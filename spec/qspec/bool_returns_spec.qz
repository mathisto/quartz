## Bool Returns - Verify predicate builtins return Bool type
## Phase 2: Builtins that are predicates now return TYPE_BOOL
##
## Contract:
##   1. == on strings returns.
##   2. Any and all return.
##   3. File_exists returns bool.
##   4. Map_has returns bool.
##   5. Is_alpha returns bool.
##   6. Is_digit returns bool.

import * from qspec

def main(): Int
  describe("predicate builtins return Bool") do ->
    it("str_contains returns Bool") do ->
      var result = str_contains("hello world", "world")
      assert_eq(result, true)
      assert_eq(str_contains("hello", "xyz"), false)
    end

    it("str_starts_with returns Bool") do ->
      assert_eq(str_starts_with("hello", "hel"), true)
      assert_eq(str_starts_with("hello", "xyz"), false)
    end

    it("str_ends_with returns Bool") do ->
      assert_eq(str_ends_with("hello", "llo"), true)
      assert_eq(str_ends_with("hello", "xyz"), false)
    end

    it("== on strings returns Bool") do ->
      assert_eq("abc" == "abc", true)
      assert_eq("abc" == "def", false)
    end

    it("is_digit returns Bool") do ->
      assert_eq(is_digit(48), true)
      assert_eq(is_digit(65), false)
    end

    it("is_alpha returns Bool") do ->
      assert_eq(is_alpha(65), true)
      assert_eq(is_alpha(48), false)
    end

    it("file_exists returns Bool") do ->
      assert_eq(file_exists("nonexistent_file_xyz_123"), false)
    end

    it("map_has returns Bool") do ->
      var m = map_new()
      m.set("key", 42)
      assert_eq(m.has("key"), true)
      assert_eq(m.has("missing"), false)
      m.free()
    end

    it("vec_contains returns Bool") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      assert_eq(vec_contains(v, 10), true)
      assert_eq(vec_contains(v, 99), false)
    end

    it("set_has returns Bool") do ->
      var s = set_new()
      set_add(s, "hello")
      assert_eq(set_has(s, "hello"), true)
      assert_eq(set_has(s, "missing"), false)
      set_free(s)
    end

    it("any? and all? return Bool") do ->
      var v = [1, 2, 3, 4, 5]
      assert_eq(any?(v, x: Int -> x > 3), true)
      assert_eq(all?(v, x: Int -> x > 0), true)
      assert_eq(all?(v, x: Int -> x > 3), false)
    end
  end

  return qspec_main()
end
