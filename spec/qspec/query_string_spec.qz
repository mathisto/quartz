## Query String Spec — Tests for query parsing in std/net/http_server
##
## Tests query_param, query_params, query_has using manually constructed
## Request structs with pre-set query_string fields.

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers — construct Request with a given query string
# =============================================================================

def make_request(qs: String): Request
  var req = Request {
    method: "GET", path: "/test", query_string: qs, body: "",
    raw_path: "/test?" + qs,
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  _parse_query_into(req)
  return req
end

# =============================================================================
# Test helpers
# =============================================================================

def print_basic_query(): Void
  var req = make_request("name=alice&age=30")
  puts(query_param(req, "name"))
end

def print_basic_query_age(): Void
  var req = make_request("name=alice&age=30")
  puts(query_param(req, "age"))
end

def print_missing_key(): Void
  var req = make_request("name=alice")
  var result = query_param(req, "missing")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_encoded_value(): Void
  var req = make_request("q=hello%20world&lang=en")
  puts(query_param(req, "q"))
end

def print_encoded_key(): Void
  var req = make_request("my%20key=value")
  puts(query_param(req, "my key"))
end

def print_empty_value(): Void
  var req = make_request("flag=&name=bob")
  var flag = query_param(req, "flag")
  if str_byte_len(flag) == 0
    puts("empty")
  else
    puts(flag)
  end
end

def print_no_value(): Void
  var req = make_request("debug&verbose")
  var debug = query_param(req, "debug")
  if str_byte_len(debug) == 0
    puts("empty")
  else
    puts(debug)
  end
end

def print_query_has_true(): Void
  var req = make_request("name=alice")
  if query_has(req, "name")
    puts("true")
  else
    puts("false")
  end
end

def print_query_has_false(): Void
  var req = make_request("name=alice")
  if query_has(req, "missing")
    puts("true")
  else
    puts("false")
  end
end

def print_multi_value(): Void
  var req = make_request("color=red&color=blue&color=green")
  var colors = query_params(req, "color")
  puts(str_from_int(colors.size))
  puts(colors[0])
  puts(colors[2])
end

def print_empty_qs(): Void
  var req = make_request("")
  if query_has(req, "anything")
    puts("true")
  else
    puts("false")
  end
end

def print_plus_decode(): Void
  var req = make_request("q=hello+world")
  puts(query_param(req, "q"))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("query_param") do ->
    it("gets basic query value") do ->
      assert_output("alice\n", print_basic_query)
    end

    it("gets second query value") do ->
      assert_output("30\n", print_basic_query_age)
    end

    it("returns empty for missing key") do ->
      assert_output("empty\n", print_missing_key)
    end

    it("URL-decodes values") do ->
      assert_output("hello world\n", print_encoded_value)
    end

    it("URL-decodes keys") do ->
      assert_output("value\n", print_encoded_key)
    end

    it("handles empty value (key=)") do ->
      assert_output("empty\n", print_empty_value)
    end

    it("handles key with no equals sign") do ->
      assert_output("empty\n", print_no_value)
    end

    it("decodes plus as space") do ->
      assert_output("hello world\n", print_plus_decode)
    end
  end

  describe("query_has") do ->
    it("returns true for existing key") do ->
      assert_output("true\n", print_query_has_true)
    end

    it("returns false for missing key") do ->
      assert_output("false\n", print_query_has_false)
    end

    it("returns false for empty query string") do ->
      assert_output("false\n", print_empty_qs)
    end
  end

  describe("query_params (multi-value)") do ->
    it("returns all values for repeated key") do ->
      assert_output("3\nred\ngreen\n", print_multi_value)
    end
  end

  return qspec_main()
end
