## std/tui/widgets/overlay::dim_base behaviour tests.
##
## Coverage:
##   - dim_base defaults to false
##   - overlay_with_dim_base sets the flag
##   - overlay_compose with dim_base emits `\x1b[2m`
##   - overlay_compose without dim_base emits no `\x1b[2m`
##   - overlay_compose with dim_base emits `\x1b[0m` reset
##   - overlay_compose_string honours dim_base symmetrically
##   - dim composition over already-styled base lines runs without
##     blowing up (acceptable visual degradation per module doc)

import * from qspec
import std/tui/widgets/overlay as ov
import std/tui/layout as ly

def _simple_overlay(): ov::Overlay
  return ov::overlay_new("hi", ov::POS_CENTER(), ly::BORDER_NONE())
end

def _three_line_base(): String =
  "line one\nline two\nline three"

# ============================================================
# Default + builder
# ============================================================

def test_dim_base_defaults_to_false(): Void
  var o = _simple_overlay()
  if o.dim_base
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_with_dim_base_sets_flag(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  if o.dim_base
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_with_dim_base_can_unset(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  o = ov::overlay_with_dim_base(o, false)
  if o.dim_base
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

# ============================================================
# overlay_compose
# ============================================================

def test_compose_no_dim_emits_no_dim_sgr(): Void
  var o = _simple_overlay()
  var out = ov::overlay_compose(_three_line_base(), o)
  if str_contains(out, "\x1b[2m")
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_compose_with_dim_emits_dim_sgr(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  var out = ov::overlay_compose(_three_line_base(), o)
  if str_contains(out, "\x1b[2m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_compose_with_dim_emits_reset(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  var out = ov::overlay_compose(_three_line_base(), o)
  if str_contains(out, "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# overlay_compose_string
# ============================================================

def test_compose_string_no_dim_emits_no_dim_sgr(): Void
  var o = _simple_overlay()
  var out = ov::overlay_compose_string(_three_line_base(), o)
  if str_contains(out, "\x1b[2m")
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_compose_string_with_dim_emits_dim_sgr(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  var out = ov::overlay_compose_string(_three_line_base(), o)
  if str_contains(out, "\x1b[2m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_compose_string_with_dim_emits_reset(): Void
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  var out = ov::overlay_compose_string(_three_line_base(), o)
  if str_contains(out, "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Acceptable visual degradation: styled base + dim
# ============================================================

def test_dim_over_styled_base_runs_without_crash(): Void
  ## The module doc notes that dim composition over already-styled
  ## base lines may not stack cleanly on every terminal. Acceptable
  ## v0.4 limitation. The test asserts the operation completes and
  ## still emits the dim SGR (visual fidelity is best-effort).
  var styled_base = "\x1b[31mred line\x1b[0m\nplain line"
  var o = ov::overlay_with_dim_base(_simple_overlay(), true)
  var out = ov::overlay_compose_string(styled_base, o)
  if str_contains(out, "\x1b[2m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def main(): Int
  describe("dim_base flag") do ->
    it("defaults to false") do ->
      test_dim_base_defaults_to_false()
    end
    it("with_dim_base sets the flag") do ->
      test_with_dim_base_sets_flag()
    end
    it("with_dim_base can unset the flag") do ->
      test_with_dim_base_can_unset()
    end
  end

  describe("overlay_compose dim path") do ->
    it("emits no \\x1b[2m when dim_base is false") do ->
      test_compose_no_dim_emits_no_dim_sgr()
    end
    it("emits \\x1b[2m when dim_base is true") do ->
      test_compose_with_dim_emits_dim_sgr()
    end
    it("emits \\x1b[0m reset when dim_base is true") do ->
      test_compose_with_dim_emits_reset()
    end
  end

  describe("overlay_compose_string dim path") do ->
    it("emits no \\x1b[2m when dim_base is false") do ->
      test_compose_string_no_dim_emits_no_dim_sgr()
    end
    it("emits \\x1b[2m when dim_base is true") do ->
      test_compose_string_with_dim_emits_dim_sgr()
    end
    it("emits \\x1b[0m reset when dim_base is true") do ->
      test_compose_string_with_dim_emits_reset()
    end
  end

  describe("acceptable degradation") do ->
    it("dim over already-styled base still runs and emits dim SGR") do ->
      test_dim_over_styled_base_runs_without_crash()
    end
  end

  return qspec_main()
end
