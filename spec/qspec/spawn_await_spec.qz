## spawn+await tests — verifies pthread_join works after removing pthread_detach

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("spawn+await") do ->
    it("spawn+await returns value from spawned thread") do ->
      var src = """
        def compute(x: Int): Int = x * 2 + 1
        def main(): Int
          var h = go compute(21)
          var result = await h
          return result - 43
        end
        """
      assert_run_exits(src, 0)
    end

    it("spawn+await multiple threads") do ->
      var src = """
        def compute(x: Int): Int = x * 2 + 1
        def main(): Int
          var h1 = go compute(10)
          var h2 = go compute(20)
          var r1 = await h1
          var r2 = await h2
          return (r1 - 21) + (r2 - 41)
        end
        """
      assert_run_exits(src, 0)
    end

    it("spawn without await does not crash") do ->
      var src = """
        def work(): Int = 42
        def main(): Int
          go work()
          return 0
        end
        """
      assert_run_exits(src, 0)
    end
  end
  return qspec_main()
end
