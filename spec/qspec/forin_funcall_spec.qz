## For-in Function Call Dispatch Tests
##
## Verifies that `for x in func()` correctly dispatches to
## StructName$next when the function returns a custom iterator.
## This was a compiler bug where NODE_CALL was not handled in
## the for-in struct_name resolution.

import * from qspec
import * from unicode
import traits

def print_codepoints_inline(): Void
  var sb = sb_new()
  for cp in str_codepoints("ABC")
    sb_append(sb, str_from_int(cp))
    sb_append(sb, " ")
  end
  puts(sb_to_string(sb))
end

def print_char_indices_inline(): Void
  var sb = sb_new()
  for pair in str_char_indices("ABC")
    sb_append(sb, str_from_int(char_index_offset(pair)))
    sb_append(sb, " ")
  end
  puts(sb_to_string(sb))
end

def print_break_inline(): Void
  var count = 0
  for cp in str_codepoints("ABCDEF")
    count += 1
    if count == 3
      break
    end
  end
  puts(str_from_int(count))
end

def main(): Int
  describe("for-in with inline function calls") do ->
    it("iterates codepoints from function call") do ->
      var cps = vec_new()
      for cp in str_codepoints("ABC")
        cps.push(cp)
      end
      assert_eq(cps.size, 3)
      assert_eq(cps[0], 65)
      assert_eq(cps[1], 66)
      assert_eq(cps[2], 67)
    end

    it("iterates char_indices from function call") do ->
      var offsets = vec_new()
      for pair in str_char_indices("ABC")
        offsets.push(char_index_offset(pair))
      end
      assert_eq(offsets.size, 3)
      assert_eq(offsets[0], 0)
      assert_eq(offsets[1], 1)
      assert_eq(offsets[2], 2)
    end

    it("break mid-iteration with inline call") do ->
      assert_output("3\n", print_break_inline)
    end

    it("output matches expected") do ->
      assert_output("65 66 67 \n", print_codepoints_inline)
      assert_output("0 1 2 \n", print_char_indices_inline)
    end
  end

  return qspec_main()
end
