## Phase 4D.5c.1 — `__qz_async_park_propagate(rv)` consumer-side park bridge.
##
## Verifies the new MIR-recognized intrinsic lowers context-sensitively:
##
##   - Inside an async $poll body (_gen_active >= 2): emits a state-machine
##     suspend point that returns the rv arg directly via
##     `mir_emit_async_suspend_point_raw`. The resume block is named
##     `park_resume`. The terminator is `ret %<rv>` — the dynamic rv is
##     propagated unchanged so a park encoding (≤ -2 from the inner $poll)
##     flows up to the caller's $poll without re-encoding through fd→ret.
##   - Outside an async context: falls back to a synchronous `sched_yield()`
##     call and returns 0. Equivalent to the existing else branch in
##     `_lower_async_gen_iter_impl` (mir_lower_iter.qz:1070).
##
## The intrinsic is the park-encoding bridge for Phase 4D.5c — it lets
## Quartz code (specifically `Stream.next()` in 4D.5c.2) propagate park
## signals from an inner $poll without losing fd/timer wakeup-registration.
## See docs/design/PHASE_4D_5C_CONSUMER_MERGE.md.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.5c.1 — __qz_async_park_propagate intrinsic") do ->

    it("sync caller compiles") do ->
      assert_compile_succeeds("""
def main(): Int
  __qz_async_park_propagate(-3)
  return 0
end
""")
    end

    it("sync caller emits sched_yield in IR") do ->
      assert_ir_contains("""
def main(): Int
  __qz_async_park_propagate(-3)
  return 0
end
""", "@sched_yield")
    end

    it("async generator caller compiles") do ->
      assert_compile_succeeds("""
def my_gen(): impl Iterator<Int> can Async
  __qz_async_park_propagate(-3)
  yield 42
end

def main(): Int
  return 0
end
""")
    end

    it("async generator caller emits park_resume block") do ->
      assert_ir_contains("""
def my_gen(): impl Iterator<Int> can Async
  __qz_async_park_propagate(-3)
  yield 42
end

def main(): Int
  return 0
end
""", "park_resume")
    end

    it("async caller emits poll_entry state-machine dispatcher") do ->
      # park_resume is generated by mir_emit_async_suspend_point_raw within
      # the standard $poll state machine. Pin poll_entry as a coupled
      # witness — confirms we're in the right $poll lowering, not a
      # sched_yield fall-through (which would emit no state machine).
      assert_ir_contains("""
def my_gen(): impl Iterator<Int> can Async
  __qz_async_park_propagate(-3)
  yield 42
end

def main(): Int
  return 0
end
""", "poll_entry")
    end

  end

  return qspec_main()
end
