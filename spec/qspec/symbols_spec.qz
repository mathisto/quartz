## Symbols Tests
##
## Contract:
##   1. Compares symbols with if/else.
##   2. Different symbols are not.
##   3. Handles unknown symbol with.
##   4. Has symbol type in.
##   5. Parses lowercase symbol literal.
##   6. Parses symbol with numbers.
import * from qspec
import * from qspec/subprocess

struct SymState
  status: Symbol
  code: Int
end

struct SymConfig
  mode: Symbol
  level: Int
end

struct SymResponse
  status: Symbol
  value: Int
end

def main(): Int
  describe("symbol literals") do ->
    it("parses lowercase symbol literal") do ->
      assert_eq(sym_parse_lower(), 0)
    end
    it("parses symbol with underscores") do ->
      assert_eq(sym_parse_under(), 0)
    end
    it("parses symbol with numbers") do ->
      assert_eq(sym_parse_num(), 0)
    end
    it("rejects symbol starting with number") do ->
      assert_compile_fails("def main(): Int\n  x = :1foo\n  return 0\nend\n")
    end
    it("same symbols are equal") do ->
      assert_eq(sym_same_eq(), 1)
    end
    it("different symbols are not equal") do ->
      assert_eq(sym_diff_neq(), 0)
    end
    it("symbols are interned") do ->
      assert_eq(sym_interned(), 42)
    end
    it("passes symbol to function") do ->
      assert_eq(sym_pass_func(), 1)
    end
    it("returns symbol from function") do ->
      assert_eq(sym_return_func(), 1)
    end
    it("compares symbols with if/else") do ->
      assert_eq(sym_compare(), 1)
    end
    it("handles unknown symbol with fallback") do ->
      assert_eq(sym_fallback(), 42)
    end
    it("stores symbol in variable") do ->
      assert_eq(sym_store_var(), 1)
    end
    it("stores symbol in struct field") do ->
      assert_eq(sym_struct_field(), 200)
    end
    it("stores symbol in array") do ->
      assert_eq(sym_array(), 1)
    end
    it("has Symbol type in function parameters") do ->
      assert_eq(sym_typed_param(), 1)
    end
    it("uses symbol for status codes") do ->
      assert_eq(sym_status_codes(), 1)
    end
    it("uses symbol for configuration keys") do ->
      assert_eq(sym_config_keys(), 3)
    end
    it("uses symbol in Result-like pattern") do ->
      assert_eq(sym_result_pattern(), 5)
    end
  end
  return qspec_main()
end

def sym_parse_lower(): Int
  s = :ok
  return 0
end

def sym_parse_under(): Int
  s = :not_found
  return 0
end

def sym_parse_num(): Int
  s = :error404
  return 0
end

def sym_same_eq(): Int
  a = :ok
  b = :ok
  if a == b
    return 1
  end
  return 0
end

def sym_diff_neq(): Int
  a = :ok
  b = :error
  if a == b
    return 1
  end
  return 0
end

def sym_check_interned(s: Symbol): Int
  if s == :expected
    return 42
  end
  return 0
end

def sym_interned(): Int = sym_check_interned(:expected)

def sym_process(status: Symbol): Int
  if status == :success
    return 1
  end
  if status == :failure
    return 2
  end
  return 0
end

def sym_pass_func(): Int = sym_process(:success)

def sym_get_status(): Symbol = :ready

def sym_return_func(): Int
  s = sym_get_status()
  if s == :ready
    return 1
  end
  return 0
end

def sym_compare(): Int
  status = :warning
  if status == :ok
    return 0
  end
  if status == :warning
    return 1
  end
  if status == :error
    return 2
  end
  return 99
end

def sym_fallback(): Int
  status = :unknown
  if status == :ok
    return 0
  end
  if status == :error
    return 1
  end
  return 42
end

def sym_store_var(): Int
  var s = :initial
  s = :updated
  if s == :updated
    return 1
  end
  return 0
end

def sym_struct_field(): Int
  state = SymState { status: :active, code: 200 }
  if state.status == :active
    return state.code
  end
  return 0
end

def sym_array(): Int
  statuses = [:ok, :warning, :error]
  if statuses[1] == :warning
    return 1
  end
  return 0
end

def sym_check_typed(s: Symbol): Int
  if s == :typed
    return 1
  end
  return 0
end

def sym_typed_param(): Int = sym_check_typed(:typed)

def sym_http_status(code: Int): Symbol
  if code == 200
    return :ok
  end
  if code == 404
    return :not_found
  end
  if code == 500
    return :server_error
  end
  return :unknown
end

def sym_status_codes(): Int
  status = sym_http_status(404)
  if status == :not_found
    return 1
  end
  return 0
end

def sym_config_keys(): Int
  config = SymConfig { mode: :production, level: 3 }
  if config.mode == :production
    return config.level
  end
  return 0
end

def sym_result_pattern(): Int
  resp = SymResponse { status: :ok, value: 5 }
  if resp.status == :ok
    return resp.value
  end
  return 0
end
