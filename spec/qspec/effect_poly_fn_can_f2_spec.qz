## P3.F.2 — Fn type carries `can e` row, resolved via enclosing function's
## row-var env. Two `can e` mentions inside one signature share one erv;
## each call site instantiates a fresh erv so pure + async callers of the
## same polymorphic function don't collide.

import * from qspec

def compose2<e>(f: Fn(Int): Int can e, g: Fn(Int): Int can e, x: Int): Int can e
  return g(f(x))
end

def double_it(x: Int): Int = x * 2
def inc_it(x: Int): Int = x + 1
def async_tick(x: Int): Int can Async = x + 100

def pure_compose(): Int = compose2(double_it, inc_it, 10)

def async_compose(): Int can Async = compose2(async_tick, async_tick, 0)

def print_pure(): Void = puts("#{pure_compose()}")
def print_async(): Void = puts("#{async_compose()}")

def main(): Int
  describe("Fn(T): U can e — effect-polymorphic combinators") do ->
    it("pure instantiation: compose2<e=empty> through Int-Int callbacks") do ->
      assert_eq(pure_compose(), 21)
    end

    it("async instantiation: compose2<e={Async}> through Async callbacks") do ->
      assert_eq(async_compose(), 200)
    end

    it("pure output matches expected") do ->
      assert_output("21\n", print_pure)
    end

    it("async output matches expected") do ->
      assert_output("200\n", print_async)
    end
  end
  return qspec_main()
end
