## std/log — Milestone D.7 stdlib pilot acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D (chunk D.7).
##
## Validates the `std/log` module: `import std/log` pulls in the `Log`
## effect (cross-module effect registration, new in D.7) plus three
## severity wrappers (`log::info`, `log::warn`, `log::error`) and a
## prefix-free `log::raw`. Default Log handler (blessed via D.4) fires
## when no user handler is installed. User `with Log { emit: my_fn }`
## overrides the default and sees the prefixed message as `arg0`.
##
## D.7 was the first consumer of cross-module effect decls — effect
## registration now runs in two phases: Phase 4.0d of quartz.qz picks
## up imported `NODE_EFFECT_DECL` entries via the resolver's all_funcs
## vector (new `RESOLVE_TAG_EFFECT_DECL = 15`), and Phase 1.4 of
## tc_program handles the root module's own effect decls as before.
## Duplicate cross-module names still surface as QZ0612.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("std/log stdlib pilot (piezo D.7)") do ->
    it("import std/log + log::info routes through default Log handler") do ->
      # Default Log handler (D.4) writes the actual message to stderr
      # followed by a newline, returns 0 (non-fatal). No user override
      # installed.
      assert_run_exits("""
import std/log

def main(): Int
  log::info("hello")
  return 0
end
""", 0)
    end

    it("default Log handler emits actual message to stderr") do ->
      assert_run_stderr_contains("""
import std/log

def main(): Int
  log::info("hello")
  return 0
end
""", "[INFO] hello")
    end

    it("user handler captures log::info message with [INFO] prefix") do ->
      assert_run_stdout_eq("""
import std/log

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  return 0
end

def main(): Int
  with Log { emit: cap } do ->
    log::info("boot complete")
  end
  return 0
end
""", "[INFO] boot complete\n")
    end

    it("all severity wrappers apply their prefixes") do ->
      assert_run_stdout_eq("""
import std/log

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  return 0
end

def main(): Int
  with Log { emit: cap } do ->
    log::info("a")
    log::warn("b")
    log::error("c")
    log::raw("d")
  end
  return 0
end
""", "[INFO] a\n[WARN] b\n[ERROR] c\nd\n")
    end

    it("can-rowed callers compose through log::info") do ->
      # `greet()` has `can Log`; user handler covers Log inside the with
      # block, so greet() typechecks without QZ0611 and the prefixed
      # message reaches the handler.
      assert_run_stdout_eq("""
import std/log

def greet(name: String): Int can Log
  var msg = "hello, "
  msg = msg + name
  return log::info(msg)
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  return 0
end

def main(): Int
  with Log { emit: cap } do ->
    greet("world")
  end
  return 0
end
""", "[INFO] hello, world\n")
    end

    it("cross-module duplicate still fires QZ0612") do ->
      # Declaring `effect Log` locally while also importing std/log
      # hits the registered-name guard and emits QZ0612. This is the
      # expected collision behavior; callers should pick ONE source.
      assert_compile_error("""
import std/log

effect Log
  def emit(s: String): Int
end

def main(): Int = 0
""", "QZ0612")
    end
  end
  return qspec_main()
end
