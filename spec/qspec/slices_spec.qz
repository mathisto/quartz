## Slices Tests
##
## Contract:
##   1. Create: `slice(v, start, end)` creates slice with correct len.
##   2. Read: `slice_get` reads elements at logical index.
##   3. Write: `slice_set` writes elements at logical index.
##   4. Empty: `slice(v, n, n)` creates zero-length slice.
##   5. End: slice at end of vec works.
##   6. Range: `v[start..end]` syntax creates slice.
##   7. Mutation: slice_set mutation reflects in underlying vec.
##   8. Full: slicing entire vec captures all elements.
import * from qspec

def main(): Int
  describe("slices") do ->
    it("creates a slice with slice() builtin") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = slice(v, 1, 3)
      assert_eq(slice_size(s), 2)
    end

    it("reads elements with slice_get") do ->
      var v = vec_new()
      v.push(100)
      v.push(200)
      v.push(300)
      var s = slice(v, 0, 3)
      assert_eq(slice_get(s, 0), 100)
      assert_eq(slice_get(s, 1), 200)
      assert_eq(slice_get(s, 2), 300)
    end

    it("writes elements with slice_set") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var s = slice(v, 0, 3)
      slice_set(s, 1, 99)
      assert_eq(slice_get(s, 1), 99)
    end

    it("creates an empty slice") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      var s = slice(v, 1, 1)
      assert_eq(slice_size(s), 0)
    end

    it("slices at the end of a vec") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var s = slice(v, 2, 3)
      assert_eq(slice_size(s), 1)
      assert_eq(slice_get(s, 0), 30)
    end

    it("uses range syntax v[start..end]") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = v[1..3]
      assert_eq(s.size, 2)
      assert_eq(s[0], 20)
      assert_eq(s[1], 30)
    end

    it("slice_set mutation reflects in original vec") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var s = slice(v, 0, 3)
      slice_set(s, 0, 99)
      assert_eq(v[0], 99)
    end

    it("full vec slice captures all elements") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var s = slice(v, 0, 3)
      assert_eq(slice_size(s), 3)
      assert_eq(slice_get(s, 0), 10)
      assert_eq(slice_get(s, 2), 30)
    end
  end
  return qspec_main()
end
