## Struct update syntax (C.1) — `Struct { ...base, k: v }` desugars to a full
## literal that copies missing fields from `base`. Equivalent to Rust's
## `..base` and OCaml's `{ r with ... }`.
##
## Acceptance:
##   1. Pure clone: `Struct { ...base }` (no overrides).
##   2. Partial override: `Struct { ...base, k: v }`.
##   3. All fields overridden: spread is a no-op but still legal.
##   4. Generic struct: `Box<Int> { ...box, value: 99 }`.
##   5. Large struct (~10 fields).
##   6. Error: multiple spreads `Struct { ...a, ...b }`.
##   7. Error: unknown field in override.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("struct update syntax") do ->
    it("clones a struct with no overrides") do ->
      assert_run_exits(su_clone_src(), 30)
    end

    it("overrides a single field, copies the rest") do ->
      assert_run_exits(su_partial_src(), 17)
    end

    it("overrides every field (spread is no-op)") do ->
      assert_run_exits(su_full_src(), 7)
    end

    it("works with a generic struct") do ->
      assert_run_exits(su_generic_src(), 99)
    end

    it("rebuilds a 12-field struct in one line") do ->
      assert_run_exits(su_large_src(), 94)
    end

    it("rejects multiple spreads") do ->
      assert_compile_error(su_multi_spread_src(), "spread")
    end

    it("rejects unknown field in override") do ->
      assert_compile_error(su_unknown_field_src(), "field")
    end

    it("preserves Vec-typed fields through spread") do ->
      assert_run_exits(su_vec_field_src(), 42)
    end

    it("supports nested struct spread") do ->
      assert_run_exits(su_nested_src(), 50)
    end
  end

  return qspec_main()
end

def su_clone_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 10, y: 20 }
    var q = Point { ...p }
    return q.x + q.y
  end
  """

def su_partial_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 10, y: 20 }
    var q = Point { ...p, x: -3 }
    return q.x + q.y
  end
  """

def su_full_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 10, y: 20 }
    var q = Point { ...p, x: 3, y: 4 }
    return q.x + q.y
  end
  """

def su_generic_src(): String = """
  struct Box<T>
    value: T
  end
  def main(): Int
    var b = Box<Int> { value: 1 }
    var c = Box<Int> { ...b, value: 99 }
    return c.value
  end
  """

def su_large_src(): String = """
  struct World
    a: Int
    b: Int
    c: Int
    d: Int
    e: Int
    f: Int
    g: Int
    h: Int
    i: Int
    j: Int
    k: Int
    l: Int
  end
  def main(): Int
    var w = World {
      a: 1, b: 2, c: 3, d: 4, e: 5, f: 6,
      g: 7, h: 8, i: 9, j: 10, k: 11, l: 12
    }
    var w2 = World { ...w, c: 30, k: 0 }
    return w2.a + w2.b + w2.c + w2.d + w2.e + w2.f + w2.g + w2.h + w2.i + w2.j + w2.k + w2.l
  end
  """

def su_multi_spread_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 1, y: 2 }
    var q = Point { x: 10, y: 20 }
    var r = Point { ...p, ...q }
    return r.x
  end
  """

def su_unknown_field_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 1, y: 2 }
    var q = Point { ...p, z: 99 }
    return q.x
  end
  """

def su_vec_field_src(): String = """
  struct Bag
    items: Vec<Int>
    label: Int
  end
  def main(): Int
    var v = vec_new<Int>()
    v.push(10)
    v.push(20)
    v.push(12)
    var b = Bag { items: v, label: 0 }
    var b2 = Bag { ...b, label: 99 }
    var sum = 0
    for x in b2.items
      sum += x
    end
    return sum
  end
  """

def su_nested_src(): String = """
  struct Inner
    a: Int
    b: Int
  end
  struct Outer
    name: Int
    inner: Inner
  end
  def main(): Int
    var i = Inner { a: 10, b: 20 }
    var o = Outer { name: 0, inner: i }
    var o2 = Outer { ...o, inner: Inner { ...i, a: 30 } }
    return o2.inner.a + o2.inner.b
  end
  """
