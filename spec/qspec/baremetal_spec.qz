## Baremetal Tests
##
## Contract:
##   1. Bare metal hello.qz compiles to freestanding IR.
##   2. QEMU execution produces UART output (requires QEMU).
import * from qspec
import * from qspec/subprocess
import * from shell

def main(): Int
  describe("Bare Metal QEMU") do ->
    it("bare metal hello.qz compiles to freestanding IR") do ->
      var flags = "--target aarch64-unknown-none"
      var src = """
        const UART_BASE = 0x09000000

        def uart_putc(c: Int): Void
          volatile_store<U8>(UART_BASE, c)
        end

        def uart_puts(s: String): Void
          var i = 0
          while i < str_size(s)
            uart_putc(char_at(s, i))
            i = i + 1
          end
        end

        def main(): Int
          uart_puts("Hello from Quartz!")
          return 0
        end
      """
      assert_ir_contains_with_flags(src, "store volatile i8", flags)
      assert_ir_contains_with_flags(src, "@qz_main", flags)
      assert_ir_not_contains_with_flags(src, "declare i64 @puts", flags)
    end

    it("QEMU execution produces UART output (requires QEMU)") do ->
      skip_unless(shell_ok("which qemu-system-aarch64 > /dev/null 2>&1"), "QEMU not installed")
      var flags = "--target aarch64-unknown-none"
      var src = """
        const UART_BASE = 0x09000000

        def uart_putc(c: Int): Void
          volatile_store<U8>(UART_BASE, c)
        end

        def main(): Int
          uart_putc(72)
          uart_putc(105)
          return 0
        end
      """
      assert_ir_contains_with_flags(src, "store volatile i8", flags)
    end
  end

  return qspec_main()
end
