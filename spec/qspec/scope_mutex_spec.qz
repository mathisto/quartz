## scope-aware mutex lock (B.7 Phase 4e.3)
##
## scope_lock is the fourth scope-integrated blocking primitive (after
## scope_sleep_ms in Phase 4e.1 and scope_recv/scope_send in Phase 4e.2).
## It follows the same chunked-poll-first recipe: under root scope, route
## to the tight blocking `mutex_lock` call; under a real scope, alternate
## `mutex_try_lock` with `sched_sleep(min(chunk, deadline_remaining_ms))`
## and `scope_check` between chunks.
##
## Contract:
##   1. Under root scope, scope_lock on an uncontended mutex returns the
##      protected value without throwing.
##   2. Under a scope with a generous deadline, scope_lock on an uncontended
##      mutex returns the value without throwing — the try_lock succeeds on
##      the first iteration, never entering the chunk-poll path.
##   3. Under a scope with a tight deadline, scope_lock on a held mutex
##      throws "deadline_exceeded" within ~chunk_size + slack ms. The
##      scope's deadline timer (Phase 4d) is what fires the deadline.
##   4. Under a scope already cancelled at entry, scope_lock throws
##      immediately with the user-supplied reason (preflight check).

import * from qspec
import * from std/sync/composition/scope
import * from std/throws

# Capture for handler-driven assertions.
var sc_caught_msg = ""
var sc_caught_count = 0

def sc_capture(op_name: Int, argc: Int, argv: Int): Int
  sc_caught_msg = as_type<String>(load(argv, 0))
  sc_caught_count += 1
  return 0
end

def is_in_range(v: Int, lo: Int, hi: Int): Int
  if v >= lo and v <= hi
    return 1
  end
  return 0
end

# Per-test mutex slot and result slot — module globals so test bodies can
# address them without juggling closure capture across `with Throws` boundaries.
var sc_m = 0
var sc_lock_val = -1
var sc_lock_ok = 0

def sc_lock_into_global(): Int
  var r = scope_lock(sc_m)
  sc_lock_val = r
  sc_lock_ok = 1
  return 0
end

def main(): Int
  describe("scope_lock (B.7 Phase 4e.3)") do ->

    it("under root, scope_lock on uncontended mutex returns the value") do ->
      var m = mutex_new(42)
      var r = scope_lock(m)
      assert_eq(r, 42)
      mutex_unlock(m, r)
    end

    it("under a scope, scope_lock on uncontended mutex returns value without throwing") do ->
      sc_m = mutex_new(7)
      sc_lock_val = -1
      sc_lock_ok = 0
      sc_caught_count = 0
      var s = scope_timeout(scope_root(), 5_000)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_lock_into_global)
        0
      end
      assert_eq(sc_caught_count, 0)
      assert_eq(sc_lock_ok, 1)
      assert_eq(sc_lock_val, 7)
      mutex_unlock(sc_m, sc_lock_val)
    end

    it("scope_lock with deadline fires deadline_exceeded on a held mutex") do ->
      sc_m = mutex_new(99)
      # Hold the mutex from the test thread — scope_lock will spin-fail.
      var held_val = mutex_lock(sc_m)
      sc_lock_val = -1
      sc_lock_ok = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var start_ns = time_mono_ns()
      var s = scope_timeout(scope_root(), 50)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_lock_into_global)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      # Deadline 50ms; chunk granularity adds up to ~50ms of slack.
      assert_eq(is_in_range(elapsed_ms, 45, 300), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "deadline_exceeded")
      # Body never reached the success branch.
      assert_eq(sc_lock_ok, 0)
      # Release the held mutex for cleanup.
      mutex_unlock(sc_m, held_val)
    end

    it("preflight: scope already cancelled at entry throws user reason") do ->
      sc_m = mutex_new(0)
      sc_lock_val = -1
      sc_lock_ok = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var s = scope_with_cancel(scope_root())
      scope_cancel_with(s, "user_aborted_lock")
      var start_ns = time_mono_ns()
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_lock_into_global)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      # No sched_sleep should run; only the entry scope_check fires.
      assert_eq(is_in_range(elapsed_ms, 0, 50), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "user_aborted_lock")
      assert_eq(sc_lock_ok, 0)
    end

  end
  return qspec_main()
end
