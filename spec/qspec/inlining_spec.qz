## Inlining Tests
##
## Contract:
##   1. IR contains inlined body: function body appears in caller's IR.
##   2. Correctness: inlined result matches non-inlined.
##   3. Multi-call: multiple inlined calls produce correct results.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Inlining") do ->
    it("IR contains inlined function body") do ->
      assert_ir_contains("""
        def square(x: Int): Int
          x * x
        end

        def main(): Int
          square(5)
        end
      """, "mul")
    end

    it("correctly computes inlined result") do ->
      assert_run_exits("""
        def square(x: Int): Int
          x * x
        end

        def main(): Int
          var r = square(6)
          r
        end
      """, 36)
    end

    it("inlining preserves multi-call correctness") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int
          a + b
        end

        def main(): Int
          var x = add(10, 20)
          var y = add(5, 7)
          x + y
        end
      """, 42)
    end

    it("identity function inlines correctly") do ->
      assert_run_exits("""
        def id(x: Int): Int
          x
        end

        def main(): Int
          id(42)
        end
      """, 42)
    end

    it("nested inline call computes correctly") do ->
      assert_run_exits("""
        def double(x: Int): Int
          x * 2
        end

        def quad(x: Int): Int
          double(double(x))
        end

        def main(): Int
          quad(10)
        end
      """, 40)
    end
  end

  return qspec_main()
end
