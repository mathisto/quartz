## Type Alias Tests

import * from qspec
import * from qspec/subprocess

type UserId = Int
type UserName = String
type Level1 = Int
type Level2 = Level1
type Level3 = Level2

struct TAUser
  id: UserId
  name: UserName
end

def main(): Int
  describe("type aliases") do ->
    it("aliases primitive type Int") do ->
      assert_eq(ta_get_id(), 42)
    end
    it("aliases String type") do ->
      assert_eq(ta_greet("World"), 0)
    end
    it("aliases Bool type") do ->
      assert_eq(ta_check(1), 1)
    end
    it("alias in struct field type") do ->
      u = TAUser { id: 42, name: "Alice" }
      assert_eq(u.id, 42)
    end
    it("allows chained aliases") do ->
      assert_eq(ta_get_level(), 42)
    end
    it("allows deeply chained aliases") do ->
      assert_eq(ta_get_deep(), 55)
    end
    it("aliased type where original expected") do ->
      uid = ta_get_uid()
      assert_eq(ta_process_int(uid), 42)
    end
    it("original type where alias expected") do ->
      assert_eq(ta_process_uid(21), 42)
    end
    it("aliases unary function type") do ->
      assert_run_exits("""
        type Transform = Fn(Int)
        def apply(f: Transform, x: Int): Int = f(x)
        def my_double(x: Int): Int = x * 2
        def main(): Int = apply(&my_double, 21)
        """, 42)
    end
    it("aliases binary function type") do ->
      assert_run_exits("""
        type BinOp = Fn(Int, Int)
        def apply(f: BinOp, a: Int, b: Int): Int = f(a, b)
        def my_add(a: Int, b: Int): Int = a + b
        def main(): Int = apply(&my_add, 20, 22)
        """, 42)
    end
    it("aliases function returning Void") do ->
      assert_run_exits("""
        type Action = Fn(Int)
        def run(f: Action, x: Int): Int
          f(x)
          return 42
        end
        def noop(x: Int): Int = x
        def main(): Int = run(&noop, 0)
        """, 42)
    end
    it("rejects recursive alias") do ->
      assert_compile_error("""
        type X = X
        def main(): Int = 0
        """, "Recursive type alias")
    end
    it("rejects alias to unknown type") do ->
      assert_compile_error("""
        type X = Nonexistent
        def main(): Int = 0
        """, "unknown type")
    end
    it("rejects mutually recursive aliases") do ->
      assert_compile_error("""
        type A = B
        type B = A
        def main(): Int = 0
        """, "Recursive type alias cycle")
    end
    it("aliases imported struct type") do ->
      var files: Vec = vec_new()
      files.push(as_int("ta_struct_mod.qz"))
      vec_push(files, as_int("""
        struct TAStruct2
          val: Int
        end
        def ta_struct2_get(s: TAStruct2): Int
          return s.val
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import ta_struct_mod
        type MyStruct = TAStruct2
        def main(): Int
          s: MyStruct = TAStruct2 { val: 42 }
          return ta_struct_mod::ta_struct2_get(s)
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
    it("uses imported type alias (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("ta_alias_mod.qz"))
      vec_push(files, as_int("""
        type AliasId = Int
        def ta_alias_get(): AliasId
          return 42
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import ta_alias_mod
        def main(): Int
          return ta_alias_mod::ta_alias_get()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end
  return qspec_main()
end

def ta_get_id(): UserId = 42
def ta_greet(name: UserName): Int
  puts(name)
  return 0
end
def ta_check(f: Int): Int
  if f
    return 1
  end
  return 0
end
def ta_get_level(): Level3 = 42
def ta_get_deep(): Int = 55
def ta_get_uid(): UserId = 21
def ta_process_int(id: Int): Int = id * 2
def ta_process_uid(id: UserId): Int = id * 2
