## FIX.6 Phase 5: List Comprehension & Array Literal Type Inference Tests
##
## Contract:
##   1. List comp infers element type from body expression.
##   2. Array literals infer element type from first element.
##   3. .size works on list comp results.
##   4. Indexing into list comp results works.

import * from qspec

def print_int_listcomp(): Void
  var items = [x * 2 for x in 0..5]
  puts(str_from_int(items.size))
  puts(str_from_int(items[0]))
  puts(str_from_int(items[4]))
end

def print_string_array(): Void
  var names = ["alice", "bob", "charlie"]
  puts(str_from_int(names.size))
  puts(names[0])
  puts(names[2])
end

def print_nested_listcomp(): Void
  var base = [1, 2, 3]
  var doubled = [base[i] * 2 for i in 0..base.size]
  puts(str_from_int(doubled.size))
  puts(str_from_int(doubled[0]))
  puts(str_from_int(doubled[2]))
end

def main(): Int
  describe("list comprehension type inference") do ->
    it("infers Int element type from body") do ->
      assert_output("5\n0\n8\n", print_int_listcomp)
    end

    it("array literal infers type from elements") do ->
      assert_output("3\nalice\ncharlie\n", print_string_array)
    end

    it("nested list comp preserves element type") do ->
      assert_output("3\n2\n6\n", print_nested_listcomp)
    end

    it(".size on list comp result") do ->
      var items = [x for x in 0..10]
      assert_eq(items.size, 10)
    end

    it("indexing list comp result") do ->
      var items = [x * 3 for x in 0..4]
      assert_eq(items[0], 0)
      assert_eq(items[1], 3)
      assert_eq(items[2], 6)
      assert_eq(items[3], 9)
    end
  end

  return qspec_main()
end
