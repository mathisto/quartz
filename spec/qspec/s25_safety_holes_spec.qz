## S2.5 Safety Audit Holes — Tests for all fixed holes
## Covers: #6 NODE_ASSIGN re-init, #7 struct init move, #13 lambda capture move,
##         #3 try/catch move branches, #9 enum payload move, #11 NLL+move interaction
##
## Contract:
##   1. S2.5 hole #6: NODE_ASSIGN move re-init.
##   2. S2.5 hole #7: struct init consumes moved values.
##   3. S2.5 hole #13: lambda captures consume moved values.
##   4. S2.5 hole #3: try/catch move branch handling.
##   5. S2.5 hole #9: enum payload consumes moved values.
##   6. S2.5 hole #11: NLL release then move is safe.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Hole #6: NODE_ASSIGN move re-init (CRITICAL)
  # ===========================================================================
  describe("S2.5 hole #6: NODE_ASSIGN move re-init") do ->
    it("reassignment after move re-initializes value") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          consume(r)
          r = Res{x: 99}
          return r.x
        end
        """, 99)
    end

    it("use after move without re-init is still QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          consume(r)
          return r.x
        end
        """, "QZ1212")
    end

    it("re-init clears partial move state") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Pair
          a: Int
          b: Int
        end
        extend Pair with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Pair): Int = r.a
        def main(): Int
          var p = Pair{a: 1, b: 2}
          consume(p)
          p = Pair{a: 10, b: 20}
          return p.a + p.b
        end
        """, 30)
    end
  end

  # ===========================================================================
  # Hole #7: NODE_STRUCT_INIT move consumption (MEDIUM)
  # ===========================================================================
  describe("S2.5 hole #7: struct init consumes moved values") do ->
    it("value used in struct init is consumed") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Inner
          val: Int
        end
        extend Inner with Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Outer
          inner: Int
        end
        def main(): Int
          var x = Inner{val: 42}
          var o = Outer{inner: x}
          return x.val
        end
        """, "QZ1212")
    end

    it("struct init with non-Drop values works fine") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        struct Line
          start: Int
          stop: Int
        end
        def main(): Int
          var p1 = Point{x: 1, y: 2}
          var p2 = Point{x: 3, y: 4}
          var l = Line{start: p1, stop: p2}
          return p1.x + p2.x
        end
        """, 4)
    end

    it("multiple struct fields consume multiple values") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Pair
          a: Int
          b: Int
        end
        def main(): Int
          var r1 = Res{x: 1}
          var r2 = Res{x: 2}
          var p = Pair{a: r1, b: r2}
          return r1.x
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Hole #13: Lambda capture move consumption (MEDIUM)
  # ===========================================================================
  describe("S2.5 hole #13: lambda captures consume moved values") do ->
    it("captured Drop value is consumed at lambda creation") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var c = Conn{fd: 42}
          var f = -> c.fd
          return c.fd
        end
        """, "QZ1212")
    end

    it("two lambdas capturing same Drop value is QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var c = Conn{fd: 42}
          var f1 = -> c.fd
          var f2 = -> c.fd
          return 0
        end
        """, "QZ1212")
    end

    it("lambda capturing non-Drop value is fine") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var f = -> x + 1
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Hole #3: NODE_TRY_CATCH move branch handling (MEDIUM)
  # ===========================================================================
  describe("S2.5 hole #3: try/catch move branch handling") do ->
    it("value moved in try body is moved after try/catch") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        enum TcRes
          Ok(value: Int)
          Err(error: Int)
        end
        def consume(r: Res): TcRes
          return TcRes::Ok(r.x)
        end
        def main(): Int
          var r = Res{x: 1}
          var v = try
            consume(r)
          catch Err(e)
            0
          end
          return r.x
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Hole #9: Enum payload move consumption (LOW)
  # ===========================================================================
  describe("S2.5 hole #9: enum payload consumes moved values") do ->
    it("value used as enum payload is consumed") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        enum Wrapper
          Held(val: Int)
          Empty
        end
        def main(): Int
          var r = Res{x: 42}
          var w = Wrapper::Held(r)
          return r.x
        end
        """, "QZ1212")
    end

    it("non-Drop value as enum payload is fine") do ->
      assert_run_exits("""
        enum Wrapper
          Held(val: Int)
          Empty
        end
        def main(): Int
          var x = 42
          var w = Wrapper::Held(x)
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Hole #11: NLL release + move interaction (MEDIUM — verification)
  # ===========================================================================
  describe("S2.5 hole #11: NLL release then move is safe") do ->
    it("borrow released by NLL, then move succeeds") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def use_ref(r: &Res): Int = 1
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var val = use_ref(&r)
          return consume(r)
        end
        """, 42)
    end
  end

  return qspec_main()
end
