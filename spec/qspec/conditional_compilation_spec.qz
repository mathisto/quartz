## Conditional Compilation Tests
##
## Contract:
##   1. Basic @cfg.
##   2. @cfg on struct.
##   3. @cfg on arch.
##   4. @cfg combined with @repr(c).
##   5. @cfg on enum.
##   6. Compound conditions.
##   7. @cfg on type alias.
##   8. @cfg on struct fields.
##   9. @cfg(target_feature).

import * from qspec
import * from qspec/subprocess

## @cfg on functions - platform dispatch
@cfg(os: "macos")
def platform_val(): Int = 2

@cfg(os: "linux")
def platform_val(): Int = 1

@cfg(os: "macos")
def platform_block(): Int
  return 2
end

@cfg(os: "linux")
def platform_block(): Int
  return 1
end

## @cfg on arch
@cfg(arch: "aarch64")
def get_arch(): Int = 1

@cfg(arch: "x86_64")
def get_arch(): Int = 2

## @cfg(not: ...)
@cfg(not: os: "windows")
def not_windows(): Int = 1

@cfg(not: os: "macos")
def not_mac_fn(): Int = 1

@cfg(os: "macos")
def not_mac_fn(): Int = 2

## @cfg(any: ...)
@cfg(any: os: "macos", os: "linux")
def unix_like(): Int = 1

## @cfg on struct
@cfg(os: "macos")
struct MacInfo
  value: Int
end

## @cfg on enum
@cfg(os: "macos")
enum PlatEnum
  Mac
  Other
end

## @cfg on type alias
@cfg(os: "macos")
type Handle = Int

def get_handle(): Handle = 55

## @cfg combined with @repr(C) — field_offset intrinsic not available via lli
## @cfg(os: "macos")
## @repr(C)
## struct CData
##   x: CInt
##   y: CInt
## end

## @cfg(any: ...) - no match on this platform
@cfg(any: os: "windows", os: "freebsd")
def cc_any_none(): Int = 99

@cfg(any: os: "macos", os: "linux")
def cc_any_none(): Int = 42

## @cfg(all: ...) - all conditions match
@cfg(all: os: "macos", arch: "aarch64")
def cc_all_match(): Int = 1

@cfg(os: "linux")
def cc_all_match(): Int = 1

@cfg(all: os: "macos", arch: "x86_64")
def cc_all_match(): Int = 1

## @cfg(all: ...) - one condition false
@cfg(all: os: "macos", os: "windows")
def cc_all_skip(): Int = 99

@cfg(not: os: "windows")
def cc_all_skip(): Int = 42

## @cfg on struct fields
struct CfgFieldStruct
  always: Int
  @cfg(os: "macos")
  mac_field: Int
  @cfg(os: "windows")
  win_field: Int
end

struct CfgNotFieldStruct
  always: Int
  @cfg(not: os: "windows")
  unix_field: Int
end

## @cfg(target_feature) detection
@cfg(target_feature: "neon")
def cc_has_neon(): Int = 1

@cfg(not: target_feature: "neon")
def cc_has_neon(): Int = 0

@cfg(target_feature: "sse2")
def cc_has_sse2(): Int = 1

@cfg(not: target_feature: "sse2")
def cc_has_sse2(): Int = 0

@cfg(target_feature: "avx512")
def cc_has_avx512(): Int = 1

@cfg(not: target_feature: "avx512")
def cc_has_avx512(): Int = 0

## fallback function for any tests
def fallback_val(): Int = 2

def main(): Int
  describe("basic @cfg") do ->
    it("includes matching os definition") do ->
      assert_eq(platform_val(), 2)
    end

    it("excludes non-matching os definition (block def)") do ->
      assert_eq(platform_block(), 2)
    end
  end

  describe("@cfg on struct") do ->
    it("matching struct is included") do ->
      var i = MacInfo { value: 42 }
      assert_eq(i.value, 42)
    end
  end

  describe("@cfg on arch") do ->
    it("detects architecture") do ->
      result = get_arch()
      ## Either 1 (aarch64) or 2 (x86_64) is valid
      assert_eq(result > 0, true)
    end
  end

  describe("@cfg combined with @repr(C)") do ->
    it("combined annotations work (@repr(C) + @cfg)") do ->
      assert_run_exits("""
        @cfg(os: "macos")
        @repr(C)
        struct CfgReprStruct
          a: I32
          b: I32
        end
        def main(): Int
          var s = CfgReprStruct { a: 42, b: 99 }
          return s.a
        end
        """, 42)
    end
  end

  describe("@cfg on enum") do ->
    it("matching enum is included") do ->
      var e = PlatEnum::Mac
      match e
        PlatEnum::Mac => assert_eq(10, 10)
        PlatEnum::Other => assert_eq(0, 10)
      end
    end
  end

  describe("compound conditions") do ->
    it("@cfg(not: ...) negates a condition") do ->
      assert_eq(not_windows(), 1)
    end

    it("@cfg(not: ...) skips when condition matches") do ->
      assert_eq(not_mac_fn(), 2)
    end

    it("@cfg(any: ...) matches if any condition is true") do ->
      assert_eq(unix_like(), 1)
    end

    it("@cfg(any: ...) skips if no condition matches") do ->
      assert_eq(cc_any_none(), 42)
    end

    it("@cfg(all: ...) matches if all conditions are true") do ->
      assert_eq(cc_all_match(), 1)
    end

    it("@cfg(all: ...) skips if any condition is false") do ->
      assert_eq(cc_all_skip(), 42)
    end
  end

  describe("@cfg on type alias") do ->
    it("type alias with @cfg works") do ->
      assert_eq(get_handle(), 55)
    end
  end

  describe("@cfg on struct fields") do ->
    it("@cfg on struct field includes matching field") do ->
      var s = CfgFieldStruct { always: 1, mac_field: 2 }
      assert_eq(s.always, 1)
      assert_eq(s.mac_field, 2)
    end

    it("@cfg(not: ...) on struct field excludes matching field") do ->
      var s = CfgNotFieldStruct { always: 1, unix_field: 2 }
      assert_eq(s.always, 1)
      assert_eq(s.unix_field, 2)
    end
  end

  describe("@cfg(target_feature)") do ->
    it("detects neon on aarch64") do ->
      assert_eq(cc_has_neon(), 1)
    end

    it("detects sse2 on x86_64") do ->
      ## On aarch64: sse2=0, on x86_64: sse2=1
      ## This test just verifies target_feature detection works
      assert_eq(cc_has_sse2() >= 0, 1)
    end

    it("unknown feature evaluates to false") do ->
      assert_eq(cc_has_avx512(), 0)
    end
  end

  return qspec_main()
end

