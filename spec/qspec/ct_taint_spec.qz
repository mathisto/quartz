## CT taint tests (NET.4 Layer 3 — @ct MIR pass)
##
## Contract:
##   1. `@ct` is accepted on `def` declarations, rejected elsewhere.
##   2. Inside an `@ct` function with a `Secret<T>` parameter, the MIR
##      taint pass propagates secrecy through `secret_unwrap`, arithmetic,
##      `MIR_LOAD_VAR` / `MIR_STORE_VAR`, and `MIR_PHI`, then rejects:
##        - branch on Secret-derived condition          → QZ0700
##        - array index by Secret-derived value         → QZ0701
##        - comparison with a Secret-derived operand    → QZ0702
##        - variable shift by Secret-derived amount     → QZ0703
##   3. Canonical CT helpers (select-style branchless arithmetic) pass.
##
## Layer 1 (STRICT_NEWTYPES) and Layer 3 (this pass) are complementary:
## Layer 1 rejects the same four sinks WHEN the value is still typed
## `Secret<T>` at the use site; Layer 3 catches the case where the value
## was untyped via `secret_unwrap` inside an `@ct` boundary. The negative
## specs below therefore call `secret_unwrap` first so the typechecker
## sees a loose `Int`/`Bytes` value — only the taint pass can flag it.
##
## NET.4 Layer 3 design: docs/design/SECRET_T_AND_DUDECT_DESIGN.md §"Layer 3".

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("@ct attribute parsing") do ->
    it("accepts @ct on a def declaration") do ->
      assert_compile_succeeds("""
        @ct
        def noop(): Int = 0
        def main(): Int = noop()
      """)
    end

    it("rejects @ct on a struct definition") do ->
      assert_compile_error("""
        @ct
        struct Foo
          x: Int
        end
        def main(): Int = 0
      """, "@ct can only be applied to function definitions")
    end

    it("rejects @ct on a newtype declaration") do ->
      assert_compile_error("""
        @ct
        newtype Tag = Int
        def main(): Int = 0
      """, "@ct can only be applied to function definitions")
    end
  end

  describe("@ct positive path") do ->
    # Branchless CT-safe primitive — no sinks fire even though every value
    # in the function body is taint-derived.
    it("accepts a branchless CT-safe primitive over Secret<Int>") do ->
      assert_compile_succeeds("""
        import * from std/core/crypto/secret

        @ct
        def ct_xor(a: Secret<Int>, b: Secret<Int>): Int
          # Pure arithmetic on unwrapped secrets — no comparison, no
          # branch, no index, no variable shift. Layer 3 stays silent.
          var ai = secret_unwrap<Int>(a)
          var bi = secret_unwrap<Int>(b)
          return ai ^ bi
        end

        def main(): Int = 0
      """)
    end

    # Constant shift amount is fine — only VARIABLE shifts leak through
    # the µop path. `x >> 8` on a secret value is a constant-amount
    # shift; Layer 3 must not flag.
    it("accepts a constant-amount shift on a Secret-derived value") do ->
      assert_compile_succeeds("""
        import * from std/core/crypto/secret

        @ct
        def ct_top_byte(s: Secret<Int>): Int
          var v = secret_unwrap<Int>(s)
          return (v >> 56) & 255
        end

        def main(): Int = 0
      """)
    end

    # An `@ct` function with no Secret<T> params is a no-op for the pass —
    # nothing to taint, no sinks fire even with branches/index/compare.
    it("accepts an @ct function with no Secret<T> parameters") do ->
      assert_compile_succeeds("""
        @ct
        def f(x: Int): Int
          if x > 0
            return x + 1
          end
          return 0
        end

        def main(): Int = 0
      """)
    end
  end

  describe("@ct rejections (MIR taint sinks)") do ->
    it("rejects branch on a Secret-derived condition (QZ0700)") do ->
      assert_compile_error("""
        import * from std/core/crypto/secret

        @ct
        def bad_branch(s: Secret<Int>): Int
          var n = secret_unwrap<Int>(s)
          # `& 1` is not itself a sink; but the `if` terminator branches
          # on the tainted bool. QZ0700 fires.
          if (n & 1) == 1
            return 1
          end
          return 0
        end

        def main(): Int = 0
      """, "QZ0700")
    end

    it("rejects array index by a Secret-derived value (QZ0701)") do ->
      assert_compile_error("""
        import * from std/core/crypto/secret

        @ct
        def bad_index(s: Secret<Int>): Int
          var n = secret_unwrap<Int>(s)
          var table = vec_new<Int>()
          table.push(11)
          table.push(22)
          # `table[n]` taints the index — cache-line addressing leaks n.
          return table[n]
        end

        def main(): Int = 0
      """, "QZ0701")
    end

    it("rejects comparison on a Secret-derived operand (QZ0702)") do ->
      assert_compile_error("""
        import * from std/core/crypto/secret

        @ct
        def bad_compare(a: Secret<Int>, b: Secret<Int>): Int
          var ai = secret_unwrap<Int>(a)
          var bi = secret_unwrap<Int>(b)
          # `==` is the leak — `subtle::ct_eq_byte` is the CT replacement.
          var eq = ai == bi
          return eq
        end

        def main(): Int = 0
      """, "QZ0702")
    end

    it("rejects variable shift by a Secret-derived amount (QZ0703)") do ->
      assert_compile_error("""
        import * from std/core/crypto/secret

        @ct
        def bad_shift(amount: Secret<Int>, val: Int): Int
          var sh = secret_unwrap<Int>(amount)
          # Variable-amount shift on x86/ARM leaks the amount through the
          # µop dispatch path.
          return val << sh
        end

        def main(): Int = 0
      """, "QZ0703")
    end
  end

  return qspec_main()
end
