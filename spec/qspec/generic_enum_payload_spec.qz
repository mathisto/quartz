## Regression spec for generic enum payload typing
## (GENERIC_ENUM_PAYLOAD_ERASES_TO_INT).
##
## Three orthogonal bugs co-occurred:
##
## 1. `tc_substitute_annotation` mis-sliced tuple types like `(Int, Ev<T>)`
##    — it only handled the `Base<...>` shape, so the trailing `)` was left
##    inside the inner slice and the substituted output came out malformed.
##
## 2. `tc_make_tuple_type` interned by `(arity, 0)` alone, so any two
##    N-tuples shared a TypeId. Once call-site substitution started
##    emitting concrete tuple shapes (`(Int, Ev<String>)`) after the
##    generic shape (`(Int, Ev<T>)`) had populated the slot, the new
##    shape silently re-used the stale element-types vector.
##
## 3. `tc_expr_field_access` collapsed the object's ptype to its base
##    kind (TYPE_TUPLE) before the tuple-positional-access branch checked
##    `>= PTYPE_BASE`. The check failed and `pair.0` / `pair.1` always
##    returned TYPE_INT, even when the tuple's per-element types were
##    properly tracked.
##
## All three needed fixing; `tc_types_match` was also taught to recurse
## into TYPE_TUPLE element types so structurally equivalent tuples (the
## annotation's ptype vs the body-constructor's ptype with bare-enum
## elements) compare equal.

## HB-DOG.6 addendum: a match-arm payload binding must carry its declared
## type into MIR so a `.size` / field access on it resolves. The bug:
## `mir_mark_pattern_bindings_typed` recorded only `String` payload bindings,
## so a `Vec<Int>` payload binding had no tracked MIR type — and a `.size` in
## a typecheck-skipped context (a `while`-condition inside a curly-block match
## arm) fell through to the offset-0 field-access fallback, reading the wrong
## word and bounds-panicking. Fixed by marking every non-empty payload type.

import * from qspec

enum GeP_Ev<T>
  GeP_Idle
  GeP_Selected(item: T)
end

enum HBD6_Box
  HBD6_Empty
  HBD6_Full(items: Vec<Int>)
end

## Exercises the exact HB-DOG.6 shape: `.size` on a `Vec` payload binding
## inside a `while`-condition within a curly-block match arm.
def hbd6_sum_payload(): Int
  var v = vec_new<Int>()
  vec_push(v, 10)
  vec_push(v, 20)
  vec_push(v, 30)
  var b = HBD6_Box::HBD6_Full(v)
  var total = 0
  match b
    HBD6_Empty => total = 0
    HBD6_Full(items) => {
      var k = 0
      while k < items.size
        total = total + items[k]
        k += 1
      end
    }
  end
  return total
end

def make_simple<Item>(x: Item): GeP_Ev<Item>
  return GeP_Ev::GeP_Selected(x)
end

def make_pair<Item>(x: Item): (Int, GeP_Ev<Item>)
  return (1, GeP_Ev::GeP_Selected(x))
end

def use_simple_payload(): String
  var ev = make_simple<String>("ok")
  match ev
    GeP_Idle             => return "idle"
    GeP_Selected(item)   =>
      var v = vec_new<String>()
      vec_push(v, item)
      return v[0]
  end
  return "fallthrough"
end

def use_pair_payload(): String
  var pair = make_pair<String>("paired")
  var ev = pair.1
  match ev
    GeP_Idle             => return "idle"
    GeP_Selected(item)   =>
      var v = vec_new<String>()
      vec_push(v, item)
      return v[0]
  end
  return "fallthrough"
end

def use_inline_pair(): String
  var pair: (Int, GeP_Ev<String>) = (1, GeP_Ev::GeP_Selected("inline"))
  var ev = pair.1
  match ev
    GeP_Idle             => return "idle"
    GeP_Selected(item)   =>
      var v = vec_new<String>()
      vec_push(v, item)
      return v[0]
  end
  return "fallthrough"
end

def main(): Int
  describe("generic enum payload preserves type-arg across boundaries") do ->

    it("destructures a typed payload from a direct generic-fn call") do ->
      assert_eq_str(use_simple_payload(), "ok")
    end

    it("destructures a typed payload from a tuple-wrapped generic-fn call") do ->
      assert_eq_str(use_pair_payload(), "paired")
    end

    it("destructures a typed payload from an inline-typed tuple") do ->
      assert_eq_str(use_inline_pair(), "inline")
    end

    it("resolves .size on a Vec payload binding in a curly-block while-cond (HB-DOG.6)") do ->
      assert_eq(hbd6_sum_payload(), 60)
    end

  end
  return qspec_main()
end
