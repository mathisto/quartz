## Auto Vectorize Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Auto Vectorize — compilation") do ->
    it("compiles vectorizable loop correctly") do ->
      assert_compile_succeeds(av_basic_loop())
    end
    it("vectorizable loop produces correct result") do ->
      assert_run_exits(av_sum_loop(), 45)
    end
    it("multiplication accumulation loop") do ->
      assert_run_exits(av_mul_loop(), 0)
    end
    it("loop with conditional produces correct result") do ->
      assert_run_exits(av_cond_loop(), 20)
    end
    it("nested loops outer iteration correct") do ->
      assert_run_exits(av_nested_loop(), 100)
    end
    it("loop with function call in body") do ->
      assert_run_exits(av_func_call_loop(), 90)
    end
    it("large iteration count correct") do ->
      assert_run_exits(av_large_loop(), 44)
    end
    it("loop with break produces correct result") do ->
      assert_run_exits(av_break_loop(), 10)
    end
    it("loop counting down") do ->
      assert_run_exits(av_countdown_loop(), 55)
    end
    it("loop with bitwise operations") do ->
      assert_run_exits(av_bitwise_loop(), 15)
    end
    it("loop with compound assignment") do ->
      assert_run_exits(av_compound_loop(), 45)
    end
    it("simple array sum with indices") do ->
      assert_run_exits(av_array_sum(), 15)
    end
    it("loop body with multiple statements") do ->
      assert_run_exits(av_multi_stmt_loop(), 90)
    end
    it("empty loop (0 iterations)") do ->
      assert_run_exits(av_empty_loop(), 0)
    end
    it("loop with single iteration") do ->
      assert_run_exits(av_single_iter_loop(), 0)
    end
  end
  return qspec_main()
end

def av_basic_loop(): String = """
  def sum_array(arr: Int, n: Int): Int
    var total = 0
    var i = 0
    while i < n
      total += i
      i += 1
    end
    return total
  end
  def main(): Int
    sum_array(0, 100)
  end
  """

def av_sum_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 10
      total += i
      i += 1
    end
    total
  end
  """

def av_mul_loop(): String = """
  def main(): Int
    var result = 1
    var i = 1
    while i <= 10
      result = result * i
      i += 1
    end
    result
  end
  """

def av_cond_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 10
      if i % 2 == 0
        total += i
      end
      i += 1
    end
    total
  end
  """

def av_nested_loop(): String = """
  def main(): Int
    var count = 0
    var i = 0
    while i < 10
      var j = 0
      while j < 10
        count += 1
        j += 1
      end
      i += 1
    end
    count
  end
  """

def av_func_call_loop(): String = """
  def double(x: Int): Int = x * 2
  def main(): Int
    var total = 0
    var i = 0
    while i < 10
      total += double(i)
      i += 1
    end
    total
  end
  """

def av_large_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 1000
      total += i
      i += 1
    end
    total
  end
  """

def av_break_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 100
      if i == 5
        break
      end
      total += i
      i += 1
    end
    total
  end
  """

def av_countdown_loop(): String = """
  def main(): Int
    var total = 0
    var i = 10
    while i > 0
      total += i
      i -= 1
    end
    total
  end
  """

def av_bitwise_loop(): String = """
  def main(): Int
    var result = 0
    var i = 0
    while i < 4
      result = result | (1 << i)
      i += 1
    end
    result
  end
  """

def av_compound_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 10
      total += i
      i += 1
    end
    total
  end
  """

def av_array_sum(): String = """
  def main(): Int
    var v = vec_new()
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)
    vec_push(v, 4)
    vec_push(v, 5)
    var total = 0
    var i = 0
    while i < 5
      total += vec_get(v, i)
      i += 1
    end
    total
  end
  """

def av_multi_stmt_loop(): String = """
  def main(): Int
    var a = 0
    var b = 0
    var i = 0
    while i < 10
      a += i
      b += i
      i += 1
    end
    a + b
  end
  """

def av_empty_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 0
      total += i
      i += 1
    end
    total
  end
  """

def av_single_iter_loop(): String = """
  def main(): Int
    var total = 0
    var i = 0
    while i < 1
      total += i
      i += 1
    end
    total
  end
  """
