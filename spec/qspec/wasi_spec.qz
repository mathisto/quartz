## Wasi Tests
##
## Contract:
##   1. WASI Target.
##   2. Declaration gating.
##   3. @cfg with --target.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("WASI Target") do ->
    describe("declaration gating") do ->
      it("omits pthread declarations for wasm32-wasi") do ->
        var flags = "--target wasm32-wasi"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "@pthread", flags)
      end

      it("omits system/regcomp declarations for wasm32-wasi") do ->
        var flags = "--target wasm32-wasi"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "declare i32 @system", flags)
        assert_ir_not_contains_with_flags(src, "@regcomp", flags)
      end

      it("emits _start instead of main for wasm32-wasi") do ->
        var flags = "--target wasm32-wasi"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@_start", flags)
        assert_ir_not_contains_with_flags(src, "define i32 @main", flags)
      end

      it("uses correct triple for wasm32-wasi") do ->
        assert_ir_contains_with_flags("def main(): Int = 0", "wasm32-wasi", "--target wasm32-wasi")
      end
    end

    describe("@cfg with --target") do ->
      it("selects wasi branch with @cfg(os: wasi)") do ->
        var flags = "--target wasm32-wasi"
        var src = """
          @cfg(os: "wasi")
          def get_platform(): Int = 1

          @cfg(os: "macos")
          def get_platform(): Int = 2

          def main(): Int = get_platform()
        """
        assert_ir_contains_with_flags(src, "add i64 0, 1", flags)
      end

      it("selects wasm32 branch with @cfg(arch: wasm32)") do ->
        var flags = "--target wasm32-wasi"
        var src = """
          @cfg(arch: "wasm32")
          def get_arch(): Int = 32

          @cfg(arch: "aarch64")
          def get_arch(): Int = 64

          def main(): Int = get_arch()
        """
        assert_ir_contains_with_flags(src, "add i64 0, 32", flags)
      end
    end
  end

  return qspec_main()
end
