## Slice<T> / SliceMut<T> Tests (Tier 4 #24 Phase 1+2)
##
## Contract:
##   1. slice() returns Slice<T> typed as a 16-byte {ptr, len} view.
##   2. v[a..b], v[a..], v[..b], v[..] all produce slice-shaped results.
##   3. Inclusive range v[a...b] works in partial positions too.
##   4. Slice<T> exposes .size / .len / .get / .empty? via UFCS.
##   5. SliceMut<T> additionally exposes .set; mutation is visible in the Vec.
##   6. Empty slice: slice(v, n, n).size == 0.
##
## Layout note: slice() currently produces a heap-allocated 16-byte
## {data_ptr, len} header (see cg_intrinsic_collection.qz). v[a..b] syntax
## still emits vec_slice (24-byte Vec copy) — Phase 3 will unify. Tests
## below cover what the new type system delivers today.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Slice<T> construction") do ->
    it("slice(v, a, b) yields a Slice<T> with correct length") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s: Slice<Int> = slice(v, 1, 3)
      assert_eq(s.size, 2)
    end

    it("empty slice: slice(v, n, n).size == 0") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      var s: Slice<Int> = slice(v, 1, 1)
      assert_eq(s.size, 0)
    end

    it("full slice: slice(v, 0, size) reads every element") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var s: Slice<Int> = slice(v, 0, 3)
      assert_eq(s.size, 3)
      assert_eq(s.get(0), 10)
      assert_eq(s.get(2), 30)
    end
  end

  describe("Range-indexing surface syntax") do ->
    it("v[a..b] size is b - a") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      v.push(50)
      var s = v[1..4]
      assert_eq(s.size, 3)
    end

    it("v[a..] runs to the end") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = v[2..]
      assert_eq(s.size, 2)
    end

    it("v[..b] starts at zero") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = v[..3]
      assert_eq(s.size, 3)
    end

    it("v[..] covers the whole vector") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var s = v[..]
      assert_eq(s.size, 3)
    end

    it("v[a...b] inclusive range still works") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = v[1...2]
      assert_eq(s.size, 2)
    end
  end

  describe("Slice<T> UFCS dispatch") do ->
    it(".len is an alias for .size") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var s: Slice<Int> = slice(v, 0, 3)
      assert_eq(s.len(), s.size)
    end

    it(".get(i) reads the i-th element of the slice") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s: Slice<Int> = slice(v, 1, 4)
      assert_eq(s.get(0), 20)
      assert_eq(s.get(1), 30)
      assert_eq(s.get(2), 40)
    end
  end

  describe("SliceMut<T> write dispatch") do ->
    it(".set(i, v) writes through to the underlying Vec") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var m: SliceMut<Int> = slice(v, 0, 3)
      m.set(1, 99)
      assert_eq(v[1], 99)
    end
  end

  describe("Borrow-checker integration (Phase 3)") do ->
    it("NLL drops the borrow at the end of the slice's scope") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      if 1 == 1
        var s: Slice<Int> = slice(v, 0, 2)
        assert_eq(s.size, 2)
      end
      v[0] = 99
      assert_eq(v[0], 99)
    end

    it("reading the Vec is allowed while a shared slice is live") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      var s: Slice<Int> = slice(v, 0, 2)
      assert_eq(v[0], 10)
      assert_eq(s.size, 2)
    end
  end

  describe("for-in iteration over Slice<T> (Phase 4)") do ->
    it("iterates all elements in order") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      v.push(50)
      var s: Slice<Int> = slice(v, 1, 4)
      var total = 0
      for x in s
        total = total + x
      end
      assert_eq(total, 90)
    end

    it("empty slice yields zero iterations") do ->
      var v = vec_new()
      v.push(1)
      var s: Slice<Int> = slice(v, 0, 0)
      var ran = 0
      for x in s
        ran = ran + 1
      end
      assert_eq(ran, 0)
    end
  end

  describe("UFCS-mutation borrow-check (Phase 4b §2.5)") do ->
    it("v.push(X) while slice is live raises QZ1209") do ->
      assert_compile_error("""
        def main(): Int
          var v = vec_new()
          v.push(10)
          v.push(20)
          var s: Slice<Int> = slice(v, 0, 2)
          v.push(99)
          return s.size
        end
        """, "QZ1209")
    end

    it("v.clear() while slice is live raises QZ1209") do ->
      assert_compile_error("""
        def main(): Int
          var v = vec_new()
          v.push(10)
          var s: Slice<Int> = slice(v, 0, 1)
          v.clear()
          return s.size
        end
        """, "QZ1209")
    end

    it("v.sort() while slice is live raises QZ1209") do ->
      assert_compile_error("""
        def main(): Int
          var v = vec_new()
          v.push(3)
          v.push(1)
          v.push(2)
          var s: Slice<Int> = slice(v, 0, 3)
          v.sort()
          return s.size
        end
        """, "QZ1209")
    end

    it("v.push(X) after slice scope ends is OK") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(10)
          if 1 == 1
            var s: Slice<Int> = slice(v, 0, 1)
            var _k = s.size
          end
          v.push(99)
          return 0
        end
        """, 0)
    end

    it("v.size() while slice is live is OK (non-mutating)") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(10)
          v.push(20)
          var s: Slice<Int> = slice(v, 0, 2)
          var _n = v.size
          var _m = s.size
          return 0
        end
        """, 0)
    end
  end

  describe("Vec<T> → Slice<T> auto-coerce (Phase 4b §2.1)") do ->
    it("Vec<Int> auto-coerces to Slice<Int> at call sites") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(_takes_slice(v), 3)
    end

    it("auto-coerce covers the whole vector") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      assert_eq(_sum_slice(v), 10)
    end

    it("empty Vec coerces to empty slice") do ->
      var v = vec_new()
      assert_eq(_takes_slice(v), 0)
    end

    it("Vec<Int> auto-coerces to SliceMut<Int>") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      _zero_first(v)
      assert_eq(v[0], 0)
      assert_eq(v[1], 20)
    end
  end

  describe("v[a..b] zero-copy switch (Phase 4b §2.4)") do ->
    it("v[a..b] now produces Slice<T>, not Vec<T>") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.push(40)
      var s = v[1..3]
      assert_eq(s.size, 2)
      assert_eq(s[0], 20)
      assert_eq(s[1], 30)
    end

    it("v[a..b] on array literal yields Slice<Int>") do ->
      var v = [10, 20, 30, 40, 50]
      var s = v[1..4]
      assert_eq(s[0] + s[1] + s[2], 90)
    end

    it("v[a..b] inclusive range still works") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      var s = v[1...3]
      assert_eq(s.size, 3)
      assert_eq(s[0] + s[1] + s[2], 9)
    end

    it("zero-copy: mutating original Vec after scope end changes are visible via new slice") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      var s1 = v[0..2]
      assert_eq(s1[0], 10)
      # s1 drops at scope end — v[0] = 99 allowed after
      v[0] = 99
      var s2 = v[0..2]
      assert_eq(s2[0], 99)
    end

    it("v[..] full slice via partial range") do ->
      var v = [100, 200, 300]
      var s = v[..]
      assert_eq(s.size, 3)
      assert_eq(s[2], 300)
    end

    it("for-in over v[a..b] iterates slice") do ->
      var v = [10, 20, 30, 40, 50]
      var total = 0
      for x in v[1..4]
        total = total + x
      end
      assert_eq(total, 90)
    end
  end

  describe("Slice::EMPTY constant (Phase 4b §2.3)") do ->
    it("Slice::EMPTY is zero-length") do ->
      var s: Slice<Int> = Slice::EMPTY
      assert_eq(s.size, 0)
    end

    it("Slice::EMPTY has empty? true") do ->
      var s: Slice<Int> = Slice::EMPTY
      assert_eq(s.len(), 0)
    end

    it("SliceMut::EMPTY is zero-length") do ->
      var m: SliceMut<Int> = SliceMut::EMPTY
      assert_eq(m.size, 0)
    end

    it("Slice::EMPTY returned from a function") do ->
      assert_eq(_empty_slice().size, 0)
    end

    it("Slice::EMPTY iterates zero times") do ->
      var s: Slice<Int> = Slice::EMPTY
      var ran = 0
      for x in s
        ran = ran + 1
      end
      assert_eq(ran, 0)
    end
  end

  describe("String → Slice<Byte> bridge (Phase 4b §2.2)") do ->
    it("str_as_byte_slice exposes the byte buffer") do ->
      var s: Slice<Byte> = str_as_byte_slice("AB")
      assert_eq(s.size, 2)
      assert_eq(s.get(0), 65)
      assert_eq(s.get(1), 66)
    end

    it("empty string yields empty byte slice") do ->
      var s: Slice<Byte> = str_as_byte_slice("")
      assert_eq(s.size, 0)
    end

    it("String auto-coerces to Slice<Byte> at call sites") do ->
      assert_eq(_byte_sum("AB"), 131)
    end

    it("for-in over Slice<Byte> reads bytes 0..255") do ->
      assert_eq(_byte_sum("ABC"), 198)
    end

    it("non-ASCII bytes come through unchanged") do ->
      var s: Slice<Byte> = str_as_byte_slice("\xFF")
      assert_eq(s.size, 1)
      assert_eq(s.get(0), 255)
    end
  end

  # Tier 4 #24 wide-element stride support: Slice<T> for @value structs
  # with elem_width > 8 (Point=16, RGB=24, etc.) must stride by elem_width
  # bytes, not 8. Slice header carries elem_width at slot[2] (24-byte layout).
  describe("wide-element stride") do ->
    it("Vec<Point>[0..2] reads correct struct boundaries") do ->
      var ws_pts_a = vec_new<Point>()
      ws_pts_a.push(Point { x: 1, y: 2 })
      ws_pts_a.push(Point { x: 3, y: 4 })
      ws_pts_a.push(Point { x: 5, y: 6 })
      var ws_s_a: Slice<Point> = slice(ws_pts_a, 0, 2)
      assert_eq(ws_s_a.size, 2)
      var ws_a0 = ws_s_a.get(0)
      var ws_a1 = ws_s_a.get(1)
      assert_eq(ws_a0.x, 1)
      assert_eq(ws_a0.y, 2)
      assert_eq(ws_a1.x, 3)
      assert_eq(ws_a1.y, 4)
    end

    it("Vec<Point>[1..3] starts at correct offset") do ->
      var ws_pts_b = vec_new<Point>()
      ws_pts_b.push(Point { x: 1, y: 2 })
      ws_pts_b.push(Point { x: 3, y: 4 })
      ws_pts_b.push(Point { x: 5, y: 6 })
      var ws_s_b: Slice<Point> = slice(ws_pts_b, 1, 3)
      var ws_b0 = ws_s_b.get(0)
      var ws_b1 = ws_s_b.get(1)
      assert_eq(ws_b0.x, 3)
      assert_eq(ws_b1.y, 6)
    end

    it("range syntax v[a..b] over Vec<Point> strides correctly") do ->
      var ws_pts_c = vec_new<Point>()
      ws_pts_c.push(Point { x: 10, y: 20 })
      ws_pts_c.push(Point { x: 30, y: 40 })
      ws_pts_c.push(Point { x: 50, y: 60 })
      var ws_s_c = ws_pts_c[1..3]
      var ws_c0 = ws_s_c.get(0)
      var ws_c1 = ws_s_c.get(1)
      assert_eq(ws_c0.x, 30)
      assert_eq(ws_c0.y, 40)
      assert_eq(ws_c1.x, 50)
      assert_eq(ws_c1.y, 60)
    end

    it("SliceMut<Point>.set writes whole struct at correct offset") do ->
      var ws_pts_d = vec_new<Point>()
      ws_pts_d.push(Point { x: 1, y: 2 })
      ws_pts_d.push(Point { x: 3, y: 4 })
      var ws_m_d: SliceMut<Point> = slice(ws_pts_d, 0, 2)
      ws_m_d.set(1, Point { x: 99, y: 100 })
      var ws_d_back = ws_pts_d[1]
      assert_eq(ws_d_back.x, 99)
      assert_eq(ws_d_back.y, 100)
    end

    it("Slice<Point>::EMPTY has elem_width default but len=0") do ->
      var ws_e_empty: Slice<Point> = Slice::EMPTY
      assert_eq(ws_e_empty.size, 0)
    end
  end

  # Tier 4 #24 follow-up: nested slicing — `s[a..b]` where s is already
  # a Slice<T>. MIR detects the Slice base type and dispatches to `subslice`
  # which reads the source's 24-byte header layout (vs `slice` which reads
  # Vec's 32-byte layout). Pre-fix: silent wrong-data (read past slice header).
  describe("nested slicing") do ->
    it("nested slice on Slice<Int> reads correct values") do ->
      var ns_v = vec_new<Int>()
      ns_v.push(10)
      ns_v.push(20)
      ns_v.push(30)
      ns_v.push(40)
      ns_v.push(50)
      var ns_s: Slice<Int> = slice(ns_v, 1, 4)
      var ns_s2 = ns_s[0..2]
      assert_eq(ns_s2.size, 2)
      assert_eq(ns_s2.get(0), 20)
      assert_eq(ns_s2.get(1), 30)
    end

    it("nested slice with offset starts at correct element") do ->
      var ns_v2 = vec_new<Int>()
      ns_v2.push(100)
      ns_v2.push(200)
      ns_v2.push(300)
      ns_v2.push(400)
      ns_v2.push(500)
      var ns_outer: Slice<Int> = slice(ns_v2, 1, 5)
      var ns_inner = ns_outer[1..3]
      assert_eq(ns_inner.size, 2)
      assert_eq(ns_inner.get(0), 300)
      assert_eq(ns_inner.get(1), 400)
    end

    it("nested slice with open-ended range s[a..]") do ->
      var ns_v3 = vec_new<Int>()
      ns_v3.push(1)
      ns_v3.push(2)
      ns_v3.push(3)
      ns_v3.push(4)
      var ns_outer3: Slice<Int> = slice(ns_v3, 0, 4)
      var ns_tail = ns_outer3[2..]
      assert_eq(ns_tail.size, 2)
      assert_eq(ns_tail.get(0), 3)
      assert_eq(ns_tail.get(1), 4)
    end

    it("nested slice on Slice<Point> preserves wide stride") do ->
      var ns_pts = vec_new<Point>()
      ns_pts.push(Point { x: 1, y: 2 })
      ns_pts.push(Point { x: 3, y: 4 })
      ns_pts.push(Point { x: 5, y: 6 })
      ns_pts.push(Point { x: 7, y: 8 })
      var ns_outer_p: Slice<Point> = slice(ns_pts, 1, 4)
      var ns_inner_p = ns_outer_p[0..2]
      assert_eq(ns_inner_p.size, 2)
      var ns_p0 = ns_inner_p.get(0)
      var ns_p1 = ns_inner_p.get(1)
      assert_eq(ns_p0.x, 3)
      assert_eq(ns_p0.y, 4)
      assert_eq(ns_p1.x, 5)
      assert_eq(ns_p1.y, 6)
    end
  end

  return qspec_main()
end

@value
struct Point
  x: Int
  y: Int
end

def _takes_slice(s: Slice<Int>): Int = s.size

def _empty_slice(): Slice<Int> = Slice::EMPTY

def _byte_sum(s: Slice<Byte>): Int
  var total = 0
  for b in s
    total = total + b
  end
  return total
end

def _sum_slice(s: Slice<Int>): Int
  var total = 0
  for x in s
    total = total + x
  end
  return total
end

def _zero_first(m: SliceMut<Int>): Void
  m.set(0, 0)
end
