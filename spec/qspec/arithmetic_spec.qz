## Arithmetic Tests
##
## Contract:
##   1. Integer literals.
##   2. Addition.
##   3. Subtraction.
##   4. Multiplication.
##   5. Division.
##   6. Modulo.
##   7. Operator precedence.
##   8. Variables.
##   9. Arithmetic properties.
##
## Compile: self-hosted/bin/quartz-new2 build spec/qspec/arithmetic_spec.qz --stdlib-path std > /tmp/arith.ll
## Link:    clang -O2 -x ir /tmp/arith.ll -o /tmp/arith_spec
## Run:     /tmp/arith_spec

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Integer Literals
  # ==========================================================================

  describe("integer literals") do ->
    it("returns an integer literal") do ->
      assert_eq(42, 42)
    end

    it("returns zero") do ->
      assert_eq(0, 0)
    end

    it("returns negative via subtraction") do ->
      var result = 10 - 15
      assert_eq(result, -5)
    end
  end

  # ==========================================================================
  # Addition
  # ==========================================================================

  describe("addition") do ->
    it("adds two integers") do ->
      assert_eq(1 + 2, 3)
    end

    it("adds multiple integers") do ->
      assert_eq(1 + 2 + 3 + 4, 10)
    end
  end

  # ==========================================================================
  # Subtraction
  # ==========================================================================

  describe("subtraction") do ->
    it("subtracts two integers") do ->
      assert_eq(10 - 3, 7)
    end
  end

  # ==========================================================================
  # Multiplication
  # ==========================================================================

  describe("multiplication") do ->
    it("multiplies two integers") do ->
      assert_eq(6 * 7, 42)
    end
  end

  # ==========================================================================
  # Division
  # ==========================================================================

  describe("division") do ->
    it("divides two integers") do ->
      assert_eq(100 / 10, 10)
    end

    it("truncates toward zero") do ->
      assert_eq(7 / 2, 3)
    end
  end

  # ==========================================================================
  # Modulo
  # ==========================================================================

  describe("modulo") do ->
    it("computes remainder") do ->
      assert_eq(17 % 5, 2)
    end
  end

  # ==========================================================================
  # Operator Precedence
  # ==========================================================================

  describe("operator precedence") do ->
    it("respects multiplication over addition") do ->
      assert_eq(2 + 3 * 4, 14)
    end

    it("respects parentheses") do ->
      assert_eq((2 + 3) * 4, 20)
    end
  end

  # ==========================================================================
  # Variables
  # ==========================================================================

  describe("variables") do ->
    it("uses let bindings") do ->
      x = 10
      y = 20
      assert_eq(x + y, 30)
    end

    it("reassigns variables") do ->
      var x = 10
      x = 20
      assert_eq(x, 20)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("arithmetic properties") do ->
    property_commutative("addition is commutative", arith_add)
    property_commutative("multiplication is commutative", arith_mul)
    property_identity("additive identity (n + 0 = n)", arith_add, 0)
    property_identity("multiplicative identity (n * 1 = n)", arith_mul, 1)

    forall_ii("subtraction inverse: (a + b) - b == a") do x: Int, y: Int ->
      assert_eq((x + y) - y, x)
    end

    forall_i("multiplication annihilator: n * 0 == 0") do x: Int ->
      assert_eq(x * 0, 0)
    end

    forall_i("subtraction self-inverse: n - n == 0") do x: Int ->
      assert_eq(x - x, 0)
    end

    forall_ii("distributive: a * (b + c) == a*b + a*c") do a: Int, b: Int ->
      var c = a % 100
      assert_eq(a * (b + c), a * b + a * c)
    end
  end

  return qspec_main()
end

def arith_add(a: Int, b: Int): Int = a + b
def arith_mul(a: Int, b: Int): Int = a * b
