## Regression spec for as_type<m::T>(handle) module-qualified type-arg.
##
## Pre-fix bug (AS_TYPE_MODULE_QUALIFIED_CODEGEN_FAIL): the parser's
## typed-call type-arg branch (parser.qz:3040) consumed only a single
## IDENT, so `as_type<w::Widget>(handle)` failed to match the typed-call
## shape entirely. The expression then re-parsed as
##   (as_type < w::Widget) > (handle)
## where `w::Widget` got alias-resolved to a bare `Widget` ident, which
## in turn reached codegen as an unresolved PascalCase identifier
## (QZ9501 ICE).
##
## Fix: parser type-arg now consumes `IDENT (:: IDENT)+` and applies the
## same alias-vs-module discrimination as parser.qz:1895. For
## `alias::Type`, the alias is dropped (types live globally). For
## `module::Type`, the segments concatenate with `$` (module-mangled).
##
## NOTE (item 45, F4 value-default flip): the embedded `Widget` is marked
## `@repr(C)` to pin it to reference layout. `as_int`/`as_type` are
## pointer-identity reinterprets, valid ONLY for reference-layout structs;
## under the value-default flip a plain `Widget` would become value-layout
## and `as_int(widget)` would (correctly) raise QZ0221. This spec's purpose
## is module-qualified `as_type<m::T>` parsing — the int-erasure is just
## incidental plumbing — so pinning the struct keeps coverage at both flip
## states. Do NOT remove the `@repr(C)`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("as_type<m::T> module-qualified type-arg") do ->

    it("resolves alias::Type and recovers the value") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("widget.qz"))
      var widget_src = """
@repr(C)
struct Widget
  v: Int
end

def widget_new(): Widget = Widget { v: 42 }
"""
      vec_push(files, as_int(widget_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import widget as w

def main(): Int
  var handle: Int = as_int(w::widget_new())
  var t: w::Widget = as_type<w::Widget>(handle)
  return t.v
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("does not regress unqualified as_type<T>") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("widget.qz"))
      var widget_src = """
@repr(C)
struct Widget
  v: Int
end

def widget_new(): Widget = Widget { v: 7 }
"""
      vec_push(files, as_int(widget_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import widget as w

def main(): Int
  var handle: Int = as_int(w::widget_new())
  var t: Widget = as_type<Widget>(handle)
  return t.v
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 7)
    end

  end
  return qspec_main()
end
