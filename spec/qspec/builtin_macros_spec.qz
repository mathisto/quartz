## Built-in Macros Tests
##
## Contract:
##   1. $try.
##   2. $unwrap.
##   3. $assert.
##   4. Panic.
##   5. $try edge cases.
##   6. $unwrap edge cases.
##   7. $assert edge cases.
##   8. $debug.
##   9. Return in match arms (ty_never).
import * from qspec

def bm_get_value(): Int = Option::Some(42)
def bm_get_none(): Int = Option::None

def bm_try_some(): Int
  x = try bm_get_value()
  return Option::Some(x + 1)
end

def bm_try_none(): Int
  x = try bm_get_none()
  return Option::Some(x + 1)
end

def bm_step1(): Int = Option::Some(10)
def bm_step2(x: Int): Int = Option::Some(x * 2)

def bm_chain(): Int
  a = try bm_step1()
  b = try bm_step2(a)
  return Option::Some(b + 5)
end

def bm_chain_short(): Int
  a = try bm_get_none()
  b = try bm_step2(a)
  return Option::Some(b + 5)
end

def bm_try_inline(): Int
  x = try Option::Some(99)
  return Option::Some(x)
end

def bm_try_conditional(flag: Int): Int
  if flag
    x = try Option::Some(100)
    return Option::Some(x)
  end
  return Option::None
end

def bm_try_loop(): Int
  var i = 0
  while i < 5
    if i == 3
      x = try Option::None
      return Option::Some(x)
    end
    i = i + 1
  end
  return Option::Some(99)
end

def bm_add_options(a: Int, b: Int): Int
  va = try a
  vb = try b
  return Option::Some(va + vb)
end

def bm_get_some(): Int = Option::Some(77)

def bm_is_positive(x: Int): Int
  if x > 0
    return 1
  end
  return 0
end

def bm_match_option(opt: Int): Int
  return match opt
    Some(v) => v
    None => -1
    _ => -2
  end
end

def bm_classify(x: Int): Int
  result = match x
    0 => return -1
    1 => 100
    _ => 200
  end
  return result
end

def bm_check(x: Int): Int
  result = match x
    1 => 10
    2 => return 99
    _ => 30
  end
  return result
end

def main(): Int
  describe("$try") do ->
    it("unwraps Some and returns the value") do ->
      assert_eq(bm_match_option(bm_try_some()), 43)
    end

    it("propagates None by early-returning") do ->
      assert_eq(bm_match_option(bm_try_none()), -1)
    end

    it("works in a chain of try calls") do ->
      assert_eq(bm_match_option(bm_chain()), 25)
    end

    it("short-circuits on first None in a chain") do ->
      assert_eq(bm_match_option(bm_chain_short()), -1)
    end
  end

  describe("$unwrap") do ->
    it("unwraps Some and returns the value") do ->
      opt = Option::Some(42)
      x = $unwrap(opt)
      assert_eq(x, 42)
    end

    it("panics with location info on None") do ->
      assert_run_panics("""
def main(): Int
  opt = Option::None
  x = $unwrap(opt)
  print_int(x)
  return 0
end
""", "unwrap failed")
    end
  end

  describe("$assert") do ->
    it("passes when condition is true") do ->
      $assert(1 == 1)
      assert_eq(1, 1)
    end

    it("panics with location info when condition is false") do ->
      assert_run_panics("""
def main(): Int
  $assert(1 == 2)
  print_int(42)
  return 0
end
""", "ssertion failed")
    end
  end

  describe("panic") do ->
    it("outputs panic message on panic") do ->
      assert_run_panics("""
def main(): Int
  panic("hello")
  return 0
end
""", "hello")
    end
  end

  describe("$try edge cases") do ->
    it("works with inline expressions") do ->
      assert_eq(bm_match_option(bm_try_inline()), 99)
    end

    it("works inside an if body") do ->
      assert_eq(bm_match_option(bm_try_conditional(1)), 100)
    end

    it("early-returns from inside a loop") do ->
      assert_eq(bm_match_option(bm_try_loop()), -1)
    end

    it("works with multiple $try on the same line of logic") do ->
      r = bm_add_options(Option::Some(10), Option::Some(20))
      assert_eq(bm_match_option(r), 30)
    end
  end

  describe("$unwrap edge cases") do ->
    it("unwraps an expression result directly") do ->
      x = $unwrap(bm_get_some())
      assert_eq(x, 77)
    end
  end

  describe("$assert edge cases") do ->
    it("works with complex boolean expressions") do ->
      x = 10
      $assert(x > 5)
      $assert(x < 20)
      assert_eq(x, 10)
    end

    it("works with function call conditions") do ->
      $assert(bm_is_positive(42) == 1)
      assert_eq(1, 1)
    end

    it("multiple asserts in sequence") do ->
      $assert(1 == 1)
      $assert(2 + 2 == 4)
      $assert(10 > 5)
      assert_eq(99, 99)
    end
  end

  describe("$debug") do ->
    it("prints debug prefix and value to stderr") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(42)
  return 0
end
""", "42")
    end

    it("evaluates the expression") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(10 + 20)
  return 0
end
""", "30")
    end

    it("works with variable references") do ->
      assert_run_stderr_contains("""
def main(): Int
  x = 555
  $debug(x)
  return 0
end
""", "555")
    end

    it("returns the value") do ->
      assert_run_stdout_eq("""
def main(): Int
  x = $debug(42)
  print_int(x)
  return 0
end
""", "42\n")
    end

    it("can be used in expression position") do ->
      assert_run_stdout_eq("""
def main(): Int
  print_int($debug(40) + 2)
  return 0
end
""", "42\n")
    end

    it("evaluates expression exactly once") do ->
      assert_run_stdout_eq("""
var counter = 0
def bump(): Int
  counter = counter + 1
  return counter
end
def main(): Int
  x = $debug(bump())
  print_int(x)
  print_int(counter)
  return 0
end
""", "1\n1\n")
    end
  end

  describe("return in match arms (TY_NEVER)") do ->
    it("allows return in match arm alongside value-producing arms") do ->
      assert_eq(bm_classify(0), -1)
    end

    it("allows return in any position of match arms") do ->
      assert_eq(bm_check(1), 10)
      assert_eq(bm_check(2), 99)
      assert_eq(bm_check(3), 30)
    end
  end

  return qspec_main()
end
