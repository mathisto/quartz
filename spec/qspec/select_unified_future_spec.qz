## C.13 Phase 5 — FutureSelectable round-trip through real Selectable
## trait dispatch. Exercises:
##   - awaitable(task) wraps a go/async handle as a Selectable
##   - try_poll reads frame[0] state; returns Some(frame[1]) if done
##   - non-destructive: result lives in option payload, complete is no-op
##   - bound value flows through to the arm body (unlike Deadline /
##     ScopeCancel where complete throws)
##
## Phase 5 hardening (May 10 2026): Pre-Phase-5, the tests below used
## `case ... default => got = -2` as a hang guard against the race where
## `go (-> v)` from a top-level def spawns a real worker thread that
## hadn't completed by the time try_poll ran. With Phase 5's active-wake
## (FutureSelectable.register_waker → __qz_waiter_register; task_done
## → __qz_waiter_notify_all → sched_wake), the select PARKS until
## the worker completes the future, so the hang guard is no longer
## load-bearing AND introduced a false-fire race (default short-circuit
## fired before worker completion). The default arm is removed below;
## any leftover hang means active-wake is broken.

import * from qspec
import * from std/sync/composition/awaitable
import * from std/sync/communication/channel

# Done-task helper. `go (-> v)` from a top-level def spawns a real
# worker; the polling task parks via Phase 5 active-wake until the
# worker calls task_done on completion.
def make_done_task(v: Int): Int
  return go (-> v)
end

def test_awaitable_fires_on_done_task(): Int
  var t = make_done_task(42)
  var got = -1
  select
    case x = awaitable(t) => got = x
  end
  return got
end

def test_awaitable_value_zero(): Int
  var t = make_done_task(0)
  var fired = -1
  var got = -1
  select
    case x = awaitable(t) => fired = 1
                            got = x
  end
  return fired * 1000 + got
end

def test_awaitable_value_negative(): Int
  var t = make_done_task(-5)
  var got = -999
  select
    case x = awaitable(t) => got = x
  end
  return got
end

def test_awaitable_underscore_binding(): Int
  var t = make_done_task(77)
  var fired = 0
  select
    case _ = awaitable(t) => fired = 1
  end
  return fired
end

def test_two_awaitable_arms_first_wins(): Int
  var t1 = make_done_task(11)
  var t2 = make_done_task(22)
  var got = -1
  select
    case x = awaitable(t1) => got = x
    case y = awaitable(t2) => got = 100 + y
  end
  # Either arm winning is acceptable; both eventually become ready and
  # whichever's task_done fires first wakes the polling task. Phase 14
  # fairness still shuffles the try-order, but the actual win depends on
  # worker timing now.
  if got == 11
    return 1
  end
  if got == 122
    return 1
  end
  return 0
end

def test_recv_beats_unfinished_awaitable(): Int
  # Channel is ready synchronously; future is a real spawn that may or
  # may not complete before recv-arm fires. Either is acceptable —
  # assert any ready-arm wins.
  var ch = channel_new(1)
  send(ch, 99)
  var got = -1
  var t = make_done_task(7)
  select
    case v = recvable(ch) => got = v
    case x = awaitable(t) => got = 1000 + x
  end
  if got == 99
    return 1
  end
  if got == 1007
    return 1
  end
  return 0
end

def main(): Int
  describe("select unified — FutureSelectable trait dispatch") do ->
    it("awaitable arm fires when task is done") do ->
      assert_eq(test_awaitable_fires_on_done_task(), 42)
    end
    it("awaitable arm binds value 0 (not confused with default-fallthrough)") do ->
      assert_eq(test_awaitable_value_zero(), 1000)
    end
    it("awaitable arm binds negative result") do ->
      assert_eq(test_awaitable_value_negative(), -5)
    end
    it("awaitable arm with `_` wildcard binding fires the body") do ->
      assert_eq(test_awaitable_underscore_binding(), 1)
    end
    it("two ready awaitable arms — fairness shuffle picks one") do ->
      assert_eq(test_two_awaitable_arms_first_wins(), 1)
    end
    it("recvable + awaitable both ready — fairness shuffle picks one") do ->
      assert_eq(test_recv_beats_unfinished_awaitable(), 1)
    end
  end

  return qspec_main()
end
