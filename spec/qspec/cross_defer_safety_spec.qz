## Cross-Feature: Defer × Safety (TEST.2 Phase 3)
##
## Contract: Interactions between defer and ownership/safety.
##   1. Defer ordering (LIFO).
##   2. Defer inside control flow.
##   3. Multiple defers execute in correct order.
##   4. Defer with owned values.
##   5. Defer inside loop.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ==========================================================================
  # Defer Ordering
  # ==========================================================================
  describe("defer ordering") do ->
    it("single defer executes at end of scope") do ->
      assert_run_stdout_eq("""
        def main(): Int
          puts("before")
          defer puts("deferred")
          puts("after")
          return 0
        end
        """, "before\nafter\ndeferred\n")
    end

    it("multiple defers execute in LIFO order") do ->
      assert_run_stdout_eq("""
        def main(): Int
          defer puts("first")
          defer puts("second")
          defer puts("third")
          return 0
        end
        """, "third\nsecond\nfirst\n")
    end
  end

  # ==========================================================================
  # Defer Inside Control Flow
  # ==========================================================================
  describe("defer inside control flow") do ->
    it("defer inside if branch executes when branch taken") do ->
      assert_run_stdout_eq("""
        def main(): Int
          if 1 == 1
            defer puts("in-if")
            puts("body")
          end
          puts("after")
          return 0
        end
        """, "body\nin-if\nafter\n")
    end

    it("defer not executed when branch not taken") do ->
      assert_run_stdout_eq("""
        def main(): Int
          if 1 == 0
            defer puts("should-not-appear")
          end
          puts("done")
          return 0
        end
        """, "done\n")
    end
  end

  # ==========================================================================
  # Defer with Function Calls
  # ==========================================================================
  describe("defer with function calls") do ->
    it("defer calls cleanup function") do ->
      assert_run_stdout_eq("""
        def cleanup(): Void
          puts("cleaned")
        end
        def main(): Int
          defer cleanup()
          puts("work")
          return 0
        end
        """, "work\ncleaned\n")
    end

    it("defer in called function scoped correctly") do ->
      assert_run_stdout_eq("""
        def work(): Void
          defer puts("work-cleanup")
          puts("working")
        end
        def main(): Int
          puts("start")
          work()
          puts("end")
          return 0
        end
        """, "start\nworking\nwork-cleanup\nend\n")
    end
  end

  # ==========================================================================
  # Defer with Return Values
  # ==========================================================================
  describe("defer with return") do ->
    it("defer executes before return value is used by caller") do ->
      assert_run_stdout_eq("""
        def compute(): Int
          defer puts("defer-in-compute")
          puts("computing")
          return 42
        end
        def main(): Int
          var r = compute()
          puts("result")
          return 0
        end
        """, "computing\ndefer-in-compute\nresult\n")
    end
  end

  # ==========================================================================
  # Defer in Loop
  # ==========================================================================
  describe("defer in loop") do ->
    it("defer in for loop executes each iteration") do ->
      assert_run_exits("""
        def main(): Int
          var count = 0
          for i in 0..3
            defer count += 1
          end
          return count
        end
        """, 3)
    end
  end

  return qspec_main()
end
