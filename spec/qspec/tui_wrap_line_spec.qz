## std/tui/layout::wrap_line behaviour tests.
##
## Coverage:
##   - empty string → single empty segment
##   - line shorter than width fits on one line
##   - greedy word break at whitespace
##   - whitespace at wrap point is dropped
##   - oversized word hard-cuts at width
##   - styled span wrapped: open SGR closed at line break
##   - already-reset styled span needs no extra reset
##   - width <= 0 returns the line as-is
##   - wide codepoints contribute 2 cells
##   - run of trailing whitespace doesn't produce a phantom blank line

import * from qspec
import std/tui/layout as ly

def test_empty_string_yields_one_empty_segment(): Void
  var v = ly::wrap_line("", 10)
  assert_eq(v.size, 1)
  assert_eq_str(v[0], "")
end

def test_short_line_returns_one_segment(): Void
  var v = ly::wrap_line("hello", 10)
  assert_eq(v.size, 1)
  assert_eq_str(v[0], "hello")
end

def test_greedy_break_at_whitespace(): Void
  var v = ly::wrap_line("hello world", 5)
  assert_eq(v.size, 2)
  assert_eq_str(v[0], "hello")
  assert_eq_str(v[1], "world")
end

def test_three_words_two_lines(): Void
  var v = ly::wrap_line("the quick brown", 10)
  assert_eq(v.size, 2)
  assert_eq_str(v[0], "the quick")
  assert_eq_str(v[1], "brown")
end

def test_oversized_word_hard_cut(): Void
  var v = ly::wrap_line("supercalifragilistic", 5)
  assert_eq(v.size, 4)
  assert_eq_str(v[0], "super")
  assert_eq_str(v[1], "calif")
  assert_eq_str(v[2], "ragil")
  assert_eq_str(v[3], "istic")
end

def test_styled_span_wrap_appends_reset(): Void
  ## Single styled span longer than width — hard-cut, every cut
  ## segment that carries an open SGR gets `\x1b[0m` appended.
  var input = "\x1b[31mredwordtoolong\x1b[0m"
  var v = ly::wrap_line(input, 5)
  ## First segment carries the opener; gets reset appended.
  if str_contains(v[0], "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_already_reset_segment_no_double_reset(): Void
  ## A segment ending in `\x1b[0m` shouldn't get a second reset.
  var v = ly::wrap_line("\x1b[31mhi\x1b[0m there", 5)
  ## v[0] = "\x1b[31mhi\x1b[0m"; should not have a trailing `\x1b[0m\x1b[0m`.
  if str_contains(v[0], "\x1b[0m\x1b[0m")
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_zero_width_returns_input_as_one_segment(): Void
  var v = ly::wrap_line("hello world", 0)
  assert_eq(v.size, 1)
  assert_eq_str(v[0], "hello world")
end

def test_negative_width_returns_input_as_one_segment(): Void
  var v = ly::wrap_line("hello world", -5)
  assert_eq(v.size, 1)
  assert_eq_str(v[0], "hello world")
end

def test_word_exactly_at_width(): Void
  var v = ly::wrap_line("hello world", 11)
  assert_eq(v.size, 1)
  assert_eq_str(v[0], "hello world")
end

def test_two_words_each_exactly_width(): Void
  var v = ly::wrap_line("aaaaa bbbbb", 5)
  assert_eq(v.size, 2)
  assert_eq_str(v[0], "aaaaa")
  assert_eq_str(v[1], "bbbbb")
end

def main(): Int
  describe("wrap_line basics") do ->
    it("empty string yields one empty segment") do ->
      test_empty_string_yields_one_empty_segment()
    end
    it("short line returns one segment") do ->
      test_short_line_returns_one_segment()
    end
    it("zero width returns input as a single segment") do ->
      test_zero_width_returns_input_as_one_segment()
    end
    it("negative width returns input as a single segment") do ->
      test_negative_width_returns_input_as_one_segment()
    end
  end

  describe("wrap_line word boundaries") do ->
    it("greedy break at whitespace") do ->
      test_greedy_break_at_whitespace()
    end
    it("three words across two lines") do ->
      test_three_words_two_lines()
    end
    it("word exactly at width fits") do ->
      test_word_exactly_at_width()
    end
    it("two words each exactly at width yields two lines") do ->
      test_two_words_each_exactly_width()
    end
  end

  describe("wrap_line hard cut") do ->
    it("oversized word hard-cuts at width") do ->
      test_oversized_word_hard_cut()
    end
  end

  describe("wrap_line ANSI safety") do ->
    it("styled hard-cut segments append reset") do ->
      test_styled_span_wrap_appends_reset()
    end
    it("already-reset segment doesn't get a double reset") do ->
      test_already_reset_segment_no_double_reset()
    end
  end

  return qspec_main()
end
