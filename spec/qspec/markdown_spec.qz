## Markdown Spec — Tests for std/markdown.qz

import * from qspec
import std/markdown

# =============================================================================
# Test helpers
# =============================================================================

def print_h1(): Void
  puts(md_to_html("# Hello"))
end

def print_h2(): Void
  puts(md_to_html("## Section"))
end

def print_h3(): Void
  puts(md_to_html("### Subsection"))
end

def print_code_block(): Void
  puts(md_to_html("```rust\nlet x = 1;\n```"))
end

def print_typed_code_block(): Void
  puts(md_to_html("```ruby:starter\nx = 1\n```"))
end

def print_utf8_heading(): Void
  puts(md_to_html("# 🎯 Goals café"))
end

def print_bold(): Void
  puts(md_to_html("**bold text**"))
end

def print_italic(): Void
  puts(md_to_html("*italic text*"))
end

def print_inline_code(): Void
  puts(md_to_html("`code`"))
end

def print_link(): Void
  puts(md_to_html("[click](http://example.com)"))
end

def print_table(): Void
  puts(md_to_html("| A | B |\n|---|---|\n| 1 | 2 |"))
end

def print_ul_grouped(): Void
  puts(md_to_html("- one\n- two\n- three"))
end

def print_ol(): Void
  puts(md_to_html("1. first\n2. second\n3. third"))
end

def print_escape(): Void
  puts(html_escape("<script>alert(\"xss\")</script>"))
end

def print_page_wrapper(): Void
  var page = md_to_html_page("# Hello", "Test")
  # Check it starts with DOCTYPE and contains the title
  if str_starts_with(page, "<!DOCTYPE html>")
    puts("has doctype")
  else
    puts("no doctype")
  end
  if str_contains(page, "<title>Test</title>")
    puts("has title")
  else
    puts("no title")
  end
  if str_contains(page, "<h1>Hello</h1>")
    puts("has h1")
  else
    puts("no h1")
  end
end

def print_blockquote(): Void
  puts(md_to_html("> quoted text"))
end

def print_hr(): Void
  puts(md_to_html("---"))
end

def print_empty_lines(): Void
  var result = md_to_html("para1\n\npara2")
  puts(result)
end

def print_mixed_lists(): Void
  # UL then paragraph then OL
  var result = md_to_html("- a\n- b\n\ntext\n\n1. x\n2. y")
  if str_contains(result, "<ul>")
    puts("has ul")
  else
    puts("no ul")
  end
  if str_contains(result, "<ol>")
    puts("has ol")
  else
    puts("no ol")
  end
  if str_contains(result, "<p>text</p>")
    puts("has para")
  else
    puts("no para")
  end
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("md_to_html") do ->
    it("renders h1 heading") do ->
      assert_output("<h1>Hello</h1>\n\n", print_h1)
    end

    it("renders h2 heading with anchor") do ->
      assert_output_contains("<h2 id=\"section\">Section</h2>", print_h2)
    end

    it("renders h3 heading with anchor") do ->
      assert_output_contains("<h3 id=\"subsection\">Subsection</h3>", print_h3)
    end

    it("renders fenced code block with language") do ->
      assert_output_contains("<pre><code class=\"language-rust\">", print_code_block)
    end

    it("splits typed code fences into language + data-block-type") do ->
      assert_output_contains("<pre><code class=\"language-ruby\" data-block-type=\"starter\">", print_typed_code_block)
    end

    it("preserves multibyte UTF-8 in text") do ->
      assert_output_contains("🎯 Goals café", print_utf8_heading)
    end

    it("renders bold text") do ->
      assert_output("<p><strong>bold text</strong></p>\n\n", print_bold)
    end

    it("renders italic text") do ->
      assert_output("<p><em>italic text</em></p>\n\n", print_italic)
    end

    it("renders inline code") do ->
      assert_output("<p><code>code</code></p>\n\n", print_inline_code)
    end

    it("renders links") do ->
      assert_output_contains("<a href=\"http://example.com\">click</a>", print_link)
    end

    it("renders tables") do ->
      assert_output_contains("<table>", print_table)
    end

    it("groups consecutive unordered list items") do ->
      assert_output("<ul>\n<li>one</li>\n<li>two</li>\n<li>three</li>\n</ul>\n\n", print_ul_grouped)
    end

    it("renders ordered lists") do ->
      assert_output("<ol>\n<li>first</li>\n<li>second</li>\n<li>third</li>\n</ol>\n\n", print_ol)
    end

    it("renders blockquotes") do ->
      assert_output_contains("<blockquote>quoted text</blockquote>", print_blockquote)
    end

    it("renders horizontal rules") do ->
      assert_output("<hr>\n\n", print_hr)
    end

    it("handles mixed list types") do ->
      assert_output("has ul\nhas ol\nhas para\n", print_mixed_lists)
    end
  end

  describe("html_escape") do ->
    it("escapes special characters") do ->
      assert_output("&lt;script&gt;alert(&quot;xss&quot;)&lt;/script&gt;\n", print_escape)
    end
  end

  describe("md_to_html_page") do ->
    it("produces complete HTML page") do ->
      assert_output("has doctype\nhas title\nhas h1\n", print_page_wrapper)
    end
  end

  describe("empty lines") do ->
    it("skips empty lines between paragraphs") do ->
      assert_output("<p>para1</p>\n<p>para2</p>\n\n", print_empty_lines)
    end
  end

  return qspec_main()
end
