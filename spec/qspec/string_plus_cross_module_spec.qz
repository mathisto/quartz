## String Plus Cross Module Tests
##
## Contract:
##   1. Cross-module + literal: `red("hello") + " world"` contains both.
##   2. Two cross-module: `red("a") + green("b")` contains both.
##   3. Literal + cross-module: `"prefix: " + bold("test")` contains both.
##   4. Chained: `dim("x") + " " + cyan("y")` contains both.
##   5. Empty: `red("") + "test"` contains "test".
##   6. Triple: three cross-module concats.
import * from qspec
import * from colors

def main(): Int
  describe("Cross-module string + operator") do ->

    it("concatenates cross-module function return + literal") do ->
      var result = red("hello") + " world"
      expect(str_contains(result, "hello")).to_eq(1)
      expect(str_contains(result, "world")).to_eq(1)
    end

    it("concatenates two cross-module function returns") do ->
      var result = red("a") + green("b")
      expect(str_contains(result, "a")).to_eq(1)
      expect(str_contains(result, "b")).to_eq(1)
    end

    it("concatenates literal + cross-module function return") do ->
      var result = "prefix: " + bold("test")
      expect(str_contains(result, "prefix")).to_eq(1)
      expect(str_contains(result, "test")).to_eq(1)
    end

    it("handles chained cross-module string +") do ->
      var result = dim("x") + " " + cyan("y")
      expect(str_contains(result, "x")).to_eq(1)
      expect(str_contains(result, "y")).to_eq(1)
    end

    it("concatenates empty string + cross-module return") do ->
      var result = "" + red("visible")
      expect(str_contains(result, "visible")).to_eq(1)
    end

    it("triple cross-module concats") do ->
      var result = red("a") + green("b") + cyan("c")
      expect(str_contains(result, "a")).to_eq(1)
      expect(str_contains(result, "c")).to_eq(1)
    end

  end

  return qspec_main()
end
