## Path Tests
##
## Contract:
##   1. Path_basename extracts filename.
##   2. Path_basename of bare filename.
##   3. Path_dir extracts directory.
##   4. Path_dir returns dot for.
##   5. Path_ext with extension.
##   6. Path_ext with no extension.
import * from qspec

def main(): Int
  describe("path manipulation") do ->
    it("path_join basic") do ->
      assert_eq(path_join("foo", "bar").size, 7)
    end
    it("path_join avoids double slash") do ->
      assert_eq(path_join("foo/", "bar").size, 7)
    end
    it("path_ext with extension") do ->
      assert_eq(path_ext("file.txt").size, 3)
    end
    it("path_ext with no extension") do ->
      assert_eq(path_ext("no_ext").size, 0)
    end
    it("path_dir extracts directory") do ->
      assert_eq(path_dir("/home/user/file.txt").size, 10)
    end
    it("path_dir returns dot for bare filename") do ->
      assert_eq(path_dir("file.txt").size, 1)
    end
    it("path_basename extracts filename") do ->
      assert_eq(path_basename("/home/user/file.txt").size, 8)
    end
    it("path_basename of bare filename") do ->
      assert_eq(path_basename("file.txt").size, 8)
    end
  end
  return qspec_main()
end
