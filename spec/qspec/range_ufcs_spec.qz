## Range UFCS Method Tests
##
## Phase 7 of the API unification sprint: Range gains UFCS dispatch
## for size, contains, start, end. Previously these required free-function
## calls (range_size(r), range_contains(r, x), etc.) — table-stakes
## ergonomic gap fixed in this phase.

import * from qspec

def range_size_test(): Int
  r = 0..10
  return r.size()
end

def range_size_inclusive_test(): Int
  r = 0...10
  return r.size()
end

def range_start_test(): Int
  r = 5..15
  return r.start()
end

def range_end_test(): Int
  r = 5..15
  return r.end()
end

def range_contains_lower_test(): Int
  r = 0..10
  if r.contains(0)
    return 1
  end
  return 0
end

def range_contains_middle_test(): Int
  r = 0..10
  if r.contains(5)
    return 1
  end
  return 0
end

def range_contains_excluded_upper_test(): Int
  r = 0..10
  if r.contains(10)
    return 1
  end
  return 0
end

def range_contains_outside_test(): Int
  r = 0..10
  if r.contains(99)
    return 1
  end
  return 0
end

def range_contains_inclusive_upper_test(): Int
  r = 0...10
  if r.contains(10)
    return 1
  end
  return 0
end

def range_chained_test(): Int
  r = 0..100
  return r.start() + r.end() + r.size()
end

def main(): Int
  describe("Range UFCS dispatch") do ->
    it("r.size() — half-open") do ->
      assert_eq(range_size_test(), 10)
    end

    it("r.size() — inclusive") do ->
      assert_eq(range_size_inclusive_test(), 11)
    end

    it("r.start() returns lower bound") do ->
      assert_eq(range_start_test(), 5)
    end

    it("r.end() returns upper bound (keyword as method name)") do ->
      assert_eq(range_end_test(), 15)
    end

    it("r.contains(lower) returns true") do ->
      assert_eq(range_contains_lower_test(), 1)
    end

    it("r.contains(middle) returns true") do ->
      assert_eq(range_contains_middle_test(), 1)
    end

    it("r.contains(upper) returns false for half-open") do ->
      assert_eq(range_contains_excluded_upper_test(), 0)
    end

    it("r.contains(outside) returns false") do ->
      assert_eq(range_contains_outside_test(), 0)
    end

    it("r.contains(upper) returns true for inclusive") do ->
      assert_eq(range_contains_inclusive_upper_test(), 1)
    end

    it("Range methods chain in arithmetic") do ->
      assert_eq(range_chained_test(), 200)
    end
  end

  return qspec_main()
end
