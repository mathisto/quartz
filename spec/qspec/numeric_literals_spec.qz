import * from qspec

def main(): Int
  describe("numeric literals") do ->
    it("decimal integer") do ->
      assert_eq(42, 42)
    end

    it("underscore separators in decimal") do ->
      assert_eq(1_000_000, 1000000)
      assert_eq(1_2_3, 123)
    end

    it("hex literal 0x") do ->
      assert_eq(0xFF, 255)
      assert_eq(0x0, 0)
      assert_eq(0xDEAD, 57005)
      assert_eq(0x1A, 26)
    end

    it("hex literal 0X uppercase prefix") do ->
      assert_eq(0XFF, 255)
    end

    it("hex with underscores") do ->
      assert_eq(0xFF_FF, 65535)
    end

    it("binary literal 0b") do ->
      assert_eq(0b0, 0)
      assert_eq(0b1, 1)
      assert_eq(0b1010, 10)
      assert_eq(0b11111111, 255)
    end

    it("binary with underscores") do ->
      assert_eq(0b1111_0000, 240)
      assert_eq(0b1010_0110, 166)
    end

    it("octal literal 0o") do ->
      assert_eq(0o0, 0)
      assert_eq(0o7, 7)
      assert_eq(0o10, 8)
      assert_eq(0o77, 63)
      assert_eq(0o755, 493)
      assert_eq(0o777, 511)
    end

    it("octal literal 0O uppercase prefix") do ->
      assert_eq(0O755, 493)
    end

    it("octal with underscores") do ->
      assert_eq(0o7_5_5, 493)
    end
  end

  return qspec_main()
end
