## Type Propagation Tests
##
## Contract:
##   1. Bare map_new() still works.
##   2. Bare vec_new() still works.
##   3. Map_get returns value.
##   4. Map_keys returns vec of.
##   5. Str_split result allows str_concat.
##   6. Str_split result allows str_size.
import * from qspec

def main(): Int
  describe("type propagation") do ->
    it("str_split result allows str_size") do ->
      parts = str_split("hello.world.foo", ".")
      first_part = parts[0]
      assert_eq(first_part.size, 5)
    end
    it("str_split result allows str_concat on elements") do ->
      parts = str_split("ab.cd", ".")
      a = parts[0]
      b = parts[1]
      combined = a + b
      assert_eq(combined.size, 4)
    end
    it("vec_new() with int push/get") do ->
      var vt = vec_new()
      vt.push(42)
      assert_eq(vt[0], 42)
    end
    it("vec_new() pop returns correct value") do ->
      var vt = vec_new()
      vt.push(10)
      vt.push(20)
      match vt.pop()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
    end
    it("map_get returns value") do ->
      var m = map_new()
      m.set("age", 30)
      match m.get("age")
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
    end
    it("map_keys returns vec of keys") do ->
      var m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      var keys = m.keys()
      assert_eq(keys.size, 2)
    end
    it("bare vec_new() still works") do ->
      var vt = vec_new()
      vt.push(42)
      assert_eq(vt[0], 42)
    end
    it("bare map_new() still works") do ->
      var m = map_new()
      m.set("key", 10)
      match m.get("key")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
    end
  end
  return qspec_main()
end
