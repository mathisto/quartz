## P3.F.3c — `for v in src` auto-dispatches to async iteration when the
## source is `impl AsyncIterator<T>`. No `for await` needed. Typecheck
## widens caller's effect row by {Async} automatically.
##
## `for await` remains valid (explicit is fine). This is the Ruby-feel
## payoff: users write `for v in src` and the compiler infers from src's
## static type whether the iteration is async.

import * from qspec

def _async_nums(): impl AsyncIterator<Int>
  yield 1
  yield 2
  yield 3
end

def _sum_bare_for(): Int can Async
  var total = 0
  for v in _async_nums()
    total = total + v
  end
  return total
end

def _sum_for_await(): Int can Async
  var total = 0
  for await v in _async_nums()
    total = total + v
  end
  return total
end

def main(): Int
  describe("for v in src auto-dispatches async iteration") do ->
    it("bare `for` over async source yields correct sum") do ->
      assert_eq(_sum_bare_for(), 6)
    end

    it("`for await` still works identically (regression)") do ->
      assert_eq(_sum_for_await(), 6)
    end

    it("bare and for-await produce identical results") do ->
      assert_eq(_sum_bare_for(), _sum_for_await())
    end
  end
  return qspec_main()
end
