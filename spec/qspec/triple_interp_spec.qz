## Triple-Quoted String Interpolation Tests (Mode Stack)
## Verifies split-token emission for """...#{...}...""" strings.

import * from qspec

def print_simple(): Void
  x = 42
  puts("""hello #{x} world""")
end

def print_start(): Void
  x = "hi"
  puts("""#{x} there""")
end

def print_end(): Void
  x = "bye"
  puts("""say #{x}""")
end

def print_only_interp(): Void
  x = 99
  puts("""#{x}""")
end

def print_multi_line(): Void
  name = "world"
  n = 42
  puts("""
    hello #{name}
    value: #{n}
    """)
end

def print_multi_interps(): Void
  a = 1
  b = 2
  c = 3
  puts("""#{a} #{b} #{c}""")
end

def print_embedded_quotes(): Void
  x = "inner"
  puts("""say "#{x}" here""")
end

def print_escaped_hash(): Void
  puts("""literal \#{not interp}""")
end

def helper(s: String): String = "<<#{s}>>"

def print_nested_string(): Void
  puts("""result: #{helper("test")}""")
end

def print_vec_index(): Void
  var v = vec_new()
  v.push(42)
  puts("""val: #{v[0]}""")
end

def print_no_interp(): Void
  puts("""plain triple-quoted""")
end

def print_indent_strip(): Void
  puts("""
    line1
    line2
    """)
end

def print_relative_indent(): Void
  puts("""
    outer
      inner
    outer
    """)
end

def main(): Int
  describe("triple-quoted split-token interpolation") do ->
    it("simple interpolation") do ->
      assert_output("hello 42 world\n", print_simple)
    end

    it("interpolation at start") do ->
      assert_output("hi there\n", print_start)
    end

    it("interpolation at end") do ->
      assert_output("say bye\n", print_end)
    end

    it("only interpolation, no literal") do ->
      assert_output("99\n", print_only_interp)
    end

    it("multi-line with indent stripping") do ->
      assert_output("hello world\nvalue: 42\n", print_multi_line)
    end

    it("multiple adjacent interpolations") do ->
      assert_output("1 2 3\n", print_multi_interps)
    end

    it("embedded quotes in content") do ->
      assert_output("say \"inner\" here\n", print_embedded_quotes)
    end

    it("escaped hash is literal") do ->
      assert_output("literal \#{not interp}\n", print_escaped_hash)
    end

    it("nested string inside interpolation") do ->
      assert_output("result: <<test>>\n", print_nested_string)
    end

    it("brace expression (vec index) in interpolation") do ->
      assert_output("val: 42\n", print_vec_index)
    end

    it("plain triple-quoted still works") do ->
      assert_output("plain triple-quoted\n", print_no_interp)
    end

    it("indent stripping without interpolation") do ->
      assert_output("line1\nline2\n", print_indent_strip)
    end

    it("relative indentation preserved") do ->
      assert_output("outer\n  inner\nouter\n", print_relative_indent)
    end
  end

  return qspec_main()
end
