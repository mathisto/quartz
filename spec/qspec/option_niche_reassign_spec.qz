## Option<boxed-T> niche var REASSIGNMENT round-trip (MEMORY_MODEL_V3 §14.7 hole #3).
##
## A niche-typed `var x: Option<P>` is a single 8-byte slot (None = const 0,
## Some(p) = the pointer). A reassignment emits a second `store` to that SAME
## slot. The hazard (filed as hole #3): if the reassigned RHS does not construct
## its value at the niche representation (e.g. a bare `None` SPILLS to a tagged,
## non-null box), the niche-aware read range-tests that box as non-null and
## misreads `None` as `Some` — a §14.4 construct-spill / read-niche mismatch.
##
## Fixed by item 6.2 Phase 2 (commit 4e057f71): the NODE_ASSIGN handler threads
## the var's tracked `Option<P>` type as the niche-expected type onto the RHS
## lowering, so the reassigned None/Some construct at the niche representation and
## agree with the read. These tests lock that down across both directions and a
## Some->None->Some chain, for struct / String / Vec payload classes, plus a
## plain non-Option var reassign as a control.
##
## Representation-agnostic at the source level: MUST pass under tagged OR niche
## layout — value is as a regression net across the boxed-pointer-niche flip.
import * from qspec

struct Point
  x: Int
  y: Int
end

## Opaque-boundary readers: passing the reassigned var through a function call
## defeats flow-narrowing, so the `is None` / `is Some` test MUST load the slot
## at runtime instead of constant-folding the narrowed result. This is the path
## that actually exercises the niche store/read agreement after reassignment
## (item 5b: a narrowed in-line read can fold to a constant and mask a wrong
## slot value; the opaque read cannot).
def opt_point_is_none(o: Option<Point>): Int
  if o is None
    return 1
  end
  return 0
end

def opt_str_is_none(o: Option<String>): Int
  if o is None
    return 1
  end
  return 0
end

def opt_int_is_none(o: Option<Int>): Int
  if o is None
    return 1
  end
  return 0
end

def main(): Int
  describe("Option<Point> niche var reassign") do ->
    it("Some -> None reassign reads None") do ->
      var a: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      a = Option::None
      assert_eq(a is None, 1)
    end
    it("Some -> None reassign: is_some() false") do ->
      var a: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      a = Option::None
      assert_eq(a is Some, 0)
    end
    it("Some -> None reassign: match hits None arm") do ->
      var a: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      a = Option::None
      v = match a
        Some(p) => 1
        None => 0
      end
      assert_eq(v, 0)
    end
    it("None -> Some reassign reads Some") do ->
      var b: Option<Point> = Option::None
      b = Option::Some(Point { x: 3, y: 4 })
      assert_eq(b is Some, 1)
    end
    it("None -> Some reassign: payload intact") do ->
      var b: Option<Point> = Option::None
      b = Option::Some(Point { x: 3, y: 4 })
      v = match b
        Some(p) => p.x * 100 + p.y
        None => -1
      end
      assert_eq(v, 304)
    end
    it("Some -> None -> Some chain ends Some") do ->
      var c: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      c = Option::None
      c = Option::Some(Point { x: 7, y: 8 })
      assert_eq(c is Some, 1)
    end
    it("Some -> Some -> None chain ends None") do ->
      var c: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      c = Option::Some(Point { x: 9, y: 9 })
      c = Option::None
      assert_eq(c is None, 1)
    end
  end

  describe("Option<String> niche var reassign") do ->
    it("Some -> None reassign reads None") do ->
      var s: Option<String> = Option::Some("hi")
      s = Option::None
      assert_eq(s is None, 1)
    end
    it("None -> Some reassign reads Some") do ->
      var s: Option<String> = Option::None
      s = Option::Some("yo")
      assert_eq(s is Some, 1)
    end
  end

  describe("Option<Vec> niche var reassign") do ->
    it("Some -> None reassign reads None") do ->
      var v: Option<Vec<Int>> = Option::Some(vec_new())
      v = Option::None
      assert_eq(v is None, 1)
    end
    it("None -> Some reassign reads Some") do ->
      var v: Option<Vec<Int>> = Option::None
      v = Option::Some(vec_new())
      assert_eq(v is Some, 1)
    end
  end

  describe("unannotated niche var reassign") do ->
    it("var inferred from Some, reassigned None, reads None") do ->
      var a = Option::Some(Point { x: 1, y: 2 })
      a = Option::None
      assert_eq(a is None, 1)
    end
  end

  describe("plain non-Option var reassign control") do ->
    it("Int var reassign reads the new value") do ->
      var n = 10
      n = 20
      assert_eq(n, 20)
    end
  end

  describe("niche var reassign read via opaque call (no flow-narrowing)") do ->
    it("Some -> None reads None through a function call") do ->
      var a: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      a = Option::None
      assert_eq(opt_point_is_none(a), 1)
    end
    it("None -> Some reads Some through a function call") do ->
      var b: Option<Point> = Option::None
      b = Option::Some(Point { x: 3, y: 4 })
      assert_eq(opt_point_is_none(b), 0)
    end
    it("unannotated Some -> None reads None through a function call") do ->
      var c = Option::Some(Point { x: 5, y: 6 })
      c = Option::None
      assert_eq(opt_point_is_none(c), 1)
    end
    it("Some -> None -> Some chain ends Some through a function call") do ->
      var d: Option<Point> = Option::Some(Point { x: 1, y: 2 })
      d = Option::None
      d = Option::Some(Point { x: 7, y: 8 })
      assert_eq(opt_point_is_none(d), 0)
    end
    it("String Some -> None reads None through a function call") do ->
      var s: Option<String> = Option::Some("hi")
      s = Option::None
      assert_eq(opt_str_is_none(s), 1)
    end
    it("non-niche Option<Int> Some -> None reads None through a function call") do ->
      var n: Option<Int> = Option::Some(99)
      n = Option::None
      assert_eq(opt_int_is_none(n), 1)
    end
    it("non-niche Option<Int> None -> Some reads Some through a function call") do ->
      var m: Option<Int> = Option::None
      m = Option::Some(7)
      assert_eq(opt_int_is_none(m), 0)
    end
  end

  return qspec_main()
end
