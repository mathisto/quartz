## Closure Capture Tests
##
## Contract:
##   1. Basic capture.
##   2. Make_adder pattern.
##   3. Make_multiplier pattern.
##   4. Higher-order functions.
##   5. Parameter shadowing.
##   6. Pure lambdas.
##   7. First-class function values.
##   8. Capture ordering.
##   9. Closure type errors.
##   10. Nested closures.
##   11. Closures with higher-order functions.
##   12. Closure capture timing.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("basic capture") do ->
    it("captures single variable") do ->
      f = cc_make_val_returner(10)
      assert_eq(f(), 10)
    end

    it("captures multiple variables") do ->
      f = cc_make_sum_returner(10, 20)
      assert_eq(f(), 30)
    end

    it("captures function parameter") do ->
      f = cc_make_returner(42)
      assert_eq(f(), 42)
    end
  end

  describe("make_adder pattern") do ->
    it("creates adder closure") do ->
      add5 = cc_make_adder(5)
      assert_eq(add5(10), 15)
    end

    it("creates multiple different adders") do ->
      add2 = cc_make_adder(2)
      add3 = cc_make_adder(3)
      assert_eq(add2(10) + add3(10), 25)
    end
  end

  describe("make_multiplier pattern") do ->
    it("creates multiplier closure") do ->
      double = cc_make_multiplier(2)
      triple = cc_make_multiplier(3)
      assert_eq(double(5) + triple(5), 25)
    end
  end

  describe("higher-order functions") do ->
    it("passes closure to function") do ->
      f = cc_make_multiplier(4)
      assert_eq(cc_apply(f, 5), 20)
    end

    it("returns closure from function") do ->
      by2 = cc_make_step(2)
      by3 = cc_make_step(3)
      assert_eq(by2(10) + by3(10), 25)
    end
  end

  describe("parameter shadowing") do ->
    it("closure parameter shadows outer variable") do ->
      f = cc_make_doubler()
      assert_eq(f(5) + 100, 110)
    end

    it("multiple closures with same parameter name") do ->
      f = cc_make_adder(1)
      g = cc_make_adder(2)
      assert_eq(f(10) + g(20), 33)
    end
  end

  describe("pure lambdas") do ->
    it("lambda with no captures") do ->
      f = cc_make_doubler()
      assert_eq(f(21), 42)
    end

    it("constant-returning nullary lambda") do ->
      f = cc_make_const(42)
      assert_eq(f(), 42)
    end

    it("multi-parameter lambda") do ->
      add = cc_make_binary_adder()
      assert_eq(add(13, 29), 42)
    end
  end

  describe("first-class function values") do ->
    it("named function as value") do ->
      f = cc_double
      assert_eq(f(21), 42)
    end

    it("passes named function to higher-order function") do ->
      assert_eq(cc_apply(cc_double, 21), 42)
    end
  end

  describe("capture ordering") do ->
    it("captures multiple variables in lexical order") do ->
      f = cc_make_compose(1, 2, 3)
      assert_eq(f(), 123)
    end
  end

  describe("closure type errors") do ->
    it("rejects wrong parameter count") do ->
      assert_compile_error("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((a, b) -> a + b, 5)
        end
        """, "Lambda has 2 parameter(s) but Fn(Int): Int expects 1")
    end
    it("rejects wrong parameter type") do ->
      assert_compile_error("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((s: String) -> 0, 5)
        end
        """, "parameter type mismatch")
    end
  end

  describe("nested closures") do ->
    it("captures through two levels of nesting") do ->
      f = cc_nested_level2(10)
      assert_eq(f(), 12)
    end
    it("captures from grandparent scope") do ->
      g = cc_grandparent(5)
      assert_eq(g(3), 14)
    end
  end

  describe("closures with higher-order functions") do ->
    it("closure with map over array") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var multiplier = 10
      var result = vec_new()
      var i = 0
      while i < v.size
        result.push(v[i] * multiplier)
        i += 1
      end
      assert_eq(result[0], 10)
      assert_eq(result[1], 20)
      assert_eq(result[2], 30)
    end

    it("closure with each captures by value") do ->
      f = cc_make_adder(10)
      assert_eq(cc_apply_twice(f, 5), 25)
    end

    it("closure with reduce") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      var sum = 0
      var i = 0
      while i < v.size
        sum += v[i]
        i += 1
      end
      assert_eq(sum, 10)
    end
  end

  describe("closure capture timing") do ->
    it("captures value at closure creation time") do ->
      assert_eq(cc_capture_timing_test(), 11)
    end
  end

  return qspec_main()
end

## All helper functions use arrow syntax to avoid pipe-lambda parse issues
## Typed pipe lambdas |x: Int| fail in self-hosted compiler

def cc_make_val_returner(v: Int): Fn(): Int
  return -> v
end

def cc_make_sum_returner(a: Int, b: Int): Fn(): Int
  return -> a + b
end

def cc_make_returner(n: Int): Fn(): Int
  return -> n
end

def cc_make_adder(n: Int): Fn(Int): Int
  return (x: Int) -> x + n
end

def cc_make_multiplier(n: Int): Fn(Int): Int
  return (x: Int) -> x * n
end

def cc_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def cc_make_step(step: Int): Fn(Int): Int
  return (n: Int) -> n + step
end

def cc_double(x: Int): Int
  return x * 2
end

def cc_make_doubler(): Fn(Int): Int
  return (x: Int) -> x * 2
end

def cc_make_const(v: Int): Fn(): Int
  return -> v
end

def cc_make_binary_adder(): Fn(Int, Int): Int
  return (a: Int, b: Int) -> a + b
end

def cc_make_compose(a: Int, b: Int, c: Int): Fn(): Int
  return -> a * 100 + b * 10 + c
end

def cc_apply_twice(f: Fn(Int): Int, x: Int): Int
  return f(f(x))
end

def cc_capture_timing_test(): Int
  var x = 10
  f = (a: Int) -> x + a
  x = 99
  return f(1)
end

def cc_nested_level2(x: Int): Fn(): Int
  inner = -> x + 1
  return -> inner() + 1
end

def cc_grandparent(x: Int): Fn(Int): Int
  base = x * 2
  mid = -> base + 1
  return (n: Int) -> mid() + n
end
