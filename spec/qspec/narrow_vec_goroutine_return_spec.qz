## Regression spec for NARROW_VEC_GOROUTINE_RETURN_CORRUPTION
## (and the sister bug STRUCT_FIELD_SIZE_HIJACK_BY_VEC_SIZE).
##
## Both bugs share root cause: NODE_GO / NODE_ASYNC_CALL / NODE_AWAIT
## type-erase to TYPE_INT in the typechecker, so the LET binding for
## `var v = await go f()` loses the inner callee's return-type
## annotation. Without that annotation:
##
##   1. `v[i]` for narrow Vec<Bool> mis-resolves at the typechecker's
##      `.size` UFCS shortcut path, falling through to wrong-stride
##      reads on element values.
##   2. `p.size` for a struct field literally named `size` mis-resolves
##      as `vec_size(p)` (typechecker rewrites field access on TYPE_INT
##      receivers without struct_name to vec_size), printing a heap
##      pointer instead of the field value.
##
## The option-C fix in `typecheck_walk.qz` NODE_LET handler walks
## through NODE_AWAIT → NODE_GO/NODE_ASYNC_CALL → NODE_CALL → callee
## NODE_IDENT, looks up the inner function's return annotation via
## `tc_lookup_function_return_annotation`, and propagates struct_name
## (for user structs) and type_ann (for both user structs and builtin
## containers like Vec<Bool>) onto the binding. Runtime type stays
## TYPE_INT — only the side-channel binding metadata changes.
##
## Codegen is unchanged. The fix is purely typecheck-side.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("await of go returning narrow-element Vec<Bool>") do ->
    it("reads all 3 elements correctly through the await boundary") do ->
      assert_run_stdout_eq("""
import * from std/sync/composition/go

def make_bool_vec(): Vec<Bool>
  var v = vec_new<Bool>()
  v.push(true)
  v.push(false)
  v.push(true)
  return v
end

def main(): Int
  sched_init(1)
  var fut = go make_bool_vec()
  var v = await fut
  for i in 0..v.size
    if v[i]
      puts("[" + str_from_int(i) + "]=T")
    else
      puts("[" + str_from_int(i) + "]=F")
    end
  end
  sched_shutdown()
  return 0
end
""", "[0]=T\n[1]=F\n[2]=T\n")
    end

    it("reads all 5 elements correctly through the await boundary") do ->
      assert_run_stdout_eq("""
import * from std/sync/composition/go

def make_bool_vec(): Vec<Bool>
  var v = vec_new<Bool>()
  v.push(true)
  v.push(false)
  v.push(true)
  v.push(false)
  v.push(true)
  return v
end

def main(): Int
  sched_init(1)
  var fut = go make_bool_vec()
  var v = await fut
  for i in 0..v.size
    if v[i]
      puts("[" + str_from_int(i) + "]=T")
    else
      puts("[" + str_from_int(i) + "]=F")
    end
  end
  sched_shutdown()
  return 0
end
""", "[0]=T\n[1]=F\n[2]=T\n[3]=F\n[4]=T\n")
    end
  end

  describe("await of go returning user struct (sister bug — STRUCT_FIELD_SIZE_HIJACK)") do ->
    it("reads non-shadowed field 'total' correctly") do ->
      assert_run_stdout_eq("""
import * from std/sync/composition/go

struct Pair
  first: String
  second: String
  total: Int
end

def make_pair(): Pair
  return Pair { first: "a", second: "b", total: 7 }
end

def main(): Int
  sched_init(1)
  var fut = go make_pair()
  var p = await fut
  puts("total=" + str_from_int(p.total))
  puts("first=" + p.first)
  sched_shutdown()
  return 0
end
""", "total=7\nfirst=a\n")
    end

    it("reads field literally named 'size' without vec_size hijack") do ->
      # Sister bug: pre-fix, `p.size` rewrote to `vec_size(p)` because the
      # typechecker's TYPE_INT receiver fallback couldn't recover the
      # struct identity of an awaited goroutine return. Post-fix the
      # binding's struct_name is set to "Pair" and `.size` resolves to
      # the field at the correct offset (slot 2).
      assert_run_stdout_eq("""
import * from std/sync/composition/go

struct Pair
  first: String
  second: String
  size: Int
end

def make_pair(): Pair
  return Pair { first: "a", second: "b", size: 7 }
end

def main(): Int
  sched_init(1)
  var fut = go make_pair()
  var p = await fut
  puts("size=" + str_from_int(p.size))
  sched_shutdown()
  return 0
end
""", "size=7\n")
    end

    it("direct `await go f()` form (no intermediate fut binding) also works") do ->
      # Covers the AST shape where AWAIT.left is NODE_GO directly,
      # not a NODE_IDENT pointing to a separately-bound goroutine
      # handle. The fix handles both shapes via separate branches.
      assert_run_stdout_eq("""
import * from std/sync/composition/go

struct Pair
  first: String
  second: String
  size: Int
end

def make_pair(): Pair
  return Pair { first: "a", second: "b", size: 7 }
end

def main(): Int
  sched_init(1)
  var p = await go make_pair()
  puts("size=" + str_from_int(p.size))
  sched_shutdown()
  return 0
end
""", "size=7\n")
    end
  end

  return qspec_main()
end
