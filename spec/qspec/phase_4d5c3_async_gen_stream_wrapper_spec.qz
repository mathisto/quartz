## Phase 4D.5c.3 — Async generator constructor wraps in Stream<T, e>.
##
## Pre-4D.5c.3: `mir_lower_async_generator` emitted a thin `<name>` ctor
## that inline-allocated the 6-slot async frame and returned the raw
## frame_ptr. The for-in/for-await consumer (lower_async_gen_iteration*)
## treated the value as an inner async frame and invoked
## `__Future_<name>$poll(frame)` directly (or loaded poll fn from
## frame[2] for the indirect path).
##
## Post-4D.5c.3: the ctor calls `__Future_<name>$new(params...)` (already
## emitted by PASS 1.3c for every async target — async generators are
## auto-registered as async targets via PASS 0.99b's suspend-propagation
## scan), then wraps the returned frame in a 2-word Stream<T, e> handle
## `{frame@0, step@1}` — byte-identical to what `mir_lower_generator_effect`
## emits for sync `impl Iterator<T>`. The matching consumer-side update
## in `_lower_async_gen_iter_impl` (mir_lower_iter.qz:~1043) loads the
## inner frame from `wrapper[0]` and (indirect form) the step fn from
## `wrapper[1]`.
##
## What this spec verifies:
## 1. Bare `for v in async_gen()` (NODE_CALL) compiles + runs correctly
##    end-to-end — yields are observed in the consumer body.
## 2. `var s = async_gen(); for v in s` (NODE_IDENT-typed indirect) — the
##    indirect-poll path through `wrapper[1]` works.
## 3. `for await v in async_gen()` (NODE_FOR_AWAIT direct) compiles.
## 4. `for await v in s` (NODE_FOR_AWAIT indirect) compiles.
## 5. Generator-inside-generator composition: `for x in inner_gen() ... yield x`
##    — the colorless-skip case from the 4D.5b memo. The skip predicate
##    fires (annotation-based, independent of runtime shape), the for-in
##    iterates the Stream wrapper, and yields propagate up correctly.
## 6. The constructor IR shape: `<name>` calls `__Future_<name>$new` and
##    allocates a 2-slot wrapper (concrete witness that the producer
##    actually wraps now).
##
## See docs/design/PHASE_4D_5C_CONSUMER_MERGE.md §4D.5c.3 (Path B revised).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.5c.3 — async generator constructor wraps in Stream<T,e>") do ->

    it("for v in async_gen() (NODE_CALL direct) yields observed in consumer body") do ->
      assert_run_exits("""
def counting(): impl Iterator<Int> can Async
  yield 10
  yield 20
  yield 30
end

def main(): Int
  var total = 0
  for v in counting()
    total = total + v
  end
  return total
end
""", 60)
    end

    it("var s = async_gen(); for v in s (NODE_IDENT-typed indirect) iterates correctly") do ->
      assert_run_exits("""
def counting(): impl Iterator<Int> can Async
  yield 1
  yield 2
  yield 3
  yield 4
end

def main(): Int
  var s = counting()
  var total = 0
  for v in s
    total = total + v
  end
  return total
end
""", 10)
    end

    it("for await v in async_gen() (NODE_FOR_AWAIT direct) compiles") do ->
      assert_compile_succeeds("""
def counting(): impl Iterator<Int> can Async
  yield 1
  yield 2
end

def main(): Int
  var total = 0
  for await v in counting()
    total = total + v
  end
  return total
end
""")
    end

    it("for await v in s (NODE_FOR_AWAIT indirect) compiles") do ->
      assert_compile_succeeds("""
def counting(): impl Iterator<Int> can Async
  yield 1
  yield 2
end

def main(): Int
  var s = counting()
  var total = 0
  for await v in s
    total = total + v
  end
  return total
end
""")
    end

    it("colorless-skip — generator-inside-generator composition (the 4D.5b memo case)") do ->
      assert_run_exits("""
def inner(): impl Iterator<Int> can Async
  yield 11
  yield 22
end

def outer(): impl Iterator<Int> can Async
  for x in inner()
    yield x
  end
  yield 99
end

def main(): Int
  var total = 0
  for v in outer()
    total = total + v
  end
  return total
end
""", 132)
    end

    it("constructor IR calls __Future_<name>$new (witness for producer-side wrap)") do ->
      assert_ir_contains("""
def counting(): impl Iterator<Int> can Async
  yield 1
end

def main(): Int
  for v in counting()
    return v
  end
  return 0
end
""", "@__Future_counting$new")
    end

  end

  return qspec_main()
end
