## Tail Call Optimization Tests
##
## Contract:
##   1. Self-recursive tail: `tail call` emitted in IR.
##   2. Non-tail: `1 + f(n-1)` NOT marked tail call.
##   3. Mutual tail call: `is_even`/`is_odd` pair.
##   4. Large recursion: no stack overflow with TCO.
##   5. Accumulator pattern: sum_tail, count_down.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("tail call optimization") do ->
    it("emits tail call for self-recursive tail position") do ->
      assert_ir_contains("""
def sum_tail(n: Int, acc: Int): Int
  if n == 0
    return acc
  end
  return sum_tail(n - 1, acc + n)
end
def main(): Int
  return sum_tail(10, 0)
end
""", "tail call")
    end

    it("self-recursive tail call computes correctly") do ->
      assert_eq(tco_sum_tail(10, 0), 55)
    end

    it("non-tail call is not marked tail") do ->
      assert_ir_not_contains("""
        def non_tail(n: Int): Int
          if n <= 0
            return 0
          end
          return 1 + non_tail(n - 1)
        end
        def main(): Int
          var result = non_tail(5)
          print_int(result)
          return 0
        end
        """, "tail call i64 @non_tail")
    end

    it("mutual tail call works correctly") do ->
      assert_eq(tco_is_even(10), 1)
    end

    it("tail call to different function emits tail") do ->
      assert_ir_contains("""
        def is_e(n: Int): Int
          if n == 0
            return 1
          end
          return is_o(n - 1)
        end
        def is_o(n: Int): Int
          if n == 0
            return 0
          end
          return is_e(n - 1)
        end
        def main(): Int
          return is_e(10)
        end
        """, "tail call")
    end

    it("tail call result is correct with large recursion") do ->
      var result = tco_count_down(100, 0)
      if result == 100
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("tail factorial computes correctly") do ->
      assert_eq(tco_factorial(5, 1), 120)
    end

    it("mutual recursion computes odd correctly") do ->
      assert_eq(tco_is_odd(7), 1)
      assert_eq(tco_is_odd(10), 0)
    end
  end

  return qspec_main()
end

def tco_sum_tail(n: Int, acc: Int): Int
  if n <= 0
    return acc
  end
  return tco_sum_tail(n - 1, acc + n)
end

def tco_is_even(n: Int): Int
  if n == 0
    return 1
  end
  return tco_is_odd(n - 1)
end

def tco_is_odd(n: Int): Int
  if n == 0
    return 0
  end
  return tco_is_even(n - 1)
end

def tco_count_down(n: Int, acc: Int): Int
  if n <= 0
    return acc
  end
  return tco_count_down(n - 1, acc + 1)
end

def tco_factorial(n: Int, acc: Int): Int
  if n <= 1
    return acc
  end
  return tco_factorial(n - 1, acc * n)
end

