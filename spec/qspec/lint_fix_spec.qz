## Lint Auto-Fix Tests (Phase 7)
##
## Tests --fix flag for QZ7101 (bool hygiene), QZ7102 (unless),
## QZ7103 (compound assign), QZ7104 (.size), QZ7105 (endless def),
## QZ7106 (trailing ws).

import * from qspec
import * from qspec/subprocess

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint --fix (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("--fix: QZ7106 trailing whitespace") do ->

    it("removes trailing spaces") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_7106.qz"
      var out = "/tmp/qz_fix_7106.out"
      var err = "/tmp/qz_fix_7106.err"
      # Use a multi-statement body so QZ7105 doesn't fire and overlap
      write_file(src, "def main(): Int   \n  var x = 0\n  x += 1\n  return x\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      assert_eq(str_contains(fixed, "Int   "), false)
      assert_eq(str_contains(fixed, "def main(): Int"), true)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: QZ7102 if not -> unless") do ->

    it("replaces if not with unless") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_7102.qz"
      var out = "/tmp/qz_fix_7102.out"
      var err = "/tmp/qz_fix_7102.err"
      write_file(src, "def foo(x: Bool): Int\n  if not x\n    return 0\n  end\n  return 1\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      assert_eq(str_contains(fixed, "unless x"), true)
      assert_eq(str_contains(fixed, "if not"), false)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: QZ7104 .len -> .size") do ->

    it("replaces .len( with .size(") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_7104.qz"
      var out = "/tmp/qz_fix_7104.out"
      var err = "/tmp/qz_fix_7104.err"
      # Multi-statement body so QZ7105 doesn't conflict
      write_file(src, "def foo(items: Vec<Int>): Int\n  var n = items.len()\n  return n\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      assert_eq(str_contains(fixed, ".size()"), true)
      assert_eq(str_contains(fixed, ".len()"), false)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: QZ7105 endless def") do ->

    it("collapses to endless def form") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_7105.qz"
      var out = "/tmp/qz_fix_7105.out"
      var err = "/tmp/qz_fix_7105.err"
      write_file(src, "def double(x: Int): Int\n  return x * 2\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      assert_eq(str_contains(fixed, "def double(x: Int): Int = x * 2"), true)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: QZ7103 compound assign") do ->

    it("transforms x = x + 1 to x += 1") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_7103.qz"
      var out = "/tmp/qz_fix_7103.out"
      var err = "/tmp/qz_fix_7103.err"
      write_file(src, "def foo(): Void\n  var count = 0\n  count += 1\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      assert_eq(str_contains(fixed, "count += 1"), true)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: multiple fixes in one file") do ->

    it("applies multiple fixes at once") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_multi.qz"
      var out = "/tmp/qz_fix_multi.out"
      var err = "/tmp/qz_fix_multi.err"
      write_file(src, "def foo(): Int   \n  if not valid\n    return 0\n  end\n  return items.len()\nend\n")
      system(compiler + " lint --fix " + src + " > " + out + " 2> " + err)
      var fixed = read_file(src)
      # Trailing ws removed
      assert_eq(str_contains(fixed, "Int   "), false)
      # if not -> unless
      assert_eq(str_contains(fixed, "unless valid"), true)
      # .len -> .size
      assert_eq(str_contains(fixed, ".size()"), true)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--fix: no changes when clean") do ->

    it("does not modify clean file") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_fix_clean.qz"
      var cmd_out = "/tmp/qz_fix_clean_stdout"
      var err = "/tmp/qz_fix_clean_err"
      # Use a truly clean file (no single-return, no trailing ws, etc.)
      var original = "def main(): Int\n  var x = 1\n  x += 1\n  return x\nend\n"
      write_file(src, original)
      system(compiler + " lint --fix " + src + " > " + cmd_out + " 2> " + err)
      var after = read_file(src)
      # File should be unchanged
      assert_eq_str(after, original)
      file_delete(src)
      file_delete(cmd_out)
      file_delete(err)
    end
  end

  return qspec_main()
end
