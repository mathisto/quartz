## Cancel Propagation Tests — Phase 3 Cancellation Infrastructure
##
## Tests for automatic cancel propagation via frame[3] cancel token slot:
##   - go_cancellable: spawns task with cancel token
##   - Auto cancel-on-failure: scheduler cancels token when task returns -1
##   - Cancel check at resume points: sched_yield checks frame[3]
##   - cancel_on_success policy: negative token encoding

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("cancel propagation") do ->
    it("go_cancellable sets cancel token at frame[3]") do ->
      assert_run_exits(go_cancellable_src(), 0)
    end

    it("cancel token at frame[3] cancels task at sched_yield") do ->
      assert_run_exits(cancel_at_yield_src(), 0)
    end

    it("auto cancel-on-failure: sibling cancelled when one fails") do ->
      assert_run_exits(auto_cof_src(), 0)
    end

    it("auto cancel-on-failure: panic cancels siblings") do ->
      assert_run_exits(auto_cof_panic_src(), 0)
    end

    it("no cancellation when all tasks succeed") do ->
      assert_run_exits(no_cancel_on_success_src(), 0)
    end

    it("cancel_on_success: first success cancels siblings") do ->
      assert_run_exits(cos_first_success_src(), 0)
    end

    it("deeply nested: 3 tasks, middle fails, others cancelled") do ->
      assert_run_exits(deep_cancel_src(), 0)
    end

    it("cancelled task result is -1") do ->
      assert_run_exits(cancelled_result_src(), 0)
    end
  end

  return qspec_main()
end

def go_cancellable_src(): String
  return """
    def worker(): Int
      var i = 0
      while i < 100
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f = async worker()
      store(f, 3, tok)
      var ct = load(f, 3)
      cancel_token_free(tok)
      if ct == tok
        return 0
      end
      return 1
    end
    """
end

def cancel_at_yield_src(): String
  return """
    def worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f = async worker()
      store(f, 3, tok)
      sched_spawn(f)
      cancel_token_cancel(tok)
      sched_shutdown()
      var result = load(f, 1)
      cancel_token_free(tok)
      if result == -1
        return 0
      end
      return 1
    end
    """
end

def auto_cof_src(): String
  return """
    def slow_worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def fail_fast(): Int
      return -1
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f1 = async slow_worker()
      store(f1, 3, tok)
      sched_spawn(f1)
      var f2 = async fail_fast()
      store(f2, 3, tok)
      sched_spawn(f2)
      sched_shutdown()
      var r1 = load(f1, 1)
      var r2 = load(f2, 1)
      cancel_token_free(tok)
      if r2 == -1
        if r1 == -1
          return 0
        end
      end
      return 1
    end
    """
end

def auto_cof_panic_src(): String
  return """
    def slow_worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def panicker(): Int
      sched_yield()
      panic("boom")
      return 0
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f1 = async slow_worker()
      store(f1, 3, tok)
      sched_spawn(f1)
      var f2 = async panicker()
      store(f2, 3, tok)
      sched_spawn(f2)
      sched_shutdown()
      var r1 = load(f1, 1)
      var r2 = load(f2, 1)
      cancel_token_free(tok)
      if r2 == -1
        if r1 == -1
          return 0
        end
      end
      return 1
    end
    """
end

def no_cancel_on_success_src(): String
  return """
    def worker(n: Int): Int
      var i = 0
      while i < 10
        sched_yield()
        i += 1
      end
      return n
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f1 = async worker(10)
      store(f1, 3, tok)
      sched_spawn(f1)
      var f2 = async worker(20)
      store(f2, 3, tok)
      sched_spawn(f2)
      sched_shutdown()
      var r1 = load(f1, 1)
      var r2 = load(f2, 1)
      var cancelled = cancel_token_is_cancelled(tok)
      cancel_token_free(tok)
      if cancelled == 0
        if r1 == 10
          if r2 == 20
            return 0
          end
        end
      end
      return 1
    end
    """
end

def cos_first_success_src(): String
  return """
    def slow_worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def fast_success(): Int
      return 99
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f1 = async slow_worker()
      store(f1, 3, 0 - tok)
      sched_spawn(f1)
      var f2 = async fast_success()
      store(f2, 3, 0 - tok)
      sched_spawn(f2)
      sched_shutdown()
      var r1 = load(f1, 1)
      var r2 = load(f2, 1)
      cancel_token_free(tok)
      if r2 == 99
        if r1 == -1
          return 0
        end
      end
      return 1
    end
    """
end

def deep_cancel_src(): String
  return """
    def slow_worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def fail_fast(): Int
      return -1
    end
    def main(): Int
      sched_init(4)
      var tok = cancel_token_new()
      var f1 = async slow_worker()
      store(f1, 3, tok)
      var f2 = async fail_fast()
      store(f2, 3, tok)
      var f3 = async slow_worker()
      store(f3, 3, tok)
      sched_spawn(f1)
      sched_spawn(f2)
      sched_spawn(f3)
      sched_shutdown()
      var r1 = load(f1, 1)
      var r2 = load(f2, 1)
      var r3 = load(f3, 1)
      cancel_token_free(tok)
      if r1 == -1
        if r2 == -1
          if r3 == -1
            return 0
          end
        end
      end
      return 1
    end
    """
end

def cancelled_result_src(): String
  return """
    def worker(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var f = async worker()
      store(f, 3, tok)
      sched_spawn(f)
      cancel_token_cancel(tok)
      sched_shutdown()
      var state = load(f, 0)
      var result = load(f, 1)
      cancel_token_free(tok)
      if state == -1
        if result == -1
          return 0
        end
      end
      return 1
    end
    """
end
