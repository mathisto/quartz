## Cross-Module Bug Fixes Regression Tests
##
## Validates fixes for four cross-module compiler bugs:
##   Bug 4: str_split returns Vec<String> ptype (not TYPE_INT)
##   Bug 1: Chained .size on struct Vec<T> fields works via ptype unwrapping
##   Bug 3: UFCS String methods resolve on values from str_split
##   Bug 2: Module-level global reassignment stores to global (not local)
##
## Contract:
##   1. Str_split returns Vec<String>.
##   2. Chained .size on struct Vec<T> field.
##   3. UFCS on values from str_split.
##   4. Module-level global reassignment.

import * from qspec

## ---- Bug 2: Module-level globals ----
var _counter = 0
var _name = "initial"
var _items = vec_new<String>()

def reset_globals(): Void
  _counter = 0
  _name = "reset"
end

def increment(): Void
  _counter = _counter + 1
end

def set_name(n: String): Void
  _name = n
end

def reinit_items(): Void
  _items = vec_new<String>()
  _items.push("fresh")
end

def get_counter(): Int = _counter
def get_name(): String = _name
def get_items(): Vec<String> = _items

## ---- Bug 1: Struct with Vec field ----
struct Container
  items: Vec<String>
  count: Int
end

def make_container(): Container
  var v = vec_new<String>()
  v.push("alpha")
  v.push("beta")
  v.push("gamma")
  return Container{items: v, count: 3}
end

def main(): Int
  ## Bug 4: str_split return type
  describe("str_split returns Vec<String>") do ->
    it("result has correct .size") do ->
      var parts = str_split("a,b,c", ",")
      assert_eq(parts.size, 3)
    end

    it("indexing returns String") do ->
      var parts = str_split("hello|world", "|")
      assert_eq_str(parts[0], "hello")
      assert_eq_str(parts[1], "world")
    end

    it("single element split") do ->
      var parts = str_split("nosep", ",")
      assert_eq(parts.size, 1)
      assert_eq_str(parts[0], "nosep")
    end
  end

  ## Bug 1: Chained .size on struct Vec field
  describe("chained .size on struct Vec<T> field") do ->
    it("resolves .size through struct field") do ->
      var c = make_container()
      assert_eq(c.items.size, 3)
    end

    it("indexes through struct field") do ->
      var c = make_container()
      assert_eq_str(c.items[0], "alpha")
      assert_eq_str(c.items[2], "gamma")
    end
  end

  ## Bug 3: UFCS on str_split results
  describe("UFCS on values from str_split") do ->
    it("calls .char_at on split result element") do ->
      var parts = str_split("hello|world", "|")
      var first = parts[0]
      assert_eq(first.char_at(0), 104)
    end

    it("calls .find on split result element") do ->
      var parts = str_split("hello|world", "|")
      var second = parts[1]
      match second.find("rl")
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
    end

    it("calls UFCS .split on a string") do ->
      var text = "a,b,c"
      var parts = text.split(",")
      assert_eq(parts.size, 3)
      assert_eq_str(parts[1], "b")
    end

    it("calls UFCS .contains on split result") do ->
      var parts = str_split("foo-bar", "-")
      var first = parts[0]
      assert_eq(first.contains("oo"), 1)
    end
  end

  ## Bug 2: Module-level global reassignment
  describe("module-level global reassignment") do ->
    it("reads initial int global") do ->
      assert_eq(get_counter(), 0)
    end

    it("increments int global via function") do ->
      increment()
      increment()
      increment()
      assert_eq(get_counter(), 3)
    end

    it("resets int global to zero") do ->
      reset_globals()
      assert_eq(get_counter(), 0)
    end

    it("reassigns string global") do ->
      set_name("hello")
      assert_eq_str(get_name(), "hello")
    end

    it("reinitializes vec global") do ->
      reinit_items()
      var items = get_items()
      assert_eq(items.size, 1)
      assert_eq_str(items[0], "fresh")
    end
  end

  return qspec_main()
end
