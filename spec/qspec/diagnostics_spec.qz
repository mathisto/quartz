## Runtime Diagnostics Tests — Phase 6

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("runtime diagnostics") do ->
    it("sched_worker_count returns worker count") do ->
      assert_run_exits(worker_count_src(), 0)
    end
    it("sched_worker_busy_ns reads the correct per-worker slot (no stride garbage)") do ->
      assert_run_exits(busy_ns_no_garbage_src(), 0)
    end
    it("sched_task_count tracks active tasks") do ->
      assert_run_exits(task_count_src(), 0)
    end
    it("sched_enable_tracing captures spawn and complete events") do ->
      assert_run_exits(trace_events_src(), 0)
    end
    it("sched_read_traces returns empty vec when tracing disabled") do ->
      assert_run_exits(trace_disabled_src(), 0)
    end
    it("trace ring buffer records correct event types") do ->
      assert_run_exits(trace_types_src(), 0)
    end
  end
  return qspec_main()
end

def worker_count_src(): String = """
  def main(): Int
    sched_init(4)
    var wc = sched_worker_count()
    sched_shutdown()
    if wc == 4
      return 0
    end
    return 1
  end
  """

## Regression: sched_worker_busy_ns must index the per-worker data array
## with the canonical 12-i64 stride (busy_ns at slot [8]). A stale stride
## of 10 read each worker's busy_ns off the wrong slot for every wid>0 —
## worker 2 returned the queue cap (256), worker 4 a heap pointer, etc. —
## surfacing as pointer-like garbage in /load/metrics. Idle workers right
## after sched_init have busy_ns == 0; the bug produced the cap sentinel
## (256) and pointer values (>1e9), so we reject those.
def busy_ns_no_garbage_src(): String = """
  def main(): Int
    sched_init(8)
    sched_yield()
    var w = 0
    while w < 8
      var b = sched_worker_busy_ns(w)
      if b == 256
        sched_shutdown()
        return 1
      end
      if b > 1000000000
        sched_shutdown()
        return 1
      end
      w += 1
    end
    sched_shutdown()
    return 0
  end
  """

def task_count_src(): String = """
  def worker(): Int
    var i = 0
    while i < 100
      sched_yield()
      i += 1
    end
    return 42
  end
  def main(): Int
    sched_init(2)
    var f1 = async worker()
    sched_spawn(f1)
    var f2 = async worker()
    sched_spawn(f2)
    var count = sched_task_count()
    sched_shutdown()
    if count >= 1
      return 0
    end
    return 1
  end
  """

def trace_events_src(): String = """
  def worker(): Int
    var i = 0
    while i < 10
      sched_yield()
      i += 1
    end
    return 42
  end
  def main(): Int
    sched_init(2)
    sched_enable_tracing(1)
    var f1 = async worker()
    sched_spawn(f1)
    var f2 = async worker()
    sched_spawn(f2)
    sched_shutdown()
    var traces = sched_read_traces(100)
    var n = vec_size(traces)
    sched_enable_tracing(0)
    if n >= 16
      return 0
    end
    return 1
  end
  """

def trace_disabled_src(): String = """
  def main(): Int
    sched_init(2)
    var traces = sched_read_traces(100)
    var n = vec_size(traces)
    sched_shutdown()
    if n == 0
      return 0
    end
    return 1
  end
  """

def trace_types_src(): String = """
  def worker(): Int
    var i = 0
    while i < 5
      sched_yield()
      i += 1
    end
    return 99
  end
  def main(): Int
    sched_init(2)
    sched_enable_tracing(1)
    var f = async worker()
    sched_spawn(f)
    sched_shutdown()
    var traces = sched_read_traces(100)
    var n = vec_size(traces)
    sched_enable_tracing(0)
    if n < 8
      return 1
    end
    var spawn_type = vec_get(traces, 0)
    var complete_type = vec_get(traces, 4)
    if spawn_type == 1
      if complete_type == 2
        var payload = vec_get(traces, 7)
        if payload == 99
          return 0
        end
      end
    end
    return 1
  end
  """
