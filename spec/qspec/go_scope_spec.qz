## P26: Go-Task Structured Concurrency Tests
##
## Tests go_scope, go_supervisor, go_scope_timeout, and go_race —
## M:N scheduler nurseries that use async/sched_spawn (317B/task).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("go_scope (P26)") do ->
    it("all children complete before scope exits") do ->
      var src = """
        import std/sync/composition/go
        var g_sum = atomic_new(0)
        def worker10(): Int
          atomic_add(g_sum, 10)
          return 0
        end
        def worker20(): Int
          atomic_add(g_sum, 20)
          return 0
        end
        def scope_body(): Int
          go_spawn(worker10)
          go_spawn(worker20)
          return 0
        end
        def main(): Int
          go_scope(scope_body)
          puts(str_from_int(atomic_load(g_sum)))
          return 0
        end
        """
      assert_run_stdout_eq(src, "30\n")
    end

    it("child failure returns -1") do ->
      var src = """
        import std/sync/composition/go
        def bad(): Int
          return -1
        end
        def scope_body(): Int
          go_spawn(bad)
          return 0
        end
        def main(): Int
          var result = go_scope(scope_body)
          puts(str_from_int(result))
          return 0
        end
        """
      assert_run_stdout_eq(src, "-1\n")
    end

    it("cancel-on-failure stops remaining children") do ->
      var src = """
        import std/sync/composition/go
        var g_count = atomic_new(0)
        def slow_good(): Int
          sched_sleep(200)
          atomic_add(g_count, 1)
          return 0
        end
        def immediate_fail(): Int
          return -1
        end
        def scope_body(): Int
          go_spawn(slow_good)
          go_spawn(immediate_fail)
          return 0
        end
        def main(): Int
          var r = go_scope(scope_body)
          puts(str_from_int(r))
          return 0
        end
        """
      assert_run_stdout_eq(src, "-1\n")
    end
  end

  describe("go_supervisor (P26)") do ->
    it("collects all results including failures") do ->
      var src = """
        import std/sync/composition/go
        def ok_task(): Int = 42
        def fail_task(): Int = -1
        def sup_body(): Int
          go_spawn(ok_task)
          go_spawn(fail_task)
          go_spawn(ok_task)
          return 0
        end
        def main(): Int
          var results = go_supervisor(sup_body)
          puts(str_from_int(vec_size(results)))
          return 0
        end
        """
      assert_run_stdout_eq(src, "3\n")
    end
  end

  describe("go_scope_timeout (P26)") do ->
    it("completes within deadline returns 0") do ->
      var src = """
        import std/sync/composition/go
        def fast(): Int
          sched_sleep(10)
          return 0
        end
        def main(): Int
          var r = go_scope_timeout(5000) do ->
            go_spawn(fast)
            return 0
          end
          puts(str_from_int(r))
          return 0
        end
        """
      assert_run_stdout_eq(src, "0\n")
    end

    it("timeout returns -2") do ->
      var src = """
        import std/sync/composition/go
        def slow(): Int
          sched_sleep(5000)
          return 0
        end
        def main(): Int
          var r = go_scope_timeout(50) do ->
            go_spawn(slow)
            return 0
          end
          puts(str_from_int(r))
          return 0
        end
        """
      assert_run_stdout_eq(src, "-2\n")
    end
  end

  describe("go_race (P26)") do ->
    it("returns result of first completed task") do ->
      var src = """
        import std/sync/composition/go
        def fast(): Int
          sched_sleep(10)
          return 42
        end
        def slow(): Int
          sched_sleep(5000)
          return 99
        end
        def main(): Int
          var tasks = vec_new()
          tasks.push(slow)
          tasks.push(fast)
          var r = go_race(tasks)
          puts(str_from_int(r))
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end
  end

  return qspec_main()
end
