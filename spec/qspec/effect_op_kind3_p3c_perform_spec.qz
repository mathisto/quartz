## Effect kind=3 continuation-preserving resume end-to-end — P3.0c-perform acceptance.
##
## Operation Piezoelectric Effects, Phase 3, Milestone P3.0 (chunk
## P3.0c-perform). Builds on P3.0a (TLS install_idx + resumed array),
## P3.0b (classifier kind=3 tag), P3.0c-runtime (perform stashes
## %kind in TLS), P3.0c-resume (resume(v) runtime kind dispatch),
## P3.0c-resume-guard (null-safe cont_frame), P3.0c-perform-runtime
## (runtime kind=2/3 post-handler split).
##
## What this locks in:
##
##   - A function invoked via `go` that contains a kind=3 perform
##     suspends correctly: save state, store %self into TLS
##     cont_frame, call perform. Handler invokes resume(v), which
##     (via __qz_effect_resume_cont) calls the $poll function nested
##     with v stashed in TLS resume_val. Nested invocation's state
##     machine dispatches to post-perform block, loads v as the
##     perform-expression value, continues body.
##
##   - Body completion writes body_rv to frame[1] and state=-1.
##     Nested poll returns to resume_cont, which sets resumed[idx]=1.
##     Handler continues past resume(), may do more work, eventually
##     returns. __qz_effect_perform sees kind=3 + resumed=1 and
##     returns normally. Outer poll invocation sees perform return
##     and rets POLL_READY (1). Scheduler marks task done. Awaiter
##     wakes via completion pipe, reads frame[1] = body_rv.
##
##   - The classic CPS effect test: trace proves body runs PAST the
##     perform (post-perform prints fire), handler runs PAST its
##     own resume call (handler-after-resume prints fire), and the
##     with-block evaluates to body's return (per memo §Q6).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect kind=3 continuation-preserving resume (piezo P3.0c-perform)") do ->
    it("resume(v) delivers v back into the caller and body runs to completion") do ->
      assert_run_stdout_eq("""
effect Yieldy
  def pause(x: Int): Int
    do_nothing()
    resume(0)
    return 0
  end
end

def do_nothing(): Int = 0

def my_pause(op_name: Int, argc: Int, argv: Int): Int
  resume(42)
  return 999
end

def my_routine(): Int can Yieldy
  var v = pause(7)
  return v
end

def main(): Int
  sched_init(2)
  with Yieldy { pause: my_pause } do ->
    var fut = go my_routine()
    var r = await fut
    puts(str_from_int(r))
  end
  return 0
end
""", "42\n")
    end

    it("body's post-perform code runs in the nested resume-invocation") do ->
      # Proves the continuation re-entry via nested $poll fires all
      # post-perform statements AND the handler's post-resume code.
      # Uses eputs so output ordering is deterministic across
      # scheduler threads (line-buffered stderr flushes per write).
      assert_run_stderr_contains("""
effect Yieldy
  def pause(x: Int): Int
    do_nothing()
    resume(0)
    return 0
  end
end

def do_nothing(): Int = 0

def my_pause(op_name: Int, argc: Int, argv: Int): Int
  eputs("handler-before-resume")
  resume(7)
  eputs("handler-after-resume")
  return 999
end

def my_routine(): Int can Yieldy
  eputs("routine-before-pause")
  var v = pause(0)
  eputs("routine-after-pause")
  return v
end

def main(): Int
  sched_init(2)
  with Yieldy { pause: my_pause } do ->
    var fut = go my_routine()
    var r = await fut
    puts(str_from_int(r))
  end
  return 0
end
""", "routine-after-pause")
    end

    it("handler runs past its own resume call (classic CPS shape)") do ->
      assert_run_stderr_contains("""
effect Yieldy
  def pause(x: Int): Int
    do_nothing()
    resume(0)
    return 0
  end
end

def do_nothing(): Int = 0

def my_pause(op_name: Int, argc: Int, argv: Int): Int
  eputs("handler-before")
  resume(0)
  eputs("handler-after")
  return 0
end

def my_routine(): Int can Yieldy
  var v = pause(0)
  return v + 1
end

def main(): Int
  sched_init(2)
  with Yieldy { pause: my_pause } do ->
    var fut = go my_routine()
    var r = await fut
    puts(str_from_int(r))
  end
  return 0
end
""", "handler-after")
    end

    it("resume value propagates through the perform expression") do ->
      # pause(any) → resume(100); body reads as `v = 100`; `v * 2 = 200`.
      assert_run_stdout_eq("""
effect Prompt
  def ask(x: Int): Int
    do_nothing()
    resume(0)
    return 0
  end
end

def do_nothing(): Int = 0

def my_prompt(op_name: Int, argc: Int, argv: Int): Int
  resume(100)
  return 1
end

def my_worker(): Int can Prompt
  var v = ask(0)
  return v * 2
end

def main(): Int
  sched_init(2)
  with Prompt { ask: my_prompt } do ->
    var fut = go my_worker()
    var r = await fut
    puts(str_from_int(r))
  end
  return 0
end
""", "200\n")
    end
  end
  return qspec_main()
end
