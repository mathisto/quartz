## Module Prefix Tests - Verifies correct symbol prefixing across modules
## Tests for Bug 1 (double-prefix), Bug 4 (private forward-ref),
## Bug 7 (SSA collision), Bug 6 (arity overload)
##
## Contract:
##   1. Multi-file compilation.
##   2. Intra-module prefix (Bug 1).
##   3. Private forward-reference (Bug 4).
##   4. SSA naming (Bug 7).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("multi-file compilation") do ->
    it("compiles and runs a 2-file project") do ->
      var files: Vec = vec_new()
      files.push(as_int("helper.qz"))
      files.push(as_int("def helper_add(a: Int, b: Int): Int = a + b"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import helper
        def main(): Int
          return helper_add(1, 2)
        end
        """))
      assert_multi_run_exits(files, 1, 3)
    end

    it("qualified import with prefix") do ->
      var files: Vec = vec_new()
      files.push(as_int("mathmod.qz"))
      files.push(as_int("def double(x: Int): Int = x * 2"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mathmod
        def main(): Int
          return mathmod::double(5)
        end
        """))
      assert_multi_run_exits(files, 1, 10)
    end

    it("wildcard import without prefix") do ->
      var files: Vec = vec_new()
      files.push(as_int("ops.qz"))
      files.push(as_int("def triple(x: Int): Int = x * 3"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from ops
        def main(): Int
          return triple(4)
        end
        """))
      assert_multi_run_exits(files, 1, 12)
    end
  end

  describe("intra-module prefix (Bug 1)") do ->
    it("no double-prefix on intra-module calls") do ->
      var files: Vec = vec_new()
      files.push(as_int("mymod.qz"))
      vec_push(files, as_int("""
        def helper(): Int = 42
        def caller(): Int
          return helper()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mymod
        def main(): Int
          return mymod::caller()
        end
        """))
      var r = subprocess_compile_multi(files, 1)
      _inc_assertions()
      if str_contains(r.stdout_content, "mymod$mymod$")
        _record_failure("Found double-prefix mymod$mymod$ in IR")
      end
    end

    it("intra-module call has single prefix in IR") do ->
      var files: Vec = vec_new()
      files.push(as_int("smod.qz"))
      vec_push(files, as_int("""
        def helper(): Int = 42
        def caller(): Int
          return helper()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import smod
        def main(): Int
          return smod::caller()
        end
        """))
      assert_multi_ir_contains(files, 1, "@smod$helper")
    end

    it("intra-module call chain works") do ->
      var files: Vec = vec_new()
      files.push(as_int("chain.qz"))
      vec_push(files, as_int("""
        def foo(): Int
          return bar()
        end
        def bar(): Int
          return baz()
        end
        def baz(): Int = 42
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import chain
        def main(): Int
          return chain::foo()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end

    it("cross-module call keeps single prefix") do ->
      var files: Vec = vec_new()
      files.push(as_int("helperb.qz"))
      files.push(as_int("def get_val(): Int = 99"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import helperb
        def main(): Int
          return helperb::get_val()
        end
        """))
      assert_multi_run_exits(files, 1, 99)
    end

    it("already-prefixed call not double-prefixed") do ->
      var files: Vec = vec_new()
      files.push(as_int("mod_a.qz"))
      files.push(as_int("def greet(): Int = 7"))
      files.push(as_int("mod_b.qz"))
      vec_push(files, as_int("""
        import mod_a
        def relay(): Int
          return mod_a::greet()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mod_b
        def main(): Int
          return mod_b::relay()
        end
        """))
      assert_multi_run_exits(files, 2, 7)
    end
  end

  describe("private forward-reference (Bug 4)") do ->
    it("public fn calls private fn defined below") do ->
      var files: Vec = vec_new()
      files.push(as_int("pmod.qz"))
      vec_push(files, as_int("""
        def public_fn(x: Int): Int
          return helper(x)
        end
        private
        def helper(n: Int): Int
          if n <= 0
            return 0
          end
          return n + helper(n - 1)
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import pmod
        def main(): Int
          return pmod::public_fn(5)
        end
        """))
      assert_multi_run_exits(files, 1, 15)
    end

    it("private fn calls another private fn") do ->
      var files: Vec = vec_new()
      files.push(as_int("pmod2.qz"))
      vec_push(files, as_int("""
        def api(): Int
          return step1()
        end
        private
        def step1(): Int
          return step2()
        end
        def step2(): Int = 77
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import pmod2
        def main(): Int
          return pmod2::api()
        end
        """))
      assert_multi_run_exits(files, 1, 77)
    end

    it("cross-module private access rejected") do ->
      var files: Vec = vec_new()
      files.push(as_int("pmod3.qz"))
      vec_push(files, as_int("""
        def api(): Int = 1
        private
        def secret(): Int = 42
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import pmod3
        def main(): Int
          return pmod3::secret()
        end
        """))
      assert_multi_compile_error(files, 1, "has no function")
    end
  end

  describe("SSA naming (Bug 7)") do ->
    it("variable named v1 compiles and runs") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        def main(): Int
          var v1 = 42
          return v1
        end
        """))
      assert_multi_run_exits(files, 0, 42)
    end
    it("variable named v2 in loop") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        def main(): Int
          var v2 = 0
          var i = 0
          while i < 10
            v2 = v2 + 1
            i = i + 1
          end
          return v2
        end
        """))
      assert_multi_run_exits(files, 0, 10)
    end
    it("multiple v-vars: v1 + v2 + v3") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        def main(): Int
          var v1 = 10
          var v2 = 20
          var v3 = 12
          return v1 + v2 + v3
        end
        """))
      assert_multi_run_exits(files, 0, 42)
    end
    it("v-var as function parameter") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        def add_v(v1: Int, v2: Int): Int
          return v1 + v2
        end
        def main(): Int
          return add_v(20, 22)
        end
        """))
      assert_multi_run_exits(files, 0, 42)
    end
  end

  return qspec_main()
end
