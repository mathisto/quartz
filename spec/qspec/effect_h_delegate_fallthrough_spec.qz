## H-delegate fall-through — Milestone H-delegate acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone H-delegate.
##
## Before H-delegate, multi-op handler records went through a
## synthesized `__qz_eff_shim_N` function. Unlisted ops hit the
## shim's fall-through and routed to `__qz_effect_unhandled` →
## exit(66). This spec verifies the new behavior: unlisted ops
## fall through the install stack and hit the next matching
## handler (or the default).
##
## Under H-delegate, multi-op records push ONE stack entry per op
## (parallel `stack_op_filters` array carries the op-name ptr).
## `__qz_effect_perform`'s scan matches eff_name AND (op_filter
## == null OR op_filter == requested_op), so unmatched ops skip
## past the entry.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("H-delegate: unlisted ops fall through to outer handlers") do ->
    it("inner record binds op1; op2 falls through to outer record") do ->
      assert_run_stdout_eq("""
effect E
  def op1(x: Int): Int
  def op2(x: Int): Int
end

def outer_op1(op_name: Int, argc: Int, argv: Int): Int
  puts("OUTER op1: " + load(argv, 0).to_s())
  return 0
end

def outer_op2(op_name: Int, argc: Int, argv: Int): Int
  puts("OUTER op2: " + load(argv, 0).to_s())
  return 0
end

def inner_op1(op_name: Int, argc: Int, argv: Int): Int
  puts("INNER op1: " + load(argv, 0).to_s())
  return 0
end

def main(): Int
  with E { op1: outer_op1, op2: outer_op2 } do ->
    with E { op1: inner_op1 } do ->
      op1(1)
      op2(2)
    end
  end
  return 0
end
""", "INNER op1: 1\nOUTER op2: 2\n")
    end

    it("3-op effect: inner binds 1, middle binds 1, outer binds all 3") do ->
      # Exercises deeper stacks. inner binds op1 only; middle binds op2;
      # outer binds all three. op3() should walk past inner (op_filter
      # mismatch), past middle (same), and fire outer's op3 handler.
      assert_run_stdout_eq("""
effect E
  def op1(x: Int): Int
  def op2(x: Int): Int
  def op3(x: Int): Int
end

def o1(op_name: Int, argc: Int, argv: Int): Int
  puts("O.op1:" + load(argv, 0).to_s())
  0
end
def o2(op_name: Int, argc: Int, argv: Int): Int
  puts("O.op2:" + load(argv, 0).to_s())
  0
end
def o3(op_name: Int, argc: Int, argv: Int): Int
  puts("O.op3:" + load(argv, 0).to_s())
  0
end
def m2(op_name: Int, argc: Int, argv: Int): Int
  puts("M.op2:" + load(argv, 0).to_s())
  0
end
def i1(op_name: Int, argc: Int, argv: Int): Int
  puts("I.op1:" + load(argv, 0).to_s())
  0
end

def main(): Int
  with E { op1: o1, op2: o2, op3: o3 } do ->
    with E { op2: m2 } do ->
      with E { op1: i1 } do ->
        op1(10)
        op2(20)
        op3(30)
      end
    end
  end
  return 0
end
""", "I.op1:10\nM.op2:20\nO.op3:30\n")
    end

    it("single-field record now binds ONLY the specified op (silent-bug fix)") do ->
      # Before H-delegate, a single-field record installed with op_filter=null
      # so the handler intercepted ALL ops of the effect. Under H-delegate,
      # single-field install uses op_filter=field_name and unlisted ops fall
      # through. Confirm: `with E { op1: h }` catches op1 but lets op2 reach
      # the outer handler.
      assert_run_stdout_eq("""
effect E
  def op1(x: Int): Int
  def op2(x: Int): Int
end

def outer(op_name: Int, argc: Int, argv: Int): Int
  puts("outer " + as_string(op_name) + ":" + load(argv, 0).to_s())
  0
end

def inner(op_name: Int, argc: Int, argv: Int): Int
  puts("inner " + as_string(op_name) + ":" + load(argv, 0).to_s())
  0
end

def main(): Int
  with E { op1: outer, op2: outer } do ->
    with E { op1: inner } do ->
      op1(1)
      op2(2)
    end
  end
  return 0
end
""", "inner op1:1\nouter op2:2\n")
    end

    it("unlisted op with no outer handler and no default → exit 66") do ->
      # If no outer handler of E covers the op and E has no blessed
      # default (only Throws + Log are blessed in D.4), the scan runs
      # off the stack bottom and routes to __qz_effect_unhandled.
      assert_run_exits("""
effect Custom
  def op1(x: Int): Int
  def op2(x: Int): Int
end

def h_op1(op_name: Int, argc: Int, argv: Int): Int = 0

def main(): Int
  with Custom { op1: h_op1 } do ->
    op2(99)
  end
  return 0
end
""", 66)
    end

    it("multi-op record with op args preserved through argv") do ->
      # Regression: after dropping the shim, the direct install call
      # must still thread argc/argv correctly to each user handler.
      assert_run_stdout_eq("""
effect M
  def send(msg: String, level: Int): Int
  def recv(id: Int): Int
end

def send_h(op_name: Int, argc: Int, argv: Int): Int
  var m = as_string(load(argv, 0))
  var l = load(argv, 1)
  puts("send:" + m + "@" + l.to_s())
  0
end

def recv_h(op_name: Int, argc: Int, argv: Int): Int
  var i = load(argv, 0)
  puts("recv:" + i.to_s())
  0
end

def main(): Int
  with M { send: send_h, recv: recv_h } do ->
    send("hello", 2)
    recv(42)
    send("world", 5)
  end
  return 0
end
""", "send:hello@2\nrecv:42\nsend:world@5\n")
    end
  end
  return qspec_main()
end
