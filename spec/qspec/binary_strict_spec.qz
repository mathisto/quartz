## Binary DSL — Phase 1.5 STEP 4: typecheck strictness for `as` and `.with`.
##
## Per design decision #12, `as` is strict: source-to-u<N> requires the
## source to be a packed struct with matching backing width. u<N>-to-struct
## requires the target to be a packed struct and the source to be Int.
## `.with { field = ... }` validates field names at typecheck — typos
## are rejected rather than silently ignored.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — typecheck strictness (STEP 4)") do ->

    it("rejects `as u32` on non-packed struct (QZ0954)") do ->
      assert_compile_error("""
        struct Plain
          a: Int
          b: Int
        end
        def main(): Int
          var p = Plain { a: 1, b: 2 }
          var r = p as u32
          return 0
        end
        """, "QZ0954")
    end

    it("rejects `as uN` with mismatched backing width (QZ0955)") do ->
      assert_compile_error("""
        packed struct(u8) Small
          a: 4
          b: 4
        end
        def main(): Int
          var s = Small { a: 1, b: 2 }
          var r = s as u32
          return 0
        end
        """, "QZ0955")
    end

    it("rejects `as StructName` with non-packed target (QZ0956)") do ->
      assert_compile_error("""
        struct Plain
          a: Int
          b: Int
        end
        def main(): Int
          var r = 42 as Plain
          return 0
        end
        """, "QZ0956")
    end

    it("rejects `.with` on non-packed struct (QZ0958)") do ->
      assert_compile_error("""
        struct Plain
          a: Int
          b: Int
        end
        def main(): Int
          var p = Plain { a: 1, b: 2 }
          var q = p.with { a = 5 }
          return 0
        end
        """, "QZ0958")
    end

    it("rejects `.with` with unknown field name (QZ0959)") do ->
      assert_compile_error("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 1, w: 2 }
          var g = f.with { zzz = 9 }
          return 0
        end
        """, "QZ0959")
    end

    it("accepts valid `as` and `.with` usage") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 10, w: 3 }
          var raw = f as u8
          var g = f.with { v = 5 }
          return 99 if raw != 163
          return 98 if g.v != 5
          return 0
        end
        """, 0)
    end

  end

  return qspec_main()
end
