## Simd I32X4 Tests
##
## Contract:
##   1. Chained operations.
##   2. Emits <4 x i32>.
##   3. Handles negative values correctly.
##   4. Simd_i32x4_add.
##   5. Simd_i32x4_mul.
##   6. Simd_i32x4_sub.
import * from qspec

def main(): Int
  describe("SIMD I32x4") do ->
    it("splat and extract all four lanes") do ->
      assert_eq(si4_splat(), 1)
    end
    it("simd_i32x4_add") do ->
      assert_eq(si4_add(), 42)
    end
    it("simd_i32x4_sub") do ->
      assert_eq(si4_sub(), 42)
    end
    it("simd_i32x4_mul") do ->
      assert_eq(si4_mul(), 42)
    end
    it("simd_i32x4_sum") do ->
      assert_eq(si4_sum(), 40)
    end
    it("handles negative values correctly") do ->
      assert_eq(si4_neg(), 1)
    end
    it("chained operations") do ->
      assert_eq(si4_chain(), 21)
    end
    it("emits <4 x i32> vector instructions (IR test)") do ->
      assert_ir_contains("""
def main(): Int
  v = simd_i32x4_splat(42)
  return simd_i32x4_extract(v, 0)
end
""", "insertelement <4 x i32>")
    end
  end
  return qspec_main()
end

def si4_splat(): Int
  var v = simd_i32x4_splat(42)
  var lane0 = simd_i32x4_extract(v, 0)
  var lane1 = simd_i32x4_extract(v, 1)
  var lane2 = simd_i32x4_extract(v, 2)
  var lane3 = simd_i32x4_extract(v, 3)
  if lane0 == 42
    if lane1 == 42
      if lane2 == 42
        if lane3 == 42
          return 1
        end
      end
    end
  end
  return 0
end
def si4_add(): Int
  var a = simd_i32x4_splat(10)
  var b = simd_i32x4_splat(32)
  var c = simd_i32x4_add(a, b)
  return simd_i32x4_extract(c, 0)
end
def si4_sub(): Int
  var a = simd_i32x4_splat(50)
  var b = simd_i32x4_splat(8)
  var c = simd_i32x4_sub(a, b)
  return simd_i32x4_extract(c, 0)
end
def si4_mul(): Int
  var a = simd_i32x4_splat(6)
  var b = simd_i32x4_splat(7)
  var c = simd_i32x4_mul(a, b)
  return simd_i32x4_extract(c, 0)
end
def si4_sum(): Int
  var v = simd_i32x4_splat(10)
  return simd_i32x4_sum(v)
end
def si4_neg(): Int
  var a = simd_i32x4_splat(100)
  var b = simd_i32x4_splat(150)
  var c = simd_i32x4_sub(a, b)
  var val = simd_i32x4_extract(c, 0)
  if val == -50
    return 1
  end
  return 0
end
def si4_chain(): Int
  var a = simd_i32x4_splat(3)
  var b = simd_i32x4_splat(4)
  var sum = simd_i32x4_add(a, b)
  var product = simd_i32x4_mul(sum, a)
  return simd_i32x4_extract(product, 0)
end
