## Range Tests
##
## Contract:
##   1. Range_contains.
##   2. Range accessors.
##   3. Range as variable.
##   4. For-loop with range.
import * from qspec

def main(): Int
  describe("range_contains") do ->
    it("exclusive range 0..5 contains 3") do ->
      r = 0..5
      assert_eq(range_contains(r, 3), 1)
    end

    it("exclusive range 0..5 does not contain 5") do ->
      r = 0..5
      assert_eq(range_contains(r, 5), 0)
    end

    it("inclusive range 0...5 contains 5") do ->
      r = 0...5
      assert_eq(range_contains(r, 5), 1)
    end

    it("range does not contain value below start") do ->
      r = 5..10
      assert_eq(range_contains(r, 3), 0)
    end
  end

  describe("range accessors") do ->
    it("range_start returns start value") do ->
      r = 3..10
      assert_eq(range_start(r), 3)
    end

    it("range_end returns end value") do ->
      r = 3..10
      assert_eq(range_end(r), 10)
    end

    it("range_size returns length for exclusive range") do ->
      r = 0..5
      assert_eq(range_size(r), 5)
    end

    it("range_size returns length for inclusive range") do ->
      r = 0...5
      assert_eq(range_size(r), 6)
    end
  end

  describe("range as variable") do ->
    it("can store range in variable and pass to function") do ->
      r = 0..10
      assert_eq(range_sum(r), 45)
    end
  end

  describe("for-loop with range") do ->
    it("for i in 0..5 iterates correctly") do ->
      assert_eq(range_for_loop_sum(), 10)
    end
  end

  return qspec_main()
end

def range_for_loop_sum(): Int
  var sum = 0
  for i in 0..5
    sum = sum + i
  end
  return sum
end

def range_sum(r: Int): Int
  var sum = 0
  var i = range_start(r)
  while i < range_end(r)
    sum = sum + i
    i += 1
  end
  return sum
end
