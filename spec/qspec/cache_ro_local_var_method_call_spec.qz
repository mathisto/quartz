import * from qspec
import * from style

# Cache-ro regression: UFCS method call on a local variable bound to a
# stdlib type. Receiver is `var s: Style` — mir_ctx_get_var_type returns
# "Style" via the let-binding tracker (mir_ctx_mark_struct_var in
# mir_lower_stmt_handlers.qz). Subsequent `s.bold()` mangles to
# `Style$bold` via Path A's fallback.
#
# Distinct from the method-chain spec: receiver here is a VAR, not a
# chain leaf. Tests Phase 1's unified resolver in the simplest shape.
#
# Path A at mir_lower_expr_handlers.qz:1458-1498 should ALREADY handle
# this — `mir_infer_expr_type(NODE_IDENT for local var)` returns "Style".
# This spec verifies the path hasn't regressed and exercises the unified
# resolver in Phase 1.

def main(): Int
  describe("cache-ro UFCS on local var") do ->
    it("var s = Style.new(); s.bold() works") do ->
      var s = Style.new()
      var s2 = s.bold()
      var out = s2.render_at("hi", 256)
      assert_eq(str_byte_len(out) > 0, true)
    end

    it("multi-step builder pattern through local vars") do ->
      var base = Style.new()
      var bolded = base.bold()
      var colored = bolded.fg(Green())
      var rendered = colored.render_at("multi", 256)
      assert_eq(str_byte_len(rendered) > 0, true)
    end

    it("local var preserves identity across method calls") do ->
      var s = Style.new()
      var a = s.bold().render_at("a", 0)
      var b = s.bold().render_at("a", 0)
      assert_eq_str(a, b)
    end
  end
  return qspec_main()
end
