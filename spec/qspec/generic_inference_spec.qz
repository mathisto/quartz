## Generic Inference Tests
##
## Contract:
##   1. Explicit type args: `Box<Int>` produces concrete type.
##   2. Inference: type args inferred from field values.
##   3. Multi-param: inference with multiple type parameters.
##   4. Field access: field of generic returns concrete type.
##   5. Match: pattern match on generic enum extracts value.
##   6. Nothing path: match Nothing arm of generic enum.
##   7. Nested: generic inside generic.
import * from qspec

enum GIMaybe<T>
  Just(value: T)
  Nothing
end

struct GIBox<T>
  value: T
end

struct GIPair<A, B>
  first: A
  second: B
end

def gi_identity(x: Int): Int = x

def main(): Int
  describe("generic inference") do ->
    it("explicit type args produce correct type") do ->
      var b = GIBox<Int> { value: 5 }
      assert_eq(b.value, 5)
    end

    it("infers type args from field values") do ->
      var w = GIBox { value: 42 }
      assert_eq(w.value, 42)
    end

    it("infers multiple type args") do ->
      var p = GIPair { first: 10, second: 20 }
      assert_eq(p.first + p.second, 30)
    end

    it("field access returns concrete type") do ->
      var b = GIBox<Int> { value: 7 }
      assert_eq(gi_identity(b.value), 7)
    end

    it("match binding on generic enum") do ->
      m = GIMaybe::Just(42)
      result = match m
        GIMaybe::Just(val) => val
        GIMaybe::Nothing => 0
        _ => 0
      end
      assert_eq(result, 42)
    end

    it("Nothing path returns default") do ->
      m = GIMaybe::Nothing
      result = match m
        GIMaybe::Just(val) => val
        GIMaybe::Nothing => -1
        _ => -2
      end
      assert_eq(result, -1)
    end

    it("nested generic: Box of Pair") do ->
      var inner = GIPair { first: 20, second: 22 }
      var outer = GIBox { value: inner.first + inner.second }
      assert_eq(outer.value, 42)
    end

    it("inferred pair with computed values") do ->
      var p = GIPair { first: 6 * 7, second: 100 / 10 }
      assert_eq(p.first, 42)
      assert_eq(p.second, 10)
    end
  end
  return qspec_main()
end
