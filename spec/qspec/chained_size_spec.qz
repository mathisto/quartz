import * from qspec

struct Container
  items: Vec<String>
  count: Int
end

def make_container(): Container
  var v = vec_new<String>()
  v.push("alpha")
  v.push("beta")
  v.push("gamma")
  return Container{items: v, count: 3}
end

def main(): Int
  describe("str_split return type") do ->
    it("returns correct count via .size") do ->
      var parts = str_split("a,b,c", ",")
      assert_eq(parts.size, 3)
    end

    it("indexes return strings") do ->
      var parts = str_split("hello|world", "|")
      assert_eq_str(parts[0], "hello")
      assert_eq_str(parts[1], "world")
    end
  end

  describe("chained .size on struct Vec field") do ->
    it("accesses Vec<String> field .size") do ->
      var c = make_container()
      assert_eq(c.items.size, 3)
    end

    it("accesses Vec<String> field elements") do ->
      var c = make_container()
      assert_eq_str(c.items[0], "alpha")
      assert_eq_str(c.items[2], "gamma")
    end
  end

  describe("UFCS on str_split results") do ->
    it("calls .char_at on indexed element") do ->
      var parts = str_split("hello|world", "|")
      var first = parts[0]
      assert_eq(first.char_at(0), 104)
    end

    it("calls .find on string from split") do ->
      var parts = str_split("hello|world", "|")
      var second = parts[1]
      match second.find("rl")
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
    end

    it("calls UFCS .split on a string") do ->
      var text = "a,b,c"
      var parts = text.split(",")
      assert_eq(parts.size, 3)
      assert_eq_str(parts[1], "b")
    end

    it("calls UFCS .contains on a string") do ->
      var parts = str_split("foo-bar", "-")
      var first = parts[0]
      assert_eq(first.contains("oo"), 1)
    end
  end
  return qspec_main()
end
