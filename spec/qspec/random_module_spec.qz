## Random Module Tests — TDD spec
##
## Tests: seed, range, float, bool, shuffle, choice, sample.
##
## Contract:
##   1. Random module.
##   2. Random helpers.

import * from qspec
import * from random

def main(): Int
  describe("random module") do ->
    it("random_seed produces deterministic sequence") do ->
      rand_seed(42)
      var a = rand_int()
      rand_seed(42)
      var b = rand_int()
      assert_eq(a, b)
    end

    it("random_range stays within bounds") do ->
      rand_seed(123)
      var all_in_range = 1
      for i in 0..100
        var v = rand_range(10, 20)
        if v < 10 or v >= 20
          all_in_range = 0
        end
      end
      assert_eq(all_in_range, 1)
    end

    it("random_float is in [0, 1)") do ->
      rand_seed(456)
      var all_in_range = 1
      for i in 0..100
        var f = rand_float()
        if f < 0.0 or f >= 1.0
          all_in_range = 0
        end
      end
      assert_eq(all_in_range, 1)
    end
  end

  describe("random helpers") do ->
    it("random_bool returns 0 or 1") do ->
      rand_seed(789)
      var all_valid = 1
      for i in 0..100
        var b = random_bool()
        if b != 0 and b != 1
          all_valid = 0
        end
      end
      assert_eq(all_valid, 1)
    end

    it("shuffle preserves length") do ->
      rand_seed(111)
      var v = vec_new()
      for i in 0..10
        v.push(i)
      end
      random_shuffle(v)
      assert_eq(v.size, 10)
    end

    it("shuffle preserves elements") do ->
      rand_seed(222)
      var v = vec_new()
      for i in 0..10
        v.push(i)
      end
      random_shuffle(v)
      # Sum should be preserved (0+1+...+9 = 45)
      var total = 0
      for i in 0..10
        total += v[i]
      end
      assert_eq(total, 45)
    end

    it("choice returns element from vec") do ->
      rand_seed(333)
      var v = vec_new()
      v.push(100)
      v.push(200)
      v.push(300)
      var c = random_choice(v)
      # Must be one of the values
      var valid = (c == 100) or (c == 200) or (c == 300)
      assert_eq(valid, true)
    end

    it("sample returns k elements") do ->
      rand_seed(444)
      var v = vec_new()
      for i in 0..20
        v.push(i)
      end
      var s = random_sample(v, 5)
      assert_eq(s.size, 5)
    end

    it("sample k > n returns n elements") do ->
      rand_seed(555)
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var s = random_sample(v, 10)
      assert_eq(s.size, 3)
    end
  end

  return qspec_main()
end
