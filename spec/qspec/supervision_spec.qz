import * from qspec
import * from std/sync/composition/go

var g_attempt_count = 0

# Atomics for supervisor_tree tests
var g_st_ofo_c0 = 0
var g_st_ofo_c1 = 0
var g_st_ofo_c2 = 0
var g_st_ofo_attempts = 0

var g_st_ofa_total = 0
var g_st_ofa_attempts = 0

var g_st_rfo_c0 = 0
var g_st_rfo_c1 = 0
var g_st_rfo_c2 = 0
var g_st_rfo_attempts = 0

var g_st_single_attempts = 0

def succeeding_task(): Int
  return 42
end

def failing_then_succeeding(): Int
  g_attempt_count += 1
  if g_attempt_count <= 2
    return -1  # fail first 2 attempts
  end
  return 0  # succeed on 3rd attempt
end

def always_failing(): Int
  return -1
end

def test_supervised_success(): Void
  var result = supervised(3, succeeding_task)
  puts(to_str(result))
end

def test_supervised_always_fail(): Void
  var result = supervised(2, always_failing)
  puts(to_str(result))
end

def scope_body(): Int
  puts("scope ok")
  return 0
end

def test_existing_scope(): Void
  sched_init(2)
  scope(scope_body)
  sched_shutdown()
end

def child_ok(): Int = 1

def structured_scope_body(): Int
  go_spawn(child_ok)
  go_spawn(child_ok)
  return 0
end

def test_structured_scope(): Void
  var r = structured_scope(structured_scope_body)
  puts("structured ok")
end

def supervisor_body(): Int
  go_spawn(child_ok)
  go_spawn(always_failing)
  go_spawn(child_ok)
  return 0
end

def test_structured_supervisor(): Void
  var results = structured_supervisor(supervisor_body)
  puts("supervisor ok")
end

# --- supervisor_tree test helpers ---

def st_child_ok(): Int = 0

def st_always_fail(): Int = -1

# ONE_FOR_ONE per-child tracking
def st_ofo_c0(): Int
  atomic_add(g_st_ofo_c0, 1)
  return 0
end

def st_ofo_c1(): Int
  var attempt = atomic_add(g_st_ofo_attempts, 1)
  atomic_add(g_st_ofo_c1, 1)
  if attempt == 0
    return -1
  end
  return 0
end

def st_ofo_c2(): Int
  atomic_add(g_st_ofo_c2, 1)
  return 0
end

# ONE_FOR_ALL total tracking
def st_ofa_ok(): Int
  atomic_add(g_st_ofa_total, 1)
  return 0
end

def st_ofa_fail(): Int
  var attempt = atomic_add(g_st_ofa_attempts, 1)
  atomic_add(g_st_ofa_total, 1)
  if attempt == 0
    return -1
  end
  return 0
end

# REST_FOR_ONE per-child tracking
def st_rfo_c0(): Int
  atomic_add(g_st_rfo_c0, 1)
  return 0
end

def st_rfo_c1(): Int
  var attempt = atomic_add(g_st_rfo_attempts, 1)
  atomic_add(g_st_rfo_c1, 1)
  if attempt == 0
    return -1
  end
  return 0
end

def st_rfo_c2(): Int
  atomic_add(g_st_rfo_c2, 1)
  return 0
end

# Single child fail-then-recover
def st_single_fail(): Int
  var attempt = atomic_add(g_st_single_attempts, 1)
  if attempt == 0
    return -1
  end
  return 0
end

# --- supervisor_tree test functions ---

def test_st_all_succeed(): Void
  var children = vec_new()
  children.push(st_child_ok)
  children.push(st_child_ok)
  children.push(st_child_ok)
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 5, children)
  puts(to_str(result))
end

def test_st_one_for_one(): Void
  g_st_ofo_c0 = atomic_new(0)
  g_st_ofo_c1 = atomic_new(0)
  g_st_ofo_c2 = atomic_new(0)
  g_st_ofo_attempts = atomic_new(0)
  var children = vec_new()
  children.push(st_ofo_c0)
  children.push(st_ofo_c1)
  children.push(st_ofo_c2)
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 5, children)
  var c0 = atomic_load(g_st_ofo_c0)
  var c1 = atomic_load(g_st_ofo_c1)
  var c2 = atomic_load(g_st_ofo_c2)
  puts("#{to_str(result)} #{to_str(c0)} #{to_str(c1)} #{to_str(c2)}")
end

def test_st_one_for_all(): Void
  g_st_ofa_total = atomic_new(0)
  g_st_ofa_attempts = atomic_new(0)
  var children = vec_new()
  children.push(st_ofa_ok)
  children.push(st_ofa_fail)
  children.push(st_ofa_ok)
  var result = supervisor_tree(RESTART_ONE_FOR_ALL, 5, children)
  var total = atomic_load(g_st_ofa_total)
  puts("#{to_str(result)} #{to_str(total)}")
end

def test_st_rest_for_one(): Void
  g_st_rfo_c0 = atomic_new(0)
  g_st_rfo_c1 = atomic_new(0)
  g_st_rfo_c2 = atomic_new(0)
  g_st_rfo_attempts = atomic_new(0)
  var children = vec_new()
  children.push(st_rfo_c0)
  children.push(st_rfo_c1)
  children.push(st_rfo_c2)
  var result = supervisor_tree(RESTART_REST_FOR_ONE, 5, children)
  var c0 = atomic_load(g_st_rfo_c0)
  var c1 = atomic_load(g_st_rfo_c1)
  var c2 = atomic_load(g_st_rfo_c2)
  puts("#{to_str(result)} #{to_str(c0)} #{to_str(c1)} #{to_str(c2)}")
end

def test_st_budget_exceeded(): Void
  var children = vec_new()
  children.push(st_always_fail)
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 2, children)
  puts(to_str(result))
end

def test_st_empty(): Void
  var children = vec_new()
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 5, children)
  puts(to_str(result))
end

def test_st_single_recover(): Void
  g_st_single_attempts = atomic_new(0)
  var children = vec_new()
  children.push(st_single_fail)
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 5, children)
  puts(to_str(result))
end

def test_st_max_zero(): Void
  var children = vec_new()
  children.push(st_always_fail)
  var result = supervisor_tree(RESTART_ONE_FOR_ONE, 0, children)
  puts(to_str(result))
end

def main(): Int
  describe("supervision trees") do ->

    it("supervised succeeds on first try") do ->
      assert_output("42\n", test_supervised_success)
    end

    it("supervised returns -1 after max restarts exceeded") do ->
      assert_output("-1\n", test_supervised_always_fail)
    end

    it("existing scope() still works") do ->
      assert_output("scope ok\n", test_existing_scope)
    end

    it("structured_scope awaits all children") do ->
      assert_output("structured ok\n", test_structured_scope)
    end

    it("structured_supervisor isolates failures") do ->
      assert_output("supervisor ok\n", test_structured_supervisor)
    end

    # --- supervisor_tree tests ---

    it("supervisor_tree: all children succeed returns 0") do ->
      assert_output("0\n", test_st_all_succeed)
    end

    it("supervisor_tree: ONE_FOR_ONE restarts only failed child") do ->
      assert_output("0 1 2 1\n", test_st_one_for_one)
    end

    it("supervisor_tree: ONE_FOR_ALL restarts all children") do ->
      assert_output("0 6\n", test_st_one_for_all)
    end

    it("supervisor_tree: REST_FOR_ONE restarts failed and later") do ->
      assert_output("0 1 2 2\n", test_st_rest_for_one)
    end

    it("supervisor_tree: budget exceeded returns -1") do ->
      assert_output("-1\n", test_st_budget_exceeded)
    end

    it("supervisor_tree: empty children returns 0") do ->
      assert_output("0\n", test_st_empty)
    end

    it("supervisor_tree: single child fails then recovers") do ->
      assert_output("0\n", test_st_single_recover)
    end

    it("supervisor_tree: max_restarts=0 means first failure fatal") do ->
      assert_output("-1\n", test_st_max_zero)
    end

  end

  return qspec_main()
end
