## Static Files Spec — Tests for MIME type detection, path traversal, with_static

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers
# =============================================================================

def make_get_request(path: String): Request
  return Request {
    method: "GET", path: path, query_string: "", body: "",
    raw_path: path,
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
end

def fallback_handler(req: Request): Response
  return text_response("fallback")
end

# =============================================================================
# Test helpers — MIME types
# =============================================================================

def print_mime_html(): Void
  puts(_mime_type("index.html"))
end

def print_mime_css(): Void
  puts(_mime_type("style.css"))
end

def print_mime_js(): Void
  puts(_mime_type("app.js"))
end

def print_mime_json(): Void
  puts(_mime_type("data.json"))
end

def print_mime_png(): Void
  puts(_mime_type("image.png"))
end

def print_mime_jpg(): Void
  puts(_mime_type("photo.jpg"))
end

def print_mime_svg(): Void
  puts(_mime_type("icon.svg"))
end

def print_mime_pdf(): Void
  puts(_mime_type("doc.pdf"))
end

def print_mime_md(): Void
  puts(_mime_type("readme.md"))
end

def print_mime_default(): Void
  puts(_mime_type("archive.tar.gz"))
end

# =============================================================================
# Test helpers — Path traversal
# =============================================================================

def print_traversal_dotdot(): Void
  if _has_path_traversal("../../etc/passwd")
    puts("blocked")
  else
    puts("allowed")
  end
end

def print_traversal_encoded(): Void
  if _has_path_traversal("%2e%2e/etc/passwd")
    puts("blocked")
  else
    puts("allowed")
  end
end

def print_traversal_safe(): Void
  if _has_path_traversal("docs/readme.md")
    puts("blocked")
  else
    puts("allowed")
  end
end

# =============================================================================
# Test helpers — Static serving via _static_handle_request
# =============================================================================

def print_static_serves_file(): Void
  write_file("/tmp/_qspec_static_test.txt", "hello static")
  var req = make_get_request("/static/_qspec_static_test.txt")
  var resp = _static_handle_request("/static", "/tmp", fallback_handler, req)
  puts(str_from_int(resp.status))
  puts(resp.content_type)
  puts(resp.body)
end

def print_static_falls_through(): Void
  var req = make_get_request("/static/_qspec_nonexistent_xyz.txt")
  var resp = _static_handle_request("/static", "/tmp", fallback_handler, req)
  puts(resp.body)
end

def print_static_blocks_traversal(): Void
  var req = make_get_request("/files/../etc/passwd")
  var resp = _static_handle_request("/files", "/tmp", fallback_handler, req)
  puts(str_from_int(resp.status))
end

def print_static_wrong_prefix(): Void
  var req = make_get_request("/other/file.txt")
  var resp = _static_handle_request("/static", "/tmp", fallback_handler, req)
  puts(resp.body)
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("_mime_type") do ->
    it("detects HTML") do ->
      assert_output("text/html\n", print_mime_html)
    end

    it("detects CSS") do ->
      assert_output("text/css\n", print_mime_css)
    end

    it("detects JavaScript") do ->
      assert_output("application/javascript\n", print_mime_js)
    end

    it("detects JSON") do ->
      assert_output("application/json\n", print_mime_json)
    end

    it("detects PNG") do ->
      assert_output("image/png\n", print_mime_png)
    end

    it("detects JPEG") do ->
      assert_output("image/jpeg\n", print_mime_jpg)
    end

    it("detects SVG") do ->
      assert_output("image/svg+xml\n", print_mime_svg)
    end

    it("detects PDF") do ->
      assert_output("application/pdf\n", print_mime_pdf)
    end

    it("detects markdown as text/html") do ->
      assert_output("text/html\n", print_mime_md)
    end

    it("defaults to octet-stream") do ->
      assert_output("application/octet-stream\n", print_mime_default)
    end
  end

  describe("_has_path_traversal") do ->
    it("blocks .. traversal") do ->
      assert_output("blocked\n", print_traversal_dotdot)
    end

    it("blocks percent-encoded traversal") do ->
      assert_output("blocked\n", print_traversal_encoded)
    end

    it("allows safe paths") do ->
      assert_output("allowed\n", print_traversal_safe)
    end
  end

  describe("_static_handle_request") do ->
    it("serves existing file with correct MIME type") do ->
      assert_output("200\ntext/plain\nhello static\n", print_static_serves_file)
    end

    it("falls through for missing files") do ->
      assert_output("fallback\n", print_static_falls_through)
    end

    it("blocks path traversal with 403") do ->
      assert_output("403\n", print_static_blocks_traversal)
    end

    it("falls through for wrong prefix") do ->
      assert_output("fallback\n", print_static_wrong_prefix)
    end
  end

  return qspec_main()
end
