## SURF.FLOW Phase 3 — Result narrowing, arbitrary user-enum `is Variant`,
## `and`-chains, and nested guards. Generalizes the Option-only Phase 1/2 narrowing
## (FLOW_NARROWING.md §5 Phase 3). SOUNDNESS is the point (§3.3): narrowing must
## never let the wrong variant's payload be read, must never else-narrow a 3+-variant
## enum, must never narrow from an `and`-chain's else, and a narrowed value flowing
## WHOLE into a wide enum slot must round-trip the wide word (the Phase-2 SIGSEGV
## class, here extended to Result + user enums).
##
## Behavioral signal (same trick as flow_narrow_p2_spec): a CORRECT narrowing yields
## the exact inner payload value; an un-narrowed read passes the raw enum word, which
## is a garbage pointer-ish integer ≠ the payload. So `== value` proves narrowing
## fired; `!= value` proves a soundness invalidation/non-narrowing held.
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

# Boxed payload struct (non-@value ⇒ a genuine boxed pointer payload).
struct Box
  v: Int
end

def box_v(b: Box): Int = b.v

# --- Result narrowing: SPILL layout (Result<Int,String> — scalar Ok payload) ---

## `if r is Ok` — then-branch narrows r to inner T (Int).
def result_is_ok_then(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if r is Ok
    out = use_int(r)
  end
  return out
end

## `r.ok?` then-narrow.
def result_ok_pred_then(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if r.ok?
    out = use_int(r)
  end
  return out
end

## `r.is_ok()` then-narrow.
def result_is_ok_ufcs_then(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if r.is_ok()
    out = use_int(r)
  end
  return out
end

## `if r is Err` — then-branch narrows r to inner E (String). Result then-narrows
## BOTH arms (Err carries a readable payload, unlike Option None).
def result_is_err_then(): String
  r: Result<Int, String> = Result::Err("boom")
  var out = "MISS"
  if r is Err
    out = use_str(r)
  end
  return out
end

## `r.err?` then-narrow to E.
def result_err_pred_then(): String
  r: Result<Int, String> = Result::Err("boom")
  var out = "MISS"
  if r.err?
    out = use_str(r)
  end
  return out
end

## else-narrow: else of `r is Ok` proves r is Err → narrow to E in else.
def result_else_narrows_err(): String
  r: Result<Int, String> = Result::Err("nope")
  var out = "MISS"
  if r is Ok
    out = "WAS_OK"
  else
    out = use_str(r)
  end
  return out
end

## else-narrow: else of `r.err?` proves r is Ok → narrow to T in else.
def result_else_narrows_ok(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if r.err?
    out = -1
  else
    out = use_int(r)
  end
  return out
end

## guard-style: `if r is Err return end; use(r as T)` — r narrows to Ok-T after.
def result_guard_style(): Int
  r: Result<Int, String> = Result::Ok(42)
  if r is Err
    return -1
  end
  return use_int(r)
end

# --- Result narrowing: NICHE-MULTI layout (Result<String,String> — both boxed) ---
#
# PARKED — niche-multi Result (both type args boxed) is PRE-EXISTING broken in the
# compiler independent of flow-narrowing: `r is Ok` / `r.ok?` evaluate FALSE and even
# `match r { Ok(v) => v }` yields a null/garbage payload on the GOLDEN (pre-Phase-3)
# binary (verified by IR + run, 2026-06-18). The narrowing classifier/extractor IS
# generalized to niche-multi (the `& ~7` mask path in mir_emit_narrowed_read), so it
# will light up automatically once the underlying niche-multi Result tag-read/extract
# is fixed. Until then narrowing is INERT for niche Result (the guard branch is never
# taken) and SOUND (the narrowed-into-wide pin protects whole-flow). The soundness
# round-trip below proves niche Result does not CRASH under narrowing.

## SOUNDNESS: a niche Result flowing whole through a narrowing region must not crash
## (the pin round-trips the wide word). The `is Ok` guard is pre-existing-false so the
## then-branch is dead; the else assigns the whole word back. We do NOT `match` the
## sink (niche-multi Result match is pre-existing broken — see PARK note), only prove
## the flow completes and returns a determinate sentinel without a SIGSEGV.
def result_niche_roundtrip_safe(): Int
  r: Result<String, String> = Result::Err("E")
  var sink: Result<String, String> = Result::Err("init")
  if r is Ok
    sink = r   # dead branch (is Ok pre-existing false) — but must typecheck/lower
  else
    sink = r   # whole-word assign into a Result slot — pin round-trips, no crash
  end
  return 7
end

## niche-multi Result Ok then-narrow: `r is Ok` narrows r to the inner T (String).
## The narrowed value is usable as the Ok payload String inside the branch (no unwrap).
def result_niche_ok_then(): String
  r: Result<String, String> = Result::Ok("hi")
  var out = "MISS"
  if r is Ok
    out = use_str(r)
  end
  return out
end

## niche-multi Result Err then-narrow: `r is Err` narrows r to the inner E (String).
def result_niche_err_then(): String
  r: Result<String, String> = Result::Err("boom")
  var out = "MISS"
  if r is Err
    out = use_str(r)
  end
  return out
end

## niche-multi Result else-narrow: else of `r is Ok` proves r is Err → narrow to E.
def result_niche_else_narrows_err(): String
  r: Result<String, String> = Result::Err("nope")
  var out = "MISS"
  if r is Ok
    out = "WAS_OK"
  else
    out = use_str(r)
  end
  return out
end

# --- Arbitrary user enums ---

# Binary user enum (exactly 2 variants, each single-payload boxed).
enum Pair
  Left(box: Box)
  Right(box: Box)
end

## `e is Left` then-narrow to the Left payload (Box). Read its .v field.
def user_binary_then(): Int
  e: Pair = Pair::Left(Box { v: 7 })
  var out = 0
  if e is Left
    out = box_v(e)
  end
  return out
end

## Binary user enum else-narrow: else of `is Left` ⇒ Right → narrow to Right's Box.
def user_binary_else(): Int
  e: Pair = Pair::Right(Box { v: 9 })
  var out = 0
  if e is Left
    out = -1
  else
    out = box_v(e)
  end
  return out
end

# 3-variant user enum — THEN-only narrowing (else could be any remaining variant).
enum Tri
  A(box: Box)
  B(box: Box)
  C
end

## 3-variant `is A` then-narrow to A's Box payload.
def user_tri_then(): Int
  e: Tri = Tri::A(Box { v: 11 })
  var out = 0
  if e is A
    out = box_v(e)
  end
  return out
end

## SOUNDNESS: a 3-variant enum does NOT else-narrow. In the else of `e is A`, e
## could be B or C — so `e` must NOT be narrowed. A bare read in the else must be the
## raw enum word (≠ a payload). Here e is B(v=13); if the else wrongly narrowed to A
## it would still read B's box. We DON'T narrow, so reading e via box_v in the else
## is undefined ABI-wise — instead we MUST use an explicit match. To prove no
## else-narrow without a must-not-compile harness, we verify the explicit-match path
## yields the correct value (a bare narrowed read is simply never emitted because the
## else table has no refinement; if it did, this function's structure would differ).
## We assert the explicit match works AND that a separately-narrowed THEN path on the
## same enum yields the payload — i.e. then narrows, else does not.
def user_tri_else_explicit(): Int
  e: Tri = Tri::B(Box { v: 13 })
  var out = 0
  if e is A
    out = -1
  else
    out = match e
      A(b) => box_v(b)
      B(b) => box_v(b)
      C    => -2
    end
  end
  return out
end

# --- and-chains ---

## `if a.some? and b.some?` narrows BOTH a and b in the then-branch (fact union).
def and_chain_double_narrow(): Int
  a: Option<Int> = option_some(10)
  b: Option<Int> = option_some(32)
  var out = 0
  if a.some? and b.some?
    out = use_int_raw(a) + use_int_raw(b)
  end
  return out
end

## and-chain mixing Option + Result: both narrow in the then-branch.
def and_chain_option_result(): Int
  a: Option<Int> = option_some(5)
  r: Result<Int, String> = Result::Ok(37)
  var out = 0
  if a.some? and r.is_ok()
    out = use_int_raw(a) + use_int_raw(r)
  end
  return out
end

## SOUNDNESS: the ELSE of an `and`-chain proves nothing (De Morgan). Neither a nor b
## may be narrowed in the else. Here a is None, b is Some(99); the else fires. A bare
## read of b in the else must be UN-narrowed (raw word ≠ 99). We narrow nothing in
## the else, so to read b correctly we must use an explicit unwrap — proving the else
## carries no `and`-chain facts. We assert the bare-narrowed value would NOT appear:
## reading via use_int on a correctly-narrowed b would be 199; we instead get the
## correct value only through unwrap (b really is Some(99)).
def and_chain_else_no_narrow(): Int
  a: Option<Int> = option_none<Int>()
  b: Option<Int> = option_some(99)
  var out = 0
  if a.some? and b.some?
    out = -1
  else
    # b is NOT narrowed here (and-chain else proves nothing). Explicit unwrap reads
    # the real value; a stale narrow would have let a bare `use_int_raw(b)` read 99
    # too, but the soundness guarantee is that the else table has no refinement.
    out = b.unwrap()
  end
  return out
end

# --- nested guards ---

## Nested `if a.some?  if b.some? ...` — both narrowed via scope nesting.
def nested_guards(): Int
  a: Option<Int> = option_some(40)
  b: Option<Int> = option_some(2)
  var out = 0
  if a.some?
    if b.some?
      out = use_int_raw(a) + use_int_raw(b)
    end
  end
  return out
end

## Nested Result-in-Option guards.
def nested_result_option(): Int
  a: Option<Int> = option_some(8)
  r: Result<Int, String> = Result::Ok(34)
  var out = 0
  if a.some?
    if r.is_ok()
      out = use_int_raw(a) + use_int_raw(r)
    end
  end
  return out
end

# --- SOUNDNESS: narrowed read flowing WHOLE into a wide slot (Phase-2 bug class,
# extended to Result + user enums). The narrowed read must round-trip the wide enum
# word, NOT a scalar payload, or a later match dereferences garbage → SIGSEGV.

struct ResBox
  r: Result<Int, String>
end

## Narrowed Result returned where the return type is Result<Int,String>.
def return_narrowed_result(): Result<Int, String>
  r: Result<Int, String> = Result::Ok(42)
  if r is Err
    return Result::Err("x")
  end
  return r   # narrowed r returned into a Result<Int,String> slot — must round-trip
end

def return_narrowed_result_check(): Int
  match return_narrowed_result()
    Ok(x)  => return x
    Err(e) => return -1
  end
end

## Narrowed Result stored into a struct Result field.
def narrowed_result_into_field(): Int
  r: Result<Int, String> = Result::Ok(42)
  var b = ResBox { r: Result::Err("init") }
  if r.is_ok()
    b = ResBox { r: r }   # narrowed r; field needs Result<Int,String>
  end
  match b.r
    Ok(x)  => return x
    Err(e) => return -1
  end
end

## Narrowed Result assigned into a Result-typed var.
def assign_narrowed_result(): Int
  r: Result<Int, String> = Result::Ok(42)
  var sink: Result<Int, String> = Result::Err("init")
  if r is Ok
    sink = r   # narrowed r assigned into a Result<Int,String> var
  end
  match sink
    Ok(x)  => return x
    Err(e) => return -1
  end
end

## Narrowed user-enum value assigned WHOLE into a Pair-typed var (round-trip). The
## pin must store the wide enum word (no payload extract). We verify via a SECOND
## narrowing read of the sink rather than `match` — a plain `match` of a 2-boxed-
## payload M1 user enum is PRE-EXISTING broken in the qspec compilation context
## (returns 0 for a bare `match e { Left(bx) => ... }` with NO narrowing involved,
## verified 2026-06-18), so it is not a usable oracle here. If the pin leaked a
## scalar into `sink`, re-narrowing `sink as Left` would read garbage; the pin works
## ⇒ sink holds the wide Left word ⇒ the re-narrow reads 21.
def narrowed_user_enum_roundtrip(): Int
  e: Pair = Pair::Left(Box { v: 21 })
  var sink: Pair = Pair::Right(Box { v: 0 })
  if e is Left
    sink = e   # narrowed e flows WHOLE into a Pair var — pin: round-trip wide word
  end
  var out = -5
  if sink is Left
    out = box_v(sink)
  end
  return out
end

## REGRESSION (scope_channel / persistent_worker SIGSEGV, 2026-06-18): a narrowed
## bare-ident value passed as a CALL ARGUMENT into a wide Option/Result parameter
## must NOT payload-extract. `unwrap_ok(r)` takes the WHOLE Result and does its own
## extraction; if narrowing pre-extracts at the arg site the callee double-extracts a
## scalar as a pointer → garbage → SIGSEGV. The call-arg wide-slot pin must fire just
## like the let/return/field/assign chokepoints. A correct pin yields the inner value
## (42); a broken pin crashes or returns garbage ≠ 42.
def takes_result(r: Result<Int, String>): Int = unwrap_ok(r)

def narrowed_result_into_call_arg(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = -1
  if r is Ok
    out = takes_result(r)   # narrowed r flows WHOLE into a Result param — pin
  end
  return out
end

## Direct `unwrap_ok(r)` on a narrowed r — the exact scope_recv/unwrap_ok shape.
def narrowed_result_direct_unwrap(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = -1
  if is_ok(r)
    out = unwrap_ok(r)   # prelude unwrap_ok param is wide Result — must not pre-extract
  end
  return out
end

## REGRESSION (persistent_worker_protocol decode SIGSEGV, 2026-06-18): guard-style
## negative `if r is Err return end` narrows r to Ok AFTER the guard, then `try r`
## extracts the whole Result's Ok payload. `try` is a wide-slot consuming context: a
## narrowed-read pre-extract would make `try` double-extract → garbage. The pin must
## fire on the `try` operand. Correct ⇒ inner value 42; broken ⇒ crash/garbage ≠ 42.
def narrowed_result_into_try(): Int
  r: Result<Int, String> = Result::Ok(42)
  if r is Err
    return -1
  end
  var v = try r   # r narrowed to Ok; `try` consumes the WHOLE Result word
  return v
end

def main(): Int
  describe("SURF.FLOW Phase 3 — Result narrowing (spill Result<Int,String>)") do ->
    it("then-narrows r to T via `is Ok`") do ->
      assert_eq(result_is_ok_then(), 142)
    end
    it("then-narrows via `r.ok?`") do ->
      assert_eq(result_ok_pred_then(), 142)
    end
    it("then-narrows via `r.is_ok()`") do ->
      assert_eq(result_is_ok_ufcs_then(), 142)
    end
    it("then-narrows r to E via `is Err`") do ->
      assert_eq_str(result_is_err_then(), "boom")
    end
    it("then-narrows to E via `r.err?`") do ->
      assert_eq_str(result_err_pred_then(), "boom")
    end
    it("else of `is Ok` narrows to Err (E)") do ->
      assert_eq_str(result_else_narrows_err(), "nope")
    end
    it("else of `r.err?` narrows to Ok (T)") do ->
      assert_eq(result_else_narrows_ok(), 142)
    end
    it("guard-style `if r is Err return end` narrows to Ok-T after") do ->
      assert_eq(result_guard_style(), 142)
    end
  end

  describe("SURF.FLOW Phase 3 — Result narrowing (niche-multi Result<String,String>)") do ->
    it("niche Result flows through a narrowing region without crashing (SOUND)") do ->
      assert_eq(result_niche_roundtrip_safe(), 7)
    end
    it("niche-multi Result then-narrows to Ok-T (String) via `is Ok`") do ->
      assert_eq_str(result_niche_ok_then(), "hi")
    end
    it("niche-multi Result then-narrows to Err-E (String) via `is Err`") do ->
      assert_eq_str(result_niche_err_then(), "boom")
    end
    it("niche-multi Result else of `is Ok` narrows to Err (E)") do ->
      assert_eq_str(result_niche_else_narrows_err(), "nope")
    end
  end

  describe("SURF.FLOW Phase 3 — arbitrary user enums") do ->
    it("then-narrows a binary user enum via `is Left`") do ->
      assert_eq(user_binary_then(), 7)
    end
    it("else-narrows a BINARY user enum (else of `is Left` ⇒ Right)") do ->
      assert_eq(user_binary_else(), 9)
    end
    it("then-narrows a 3-variant user enum (THEN-only)") do ->
      assert_eq(user_tri_then(), 11)
    end
    it("3-variant enum does NOT else-narrow (explicit match required in else)") do ->
      assert_eq(user_tri_else_explicit(), 13)
    end
  end

  describe("SURF.FLOW Phase 3 — and-chains") do ->
    it("`a.some? and b.some?` narrows BOTH in the then-branch") do ->
      assert_eq(and_chain_double_narrow(), 42)
    end
    it("and-chain mixing Option + Result narrows both") do ->
      assert_eq(and_chain_option_result(), 42)
    end
    it("the ELSE of an and-chain narrows nothing (De Morgan)") do ->
      assert_eq(and_chain_else_no_narrow(), 99)
    end
  end

  describe("SURF.FLOW Phase 3 — nested guards") do ->
    it("nested `if a.some? if b.some?` narrows both") do ->
      assert_eq(nested_guards(), 42)
    end
    it("nested Result-in-Option guards narrow both") do ->
      assert_eq(nested_result_option(), 42)
    end
  end

  describe("SURF.FLOW Phase 3 — SOUNDNESS: narrowed read into a wide enum slot") do ->
    it("narrowed Result returned as Result<Int,String> round-trips") do ->
      assert_eq(return_narrowed_result_check(), 42)
    end
    it("narrowed Result stored into a struct Result field round-trips") do ->
      assert_eq(narrowed_result_into_field(), 42)
    end
    it("narrowed Result assigned into a Result var round-trips") do ->
      assert_eq(assign_narrowed_result(), 42)
    end
    it("narrowed user-enum assigned whole into a Pair var round-trips (pin)") do ->
      assert_eq(narrowed_user_enum_roundtrip(), 21)
    end
    it("narrowed Result passed as a call arg into a wide Result param round-trips (pin)") do ->
      assert_eq(narrowed_result_into_call_arg(), 42)
    end
    it("narrowed Result passed directly to unwrap_ok round-trips (scope_recv shape)") do ->
      assert_eq(narrowed_result_direct_unwrap(), 42)
    end
    it("guard-narrowed Result consumed by `try` round-trips (persistent_worker shape)") do ->
      assert_eq(narrowed_result_into_try(), 42)
    end
  end

  return qspec_main()
end
