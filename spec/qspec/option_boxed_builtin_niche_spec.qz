## Option<boxed BUILTIN> niche-representation tests (item 6.4a).
##
## Under the 6.4a flip the SEVEN clean named builtins (String / Vec / Map / Set /
## IntMap / Regex / Future) join the niche: None = null pointer (0), Some(p) = the
## pointer p (single word, no tag). Discriminant: None <=> 0, Some <=> != 0. Empty
## collections are non-null HEADER pointers, so `Some(vec_new())` reads as Some,
## NOT None — that empty-vs-null catch is the central soundness check here.
##
## Representation-agnostic: identical source, identical observable behavior under
## both the old tagged layout and the new niche layout. Value = differential
## oracle across the flip. Function/Tuple stay TAGGED (separate gate) — covered by
## option_boxed_struct_niche_spec's non-niche locks + the IR-level confirmation.
import * from qspec

def main(): Int
  describe("Option<String> niche — Some/None/unwrap/match") do ->
    it("is Some for option_some(\"hi\")") do ->
      var o: Option<String> = option_some("hi")
      assert_eq(o is Some, 1)
    end
    it("is None for option_none") do ->
      var o: Option<String> = option_none()
      assert_eq(o is None, 1)
    end
    it("unwrap returns the payload string") do ->
      var o: Option<String> = option_some("payload")
      assert_eq_str(o.unwrap(), "payload")
    end
    it("match Some(s) reads the string") do ->
      var o: Option<String> = option_some("matched")
      var r = match o
        Some(s) => s
        None => "fallback"
      end
      assert_eq_str(r, "matched")
    end
    it("match None fires the None arm") do ->
      var o: Option<String> = option_none()
      var r = match o
        Some(s) => s
        None => "none-arm"
      end
      assert_eq_str(r, "none-arm")
    end
    it("Some of the EMPTY string is Some, not None") do ->
      var o: Option<String> = option_some("")
      assert_eq(o is Some, 1)
    end
  end

  describe("Option<String> niche — ?? nil-coalescing / ?. safe-nav") do ->
    it("?? unwraps Some") do ->
      var o: Option<String> = option_some("real")
      assert_eq_str(o ?? "dflt", "real")
    end
    it("?? yields default on None") do ->
      var o: Option<String> = option_none()
      assert_eq_str(o ?? "dflt", "dflt")
    end
    it("?? recovers the payload string on Some") do ->
      var o: Option<String> = option_some("abc")
      assert_eq_str(o ?? "x", "abc")
    end
    it("?? falls through to default on None") do ->
      var o: Option<String> = option_none()
      assert_eq_str(o ?? "x", "x")
    end
  end

  describe("Option<String> niche — UN-ANNOTATED local") do ->
    it("var s = option_some(\"hi\") reads is Some (no annotation)") do ->
      var s = option_some("hi")
      assert_eq(s is Some, 1)
    end
    it("un-annotated some? predicate is true") do ->
      var s = option_some("kept")
      assert_eq(s.some?, 1)
    end
  end

  describe("Option<Vec<Int>> niche — round-trip + empty-is-Some catch") do ->
    it("Some(non-empty vec) is Some, unwrap reads element") do ->
      var v: Vec<Int> = vec_new()
      v.push(42)
      var o: Option<Vec<Int>> = option_some(v)
      assert_eq(o.unwrap()[0], 42)
    end
    it("Some(EMPTY vec) reads is Some, NOT None") do ->
      var o: Option<Vec<Int>> = option_some(vec_new())
      assert_eq(o is Some, 1)
    end
    it("Some(EMPTY vec) is None returns 0") do ->
      var o: Option<Vec<Int>> = option_some(vec_new())
      assert_eq(o is None, 0)
    end
    it("None of Option<Vec<Int>> is None") do ->
      var o: Option<Vec<Int>> = option_none()
      assert_eq(o is None, 1)
    end
    it("match Some(vec) reaches the payload size") do ->
      var v: Vec<Int> = vec_new()
      v.push(1)
      v.push(2)
      var o: Option<Vec<Int>> = option_some(v)
      var r = match o
        Some(vv) => vv.size
        None => -1
      end
      assert_eq(r, 2)
    end
  end

  describe("Option<Map> niche — empty map is Some + round-trip") do ->
    it("Some(empty map) reads is Some, not None") do ->
      var o: Option<Map> = option_some(map_new())
      assert_eq(o is Some, 1)
    end
    it("None of Option<Map> is None") do ->
      var o: Option<Map> = option_none()
      assert_eq(o is None, 1)
    end
    it("unwrap recovers a populated map's get") do ->
      var m = map_new()
      m.set("k", 99)
      var o: Option<Map> = option_some(m)
      var got = 0
      match o.unwrap().get("k")
        Some(x) => got = x
        _ => assert_eq(0, 1)
      end
      assert_eq(got, 99)
    end
  end

  describe("Option<Set> niche — empty set is Some + round-trip") do ->
    it("Some(empty set) reads is Some, not None") do ->
      var o: Option<Set> = option_some(set_new())
      assert_eq(o is Some, 1)
    end
    it("None of Option<Set> is None") do ->
      var o: Option<Set> = option_none()
      assert_eq(o is None, 1)
    end
    it("unwrap recovers a populated set's size") do ->
      var s = set_new()
      s.add(7)
      s.add(9)
      var o: Option<Set> = option_some(s)
      assert_eq(set_size(o.unwrap()), 2)
    end
  end

  describe("Option<Regex> niche — Some/None") do ->
    it("Some(compiled regex) reads is Some") do ->
      var o: Option<Regex> = option_some(~r"a+b")
      assert_eq(o is Some, 1)
    end
    it("None of Option<Regex> is None") do ->
      var o: Option<Regex> = option_none()
      assert_eq(o is None, 1)
    end
    it("?? yields default regex-source-len on None") do ->
      var o: Option<Regex> = option_none()
      var present = match o
        Some(r) => 1
        None => 0
      end
      assert_eq(present, 0)
    end
  end

  describe("Option<Vec<Int>> niche — round-trip through call boundary") do ->
    it("Some(vec) survives arg+return, fields intact") do ->
      var v: Vec<Int> = vec_new()
      v.push(5)
      v.push(6)
      var o = roundtrip_vec(option_some(v))
      assert_eq(o.unwrap()[1], 6)
    end
    it("None survives arg+return as None") do ->
      var o = roundtrip_vec(option_none())
      assert_eq(o is None, 1)
    end
  end

  describe("Vec<Option<String>> as a STRUCT FIELD — None construct/read parity (6.4b)") do ->
    # The tui_form crash shape: `field.push(Option::None)` where the receiver is
    # a struct field (NOT a local var). The vec-elem registry is keyed on var
    # names, so a field receiver left niche-expected unset → None constructed as
    # a TAGGED spill box (non-null) that the niche `is Some` read range-tested as
    # Some → SIGSEGV. Construct and read must agree for a field-typed collection.
    it("field.push(None) reads back as None, not Some") do ->
      var h = ErrHolder { errs: vec_new<Option<String>>() }
      h.errs.push(option_none())
      assert_eq(h.errs[0] is None, 1)
    end
    it("field.push(Some(s)) reads back the payload string") do ->
      var h = ErrHolder { errs: vec_new<Option<String>>() }
      h.errs.push(option_some("err-msg"))
      assert_eq_str(h.errs[0].unwrap(), "err-msg")
    end
    it("match over a field element fires the None arm (no spill-box leak)") do ->
      var h = ErrHolder { errs: vec_new<Option<String>>() }
      h.errs.push(option_none())
      var r = match h.errs[0]
        Some(m) => m
        None => "ok-none"
      end
      assert_eq_str(r, "ok-none")
    end
    it("field.push(Some(\"\")) is Some, not None (empty != null)") do ->
      var h = ErrHolder { errs: vec_new<Option<String>>() }
      h.errs.push(option_some(""))
      assert_eq(h.errs[0] is Some, 1)
    end
    it("vec_set on a field element preserves None") do ->
      var h = ErrHolder { errs: vec_new<Option<String>>() }
      h.errs.push(option_some("first"))
      h.errs[0] = option_none()
      assert_eq(h.errs[0] is None, 1)
    end
  end

  describe("direct Option<String> field assign — None construct/read parity (6.4b)") do ->
    # `obj.opt = Option::None` on a niche-eligible Option<String> field must
    # construct the niche None (0), not a spill box. Read back via is None / match.
    it("obj.opt = None reads back as None") do ->
      var b = OptBox { opt: option_some("x") }
      b.opt = option_none()
      assert_eq(b.opt is None, 1)
    end
    it("obj.opt = Some(s) reads back the payload") do ->
      var b = OptBox { opt: option_none() }
      b.opt = option_some("set-val")
      assert_eq_str(b.opt.unwrap(), "set-val")
    end
    it("obj.opt = Some(\"\") is Some, not None") do ->
      var b = OptBox { opt: option_none() }
      b.opt = option_some("")
      assert_eq(b.opt is Some, 1)
    end
  end

  return qspec_main()
end

def roundtrip_vec(o: Option<Vec<Int>>): Option<Vec<Int>>
  return o
end

struct ErrHolder
  errs: Vec<Option<String>>
end

struct OptBox
  opt: Option<String>
end
