## Phase 4D.1 — struct row-var registration smoke test.
##
## Verifies that struct declarations with lowercase-first generic params
## (the row-var convention from P3.F.1) register cleanly:
##
##   1. `struct Foo<T, e>` — mixed type-var + row-var.
##   2. `struct Bar<e>` — row-var only.
##   3. `struct Baz<T, U, e, f>` — multiple of each kind.
##
## The structs are declared but not instantiated. Field-type reference of
## a row-var (`field: Fn(...) can e` on a struct) is a 4D.2 story; here we
## prove only that registration handles the lowercase convention without
## crash or spurious diagnostic. If `tc_register_struct_def`'s row-var
## detection mis-allocated, mis-pushed, or mis-bound, this spec would fail
## to compile.
##
## Each struct also declares a regular type-var-using field (`x: T`) so
## the existing `tc_is_type_param` path still resolves correctly with the
## new row-var names mixed into the type_params string.

import * from qspec

struct PairP4d1<T, e>
  x: T
  y: T
end

struct OnlyRowP4d1<e>
  tag: Int
end

struct MixedP4d1<T, U, e, f>
  a: T
  b: U
end

def main(): Int
  describe("4D.1 — struct row-var registration") do ->
    it("struct with mixed type-var + row-var params registers") do ->
      var p = PairP4d1 { x: 7, y: 11 }
      assert_eq(p.x + p.y, 18)
    end

    it("struct with a single row-var param registers") do ->
      var b = OnlyRowP4d1 { tag: 42 }
      assert_eq(b.tag, 42)
    end

    it("struct with multiple type and row params registers") do ->
      var m = MixedP4d1 { a: 100, b: 200 }
      assert_eq(m.a + m.b, 300)
    end
  end
  return qspec_main()
end
