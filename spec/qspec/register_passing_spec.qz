## Register Passing Tests
##
## Contract:
##   1. 4-field struct falls back.
##   2. Callee does local @value.
##   3. Compute_distance on local @value.
##   4. Field mutation in callee.
##   5. Param count overflow: no.
##   6. Passes 2-field @value struct.
import * from qspec

@value
struct Point
  x: Int
  y: Int
end

@value
struct Triple
  a: Int
  b: Int
  c: Int
end

@value
struct Quad
  w: Int
  x: Int
  y: Int
  z: Int
end

# -- Test helpers --

def get_x(p: Point): Int = p.x
def get_y(p: Point): Int = p.y

def point_sum(p: Point): Int = p.x + p.y

def triple_sum(t: Triple): Int = t.a + t.b + t.c

def add_points(a: Point, b: Point): Int = a.x + b.x + a.y + b.y

def scale_x(p: Point, factor: Int): Int = p.x * factor

def quad_sum(q: Quad): Int = q.w + q.x + q.y + q.z

def many_params(a: Int, b: Int, c: Int, pt1: Point, pt2: Point, d: Int): Int
  return a + b + c + pt1.x + pt1.y + pt2.x + pt2.y + d
end

def compute_distance(p: Point): Int = p.x * p.x + p.y * p.y

def recursive_sum(p: Point, n: Int): Int
  if n <= 0
    return 0
  end
  return p.x + p.y + recursive_sum(p, n - 1)
end

def mutate_check(p: Point): Int
  var local = Point { x: p.x + 100, y: p.y + 200 }
  return local.x + local.y
end

# -- Tests --

def test_2field_pass(): Void
  var p = Point { x: 10, y: 20 }
  assert_eq(point_sum(p), 30)
end

def test_3field_pass(): Void
  var t = Triple { a: 100, b: 200, c: 300 }
  assert_eq(triple_sum(t), 600)
end

def test_two_struct_params(): Void
  var a = Point { x: 1, y: 2 }
  var b = Point { x: 3, y: 4 }
  assert_eq(add_points(a, b), 10)
end

def test_mixed_struct_int(): Void
  var p = Point { x: 7, y: 0 }
  assert_eq(scale_x(p, 6), 42)
end

def test_callee_local_alloc(): Void
  var p = Point { x: 5, y: 10 }
  assert_eq(mutate_check(p), 315)
end

def test_nested_call(): Void
  var p = Point { x: 3, y: 4 }
  assert_eq(compute_distance(p), 25)
end

def test_4field_no_decompose(): Void
  var q = Quad { w: 1, x: 2, y: 3, z: 4 }
  assert_eq(quad_sum(q), 10)
end

def test_param_overflow(): Void
  var p1 = Point { x: 1, y: 2 }
  var p2 = Point { x: 3, y: 4 }
  # 8 params after expansion: a, b, c, p1.x, p1.y, p2.x, p2.y, d = 8
  assert_eq(many_params(10, 20, 30, p1, p2, 40), 110)
end

def test_recursive_struct(): Void
  var p = Point { x: 3, y: 7 }
  assert_eq(recursive_sum(p, 5), 50)
end

def test_field_value_semantics(): Void
  var p = Point { x: 10, y: 20 }
  # mutate_check creates local copy — original unchanged
  assert_eq(mutate_check(p), 330)
  assert_eq(p.x, 10)
  assert_eq(p.y, 20)
end

def main(): Int
  describe("register passing for @value structs") do ->
    it("passes 2-field @value struct via registers") do ->
      test_2field_pass()
    end

    it("passes 3-field @value struct via registers") do ->
      test_3field_pass()
    end

    it("passes two @value struct params") do ->
      test_two_struct_params()
    end

    it("passes mixed @value struct and Int params") do ->
      test_mixed_struct_int()
    end

    it("callee does local @value alloc with struct param") do ->
      test_callee_local_alloc()
    end

    it("compute_distance on local @value struct") do ->
      test_nested_call()
    end

    it("4-field struct falls back to pointer passing") do ->
      test_4field_no_decompose()
    end

    it("param count overflow: no decompose when >8 expanded") do ->
      test_param_overflow()
    end

    it("recursive function with @value param") do ->
      test_recursive_struct()
    end

    it("field mutation in callee preserves value semantics") do ->
      test_field_value_semantics()
    end
  end

  return qspec_main()
end
