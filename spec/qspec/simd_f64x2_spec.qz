## Simd F64X2 Tests
##
## Contract:
##   1. Emits <2 x double>.
##   2. Mixed lane operations.
##   3. Simd_f64x2_add.
##   4. Simd_f64x2_div.
##   5. Simd_f64x2_mul.
##   6. Simd_f64x2_sub.
import * from qspec

def main(): Int
  describe("SIMD F64x2") do ->
    it("splat and extract both lanes") do ->
      assert_eq(sd2_splat(), 42)
    end
    it("simd_f64x2_add") do ->
      assert_eq(sd2_add(), 4)
    end
    it("simd_f64x2_sub") do ->
      assert_eq(sd2_sub(), 7)
    end
    it("simd_f64x2_mul") do ->
      assert_eq(sd2_mul(), 12)
    end
    it("simd_f64x2_div") do ->
      assert_eq(sd2_div(), 5)
    end
    it("simd_f64x2_sum") do ->
      assert_eq(sd2_sum(), 15)
    end
    it("mixed lane operations") do ->
      assert_eq(sd2_mixed(), 39)
    end
    it("emits <2 x double> vector instructions (IR test)") do ->
      assert_ir_contains("""
def main(): Int
  v = simd_f64x2_splat(1.0)
  return to_int(simd_f64x2_extract(v, 0))
end
""", "insertelement <2 x double>")
    end
  end
  return qspec_main()
end

def sd2_splat(): Int
  var v = simd_f64x2_splat(3.14)
  var lane0 = simd_f64x2_extract(v, 0)
  var lane1 = simd_f64x2_extract(v, 1)
  if to_int(lane0) == 3
    if to_int(lane1) == 3
      return 42
    end
  end
  return 0
end
def sd2_add(): Int
  var a = simd_f64x2_splat(1.5)
  var b = simd_f64x2_splat(2.5)
  var c = simd_f64x2_add(a, b)
  return to_int(simd_f64x2_extract(c, 0))
end
def sd2_sub(): Int
  var a = simd_f64x2_splat(10.0)
  var b = simd_f64x2_splat(3.0)
  var c = simd_f64x2_sub(a, b)
  return to_int(simd_f64x2_extract(c, 0))
end
def sd2_mul(): Int
  var a = simd_f64x2_splat(3.0)
  var b = simd_f64x2_splat(4.0)
  var c = simd_f64x2_mul(a, b)
  return to_int(simd_f64x2_extract(c, 0))
end
def sd2_div(): Int
  var a = simd_f64x2_splat(20.0)
  var b = simd_f64x2_splat(4.0)
  var c = simd_f64x2_div(a, b)
  return to_int(simd_f64x2_extract(c, 0))
end
def sd2_sum(): Int
  var a = simd_f64x2_splat(7.5)
  return to_int(simd_f64x2_sum(a))
end
def sd2_mixed(): Int
  var a = simd_f64x2_splat(10.0)
  var b = simd_f64x2_splat(3.0)
  var added = simd_f64x2_add(a, b)
  var mulled = simd_f64x2_mul(added, b)
  return to_int(simd_f64x2_extract(mulled, 1))
end
