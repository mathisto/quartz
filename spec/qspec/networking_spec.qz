## Networking Tests
##
## Contract:
##   1. Networking.
##   2. Socket FFI.
##   3. Getaddrinfo FFI.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Networking") do ->
    describe("Socket FFI") do ->
      it("socket extern declarations compile") do ->
        assert_compile_succeeds("""
          extern "C" def socket(domain: Int, sock_type: Int, protocol: Int): Int
          extern "C" def connect(sockfd: Int, addr: Int, addrlen: Int): Int
          extern "C" def send(sockfd: Int, buf: CPtr, len: Int, flags: Int): Int
          extern "C" def recv(sockfd: Int, buf: CPtr, len: Int, flags: Int): Int
          extern "C" def close(fd: Int): Int
          def main(): Int
            return 0
          end
        """)
      end

      it("IR contains socket extern declaration") do ->
        assert_ir_contains("""
          extern "C" def socket(domain: Int, sock_type: Int, protocol: Int): Int
          def main(): Int
            return 0
          end
        """, "declare i64 @socket(i64, i64, i64)")
      end

      it("sockaddr_in struct compiles") do ->
        assert_compile_succeeds("""
          @repr(C)
          struct SockaddrIn
            sin_family: Int
            sin_port: Int
            sin_addr: Int
            sin_zero: Int
          end
          def main(): Int
            return 0
          end
        """)
      end
    end

    describe("getaddrinfo FFI") do ->
      it("getaddrinfo extern compiles") do ->
        assert_compile_succeeds("""
          extern "C" def getaddrinfo(node: CPtr, service: CPtr, hints: CPtr, res: CPtr): Int
          extern "C" def freeaddrinfo(res: CPtr): Int
          def main(): Int
            return 0
          end
        """)
      end
    end
  end

  return qspec_main()
end
