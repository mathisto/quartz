## Unicode Table Lookup Tests
##
## Contract:
##   1. Binary search range lookup.
##   2. Binary search mapping lookup.
##   3. Category ranges return correct results.
##   4. Case mapping tables return correct results.

import * from qspec
import * from unicode/tables
import * from unicode/case_data
import * from unicode/category_data

def main(): Int
  describe("unicode_range_contains") do ->
    it("finds codepoint in range") do ->
      var t = vec_new()
      t.push((65 << 21) | 90)
      t.push((97 << 21) | 122)
      assert_eq(unicode_range_contains(t, 65), true)
      assert_eq(unicode_range_contains(t, 90), true)
      assert_eq(unicode_range_contains(t, 75), true)
      assert_eq(unicode_range_contains(t, 97), true)
      assert_eq(unicode_range_contains(t, 122), true)
    end

    it("rejects codepoint outside range") do ->
      var t = vec_new()
      t.push((65 << 21) | 90)
      t.push((97 << 21) | 122)
      assert_eq(unicode_range_contains(t, 64), false)
      assert_eq(unicode_range_contains(t, 91), false)
      assert_eq(unicode_range_contains(t, 96), false)
      assert_eq(unicode_range_contains(t, 123), false)
    end

    it("handles empty table") do ->
      var t = vec_new()
      assert_eq(unicode_range_contains(t, 65), false)
    end

    it("handles single-codepoint range") do ->
      var t = vec_new()
      t.push((42 << 21) | 42)
      assert_eq(unicode_range_contains(t, 42), true)
      assert_eq(unicode_range_contains(t, 41), false)
      assert_eq(unicode_range_contains(t, 43), false)
    end
  end

  describe("unicode_mapping_lookup") do ->
    it("finds exact key") do ->
      var keys = vec_new()
      var vals = vec_new()
      keys.push(97)
      vals.push(65)
      keys.push(98)
      vals.push(66)
      assert_eq(unicode_mapping_lookup(keys, vals, 97), 65)
      assert_eq(unicode_mapping_lookup(keys, vals, 98), 66)
    end

    it("returns codepoint unchanged if not found") do ->
      var keys = vec_new()
      var vals = vec_new()
      keys.push(97)
      vals.push(65)
      assert_eq(unicode_mapping_lookup(keys, vals, 50), 50)
    end
  end

  describe("category tables") do ->
    it("ASCII letters are alphabetic") do ->
      var ranges = uc_alphabetic_ranges()
      assert_eq(unicode_range_contains(ranges, 65), true)
      assert_eq(unicode_range_contains(ranges, 90), true)
      assert_eq(unicode_range_contains(ranges, 97), true)
      assert_eq(unicode_range_contains(ranges, 122), true)
    end

    it("digits are not alphabetic") do ->
      var ranges = uc_alphabetic_ranges()
      assert_eq(unicode_range_contains(ranges, 48), false)
      assert_eq(unicode_range_contains(ranges, 57), false)
    end

    it("e-acute is alphabetic") do ->
      var ranges = uc_alphabetic_ranges()
      assert_eq(unicode_range_contains(ranges, 233), true)
    end

    it("ASCII digits are numeric") do ->
      var ranges = uc_numeric_ranges()
      assert_eq(unicode_range_contains(ranges, 48), true)
      assert_eq(unicode_range_contains(ranges, 57), true)
      assert_eq(unicode_range_contains(ranges, 65), false)
    end

    it("space and tab are whitespace") do ->
      var ranges = uc_whitespace_ranges()
      assert_eq(unicode_range_contains(ranges, 32), true)
      assert_eq(unicode_range_contains(ranges, 9), true)
      assert_eq(unicode_range_contains(ranges, 10), true)
      assert_eq(unicode_range_contains(ranges, 65), false)
    end
  end

  describe("case mapping tables") do ->
    it("lowercase a maps to uppercase A") do ->
      var keys = uc_upper_keys()
      var vals = uc_upper_vals()
      assert_eq(unicode_mapping_lookup(keys, vals, 97), 65)
      assert_eq(unicode_mapping_lookup(keys, vals, 122), 90)
    end

    it("uppercase A maps to lowercase a") do ->
      var keys = uc_lower_keys()
      var vals = uc_lower_vals()
      assert_eq(unicode_mapping_lookup(keys, vals, 65), 97)
      assert_eq(unicode_mapping_lookup(keys, vals, 90), 122)
    end

    it("e-acute maps correctly") do ->
      var keys = uc_upper_keys()
      var vals = uc_upper_vals()
      ## U+00E9 (e-acute) -> U+00C9 (E-acute)
      assert_eq(unicode_mapping_lookup(keys, vals, 0xE9), 0xC9)
    end

    it("unmapped codepoint returns itself") do ->
      var keys = uc_upper_keys()
      var vals = uc_upper_vals()
      assert_eq(unicode_mapping_lookup(keys, vals, 48), 48)
    end
  end

  return qspec_main()
end
