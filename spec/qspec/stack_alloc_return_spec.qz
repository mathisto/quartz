## Stack Alloc Return Tests
##
## Contract:
##   1. Arithmetic: arithmetic before return.
##   2. Chained: chained constructor calls.
##   3. Conditional: conditional return.
##   4. Large: large @value struct (6 fields).
##   5. Loop: loop with struct creation.
##   6. Simple: simple @value struct return.
##   7. Vec: Vec storage still works with constructors.
##   8. Nested: nested constructor (point_add of point_add).
##   9. Pair: return 2-field @value struct.
import * from qspec

@value
struct Point3D
  x: Int
  y: Int
  z: Int
end

@value
struct Pair
  a: Int
  b: Int
end

@value
struct Big6
  f1: Int
  f2: Int
  f3: Int
  f4: Int
  f5: Int
  f6: Int
end

# -- Constructor helpers (these should get alwaysinline + stack alloc) --

def make_point(x: Int, y: Int, z: Int): Point3D
  return Point3D { x: x, y: y, z: z }
end

def make_pair(a: Int, b: Int): Pair
  return Pair { a: a, b: b }
end

def make_big(v: Int): Big6
  return Big6 { f1: v, f2: v + 1, f3: v + 2, f4: v + 3, f5: v + 4, f6: v + 5 }
end

def point_add(a: Point3D, b: Point3D): Point3D
  return Point3D { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
end

def point_min(a: Point3D, b: Point3D): Point3D
  var rx = a.x
  if b.x < rx; rx = b.x; end
  var ry = a.y
  if b.y < ry; ry = b.y; end
  var rz = a.z
  if b.z < rz; rz = b.z; end
  return Point3D { x: rx, y: ry, z: rz }
end

# -- Test output helpers --

def test_simple_return(): Void
  var p = make_point(1, 2, 3)
  assert_eq(p.x, 1)
  assert_eq(p.y, 2)
  assert_eq(p.z, 3)
end

def test_arithmetic_return(): Void
  var a = make_point(10, 20, 30)
  var b = make_point(1, 2, 3)
  var c = point_add(a, b)
  assert_eq(c.x, 11)
  assert_eq(c.y, 22)
  assert_eq(c.z, 33)
end

def test_conditional_return(): Void
  var a = make_point(5, 1, 8)
  var b = make_point(2, 7, 3)
  var m = point_min(a, b)
  assert_eq(m.x, 2)
  assert_eq(m.y, 1)
  assert_eq(m.z, 3)
end

def test_chained_calls(): Void
  var r = point_add(make_point(1, 2, 3), make_point(4, 5, 6))
  assert_eq(r.x, 5)
  assert_eq(r.y, 7)
  assert_eq(r.z, 9)
end

def test_large_struct(): Void
  var b = make_big(10)
  assert_eq(b.f1, 10)
  assert_eq(b.f2, 11)
  assert_eq(b.f3, 12)
  assert_eq(b.f4, 13)
  assert_eq(b.f5, 14)
  assert_eq(b.f6, 15)
end

def test_loop_no_overflow(): Void
  var sum = 0
  for i in 0..1000
    var p = make_point(i, i + 1, i + 2)
    sum = sum + p.x + p.y + p.z
  end
  # sum = Σ(3i+3) for i=0..999 = 3*999*1000/2 + 3*1000 = 1501500
  assert_eq(sum, 1501500)
end

def test_vec_storage_still_works(): Void
  var v = vec_new<Point3D>()
  v.push(make_point(1, 2, 3))
  v.push(make_point(4, 5, 6))
  var p0 = v[0]
  var p1 = v[1]
  assert_eq(p0.x, 1)
  assert_eq(p1.z, 6)
end

def test_nested_constructors(): Void
  var a = make_point(1, 2, 3)
  var b = make_point(4, 5, 6)
  var c = make_point(7, 8, 9)
  var r = point_add(point_add(a, b), c)
  assert_eq(r.x, 12)
  assert_eq(r.y, 15)
  assert_eq(r.z, 18)
end

def test_pair_return(): Void
  var p = make_pair(100, 200)
  assert_eq(p.a, 100)
  assert_eq(p.b, 200)
end

def main(): Int
  describe("M.R.8 stack alloc for @value struct return") do ->
    it("simple @value struct return") do ->
      test_simple_return()
    end

    it("arithmetic before return") do ->
      test_arithmetic_return()
    end

    it("conditional return") do ->
      test_conditional_return()
    end

    it("chained constructor calls") do ->
      test_chained_calls()
    end

    it("large @value struct (6 fields)") do ->
      test_large_struct()
    end

    it("loop with struct creation — no stack overflow") do ->
      test_loop_no_overflow()
    end

    it("Vec storage still works with constructors") do ->
      test_vec_storage_still_works()
    end

    it("nested constructor calls compose") do ->
      test_nested_constructors()
    end

    it("2-field @value struct return works") do ->
      test_pair_return()
    end
  end

  return qspec_main()
end
