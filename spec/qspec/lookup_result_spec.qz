## Lookup Result Tests
##
## Contract:
##   1. Constructs found with value.
##   2. Constructs notfound.
##   3. Guard clause early returns.
##   4. Guard clause extracts value.
##   5. Lookup_is_found existence check with.
##   6. Lookup_is_found works.
import * from qspec

enum LookupResult
  Found(value: Int)
  NotFound
end

def main(): Int
  describe("LookupResult enum") do ->
    it("constructs Found with value") do ->
      x = LookupResult::Found(42)
      assert_eq(lr_unwrap(x, 0), 42)
    end
    it("constructs NotFound") do ->
      x = LookupResult::NotFound
      assert_eq(lr_unwrap(x, 99), 99)
    end
    it("lookup_is_found works") do ->
      a = LookupResult::Found(10)
      b = LookupResult::NotFound
      assert_eq(lr_is_found(a), 1)
      assert_eq(lr_is_found(b), 0)
    end
    it("simulates table lookup") do ->
      a = lr_lookup(1)
      x = lr_unwrap(a, 0)
      b = lr_lookup(2)
      y = lr_unwrap(b, 0)
      c = lr_lookup(99)
      z = lr_unwrap(c, 100)
      assert_eq(x + y + z, 130)
    end
    it("guard clause extracts value") do ->
      idx = lr_guard_extract(2)
      assert_eq(idx, 20)
    end
    it("guard clause early returns on NotFound") do ->
      idx = lr_guard_extract(99)
      assert_eq(idx, 0)
    end
    it("Vec<String> parallel vector lookup with ==") do ->
      result = lr_str_lookup("bob")
      assert_eq(lr_unwrap(result, 0), 20)
    end
    it("NotFound return for missing name") do ->
      result = lr_str_lookup("nobody")
      assert_eq(lr_unwrap(result, 999), 999)
    end
    it("lookup_is_found existence check with strings") do ->
      a = lr_str_lookup("alice")
      b = lr_str_lookup("unknown")
      assert_eq(lr_is_found(a), 1)
      assert_eq(lr_is_found(b), 0)
    end
    it("lookup_unwrap with string vectors") do ->
      a = lr_str_lookup("alice")
      b = lr_str_lookup("charlie")
      assert_eq(lr_unwrap(a, 0) + lr_unwrap(b, 0), 40)
    end
  end
  return qspec_main()
end
def lr_unwrap(r: Int, fallback: Int): Int
  return match r
    LookupResult::Found(v) => v
    LookupResult::NotFound => fallback
    _ => fallback
  end
end
def lr_is_found(r: Int): Int
  return match r
    LookupResult::Found(v) => 1
    LookupResult::NotFound => 0
    _ => 0
  end
end
def lr_lookup(key: Int): Int
  if key == 1
    return LookupResult::Found(10)
  end
  if key == 2
    return LookupResult::Found(20)
  end
  if key == 3
    return LookupResult::Found(30)
  end
  return LookupResult::NotFound
end
def lr_str_lookup(name: String): Int
  var keys = vec_new()
  keys.push(as_int("alice"))
  keys.push(as_int("bob"))
  keys.push(as_int("charlie"))
  var vals = vec_new()
  vals.push(10)
  vals.push(20)
  vals.push(30)
  var i = 0
  while i < keys.size
    if as_string(keys[i]) == name
      return LookupResult::Found(vals[i])
    end
    i += 1
  end
  return LookupResult::NotFound
end
def lr_guard_extract(key: Int): Int
  result = lr_lookup(key)
  idx = match result
    LookupResult::Found(val) => val
    LookupResult::NotFound => 0
    _ => 0
  end
  return idx
end
