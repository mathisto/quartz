## Nil Tests
##
## Contract:
##   1. Nil literal.
##   2. Nil as false.
##   3. Nil assignment.
##   4. Nil type checking.
import * from qspec

def main(): Int
  describe("nil literal") do ->
    it("parses nil keyword") do ->
      var x = nil
      assert_eq(x, nil)
    end

    it("nil equals nil") do ->
      assert_eq(nil_equals_nil(), 1)
    end
  end

  describe("nil as false") do ->
    it("nil is falsy in if") do ->
      assert_eq(nil_falsy(), 0)
    end
  end

  describe("nil assignment") do ->
    it("can reassign nil to variable") do ->
      assert_eq(nil_reassign(), 1)
    end
  end

  describe("nil type checking") do ->
    it("nil not equals Int value") do ->
      assert_eq(nil_neq_int(), 1)
    end

    it("nil equals false") do ->
      assert_eq(nil_eq_false(), 1)
    end

    it("nil can be returned from function expecting Int") do ->
      assert_eq(nil_get_nil(), 0)
    end

    it("nil can be passed as Int argument") do ->
      assert_eq(nil_is_nil(nil), 1)
    end
  end

  return qspec_main()
end

def nil_equals_nil(): Int
  var x = nil
  if x == nil
    return 1
  end
  return 0
end

def nil_falsy(): Int
  var x = nil
  if x
    return 1
  end
  return 0
end

def nil_reassign(): Int
  var x = nil
  x = nil
  if x == nil
    return 1
  end
  return 0
end

def nil_neq_int(): Int
  var x = nil
  if x != 42
    return 1
  end
  return 0
end

def nil_eq_false(): Int
  if nil == false
    return 1
  end
  return 0
end

def nil_get_nil(): Int
  return nil
end

## def nil_return_int(): Int

def nil_is_nil(x: Int): Int
  if x == nil
    return 1
  end
  return 0
end
