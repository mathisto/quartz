## QSpec runner lifecycle regression coverage.
import * from qspec
import std/throws

var lifecycle_trace = ""
var lifecycle_outer_before = 0
var lifecycle_outer_after = 0
var lifecycle_inner_before = 0
var lifecycle_inner_after = 0
var lifecycle_bodies = 0
var lifecycle_after_skip = 0
var lifecycle_declaration_throws = 0

def capture_declaration_throw(op_name: Int, argc_l: Int, argv_l: Int): Int
  lifecycle_declaration_throws += 1
  return 0
end

def throw_during_declaration(): Void
  throw("declaration-time throw")
end

def restored_sibling_body(): Void
  assert_eq(lifecycle_declaration_throws, 2)
end

def restored_root_body(): Void
  assert_eq(lifecycle_declaration_throws, 2)
end

def register_throwing_outer(): Void
  with Throws { throw: capture_declaration_throw } do ->
    context("recovered child", throw_during_declaration)
  end
  it("sibling after declaration throw", restored_sibling_body)
  describe("propagating child", throw_during_declaration)
end

def register_restored_root(): Void
  it("root declaration after propagated throw", restored_root_body)
end

def outer_before(): Void
  lifecycle_outer_before += 1
  lifecycle_trace += "B"
end

def outer_after(): Void
  lifecycle_outer_after += 1
  lifecycle_trace += "A"
end

def inner_before(): Void
  lifecycle_inner_before += 1
  lifecycle_trace += "b"
end

def inner_after(): Void
  lifecycle_inner_after += 1
  lifecycle_trace += "a"
end

def first_body(): Void
  lifecycle_bodies += 1
  lifecycle_trace += "1"
  assert_eq(lifecycle_outer_before, 1)
  assert_eq(lifecycle_outer_after, 0)
end

def inner_body(): Void
  lifecycle_bodies += 1
  lifecycle_trace += "2"
  assert_eq(lifecycle_outer_before, 2)
  assert_eq(lifecycle_outer_after, 1)
  assert_eq(lifecycle_inner_before, 1)
  assert_eq(lifecycle_inner_after, 0)
end

def skipped_body(): Void
  lifecycle_bodies += 1
  lifecycle_trace += "s"
  skip_unless(0, "intentional regression skip")
  lifecycle_after_skip += 1
end

def unconditionally_skipped_body(): Void
  lifecycle_bodies += 1
  lifecycle_trace += "t"
  skip("intentional unconditional skip")
  lifecycle_after_skip += 1
end

def register_inner(): Void
  before(inner_before)
  after(inner_after)
  it("runs inherited and local hooks", inner_body)
end

def register_lifecycle(): Void
  before(outer_before)
  after(outer_after)
  it("runs only during qspec_run", first_body)
  describe("nested", register_inner)
  it("suppresses the body after skip_unless", skipped_body)
  it("suppresses remaining body after unconditional skip", unconditionally_skipped_body)
end

def main(): Int
  with Throws { throw: capture_declaration_throw } do ->
    describe("throw restoration", register_throwing_outer)
  end
  describe("root after throw", register_restored_root)
  describe("QSpec lifecycle", register_lifecycle)
  var roots = qspec_root_suites()
  if vec_size(roots) != 3 or qspec_suite_name(vec_get(roots, 0)) != "throw restoration" or qspec_suite_name(vec_get(roots, 1)) != "root after throw"
    return 79
  end
  var throwing_entries = qspec_suite_entries(vec_get(roots, 0))
  var restored_entries = qspec_suite_entries(vec_get(roots, 1))
  if vec_size(throwing_entries) != 3 or vec_size(restored_entries) != 1
    return 78
  end
  if lifecycle_bodies != 0 or lifecycle_outer_before != 0 or lifecycle_outer_after != 0
    return 80
  end

  var failures = qspec_run()
  if failures != 0
    return 81
  end
  if lifecycle_trace != "B1ABb2aABsABtA"
    return 82
  end
  if lifecycle_outer_before != 4 or lifecycle_outer_after != 4
    return 83
  end
  if lifecycle_inner_before != 1 or lifecycle_inner_after != 1
    return 84
  end
  if lifecycle_bodies != 4 or lifecycle_after_skip != 0
    return 85
  end
  if qspec_total() != 6 or qspec_passed() != 4 or qspec_skipped() != 2
    return 86
  end
  if qspec_assertions() != 8
    return 87
  end

  var capture = capture_output_start()
  qspec_format_pretty()
  var output = capture_output_end(capture)
  var first_pos = output.find("runs only during qspec_run").unwrap_or(-1)
  var nested_pos = output.find("nested").unwrap_or(-1)
  var unless_pos = output.find("suppresses the body after skip_unless").unwrap_or(-1)
  var skip_pos = output.find("suppresses remaining body after unconditional skip").unwrap_or(-1)
  if first_pos < 0 or nested_pos <= first_pos or unless_pos <= nested_pos or skip_pos <= unless_pos
    return 88
  end
  var cached_rc = qspec_main()
  var cached_rc_again = qspec_main()
  if cached_rc != 0 or cached_rc_again != 0 or lifecycle_bodies != 4 or qspec_total() != 6 or qspec_assertions() != 8
    return 89
  end
  return 0
end
