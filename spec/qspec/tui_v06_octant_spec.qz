## QSpec coverage for std/tui/octant.qz — Phase 6.6 of the v0.6 cell engine.
##
## Coverage:
##   - OctantBlitter construction: dimensions, initial all-off pixel grid
##   - octant_get / octant_set round-trip; OOB defensive returns
##   - octant_fill flood-on / flood-off
##   - octant_cell_w / octant_cell_h derived dimensions
##   - Pattern extraction bit ordering: Unicode-standard top-left = bit 0
##     row-major within 2-col 4-row octant cell
##   - Quadrant glyph table (all 16 patterns, including space + halves +
##     full + 4 single-quadrants + 6 quadrant-pair / 4 triple compositions)
##   - Half glyph table (all 4 patterns)
##   - Ascii glyph (empty + any-on)
##   - Octant glyph: the 16 known pre-existing patterns produce identical
##     glyphs to Quadrant on the same pattern (since Octant reuses the
##     Quadrant chars for those 16); other patterns fall through to
##     Quadrant under v0.6.6.0
##   - octant_blit_to_plane: cells written at (dst_x, dst_y) onward,
##     fg/bg channels applied, attrs cleared, OOB cells clipped silently
##
## See docs/design/TUI_V06_CELL_ENGINE.md D6 + Unicode 17 chart
## U+1CC00..U+1CEBF for the codepoint reference.

import * from qspec
import std/tui/octant as oc
import std/tui/plane as pl
import std/tui/cell as cl

# =============================================================================
# Helpers — build a blitter at a known pattern, extract glyph from a single-cell blit
# =============================================================================

## Build a 2x4 (= 1 cell) blitter with the 8 bits of `pat` set.
def _blitter_with_pattern(pat: Int): oc::OctantBlitter
  var b = oc::octant_blitter_new(2, 4)
  if (pat & 1) != 0
    b = oc::octant_set(b, 0, 0, true)
  end
  if (pat & 2) != 0
    b = oc::octant_set(b, 1, 0, true)
  end
  if (pat & 4) != 0
    b = oc::octant_set(b, 0, 1, true)
  end
  if (pat & 8) != 0
    b = oc::octant_set(b, 1, 1, true)
  end
  if (pat & 16) != 0
    b = oc::octant_set(b, 0, 2, true)
  end
  if (pat & 32) != 0
    b = oc::octant_set(b, 1, 2, true)
  end
  if (pat & 64) != 0
    b = oc::octant_set(b, 0, 3, true)
  end
  if (pat & 128) != 0
    b = oc::octant_set(b, 1, 3, true)
  end
  return b
end

## Blit a 1-cell pattern with the given quality and return the resulting
## glyph string.
def _glyph(pat: Int, q: oc::OctantQuality): String
  var b = _blitter_with_pattern(pat)
  var p = pl::plane_create(1, 1)
  var p2 = oc::octant_blit_to_plane(
    b, p, 0, 0, q,
    cl::channel_default(), cl::channel_default()
  )
  var cell = pl::plane_getc(p2, 0, 0)
  return cell.egc
end

# =============================================================================
# Spec body
# =============================================================================

def main(): Int
  describe("OctantBlitter — construction") do ->
    it("dimensions stored correctly") do ->
      var b = oc::octant_blitter_new(8, 12)
      assert_eq(b.pixel_w, 8)
      assert_eq(b.pixel_h, 12)
    end

    it("all pixels start off") do ->
      var b = oc::octant_blitter_new(4, 4)
      var any = false
      var py = 0
      while py < 4
        var px = 0
        while px < 4
          if oc::octant_get(b, px, py)
            any = true
          end
          px += 1
        end
        py += 1
      end
      if any
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("negative dimensions clamp to 0") do ->
      var b = oc::octant_blitter_new(-3, -5)
      assert_eq(b.pixel_w, 0)
      assert_eq(b.pixel_h, 0)
    end

    it("octant_cell_w / octant_cell_h derived correctly") do ->
      var b = oc::octant_blitter_new(8, 12)
      assert_eq(oc::octant_cell_w(b), 4)
      assert_eq(oc::octant_cell_h(b), 3)
    end
  end

  describe("OctantBlitter — set / get") do ->
    it("set then get round-trips") do ->
      var b = oc::octant_blitter_new(4, 4)
      var b2 = oc::octant_set(b, 1, 2, true)
      var got = oc::octant_get(b2, 1, 2)
      if got
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("set is non-mutating — original unchanged") do ->
      var b = oc::octant_blitter_new(4, 4)
      var b2 = oc::octant_set(b, 0, 0, true)
      var orig = oc::octant_get(b, 0, 0)
      var modified = oc::octant_get(b2, 0, 0)
      if orig
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      if modified
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("OOB get returns false") do ->
      var b = oc::octant_blitter_new(4, 4)
      var g1 = oc::octant_get(b, -1, 0)
      var g2 = oc::octant_get(b, 4, 0)
      var g3 = oc::octant_get(b, 0, 4)
      var g4 = oc::octant_get(b, 99, 99)
      if g1 or g2 or g3 or g4
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("OOB set is silent no-op (dimensions preserved)") do ->
      var b = oc::octant_blitter_new(4, 4)
      var b2 = oc::octant_set(b, 99, 99, true)
      assert_eq(b2.pixel_w, 4)
      assert_eq(b2.pixel_h, 4)
    end

    it("octant_fill(true) fills every pixel") do ->
      var b = oc::octant_blitter_new(2, 2)
      var b2 = oc::octant_fill(b, true)
      var all_on = true
      var py = 0
      while py < 2
        var px = 0
        while px < 2
          if not oc::octant_get(b2, px, py)
            all_on = false
          end
          px += 1
        end
        py += 1
      end
      if all_on
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("Pattern extraction — Unicode bit ordering") do ->
    # Bit ordering: top-left = bit 0, top-right = bit 1, then row-major
    # down to bottom-right = bit 7.
    it("single top-left pixel produces pattern 0x01") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_set(b, 0, 0, true)
      var glyph = _glyph(1, oc::OctantQuality::Quadrant)
      # Pattern 0x01 has UL quadrant set (bit 0 maps to UL)
      # → 4-bit quadrant pattern 0x1 → glyph "▘".
      assert_eq_str(glyph, "▘")
    end

    it("single bottom-right pixel produces pattern 0x80") do ->
      var glyph = _glyph(0x80, oc::OctantQuality::Quadrant)
      # Pattern 0x80 has LR quadrant set → quadrant pattern 0x8 → "▗".
      assert_eq_str(glyph, "▗")
    end
  end

  describe("Quadrant quality — full glyph table") do ->
    it("empty pattern 0x00 → space") do ->
      assert_eq_str(_glyph(0x00, oc::OctantQuality::Quadrant), " ")
    end
    it("UL quadrant 0x05 (bits 0,2) → ▘ U+2598") do ->
      assert_eq_str(_glyph(0x05, oc::OctantQuality::Quadrant), "▘")
    end
    it("UR quadrant 0x0A → ▝ U+259D") do ->
      assert_eq_str(_glyph(0x0A, oc::OctantQuality::Quadrant), "▝")
    end
    it("upper half 0x0F → ▀ U+2580") do ->
      assert_eq_str(_glyph(0x0F, oc::OctantQuality::Quadrant), "▀")
    end
    it("LL quadrant 0x50 → ▖ U+2596") do ->
      assert_eq_str(_glyph(0x50, oc::OctantQuality::Quadrant), "▖")
    end
    it("left half 0x55 → ▌ U+258C") do ->
      assert_eq_str(_glyph(0x55, oc::OctantQuality::Quadrant), "▌")
    end
    it("UR + LL 0x5A → ▞ U+259E") do ->
      assert_eq_str(_glyph(0x5A, oc::OctantQuality::Quadrant), "▞")
    end
    it("UL + UR + LL 0x5F → ▛ U+259B") do ->
      assert_eq_str(_glyph(0x5F, oc::OctantQuality::Quadrant), "▛")
    end
    it("LR quadrant 0xA0 → ▗ U+2597") do ->
      assert_eq_str(_glyph(0xA0, oc::OctantQuality::Quadrant), "▗")
    end
    it("UL + LR 0xA5 → ▚ U+259A") do ->
      assert_eq_str(_glyph(0xA5, oc::OctantQuality::Quadrant), "▚")
    end
    it("right half 0xAA → ▐ U+2590") do ->
      assert_eq_str(_glyph(0xAA, oc::OctantQuality::Quadrant), "▐")
    end
    it("UL + UR + LR 0xAF → ▜ U+259C") do ->
      assert_eq_str(_glyph(0xAF, oc::OctantQuality::Quadrant), "▜")
    end
    it("lower half 0xF0 → ▄ U+2584") do ->
      assert_eq_str(_glyph(0xF0, oc::OctantQuality::Quadrant), "▄")
    end
    it("UL + LL + LR 0xF5 → ▙ U+2599") do ->
      assert_eq_str(_glyph(0xF5, oc::OctantQuality::Quadrant), "▙")
    end
    it("UR + LL + LR 0xFA → ▟ U+259F") do ->
      assert_eq_str(_glyph(0xFA, oc::OctantQuality::Quadrant), "▟")
    end
    it("full pattern 0xFF → █ U+2588") do ->
      assert_eq_str(_glyph(0xFF, oc::OctantQuality::Quadrant), "█")
    end
  end

  describe("Half quality — full glyph table") do ->
    it("empty 0x00 → space") do ->
      assert_eq_str(_glyph(0x00, oc::OctantQuality::Half), " ")
    end
    it("upper-only (any of bits 0..3) → ▀") do ->
      assert_eq_str(_glyph(0x01, oc::OctantQuality::Half), "▀")
      assert_eq_str(_glyph(0x0F, oc::OctantQuality::Half), "▀")
    end
    it("lower-only (any of bits 4..7) → ▄") do ->
      assert_eq_str(_glyph(0x10, oc::OctantQuality::Half), "▄")
      assert_eq_str(_glyph(0xF0, oc::OctantQuality::Half), "▄")
    end
    it("both halves → █") do ->
      assert_eq_str(_glyph(0x11, oc::OctantQuality::Half), "█")
      assert_eq_str(_glyph(0xFF, oc::OctantQuality::Half), "█")
    end
  end

  describe("Ascii quality") do ->
    it("empty 0x00 → space") do ->
      assert_eq_str(_glyph(0x00, oc::OctantQuality::Ascii), " ")
    end
    it("any-on → '#'") do ->
      assert_eq_str(_glyph(0x01, oc::OctantQuality::Ascii), "#")
      assert_eq_str(_glyph(0x80, oc::OctantQuality::Ascii), "#")
      assert_eq_str(_glyph(0xFF, oc::OctantQuality::Ascii), "#")
    end
  end

  describe("Octant quality — known reused patterns + Quadrant fallback") do ->
    it("the 16 known pre-existing patterns produce same glyph as Quadrant") do ->
      var pats = vec_new<Int>()
      pats.push(0x00)
      pats.push(0x05)
      pats.push(0x0A)
      pats.push(0x0F)
      pats.push(0x50)
      pats.push(0x55)
      pats.push(0x5A)
      pats.push(0x5F)
      pats.push(0xA0)
      pats.push(0xA5)
      pats.push(0xAA)
      pats.push(0xAF)
      pats.push(0xF0)
      pats.push(0xF5)
      pats.push(0xFA)
      pats.push(0xFF)
      var n = pats.size
      var i = 0
      var all_match = true
      while i < n
        var pat = pats[i]
        var oct = _glyph(pat, oc::OctantQuality::Octant)
        var quad = _glyph(pat, oc::OctantQuality::Quadrant)
        if not str_eq(oct, quad)
          all_match = false
        end
        i += 1
      end
      if all_match
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("non-quadrant-clean patterns emit their Unicode 17 octant codepoint, NOT the Quadrant approximation (v0.6.6.1)") do ->
      # Pattern 0x01 (single top-left subpixel) — under v0.6.6.0 this
      # fell back to Quadrant's UL-only ▘ glyph. Under v0.6.6.1 it
      # correctly emits its own codepoint (U+1CEAB) for the
      # subpixel-only-top-left shape.
      var g_01 = _glyph(0x01, oc::OctantQuality::Octant)
      var g_01_quad = _glyph(0x01, oc::OctantQuality::Quadrant)
      # The Octant glyph must NOT match the Quadrant approximation
      # for patterns that aren't quadrant-clean — that's the whole
      # point of 6.6.1.
      if str_eq(g_01, g_01_quad)
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      # The codepoint comes from the new table directly.
      assert_eq(oc::octant_codepoint(0x01), 0x1CEA8)
      # Pattern 0x80 (single bottom-right subpixel) likewise gets its
      # own codepoint (U+1CEA0 — single-subpixel-bottom-right), not
      # Quadrant's ▗ approximation.
      var g_80 = _glyph(0x80, oc::OctantQuality::Octant)
      var g_80_quad = _glyph(0x80, oc::OctantQuality::Quadrant)
      if str_eq(g_80, g_80_quad)
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      assert_eq(oc::octant_codepoint(0x80), 0x1CEA0)
    end
  end

  describe("Octant quality — full Unicode 17 table coverage (Phase 6.6.1)") do ->
    it("first new octant codepoint: pattern 0x04 (OCTANT-3 = upper-mid-left) → U+1CD00") do ->
      # OCTANT-3 = digit-3 = bit 2 (upper-mid-left) only = pattern 0x04
      # in our bit ordering. This is the very first new codepoint in
      # the Unicode 17 octant block.
      assert_eq(oc::octant_codepoint(0x04), 0x1CD00)
    end

    it("last new octant codepoint: pattern 0xFE (OCTANT-2345678) → U+1CDE5") do ->
      # OCTANT-2345678 = all bits except digit-1 (top-left) = bits 1..7
      # in our ordering = 0xFE.
      assert_eq(oc::octant_codepoint(0xFE), 0x1CDE5)
    end

    it("16 quadrant-clean patterns map to existing Block Elements range") do ->
      assert_eq(oc::octant_codepoint(0x00), 0x0020)  # space
      assert_eq(oc::octant_codepoint(0x05), 0x2598)  # ▘ QUAD UL
      assert_eq(oc::octant_codepoint(0x0A), 0x259D)  # ▝ QUAD UR
      assert_eq(oc::octant_codepoint(0x0F), 0x2580)  # ▀ UPPER HALF
      assert_eq(oc::octant_codepoint(0x50), 0x2596)  # ▖ QUAD LL
      assert_eq(oc::octant_codepoint(0x55), 0x258C)  # ▌ LEFT HALF
      assert_eq(oc::octant_codepoint(0x5A), 0x259E)  # ▞ DIAG
      assert_eq(oc::octant_codepoint(0x5F), 0x259B)  # ▛
      assert_eq(oc::octant_codepoint(0xA0), 0x2597)  # ▗ QUAD LR
      assert_eq(oc::octant_codepoint(0xA5), 0x259A)  # ▚ DIAG
      assert_eq(oc::octant_codepoint(0xAA), 0x2590)  # ▐ RIGHT HALF
      assert_eq(oc::octant_codepoint(0xAF), 0x259C)  # ▜
      assert_eq(oc::octant_codepoint(0xF0), 0x2584)  # ▄ LOWER HALF
      assert_eq(oc::octant_codepoint(0xF5), 0x2599)  # ▙
      assert_eq(oc::octant_codepoint(0xFA), 0x259F)  # ▟
      assert_eq(oc::octant_codepoint(0xFF), 0x2588)  # █ FULL BLOCK
    end

    it("10 non-quadrant-clean reused patterns map to legacy/symbol blocks") do ->
      # Patterns reused from outside U+2580..U+259F — verified against
      # the Bobby-Miller community gist after conversion to our bit
      # ordering (bit 0 = top-left, row-major down to bit 7 = bottom-right).
      # Single-corner-subpixel patterns: 4 reused codepoints in
      # U+1CEA0..U+1CEAB.
      assert_eq(oc::octant_codepoint(0x01), 0x1CEA8)  # single top-left (TL)
      assert_eq(oc::octant_codepoint(0x02), 0x1CEAB)  # single top-right (TR)
      assert_eq(oc::octant_codepoint(0x40), 0x1CEA3)  # single bottom-left (BL)
      assert_eq(oc::octant_codepoint(0x80), 0x1CEA0)  # single bottom-right (BR)
      # Top-row-only / bottom-row-only patterns: existing 1/4 blocks.
      assert_eq(oc::octant_codepoint(0x03), 0x1FB82)  # top row (TL+TR)
      assert_eq(oc::octant_codepoint(0xC0), 0x2582)   # bottom row (BL+BR)
      # 3/4 patterns: top 6 / bottom 6 subpixels. Gist typo at top-3-rows
      # was U+2586 (LOWER 3/4); corrected to U+1FB85 (UPPER 3/4) — the
      # geometric counterpart that pairs with U+2586's bottom-3-rows.
      assert_eq(oc::octant_codepoint(0x3F), 0x1FB85)  # top 3 rows (UPPER 3/4)
      assert_eq(oc::octant_codepoint(0xFC), 0x2586)   # bottom 3 rows (LOWER 3/4)
      # Middle-rows-of-one-column patterns.
      assert_eq(oc::octant_codepoint(0x14), 0x1FBE6)  # left col mid 2 (uML+lML)
      assert_eq(oc::octant_codepoint(0x28), 0x1FBE7)  # right col mid 2 (uMR+lMR)
    end

    it("table coverage: every pattern 0x00..0xFF returns a non-zero codepoint") do ->
      var miss = 0
      var pat = 0
      while pat < 256
        var cp = oc::octant_codepoint(pat)
        if cp == 0
          miss += 1
        end
        pat += 1
      end
      assert_eq(miss, 0)
    end

    it("table coverage: 230 patterns land in the new U+1CD00..U+1CDE5 range") do ->
      var hits = 0
      var pat = 0
      while pat < 256
        var cp = oc::octant_codepoint(pat)
        if cp >= 0x1CD00 and cp <= 0x1CDE5
          hits += 1
        end
        pat += 1
      end
      assert_eq(hits, 230)
    end

    it("UTF-8 encoder: 4-byte codepoints in U+1CD00 range") do ->
      var s = oc::codepoint_to_utf8(0x1CD00)
      assert_eq(str_byte_len(s), 4)
      # First byte of 4-byte UTF-8: 11110xxx
      var b0 = str_byte_at(s, 0)
      if (b0 & 0xF8) == 0xF0
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("UTF-8 encoder: 3-byte codepoints in U+2580 range") do ->
      var s = oc::codepoint_to_utf8(0x2598)
      assert_eq(str_byte_len(s), 3)
      var b0 = str_byte_at(s, 0)
      if (b0 & 0xF0) == 0xE0
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("UTF-8 encoder: 1-byte ASCII (space)") do ->
      var s = oc::codepoint_to_utf8(0x20)
      assert_eq(str_byte_len(s), 1)
      assert_eq(str_byte_at(s, 0), 0x20)
    end
  end

  describe("octant_blit_to_plane — composition") do ->
    it("writes one cell per (2 cols × 4 rows) of pixels") do ->
      var b = oc::octant_blitter_new(4, 4)
      # Pixel grid is 4x4 → 2 cells wide × 1 cell tall.
      var p = pl::plane_create(2, 1)
      var p2 = oc::octant_blit_to_plane(
        b, p, 0, 0,
        oc::OctantQuality::Quadrant,
        cl::channel_default(), cl::channel_default()
      )
      assert_eq(p2.w, 2)
      assert_eq(p2.h, 1)
    end

    it("applies fg / bg channels") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_fill(b, true)   # all on → "█"
      var p = pl::plane_create(1, 1)
      var fg = cl::channel_rgb(0x1FF0000)   # red
      var bg = cl::channel_rgb(0x100FF00)   # green
      var p2 = oc::octant_blit_to_plane(
        b2, p, 0, 0,
        oc::OctantQuality::Quadrant, fg, bg
      )
      var c = pl::plane_getc(p2, 0, 0)
      assert_eq_str(c.egc, "█")
      assert_eq(c.fg.color, 0x1FF0000)
      assert_eq(c.bg.color, 0x100FF00)
    end

    it("clips OOB cells silently") do ->
      var b = oc::octant_blitter_new(4, 4)   # 2 cells wide × 1 tall
      var b2 = oc::octant_fill(b, true)
      var p = pl::plane_create(1, 1)
      # Plane is only 1x1 — second cell from blitter falls off the right.
      var p2 = oc::octant_blit_to_plane(
        b2, p, 0, 0,
        oc::OctantQuality::Quadrant,
        cl::channel_default(), cl::channel_default()
      )
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, "█")
    end

    it("dst offset places cells at (dst_x, dst_y)") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_fill(b, true)
      var p = pl::plane_create(3, 2)
      var p2 = oc::octant_blit_to_plane(
        b2, p, 1, 1,
        oc::OctantQuality::Quadrant,
        cl::channel_default(), cl::channel_default()
      )
      # Cell at (1, 1) should be the rendered glyph.
      assert_eq_str(pl::plane_getc(p2, 1, 1).egc, "█")
      # Cell at (0, 0) should still be a blank.
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, " ")
    end
  end

  return qspec_main()
end
