## QSpec coverage for the Profile test-handler factories
## (Phase A.6 Phase 4): profile_capture_handler,
## profile_silent_handler, profile_ndjson_handler.
##
## 4 ops × 3 handlers minus uninteresting combinations + 2 cross-
## cutting tests.

import * from qspec
import std/profile

# Helper: run a function under the capture handler and print the log.
def _under_capture(body: Fn(): Void): Void
  profile_capture_reset()
  with Profile {
    prof_phase: profile_capture_handler,
    prof_span_begin: profile_capture_handler,
    prof_span_end: profile_capture_handler,
    prof_sample: profile_capture_handler
  } do ->
    body()
  end
  var log = profile_capture_log()
  for entry in log
    puts(entry)
  end
end

# --- Capture handler tests (4) ---

def t_cap_phase(): Void
  _under_capture(_phase_body)
end
def _phase_body(): Void
  prof_phase("init")
  prof_phase("lex")
end

def t_cap_sample(): Void
  _under_capture(_sample_body)
end
def _sample_body(): Void
  prof_sample("functions", 2440)
  prof_sample("modules", 17)
end

def t_cap_span(): Void
  _under_capture(_span_body)
end
def _span_body(): Void
  var h = prof_span_begin("compile")
  var sum = 0
  for i in 0..50
    sum = sum + i
  end
  prof_span_end(h, "compile")
end

def t_cap_mixed(): Void
  _under_capture(_mixed_body)
end
def _mixed_body(): Void
  prof_phase("init")
  prof_sample("count", 1)
  var h = prof_span_begin("body")
  prof_phase("middle")
  prof_span_end(h, "body")
  prof_phase("done")
end

# --- Silent handler tests (4) ---
# All four silent ops produce zero stdout output (they emit nothing
# at all). Span ops still return real timestamps; phase/sample
# return 0.

def t_silent_phase(): Void
  with Profile { prof_phase: profile_silent_handler } do ->
    prof_phase("ignored")
    prof_phase("also_ignored")
  end
  puts("done")
end

def t_silent_sample(): Void
  with Profile { prof_sample: profile_silent_handler } do ->
    var rv = prof_sample("count", 999)
    puts("rv=#{rv}")
  end
end

def t_silent_span_returns_real(): Void
  with Profile {
    prof_span_begin: profile_silent_handler,
    prof_span_end: profile_silent_handler
  } do ->
    var h = prof_span_begin("work")
    var sum = 0
    for i in 0..50
      sum = sum + i
    end
    var elapsed = prof_span_end(h, "work")
    if h > 0 and elapsed >= 0
      puts("real_timestamps")
    else
      puts("bad_timestamps")
    end
  end
end

def t_silent_combined(): Void
  with Profile {
    prof_phase: profile_silent_handler,
    prof_sample: profile_silent_handler
  } do ->
    prof_phase("a")
    prof_sample("b", 1)
    prof_phase("c")
  end
  puts("ok")
end

# --- NDJSON handler tests (4) ---
# These bind to stdout-emitting puts via assert_output. The ndjson
# handler emits to stderr, so we use assert_output's match against
# stdout — but we also need to validate via a dummy puts that
# something happened. Simplest: pair each ndjson call with a
# stdout puts marker.

def t_ndjson_phase(): Void
  with Profile { prof_phase: profile_ndjson_handler } do ->
    prof_phase("test")
  end
  puts("after")
end

def t_ndjson_sample(): Void
  with Profile { prof_sample: profile_ndjson_handler } do ->
    var rv = prof_sample("counter", 42)
    puts("sample_rv=#{rv}")
  end
end

def t_ndjson_span(): Void
  with Profile {
    prof_span_begin: profile_ndjson_handler,
    prof_span_end: profile_ndjson_handler
  } do ->
    var h = prof_span_begin("span1")
    var elapsed = prof_span_end(h, "span1")
    if elapsed >= 0
      puts("span_done")
    end
  end
end

def t_ndjson_does_not_block_default(): Void
  # ndjson handler emits, but bypasses _profile_ndjson_enabled gate.
  # The default handler with both gates off is a no-op. Verify by
  # alternating — ndjson handler inside the with-block, default
  # handler outside, both invoked, only the ndjson one observable.
  with Profile { prof_phase: profile_ndjson_handler } do ->
    prof_phase("inside")
  end
  prof_phase("outside")
  puts("ok")
end

# --- Cross-cutting (2) ---

def t_capture_resets_between_runs(): Void
  _under_capture(_phase_body)
  puts("---")
  _under_capture(_sample_body)
end

def t_handlers_can_compose_per_op(): Void
  # Mix capture for phase + silent for sample in the same with-block.
  profile_capture_reset()
  with Profile {
    prof_phase: profile_capture_handler,
    prof_sample: profile_silent_handler
  } do ->
    prof_phase("captured1")
    prof_sample("silent1", 1)
    prof_phase("captured2")
    prof_sample("silent2", 2)
  end
  for entry in profile_capture_log()
    puts(entry)
  end
end

def main(): Int
  describe("Profile test-handler factories (A.6 Phase 4)") do ->
    # Capture handler
    it("capture: phase ops are recorded in order") do ->
      assert_output("phase init\nphase lex\n", t_cap_phase)
    end
    it("capture: sample ops record name + value") do ->
      assert_output("sample functions=2440\nsample modules=17\n", t_cap_sample)
    end
    it("capture: span begin/end record both events") do ->
      assert_output("span_begin compile\nspan_end compile\n", t_cap_span)
    end
    it("capture: mixed ops preserve call order") do ->
      assert_output("phase init\nsample count=1\nspan_begin body\nphase middle\nspan_end body\nphase done\n", t_cap_mixed)
    end

    # Silent handler
    it("silent: phase calls produce no output") do ->
      assert_output("done\n", t_silent_phase)
    end
    it("silent: sample returns 0") do ->
      assert_output("rv=0\n", t_silent_sample)
    end
    it("silent: span begin/end still return real timestamps") do ->
      assert_output("real_timestamps\n", t_silent_span_returns_real)
    end
    it("silent: combined silent ops produce no output") do ->
      assert_output("ok\n", t_silent_combined)
    end

    # NDJSON handler — assertions are via stdout puts since ndjson
    # writes to stderr (not captured by assert_output).
    it("ndjson: phase emits NDJSON + stdout marker fires") do ->
      assert_output("after\n", t_ndjson_phase)
    end
    it("ndjson: sample returns 0") do ->
      assert_output("sample_rv=0\n", t_ndjson_sample)
    end
    it("ndjson: span returns real elapsed") do ->
      assert_output("span_done\n", t_ndjson_span)
    end
    it("ndjson: outside-of-with falls through to no-op default") do ->
      assert_output("ok\n", t_ndjson_does_not_block_default)
    end

    # Cross-cutting
    it("capture log resets between runs") do ->
      assert_output("phase init\nphase lex\n---\nsample functions=2440\nsample modules=17\n", t_capture_resets_between_runs)
    end
    it("handlers compose per-op within one with-block") do ->
      assert_output("phase captured1\nphase captured2\n", t_handlers_can_compose_per_op)
    end
  end
  return qspec_main()
end
