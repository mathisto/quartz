## Math Trig/Constants Tests — TDD spec for missing trig/log intrinsics
##
## Tests: sin, cos, tan, asin, acos, atan, atan2, sqrt, log, log2, log10,
##        exp, PI, E, TAU, degree/radian conversion, UFCS methods.
##
## Contract:
##   1. Math constants.
##   2. Trig functions.
##   3. Inverse trig functions.
##   4. Logarithm functions.
##   5. Degree/radian conversion.
##   6. UFCS trig methods.
##   7. Math wrapper functions.

import * from qspec
import * from math

def main(): Int
  describe("math constants") do ->
    it("PI is approximately 3.14159") do ->
      # to_int truncates, so PI * 100000 = 314159
      assert_eq(to_int(MATH_PI * 100000.0), 314159)
    end

    it("E is approximately 2.71828") do ->
      assert_eq(to_int(MATH_E * 100000.0), 271828)
    end

    it("TAU is approximately 2 * PI") do ->
      assert_eq(to_int(MATH_TAU * 100000.0), 628318)
    end
  end

  describe("trig functions") do ->
    it("sin(0) is 0") do ->
      assert_eq(to_int(f64_sin(to_f64(0))), 0)
    end

    it("cos(0) is 1") do ->
      assert_eq(to_int(f64_cos(to_f64(0))), 1)
    end

    it("tan(0) is 0") do ->
      assert_eq(to_int(f64_tan(to_f64(0))), 0)
    end

    it("sin(PI/2) is approximately 1") do ->
      var half_pi = MATH_PI / 2.0
      # sin(PI/2) = 1.0, multiply by 1000 for precision
      assert_eq(to_int(f64_sin(half_pi) * 1000.0), 1000)
    end

    it("cos(PI) is approximately -1") do ->
      assert_eq(to_int(f64_cos(MATH_PI) * 1000.0), -1000)
    end

    it("tan(PI/4) is approximately 1") do ->
      var quarter_pi = MATH_PI / 4.0
      # Use round to handle floating-point imprecision (0.999... -> 1.0)
      assert_eq(to_int(f64_round(f64_tan(quarter_pi) * 1000.0)), 1000)
    end
  end

  describe("inverse trig functions") do ->
    it("asin(0) is 0") do ->
      assert_eq(to_int(f64_asin(0.0)), 0)
    end

    it("acos(1) is 0") do ->
      assert_eq(to_int(f64_acos(1.0)), 0)
    end

    it("atan(0) is 0") do ->
      assert_eq(to_int(f64_atan(0.0)), 0)
    end

    it("asin(1) is approximately PI/2") do ->
      var result = f64_asin(1.0)
      # PI/2 * 10000 = 15707
      assert_eq(to_int(result * 10000.0), 15707)
    end

    it("acos(0) is approximately PI/2") do ->
      var result = f64_acos(0.0)
      assert_eq(to_int(result * 10000.0), 15707)
    end

    it("atan(1) is approximately PI/4") do ->
      var result = f64_atan(1.0)
      # PI/4 * 10000 = 7853
      assert_eq(to_int(result * 10000.0), 7853)
    end
  end

  describe("logarithm functions") do ->
    it("log(1) is 0") do ->
      assert_eq(to_int(f64_log(1.0)), 0)
    end

    it("log(E) is approximately 1") do ->
      assert_eq(to_int(f64_log(MATH_E) * 1000.0), 1000)
    end

    it("log2(8) is 3") do ->
      assert_eq(to_int(f64_log2(8.0)), 3)
    end

    it("log2(1) is 0") do ->
      assert_eq(to_int(f64_log2(1.0)), 0)
    end

    it("log10(100) is 2") do ->
      assert_eq(to_int(f64_log10(100.0)), 2)
    end

    it("log10(1000) is 3") do ->
      assert_eq(to_int(f64_log10(1000.0)), 3)
    end
  end

  describe("degree/radian conversion") do ->
    it("to_radians(180) is approximately PI") do ->
      var result = math_to_radians(180.0)
      assert_eq(to_int(result * 10000.0), 31415)
    end

    it("to_degrees(PI) is approximately 180") do ->
      var result = math_to_degrees(MATH_PI)
      assert_eq(to_int(result), 180)
    end

    it("to_radians(90) is approximately PI/2") do ->
      var result = math_to_radians(90.0)
      assert_eq(to_int(result * 10000.0), 15707)
    end

    it("roundtrip degrees -> radians -> degrees") do ->
      var d = 45.0
      var r = math_to_radians(d)
      var back = math_to_degrees(r)
      assert_eq(to_int(back), 45)
    end
  end

  describe("UFCS trig methods") do ->
    it("x.tan() works") do ->
      assert_eq(mt_tan_ufcs(), 0)
    end

    it("x.asin() works") do ->
      assert_eq(mt_asin_ufcs(), 0)
    end

    it("x.acos() works") do ->
      assert_eq(mt_acos_ufcs(), 15707)
    end

    it("x.atan() works") do ->
      assert_eq(mt_atan_ufcs(), 0)
    end

    it("x.log2() works") do ->
      assert_eq(mt_log2_ufcs(), 4)
    end

    it("x.log10() works") do ->
      assert_eq(mt_log10_ufcs(), 2)
    end
  end

  describe("math wrapper functions") do ->
    it("math_sin matches f64_sin") do ->
      assert_eq(to_int(math_sin(MATH_PI / 2.0) * 1000.0), 1000)
    end

    it("math_tan matches f64_tan") do ->
      assert_eq(to_int(math_tan(0.0)), 0)
    end

    it("math_log2 matches f64_log2") do ->
      assert_eq(to_int(math_log2(32.0)), 5)
    end

    it("math_log10 matches f64_log10") do ->
      assert_eq(to_int(math_log10(10000.0)), 4)
    end
  end

  return qspec_main()
end

# UFCS helper functions (must be named, not inline closures, for assert_output)
def mt_tan_ufcs(): Int
  var x = 0.0
  return to_int(x.tan())
end

def mt_asin_ufcs(): Int
  var x = 0.0
  return to_int(x.asin())
end

def mt_acos_ufcs(): Int
  var x = 0.0
  return to_int(x.acos() * 10000.0)
end

def mt_atan_ufcs(): Int
  var x = 0.0
  return to_int(x.atan())
end

def mt_log2_ufcs(): Int
  var x = 16.0
  return to_int(x.log2())
end

def mt_log10_ufcs(): Int
  var x = 100.0
  return to_int(x.log10())
end
