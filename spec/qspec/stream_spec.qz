## Stream Tests
##
## Contract:
##   1. println: prints string with trailing newline to stdout.
##   2. write_stdout: prints string without trailing newline.
##   3. eprintln: prints to stderr (callable, no crash).
##   4. write_stderr: prints to stderr (callable, no crash).
##   5. Interpolated: println with `#{}` interpolation.
##   6. Sequential: multiple write_stdout calls concatenate.
import * from qspec
import * from io/stream

def main(): Int
  describe("println") do ->
    it("prints string with newline") do ->
      assert_output("hello\n", stream_println_test)
    end
  end

  describe("write_stdout") do ->
    it("prints string without trailing newline") do ->
      assert_output("no newline", stream_write_stdout_test)
    end
  end

  describe("eprintln") do ->
    it("is callable") do ->
      # eprintln goes to stderr, which assert_output doesn't capture.
      # Just verify it doesn't crash.
      assert_eq(stream_eprintln_test(), 1)
    end
  end

  describe("write_stderr") do ->
    it("is callable") do ->
      assert_eq(stream_write_stderr_test(), 1)
    end
  end

  describe("println with interpolation") do ->
    it("prints interpolated value") do ->
      assert_output("count: 42\n", stream_interp_test)
    end
  end

  describe("sequential writes") do ->
    it("multiple write_stdout calls concatenate") do ->
      assert_output("abc", stream_multi_write_test)
    end
  end

  return qspec_main()
end

def stream_println_test(): Void
  println("hello")
end

def stream_write_stdout_test(): Void
  write_stdout("no newline")
end

def stream_eprintln_test(): Int
  eprintln("error message")
  return 1
end

def stream_write_stderr_test(): Int
  write_stderr("warning")
  return 1
end

def stream_interp_test(): Void
  var n = 42
  println("count: #{n}")
end

def stream_multi_write_test(): Void
  write_stdout("a")
  write_stdout("b")
  write_stdout("c")
end
