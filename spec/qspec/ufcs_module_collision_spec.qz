## UFCS Module Name Collision Tests
##
## Contract:
##   1. When a parameter name matches an imported module name,
##      dot-call syntax uses UFCS (variable.method) not module.function
##   2. Explicit module::function syntax still works for module calls

import * from qspec

## This function takes a parameter named 'string' which collides
## with the 'string' module that's imported by the prelude.
## The call string.size() should use UFCS (call size on the variable)
## NOT string::size() (module-qualified call).
def get_length(string: String): Int
  return string.size()
end

## Another collision: 'json' parameter with json module
## json.parse() should call parse(json) via UFCS, not json::parse()
## (We can't easily test json.parse because it requires a different signature,
##  so we test the principle with a simpler example)
def describe_value(value: Int): String
  return value.to_s()
end

## Test with a parameter named after a commonly-imported module
def format_string(string: String): String
  return "formatted: #{string.size()}"
end

def main(): Int
  describe("UFCS module name collision") do ->
    it("parameter named 'string' uses UFCS not module call") do ->
      assert_eq(get_length("hello"), 5)
    end

    it("parameter named 'string' with interpolation") do ->
      assert_eq_str(format_string("test"), "formatted: 4")
    end

    it("parameter named 'value' uses UFCS") do ->
      assert_eq_str(describe_value(42), "42")
    end
  end

  return qspec_main()
end
