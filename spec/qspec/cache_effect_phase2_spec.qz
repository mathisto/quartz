## QSpec coverage for Phase A.3 Phase 2 — the 5 remaining cache ops
## (cache_op_store / cache_op_save_pool / cache_op_load_pool /
## cache_op_save_ast / cache_op_load_ast).
##
## Phase 1 wired cache_op_lookup end-to-end (mechanism + relaxation +
## one consumer site) and stubbed the other 5 default-handler branches.
## Phase 2 wires those 4 stub branches to forward to the matching
## `build_cache::cache_*` impl AND migrates each callsite in
## `quartz.qz` / `resolver.qz` away from `build_cache::cache_*` to the
## effect-routed form.
##
## Each `it` block in this file proves the test-handler value prop for
## one migrated op — install a recording mock, call the migrated form
## directly, assert the mock fires with the expected args.
##
## Out of scope (deferred to Phase 3):
##   - Test-handler factories (`Cache.in_memory`, `Cache.disabled`,
##     `Cache.tracing`) shipped alongside `std/cache.qz`.
##   - Mock interception around full `compile()` / `resolve_module()`
##     calls (currently exercised at unit-op level here).

import * from qspec
import std/cache
import ast

# --- Test 1: cache_op_store interception captures (module, hash, ir).

var _t1_modules = vec_new<String>()
var _t1_hashes = vec_new<String>()
var _t1_irs = vec_new<String>()

def t1_recording_store(op_name: Int, argc: Int, argv: Int): Int
  var module = as_string(load(argv, 0))
  var hash = as_string(load(argv, 1))
  var ir = as_string(load(argv, 2))
  _t1_modules.push(module)
  _t1_hashes.push(hash)
  _t1_irs.push(ir)
  return 0
end

def t1_run(): Void
  _t1_modules = vec_new<String>()
  _t1_hashes = vec_new<String>()
  _t1_irs = vec_new<String>()
  with Cache { cache_op_store: t1_recording_store } do ->
    var r1 = cache_op_store("self-hosted/lexer.qz", "abc123", "; ir for lexer")
    var r2 = cache_op_store("std/file_io.qz", "def456", "; ir for file_io")
    puts("r1=#{r1} r2=#{r2}")
  end
  puts("count=#{_t1_modules.size}")
  puts("first=#{_t1_modules[0]}|#{_t1_hashes[0]}|#{_t1_irs[0]}")
  puts("second=#{_t1_modules[1]}|#{_t1_hashes[1]}|#{_t1_irs[1]}")
end

# --- Test 2: cache_op_save_pool interception captures the strings vec.

var _t2_saved_size = 0
var _t2_saved_first = ""
var _t2_saved_last = ""

def t2_recording_save_pool(op_name: Int, argc: Int, argv: Int): Int
  var strings = as_vec(load(argv, 0))
  _t2_saved_size = strings.size
  if strings.size > 0
    _t2_saved_first = strings[0]
    _t2_saved_last = strings[strings.size - 1]
  end
  return 0
end

def t2_run(): Void
  _t2_saved_size = 0
  _t2_saved_first = ""
  _t2_saved_last = ""
  var pool = vec_new<String>()
  pool.push("alpha")
  pool.push("beta")
  pool.push("gamma")
  with Cache { cache_op_save_pool: t2_recording_save_pool } do ->
    var r = cache_op_save_pool(pool)
    puts("r=#{r}")
  end
  puts("size=#{_t2_saved_size} first=#{_t2_saved_first} last=#{_t2_saved_last}")
end

# --- Test 3: cache_op_load_pool returns a synthetic Vec<String> from the
#     mock handler, validating the as_int(Vec)/as_vec(Int) round-trip.

def t3_synthetic_pool(op_name: Int, argc: Int, argv: Int): Int
  var pool = vec_new<String>()
  pool.push("synthetic_a")
  pool.push("synthetic_b")
  return as_int(pool)
end

def t3_run(): Void
  with Cache { cache_op_load_pool: t3_synthetic_pool } do ->
    var loaded = cache_op_load_pool()
    puts("size=#{loaded.size}")
    puts("first=#{loaded[0]}")
    puts("second=#{loaded[1]}")
  end
end

# --- Test 4: cache_op_save_ast interception captures (module, hash) — the
#     AstStorage handle and root index are passed through but inspected
#     only for non-zero presence (the existential-types model means they
#     surface as opaque i64 handles at the effect boundary).

var _t4_modules = vec_new<String>()
var _t4_hashes = vec_new<String>()
var _t4_storages = vec_new<Int>()
var _t4_roots = vec_new<Int>()

def t4_recording_save_ast(op_name: Int, argc: Int, argv: Int): Int
  var module = as_string(load(argv, 0))
  var hash = as_string(load(argv, 1))
  var storage_handle = load(argv, 2)
  var root = load(argv, 3)
  _t4_modules.push(module)
  _t4_hashes.push(hash)
  _t4_storages.push(storage_handle)
  _t4_roots.push(root)
  return 0
end

def t4_run(): Void
  _t4_modules = vec_new<String>()
  _t4_hashes = vec_new<String>()
  _t4_storages = vec_new<Int>()
  _t4_roots = vec_new<Int>()
  var dummy_storage = ast::ast_new_storage()
  with Cache { cache_op_save_ast: t4_recording_save_ast } do ->
    var r = cache_op_save_ast("self-hosted/lexer.qz", "deadbeef", dummy_storage, 42)
    puts("r=#{r}")
  end
  puts("count=#{_t4_modules.size}")
  puts("first=#{_t4_modules[0]}|#{_t4_hashes[0]}|root=#{_t4_roots[0]}")
end

# --- Test 5: cache_op_load_ast returns a synthetic Vec<Int> from the
#     mock handler (slot 0 = AstStorage handle, slot 1 = root). Validates
#     the Vec<Int> as_int(vec)/as_vec(int) round-trip through the
#     effect boundary.

def t5_synthetic_load_ast(op_name: Int, argc: Int, argv: Int): Int
  var result = vec_new<Int>()
  result.push(123456)
  result.push(789)
  return as_int(result)
end

def t5_run(): Void
  with Cache { cache_op_load_ast: t5_synthetic_load_ast } do ->
    var loaded = cache_op_load_ast("any.qz", "anyhash")
    puts("size=#{loaded.size}")
    puts("storage_handle=#{loaded[0]}")
    puts("root=#{loaded[1]}")
  end
end

def main(): Int
  describe("Cache effect: Phase 2 op migrations (A.3 Phase 2)") do ->
    it("cache_op_store mock captures (module, hash, ir) tuples") do ->
      assert_output("r1=0 r2=0\ncount=2\nfirst=self-hosted/lexer.qz|abc123|; ir for lexer\nsecond=std/file_io.qz|def456|; ir for file_io\n", t1_run)
    end

    it("cache_op_save_pool mock captures the strings Vec arg") do ->
      assert_output("r=0\nsize=3 first=alpha last=gamma\n", t2_run)
    end

    it("cache_op_load_pool mock returns a synthetic Vec<String>") do ->
      assert_output("size=2\nfirst=synthetic_a\nsecond=synthetic_b\n", t3_run)
    end

    it("cache_op_save_ast mock captures (module, hash, storage, root)") do ->
      assert_output("r=0\ncount=1\nfirst=self-hosted/lexer.qz|deadbeef|root=42\n", t4_run)
    end

    it("cache_op_load_ast mock returns a synthetic Vec<Int>") do ->
      assert_output("size=2\nstorage_handle=123456\nroot=789\n", t5_run)
    end
  end
  return qspec_main()
end
