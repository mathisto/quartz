## v0.3.2 Step 4 — Viewport behavior tests
##
## Coverage:
##   - Content management: set_content (\n-split), set_content_lines,
##     append_line, append_lines, clear
##   - Scroll: scroll_up/down clamping, page_up/down, goto_top/bottom,
##     ensure_visible, at_top/at_bottom, scroll_percent
##   - follow_tail: append auto-scrolls to bottom
##   - Update: Up/Down → Scrolled; non-scroll key → Idle
##   - View: produces `height` lines, content slice matches y_offset
##   - soft_wrap: long lines split at width

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/viewport as vp
import std/tui/layout as ly

enum SpecMsg
  Noop
end

def feed_key(v: vp::Viewport, code: Int): vp::Viewport
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = vp::viewport_update(v, msg)
  return triple.0
end

def feed_event(v: vp::Viewport, code: Int): vp::ViewportEvent
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = vp::viewport_update(v, msg)
  return triple.2
end

def make_lines_n(n: Int): Vec<String>
  var v = vec_new()
  var i = 0
  while i < n
    var num = i + 1
    vec_push(v, "line#{num}")
    i = i + 1
  end
  return v
end

# ============================================================
# Content management
# ============================================================

def test_set_content_splits_on_newline(): Void
  var v = vp::viewport_new()
  v = vp::viewport_set_content(v, "a\nb\nc")
  assert_eq(vp::viewport_line_count(v), 3)
end

def test_set_content_empty_yields_zero_lines(): Void
  var v = vp::viewport_new()
  v = vp::viewport_set_content(v, "")
  assert_eq(vp::viewport_line_count(v), 0)
end

def test_set_content_lines_preserves_input(): Void
  var v = vp::viewport_new()
  v = vp::viewport_set_content_lines(v, make_lines_n(5))
  assert_eq(vp::viewport_line_count(v), 5)
end

def test_append_line_grows_count(): Void
  var v = vp::viewport_new()
  v = vp::viewport_append_line(v, "a")
  v = vp::viewport_append_line(v, "b")
  assert_eq(vp::viewport_line_count(v), 2)
end

def test_append_lines_grows_count(): Void
  var v = vp::viewport_set_content_lines(vp::viewport_new(), make_lines_n(2))
  v = vp::viewport_append_lines(v, make_lines_n(3))
  assert_eq(vp::viewport_line_count(v), 5)
end

def test_clear_empties_and_resets_offset(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = vp::viewport_goto_bottom(v)
  v = vp::viewport_clear(v)
  assert_eq(vp::viewport_line_count(v), 0)
  if vp::viewport_at_top(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# follow_tail
# ============================================================

def test_follow_tail_off_keeps_offset_at_zero(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(2))
  v = vp::viewport_append_line(v, "x")
  if vp::viewport_at_top(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_follow_tail_on_jumps_to_bottom_after_append(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_with_follow_tail(v, true)
  # 5 lines in a 3-row window — appending a 6th should leave us at bottom.
  v = vp::viewport_set_content_lines(v, make_lines_n(5))
  v = vp::viewport_append_line(v, "tail")
  if vp::viewport_at_bottom(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Scroll commands
# ============================================================

def test_scroll_up_clamps_at_zero(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_scroll_up(v, 5)  # already at 0
  if vp::viewport_at_top(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_scroll_down_clamps_at_max(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_scroll_down(v, 100)
  if vp::viewport_at_bottom(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_page_down_advances_by_height(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = vp::viewport_page_down(v)
  assert_eq(v.y_offset, 3)
end

def test_page_up_retreats_by_height(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = vp::viewport_goto_bottom(v)  # offset=17
  v = vp::viewport_page_up(v)
  assert_eq(v.y_offset, 14)
end

def test_goto_top_resets(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_goto_bottom(v)
  v = vp::viewport_goto_top(v)
  if vp::viewport_at_top(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_goto_bottom_jumps_to_max(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_goto_bottom(v)
  if vp::viewport_at_bottom(v)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_ensure_visible_above_window(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_goto_bottom(v)  # offset=7
  v = vp::viewport_ensure_visible(v, 1)
  assert_eq(v.y_offset, 1)
end

def test_ensure_visible_below_window(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = vp::viewport_ensure_visible(v, 10)  # 10 below height-3
  assert_eq(v.y_offset, 8)  # 10 - 3 + 1
end

def test_ensure_visible_in_window_no_change(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 5)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = vp::viewport_ensure_visible(v, 2)  # in [0, 5)
  assert_eq(v.y_offset, 0)
end

# ============================================================
# Accessors
# ============================================================

def test_scroll_percent_zero_at_top(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  assert_eq(vp::viewport_scroll_percent(v), 0)
end

def test_scroll_percent_100_at_bottom(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_goto_bottom(v)
  assert_eq(vp::viewport_scroll_percent(v), 100)
end

def test_scroll_percent_zero_when_content_fits(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 10)
  v = vp::viewport_set_content_lines(v, make_lines_n(5))
  assert_eq(vp::viewport_scroll_percent(v), 0)
end

# ============================================================
# Update
# ============================================================

def test_update_up_emits_scrolled(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_goto_bottom(v)  # offset=7
  var ev = feed_event(v, terminal::KEY_UP())
  if ev is Scrolled
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_update_up_at_top_emits_idle(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  var ev = feed_event(v, terminal::KEY_UP())
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_update_unknown_key_is_idle(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  var ev = feed_event(v, 'x')
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_update_down_advances_offset(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = feed_key(v, terminal::KEY_DOWN())
  assert_eq(v.y_offset, 1)
end

def test_update_ctrl_f_pages_down(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 80, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(20))
  v = feed_key(v, terminal::KEY_CTRL_F())
  assert_eq(v.y_offset, 3)
end

# ============================================================
# View
# ============================================================

def test_view_renders_height_lines(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 20, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  var stripped = ly::strip_styles(vp::viewport_view(v, false))
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 3)
end

def test_view_first_line_matches_offset(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 20, 3)
  v = vp::viewport_set_content_lines(v, make_lines_n(10))
  v = vp::viewport_scroll_down(v, 2)
  var stripped = ly::strip_styles(vp::viewport_view(v, false))
  var lines = str_split(stripped, "\n")
  # First visible line should be "line3" (1-indexed in the helper)
  # but clipped to width 20. Just check the string starts with "line3".
  var first = lines[0]
  if str_byte_at(first, 0) == 'l' and str_byte_at(first, 4) == '3'
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_view_empty_renders_blank_window(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 5, 2)
  var stripped = ly::strip_styles(vp::viewport_view(v, false))
  # 2 lines of 5 spaces each, joined by \n
  assert_eq_str(stripped, "     \n     ")
end

# ============================================================
# Soft wrap
# ============================================================

def test_soft_wrap_breaks_long_line(): Void
  var v = vp::viewport_with_size(vp::viewport_new(), 5, 4)
  v = vp::viewport_with_soft_wrap(v, true)
  v = vp::viewport_set_content_lines(v, vec_of_one("abcdefghij"))
  var stripped = ly::strip_styles(vp::viewport_view(v, false))
  var lines = str_split(stripped, "\n")
  # First two visible lines should be "abcde" and "fghij"
  assert_eq_str(lines[0], "abcde")
  assert_eq_str(lines[1], "fghij")
end

def vec_of_one(s: String): Vec<String>
  var v = vec_new()
  vec_push(v, s)
  return v
end

# ============================================================
# Set size
# ============================================================

def test_set_size_updates_dims(): Void
  var v = vp::viewport_set_size(vp::viewport_new(), 100, 20)
  assert_eq(v.width, 100)
  assert_eq(v.height, 20)
end

def main(): Int
  describe("content management") do ->
    it("set_content splits on newline") do ->
      test_set_content_splits_on_newline()
    end
    it("set_content empty string yields 0 lines") do ->
      test_set_content_empty_yields_zero_lines()
    end
    it("set_content_lines preserves input") do ->
      test_set_content_lines_preserves_input()
    end
    it("append_line grows count") do ->
      test_append_line_grows_count()
    end
    it("append_lines grows count") do ->
      test_append_lines_grows_count()
    end
    it("clear empties and resets offset") do ->
      test_clear_empties_and_resets_offset()
    end
  end

  describe("follow_tail") do ->
    it("off keeps offset at 0 on append") do ->
      test_follow_tail_off_keeps_offset_at_zero()
    end
    it("on jumps to bottom after append") do ->
      test_follow_tail_on_jumps_to_bottom_after_append()
    end
  end

  describe("scroll commands") do ->
    it("scroll_up clamps at 0") do ->
      test_scroll_up_clamps_at_zero()
    end
    it("scroll_down clamps at max") do ->
      test_scroll_down_clamps_at_max()
    end
    it("page_down advances by height") do ->
      test_page_down_advances_by_height()
    end
    it("page_up retreats by height") do ->
      test_page_up_retreats_by_height()
    end
    it("goto_top resets to 0") do ->
      test_goto_top_resets()
    end
    it("goto_bottom jumps to max") do ->
      test_goto_bottom_jumps_to_max()
    end
    it("ensure_visible scrolls up when target above window") do ->
      test_ensure_visible_above_window()
    end
    it("ensure_visible scrolls down when target below window") do ->
      test_ensure_visible_below_window()
    end
    it("ensure_visible no-op when target in window") do ->
      test_ensure_visible_in_window_no_change()
    end
  end

  describe("accessors") do ->
    it("scroll_percent is 0 at top") do ->
      test_scroll_percent_zero_at_top()
    end
    it("scroll_percent is 100 at bottom") do ->
      test_scroll_percent_100_at_bottom()
    end
    it("scroll_percent is 0 when content fits") do ->
      test_scroll_percent_zero_when_content_fits()
    end
  end

  describe("update") do ->
    it("Up emits Scrolled when not at top") do ->
      test_update_up_emits_scrolled()
    end
    it("Up at top emits Idle") do ->
      test_update_up_at_top_emits_idle()
    end
    it("unknown key emits Idle") do ->
      test_update_unknown_key_is_idle()
    end
    it("Down advances offset") do ->
      test_update_down_advances_offset()
    end
    it("Ctrl-F pages down") do ->
      test_update_ctrl_f_pages_down()
    end
  end

  describe("view") do ->
    it("renders exactly `height` lines") do ->
      test_view_renders_height_lines()
    end
    it("first visible line matches y_offset") do ->
      test_view_first_line_matches_offset()
    end
    it("empty content renders blank window") do ->
      test_view_empty_renders_blank_window()
    end
  end

  describe("soft wrap") do ->
    it("breaks a long line at width boundary") do ->
      test_soft_wrap_breaks_long_line()
    end
  end

  describe("set size") do ->
    it("updates width and height") do ->
      test_set_size_updates_dims()
    end
  end

  return qspec_main()
end
