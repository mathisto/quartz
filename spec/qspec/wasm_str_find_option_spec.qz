## WASM str_find Option<Int> contract
##
## Pre-fix bug:
##   The WASM `_wasm_synth_str_find` body returned the raw byte index (or -1
##   for not-found), but the typecheck registry declares
##   `str_find: TYPE_OPTION`. Callers using the canonical
##   `match opt { Some(v) => ... ; None => ... }` pattern got a raw i64 in
##   their hands, treated it as a heap-box pointer, and read arbitrary memory
##   at that location. For not-found (raw -1) this trapped at 0xffffffff with
##   "memory fault at wasm address 0xffffffff" — out of bounds in linear
##   memory.
##
## Fix: split the synth into a user-level `_wasm_synth_str_find` wrapper
## that calls `option_some(idx)` / `option_none()` to box the result, with
## the search logic moved to a new `__wasm_str_find_raw` helper. Internal
## callers (`str_contains`, `str_replace`, `str_split`) updated to call the
## raw variant directly so their `< 0` / `>= 0` tests still work.
##
## **Prerequisites**: same as wasm_string_interp_spec.qz — wasmtime on PATH
## and a `--feature wasm` compiler at `QUARTZ_COMPILER`.

import * from qspec

extern "C" def getpid(): CInt

var _wsf_tid = 0

def _wsf_compile_and_run(source: String): String
  _wsf_tid += 1
  var pid = getpid()
  var src = "/tmp/_wsf_#{pid}_#{_wsf_tid}.qz"
  var wasm = "/tmp/_wsf_#{pid}_#{_wsf_tid}.wasm"
  var out_path = "/tmp/_wsf_#{pid}_#{_wsf_tid}.out"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return "COMPILE_FAILED"
  end
  var vr = system("wasm-validate #{wasm} 2>/dev/null")
  if vr != 0
    return "VALIDATE_FAILED"
  end
  var rr = system("wasmtime #{wasm} > #{out_path} 2>/dev/null")
  if rr != 0
    return "NO_RUNTIME"
  end
  return read_file(out_path)
end

def _wsf_chomp(s: String): String
  var n = str_byte_len(s)
  return s if n == 0
  var last = str_byte_at(s, n - 1)
  return str_byte_slice(s, 0, n - 1) if last == 10
  return s
end

def main(): Int
  describe("WASM str_find Option<Int> contract") do ->
    it("match Some(v)/None works for found and not-found cases") do ->
      var s = """
        def main(): Int
          var s = \"alice,bob\"
          var opt = s.find(\",\")
          match opt
            Some(v) => puts(\"found at \#{v}\")
            None => puts(\"not found\")
          end
          var opt2 = s.find(\"xyz\")
          match opt2
            Some(v) => puts(\"found at \#{v}\")
            None => puts(\"not found\")
          end
          return 0
        end
        """
      var result = _wsf_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_wsf_chomp(result), "found at 5\nnot found")
      end
    end

    it("unwrap_or extracts the value or returns the default") do ->
      var s = """
        def main(): Int
          var s = \"alice,bob\"
          puts(\"\#{s.find(\",\").unwrap_or(-1)}\")
          puts(\"\#{s.find(\"xyz\").unwrap_or(-1)}\")
          return 0
        end
        """
      var result = _wsf_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_wsf_chomp(result), "5\n-1")
      end
    end

    it("contains() still works (uses internal raw helper)") do ->
      var s = """
        def main(): Int
          var s = \"alice,bob,charlie\"
          puts(\"contains comma=\#{s.contains(\",\")}\")
          puts(\"contains xyz=\#{s.contains(\"xyz\")}\")
          return 0
        end
        """
      var result = _wsf_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_wsf_chomp(result), "contains comma=1\ncontains xyz=0")
      end
    end
  end

  return qspec_main()
end
