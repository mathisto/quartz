## Partial Move Tracking Tests — QZ1216
##
## Contract:
##   1. Field-level tracking: moving `r.x` marks field `x` as moved.
##   2. Moved field access: `r.x` after `consume(r.x)` = QZ1216.
##   3. Whole-struct use after partial move: `use(r)` after `consume(r.x)` = QZ1216.
##   4. Unmoved fields accessible: `r.y` still OK after `r.x` moved.
##   5. Re-init clears partial move: `r.x = new_val` after move clears state.
##   6. Conditional partial moves: move in one branch but not other = QZ1216.
##   7. Let-binding from field = move: `var x = r.x` marks field moved.
##   8. Fn arg from field = move: `identity(r.x)` marks field moved.
##   9. Borrow of partially-moved struct: `&r` after `consume(r.x)` = QZ1216.
##  10. Multiple fields: moving `r.x` then `r.y` tracked independently.
##  11. Re-init ALL fields clears whole-struct partial move.
##  12. Double partial move of same field = QZ1216.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("partial moves: QZ1216") do ->
    it("accessing whole struct after field move reports QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def use_res(r: Res): Int = r.x
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          return use_res(r)
        end
        """, "QZ1216")
    end

    it("accessing moved field reports QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          return r.x
        end
        """, "QZ1216")
    end

    it("partial move in one branch but not other reports QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          if r.y > 0
            consume(r.x)
          end
          return 0
        end
        """, "QZ1216")
    end

    it("let-binding from field marks field as moved") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var r = Res { x: 1, y: 2 }
          var x = r.x
          return r.x
        end
        """, "QZ1216")
    end

    it("passing field as function argument marks it moved") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def identity(v: Int): Int = v
        def main(): Int
          var r = Res { x: 10, y: 20 }
          identity(r.x)
          return r.x
        end
        """, "QZ1216")
    end

    it("re-init field after partial move clears move state") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          r.x = 42
          return r.x
        end
        """)
    end

    it("unmoved fields remain accessible after partial move") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          return r.y
        end
        """)
    end
    it("borrow after partial move = QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def peek(r: &Res): Int = r.x
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          peek(&r)
          return 0
        end
        """, "QZ1216")
    end

    it("multiple fields moved independently") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          consume(r.y)
          return r.x
        end
        """, "QZ1216")
    end

    it("re-init all fields restores whole-struct usability") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def use_res(r: Res): Int = r.x
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          consume(r.y)
          r.x = 10
          r.y = 20
          return r.x + r.y
        end
        """)
    end

    it("partial move in one match arm only = QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          if r.y > 0
            consume(r.x)
          else
            var z = 0
          end
          return 0
        end
        """, "QZ1216")
    end

    it("double partial move of same field = QZ1216") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          consume(r.x)
          return 0
        end
        """, "QZ1216")
    end
  end
  return qspec_main()
end
