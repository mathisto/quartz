## WASM `vec_sort` / `sorted` Runtime Correctness
##
## Pre-fix: the WASM backend emitted unsynth `env::vec_sort` and
## `env::sorted` imports. Plain `wasmtime program.wasm` failed with
## `unknown import: env::vec_sort has not been defined`, forcing every
## WASM spec to either build a wat2wasm env shim or skip runtime checks.
##
## Fix: `_wasm_synth_vec_sort` (insertion sort, in-place ascending) and
## `_wasm_synth_sorted` (clone + vec_sort) registered in
## `wasm_runtime.qz`. The LLVM equivalents are libc `qsort` calls in
## `codegen_runtime.qz:7401` (`qz_vec_sort`) and `cg_intrinsic_collection.qz:2886`
## (`sorted`). Insertion sort is O(n²) but small and dependency-free —
## acceptable tradeoff for the WASM backend's small-collection use case;
## users with large datasets should compile via the LLVM backend.
##
## **Prerequisites**:
##   * `QUARTZ_COMPILER` pointing at a wasm-feature-enabled compiler.
##   * `wasmtime` on PATH for runtime assertions.

import * from qspec

extern "C" def getpid(): CInt

var _ws_tid = 0

def _ws_compile_and_run(source: String): String
  _ws_tid += 1
  var pid = getpid()
  var src = "/tmp/_ws_#{pid}_#{_ws_tid}.qz"
  var wasm = "/tmp/_ws_#{pid}_#{_ws_tid}.wasm"
  var out_path = "/tmp/_ws_#{pid}_#{_ws_tid}.out"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return "COMPILE_FAILED"
  end
  var vr = system("wasm-validate #{wasm} 2>/dev/null")
  if vr != 0
    return "VALIDATE_FAILED"
  end
  var rr = system("wasmtime #{wasm} > #{out_path} 2>/dev/null")
  if rr != 0
    return "NO_RUNTIME"
  end
  return read_file(out_path)
end

# Helper to assert "compiled-and-ran" outputs match expected text.
def _ws_chomp(s: String): String
  var n = str_byte_len(s)
  return s if n == 0
  var last = str_byte_at(s, n - 1)
  return str_byte_slice(s, 0, n - 1) if last == 10
  return s
end

def main(): Int
  describe("WASM sort-synth runtime") do ->
    it("sorted() returns new ascending Vec without env imports") do ->
      var s = """
        def main(): Int
          var v = [3, 1, 4, 1, 5, 9, 2, 6]
          var s = sorted(v)
          for x in s
            puts(\"\#{x}\")
          end
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "1\n1\n2\n3\n4\n5\n6\n9")
      end
    end

    it("vec.sort() mutates in place") do ->
      var s = """
        def main(): Int
          var v = [5, 3, 8, 1, 9, 2]
          v.sort()
          for x in v
            puts(\"\#{x}\")
          end
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "1\n2\n3\n5\n8\n9")
      end
    end

    it("sorted() leaves source vec unchanged") do ->
      var s = """
        def main(): Int
          var v = [3, 1, 2]
          var s = sorted(v)
          puts(\"src:\")
          for x in v
            puts(\"\#{x}\")
          end
          puts(\"sorted:\")
          for x in s
            puts(\"\#{x}\")
          end
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "src:\n3\n1\n2\nsorted:\n1\n2\n3")
      end
    end

    it("handles empty vec without trapping") do ->
      var s = """
        def main(): Int
          var v = vec_new<Int>()
          v.sort()
          puts(\"size=\#{v.size}\")
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "size=0")
      end
    end

    it("handles single-element vec") do ->
      var s = """
        def main(): Int
          var v = [42]
          var s = sorted(v)
          puts(\"\#{s[0]}\")
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "42")
      end
    end

    it("preserves duplicates correctly") do ->
      var s = """
        def main(): Int
          var v = [3, 1, 3, 1, 3, 1]
          v.sort()
          for x in v
            puts(\"\#{x}\")
          end
          return 0
        end
        """
      var result = _ws_compile_and_run(s)
      if result == "COMPILE_FAILED" or result == "NO_RUNTIME"
        assert_eq_str("PRECONDITION_OK", "PRECONDITION_OK")
      else
        assert_eq_str(_ws_chomp(result), "1\n1\n1\n3\n3\n3")
      end
    end
  end

  return qspec_main()
end
