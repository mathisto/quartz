## Usize Type Alias Tests
##
## Contract:
##   1. Param: `usize` as function parameter type.
##   2. Return: `usize` as function return type.
##   3. Annotation: `var x: usize` type annotation.
##   4. Interchangeable: usize and Int assignable to each other.
##   5. Arithmetic: `+` on usize values.
##   6. Loop: usize in for-loop bound.
##   7. Comparison: usize in `==` comparison.
##   8. Vec size: vec .size returns usize-compatible value.
import * from qspec

def main(): Int
  describe("usize type alias") do ->
    it("usize as parameter type") do ->
      assert_eq(usize_add_one(41), 42)
    end

    it("usize as return type") do ->
      assert_eq(usize_get_size(), 42)
    end

    it("usize as variable annotation") do ->
      assert_eq(usize_var_annotation(), 42)
    end

    it("interchangeable with Int") do ->
      assert_eq(usize_interchangeable(), 42)
    end

    it("arithmetic on usize") do ->
      var x: usize = 20
      var y: usize = 22
      assert_eq(x + y, 42)
    end

    it("usize in loop bound") do ->
      var n: usize = 5
      var sum = 0
      for i in 0..n
        sum += i
      end
      assert_eq(sum, 10)
    end

    it("usize in equality comparison") do ->
      var a: usize = 42
      var b: usize = 42
      assert_eq(a == b, true)
    end

    it("vec size as usize-compatible value") do ->
      var v = [1, 2, 3]
      var len: usize = v.size
      assert_eq(len, 3)
    end
  end

  return qspec_main()
end

def usize_add_one(x: usize): Int
  return x + 1
end

def usize_get_size(): usize
  return 42
end

def usize_var_annotation(): Int
  var x: usize = 10
  x = x + 32
  return x
end

def usize_takes_int(x: Int): Int
  return x
end

def usize_takes_usize(x: usize): usize
  return x
end

def usize_interchangeable(): Int
  var a: usize = 21
  var b: Int = 21
  return usize_takes_int(a) + usize_takes_usize(b)
end
