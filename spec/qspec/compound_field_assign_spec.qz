## Compound Field and Index Assignment Tests
##
## Contract:
##   1. Struct field: `s.field = s.field op value` for +, -, *, /, %.
##   2. Array index: `a[i] = a[i] op value` for +, -, *, /, %, bxor.
##   3. Regression: identifier compound assign still works.
##   4. Expression RHS: compound with complex rhs expressions.
import * from qspec

struct CFCounter
  count: Int
end

struct CFPoint
  x: Int
  y: Int
end

def main(): Int
  describe("struct field compound assignment") do ->
    it("+= on struct field") do ->
      var s = CFCounter { count: 0 }
      s.count = s.count + 5
      assert_eq(s.count, 5)
    end

    it("-= on struct field") do ->
      var s = CFCounter { count: 10 }
      s.count = s.count - 3
      assert_eq(s.count, 7)
    end

    it("*= on struct field") do ->
      var s = CFCounter { count: 6 }
      s.count = s.count * 7
      assert_eq(s.count, 42)
    end

    it("/= on struct field") do ->
      var s = CFCounter { count: 84 }
      s.count = s.count / 2
      assert_eq(s.count, 42)
    end

    it("%= on struct field") do ->
      var s = CFCounter { count: 47 }
      s.count = s.count % 10
      assert_eq(s.count, 7)
    end
  end

  describe("array index compound assignment") do ->
    it("+= on array element") do ->
      var a = [10, 20, 30]
      a[0] = a[0] + 5
      assert_eq(a[0], 15)
    end

    it("-= on array element") do ->
      var a = [10, 20, 30]
      a[1] = a[1] - 3
      assert_eq(a[1], 17)
    end

    it("*= on array element") do ->
      var a = [6, 0, 0]
      a[0] = a[0] * 7
      assert_eq(a[0], 42)
    end

    it("/= on array element") do ->
      var a = [84, 0, 0]
      a[0] = a[0] / 2
      assert_eq(a[0], 42)
    end

    it("%= on array element") do ->
      var a = [47, 0, 0]
      a[0] = a[0] % 10
      assert_eq(a[0], 7)
    end

    it("bxor on array element") do ->
      var a = [255, 0, 0]
      a[0] = bxor(a[0], 213)
      assert_eq(a[0], 42)
    end
  end

  describe("regression") do ->
    it("identifier compound assign still works") do ->
      var x = 30
      x = x + 12
      assert_eq(x, 42)
    end

    it("compound on field with expression rhs") do ->
      var p = CFPoint { x: 10, y: 20 }
      p.x = p.x + p.y + 12
      assert_eq(p.x, 42)
    end

    it("compound on indexed with expression rhs") do ->
      var a = [10, 20, 30]
      a[0] = a[0] + a[1] + 12
      assert_eq(a[0], 42)
    end
  end

  return qspec_main()
end
