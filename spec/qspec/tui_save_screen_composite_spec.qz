## v0.3.2 Step 6 — Composite save-screen integration spec.
##
## Validates that TextInput + List + FocusRing compose correctly:
##   - Focus rotation via Tab moves between named children
##   - Each child's update is routable based on focus_ring_current
##   - Keys dispatched to a non-focused widget are no-ops
##
## This spec deliberately stays at the focus + routing layer; the
## per-widget specs (tui_focus_ring_spec, tui_text_input_spec,
## tui_list_spec) cover the widgets themselves.

import * from qspec
import * from std/traits
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/focus as fr
import std/tui/widgets/text_input as ti
import std/tui/widgets/list as ls

enum SF
  NameInput
  SaveList
end

extend SF with Eq
  def op_eq(self, other: Self): Bool
    match self
      NameInput => return other is NameInput
      SaveList  => return other is SaveList
    end
  end
end

enum SpecMsg
  Noop
end

def show(s: String): String = s

def make_ring()
  var ids = vec_new<SF>()
  vec_push(ids, SF::NameInput)
  vec_push(ids, SF::SaveList)
  return fr::focus_ring_with_initial(ids, SF::NameInput)
end

# ============================================================
# Focus rotation
# ============================================================

def test_initial_focus_is_first(): Void
  var r = make_ring()
  match fr::focus_ring_current(r)
    Some(id) =>
      if id is NameInput
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    None => assert_eq(0, 1)
  end
end

def test_tab_advances_to_second(): Void
  var r = fr::focus_ring_next(make_ring())
  match fr::focus_ring_current(r)
    Some(id) =>
      if id is SaveList
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    None => assert_eq(0, 1)
  end
end

def test_tab_wraps_back_to_first(): Void
  var r = fr::focus_ring_next(fr::focus_ring_next(make_ring()))
  match fr::focus_ring_current(r)
    Some(id) =>
      if id is NameInput
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    None => assert_eq(0, 1)
  end
end

# ============================================================
# Conditional dispatch — TextInput receives keys only when focused
# ============================================================

def test_text_input_typing_drives_value(): Void
  # Focus is on NameInput by default. Feed a printable char.
  var t = ti::text_input_new()
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: 'x', modifiers: 0 })
  var triple = ti::text_input_update(t, msg)
  var next = triple.0
  assert_eq_str(ti::text_input_value(next), "x")
end

# ============================================================
# Conditional dispatch — List receives keys when focus rotates
# ============================================================

def make_list()
  var items = vec_new<String>()
  vec_push(items, "a")
  vec_push(items, "b")
  vec_push(items, "c")
  return ls::list_new(items, ls::item_delegate_simple(show))
end

def test_list_down_advances_selection(): Void
  var l = make_list()
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_DOWN(), modifiers: 0 })
  var triple = ls::list_update(l, msg)
  var next = triple.0
  match ls::list_selected_index(next)
    Some(idx) => assert_eq(idx, 1)
    None      => assert_eq(0, 1)
  end
end

def test_list_enter_emits_selected(): Void
  var l = make_list()
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_ENTER(), modifiers: 0 })
  var triple = ls::list_update(l, msg)
  var ev = triple.2
  match ev
    Selected(item) => assert_eq_str(as_string(item), "a")
    _ => assert_eq(0, 1)
  end
end

# ============================================================
# Cross-widget integration: List Selected event prefills TextInput
# ============================================================

def test_selected_item_can_prefill_text_input(): Void
  var l = make_list()
  var t = ti::text_input_new()
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_ENTER(), modifiers: 0 })
  var triple = ls::list_update(l, msg)
  var ev = triple.2
  match ev
    Selected(item) =>
      var prefilled = ti::text_input_set_value_unchecked(t, as_string(item))
      assert_eq_str(ti::text_input_value(prefilled), "a")
    _ => assert_eq(0, 1)
  end
end

# ============================================================
# is_focused gating
# ============================================================

def test_is_focused_gates_view_state(): Void
  var r = make_ring()
  # NameInput is focused initially
  if fr::focus_ring_is_focused(r, SF::NameInput)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  # SaveList is NOT
  if fr::focus_ring_is_focused(r, SF::SaveList)
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_after_tab_focused_swaps(): Void
  var r = fr::focus_ring_next(make_ring())
  if fr::focus_ring_is_focused(r, SF::SaveList)
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if fr::focus_ring_is_focused(r, SF::NameInput)
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def main(): Int
  describe("focus rotation") do ->
    it("initial focus is first id") do ->
      test_initial_focus_is_first()
    end
    it("Tab advances to second") do ->
      test_tab_advances_to_second()
    end
    it("second Tab wraps to first") do ->
      test_tab_wraps_back_to_first()
    end
  end

  describe("text input dispatch") do ->
    it("typing drives value") do ->
      test_text_input_typing_drives_value()
    end
  end

  describe("list dispatch") do ->
    it("Down advances selection") do ->
      test_list_down_advances_selection()
    end
    it("Enter emits Selected event") do ->
      test_list_enter_emits_selected()
    end
  end

  describe("cross-widget integration") do ->
    it("List Selected event payload prefills TextInput") do ->
      test_selected_item_can_prefill_text_input()
    end
  end

  describe("is_focused gating") do ->
    it("focused id gates view state correctly") do ->
      test_is_focused_gates_view_state()
    end
    it("after Tab the focused id swaps") do ->
      test_after_tab_focused_swaps()
    end
  end

  return qspec_main()
end
