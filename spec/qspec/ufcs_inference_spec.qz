## UFCS Type Inference Tests
## Verifies that .size, .push(), and other UFCS methods work on variables
## whose compile-time type is TYPE_INT but hold Vec/String/Map at runtime.
##
## Contract:
##   1. Local Vec: `.size` and `.push()` work on local Vec<Int>.
##   2. Global Vec: `.size` and `.push()` work on module-level Vec.
##   3. Global String: `.size` works on module-level String.
##   4. Indexed: `.size` on `arr[0]` for Vec<String> element.
##   5. Param Vec: `.size` and `.push()` on typed Vec<Int> param.
##   6. Param String: `.size` on String param.
##   7. Struct field: `.size` on struct Vec<Int> field.
##   8. List comp: `.size` on list-comprehension result.
##   9. Array literal: `.size` on `[...]` literal.
##  10. Local string: `.size` on local string variable.

import * from qspec

## Module-level globals for Context 1 tests
var g_vec = vec_new()
var g_str = "hello"
var g_map = map_new()

def main(): Int
  describe("UFCS inference on local variables") do ->
    it("local Vec .size and .push() work") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      assert_eq(v.size, 2)
      assert_eq(v[0], 10)
    end
  end

  describe("UFCS on globals and indexed expressions") do ->
    it("global Vec .size and .push() work") do ->
      g_vec.push(100)
      g_vec.push(200)
      assert_eq(g_vec.size, 2)
    end

    it("global String .size works") do ->
      assert_eq(g_str.size, 5)
    end

    it(".size on indexed Vec<String> element") do ->
      var arr = vec_new<String>()
      arr.push("abc")
      arr.push("defgh")
      assert_eq(arr[0].size, 3)
      assert_eq(arr[1].size, 5)
    end
  end

  describe("UFCS on params, struct fields, and inferred types") do ->
    it(".size and .push on typed Vec<Int> param") do ->
      assert_eq(_param_vec_size_test(), 3)
      assert_eq(_param_vec_push_test(), 42)
    end

    it(".size on String param and struct Vec field") do ->
      assert_eq(_param_str_size_test(), 5)
      assert_eq(_struct_field_size_test(), 2)
    end

    it(".size on list comp and array literal") do ->
      assert_eq(_list_comp_size_test(), 5)
      assert_eq(_array_literal_size_test(), 4)
    end

    it(".size on local string variable") do ->
      var s = "quartz"
      assert_eq(s.size, 6)
    end
  end

  return qspec_main()
end

## --- Helper functions ---

def _param_vec_size_test(): Int
  var v = vec_new()
  v.push(1)
  v.push(2)
  v.push(3)
  return _take_vec_size(v)
end

def _take_vec_size(items: Vec<Int>): Int
  return items.size
end

def _param_vec_push_test(): Int
  var v = vec_new()
  _push_to_vec(v, 42)
  return v[0]
end

def _push_to_vec(items: Vec<Int>, val: Int): Void
  items.push(val)
end

def _param_str_size_test(): Int
  return _take_str_size("hello")
end

def _take_str_size(s: String): Int
  return s.size
end

struct _VecHolder
  data: Vec<Int>
end

def _struct_field_size_test(): Int
  var h = _VecHolder { data: vec_new() }
  h.data.push(10)
  h.data.push(20)
  return h.data.size
end

def _list_comp_size_test(): Int
  var src = [1, 2, 3, 4, 5]
  var items = [x * 2 for x in src]
  return items.size
end

def _array_literal_size_test(): Int
  var arr = [10, 20, 30, 40]
  return arr.size
end
