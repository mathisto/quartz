## Collection Operations Tests
##
## Contract: reversed, sorted, unique, flatten produce correct results.

import * from qspec

def is_even(x: Int): Bool = x % 2 == 0

def main(): Int
  describe("reversed(v)") do ->
    it("reverses element order") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var r = reversed(v)
      assert_eq(r.size, 3)
      assert_eq(r[0], 3)
      assert_eq(r[1], 2)
      assert_eq(r[2], 1)
    end

    it("reversed of empty is empty") do ->
      var v = vec_new<Int>()
      var r = reversed(v)
      assert_eq(r.size, 0)
    end

    it("reversed of single element") do ->
      var v = vec_new<Int>()
      v.push(42)
      var r = reversed(v)
      assert_eq(r.size, 1)
      assert_eq(r[0], 42)
    end

    it("does not modify original") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      reversed(v)
      assert_eq(v[0], 1)
    end
  end

  describe("sorted(v)") do ->
    it("returns sorted copy") do ->
      var v = vec_new<Int>()
      v.push(3)
      v.push(1)
      v.push(2)
      var s = sorted(v)
      assert_eq(s.size, 3)
      assert_eq(s[0], 1)
      assert_eq(s[1], 2)
      assert_eq(s[2], 3)
    end

    it("does not modify original") do ->
      var v = vec_new<Int>()
      v.push(3)
      v.push(1)
      sorted(v)
      assert_eq(v[0], 3)
    end

    it("sorted of empty is empty") do ->
      var v = vec_new<Int>()
      var s = sorted(v)
      assert_eq(s.size, 0)
    end
  end

  describe("unique(v)") do ->
    it("removes all duplicates") do ->
      var v = vec_new<Int>()
      v.push(3)
      v.push(1)
      v.push(2)
      v.push(1)
      v.push(3)
      var u = unique(v)
      assert_eq(u.size, 3)
    end

    it("unique of unique is same size") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var u = unique(v)
      assert_eq(u.size, 3)
    end

    it("unique of empty is empty") do ->
      var v = vec_new<Int>()
      var u = unique(v)
      assert_eq(u.size, 0)
    end

    it("unique of single element") do ->
      var v = vec_new<Int>()
      v.push(42)
      var u = unique(v)
      assert_eq(u.size, 1)
    end

    it("unique result is sorted") do ->
      var v = vec_new<Int>()
      v.push(5)
      v.push(1)
      v.push(3)
      v.push(1)
      v.push(5)
      var u = unique(v)
      assert_eq(u[0], 1)
      assert_eq(u[1], 3)
      assert_eq(u[2], 5)
    end
  end

  describe("flatten(v)") do ->
    it("flattens nested vecs") do ->
      var outer = vec_new()
      var inner1 = vec_new<Int>()
      inner1.push(1)
      inner1.push(2)
      var inner2 = vec_new<Int>()
      inner2.push(3)
      inner2.push(4)
      outer.push(as_int(inner1))
      outer.push(as_int(inner2))
      var flat = flatten(outer)
      assert_eq(flat.size, 4)
      assert_eq(flat[0], 1)
      assert_eq(flat[1], 2)
      assert_eq(flat[2], 3)
      assert_eq(flat[3], 4)
    end

    it("flatten with empty inner vec") do ->
      var outer = vec_new()
      var inner1 = vec_new<Int>()
      inner1.push(1)
      var inner2 = vec_new<Int>()
      var inner3 = vec_new<Int>()
      inner3.push(2)
      outer.push(as_int(inner1))
      outer.push(as_int(inner2))
      outer.push(as_int(inner3))
      var flat = flatten(outer)
      assert_eq(flat.size, 2)
      assert_eq(flat[0], 1)
      assert_eq(flat[1], 2)
    end

    it("flatten empty outer") do ->
      var outer = vec_new()
      var flat = flatten(outer)
      assert_eq(flat.size, 0)
    end
  end

  describe("enumerate(v)") do ->
    it("returns [index, value] pairs") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      v.push(30)
      var pairs = enumerate(v)
      assert_eq(pairs.size, 3)
      var first_pair = pairs[0]
      assert_eq(first_pair[0], 0)
      assert_eq(first_pair[1], 10)
      var last_pair = pairs[2]
      assert_eq(last_pair[0], 2)
      assert_eq(last_pair[1], 30)
    end

    it("enumerate empty vec") do ->
      var v = vec_new<Int>()
      var pairs = enumerate(v)
      assert_eq(pairs.size, 0)
    end
  end

  describe("zip(v1, v2)") do ->
    it("pairs elements from two vecs") do ->
      var a = vec_new<Int>()
      a.push(1)
      a.push(2)
      a.push(3)
      var b = vec_new<Int>()
      b.push(10)
      b.push(20)
      b.push(30)
      var zipped = zip(a, b)
      assert_eq(zipped.size, 3)
      var zip_first = zipped[0]
      assert_eq(zip_first[0], 1)
      assert_eq(zip_first[1], 10)
    end

    it("stops at shortest") do ->
      var a = vec_new<Int>()
      a.push(1)
      a.push(2)
      var b = vec_new<Int>()
      b.push(10)
      b.push(20)
      b.push(30)
      b.push(40)
      var zipped = zip(a, b)
      assert_eq(zipped.size, 2)
    end
  end

  describe("partition(v, pred)") do ->
    it("splits into matching and non-matching") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      var parts = partition(v, is_even)
      var matching = parts[0]
      var non_matching = parts[1]
      assert_eq(matching.size, 2)
      assert_eq(non_matching.size, 2)
      assert_eq(matching[0], 2)
      assert_eq(matching[1], 4)
    end
  end

  describe("group_by") do ->
    it("groups elements by key function") do ->
      var v = [10, 21, 30, 41, 50]
      var groups = group_by(v, (x: Int) -> x % 2)
      var evens: Vec<Int> = groups.get(0).unwrap()
      var odds: Vec<Int> = groups.get(1).unwrap()
      assert_eq(evens.size, 3)
      assert_eq(odds.size, 2)
    end
  end

  return qspec_main()
end
