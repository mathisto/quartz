## Minus Operator Tests
##
## Contract:
##   1. Unary minus.
##   2. Binary minus.
##   3. Precedence.
##   4. Binary + unary interactions.
##   5. Return value patterns.
##   6. Negation in conditionals.
import * from qspec

def main(): Int
  describe("unary minus") do ->
    it("double negates literal back to positive") do ->
      assert_eq(-(-42), 42)
    end
    it("uses negative literal in arithmetic") do ->
      assert_eq(50 + -8, 42)
    end
    it("negates a variable") do ->
      assert_output("-42\n", mo_print_neg_42)
    end
    it("double negates variable back to original") do ->
      x = 42
      assert_eq(-(-x), 42)
    end
    it("assigns negated variable to new binding") do ->
      x = 42
      y = -x
      assert_eq(-y, 42)
    end
    it("negates variable that is already negative") do ->
      x = -10
      assert_eq(-x, 10)
    end
  end

  describe("binary minus") do ->
    it("subtracts two literals") do ->
      assert_eq(50 - 8, 42)
    end
    it("subtracts two variables") do ->
      a = 50
      b = 8
      assert_eq(a - b, 42)
    end
    it("is left-associative") do ->
      assert_eq(10 - 3 - 2, 5)
    end
    it("chains multiple subtractions") do ->
      assert_eq(100 - 20 - 18 - 10 - 10, 42)
    end
  end

  describe("precedence") do ->
    it("-x + y: unary binds tighter than addition") do ->
      x = 2
      assert_eq(-x + 3, 1)
    end
    it("-x + y with larger values") do ->
      x = 10
      y = 52
      assert_eq(-x + y, 42)
    end
    it("parentheses override precedence") do ->
      x = 10
      y = 20
      a = -(x + y)
      b = -x + y
      assert_eq(a, -30)
      assert_eq(b, 10)
    end
  end

  describe("binary + unary interactions") do ->
    it("a - -b") do ->
      a = 40
      b = 2
      assert_eq(a - -b, 42)
    end
    it("a + -b") do ->
      a = 50
      b = 8
      assert_eq(a + -b, 42)
    end
    it("-a * -b") do ->
      a = 6
      b = 7
      assert_eq(-a * -b, 42)
    end
  end

  describe("return value patterns") do ->
    it("return -x directly") do ->
      x = -42
      assert_eq(-x, 42)
    end
    it("deeply nested negation: 8 levels") do ->
      x = 42
      assert_eq(-(-(-(-(-(-(-(-x))))))), 42)
    end
    it("0-x equivalence") do ->
      x = 42
      a = -x
      b = -x
      assert_eq(a, b)
    end
  end

  describe("negation in conditionals") do ->
    it("negated variable in if condition") do ->
      x = -5
      if -x > 0
        assert_eq(42, 42)
      else
        assert_eq(0, 1)
      end
    end
    it("comparison with negated expression") do ->
      a = 5
      b = 3
      if -a < -b
        assert_eq(42, 42)
      else
        assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end
def mo_print_neg_42(): Void
  x = 42
  print_int(-x)
end
