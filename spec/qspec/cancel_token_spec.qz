## Cancel Token Tests — Cooperative Cancellation
## Covers: token lifecycle, check-and-bail pattern, task_group integration,
## cross-thread sharing, cleanup with defer, edge cases.
##
## Contract:
##   1. Token lifecycle.
##   2. Check-and-bail pattern.
##   3. Task group cancellation.
##   4. Cross-thread token sharing.
##   5. Cancellation + cleanup.
##   6. Edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category 1: Token Lifecycle
  # ===========================================================================
  describe("token lifecycle") do ->
    it("create token starts uncancelled") do ->
      assert_run_exits(ct_create_uncancelled_src(), 0)
    end

    it("cancel sets cancelled state") do ->
      assert_run_exits(ct_cancel_sets_state_src(), 42)
    end

    it("double-cancel is idempotent") do ->
      assert_run_exits(ct_double_cancel_src(), 0)
    end

    it("free token does not crash") do ->
      assert_run_exits(ct_free_no_crash_src(), 0)
    end
  end

  # ===========================================================================
  # Category 2: Check-and-Bail Pattern
  # ===========================================================================
  describe("check-and-bail pattern") do ->
    it("loop bails early on cancellation") do ->
      assert_run_exits(ct_bail_early_src(), 5)
    end

    it("pre-cancelled token skips loop entirely") do ->
      assert_run_exits(ct_pre_cancelled_skip_src(), 0)
    end

    it("uncancelled token runs to completion") do ->
      assert_run_exits(ct_full_loop_src(), 10)
    end
  end

  # ===========================================================================
  # Category 3: Task Group Cancellation
  # ===========================================================================
  describe("task group cancellation") do ->
    it("taskgroup_cancel makes is_cancelled return 1") do ->
      assert_run_exits(ct_tg_cancel_src(), 0)
    end

    it("is_cancelled returns 0 in non-cancelled group") do ->
      assert_run_exits(ct_tg_no_cancel_src(), 0)
    end

    it("is_cancelled returns 0 after task_group exits") do ->
      assert_run_exits(ct_tg_after_exit_src(), 0)
    end

    it("g.cancel() UFCS syntax works") do ->
      assert_run_exits(ct_tg_ufcs_cancel_src(), 0)
    end
  end

  # ===========================================================================
  # Category 4: Cross-Thread Token Sharing
  # ===========================================================================
  describe("cross-thread token sharing") do ->
    it("main cancels token, spawned thread observes") do ->
      assert_run_exits(ct_main_cancels_src(), 42)
    end

    it("spawned thread cancels, main observes") do ->
      assert_run_exits(ct_thread_cancels_src(), 42)
    end

    it("multiple threads share same token") do ->
      assert_run_exits(ct_multi_thread_src(), 0)
    end
  end

  # ===========================================================================
  # Category 5: Cancellation + Cleanup
  # ===========================================================================
  describe("cancellation + cleanup") do ->
    it("defer runs when function bails on cancellation") do ->
      assert_run_exits(ct_defer_on_bail_src(), 0)
    end

    it("task with defer and is_cancelled runs cleanup") do ->
      assert_run_exits(ct_task_defer_cancel_src(), 0)
    end
  end

  # ===========================================================================
  # Category 6: Edge Cases
  # ===========================================================================
  describe("edge cases") do ->
    it("token never cancelled completes normally") do ->
      assert_run_exits(ct_never_cancelled_src(), 0)
    end

    it("multiple independent tokens") do ->
      assert_run_exits(ct_independent_tokens_src(), 0)
    end
  end

  return qspec_main()
end

## =============================================================================
## Source string helpers
## Named helpers used for subprocess source generation (heredoc scope, not #{} limitation).
## =============================================================================

# --- Category 1: Token Lifecycle ---

def ct_create_uncancelled_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      if cancel_token_is_cancelled(tok)
        return 1
      end
      return 0
    end
    """
end

def ct_cancel_sets_state_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      cancel_token_cancel(tok)
      if cancel_token_is_cancelled(tok)
        return 42
      end
      return 0
    end
    """
end

def ct_double_cancel_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      cancel_token_cancel(tok)
      cancel_token_cancel(tok)
      if cancel_token_is_cancelled(tok)
        return 0
      end
      return 1
    end
    """
end

def ct_free_no_crash_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      cancel_token_free(tok)
      return 0
    end
    """
end

# --- Category 2: Check-and-Bail Pattern ---

def ct_bail_early_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      var sum = 0
      var i = 0
      while i < 10
        if cancel_token_is_cancelled(tok)
          return sum
        end
        sum = sum + 1
        i = i + 1
        if i == 5
          cancel_token_cancel(tok)
        end
      end
      return sum
    end
    """
end

def ct_pre_cancelled_skip_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      cancel_token_cancel(tok)
      var count = 0
      var i = 0
      while i < 10
        if cancel_token_is_cancelled(tok)
          return count
        end
        count += 1
        i = i + 1
      end
      return count
    end
    """
end

def ct_full_loop_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      var sum = 0
      var i = 0
      while i < 10
        if cancel_token_is_cancelled(tok)
          return sum
        end
        sum = sum + 1
        i = i + 1
      end
      cancel_token_free(tok)
      return sum
    end
    """
end

# --- Category 3: Task Group Cancellation ---

def ct_tg_cancel_src(): String
  return """
    def check_and_store(flag: Int): Int
      var c = is_cancelled()
      atomic_add(flag, c)
      return 0
    end
    def main(): Int
      var flag = atomic_new(0)
      task_group |g|
        taskgroup_cancel(g)
        taskgroup_spawn(g, -> check_and_store(flag))
      end
      var val = atomic_load(flag)
      if val == 1
        return 0
      end
      return 1
    end
    """
end

def ct_tg_no_cancel_src(): String
  return """
    def check_cancelled(): Int = is_cancelled()
    def main(): Int
      var result = 0
      task_group |g|
        taskgroup_spawn(g, -> check_cancelled())
        var results = taskgroup_collect(g)
        result = results[0]
      end
      if result == 0
        return 0
      end
      return 1
    end
    """
end

def ct_tg_after_exit_src(): String
  return """
    def worker(): Int = 1
    def main(): Int
      task_group |g|
        taskgroup_spawn(g, -> worker())
      end
      return is_cancelled()
    end
    """
end

def ct_tg_ufcs_cancel_src(): String
  return """
    def check_and_store(flag: Int): Int
      var c = is_cancelled()
      atomic_add(flag, c)
      return 0
    end
    def main(): Int
      var flag = atomic_new(0)
      task_group |g|
        g.cancel()
        taskgroup_spawn(g, -> check_and_store(flag))
      end
      var val = atomic_load(flag)
      if val == 1
        return 0
      end
      return 1
    end
    """
end

# --- Category 4: Cross-Thread Token Sharing ---

def ct_main_cancels_src(): String
  return """
    def poll_token(tok: Int): Int
      var i = 0
      while i < 100000
        if cancel_token_is_cancelled(tok)
          return 42
        end
        i = i + 1
      end
      return 0
    end
    def main(): Int
      var tok = cancel_token_new()
      var h = go (-> poll_token(tok))
      cancel_token_cancel(tok)
      return await h
    end
    """
end

def ct_thread_cancels_src(): String
  return """
    def cancel_it(tok: Int): Int
      cancel_token_cancel(tok)
      return 0
    end
    def main(): Int
      var tok = cancel_token_new()
      var h = go (-> cancel_it(tok))
      var dummy = await h
      if cancel_token_is_cancelled(tok)
        return 42
      end
      return 0
    end
    """
end

def ct_multi_thread_src(): String
  return """
    def poll_token(tok: Int): Int
      var i = 0
      while i < 100000
        if cancel_token_is_cancelled(tok)
          return 1
        end
        i = i + 1
      end
      return 0
    end
    def main(): Int
      var tok = cancel_token_new()
      var h1 = go (-> poll_token(tok))
      var h2 = go (-> poll_token(tok))
      cancel_token_cancel(tok)
      var r1 = await h1
      var r2 = await h2
      if r1 == 1 and r2 == 1
        return 0
      end
      return 1
    end
    """
end

# --- Category 5: Cancellation + Cleanup ---

def ct_defer_on_bail_src(): String
  return """
    def work(tok: Int, counter: Int): Int
      defer atomic_add(counter, 100)
      var i = 0
      while i < 10
        if cancel_token_is_cancelled(tok)
          return i
        end
        i = i + 1
      end
      return i
    end
    def main(): Int
      var tok = cancel_token_new()
      var counter = atomic_new(0)
      cancel_token_cancel(tok)
      var result = work(tok, counter)
      var cleanup = atomic_load(counter)
      if result == 0 and cleanup == 100
        return 0
      end
      return 1
    end
    """
end

def ct_task_defer_cancel_src(): String
  return """
    def worker(flag: Int): Int
      defer atomic_add(flag, 1)
      if is_cancelled()
        return 1
      end
      return 0
    end
    def main(): Int
      var flag = atomic_new(0)
      task_group |g|
        taskgroup_cancel(g)
        taskgroup_spawn(g, -> worker(flag))
      end
      var val = atomic_load(flag)
      if val == 1
        return 0
      end
      return 1
    end
    """
end

# --- Category 6: Edge Cases ---

def ct_never_cancelled_src(): String
  return """
    def main(): Int
      var tok = cancel_token_new()
      var sum = 0
      var i = 0
      while i < 5
        sum = sum + 1
        i = i + 1
      end
      cancel_token_free(tok)
      if sum == 5
        return 0
      end
      return 1
    end
    """
end

def ct_independent_tokens_src(): String
  return """
    def main(): Int
      var tok1 = cancel_token_new()
      var tok2 = cancel_token_new()
      cancel_token_cancel(tok1)
      if not cancel_token_is_cancelled(tok1)
        return 1
      end
      if cancel_token_is_cancelled(tok2)
        return 2
      end
      cancel_token_free(tok1)
      cancel_token_free(tok2)
      return 0
    end
    """
end
