## NLL Liveness Analysis Tests
##
## Contract:
##   1. Last-use release: borrow released at last use (not scope end).
##   2. Still-active blocks mutation: borrow used AFTER mutation = QZ1209.
##   3. Unused borrows block: scope-based fallback.
##   4. Multiple borrows: each tracked independently.
##   5. Branch release: borrow used in if/else only → released after.
##   6. Loop release: borrow in loop body → released after loop.
##   7. Function call as last use.
##   8. While condition: borrow in condition → released after loop.
##   9. Match arm: borrow in match → released after match.
##  10. Ephemeral borrow: call-site `&x` released immediately.
##  11. Re-borrow after release: new borrow OK after NLL release.
##  12. Loop-created borrow: doesn't persist after loop.
##  13. Cross-fn return-borrow: QZ1210.
##  14. Nested loop isolation: inner borrow doesn't leak.
##  15. Branch scoping: borrows in branches released at end-of-if.
##  16. Multiple return paths: early return with borrow = QZ1210.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("NLL: basic last-use tracking") do ->
    it("borrow released at last use allows mutation") do ->
      # The core NLL scenario: borrow's last use is before mutation
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var y = r + 1
          x = 99
          return x
        end
        """, 99)
    end

    it("borrow still active at mutation causes error") do ->
      # r is used AFTER the mutation attempt — still an error
      assert_compile_error("""
        def main(): Int
          var x = 42
          var r = &x
          x = 99
          var y = r + 1
          return y
        end
        """, "QZ1209")
    end

    it("unused borrow blocks mutation (scope-based)") do ->
      # Unused borrows still hold until scope exit — NLL only releases at LAST USE
      assert_compile_error("""
        def main(): Int
          var x = 42
          p = &x
          x = 99
          return 0
        end
        """, "QZ1209")
    end
  end

  describe("NLL: multiple borrows") do ->
    it("two borrows with different last uses") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var y = 10
          var rx = &x
          var ry = &y
          var a = rx + 1
          var b = ry + 1
          x = 99
          y = 88
          return x + y
        end
        """, 187)
    end
  end

  describe("NLL: if/else branches") do ->
    it("borrow used only in then-branch releases after if") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          if true
            var a = r + 1
          end
          x = 99
          return x
        end
        """, 99)
    end

    it("borrow used in else-branch releases after if") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          if false
            var a = 0
          else
            var a = r + 1
          end
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: loops (conservative)") do ->
    it("borrow used in loop body — mutation after loop OK") do ->
      # With the double-walk approach, r's last use is inside the loop body.
      # After the loop, r is no longer used, so borrow is released.
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var i = 0
          while i < 1
            var a = r + 1
            i += 1
          end
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: function call as last use") do ->
    it("borrow passed to function is last use") do ->
      assert_run_exits("""
        def use_ref(r: Int): Int = r + 1
        def main(): Int
          var x = 42
          var r = &x
          var y = use_ref(r)
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: borrow in while condition") do ->
    it("borrow used only in while condition — mutation after loop OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var i = 0
          while r > 0 and i < 1
            i += 1
          end
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: match arms") do ->
    it("borrow used in match arm — mutation after match OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var result = match true
            true => r + 1
            _ => 0
          end
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: ephemeral borrow regression") do ->
    it("ephemeral borrow in function call — mutation after call OK") do ->
      assert_run_exits("""
        def peek(r: Int): Int = 0
        def main(): Int
          var x = 42
          peek(&x)
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("NLL: re-borrow after release") do ->
    it("can re-borrow after previous borrow expires") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var y = r + 1
          x = 99
          var r2 = &x
          return r2 + 0
        end
        """, 99)
    end
  end

  describe("NLL: loop-carried borrow validation") do ->
    it("borrow created in loop body does not persist after loop") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var i = 0
          while i < 3
            var r = &x
            var y = r + 1
            i += 1
          end
          x = 99
          return x
        end
        """, 99)
    end

    it("borrow of outer variable inside loop — mutation after loop OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var i = 0
          while i < 1
            var r = &x
            i += 1
          end
          x = 99
          return x
        end
        """, 99)
    end

    it("borrow created before loop stays alive through loop") do ->
      ## Borrow created BEFORE loop, used AFTER — stays alive (conservative)
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          var i = 0
          while i < 1
            i += 1
          end
          var y = r + 1
          return y
        end
        """, 43)
    end
  end

  describe("NLL: cross-function borrow return (QZ1210)") do ->
    it("return binding holding borrow of local — QZ1210") do ->
      assert_compile_error("""
        def bad(): Int
          var x = 42
          var r = &x
          return r
        end
        def main(): Int
          return 0
        end
        """, "QZ1210")
    end

    it("return binding with no borrow — OK") do ->
      assert_run_exits("""
        def good(): Int
          var x = 42
          var r = x + 1
          return r
        end
        def main(): Int
          return good()
        end
        """, 43)
    end

    it("return binding after borrow released by NLL — OK") do ->
      assert_run_exits("""
        def good(): Int
          var x = 42
          var r = &x
          var y = r + 1
          return y
        end
        def main(): Int
          return good()
        end
        """, 43)
    end
  end

  describe("NLL: for-loop borrow scoping (G1 hardening)") do ->
    it("borrow created in for-loop body does not persist after loop") do ->
      var src = "def main(): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  for i in 0..3\n"
      src = src + "    var r = &x\n"
      src = src + "    var y = r + 1\n"
      src = src + "  end\n"
      src = src + "  x = 99\n"
      src = src + "  return x\n"
      src = src + "end\n"
      assert_run_exits(src, 99)
    end

    it("borrow of outer var inside for-loop — mutation after OK") do ->
      var src = "def main(): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  for i in 0..1\n"
      src = src + "    var r = &x\n"
      src = src + "  end\n"
      src = src + "  x = 99\n"
      src = src + "  return x\n"
      src = src + "end\n"
      assert_run_exits(src, 99)
    end
  end

  describe("NLL: nested loop borrow isolation (G2 hardening)") do ->
    it("inner loop borrow does not leak to outer loop") do ->
      var src = "def main(): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  var i = 0\n"
      src = src + "  while i < 2\n"
      src = src + "    var j = 0\n"
      src = src + "    while j < 1\n"
      src = src + "      var r = &x\n"
      src = src + "      var y = r + 1\n"
      src = src + "      j += 1\n"
      src = src + "    end\n"
      src = src + "    i += 1\n"
      src = src + "  end\n"
      src = src + "  x = 99\n"
      src = src + "  return x\n"
      src = src + "end\n"
      assert_run_exits(src, 99)
    end
  end

  describe("NLL: if/else branch borrow hardening (G3)") do ->
    it("borrow created only in if-branch — mutation after end OK") do ->
      var src = "def main(): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  if true\n"
      src = src + "    var r = &x\n"
      src = src + "    var y = r + 1\n"
      src = src + "  end\n"
      src = src + "  x = 99\n"
      src = src + "  return x\n"
      src = src + "end\n"
      assert_run_exits(src, 99)
    end

    it("borrow created in both branches — mutation after end OK") do ->
      var src = "def main(): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  if true\n"
      src = src + "    var r = &x\n"
      src = src + "    var y = r + 1\n"
      src = src + "  else\n"
      src = src + "    var r = &x\n"
      src = src + "    var y = r + 2\n"
      src = src + "  end\n"
      src = src + "  x = 99\n"
      src = src + "  return x\n"
      src = src + "end\n"
      assert_run_exits(src, 99)
    end
  end

  describe("NLL: multiple return paths (G4 hardening)") do ->
    it("return binding with no borrow on one path — early return with borrow is QZ1210") do ->
      var src = "def bad(flag: Int): Int\n"
      src = src + "  var x = 42\n"
      src = src + "  var r = &x\n"
      src = src + "  if flag > 0\n"
      src = src + "    return r\n"
      src = src + "  end\n"
      src = src + "  return 0\n"
      src = src + "end\n"
      src = src + "def main(): Int\n"
      src = src + "  return 0\n"
      src = src + "end\n"
      assert_compile_error(src, "QZ1210")
    end
  end

  # ===========================================================================
  # NLL: &mut release
  # ===========================================================================
  describe("NLL: &mut last-use release") do ->
    it("&mut released at last use allows mutation") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def set_x(p: &mut Pt, v: Int): Void
          p.x = v
        end
        def main(): Int
          var p = Pt { x: 0 }
          var r = &mut p
          set_x(r, 42)
          p.x = 99
          return p.x
        end
        """, 99)
    end
  end

  # ===========================================================================
  # NLL: match arm release
  # ===========================================================================
  describe("NLL: match arm borrow release") do ->
    it("borrow used in match arm, mutation after match OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          match 1
            1 => r + 1
            _ => 0
          end
          x = 99
          return x
        end
        """, 99)
    end
  end

  # ===========================================================================
  # NLL: two borrows, independent tracking
  # ===========================================================================
  describe("NLL: independent borrow tracking") do ->
    it("first borrow dies early, second still blocks") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var r1 = &x
          var a = r1 + 1
          var r2 = &x
          x = 99
          var b = r2 + 1
          return b
        end
        """, "QZ1209")
    end
  end

  # ===========================================================================
  # NLL: unused borrow blocks (scope-based fallback)
  # ===========================================================================
  describe("NLL: scope-based fallback") do ->
    it("stored borrow never used still blocks mutation") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var r = &x
          x = 99
          return x
        end
        """, "QZ1209")
    end
  end

  return qspec_main()
end
