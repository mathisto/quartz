## Piezo P3.D — NODE_GO → `perform(Async, spawn, frame)` at kind=1.
##
## Both the lambda form (`go do ... end`) and the named-function form
## (`go f(args)`) build the task frame via the existing async
## constructor and then route the scheduler enqueue through
## `perform(Async, spawn, [frame])` at kind=1. The default Async handler
## (`__qz_default_async_handler` do_spawn) auto-initializes the
## scheduler and calls `__qz_sched_spawn`, returning the frame so
## `var h = go f()` still binds `h` to the handle. spawn is kind=1
## (function-kind) — forcing kind=3 would mark every go-containing
## function suspendable. See `docs/design/P3_D_GO_MIGRATION.md`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("P3.D — NODE_GO → perform(Async, spawn, frame) at kind=1") do ->
    it("`var h = go f(); await h` returns f's value") do ->
      var src = """
def compute(x: Int): Int = x * 3

def main(): Int
  var h = go compute(14)
  var r = await h
  puts("r=" + r.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=42\n")
    end

    it("go-lambda (statement-form) with capture") do ->
      var src = """
def main(): Int
  sched_init(1)
  var ch = channel_new(1)
  var base = 100
  go do -> send(ch, base + 23) end
  var r = recv(ch)
  sched_shutdown()
  puts("r=" + r.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=123\n")
    end

    it("multiple go + await-all composes correctly") do ->
      var src = """
def dbl(x: Int): Int = x + x

def main(): Int
  var h1 = go dbl(10)
  var h2 = go dbl(20)
  var h3 = go dbl(30)
  var sum = (await h1) + (await h2) + (await h3)
  puts("sum=" + sum.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "sum=120\n")
    end

    it("user override `with Async { spawn: my_h }` fires") do ->
      var src = """
import std/async

def inc(x: Int): Int = x + 1

def my_spawn(op: Int, argc: Int, argv: Int): Int
  puts("user spawn fired")
  return 0
end

def main(): Int can Async
  with Async { spawn: my_spawn } do ->
    go inc(5)
    0
  end
  puts("done")
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "user spawn fired\ndone\n")
    end

    it("dormant import std/async (no `go`) still compiles and runs") do ->
      var src = """
import std/async

def main(): Int
  puts("dormant ok")
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "dormant ok\n")
    end
  end
  return qspec_main()
end
