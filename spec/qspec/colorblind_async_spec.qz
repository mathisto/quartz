## Colorblind async: scheduler-aware blocking primitives + go-lambda state machines
## When recv/send/mutex_lock are called inside a $poll state machine,
## they emit try + io_suspend loops instead of blocking the OS thread.
## Go-lambdas now have proper $poll state machines with captures.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("colorblind async") do ->
    it("recv in go named function suspends task") do ->
      var src = """
var g_result = 0
def producer(ch: Int): Void
  send(ch, 42)
end
def consumer(ch: Int): Void
  g_result = recv(ch)
end
def main(): Int
  var ch = channel_new(1)
  go producer(ch)
  go consumer(ch)
  sched_shutdown()
  puts(g_result.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "42\n")
    end

    it("send on full channel suspends in go") do ->
      var src = """
var g_out = 0
def sender(ch: Int): Void
  send(ch, 1)
  send(ch, 2)
end
def receiver(ch: Int): Void
  var v1 = recv(ch)
  var v2 = recv(ch)
  g_out = v1 + v2
end
def main(): Int
  var ch = channel_new(1)
  go sender(ch)
  go receiver(ch)
  sched_shutdown()
  puts(g_out.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "3\n")
    end

    it("multiple tasks coordinate via channels") do ->
      var src = """
var g_sum = 0
def producer(ch: Int, n: Int): Void
  var i = 0
  while i < n
    send(ch, i * 10)
    i += 1
  end
  channel_close(ch)
end
def consumer(ch: Int): Void
  for await v in ch
    g_sum += v
  end
end
def main(): Int
  var ch = channel_new(2)
  go producer(ch, 5)
  go consumer(ch)
  sched_shutdown()
  puts(g_sum.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "100\n")
    end

    it("recv still works outside scheduler context") do ->
      var src = """
def main(): Int
  var ch = channel_new(1)
  send(ch, 99)
  var v = recv(ch)
  puts(v.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "99\n")
    end

    it("go auto-initializes scheduler") do ->
      var src = """
def worker(): Void
  puts("hello")
end
def main(): Int
  go worker()
  sched_shutdown()
  return 0
end
"""
      assert_run_stdout_eq(src, "hello\n")
    end

    it("go-lambda captures variables and runs on scheduler") do ->
      var src = """
def main(): Int
  var x = 42
  go do ->
    puts(x.to_s())
  end
  sched_shutdown()
  return 0
end
"""
      assert_run_stdout_eq(src, "42\n")
    end

    it("go-lambda with colorblind recv") do ->
      var src = """
def main(): Int
  var ch = channel_new(1)
  var out = channel_new(1)
  send(ch, 99)
  go do ->
    var v = recv(ch)
    send(out, v)
  end
  sched_shutdown()
  var result = recv(out)
  puts(result.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "99\n")
    end

    it("go-lambda producer/consumer pattern") do ->
      var src = """
def main(): Int
  var ch = channel_new(1)
  var out = channel_new(1)
  go do ->
    send(ch, 10)
    send(ch, 20)
    send(ch, 30)
    channel_close(ch)
  end
  go do ->
    var sum = 0
    for await v in ch
      sum += v
    end
    send(out, sum)
  end
  sched_shutdown()
  var total = recv(out)
  puts(total.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "60\n")
    end

    it("send and recv on buffered channel work normally") do ->
      var src = """
def main(): Int
  var ch = channel_new(3)
  send(ch, 10)
  send(ch, 20)
  send(ch, 30)
  var a = recv(ch)
  var b = recv(ch)
  var c = recv(ch)
  puts((a + b + c).to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "60\n")
    end

    it("rendezvous channel in go named functions") do ->
      var src = """
var g_val = 0
def sender(ch: Int): Void
  send(ch, 77)
end
def receiver(ch: Int): Void
  g_val = recv(ch)
end
def main(): Int
  var ch = channel_new(0)
  go sender(ch)
  go receiver(ch)
  sched_shutdown()
  puts(g_val.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "77\n")
    end

    it("rendezvous channel in go-lambdas") do ->
      var src = """
def main(): Int
  var ch = channel_new(0)
  var out = channel_new(1)
  go do ->
    send(ch, 55)
  end
  go do ->
    var v = recv(ch)
    send(out, v)
  end
  sched_shutdown()
  var result = recv(out)
  puts(result.to_s())
  return 0
end
"""
      assert_run_stdout_eq(src, "55\n")
    end

    it("go-lambda preserves string_vars in enclosing scope") do ->
      var src = """
def main(): Int
  var name = "hello"
  var x = 42
  go do ->
    puts(x.to_s())
  end
  sched_shutdown()
  var greeting = name + " world"
  puts(greeting)
  return 0
end
"""
      assert_run_stdout_eq(src, "42\nhello world\n")
    end

    it("go-lambda preserves string_vars for captured strings") do ->
      var src = """
def main(): Int
  var msg = "ping"
  var ch = channel_new(1)
  go do ->
    send(ch, 1)
  end
  sched_shutdown()
  recv(ch)
  var result = msg + "pong"
  puts(result)
  return 0
end
"""
      assert_run_stdout_eq(src, "pingpong\n")
    end
  end
  return qspec_main()
end
