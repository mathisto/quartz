## Interprocedural Borrow Enforcement Tests (T3c.2 Phase 3)
##
## Tests that call-site enforcement correctly uses callee BorrowSummary
## to track borrow chains across function boundaries.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("interprocedural borrow enforcement") do ->
    it("f(&x) where f doesn't escape releases borrow (existing behavior)") do ->
      assert_run_exits("""
        struct Point
          x: Int
        end
        def read_x(p: &Point): Int = p.x
        def main(): Int
          var pt = Point { x: 10 }
          var v = read_x(&pt)
          var pt2 = pt
          return v - 10
        end
        """, 0)
    end

    it("non-summary function uses ephemeral release (backward compat)") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return add(1, 2) - 3
        end
        """, 0)
    end

    it("mutable borrow through function enforces exclusivity at caller") do ->
      assert_run_exits("""
        struct Counter
          val: Int
        end
        def inc(c: &mut Counter): Void
          c.val = c.val + 1
        end
        def main(): Int
          var c = Counter { val: 0 }
          inc(&mut c)
          inc(&mut c)
          return c.val - 2
        end
        """, 0)
    end

    it("mix of borrow and non-borrow args — only borrow args tracked") do ->
      assert_run_exits("""
        struct Data
          x: Int
        end
        def read_and_add(d: &Data, n: Int): Int = d.x + n
        def main(): Int
          var d = Data { x: 5 }
          var result = read_and_add(&d, 10)
          return result - 15
        end
        """, 0)
    end

    it("multiple shared borrows to same function work") do ->
      assert_run_exits("""
        struct Vec2
          x: Int
          y: Int
        end
        def dot(a: &Vec2, b: &Vec2): Int = a.x * b.x + a.y * b.y
        def main(): Int
          var a = Vec2 { x: 2, y: 3 }
          var b = Vec2 { x: 4, y: 5 }
          return dot(&a, &b) - 23
        end
        """, 0)
    end

    it("sequential calls with borrows work correctly") do ->
      assert_run_exits("""
        struct Acc
          total: Int
        end
        def add(a: &mut Acc, n: Int): Void
          a.total = a.total + n
        end
        def get(a: &Acc): Int = a.total
        def main(): Int
          var acc = Acc { total: 0 }
          add(&mut acc, 10)
          add(&mut acc, 20)
          var result = get(&acc)
          return result - 30
        end
        """, 0)
    end

    it("return borrow from single param (elision rule 1)") do ->
      ## When a function has a single borrow param and returns a borrow,
      ## the return borrows from that param. The caller should be able to
      ## use both the result and the original after the call.
      assert_run_exits("""
        struct Wrapper
          value: Int
        end
        def get_value(w: &Wrapper): Int = w.value
        def main(): Int
          var w = Wrapper { value: 42 }
          var v = get_value(&w)
          return v - 42
        end
        """, 0)
    end

    it("function without borrow annotations has no summary") do ->
      ## Pure functions (no borrow params, no borrow return) should not
      ## interfere with existing behavior at all.
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def triple(x: Int): Int = x * 3
        def main(): Int
          var a = double(5)
          var b = triple(5)
          return a + b - 25
        end
        """, 0)
    end
  end

  return qspec_main()
end
