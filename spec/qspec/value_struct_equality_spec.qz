## item 51 regression — `@value` struct `==`/`!=` must be FIELD-DEEP, not a raw
## pointer compare.
##
## A value-layout (`@value`) struct has VALUE semantics, so `x == y` compares the two
## structs' FIELDS. Before the fix `OP_EQ`/`OP_NE` on a struct always lowered to an
## `icmp eq` of the two alloca POINTERS, so two equal-VALUED value structs compared
## unequal. mir_lower now routes value-layout struct `==`/`!=` through the runtime
## `@qz_eq_<Name>` field-by-field equality function; the emitter (`_cg_emit_struct_eq`)
## applies the +1 refcount-word skip for COW (>16B) structs so both widths read the
## correct field words. Reference structs keep identity `==` (unchanged).
##
## Covers: inline ≤16B (2×Int), COW >16B (5×Int, the refcount-skip case), and both
## `==` and `!=`. Narrow-packed value structs are NOT yet routed (residual).

import * from qspec

@value
struct EqPair
  a: Int
  b: Int
end

@value
struct EqBig
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
end

# --- inline ≤16B ---
def inline_eq_equal(): Int
  var x = EqPair{a: 3, b: 7}
  var y = EqPair{a: 3, b: 7}
  if x == y
    return 1
  end
  return 0
end

def inline_eq_differ(): Int
  var x = EqPair{a: 3, b: 7}
  var z = EqPair{a: 3, b: 9}
  if x == z
    return 1
  end
  return 0
end

def inline_ne_equal(): Int
  var x = EqPair{a: 3, b: 7}
  var y = EqPair{a: 3, b: 7}
  if x != y
    return 1
  end
  return 0
end

def inline_ne_differ(): Int
  var x = EqPair{a: 3, b: 7}
  var z = EqPair{a: 3, b: 9}
  if x != z
    return 1
  end
  return 0
end

# --- COW >16B (5 fields, refcount header at word 0) ---
def cow_eq_equal(): Int
  var x = EqBig{a: 1, b: 2, c: 3, d: 4, e: 5}
  var y = EqBig{a: 1, b: 2, c: 3, d: 4, e: 5}
  if x == y
    return 1
  end
  return 0
end

def cow_eq_differ_last(): Int
  var x = EqBig{a: 1, b: 2, c: 3, d: 4, e: 5}
  var z = EqBig{a: 1, b: 2, c: 3, d: 4, e: 9}
  if x == z
    return 1
  end
  return 0
end

def cow_eq_differ_first(): Int
  var x = EqBig{a: 1, b: 2, c: 3, d: 4, e: 5}
  var z = EqBig{a: 8, b: 2, c: 3, d: 4, e: 5}
  if x == z
    return 1
  end
  return 0
end

def cow_ne_differ(): Int
  var x = EqBig{a: 1, b: 2, c: 3, d: 4, e: 5}
  var z = EqBig{a: 1, b: 2, c: 3, d: 4, e: 9}
  if x != z
    return 1
  end
  return 0
end

def main(): Int
  describe("value-struct field-deep equality (item 51)") do ->
    it("inline <=16B: equal values compare equal") do ->
      assert_eq(inline_eq_equal(), 1)
    end
    it("inline <=16B: differing values compare unequal") do ->
      assert_eq(inline_eq_differ(), 0)
    end
    it("inline <=16B: != is false for equal values") do ->
      assert_eq(inline_ne_equal(), 0)
    end
    it("inline <=16B: != is true for differing values") do ->
      assert_eq(inline_ne_differ(), 1)
    end
    it("cow >16B: equal values compare equal (refcount-skip)") do ->
      assert_eq(cow_eq_equal(), 1)
    end
    it("cow >16B: differing last field compares unequal") do ->
      assert_eq(cow_eq_differ_last(), 0)
    end
    it("cow >16B: differing first field compares unequal") do ->
      assert_eq(cow_eq_differ_first(), 0)
    end
    it("cow >16B: != is true for differing values") do ->
      assert_eq(cow_ne_differ(), 1)
    end
  end

  return qspec_main()
end
