## StringBuilder Tests
##
## Contract:
##   1. Lifecycle: `sb_new` creates, `sb_free` destroys.
##   2. Append: `sb_append` appends string, handles empty strings.
##   3. Append int: `sb_append_int` appends positive and negative integers.
##   4. To string: `sb_to_string` converts accumulated content to String.
##   5. Clear: `sb_clear` resets builder for reuse.
##   6. Composition: builds complex output (IR-like patterns).
##   7. Multi-int: multiple int appends concatenated.
##   8. Reuse: append after clear preserves new content.

import * from qspec

def test_sb_append(): Void
  sb = sb_new()
  sb_append(sb, "hello")
  sb_append(sb, " ")
  sb_append(sb, "world")
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_empty_strings(): Void
  sb = sb_new()
  sb_append(sb, "")
  sb_append(sb, "test")
  sb_append(sb, "")
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_append_int(): Void
  sb = sb_new()
  sb_append(sb, "count: ")
  sb_append_int(sb, 42)
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_append_neg(): Void
  sb = sb_new()
  sb_append_int(sb, -123)
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_clear(): Void
  sb = sb_new()
  sb_append(sb, "first")
  sb_clear(sb)
  sb_append(sb, "second")
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_ir_pattern(): Void
  sb = sb_new()
  sb_append(sb, "  %t")
  sb_append_int(sb, 1)
  sb_append(sb, " = add i64 ")
  sb_append_int(sb, 10)
  sb_append(sb, ", ")
  sb_append_int(sb, 20)
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_multi_int(): Void
  sb = sb_new()
  sb_append_int(sb, 1)
  sb_append_int(sb, 2)
  sb_append_int(sb, 3)
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def test_sb_reuse(): Void
  sb = sb_new()
  sb_append(sb, "old")
  sb_clear(sb)
  sb_append(sb, "newdata")
  s = sb_to_string(sb)
  puts(s)
  sb_free(sb)
end

def main(): Int
  describe("sb_new and sb_free") do ->
    it("creates and frees a string builder") do ->
      sb = sb_new()
      sb_free(sb)
      assert_eq(1, 1)
    end
  end

  describe("sb_append") do ->
    it("appends strings and converts to string") do ->
      assert_output("hello world\n", test_sb_append)
    end
    it("handles empty strings") do ->
      assert_output("test\n", test_sb_empty_strings)
    end
  end

  describe("sb_append_int") do ->
    it("appends integers") do ->
      assert_output("count: 42\n", test_sb_append_int)
    end
    it("appends negative integers") do ->
      assert_output("-123\n", test_sb_append_neg)
    end
  end

  describe("sb_clear") do ->
    it("clears the builder for reuse") do ->
      assert_output("second\n", test_sb_clear)
    end
  end

  describe("building LLVM IR patterns") do ->
    it("builds IR-like output") do ->
      assert_output("  %t1 = add i64 10, 20\n", test_sb_ir_pattern)
    end
  end

  describe("additional StringBuilder tests") do ->
    it("multiple int appends concatenated") do ->
      assert_output("123\n", test_sb_multi_int)
    end

    it("append after clear preserves new content") do ->
      assert_output("newdata\n", test_sb_reuse)
    end
  end

  return qspec_main()
end
