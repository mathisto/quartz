def _t_handle_install(): Int
  var f = _qpr_empty_fn("hi", mir::MIR_TYPE_VOID)
  var b = _qpr_push_empty_block(f, "entry")
  var i = mir::mir_new_instr(mir::MIR_HANDLE_INSTALL, 0, mir::MIR_TYPE_VOID)
  i.operand2 = as_int("Throws")
  # entries alternate (op_filter_as_int, handler_fn_as_int).
  # Mix of (0, handler) — legacy single-op — and (op, handler) — H-delegate.
  var entries = vec_new<Int>()
  entries.push(0)
  entries.push(as_int("__qz_default_throw"))
  entries.push(as_int("throw"))
  entries.push(as_int("__user$on_throw"))
  i.args = entries
  i.operand1 = 1
  i.slot1 = 12
  _qpr_push_instr(b, i)
  return _qpr_roundtrip_ok(f)
end

