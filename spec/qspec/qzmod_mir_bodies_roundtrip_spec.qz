  l.operand1 = as_int("x")
  l.slot1 = 1
  _qpr_push_instr(b, l)

  var s = mir::mir_new_instr(mir::MIR_STORE_VAR, 0, mir::MIR_TYPE_VOID)
  s.operand1 = as_int("y")
  s.operand2 = 0
  s.slot1 = 0
  _qpr_push_instr(b, s)

  return _qpr_roundtrip_ok(f)
end

