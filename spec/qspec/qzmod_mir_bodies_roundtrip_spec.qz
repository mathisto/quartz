  bu.operand1 = 3
  bu.operand2 = 9
  _qpr_push_instr(b, bu)

  var pc = mir::mir_new_instr(mir::MIR_PACKED_BITCAST, 2, mir::MIR_TYPE_INT)
  pc.operand1 = 4
  pc.operand2 = 11
  pc.slot1 = 1
  _qpr_push_instr(b, pc)

  return _qpr_roundtrip_ok(f)
end

def _t_perform_op(): Int
  var f = _qpr_empty_fn("po", mir::MIR_TYPE_INT)
  var b = _qpr_push_empty_block(f, "entry")
  var i = mir::mir_new_instr(mir::MIR_PERFORM_OP, 3, mir::MIR_TYPE_INT)
  # operand1 = static-handler fn name as-int (G.1); operand2 = op_name;
  # slot1 = kind; slot2 = effect_name; op = install_dest reg.
  i.operand1 = as_int("__user$throw_handler")
  i.operand2 = as_int("throw")
  i.slot1 = 2
  i.slot2 = as_int("Throws")
  i.op = 5
  var args = vec_new<Int>()
  args.push(8)
  i.args = args
  _qpr_push_instr(b, i)
  return _qpr_roundtrip_ok(f)
end

