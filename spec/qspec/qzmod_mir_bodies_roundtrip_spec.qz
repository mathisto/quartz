def _t_phi(): Int
  var f = _qpr_empty_fn("phi", mir::MIR_TYPE_INT)
  var b0 = _qpr_push_empty_block(f, "entry")
  var b1 = _qpr_push_empty_block(f, "left")
  var b2 = _qpr_push_empty_block(f, "join")
  # INC.1.3 block-ref fix: terminator and PHI use ACTUAL block heap
  # pointers, matching live MIR. Pre-fix the spec stored literal ints
  # (2, 0, 1) which silently bypassed the index/pointer translation —
  # the producer's pickle would just round-trip those ints as no-op,
  # masking the cross-process portability bug that real MIR exhibited.
  b0.term_kind = mir::TERM_JUMP
  b0.term_data = as_int_generic(b2)
  b1.term_kind = mir::TERM_JUMP
  b1.term_data = as_int_generic(b2)
  var p = mir::mir_new_instr(mir::MIR_PHI, 10, mir::MIR_TYPE_INT)
  p.operand1 = 4
  p.operand2 = 5
  p.slot1 = as_int_generic(b0)
  p.slot2 = as_int_generic(b1)
  _qpr_push_instr(b2, p)
  return _qpr_roundtrip_ok(f)
end

