def _t_multi_block_branch(): Int
  var f = _qpr_empty_fn("mb", mir::MIR_TYPE_INT)
  var b0 = _qpr_push_empty_block(f, "entry")
  var b1 = _qpr_push_empty_block(f, "then")
  var b2 = _qpr_push_empty_block(f, "else")
  var b3 = _qpr_push_empty_block(f, "join")

  # INC.1.3 block-ref fix: branch_true / branch_false / TERM_JUMP term_data
  # carry MirBlock heap pointers in real MIR. Use the live `as_int_generic`
  # handles so the test exercises the pickle's pointer→index→pointer
  # translation rather than passing through literal ints by accident.
  b0.term_kind = mir::TERM_BRANCH
  b0.term_data = 7  # SSA reg (condition) — NOT a block ref
  b0.branch_true = as_int_generic(b1)
  b0.branch_false = as_int_generic(b2)
  b0.terminated = 1

  b1.term_kind = mir::TERM_JUMP
  b1.term_data = as_int_generic(b3)
  b1.terminated = 1

  b2.term_kind = mir::TERM_JUMP
  b2.term_data = as_int_generic(b3)
  b2.terminated = 1

  b3.term_kind = mir::TERM_RETURN
  b3.term_data = 0
  b3.terminated = 1

  f.block_counter = 4
  return _qpr_roundtrip_ok(f)
end

## Params, locals, narrow locals, return-annotation, flags all set.
def _t_full_metadata(): Int
  var f = mir::mir_new_function("__lambda_42", mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(f, "std_string")
  f.params.push("a")
  f.params.push("b")
  f.param_types.push(mir::MIR_TYPE_INT)
  f.param_types.push(mir::MIR_TYPE_STRING)
  f.param_type_names.push("Int")
  f.param_type_names.push("String")
  f.return_type_name = "Int"
  f.locals.push("tmp1")
  f.locals.push("tmp2")
  f.local_narrow_names.push("nn1")
  f.local_narrow_types.push("U8")
  f.is_naked = 1
  f.is_no_preempt = 0
  f.is_weak = 1
  f.is_export = 0
  f.is_noinline = 1
  f.entry = 0
  f.value_counter = 8
  f.block_counter = 1
  f.line = 142
  f.col = 7

  var b = _qpr_push_empty_block(f, "entry")
  b.term_kind = mir::TERM_RETURN
  b.term_data = 0
  b.terminated = 1
  return _qpr_roundtrip_ok(f)
end

## Big composite: one block with many MIR kinds back-to-back, plus a
## lambda-named function with locals. Exercises the unpickle's instr-by-
## instr cursor advancement across mixed string-mask kinds.
def _t_composite_func(): Int
  var f = mir::mir_new_function("composite", mir::MIR_TYPE_INT)
  f.params.push("x")
  f.param_types.push(mir::MIR_TYPE_INT)
  f.param_type_names.push("Int")
  f.return_type_name = "Int"
  f.locals.push("y")
  f.value_counter = 12

  var b = _qpr_push_empty_block(f, "entry")

  var ci = mir::mir_new_instr(mir::MIR_CONST_INT, 1, mir::MIR_TYPE_INT)
  ci.operand1 = 100
  _qpr_push_instr(b, ci)

  var cs = mir::mir_new_instr(mir::MIR_CONST_STRING, 2, mir::MIR_TYPE_STRING)
  cs.operand2 = as_int("greetings")
  _qpr_push_instr(b, cs)

  var lv = mir::mir_new_instr(mir::MIR_LOAD_VAR, 3, mir::MIR_TYPE_INT)
  lv.operand1 = as_int("x")
  _qpr_push_instr(b, lv)

  var bi = mir::mir_new_instr(mir::MIR_BINARY, 4, mir::MIR_TYPE_INT)
  bi.operand1 = 1
  bi.operand2 = 3
  bi.op = 0
  _qpr_push_instr(b, bi)

  var sv = mir::mir_new_instr(mir::MIR_STORE_VAR, 0, mir::MIR_TYPE_VOID)
  sv.operand1 = as_int("y")
  sv.operand2 = 4
  _qpr_push_instr(b, sv)

  var call = mir::mir_new_instr(mir::MIR_CALL, 5, mir::MIR_TYPE_INT)
  call.operand2 = as_int("std$println")
  var ca = vec_new<Int>()
  ca.push(2)
  call.args = ca
  _qpr_push_instr(b, call)

  b.term_kind = mir::TERM_RETURN
  b.term_data = 4
  b.terminated = 1
  return _qpr_roundtrip_ok(f)
end

## Out-of-bounds offset → None.
def _t_unpickle_oob_returns_none(): Int
  var pool = qzmod_emit::qzmod_pool_new()
  var f = _qpr_empty_fn("x", mir::MIR_TYPE_INT)
  var blob = qzmod_emit::mir_pickle_function(f, pool)
  # Read at off = blob.size — guaranteed OOB.
  var maybe = qzmod_load::mir_unpickle_function(blob, blob.size, pool.strings)
  if maybe.some?
    return 0
  end
  return 1
end

## Pickling the same MirFunc twice produces identical blobs + pools
## (fixpoint contract for the producer integration).
def _t_pickle_deterministic(): Int
  var f = _qpr_empty_fn("det", mir::MIR_TYPE_INT)
  var b = _qpr_push_empty_block(f, "entry")
  var i = mir::mir_new_instr(mir::MIR_CONST_STRING, 0, mir::MIR_TYPE_STRING)
  i.operand2 = as_int("twice")
  _qpr_push_instr(b, i)

  var pool_a = qzmod_emit::qzmod_pool_new()
  var blob_a = qzmod_emit::mir_pickle_function(f, pool_a)

  var pool_b = qzmod_emit::qzmod_pool_new()
  var blob_b = qzmod_emit::mir_pickle_function(f, pool_b)

  if _qpr_int_eq(blob_a, blob_b) == 0
    return 0
  end
  if _qpr_str_eq(pool_a.strings, pool_b.strings) == 0
    return 0
  end
  return 1
end

## Structural check on a concrete field — return_type_name comes back
## under str_eq, not pointer identity. Belt-and-braces against the
## blob-equality test (which would also pass if the unpickle was a
## no-op identity by accident).
def _t_unpickle_field_strings_round_trip(): Int
  var f = mir::mir_new_function("field_test", mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(f, "std_vec")
  f.return_type_name = "I32"
  f.params.push("a_long_param_name")
  f.param_types.push(mir::MIR_TYPE_INT)
  f.param_type_names.push("CInt")

  var pool = qzmod_emit::qzmod_pool_new()
  var blob = qzmod_emit::mir_pickle_function(f, pool)
  var maybe = qzmod_load::mir_unpickle_function(blob, 0, pool.strings)
  if not maybe.some?
    return 0
  end
  var g = maybe.unwrap()
  if not str_eq(g.name, "field_test")
    return 0
  end
  if not str_eq(mir::mir_func_get_origin_module(g), "std_vec")
    return 0
  end
  if g.return_type != mir::MIR_TYPE_INT
    return 0
  end
  if not str_eq(g.return_type_name, "I32")
    return 0
  end
  if g.params.size != 1
    return 0
  end
  if not str_eq(g.params[0], "a_long_param_name")
    return 0
  end
  if g.param_types.size != 1 or g.param_types[0] != mir::MIR_TYPE_INT
    return 0
  end
  if not str_eq(g.param_type_names[0], "CInt")
    return 0
  end
  return 1
end

## origin_module = "" (synthetic / __main__ functions) must round-trip
## as empty string, NOT crash or substitute. Producer integration relies
## on this for the filter: synthetic funcs leave origin_module == "" and
## are skipped from per-module shipping by string equality.
def _t_origin_module_empty_round_trip(): Int
  var f = mir::mir_new_function("__qz_module_init", mir::MIR_TYPE_INT)
  # origin_module deliberately not set — mir_new_function defaults to "".
  var pool = qzmod_emit::qzmod_pool_new()
  var blob = qzmod_emit::mir_pickle_function(f, pool)
  var maybe = qzmod_load::mir_unpickle_function(blob, 0, pool.strings)
  if not maybe.some?
    return 0
  end
  var g = maybe.unwrap()
  if not str_eq(mir::mir_func_get_origin_module(g), "")
    return 0
  end
  return 1
end

# =============================================================================
# Test suite
# =============================================================================

def main(): Int
  describe("qzmod MIR_BODIES · function shells") do ->
    it("empty function (no blocks) round-trips") do ->
      assert_eq(_t_empty_fn(), 1)
    end

    it("one empty block round-trips") do ->
      assert_eq(_t_empty_block(), 1)
    end

    it("multi-block with TERM_BRANCH + jumps round-trips") do ->
      assert_eq(_t_multi_block_branch(), 1)
    end

    it("full metadata (params + locals + narrow + flags + lambda name) round-trips") do ->
      assert_eq(_t_full_metadata(), 1)
    end
  end

  describe("qzmod MIR_BODIES · const + var ops") do ->
    it("MIR_CONST_INT round-trips") do ->
      assert_eq(_t_const_int(), 1)
    end

    it("MIR_CONST_STRING round-trips (operand2 string)") do ->
      assert_eq(_t_const_string(), 1)
    end

    it("MIR_CONST_FLOAT round-trips (operand2 string)") do ->
      assert_eq(_t_const_float(), 1)
    end

    it("MIR_LOAD_VAR + MIR_STORE_VAR round-trip (operand1 string + slot1 int)") do ->
      assert_eq(_t_load_store_var(), 1)
    end

    it("MIR_ADDR_OF round-trips (operand1 string)") do ->
      assert_eq(_t_addr_of(), 1)
    end
  end

  describe("qzmod MIR_BODIES · call ops") do ->
    it("MIR_CALL with args round-trips (operand2 string, args=SSA)") do ->
      assert_eq(_t_call_with_args(), 1)
    end

    it("MIR_INTRINSIC typed round-trips (operand2 + slot2 strings)") do ->
      assert_eq(_t_intrinsic_typed(), 1)
    end

    it("MIR_FUNC_REF round-trips (operand2 string)") do ->
      assert_eq(_t_func_ref(), 1)
    end

    it("MIR_CALL_INDIRECT round-trips (operand1 SSA, args=SSA)") do ->
      assert_eq(_t_call_indirect(), 1)
    end

    it("MIR_INLINE_C round-trips (operand2 string, args=SSA)") do ->
      assert_eq(_t_inline_c(), 1)
    end
  end

  describe("qzmod MIR_BODIES · memory + index ops") do ->
    it("MIR_ALLOC typed round-trips (operand1 string)") do ->
      assert_eq(_t_alloc_typed(), 1)
    end

    it("MIR_ALLOC_STACK with + without struct name round-trips") do ->
      assert_eq(_t_alloc_stack(), 1)
    end

    it("MIR_STORE with field_type (op-slot string) round-trips") do ->
      assert_eq(_t_store_with_field_type(), 1)
    end

    it("MIR_LOAD_OFFSET typed round-trips (operand1 + operand2 strings)") do ->
      assert_eq(_t_load_offset_typed(), 1)
    end

    it("MIR_LOAD_OFFSET untyped (no struct/field name) round-trips") do ->
      assert_eq(_t_load_offset_untyped(), 1)
    end

    it("MIR_INDEX / MIR_INDEX_STORE round-trip (slot2 string)") do ->
      assert_eq(_t_index_ops(), 1)
    end

    it("MIR_VEC_DATA_PTR round-trips (slot2 string)") do ->
      assert_eq(_t_vec_data_ptr(), 1)
    end
  end

  describe("qzmod MIR_BODIES · binary-DSL + binary + select + phi") do ->
    it("MIR_BINARY (signed + unsigned via slot1) round-trips") do ->
      assert_eq(_t_binary_unsigned(), 1)
    end

    it("MIR_SELECT round-trips") do ->
      assert_eq(_t_select(), 1)
    end

    it("MIR_PHI round-trips (slot1/slot2 = block idx)") do ->
      assert_eq(_t_phi(), 1)
    end

    it("MIR_BINARY_PACK / UNPACK / PACKED_BITCAST round-trip") do ->
      assert_eq(_t_binary_layout_ops(), 1)
    end
  end

  describe("qzmod MIR_BODIES · effects ops") do ->
    it("MIR_PERFORM_OP with static handler round-trips (operand1+2 + slot2 strings)") do ->
      assert_eq(_t_perform_op(), 1)
    end

    it("MIR_PERFORM_OP without static handler (operand1 = 0) round-trips") do ->
      assert_eq(_t_perform_op_no_static_handler(), 1)
    end

    it("MIR_HANDLE_INSTALL with mixed-arg entries round-trips (args ARE strings)") do ->
      assert_eq(_t_handle_install(), 1)
    end

    it("MIR_HANDLE_INSTALL IDENT-form (all-zero entries) round-trips") do ->
      assert_eq(_t_handle_install_no_state(), 1)
    end

    it("MIR_HANDLE_UNINSTALL round-trips (operand2 string)") do ->
      assert_eq(_t_handle_uninstall(), 1)
    end

    it("MIR_EFFECT_POP_N round-trips (operand2 string)") do ->
      assert_eq(_t_effect_pop_n(), 1)
    end
  end

  describe("qzmod MIR_BODIES · composite + invariants") do ->
    it("composite function with mixed kinds round-trips") do ->
      assert_eq(_t_composite_func(), 1)
    end

    it("pickle of same MirFunc twice produces identical bytes + pool") do ->
      assert_eq(_t_pickle_deterministic(), 1)
    end

    it("decoded fields (name + return + params + return_type_name + origin_module) come back via str_eq") do ->
      assert_eq(_t_unpickle_field_strings_round_trip(), 1)
    end

    it("origin_module = \"\" (synthetic / __main__) round-trips as empty string") do ->
      assert_eq(_t_origin_module_empty_round_trip(), 1)
    end

    it("unpickle at out-of-bounds offset returns None (advisory cache)") do ->
      assert_eq(_t_unpickle_oob_returns_none(), 1)
    end
  end

  return qspec_main()
end
