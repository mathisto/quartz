## qzmod MIR_BODIES round-trip acceptance — INC.1.1.
##
## The primitive pair `mir_pickle_function` / `mir_unpickle_function` is
## the foundation of MIR shipping (`docs/design/QZMOD_MIR_BODIES.md`).
## INC.1.1's acceptance is: build a synthetic `MirFunc` covering every
## emitted MIR opcode + every operand-discrimination class, pickle, then
## unpickle, and verify the result re-pickles byte-identically.
##
## "Pickleable equality" (re-pickle byte-match) is the right test: it
## proves every operand slot the consumer can read came back with the
## right value. Pure structural walk would have to duplicate the kind
## table and would still miss the args[] discrimination — re-pickling
## exercises the SAME path the producer uses.
##
## Coverage strategy:
##   - One test per MIR opcode that's actively emitted (table §3 +
##     mir.qz:489-599 verified). Every kind that carries a string
##     operand goes through both the string and the no-string codepath
##     (operand value = 0 sentinel) at least once across the suite.
##   - Edge cases: empty function, empty block, multi-block with branch
##     terminator, PHI, MIR_HANDLE_INSTALL with string-typed args[],
##     lambda-named function.
##   - "Pickle is deterministic" test ensures gen1/gen2 stability for the
##     producer integration's fixpoint contract.

import * from qspec
import qzmod_emit
import qzmod_load
import mir
import * from str_compat

# =============================================================================
# Round-trip harness: pickle → unpickle → re-pickle, compare blobs + pool.
# =============================================================================

## Compare two Vec<Int> elementwise. Returns 1 on equality.
def _qpr_int_eq(a: Vec<Int>, b: Vec<Int>): Int
  if a.size != b.size
    return 0
  end
  for i in 0..a.size
    if a[i] != b[i]
      return 0
    end
  end
  return 1
end

## Compare two Vec<String> elementwise via str_eq. Returns 1 on equality.
def _qpr_str_eq(a: Vec<String>, b: Vec<String>): Int
  if a.size != b.size
    return 0
  end
  for i in 0..a.size
    if not str_eq(a[i], b[i])
      return 0
    end
  end
  return 1
end

## Run the round-trip and assert pickleable equality. Returns 1 on
## success, 0 on any failure (pool divergence, blob divergence, unpickle
## fault).
def _qpr_roundtrip_ok(func: MirFunc): Int
  var pool_a = qzmod_emit::qzmod_pool_new()
  var blob_a = qzmod_emit::mir_pickle_function(func, pool_a)

  var maybe = qzmod_load::mir_unpickle_function(blob_a, 0, pool_a.strings)
  if not maybe.some?
    return 0
  end
  var func_b = maybe.unwrap()

  var pool_b = qzmod_emit::qzmod_pool_new()
  var blob_b = qzmod_emit::mir_pickle_function(func_b, pool_b)

  if _qpr_str_eq(pool_a.strings, pool_b.strings) == 0
    return 0
  end
  if _qpr_int_eq(blob_a, blob_b) == 0
    return 0
  end
  return 1
end

# =============================================================================
# Builders — minimal MirFunc/Block/Instr constructors. The pickle layout
# is field-exhaustive; helpers below populate just what each test needs
# and leave the rest at mir_new_* defaults.
# =============================================================================

## Construct an empty MirFunc with the given name + return_type. No blocks.
def _qpr_empty_fn(name: String, ret_t: Int): MirFunc
  return mir::mir_new_function(name, ret_t)
end

## Append an empty block (no instrs, default terminator) labeled `label` to
## the function. Returns the block handle for further mutation.
def _qpr_push_empty_block(func: MirFunc, label: String): MirBlock
  var block = mir::mir_new_block(label)
  func.blocks.push(block)
  return block
end

## Append an instruction to a block (no terminator change).
def _qpr_push_instr(block: MirBlock, instr: MirInstr): Void
  block.instructions.push(instr)
end

# =============================================================================
# Tests
# =============================================================================

def _t_empty_fn(): Int
  return _qpr_roundtrip_ok(_qpr_empty_fn("noop", mir::MIR_TYPE_VOID))
end

def _t_empty_block(): Int
  var f = _qpr_empty_fn("oneblock", mir::MIR_TYPE_INT)
  var _b = _qpr_push_empty_block(f, "entry")
  return _qpr_roundtrip_ok(f)
end

def _t_const_int(): Int
  var f = _qpr_empty_fn("ci", mir::MIR_TYPE_INT)
  var b = _qpr_push_empty_block(f, "entry")
  var i = mir::mir_new_instr(mir::MIR_CONST_INT, 0, mir::MIR_TYPE_INT)
  i.operand1 = 42
  _qpr_push_instr(b, i)
  f.value_counter = 1
  b.term_kind = mir::TERM_RETURN
  b.term_data = 0
  b.terminated = 1
  return _qpr_roundtrip_ok(f)
end

