## std/tui/help behaviour tests.
##
## Coverage:
##   - key_binding / keymap_new constructors
##   - keymap_with_bindings / keymap_append builders
##   - help_body contains title, group, key, action labels
##   - Action column lines up across bindings (key padding works)
##   - Empty maps still produce title + dismissal hint
##   - help_modal returns an Overlay centred at POS_CENTER with a
##     non-zero size
##   - help_styles_default produces the same body as help_body when
##     fed back through help_body_with_styles

import * from qspec
import std/tui/help as hp
import std/tui/widgets/overlay as ov
import std/tui/layout as ly
import style

# ============================================================
# Constructors
# ============================================================

def test_key_binding_holds_both_fields(): Void
  var b = hp::key_binding("Enter", "play card")
  assert_eq_str(b.key, "Enter")
  assert_eq_str(b.action, "play card")
end

def test_keymap_new_starts_empty(): Void
  var km = hp::keymap_new("Combat")
  assert_eq_str(km.group, "Combat")
  assert_eq(km.bindings.size, 0)
end

def test_keymap_with_bindings_replaces_list(): Void
  var bs = vec_new<hp::KeyBinding>()
  vec_push(bs, hp::key_binding("a", "alpha"))
  vec_push(bs, hp::key_binding("b", "beta"))
  var km = hp::keymap_with_bindings(hp::keymap_new("X"), bs)
  assert_eq(km.bindings.size, 2)
end

def test_keymap_append_grows_list(): Void
  var km = hp::keymap_append(hp::keymap_new("X"), "k", "do thing")
  km = hp::keymap_append(km, "j", "do other")
  assert_eq(km.bindings.size, 2)
end

# ============================================================
# Body content
# ============================================================

def _make_combat_map(): hp::KeyMap
  var km = hp::keymap_append(hp::keymap_new("Combat"), "↑↓",    "navigate hand")
  km = hp::keymap_append(km, "Enter", "play card")
  km = hp::keymap_append(km, "E",     "end turn")
  return km
end

def _make_anywhere_map(): hp::KeyMap
  var km = hp::keymap_append(hp::keymap_new("Anywhere"), "?", "toggle help")
  km = hp::keymap_append(km, "Q", "quit")
  return km
end

def test_body_contains_title_banner(): Void
  var maps = vec_new<hp::KeyMap>()
  var body = hp::help_body(maps)
  if str_contains(body, "KEYS")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_body_contains_dismiss_hint(): Void
  var maps = vec_new<hp::KeyMap>()
  var body = hp::help_body(maps)
  if str_contains(body, "[? to dismiss]")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_body_contains_group_titles(): Void
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  vec_push(maps, _make_anywhere_map())
  var body = hp::help_body(maps)
  if str_contains(body, "Combat") and str_contains(body, "Anywhere")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_body_contains_key_and_action_labels(): Void
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  var body = hp::help_body(maps)
  if str_contains(body, "Enter") and str_contains(body, "play card")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_body_aligns_action_column(): Void
  ## The longest key in the combat map is "Enter" (5 cells); every
  ## binding should pad its key column to that width before the
  ## 4-space gap, so the action labels start at the same column on
  ## every line.
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  var body = ly::strip_styles(hp::help_body(maps))
  ## Each binding line begins with two spaces, the padded key, four
  ## spaces, then the action. We expect to find the literal "↑↓   "
  ## (key + 3 trailing pad to reach 5 cells) followed by "    navigate".
  if str_contains(body, "  ↑↓       navigate hand")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if str_contains(body, "  Enter    play card")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if str_contains(body, "  E        end turn")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_body_with_styles_preserves_plain_text(): Void
  ## help_body_with_styles using default styles should match help_body
  ## byte-for-byte (the helper is "use the default" sugar over the
  ## same code path).
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  var a = hp::help_body(maps)
  var b = hp::help_body_with_styles(maps, hp::help_styles_default())
  assert_eq_str(a, b)
end

# ============================================================
# Modal / Overlay
# ============================================================

def test_modal_is_overlay_at_pos_center(): Void
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  var modal = hp::help_modal(maps)
  assert_eq(modal.position, ov::POS_CENTER())
end

def test_modal_has_nonzero_size(): Void
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  var modal = hp::help_modal(maps)
  if modal.width > 0 and modal.height > 0
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_modal_content_contains_group_titles(): Void
  var maps = vec_new<hp::KeyMap>()
  vec_push(maps, _make_combat_map())
  vec_push(maps, _make_anywhere_map())
  var modal = hp::help_modal(maps)
  ## modal.content is bordered, but the body lines are still embedded
  ## as substrings — strip the border decoration via strip_styles
  ## (which doesn't change box chars) and substring-match.
  if str_contains(modal.content, "Combat") and str_contains(modal.content, "Anywhere")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("constructors") do ->
    it("key_binding holds key and action") do ->
      test_key_binding_holds_both_fields()
    end
    it("keymap_new starts with empty bindings") do ->
      test_keymap_new_starts_empty()
    end
    it("keymap_with_bindings replaces the list") do ->
      test_keymap_with_bindings_replaces_list()
    end
    it("keymap_append grows the list") do ->
      test_keymap_append_grows_list()
    end
  end

  describe("body content") do ->
    it("contains the KEYS title banner") do ->
      test_body_contains_title_banner()
    end
    it("contains the dismiss hint footer") do ->
      test_body_contains_dismiss_hint()
    end
    it("contains every group title") do ->
      test_body_contains_group_titles()
    end
    it("contains every key and action label") do ->
      test_body_contains_key_and_action_labels()
    end
    it("pads keys so action column aligns across bindings") do ->
      test_body_aligns_action_column()
    end
    it("with default styles matches help_body byte-for-byte") do ->
      test_body_with_styles_preserves_plain_text()
    end
  end

  describe("modal / overlay") do ->
    it("returns an Overlay anchored at POS_CENTER") do ->
      test_modal_is_overlay_at_pos_center()
    end
    it("has non-zero width and height") do ->
      test_modal_has_nonzero_size()
    end
    it("content contains every group title") do ->
      test_modal_content_contains_group_titles()
    end
  end

  return qspec_main()
end
