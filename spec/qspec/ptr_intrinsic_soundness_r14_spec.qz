## Pointer-Intrinsic Soundness — R1.4 lock-in
##
## Regression guard for the R1.4 soundness fix in
## `self-hosted/middle/typecheck_expr_handlers.qz:2437-2513`:
##   * `arena_alloc<T>(arena)` returns `Ptr<T>` (TYPE_PTR-wrapped T), not TYPE_INT.
##   * `ptr_read<T>(ptr)`      returns the resolved `T`, not TYPE_INT.
##   * `volatile_load<T>(ptr)` returns the resolved `T`, not TYPE_INT.
##
## Why this catches a regression to TYPE_INT:
##   Each test allocates a typed slot for a 2-field struct, writes a struct
##   value, reads it back with the typed intrinsic, and does `.field` access on
##   the result. Field access only type-checks (and codegens the right offset)
##   when the read is typed `T` — the struct type. If the intrinsic regressed to
##   returning TYPE_INT, `.x`/`.y` would fail to type-check (bare Int has no
##   fields) OR codegen the wrong offsets, and the exit code would diverge.
##   The value chosen (30+12 and 40+2) totals 42 so a wrong offset / wrong value
##   read is caught by the exit-code assertion, not just a type error.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("R1.4 — pointer-intrinsic soundness (typed T, not Int)") do ->
    it("arena_alloc<T> + ptr_read<T> round-trips a struct value") do ->
      assert_run_exits(arena_typed_struct_src(), 42)
    end

    it("ptr_read<T> result supports .field access (typed, not Int)") do ->
      assert_run_exits(ptr_read_field_access_src(), 42)
    end

    it("volatile_store<T> + volatile_load<T> round-trips a struct value") do ->
      assert_run_exits(volatile_typed_struct_src(), 42)
    end

    it("ptr_read<Int> stays a usable Int (no regression)") do ->
      assert_run_exits(ptr_read_int_src(), 42)
    end
  end

  return qspec_main()
end

## arena_alloc<Pair> gives a Ptr<Pair>; write a Pair, read it back as a Pair,
## sum both fields. If ptr_read<Pair> regressed to TYPE_INT, `.a`/`.b` would
## not type-check.
def arena_typed_struct_src(): String
  var s = "struct Pair\n"
  s = s + "  a: Int\n"
  s = s + "  b: Int\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var ar = arena_new()\n"
  s = s + "  var p = arena_alloc<Pair>(ar)\n"
  s = s + "  ptr_write<Pair>(p, Pair { a: 30, b: 12 })\n"
  s = s + "  var v = ptr_read<Pair>(p)\n"
  s = s + "  arena_destroy(ar)\n"
  s = s + "  return v.a + v.b\n"
  s = s + "end\n"
  return s
end

## Field access chained directly off the ptr_read<T> result — the most direct
## proof the return type is the struct T, not Int.
def ptr_read_field_access_src(): String
  var s = "struct Pair\n"
  s = s + "  a: Int\n"
  s = s + "  b: Int\n"
  s = s + "end\n"
  s = s + "def read_a(p: Ptr<Pair>): Int\n"
  s = s + "  return ptr_read<Pair>(p).a\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var ar = arena_new()\n"
  s = s + "  var p = arena_alloc<Pair>(ar)\n"
  s = s + "  ptr_write<Pair>(p, Pair { a: 42, b: 0 })\n"
  s = s + "  var out = read_a(p)\n"
  s = s + "  arena_destroy(ar)\n"
  s = s + "  return out\n"
  s = s + "end\n"
  return s
end

## Same soundness contract for the volatile_load<T>/volatile_store<T> pair.
def volatile_typed_struct_src(): String
  var s = "struct Vec2\n"
  s = s + "  x: Int\n"
  s = s + "  y: Int\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var ar = arena_new()\n"
  s = s + "  var p = arena_alloc<Vec2>(ar)\n"
  s = s + "  volatile_store<Vec2>(p, Vec2 { x: 40, y: 2 })\n"
  s = s + "  var v = volatile_load<Vec2>(p)\n"
  s = s + "  arena_destroy(ar)\n"
  s = s + "  return v.x + v.y\n"
  s = s + "end\n"
  return s
end

## ptr_read<Int> still yields a usable Int — arithmetic on the result must work.
def ptr_read_int_src(): String
  var s = "def main(): Int\n"
  s = s + "  var ar = arena_new()\n"
  s = s + "  var p = arena_alloc<Int>(ar)\n"
  s = s + "  ptr_write<Int>(p, 40)\n"
  s = s + "  var v = ptr_read<Int>(p) + 2\n"
  s = s + "  arena_destroy(ar)\n"
  s = s + "  return v\n"
  s = s + "end\n"
  return s
end
