## NODE_WITH AST node — C.1 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.1).
## Verifies that `with handler do -> body end` now emits a real
## NODE_WITH = 101 AST node (left = handler expression, right = body
## NODE_BLOCK). Before C.1 the parser returned `ast_block(body)` directly
## and discarded the handler expression (parser.qz:4787) — the C.2
## handler-narrowing chunk had nothing to inspect.
##
## C.1 retains the AST shape and forwards typecheck + MIR to the body
## unchanged; the handler expression is typechecked for well-formedness
## but is NOT emitted at runtime. Runtime behavior must be IDENTICAL to
## Milestone A for any well-formed with-block. The new observable
## behavior is that handler expressions that reference undefined
## identifiers now surface as typecheck errors (previously silent).
##
## C.2 uses NODE_WITH.left for row narrowing; C.4 lowers the whole
## construct to MIR_HANDLE_INSTALL / MIR_HANDLE_UNINSTALL so the handler
## actually installs on the evidence chain at runtime.

import * from qspec
import * from qspec/subprocess

def piezo_c1_noop_handler(): Int = 0
def piezo_c1_handler_with_arg(n: Int): Int = n + 1

def piezo_c1_with_simple(): Int
  return with piezo_c1_noop_handler() do ->
    42
  end
end

def piezo_c1_with_multi(): Int
  return with piezo_c1_handler_with_arg(7) do ->
    var a = 10
    var b = 20
    a + b
  end
end

def piezo_c1_with_nested(): Int
  return with piezo_c1_noop_handler() do ->
    with piezo_c1_handler_with_arg(1) do ->
      99
    end
  end
end

def piezo_c1_with_stmt_chain(): Int
  var x = 0
  x = with piezo_c1_noop_handler() do ->
    5
  end
  x = x + 10
  return x
end

def main(): Int
  describe("NODE_WITH AST node (piezo C.1)") do ->
    it("simple with returns body tail value (runtime preserved)") do ->
      assert_eq(piezo_c1_with_simple(), 42)
    end

    it("multi-statement body returns last expression") do ->
      assert_eq(piezo_c1_with_multi(), 30)
    end

    it("nested with-blocks compose") do ->
      assert_eq(piezo_c1_with_nested(), 99)
    end

    it("with-expression assigns through to var") do ->
      assert_eq(piezo_c1_with_stmt_chain(), 15)
    end

    it("handler with undefined identifier now fails typecheck (C.1 regression)") do ->
      assert_compile_error("""
def c1_main(): Int
  return with no_such_handler_c1() do ->
    1
  end
end
""", "no_such_handler_c1")
    end

    it("well-formed with-block with effect-rowed handler caller still compiles") do ->
      assert_compile_succeeds("""
effect Throws
  def throw(msg: String): Int
end

def outer(): Int
  return with 42 do ->
    100
  end
end

def main(): Int = outer()
""")
    end
  end
  return qspec_main()
end
