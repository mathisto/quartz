## x86 port-I/O Intrinsics Tests
##
## Contract: port_out{8,16,32} and port_in{8,16,32} lower to LLVM inline
## asm with the correct AT&T mnemonic (outb/outw/outl, inb/inw/inl) and
## register constraints ({dx} for port, {al}/{ax}/{eax} for value). The
## asm is marked `sideeffect` so LLVM doesn't CSE / DCE calls — port I/O
## has external effects the optimizer cannot observe.
##
## Usage: legacy I/O-port-space devices in x86_64 kernels (COM1=0x3F8,
## PIC, PIT, CMOS, keyboard).

import * from qspec

def main(): Int
  describe("x86 port-I/O intrinsics") do ->
    it("port_out8 emits outb with {al},{dx} constraints") do ->
      var src = """
        def main(): Int
          port_out8(0x3F8, 72)
          return 0
        end
      """
      assert_ir_contains(src, "call void asm sideeffect \"outb")
      assert_ir_contains(src, "{al},{dx}")
    end

    it("port_out16 emits outw with {ax},{dx} constraints") do ->
      var src = """
        def main(): Int
          port_out16(0x3F8, 1000)
          return 0
        end
      """
      assert_ir_contains(src, "call void asm sideeffect \"outw")
      assert_ir_contains(src, "{ax},{dx}")
    end

    it("port_out32 emits outl with {eax},{dx} constraints") do ->
      var src = """
        def main(): Int
          port_out32(0x3F8, 1234567)
          return 0
        end
      """
      assert_ir_contains(src, "call void asm sideeffect \"outl")
      assert_ir_contains(src, "{eax},{dx}")
    end

    it("port_in8 emits inb with ={al},{dx} and zext to i64") do ->
      var src = """
        def main(): Int
          return port_in8(0x3FD)
        end
      """
      assert_ir_contains(src, "call i8 asm sideeffect \"inb")
      assert_ir_contains(src, "={al},{dx}")
      assert_ir_contains(src, "zext i8")
    end

    it("port_in16 emits inw with ={ax},{dx} and zext to i64") do ->
      var src = """
        def main(): Int
          return port_in16(0x3F8)
        end
      """
      assert_ir_contains(src, "call i16 asm sideeffect \"inw")
      assert_ir_contains(src, "={ax},{dx}")
      assert_ir_contains(src, "zext i16")
    end

    it("port_in32 emits inl with ={eax},{dx} and zext to i64") do ->
      var src = """
        def main(): Int
          return port_in32(0x3F8)
        end
      """
      assert_ir_contains(src, "call i32 asm sideeffect \"inl")
      assert_ir_contains(src, "={eax},{dx}")
      assert_ir_contains(src, "zext i32")
    end

    it("port_out args truncated from i64 to correct widths") do ->
      # Port arg always i16; value arg is width-matched (i8/i16/i32).
      var src = """
        def main(): Int
          port_out8(0x3F8, 72)
          port_out16(0x3F8, 1000)
          port_out32(0x3F8, 1234567)
          return 0
        end
      """
      assert_ir_contains(src, "trunc i64")
      # At least one i8 trunc for port_out8's value.
      assert_ir_contains(src, "to i8")
      # i16 for both port args + port_out16 value.
      assert_ir_contains(src, "to i16")
      # i32 for port_out32 value.
      assert_ir_contains(src, "to i32")
    end

    it("freestanding x86_64 compile lowers to real outb/inb opcodes") do ->
      # Sanity: the intrinsics work in the freestanding target path
      # that kernels actually use. Covered end-to-end (with llc) by
      # baremetal:verify_hello_x86_64 once hello_x86.qz starts calling
      # these — this spec checks the IR shape at the source level.
      var flags = "--target x86_64-unknown-none-elf"
      var src = """
        def main(): Int
          port_out8(0x3F8, 72)
          var b = port_in8(0x3FD)
          return b
        end
      """
      assert_ir_contains_with_flags(src, "outb", flags)
      assert_ir_contains_with_flags(src, "inb", flags)
    end
  end

  return qspec_main()
end
