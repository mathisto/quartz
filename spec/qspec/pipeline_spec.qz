## Pipeline Operator Tests
##
## Contract:
##   1. Basic pipe: `x |> f` passes x as first arg to f.
##   2. Chaining: `x |> f |> g` left-to-right composition.
##   3. Expressions: `(expr) |> f` computes expr first.
##   4. Extra args: `x |> f(y)` prepends x to arg list.
##   5. Multiple extra args: `x |> f(y, z)`.
##   6. Stdlib: pipeline with stdlib functions like vec_size.

import * from qspec

def pipe_double(x: Int): Int = x * 2
def pipe_add_one(x: Int): Int = x + 1
def pipe_add(x: Int, y: Int): Int = x + y
def pipe_sum3(a: Int, b: Int, c: Int): Int = a + b + c

def main(): Int
  describe("pipeline operator") do ->
    it("pipes value to function") do ->
      assert_eq(5 |> pipe_double, 10)
    end
    it("chains multiple pipes") do ->
      assert_eq(5 |> pipe_double |> pipe_add_one, 11)
    end
    it("works with expressions on left side") do ->
      assert_eq((3 + 2) |> pipe_double, 10)
    end
    it("prepends piped value to existing args") do ->
      assert_eq(5 |> pipe_add(3), 8)
    end
    it("works with multiple existing args") do ->
      assert_eq(10 |> pipe_sum3(20, 30), 60)
    end
    it("works with vec_size via pipeline") do ->
      v = vec_new()
      v.push(42)
      v.push(13)
      len = v |> vec_size
      v.free()
      assert_eq(len, 2)
    end

    it("long pipeline chain") do ->
      assert_eq(1 |> pipe_double |> pipe_double |> pipe_double, 8)
    end

    it("pipe with add and double") do ->
      assert_eq(10 |> pipe_add(11) |> pipe_double, 42)
    end
  end

  return qspec_main()
end
