## Result Helpers Tests
##
## Contract:
##   1. Result_map.
##   2. Result_map_err.
##   3. Result_and_then.
##   4. Result_or.
##   5. Option_map.
##   6. Option_and_then.
##   7. Option_or.
import * from qspec

# Named helpers for and_then tests (lambda return type inference limitation)
def ok_plus_10(x: Int): Result<Int, String>
  return Result::Ok(x + 10)
end

def always_err(x: Int): Result<Int, String>
  return Result::Err("nope")
end

def some_double(x: Int): Option<Int>
  return Option::Some(x * 2)
end

def always_none(x: Int): Option<Int>
  return Option::None
end

def main(): Int
  describe("result_map") do ->
    it("maps Ok value") do ->
      var r = Result::Ok(10)
      var mapped = result_map(r, x -> x * 2)
      assert_eq(unwrap_ok(mapped), 20)
    end
    it("passes through Err") do ->
      var r = Result::Err("bad")
      var mapped = result_map(r, x -> x * 2)
      assert_eq(is_err(mapped), true)
    end
  end

  describe("result_map_err") do ->
    it("maps Err value") do ->
      var r = Result::Err(1)
      var mapped = result_map_err(r, e -> e + 100)
      assert_eq(unwrap_err(mapped), 101)
    end
    it("passes through Ok") do ->
      var r = Result::Ok(42)
      var mapped = result_map_err(r, e -> e + 100)
      assert_eq(unwrap_ok(mapped), 42)
    end
  end

  describe("result_and_then") do ->
    it("chains Ok computations") do ->
      var r = Result::Ok(5)
      var chained = result_and_then(r, ok_plus_10)
      assert_eq(unwrap_ok(chained), 15)
    end
    it("short-circuits on Err") do ->
      var r = Result::Err("fail")
      var chained = result_and_then(r, ok_plus_10)
      assert_eq(is_err(chained), true)
    end
    it("propagates Err from chain function") do ->
      var r = Result::Ok(5)
      var chained = result_and_then(r, always_err)
      assert_eq(is_err(chained), true)
    end
  end

  describe("result_or") do ->
    it("returns Ok value") do ->
      var r = Result::Ok(42)
      assert_eq(result_or(r, 0), 42)
    end
    it("returns fallback on Err") do ->
      var r = Result::Err("bad")
      assert_eq(result_or(r, 99), 99)
    end
  end

  describe("option_map") do ->
    it("maps Some value") do ->
      var o = Option::Some(10)
      var mapped = option_map(o, x -> x * 3)
      assert_eq(unwrap(mapped), 30)
    end
    it("passes through None") do ->
      var o = Option::None
      var mapped = option_map(o, x -> x * 3)
      assert_eq(is_none(mapped), true)
    end
  end

  describe("option_and_then") do ->
    it("chains Some computations") do ->
      var o = Option::Some(7)
      var chained = option_and_then(o, some_double)
      assert_eq(unwrap(chained), 14)
    end
    it("short-circuits on None") do ->
      var o = Option::None
      var chained = option_and_then(o, some_double)
      assert_eq(is_none(chained), true)
    end
    it("propagates None from chain function") do ->
      var o = Option::Some(5)
      var chained = option_and_then(o, always_none)
      assert_eq(is_none(chained), true)
    end
  end

  describe("option_or") do ->
    it("returns Some value") do ->
      var o = Option::Some(42)
      assert_eq(option_or(o, 0), 42)
    end
    it("returns fallback on None") do ->
      var o = Option::None
      assert_eq(option_or(o, 99), 99)
    end
  end

  return qspec_main()
end
