## SURF.FLOW Phase 2 — else-narrowing, guard-style early-exit, refutable-bind
## subject narrowing, and `var` narrowing with invalidate-on-reassign + closure
## barrier. SOUNDNESS is the point (FLOW_NARROWING.md §3.3): narrowing must never
## let an absent value be read as present, and must be invalidated the moment the
## proof at the guard could go stale (reassignment, mutable borrow, closure
## capture).
##
## Behavioral signal (no hard must-not-compile harness exists — the typechecker
## permissively accepts `Option<T>` where `T` is expected and produces garbage at
## runtime; see report). A narrowed read extracts the Option payload (the real
## inner value); an un-narrowed read passes the raw Option word, which for a spill
## `Option<Int>` is a large garbage pointer-ish integer (NOT the payload). So:
##   - a CORRECT narrowing yields the exact inner value (e.g. 42 → use_int → 142)
##   - a CORRECT *invalidation* yields the raw garbage word (≠ the narrowed value)
## Tests assert determinate values where narrowing should fire, and assert
## `!= narrowed_value` where invalidation must have dropped the refinement.
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

# --- else-narrowing (binary Option enum) ---

## `if o.none? ... else <o is Some>` — else-branch narrows o to inner Int.
def else_narrow_none(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o.none?
    r = -1
  else
    r = use_int(o)
  end
  return r
end

## else-narrow via `o.is_none()` UFCS.
def else_narrow_is_none(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o.is_none()
    r = -1
  else
    r = use_int(o)
  end
  return r
end

## else-narrow via `o is None`.
def else_narrow_is_keyword(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o is None
    r = -1
  else
    r = use_int(o)
  end
  return r
end

## else-narrow a niche Option<String>.
def else_narrow_niche_str(): String
  os: Option<String> = option_some("payload")
  var r = "MISS"
  if os.none?
    r = "WAS_NONE"
  else
    r = use_str(os)
  end
  return r
end

# --- guard-style negative-guard early-exit ---

## `if o.none? return end; use(o)` — o narrows to Some AFTER the guard because the
## then-branch diverges (return). Reads after the if see inner Int.
def guard_style_return(): Int
  o: Option<Int> = option_some(42)
  if o.none?
    return -1
  end
  return use_int(o)
end

## guard-style with panic-divergence in the then-branch.
def guard_style_panic(): Int
  o: Option<Int> = option_some(7)
  if o.none?
    panic("absent")
  end
  return use_int_raw(o)
end

## guard-style via `o is None` + return.
def guard_style_is_none(): Int
  o: Option<Int> = option_some(42)
  if o is None
    return -1
  end
  return use_int(o)
end

## SOUNDNESS: a NON-diverging then-branch must NOT inject a post-if fact. Here the
## then-branch just assigns, so after the if `o` is still Option (could be None on
## the false path AND the true path falls through). The read after the if must be
## un-narrowed → raw garbage word, NOT 142. We assert it is NOT the narrowed value.
def guard_style_nondiverge_no_inject(): Int
  o: Option<Int> = option_some(42)
  var y = 0
  if o.none?
    y = 1
  end
  # o NOT narrowed here — must require unwrap; a bare read is the raw word.
  return use_int(o)
end

# --- refutable-bind subject narrowing ---

## `if Some(v) = o` binds v AND narrows o; a bare read of `o` reads as inner Int.
def refutable_bind_subject(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if Some(v) = o
    # both v and bare o usable as inner Int
    r = use_int_raw(o) + v
  end
  return r
end

# --- var narrowing (Phase 2) ---

## A `var` Option narrows in the then-branch when NOT reassigned/captured.
def var_narrows_then(): Int
  var vo: Option<Int> = option_some(42)
  var r = 0
  if vo.some?
    r = use_int(vo)
  end
  return r
end

## SOUNDNESS: reassigning a narrowed `var` between check and use drops the
## narrowing. After `vo = option_some(2)`, a bare read of `vo` must be un-narrowed
## (raw garbage word), NOT the narrowed 102. If invalidation were broken, the
## stale narrow would extract the new payload (2) → 102. We assert != 102.
def var_reassign_invalidates(): Int
  var vo: Option<Int> = option_some(1)
  var r = 0
  if vo.some?
    vo = option_some(2)
    r = use_int(vo)   # invalidated: garbage; broken: 102
  end
  return r
end

## SOUNDNESS: after reassign-invalidation, the value can still be read correctly
## via explicit unwrap (vo reverted to a real Option<Int>). New payload is 2.
def var_reassign_then_unwrap(): Int
  var vo: Option<Int> = option_some(1)
  var r = 0
  if vo.some?
    vo = option_some(2)
    r = vo.unwrap()   # must read the NEW value 2
  end
  return r
end

## SOUNDNESS: compound-assign invalidates narrowing (var of inner-Int-compatible
## type). We narrow, then `+=` on a *separate* counter doesn't matter; to test
## compound-assign on the SUBJECT we'd need a numeric Option — instead we verify
## the invalidate hook fires on compound-assign of the narrowed name via a var Int
## proxy is not applicable. Compound-assign of an Option is not legal arithmetic,
## so this case is covered structurally by tc_narrow_invalidate in the
## COMPOUND_ASSIGN handler; see report. (No runtime test — Option has no +=.)

## SOUNDNESS: a `var` captured by a lambda in the narrowed region drops narrowing.
## The lambda captures `vc`; after capture a bare read of `vc` must be un-narrowed
## (garbage), NOT 142. Assert != 142.
def var_captured_invalidates(): Int
  var vc: Option<Int> = option_some(42)
  var r = 0
  if vc.some?
    f = () -> use_int_raw_opt(vc)   # captures vc → invalidate narrowing
    r = use_int(vc)                  # invalidated: garbage; broken: 142
    consume(f)
  end
  return r
end

def use_int_raw_opt(o: Option<Int>): Int = 0
def consume(f: Fn(): Int): Void = nop()
def nop(): Void = ()

## CONST captured by a lambda STAYS narrowed (const can't be reassigned). bare read
## of the captured const reads as inner Int → 142.
def const_captured_stays_narrowed(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o.some?
    g = () -> use_int_raw_opt(o)   # captures const o — narrowing survives
    r = use_int(o)                  # const stays narrowed → 142
    consume(g)
  end
  return r
end

# --- SOUNDNESS: narrowed read used WHERE Option<T> IS REQUIRED (regression
# guard for the tui_form / tui_focus_ring SIGSEGV). A narrowed read extracts the
# inner-T payload, which is a REPRESENTATION change, not a subtype. If that
# extracted scalar flows into a slot that needs the WHOLE Option<T> (struct field,
# return slot, Option-typed var, Option-annotated let), a later match/unwrap
# dereferences garbage → crash. The fix suppresses extraction at such reads, so
# the Option round-trips intact. Each function below narrows `o`, stores it into a
# wide slot, then re-inspects — the value MUST still be Some(42).

struct OptBox
  v: Option<Int>
end

## Phase-1-shape: narrow in then-branch, store into a struct Option field.
def narrowed_into_struct_field(): Int
  o: Option<Int> = option_some(42)
  var b = OptBox { v: option_none<Int>() }
  if o.some?
    b = OptBox { v: o }   # o is narrowed here; field needs Option<Int>
  end
  match b.v
    Some(x) => return x
    None    => return -1
  end
end

## Guard-style shape (the exact tui_focus_ring `focus_ring_set` pattern):
## negative guard early-exit, then re-wrap the narrowed subject into an Option slot.
def guard_style_rewrap_into_field(): Int
  o: Option<Int> = option_some(42)
  if o is None
    return -1
  end
  var b = OptBox { v: o }   # post-guard o is narrowed; field needs Option<Int>
  match b.v
    Some(x) => return x
    None    => return -2
  end
end

## else-narrowed subject re-wrapped into an Option slot.
def else_narrowed_into_field(): Int
  o: Option<Int> = option_some(42)
  var b = OptBox { v: option_none<Int>() }
  if o.none?
    b = OptBox { v: option_none<Int>() }
  else
    b = OptBox { v: o }   # else-narrowed o; field needs Option<Int>
  end
  match b.v
    Some(x) => return x
    None    => return -1
  end
end

## Returning a narrowed subject where the return type is Option<Int>.
def return_narrowed_as_option(): Option<Int>
  o: Option<Int> = option_some(42)
  if o is None
    return option_none<Int>()
  end
  return o   # narrowed o returned into an Option<Int> return slot
end

def return_narrowed_as_option_check(): Int
  match return_narrowed_as_option()
    Some(x) => return x
    None    => return -1
  end
end

## Assigning a narrowed subject into an Option-typed var.
def assign_narrowed_into_option_var(): Int
  o: Option<Int> = option_some(42)
  var sink: Option<Int> = option_none<Int>()
  if o.some?
    sink = o   # narrowed o assigned into an Option<Int> var
  end
  match sink
    Some(x) => return x
    None    => return -1
  end
end

def main(): Int
  describe("SURF.FLOW Phase 2 — else-narrowing (binary Option)") do ->
    it("narrows o to inner T in the else of o.none?") do ->
      assert_eq(else_narrow_none(), 142)
    end
    it("narrows via .is_none() else") do ->
      assert_eq(else_narrow_is_none(), 142)
    end
    it("narrows via `is None` else") do ->
      assert_eq(else_narrow_is_keyword(), 142)
    end
    it("narrows a niche Option<String> in the else") do ->
      assert_eq_str(else_narrow_niche_str(), "payload")
    end
  end

  describe("SURF.FLOW Phase 2 — guard-style early-exit") do ->
    it("narrows after `if o.none? return end`") do ->
      assert_eq(guard_style_return(), 142)
    end
    it("narrows after `if o.none? panic end`") do ->
      assert_eq(guard_style_panic(), 7)
    end
    it("narrows after `if o is None return end`") do ->
      assert_eq(guard_style_is_none(), 142)
    end
    it("does NOT inject a post-if fact when the then-branch does not diverge") do ->
      # un-narrowed raw Option word must not equal the narrowed value 142
      assert_eq(guard_style_nondiverge_no_inject() == 142, false)
    end
  end

  describe("SURF.FLOW Phase 2 — refutable-bind subject") do ->
    it("narrows the subject x in `if Some(v) = x`") do ->
      # use_int_raw(o)=42 narrowed + v=42 = 84
      assert_eq(refutable_bind_subject(), 84)
    end
  end

  describe("SURF.FLOW Phase 2 — var narrowing + soundness invalidation") do ->
    it("narrows a var in the then-branch when not reassigned/captured") do ->
      assert_eq(var_narrows_then(), 142)
    end
    it("drops narrowing when the var is reassigned (no stale payload)") do ->
      assert_eq(var_reassign_invalidates() == 102, false)
    end
    it("still reads the reassigned var correctly via explicit unwrap") do ->
      assert_eq(var_reassign_then_unwrap(), 2)
    end
    it("drops narrowing when the var is captured by a lambda") do ->
      assert_eq(var_captured_invalidates() == 142, false)
    end
    it("keeps narrowing when a CONST is captured by a lambda") do ->
      assert_eq(const_captured_stays_narrowed(), 142)
    end
  end

  describe("SURF.FLOW Phase 2 — SOUNDNESS: narrowed read into a wide Option slot") do ->
    it("then-narrowed o stored into a struct Option field round-trips") do ->
      assert_eq(narrowed_into_struct_field(), 42)
    end
    it("guard-style narrowed o re-wrapped into an Option field round-trips") do ->
      assert_eq(guard_style_rewrap_into_field(), 42)
    end
    it("else-narrowed o stored into a struct Option field round-trips") do ->
      assert_eq(else_narrowed_into_field(), 42)
    end
    it("narrowed o returned as Option<Int> round-trips") do ->
      assert_eq(return_narrowed_as_option_check(), 42)
    end
    it("narrowed o assigned into an Option<Int> var round-trips") do ->
      assert_eq(assign_narrowed_into_option_var(), 42)
    end
  end

  return qspec_main()
end
