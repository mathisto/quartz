## Visibility Tests
##
## Contract:
##   1. Public by default: functions, structs, enums, type aliases, traits.
##   2. Private section: `private` keyword marks boundary.
##   3. Private items: not exported, not visible from other modules.
##   4. Internal access: private items callable within same module.
##   5. Import behavior: only public items imported.
##   6. File organization: all-public OK, no toggling back, no double-private.
##   7. Error: private items from outside = compile error.

import * from qspec
import vis_module
import vis_extended_module
import math_helper

def main(): Int
  describe("public by default") do ->
    it("functions are public by default") do ->
      assert_eq(vis_module::vis_public_fn(), 42)
    end

    it("structs are public by default") do ->
      p = VisPoint { x: 10, y: 20 }
      assert_eq(p.x + p.y, 30)
    end

    it("enums are public by default") do ->
      c = VisColor::Green
      assert_eq(vis_classify(c), 2)
    end

    it("type aliases are public by default") do ->
      var files: Vec = vec_new()
      files.push(as_int("ta_vis_mod.qz"))
      vec_push(files, as_int("""
        type VisAlias = Int
        def vis_alias_get(): VisAlias
          return 42
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import ta_vis_mod
        def main(): Int = ta_vis_mod::vis_alias_get()
        """))
      assert_multi_run_exits(files, 1, 42)
    end
    it("traits are public by default (multi-module test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("vis_trait_mod.qz"))
      vec_push(files, as_int("""
        trait PubTrait
          def get_val(): Int
            return 0
          end
        end
        struct VTBox
          val: Int
        end
        extend VTBox with PubTrait
          def get_val(): Int
            return 42
          end
        end
        def make_vtbox(): VTBox
          return VTBox { val: 42 }
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import vis_trait_mod
        def main(): Int
          b = vis_trait_mod::make_vtbox()
          return b.val
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("private section") do ->
    it("private keyword marks start of private section") do ->
      assert_eq(vis_module::vis_public_fn(), 42)
    end

    it("functions after private are not exported") do ->
      assert_compile_error_with_fixtures("""
        import math_helper
        def main(): Int
          return math_helper::math_internal()
        end
        """, "has no function")
    end
    it("structs after private are not exported (multi-module test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("pmod.qz"))
      vec_push(files, as_int("""
        struct PubStruct
          x: Int
        end
        private
        struct PrivStruct
          y: Int
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import pmod
        def main(): Int
          s = PrivStruct { y: 42 }
          return s.y
        end
        """))
      assert_multi_compile_error(files, 1, "Unknown struct")
    end
    it("enums after private are not exported (multi-module test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("emod.qz"))
      vec_push(files, as_int("""
        enum PubEnum
          A
          B
        end
        private
        enum PrivEnum
          X
          Y
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import emod
        def main(): Int
          c = PrivEnum::X
          return 0
        end
        """))
      assert_multi_compile_error(files, 1, "Unknown enum")
    end
    it("private section lasts until end of file (multi-module test)") do ->
      assert_compile_error_with_fixtures("""
        import vis_extended_module
        def main(): Int
          return vis_extended_module::vis_ext_private_fn()
        end
        """, "has no function")
    end
    it("cannot toggle back to public after private (compile-error test)") do ->
      assert_compile_fails("""
        def foo(): Int = 1
        private
        def bar(): Int = 2
        public
        def baz(): Int = 3
        def main(): Int
          return foo()
        end
        """)
    end
  end

  describe("internal access") do ->
    it("private functions callable within same module") do ->
      assert_run_exits("""
        def caller(): Int = helper()
        private
        def helper(): Int = 42
        def main(): Int = caller()
        """, 42)
    end
    it("public functions can call private functions") do ->
      assert_eq(vis_module::vis_public_add(20, 22), 42)
    end
    it("private functions can call other private functions") do ->
      assert_run_exits("""
        private
        def a(): Int = b()
        def b(): Int = 42
        def main(): Int = a()
        """, 42)
    end
    it("private structs usable within same module (multi-module test)") do ->
      assert_eq(vis_extended_module::vis_ext_use_priv(), 99)
    end
  end

  describe("import behavior") do ->
    it("imports only public definitions") do ->
      assert_eq(vis_module::vis_public_fn(), 42)
    end

    it("does not import private definitions (multi-module/IR test)") do ->
      assert_compile_error_with_fixtures("""
        import vis_extended_module
        def main(): Int
          return vis_extended_module::vis_ext_private_fn()
        end
        """, "has no function")
    end
    it("errors when accessing private function from outside") do ->
      assert_compile_error_with_fixtures("""
        import math_helper
        def main(): Int
          return math_helper::math_internal()
        end
        """, "has no function")
    end
    it("errors when accessing private struct from outside (compile-error test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("smod.qz"))
      vec_push(files, as_int("""
        struct Visible
          v: Int
        end
        private
        struct Hidden
          h: Int
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import smod
        def main(): Int
          s = Hidden { h: 1 }
          return s.h
        end
        """))
      assert_multi_compile_error(files, 1, "Unknown struct")
    end
    it("errors when accessing private enum from outside (compile-error test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("emod2.qz"))
      vec_push(files, as_int("""
        enum Visible
          A
        end
        private
        enum Hidden
          X
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import emod2
        def main(): Int
          c = Hidden::X
          return 0
        end
        """))
      assert_multi_compile_error(files, 1, "Unknown enum")
    end
  end

  describe("file organization") do ->
    it("allows all public (no private keyword)") do ->
      assert_eq(math_helper::math_add(1, 2), 3)
    end

    it("allows public section then private section") do ->
      assert_eq(vis_module::vis_public_fn(), 42)
    end

    it("errors on public keyword") do ->
      assert_compile_fails("""
        public
        def main(): Int
          return 0
        end
        """)
    end
    it("errors on private keyword appearing twice") do ->
      assert_compile_fails("""
        def foo(): Int = 1
        private
        def bar(): Int = 2
        private
        def baz(): Int = 3
        def main(): Int
          return foo() + bar() + baz()
        end
        """)
    end
  end

  return qspec_main()
end

def vis_classify(c: VisColor): Int
  return match c
    VisColor::Red => 1
    VisColor::Green => 2
    VisColor::Blue => 3
    _ => 0
  end
end
