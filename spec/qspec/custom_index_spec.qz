## Custom Index Tests
##
## Contract:
##   1. Negative indexing still works.
##   2. Obj[key] dispatches to type$get.
##   3. Obj[key]=val dispatches to type$set.
##   4. Vec index assignment is.
##   5. Vec indexing is unaffected.
import * from qspec

struct Box
  val: Int
end

extend Box
  def get(key: Int): Int
    return self.val + key
  end
  def set(&mut self, key: Int, value: Int): Void
    self.val = value + key
  end
end

def main(): Int
  describe("custom index trait") do ->
    it("obj[key] dispatches to Type$get") do ->
      var b = Box { val: 100 }
      assert_eq(b[5], 105)
    end
    it("obj[key]=val dispatches to Type$set") do ->
      var b = Box { val: 0 }
      b[5] = 100
      assert_eq(b.val, 105)
    end
    it("Vec indexing is unaffected") do ->
      var v = [10, 20, 30]
      assert_eq(v[1], 20)
    end
    it("Vec index assignment is unaffected") do ->
      var v = [10, 20, 30]
      v[0] = 42
      assert_eq(v[0], 42)
    end
    it("negative indexing still works") do ->
      var v = [10, 20, 30]
      assert_eq(v[-1], 30)
    end
  end
  return qspec_main()
end
