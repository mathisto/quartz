## Mutable Closure Capture-by-Reference (R-WS3)
##
## Contract:
##   Closures capture immutable (read-only) locals BY VALUE (unchanged), but a
##   SCALAR local that the closure body REASSIGNS (a bare `x = …`) inside a
##   NON-ESCAPING higher-order combinator (`each`/`map`/`reduce`/…) is captured
##   BY REFERENCE — the mutation writes through to the caller's slot and PERSISTS.
##
##   1. Scalar Int capture mutation persists through `.each`.
##   2. Multi-capture: two mutated scalars in separate closures each persist.
##   3. Mut + read capture in ONE closure: mut writes through, read snapshots.
##   4. Read-only (immutable) capture control: unchanged, still reads correctly.
##   5. Accumulator idioms (count, running product) persist.
import * from qspec

def main(): Int
  describe("mutable closure capture-by-reference") do ->
    it("scalar Int capture mutation persists through each") do ->
      var total = 0
      [1, 2, 3].each { total = total + it }
      assert_eq(total, 6)
    end

    it("running sum over larger list persists") do ->
      var total = 0
      [10, 20, 30, 40].each { total = total + it }
      assert_eq(total, 100)
    end

    it("count via conditional accumulate persists") do ->
      var n = 0
      [1, 2, 3, 4, 5, 6].each { if it > 3 { n = n + 1 } end }
      assert_eq(n, 3)
    end

    it("multi-capture: two independent mutated scalars each persist") do ->
      var sum = 0
      var cnt = 0
      [5, 7, 9].each { sum = sum + it }
      [1, 1, 1, 1].each { cnt = cnt + it }
      assert_eq(sum, 21)
      assert_eq(cnt, 4)
    end

    it("mut + read capture in one closure: mut writes through, read snapshots") do ->
      var base = 100
      var tally = 0
      [1, 2, 3].each { tally = tally + it + base }
      # (1+100)+(2+100)+(3+100) = 306; base read-only, unchanged.
      assert_eq(tally, 306)
      assert_eq(base, 100)
    end

    it("read-only capture control: capture unchanged, reads correctly") do ->
      var ro = 42
      var out = 0
      [1, 2].each { out = out + ro }
      assert_eq(out, 84)
      assert_eq(ro, 42)
    end

    it("running product accumulator persists") do ->
      var prod = 1
      [2, 3, 4].each { prod = prod * it }
      assert_eq(prod, 24)
    end

    it("nested each: inner mutation persists into outer accumulator") do ->
      var grand = 0
      [1, 2].each { grand = grand + it }
      [3, 4].each { grand = grand + it }
      assert_eq(grand, 10)
    end
  end

  return qspec_main()
end
