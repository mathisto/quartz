## QSpec coverage for the first migrated callsite — `_fz_random_var`
## in `std/fuzz/gen.qz` (Phase A.8 Pass 2). Pass 2 routes the bare
## `rand_range(...)` call through the Random effect's `rand_range_op`
## so test handlers can override the PRNG without touching global
## xoshiro state.
##
## This spec validates the test-handler value prop end-to-end:
## installing a custom `rand_range_op` handler that returns a fixed
## index, then invoking a function that calls into `_fz_random_var`,
## then asserting the returned variable name matches expectations.

import * from qspec
import std/random
import std/fuzz/gen

# --- Module-level state captured by the mock handler.
var _captured_calls = 0
var _forced_index = 0

def _reset_capture(): Void
  _captured_calls = 0
end

# Mock rand_range_op: ignores (lo, hi), always returns _forced_index.
def _capture_range(op_name: Int, argc: Int, argv: Int): Int
  _captured_calls = _captured_calls + 1
  return _forced_index
end

# --- Test 1: with no override installed, _fz_random_var picks an index
#     in [0, env.local_vars.size). Just assert the call returns one of
#     the registered names; the exact pick is PRNG-dependent.

def t1_run(): Void
  rand_seed_op(42)
  var env = fuzz_env_new(fuzz_config_default())
  env.local_vars.push("a")
  env.local_vars.push("b")
  env.local_vars.push("c")
  var v = _fz_random_var(env)
  if v.eq("a") or v.eq("b") or v.eq("c")
    puts("pick_in_range")
  else
    puts("pick_out_of_range=#{v}")
  end
end

# --- Test 2: with handler installed, _fz_random_var uses the forced
#     index. _forced_index=0 → first var. _forced_index=2 → third var.

def t2_run(): Void
  _reset_capture()
  _forced_index = 0
  var env = fuzz_env_new(fuzz_config_default())
  env.local_vars.push("zero")
  env.local_vars.push("one")
  env.local_vars.push("two")
  var first = ""
  var third = ""
  with Random { rand_range_op: _capture_range } do ->
    first = _fz_random_var(env)
    _forced_index = 2
    third = _fz_random_var(env)
  end
  puts("first=#{first} third=#{third} calls=#{_captured_calls}")
end

# --- Test 3: post-with calls fall back to the default xoshiro PRNG.
#     The override counter does NOT advance after the wrap exits.

def t3_run(): Void
  _reset_capture()
  _forced_index = 1
  rand_seed_op(7)
  var env = fuzz_env_new(fuzz_config_default())
  env.local_vars.push("x")
  env.local_vars.push("y")
  env.local_vars.push("z")
  var inside = ""
  with Random { rand_range_op: _capture_range } do ->
    inside = _fz_random_var(env)
  end
  var outside = _fz_random_var(env)
  if outside.eq("x") or outside.eq("y") or outside.eq("z")
    puts("inside=#{inside} outside_in_range calls=#{_captured_calls}")
  else
    puts("outside_invalid=#{outside}")
  end
end

# --- Test 4: empty local_vars — short-circuits before any rand_range_op
#     call. Returns "0" (the literal sentinel for empty environment).

def t4_run(): Void
  _reset_capture()
  var env = fuzz_env_new(fuzz_config_default())
  with Random { rand_range_op: _capture_range } do ->
    var v = _fz_random_var(env)
    puts("empty=#{v} calls=#{_captured_calls}")
  end
end

def main(): Int
  describe("Random Pass 2 — migrated _fz_random_var callsite") do ->
    it("default handler picks a valid index") do ->
      assert_output("pick_in_range\n", t1_run)
    end

    it("custom handler forces the index") do ->
      assert_output("first=zero third=two calls=2\n", t2_run)
    end

    it("post-with calls fall through to default xoshiro") do ->
      assert_output("inside=y outside_in_range calls=1\n", t3_run)
    end

    it("empty local_vars short-circuits before rand_range_op") do ->
      assert_output("empty=0 calls=0\n", t4_run)
    end
  end
  return qspec_main()
end
