## Regression spec for concrete generic instantiations at type-annotation
## positions (CONCRETE_GENERIC_AT_TYPE_ANNOTATION_REJECTED).
##
## Pre-fix: a function with a generic return type (e.g. `def make_g<T>(): G<T>`)
## had its return TypeId computed via `tc_parse_type("G<T>")`, which constructs
## a ptype `(TYPE_STRUCT, tc_parse_type("T"), 0)`. Since `tc_parse_type` only
## recognised trait-level type params (not function-level ones), the inner T
## resolved to TYPE_ERROR — so the registered return type was
## `ptype(TYPE_STRUCT, TYPE_ERROR, 0)`. A consumer annotating `G<String>` got
## `ptype(TYPE_STRUCT, TYPE_STRING, 0)`. Different ptypes → tc_types_match
## returned false → "expected unknown but got unknown" QZ0200 mismatches at
## every consumer that annotated the concrete instantiation.
##
## Fix: at the call site for a generic function with explicit type args, we
## now substitute the function's type params with the call's concrete args
## in the registered return annotation and re-parse to a TypeId. The call's
## return type now matches the consumer's annotated type at return-type and
## struct-field positions.

import * from qspec

struct CGBox<T>
  v: Vec<T>
end

def cgbox_make<T>(): CGBox<T>
  return CGBox<T> { v: vec_new<T>() }
end

def cgbox_make_str_annot(): CGBox<String>
  return cgbox_make<String>()
end

def cgbox_make_str_inferred()
  return cgbox_make<String>()
end

struct CGState
  cards: CGBox<String>
  status: String
end

def cgstate_status(): String
  var s = CGState { cards: cgbox_make<String>(), status: "ok" }
  return s.status
end

def main(): Int
  describe("concrete generic instantiations at type-annotation positions") do ->

    it("compiles a return-type annotation Generic<Concrete>") do ->
      var a = cgbox_make_str_annot()
      assert_eq(a.v.size, 0)
    end

    it("does not regress the inferred-return form") do ->
      var b = cgbox_make_str_inferred()
      assert_eq(b.v.size, 0)
    end

    it("compiles a struct field of type Generic<Concrete>") do ->
      assert_eq_str(cgstate_status(), "ok")
    end

  end
  return qspec_main()
end
