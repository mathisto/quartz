## SURF.FLOW A3 — CF-terminating (divergence) set for guard-style early-exit.
## Guard-style early-exit narrows the ENCLOSING scope AFTER an `if` whose
## then-branch cannot fall through: `if o.none? <diverge> end; use(o)` narrows
## `o` to Some, because control reaches statements after the `if` only when the
## guard was false. The divergence predicate is `tc_stmt_diverges`
## (typecheck_walk.qz). This spec pins EXACTLY which terminating forms inject the
## else-fact:
##   - `return`   (covered in flow_narrow_p2_spec — the baseline)
##   - `panic(...)` (call named panic — also in p2)
##   - `throw(...)` (call named throw — the unwinding effect-op sibling of panic;
##                   matched by NAME, since its declared return type is NOT Never)
##   - a call to a `Never`-returning function (bottom-typed divergence) — the A3
##     gap this spec was written to close (recognized via tc_lookup_function_return)
##
## Behavioral signal (identical to flow_narrow_p2_spec): a CORRECTLY narrowed read
## extracts the Option payload (the real inner Int, e.g. 42 → use_int → 142); an
## un-narrowed read passes the raw Option word (garbage for a spilled Option<Int>).
## Every test asserts the determinate narrowed value, so it is non-vacuous — the
## narrowed `o` is used as the Some payload after the guard.
import * from qspec

# `throw` is an algebraic effect operation (the blessed Throws effect). A bare
# `throw(msg)` from an untracked function fires the default main handler
# (piezo D.4), unwinding control flow — so it terminates its enclosing block.
def use_int(x: Int): Int = x + 100
def use_rec(x: Int): Int = x

# A user-defined divergent function whose body never returns normally.
# Its return type is `Never` (the bottom type), so a call to it in statement
# position must be recognized as diverging by tc_stmt_diverges.
def never_returns(): Never
  panic("unreachable")
end

# --- throw-based guard-exit ---

## `if o.none? throw(...) end; use(o)` — the then-branch unwinds via `throw`, so
## after the guard `o` narrows to Some Int.
def guard_style_throw(): Int
  o: Option<Int> = option_some(42)
  if o.none?
    throw("absent")
  end
  return use_int(o)
end

## throw guard-exit reading the narrowed payload raw (no + offset), to prove the
## extracted inner value is exactly 7 (not a garbage Option word).
def guard_style_throw_raw(): Int
  o: Option<Int> = option_some(7)
  if o.none?
    throw("absent")
  end
  return use_rec(o)
end

# --- panic-based guard-exit (re-pinned here for completeness of the set) ---

def guard_style_panic_cfterm(): Int
  o: Option<Int> = option_some(42)
  if o.none?
    panic("absent")
  end
  return use_int(o)
end

# --- Never-returning-call guard-exit ---

## `if o.none? never_returns() end; use(o)` — the then-branch calls a
## Never-returning function. If tc_stmt_diverges recognizes bottom-typed calls as
## diverging, `o` narrows to Some after the guard.
def guard_style_never_call(): Int
  o: Option<Int> = option_some(42)
  if o.none?
    never_returns()
  end
  return use_int(o)
end

def main(): Int
  describe("SURF.FLOW A3 — CF-terminating guard-exit set") do ->
    it("narrows after `if o.none? throw ... end`") do ->
      assert_eq(guard_style_throw(), 142)
    end
    it("extracts the exact Some payload after a throw guard-exit") do ->
      assert_eq(guard_style_throw_raw(), 7)
    end
    it("narrows after `if o.none? panic ... end`") do ->
      assert_eq(guard_style_panic_cfterm(), 142)
    end
    it("narrows after `if o.none? <Never-returning call> end`") do ->
      assert_eq(guard_style_never_call(), 142)
    end
  end

  return qspec_main()
end
