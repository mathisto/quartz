## Vec Higher-Order UFCS Tests
##
## Contract: All collection intrinsics work with Vec dot syntax.

import * from qspec

def double(x: Int): Int = x * 2
def is_even(x: Int): Bool = x % 2 == 0
def is_gt3(x: Int): Bool = x > 3
def add(a: Int, b: Int): Int = a + b

def main(): Int
  describe("Vec higher-order UFCS") do ->
    it("v.map(f) transforms elements") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var result = v.map(double)
      assert_eq(result.size, 3)
      assert_eq(result[0], 2)
      assert_eq(result[1], 4)
      assert_eq(result[2], 6)
    end

    it("v.filter(pred) keeps matching") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      var evens = v.filter(is_even)
      assert_eq(evens.size, 2)
      assert_eq(evens[0], 2)
      assert_eq(evens[1], 4)
    end

    it("v.reduce(init, f) folds") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      assert_eq(v.reduce(0, add), 6)
    end

    it("v.each(f) iterates") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      v.each { it }
      assert_eq(v.size, 2)
    end

    it("v.find(pred) returns first match") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(5)
      v.push(3)
      assert_eq(v.find(is_gt3), 5)
    end

    it("v.count(pred) counts matches") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      assert_eq(v.count(is_even), 2)
    end

    it("v.any?(pred) and v.all?(pred)") do ->
      var v = vec_new<Int>()
      v.push(2)
      v.push(4)
      v.push(6)
      assert_eq(v.any?(is_even), true)
      assert_eq(v.all?(is_even), true)
      assert_eq(v.any?(is_gt3), true)
      assert_eq(v.all?(is_gt3), false)
    end

    it("v.first() and v.last()") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v.first(), 10)
      assert_eq(v.last(), 30)
    end

    it("v.take(n) returns first n") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      var t = v.take(2)
      assert_eq(t.size, 2)
      assert_eq(t[0], 1)
      assert_eq(t[1], 2)
    end

    it("v.sum() and v.product()") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      assert_eq(v.sum(), 6)
      assert_eq(v.product(), 6)
    end

    it("v.map with lambda") do ->
      var v = vec_new<Int>()
      v.push(5)
      v.push(10)
      var result = v.map { it + 1 }
      assert_eq(result[0], 6)
      assert_eq(result[1], 11)
    end

    it("v.filter with lambda") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var odds = v.filter { it % 2 == 1 }
      assert_eq(odds.size, 2)
    end
  end

  return qspec_main()
end
