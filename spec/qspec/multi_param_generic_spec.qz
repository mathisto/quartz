## Multi-parameter generic function dispatch tests (F.2 Gap #4)

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("multi-param generic functions") do ->
    it("f<T,U> calling single-param generics dispatches correctly per param") do ->
      assert_run_exits(mpg_two_param_src(), 30)
    end
    it("three-param generic dispatches independently") do ->
      assert_run_exits(mpg_three_param_src(), 60)
    end
  end
  return qspec_main()
end

def mpg_two_param_src(): String = """
  trait Scorable
    def score(x: Int): Int
      return 0
    end
  end
  struct Player
    pts: Int
  end
  struct Enemy
    pts: Int
  end
  extend Player with Scorable
    def score(x: Int): Int
      return 10
    end
  end
  extend Enemy with Scorable
    def score(x: Int): Int
      return 20
    end
  end
  def get_score<T: Scorable>(hint: T, x: Int): Int
    return score(x)
  end
  def both_scores<T: Scorable, U: Scorable>(a: T, b: U): Int
    return get_score(a, 0) + get_score(b, 0)
  end
  def main(): Int
    p = Player { pts: 0 }
    e = Enemy { pts: 0 }
    return both_scores(p, e)
  end
  """

def mpg_three_param_src(): String = """
  trait Scorable
    def score(x: Int): Int
      return 0
    end
  end
  struct Player
    pts: Int
  end
  struct Enemy
    pts: Int
  end
  struct Boss
    pts: Int
  end
  extend Player with Scorable
    def score(x: Int): Int
      return 10
    end
  end
  extend Enemy with Scorable
    def score(x: Int): Int
      return 20
    end
  end
  extend Boss with Scorable
    def score(x: Int): Int
      return 30
    end
  end
  def get_score<T: Scorable>(hint: T, x: Int): Int
    return score(x)
  end
  def all_scores<T: Scorable, U: Scorable, V: Scorable>(a: T, b: U, c: V): Int
    return get_score(a, 0) + get_score(b, 0) + get_score(c, 0)
  end
  def main(): Int
    p = Player { pts: 0 }
    e = Enemy { pts: 0 }
    b = Boss { pts: 0 }
    return all_scores(p, e, b)
  end
  """
