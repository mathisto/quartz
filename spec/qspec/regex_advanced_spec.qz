## Regex Advanced Tests
##
## Contract:
##   1. =~? captures by index.
##   2. =~? returns 0 on.
##   3. =~? returns non-zero on.
##   4. Captures by name (named.
##   5. Match with regex arms.
##   6. Matches {n,m} range.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("regex advanced") do ->
    it("=~? returns non-zero on match") do ->
      assert_run_exits("""
        def main(): Int
          var c = "hello123" =~? ~r"([0-9]+)"
          if c != 0
            return 1
          end
          return 0
        end
        """, 1)
    end
    it("=~? returns 0 on no match") do ->
      assert_run_exits("""
        def main(): Int
          var c = "hello" =~? ~r"([0-9]+)"
          if c == 0
            return 1
          end
          return 0
        end
        """, 1)
    end
    it("=~? captures by index") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var c = "hello123world" =~? ~r"([a-z]+)([0-9]+)"
          puts(as_string(vec_get(c, 0)))
          puts(as_string(vec_get(c, 1)))
          puts(as_string(vec_get(c, 2)))
          return 0
        end
        """, "hello123\nhello\n123\n")
    end
    it("captures by name (named groups)") do ->
      assert_eq(rxa_capture_named(), 0)
    end
    it("match with regex arms") do ->
      assert_run_exits("""
        def classify(s: String): Int
          match s
            ~r"^[0-9]+$" => return 1
            ~r"^[a-z]+$" => return 2
            _ => return 0
          end
        end
        def main(): Int = classify("42")
        """, 1)
    end
    it("provides full matched string") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var c = "foo123bar" =~? ~r"([0-9]+)"
          puts(as_string(vec_get(c, 0)))
          return 0
        end
        """, "123\n")
    end
    it("provides capture groups") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var c = "2026-02-22" =~? ~r"([0-9]{4})-([0-9]{2})-([0-9]{2})"
          puts(as_string(vec_get(c, 1)))
          puts(as_string(vec_get(c, 2)))
          puts(as_string(vec_get(c, 3)))
          return 0
        end
        """, "2026\n02\n22\n")
    end
    it("regex_find_all returns matching strings") do ->
      assert_eq(rxa_find_all(), 0)
    end
    it("regex_replace replaces first") do ->
      assert_eq(rxa_replace(), 0)
    end
    it("regex_replace_all replaces all") do ->
      assert_eq(rxa_replace_all(), 0)
    end
    it("regex_split splits on pattern") do ->
      assert_eq(rxa_split(), 0)
    end
    it("regex_count counts occurrences") do ->
      assert_eq(rxa_count(), 0)
    end
    it("matches {n} exact count") do ->
      assert_eq(rxa_exact_count(), 0)
    end
    it("matches {n,m} range") do ->
      assert_eq(rxa_range_count(), 0)
    end
    it("matches {n,} unbounded") do ->
      assert_eq(rxa_unbounded_count(), 0)
    end
    it("non-capturing group (?:...)") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var count = regex_matches("abcdef abcdef", "(?:abc)def")
          puts(to_str(count))
          return 0
        end
        """, "2\n")
    end
    it("backreference \\1") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var count = regex_matches("abab cdcd abab", "(ab)\\1")
          puts(to_str(count))
          return 0
        end
        """, "2\n")
    end
    it("regex_matches no match") do ->
      assert_eq(rxa_matches_no_match(), 0)
    end
    it("regex_matches single match") do ->
      assert_eq(rxa_matches_single(), 0)
    end
    it("regex_matches multiple matches") do ->
      assert_eq(rxa_matches_multiple(), 0)
    end
    it("regex_matches iterate") do ->
      assert_eq(rxa_matches_iterate(), 0)
    end
    it("regex_matches accumulates values") do ->
      assert_eq(rxa_matches_accum(), 0)
    end
    it("regex_matches empty string") do ->
      assert_eq(rxa_matches_empty(), 0)
    end
  end
  return qspec_main()
end

def rxa_capture_named(): Int
  var name = regex_capture_named("John is 30 years old", "(?P<name>[A-Za-z]+) is (?P<age>[0-9]+)", "name")
  if name != "John"
    return 1
  end
  var age = regex_capture_named("John is 30 years old", "(?P<name>[A-Za-z]+) is (?P<age>[0-9]+)", "age")
  if age != "30"
    return 2
  end
  return 0
end

def rxa_find_all(): Int
  var matches = regex_find_all("abc123def456ghi789", "[0-9]+")
  if matches.size != 3
    return 1
  end
  if as_string(matches[0]) != "123"
    return 2
  end
  if as_string(matches[1]) != "456"
    return 3
  end
  if as_string(matches[2]) != "789"
    return 4
  end
  return 0
end

def rxa_split(): Int
  var parts = regex_split("one::two::three", "::")
  if parts.size != 3
    return 1
  end
  if as_string(parts[0]) != "one"
    return 2
  end
  if as_string(parts[1]) != "two"
    return 3
  end
  if as_string(parts[2]) != "three"
    return 4
  end
  return 0
end

def rxa_matches_no_match(): Int
  var count = regex_matches("hello world", "[0-9]+")
  if count == 0
    return 0
  end
  return 1
end

def rxa_matches_single(): Int
  var matches = regex_find_all("hello123world", "[0-9]+")
  if matches.size != 1
    return 1
  end
  if as_string(matches[0]) == "123"
    return 0
  end
  return 2
end

def rxa_matches_multiple(): Int
  var matches = regex_find_all("a1b2c3", "[0-9]")
  if matches.size != 3
    return 1
  end
  if as_string(matches[0]) == "1"
    if as_string(matches[1]) == "2"
      if as_string(matches[2]) == "3"
        return 0
      end
    end
  end
  return 2
end

def rxa_matches_iterate(): Int
  var matches = regex_find_all("x1y2z3", "[0-9]")
  var count = 0
  var i = 0
  while i < matches.size
    count += 1
    i += 1
  end
  if count == 3
    return 0
  end
  return 1
end

def rxa_matches_accum(): Int
  var matches = regex_find_all("x10y20z30", "[0-9]+")
  var total = 0
  var i = 0
  while i < matches.size
    total += str_to_int(as_string(matches[i]))
    i += 1
  end
  if total == 60
    return 0
  end
  return 1
end

def rxa_matches_empty(): Int
  var count = regex_matches("", "[0-9]+")
  if count == 0
    return 0
  end
  return 1
end

## Test: {n} exact count quantifier
def rxa_exact_count(): Int
  # "aaa" matches a{3}
  var a = regex_count("aaa", "^a{3}$")
  if a != 1
    return 1
  end
  # "aa" does NOT match a{3} (too few)
  var b = regex_count("aa", "^a{3}$")
  if b != 0
    return 2
  end
  # regex_replace confirms it works
  var s = regex_replace("aaabbb", "a{3}", "X")
  if s != "Xbbb"
    return 3
  end
  return 0
end

## Test: {n,m} range quantifier
def rxa_range_count(): Int
  # "aaa" matches a{2,4}
  var a = regex_count("aaa", "^a{2,4}$")
  if a != 1
    return 1
  end
  # "a" does NOT match a{2,4} (too few)
  var b = regex_count("a", "^a{2,4}$")
  if b != 0
    return 2
  end
  # regex_replace to verify greedy matching
  var s = regex_replace("abbbb", "b{2,4}", "Y")
  if s != "aY"
    return 3
  end
  return 0
end

## Test: {n,} unbounded quantifier
def rxa_unbounded_count(): Int
  # "aaaa" matches a{2,}
  var a = regex_count("aaaa", "^a{2,}$")
  if a != 1
    return 1
  end
  # "a" does NOT match a{2,} (too few)
  var b = regex_count("a", "^a{2,}$")
  if b != 0
    return 2
  end
  # regex_replace confirms it works
  var s = regex_replace("ccccc", "c{2,}", "Z")
  if s != "Z"
    return 3
  end
  return 0
end

def rxa_replace(): Int
  var s = regex_replace("hello world", "world", "quartz")
  if s != "hello quartz"
    return 1
  end
  return 0
end

def rxa_replace_all(): Int
  var s = regex_replace_all("aXbXcX", "X", "Y")
  if s != "aYbYcY"
    return 1
  end
  return 0
end

def rxa_count(): Int
  var c = regex_count("hello world hello", "hello")
  if c != 2
    return 1
  end
  return 0
end

