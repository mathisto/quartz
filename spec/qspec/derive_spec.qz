## @derive Tests
## Tests @derive(Eq, Hash, Show, Clone, Ord) macro expansion on structs.
##
## Contract:
##   1. @derive(Eq).
##   2. @derive(Hash).
##   3. @derive(Show).
##   4. @derive(Clone).
##   5. @derive(Ord).
##   6. @derive multiple traits.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("@derive(Eq)") do ->
    it("compares two equal structs") do ->
      assert_run_exits(derive_eq_equal_src(), 1)
    end

    it("compares two unequal structs") do ->
      assert_run_exits(derive_eq_unequal_src(), 0)
    end

    it("handles String fields with str_eq") do ->
      assert_run_exits(derive_eq_string_src(), 1)
    end
  end

  describe("@derive(Hash)") do ->
    it("produces consistent hashes") do ->
      assert_run_exits(derive_hash_src(), 1)
    end

    it("produces different hashes for different values") do ->
      assert_run_exits(derive_hash_diff_src(), 0)
    end
  end

  describe("@derive(Show)") do ->
    it("formats struct fields") do ->
      assert_run_stdout_eq(derive_show_src(), "Point(x=10, y=20)\n")
    end
  end

  describe("@derive(Clone)") do ->
    it("clones a struct") do ->
      assert_run_exits(derive_clone_src(), 1)
    end
  end

  describe("@derive(Ord)") do ->
    it("lexicographic less-than comparison") do ->
      assert_run_exits(derive_ord_src(), 1)
    end

    it("tiebreaking on second field") do ->
      assert_run_exits(derive_ord_tie_src(), 1)
    end
  end

  describe("@derive multiple traits") do ->
    it("derives Eq and Hash together") do ->
      assert_run_exits(derive_multi_src(), 1)
    end

    it("derives all five traits") do ->
      assert_run_exits(derive_all_five_src(), 1)
    end

    it("empty struct derives Eq") do ->
      assert_run_exits(derive_empty_src(), 1)
    end

    it("single-field struct derives Show") do ->
      assert_run_stdout_eq(derive_single_field_show_src(), "Score(val=99)\n")
    end

    it("coexists with manual impl") do ->
      assert_run_exits(derive_coexist_src(), 1)
    end

    it("struct with 5+ fields") do ->
      assert_run_exits(derive_many_fields_src(), 1)
    end
  end

  return qspec_main()
end

# ============================================================================
# Source helpers — named functions for subprocess test source generation
# ============================================================================

def derive_eq_equal_src(): String
  return """
    import traits
    @derive(Eq)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 10, y: 20 }
      b = Point { x: 10, y: 20 }
      return Point::op_eq(a, b)
    end
    """
end

def derive_eq_unequal_src(): String
  return """
    import traits
    @derive(Eq)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 10, y: 20 }
      b = Point { x: 10, y: 99 }
      return Point::op_eq(a, b)
    end
    """
end

def derive_eq_string_src(): String
  return """
    import traits
    @derive(Eq)
    struct Named
      name: String
      age: Int
    end
    def main(): Int
      a = Named { name: "Alice", age: 30 }
      b = Named { name: "Alice", age: 30 }
      return Named::op_eq(a, b)
    end
    """
end

def derive_hash_src(): String
  return """
    import traits
    @derive(Hash)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 10, y: 20 }
      b = Point { x: 10, y: 20 }
      if Point::hash(a) == Point::hash(b)
        return 1
      end
      return 0
    end
    """
end

def derive_hash_diff_src(): String
  return """
    import traits
    @derive(Hash)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 10, y: 20 }
      b = Point { x: 99, y: 1 }
      if Point::hash(a) == Point::hash(b)
        return 1
      end
      return 0
    end
    """
end

def derive_show_src(): String
  return """
    import traits
    @derive(Show)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      p = Point { x: 10, y: 20 }
      puts(Point::show(p))
      return 0
    end
    """
end

def derive_clone_src(): String
  return """
    import traits
    @derive(Eq, Clone)
    struct Pair
      a: Int
      b: Int
    end
    def main(): Int
      p = Pair { a: 20, b: 22 }
      q = Pair::clone(p)
      return Pair::op_eq(p, q)
    end
    """
end

def derive_ord_src(): String
  return """
    import traits
    @derive(Ord)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 1, y: 2 }
      b = Point { x: 3, y: 4 }
      return Point::op_lt(a, b)
    end
    """
end

def derive_ord_tie_src(): String
  return """
    import traits
    @derive(Ord)
    struct Point
      x: Int
      y: Int
    end
    def main(): Int
      a = Point { x: 5, y: 1 }
      b = Point { x: 5, y: 9 }
      return Point::op_lt(a, b)
    end
    """
end

def derive_multi_src(): String
  return """
    import traits
    @derive(Eq, Hash)
    struct Val
      n: Int
    end
    def main(): Int
      a = Val { n: 42 }
      b = Val { n: 42 }
      eq_ok = Val::op_eq(a, b)
      var hash_ok = 0
      if Val::hash(a) == Val::hash(b)
        hash_ok = 1
      end
      if eq_ok and hash_ok == 1
        return 1
      end
      return 0
    end
    """
end

def derive_all_five_src(): String
  return """
    import traits
    @derive(Eq, Hash, Show, Clone, Ord)
    struct Num
      val: Int
    end
    def main(): Int
      a = Num { val: 5 }
      b = Num { val: 5 }
      eq_ok = Num::op_eq(a, b)
      var hash_ok = 0
      if Num::hash(a) == Num::hash(b)
        hash_ok = 1
      end
      var show_ok = 0
      if str_size(Num::show(a)) > 0
        show_ok = 1
      end
      c = Num::clone(a)
      clone_ok = Num::op_eq(a, c)
      var ord_ok = 0
      d = Num { val: 10 }
      if Num::op_lt(a, d)
        ord_ok = 1
      end
      if eq_ok and hash_ok == 1 and show_ok == 1 and clone_ok and ord_ok == 1
        return 1
      end
      return 0
    end
    """
end

def derive_empty_src(): String
  return """
    import traits
    @derive(Eq)
    struct Empty
    end
    def main(): Int
      a = Empty {}
      b = Empty {}
      return Empty::op_eq(a, b)
    end
    """
end

def derive_single_field_show_src(): String
  return """
    import traits
    @derive(Show)
    struct Score
      val: Int
    end
    def main(): Int
      p = Score { val: 99 }
      puts(Score::show(p))
      return 0
    end
    """
end

def derive_coexist_src(): String
  return """
    import traits
    @derive(Eq)
    struct Val
      n: Int
    end
    extend Val with Hash
      def hash(x: Int): Int
        return x * 7
      end
    end
    def main(): Int
      a = Val { n: 42 }
      b = Val { n: 42 }
      return Val::op_eq(a, b)
    end
    """
end

def derive_many_fields_src(): String
  return """
    import traits
    @derive(Eq)
    struct Big
      a: Int
      b: Int
      c: Int
      d: Int
      e: Int
    end
    def main(): Int
      x = Big { a: 1, b: 2, c: 3, d: 4, e: 5 }
      y = Big { a: 1, b: 2, c: 3, d: 4, e: 5 }
      return Big::op_eq(x, y)
    end
    """
end
