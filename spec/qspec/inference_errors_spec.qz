## Type Inference Error Message Tests
##
## Contract:
##   1. Pushing conflicting types into vec_new() Vec produces QZ0203.
##   2. Explicit vec_new<T>() with wrong push still produces existing errors.
##   3. Bare vec_new() + consistent pushes compiles successfully.
##   4. QZ0203 mentions the variable name and both type names.
##   5. vec_set with conflicting element type produces QZ0203.
##   6. Explain text for QZ0203 renders correctly.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("type inference errors") do ->
    describe("QZ0203: type inference conflict") do ->
      it("rejects pushing Int then String into vec_new() Vec") do ->
        assert_compile_error("""
          def main(): Int
            var items = vec_new()
            items.push(42)
            items.push("hello")
            return 0
          end
        """, "Type inference conflict")
      end

      it("error message includes variable name") do ->
        assert_compile_error("""
          def main(): Int
            var data = vec_new()
            data.push(1)
            data.push("x")
            return 0
          end
        """, "data")
      end

      it("error message includes both type names") do ->
        assert_compile_error("""
          def main(): Int
            var nums = vec_new()
            nums.push(42)
            nums.push("world")
            return 0
          end
        """, "Int")
      end

      it("vec_set with conflicting type produces QZ0203") do ->
        assert_compile_error("""
          def main(): Int
            var items = vec_new()
            items.push(42)
            items.set(0, "oops")
            return 0
          end
        """, "Type inference conflict")
      end
    end

    describe("backward compatibility") do ->
      it("bare vec_new() + consistent pushes compiles") do ->
        assert_run_exits("""
          def main(): Int
            var items = vec_new()
            items.push(1)
            items.push(2)
            items.push(3)
            return items.size
          end
        """, 3)
      end

      it("explicit vec_new<Int>() + push String still errors") do ->
        assert_compile_error("""
          def main(): Int
            var items = vec_new<Int>()
            items.push("hello")
            return 0
          end
        """, "expected element type")
      end
    end
  end

  return qspec_main()
end
