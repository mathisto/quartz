## arm64 TPIDR Intrinsics Tests (EPIC SYS.1 item 7 — arm64 piece)
##
## Contract:
##   1. `tls_read_tpidr_el1()` emits `mrs x, tpidr_el1` via inline asm.
##      LLVM lowers this to a single `mrs` system-register read. Used
##      by arm64 kernels for per-CPU variable base pointer.
##   2. `tls_read_tpidr_el0()` emits `mrs x, tpidr_el0`. Used for
##      userspace TLS access (same register pthread uses for its
##      thread descriptor on Linux/Apple).
##   3. `tls_write_tpidr_el1(val)` / `tls_write_tpidr_el0(val)` emit
##      `msr tpidr_elX, x` inline asm.
##   4. All four calls are marked `sideeffect` so LLVM doesn't
##      sink / CSE / DCE them. Writing TPIDR is a real state
##      change; reads can alias the register at different points.
##
## Pairs with the x86 fs/gs TLS slice (commit e31aba4e). Same
## Quartz surface shape (int offsets or values, int return) —
## different arch-level mechanism (mrs/msr vs segment prefixes).
##
## Cross-arch expectation: these are inline-asm calls specific to
## aarch64. Compiling a program that uses them against an x86_64
## triple will fail at llc time with "invalid instruction mnemonic"
## — which is correct: callers must gate arm64-only code behind
## `@cfg(target_arch: "aarch64")` or target-specific modules.
import * from qspec

def main(): Int
  describe("arm64 TPIDR intrinsics (SYS.1 item 7)") do ->
    it("tls_read_tpidr_el1 emits mrs tpidr_el1 inline asm") do ->
      assert_ir_contains("""
def main(): Int
  var v = tls_read_tpidr_el1()
  return v
end
""", "mrs $0, tpidr_el1")
    end

    it("tls_read_tpidr_el0 emits mrs tpidr_el0 inline asm") do ->
      assert_ir_contains("""
def main(): Int
  var v = tls_read_tpidr_el0()
  return v
end
""", "mrs $0, tpidr_el0")
    end

    it("tls_write_tpidr_el1 emits msr tpidr_el1 inline asm") do ->
      assert_ir_contains("""
def main(): Int
  tls_write_tpidr_el1(42)
  return 0
end
""", "msr tpidr_el1, $0")
    end

    it("tls_write_tpidr_el0 emits msr tpidr_el0 inline asm") do ->
      assert_ir_contains("""
def main(): Int
  tls_write_tpidr_el0(42)
  return 0
end
""", "msr tpidr_el0, $0")
    end

    it("asm calls are marked sideeffect to prevent DCE") do ->
      # A non-sideeffect asm read would be eligible for dead-code
      # elimination if its result isn't used. For register reads
      # that can observe external state changes between calls,
      # that's wrong. Verify the marker is in the emitted IR.
      assert_ir_contains("""
def main(): Int
  var v = tls_read_tpidr_el1()
  return v
end
""", "asm sideeffect")
    end

    it("el1 and el0 reads use distinct register names") do ->
      # Regression check — swap in codegen would emit wrong
      # register. el1 reader must not contain "tpidr_el0".
      assert_ir_not_contains("""
def main(): Int
  var v = tls_read_tpidr_el1()
  return v
end
""", "tpidr_el0")
    end
  end

  return qspec_main()
end
