## Scoped FileGuard — B.8 Phase 5 (release ≠ release_on_throw asymmetry).
##
## Contract:
##   1. `with file_scoped(path, "w") do h -> body end` opens the file on
##      acquire, closes on normal exit. The body's writes are committed.
##   2. On throw inside a write-mode Scoped block, the file is closed
##      AND deleted (atomic-rollback) — observers see no partial-write.
##   3. On throw inside a read-mode Scoped block, the file is closed but
##      NOT deleted — read-only access never modifies the file.
##   4. Sequential acquire/release on the same path works correctly.
##   5. The bound `h` is the FILE* handle and can be used with fwrite /
##      fread inside the body.

import * from qspec
import * from std/io/file
import * from std/throws

# --- Helpers ------------------------------------------------------------

def b8_file_test_path(suffix: String): String
  return "/tmp/quartz_b8_file_" + suffix + ".tmp"
end

def b8_file_remove_if_exists(path: String): Void
  if file_exists(path)
    var ignore = file_delete(path)
  end
end

# --- Test 1: normal exit commits writes. --------------------------------

def b8_file_normal_exit_commits(): Int
  var path = b8_file_test_path("commit")
  b8_file_remove_if_exists(path)
  with file_scoped(path, "w") do h ->
    var bytes = fwrite(h, "alpha", 5)
  end
  # Normal exit: file should exist with content.
  if not file_exists(path)
    return 1  # Fail: file missing.
  end
  var content = read_file(path)
  var len = str_byte_len(content)
  b8_file_remove_if_exists(path)
  return len
end

# --- Test 2: sequential normal-exit blocks (open/close/open/close). -----

def b8_file_sequential_normal_exit(): Int
  var path = b8_file_test_path("sequential")
  b8_file_remove_if_exists(path)
  with file_scoped(path, "w") do h ->
    var bytes = fwrite(h, "first", 5)
  end
  with file_scoped(path, "w") do h ->
    var bytes = fwrite(h, "secnd", 5)
  end
  var content = read_file(path)
  var len = str_byte_len(content)
  b8_file_remove_if_exists(path)
  return len
end

# --- Phase 4b throw-safety / asymmetry tests ----------------------------

var b8_file_caught = 0

def b8_file_capture_throw(op_name: Int, argc: Int, argv: Int): Int
  b8_file_caught += 1
  return 0
end

# --- Test 3: throw in write-mode block deletes the file. ----------------

def b8_file_throw_write_deletes_file(): Int
  var path = b8_file_test_path("rollback")
  b8_file_remove_if_exists(path)
  with Throws { throw: b8_file_capture_throw } do ->
    with file_scoped(path, "w") do h ->
      var bytes = fwrite(h, "partial-data", 12)
      throw("mid-write")
    end
    0
  end
  # release_on_throw should have deleted the file. exists == false.
  var still_exists = 0
  if file_exists(path)
    still_exists = 1
  end
  b8_file_remove_if_exists(path)
  return still_exists  # 0 expected (rolled back).
end

# --- Test 4: throw in read-mode block does NOT delete the file. ---------

def b8_file_throw_read_keeps_file(): Int
  var path = b8_file_test_path("readkeep")
  b8_file_remove_if_exists(path)
  # Pre-create the file so we have something to read.
  var setup_bytes = write_file(path, "preexisting")
  with Throws { throw: b8_file_capture_throw } do ->
    with file_scoped(path, "r") do h ->
      var content = fread(h, 5)
      throw("mid-read")
    end
    0
  end
  # release_on_throw on read-mode should NOT have deleted the file.
  var still_exists = 0
  if file_exists(path)
    still_exists = 1
  end
  b8_file_remove_if_exists(path)
  return still_exists  # 1 expected (read-only access doesn't delete).
end

# --- Test 5: lock released after throw (subsequent open succeeds). ------

def b8_file_throw_releases_handle(): Int
  var path = b8_file_test_path("reopen")
  b8_file_remove_if_exists(path)
  with Throws { throw: b8_file_capture_throw } do ->
    with file_scoped(path, "w") do h ->
      var bytes = fwrite(h, "abc", 3)
      throw("kaboom")
    end
    0
  end
  # File was deleted; reopening + writing should succeed.
  with file_scoped(path, "w") do h ->
    var bytes = fwrite(h, "fresh", 5)
  end
  var content = read_file(path)
  var len = str_byte_len(content)
  b8_file_remove_if_exists(path)
  return len
end

def main(): Int
  describe("Scoped FileGuard — B.8 Phase 5") do ->
    it("normal exit commits writes; file exists with content") do ->
      assert_eq(b8_file_normal_exit_commits(), 5)
    end

    it("sequential normal-exit blocks open/close cleanly") do ->
      assert_eq(b8_file_sequential_normal_exit(), 5)
    end

    it("throw in write-mode block deletes the partial-write file") do ->
      assert_eq(b8_file_throw_write_deletes_file(), 0)
    end

    it("throw in read-mode block does NOT delete the file") do ->
      assert_eq(b8_file_throw_read_keeps_file(), 1)
    end

    it("throw releases handle; subsequent open + write succeeds") do ->
      assert_eq(b8_file_throw_releases_handle(), 5)
    end
  end

  return qspec_main()
end
