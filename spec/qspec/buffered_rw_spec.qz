## Buffered Rw Tests
##
## Contract:
##   1. BufferedReader.
##   2. BufferedWriter.
import * from qspec
import * from io/buffered

def main(): Int
  describe("BufferedReader") do ->
    it("reads lines from file") do ->
      assert_eq(br_read_lines_test(), 1)
    end

    it("detects EOF") do ->
      assert_eq(br_eof_test(), 1)
    end

    it("reads bytes") do ->
      assert_eq(br_read_byte_test(), 1)
    end

    it("reads n bytes") do ->
      assert_eq(br_read_n_test(), 1)
    end
  end

  describe("BufferedWriter") do ->
    it("writes and flushes") do ->
      assert_eq(bw_write_test(), 1)
    end

    it("write_line appends newline") do ->
      assert_eq(bw_write_line_test(), 1)
    end

    it("auto-flushes on close") do ->
      assert_eq(bw_close_test(), 1)
    end
  end

  return qspec_main()
end

def br_read_lines_test(): Int
  # Write a test file first
  var wh = open_file("/tmp/qz_br_lines.txt", "w")
  file_write_line(wh, "alpha\n")
  file_write_line(wh, "beta\n")
  file_write_line(wh, "gamma\n")
  close_file(wh)
  # Read with BufferedReader
  var rh = open_file("/tmp/qz_br_lines.txt", "r")
  var reader = buffered_reader_new(rh)
  var l1 = reader.read_line()
  var l2 = reader.read_line()
  var l3 = reader.read_line()
  reader.close()
  file_delete("/tmp/qz_br_lines.txt")
  if l1 == "alpha"
    if l2 == "beta"
      if l3 == "gamma"
        return 1
      end
    end
  end
  return 0
end

def br_eof_test(): Int
  var wh = open_file("/tmp/qz_br_eof.txt", "w")
  file_write_line(wh, "only\n")
  close_file(wh)
  var rh = open_file("/tmp/qz_br_eof.txt", "r")
  var reader = buffered_reader_new(rh)
  var l1 = reader.read_line()
  var l2 = reader.read_line()
  var eof = reader.is_eof()
  reader.close()
  file_delete("/tmp/qz_br_eof.txt")
  if l1 == "only"
    if l2.size == 0
      if eof
        return 1
      end
    end
  end
  return 0
end

def br_read_byte_test(): Int
  var wh = open_file("/tmp/qz_br_byte.txt", "w")
  fwrite(wh, "AB", 2)
  close_file(wh)
  var rh = open_file("/tmp/qz_br_byte.txt", "r")
  var reader = buffered_reader_new(rh)
  var a = reader.read_byte()
  var b = reader.read_byte()
  reader.close()
  file_delete("/tmp/qz_br_byte.txt")
  # 'A' = 65, 'B' = 66
  if a == 65
    if b == 66
      return 1
    end
  end
  return 0
end

def br_read_n_test(): Int
  var wh = open_file("/tmp/qz_br_rn.txt", "w")
  fwrite(wh, "hello world", 11)
  close_file(wh)
  var rh = open_file("/tmp/qz_br_rn.txt", "r")
  var reader = buffered_reader_new(rh)
  var chunk = reader.read_n(5)
  reader.close()
  file_delete("/tmp/qz_br_rn.txt")
  if chunk == "hello"
    return 1
  end
  return 0
end

def bw_write_test(): Int
  var wh = open_file("/tmp/qz_bw_write.txt", "w")
  var writer = buffered_writer_new(wh)
  writer.write_str("hello")
  writer.write_str(" world")
  writer.flush()
  writer.close()
  var content = read_file("/tmp/qz_bw_write.txt")
  file_delete("/tmp/qz_bw_write.txt")
  if content == "hello world"
    return 1
  end
  return 0
end

def bw_write_line_test(): Int
  var wh = open_file("/tmp/qz_bw_wl.txt", "w")
  var writer = buffered_writer_new(wh)
  writer.write_line("hello")
  writer.close()
  var content = read_file("/tmp/qz_bw_wl.txt")
  file_delete("/tmp/qz_bw_wl.txt")
  if content == "hello\n"
    return 1
  end
  return 0
end

def bw_close_test(): Int
  var wh = open_file("/tmp/qz_bw_close.txt", "w")
  var writer = buffered_writer_new(wh)
  writer.write_str("auto flush")
  writer.close()
  var content = read_file("/tmp/qz_bw_close.txt")
  file_delete("/tmp/qz_bw_close.txt")
  if content == "auto flush"
    return 1
  end
  return 0
end
