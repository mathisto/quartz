## Lint Integration Tests
##
## End-to-end tests for the full lint pipeline:
## QZ7303 (missing else), JSON output, --explain, suppression edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint integration (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("QZ7303: Missing else branch") do ->

    it("detects missing else in tail position") do ->
      src = "def foo(x: Int): Int\n  if x > 0\n    return 1\n  end\nend\n"
      assert_lint_warns(src, "QZ7303")
    end

    it("no warning on Void function") do ->
      src = "def foo(x: Int): Void\n  if x > 0\n    puts(\"yes\")\n  end\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7303")
        _record_failure("QZ7303 should not fire on Void function")
      end
    end

    it("no warning when else exists") do ->
      src = "def foo(x: Int): Int\n  if x > 0\n    return 1\n  else\n    return 0\n  end\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7303")
        _record_failure("QZ7303 should not fire when else exists")
      end
    end

    it("no warning on non-tail if") do ->
      src = "def foo(x: Int): Int\n  if x > 0\n    puts(\"positive\")\n  end\n  return x\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7303")
        _record_failure("QZ7303 should not fire on non-tail if")
      end
    end
  end

  describe("JSON output") do ->

    it("produces JSON with --error-format json") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var src = "/tmp/qz_int_json.qz"
      var out = "/tmp/qz_int_json.out"
      var err = "/tmp/qz_int_json.err"
      write_file(src, "def main(): Int\n  var x = 42\n  return 0\nend\n")
      system(compiler + " lint --error-format json " + src + " > " + out + " 2> " + err)
      var stderr = read_file(err)
      # JSON output should contain the code in a structured format
      assert_eq(str_contains(stderr, "QZ7004"), true)
      file_delete(src)
      file_delete(out)
      file_delete(err)
    end
  end

  describe("--explain for lint codes") do ->

    it("explains QZ7004") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var out = "/tmp/qz_int_explain.out"
      system(compiler + " --explain QZ7004 > " + out + " 2>/dev/null")
      var output = read_file(out)
      assert_eq(str_contains(output, "Unused Variable"), true)
      file_delete(out)
    end

    it("explains QZ7303") do ->
      _sub_init()
      var compiler = _sub_compiler_str
      var out = "/tmp/qz_int_explain2.out"
      system(compiler + " --explain QZ7303 > " + out + " 2>/dev/null")
      var output = read_file(out)
      assert_eq(str_contains(output, "Missing Else"), true)
      file_delete(out)
    end
  end

  describe("Suppression edge cases") do ->

    it("suppression does not affect other lines") do ->
      src = "def main(): Int\n  # lint:disable QZ7004\n  var x = 42\n  var y = 99\n  return 0\nend\n"
      # x is suppressed (line 3, comment on line 2), but y is NOT (line 4)
      r = subprocess_lint(src)
      # Should still warn about y
      assert_eq(str_contains(r.stderr_content, "QZ7004"), true)
    end

    it("disable all suppresses everything on that line") do ->
      src = "def main(): Int   \n  # lint:disable all\n  var x = 42\n  return 0\nend\n"
      r = subprocess_lint(src)
      # The trailing ws on line 1 should still fire (not on line 3)
      # The unused var on line 3 should be suppressed
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("QZ7004 should be suppressed by lint:disable all")
      end
    end
  end

  describe("Multiple rule categories in one file") do ->

    it("reports Tier 1 and Tier 2 warnings together") do ->
      src = "def main(): Int   \n  var x = 42\n  if true\n    return 1\n  end\n  return 0\nend\n"
      r = subprocess_lint(src)
      # Should have Tier 1 (QZ7106 trailing ws) and Tier 2 (QZ7004 unused, QZ7403 const cond)
      assert_eq(str_contains(r.stderr_content, "QZ7106"), true)
      assert_eq(str_contains(r.stderr_content, "QZ7004"), true)
      assert_eq(str_contains(r.stderr_content, "QZ7403"), true)
    end
  end

  return qspec_main()
end
