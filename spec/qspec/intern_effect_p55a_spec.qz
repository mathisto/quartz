## std/intern — Intern effect acceptance spec.
##
## Operation Piezoelectric Effects, Phase 5, Milestone 5.5.
##
## Verifies the Intern effect declared in std/intern.qz: intern/resolve
## ops are kind=1 (function-kind), the handler ABI is the standard
## (op_name, argc, argv) shape, and custom handlers can substitute the
## entire interner backing store for test isolation. The default handler
## forwards to string_intern::intern_global() — bare intern(s) inside a
## `with Intern { intern: intern_default_handler, ... }` block behaves
## exactly like string_intern::intern_id(intern_global(), s).
##
## Blessed-relaxed at typecheck: bare `intern(...)` / `resolve(...)`
## outside a `with Intern` wrap passes typecheck without needing
## `can Intern` on the caller — the compiler installs an ambient
## Intern handler at compile() entry (wrapping the typecheck pass),
## so all migrated typecheck_registry sites are covered without per-
## caller annotations. At runtime, bare calls outside any install
## fire the unhandled-op path (no main-prelude install, unlike
## FileIo). User programs wanting deterministic behavior install
## their own `with Intern { intern: ..., resolve: ... } do ... end`
## block.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("std/intern — Intern effect (piezo 5.5)") do ->
    it("default handler interns via global singleton") do ->
      assert_run_stdout_eq("""
import std/intern

def main(): Int
  with Intern {
    intern: intern_default_handler,
    resolve: intern_default_handler
  } do ->
    var id1 = intern("hello")
    var id2 = intern("hello")
    var id3 = intern("world")
    # Dedup: same string → same id
    if id1 == id2
      puts("dedup-ok")
    end
    # Different strings → different ids
    if id1 != id3
      puts("distinct-ok")
    end
    puts(resolve(id1))
    puts(resolve(id3))
  end
  return 0
end
""", "dedup-ok\ndistinct-ok\nhello\nworld\n")
    end

    it("custom handler substitutes backing interner") do ->
      assert_run_stdout_eq("""
import std/intern

var g_count = 0

def counting_intern(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  g_count = g_count + 1
  puts("intern #" + g_count.to_s() + ": " + s)
  return g_count * 100
end

def main(): Int
  with Intern { intern: counting_intern } do ->
    var a = intern("foo")
    var b = intern("bar")
    puts("a=" + a.to_s())
    puts("b=" + b.to_s())
  end
  return 0
end
""", "intern #1: foo\nintern #2: bar\na=100\nb=200\n")
    end

    it("can-rowed intermediate caller threads Intern through") do ->
      assert_run_stdout_eq("""
import std/intern

def register(name: String): Int can Intern
  return intern(name)
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  puts("got: " + s)
  return 777
end

def main(): Int
  with Intern { intern: cap } do ->
    var id = register("test")
    puts("id=" + id.to_s())
  end
  return 0
end
""", "got: test\nid=777\n")
    end

    it("resolve op round-trips with default handler") do ->
      assert_run_stdout_eq("""
import std/intern

def main(): Int
  with Intern {
    intern: intern_default_handler,
    resolve: intern_default_handler
  } do ->
    var id = intern("roundtrip")
    var back = resolve(id)
    puts(back)
  end
  return 0
end
""", "roundtrip\n")
    end

    it("bare intern outside with-block typechecks (blessed-relaxed)") do ->
      # P5.5.a: Intern is typecheck-blessed because the compiler wraps
      # compile() in an ambient install. Bare `intern(s)` passes
      # typecheck without `can Intern`. This mirrors FileIo's D.4
      # relaxation. Runtime semantics are undefined without an install
      # (no main-prelude default for Intern) — but the compile
      # succeeds.
      assert_compile_succeeds("""
import std/intern

def main(): Int
  with Intern {
    intern: intern_default_handler,
    resolve: intern_default_handler
  } do ->
    var id = intern("ok")
    puts(id.to_s())
  end
  return 0
end
""")
    end
  end
  return qspec_main()
end
