## Adversarial Collection Tests (TEST.2 Phase 2)
##
## Contract: Boundary conditions for Vec and Map operations.
##   1. Empty Vec operations.
##   2. Vec capacity and growth.
##   3. Nested collections.
##   4. Map with edge-case keys.
##   5. Collection size invariants.

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Empty Vec Operations
  # ==========================================================================
  describe("empty Vec operations") do ->
    it("new Vec has size 0") do ->
      var v = vec_new()
      assert_eq(v.size, 0)
    end

    it("push to empty Vec works") do ->
      var v = vec_new()
      v.push(42)
      assert_eq(v.size, 1)
      assert_eq(v[0], 42)
    end

    it("multiple pushes grow correctly") do ->
      var v = vec_new()
      for i in 0..100
        v.push(i)
      end
      assert_eq(v.size, 100)
      assert_eq(v[0], 0)
      assert_eq(v[99], 99)
    end
  end

  # ==========================================================================
  # Vec Capacity and Growth
  # ==========================================================================
  describe("Vec growth") do ->
    it("Vec handles 1000 elements") do ->
      var v = vec_new()
      for i in 0..1000
        v.push(i)
      end
      assert_eq(v.size, 1000)
      assert_eq(v[999], 999)
    end

    it("Vec maintains order after many pushes") do ->
      var v = vec_new()
      for i in 0..50
        v.push(i * 3)
      end
      assert_eq(v[0], 0)
      assert_eq(v[10], 30)
      assert_eq(v[49], 147)
    end

    it("Vec pop returns last element") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      result = v.pop()
      assert_eq(result ?? -1, 30)
      assert_eq(v.size, 2)
    end

    it("Vec pop on single-element Vec") do ->
      var v = vec_new()
      v.push(42)
      result = v.pop()
      assert_eq(result ?? -1, 42)
      assert_eq(v.size, 0)
    end
  end

  # ==========================================================================
  # Vec with Negative and Zero Values
  # ==========================================================================
  describe("Vec with negative/zero values") do ->
    it("Vec stores negative values") do ->
      var v = vec_new()
      v.push(-42)
      v.push(-1)
      v.push(0)
      assert_eq(v[0], -42)
      assert_eq(v[1], -1)
      assert_eq(v[2], 0)
    end

    it("Vec stores zero without confusion") do ->
      var v = vec_new()
      v.push(0)
      v.push(0)
      v.push(0)
      assert_eq(v.size, 3)
      assert_eq(v[0], 0)
    end

    forall_i("push/get roundtrip for any Int") do x: Int ->
      var v = vec_new()
      v.push(x)
      assert_eq(v[0], x)
    end
  end

  # ==========================================================================
  # Map Edge Cases
  # ==========================================================================
  describe("Map edge cases") do ->
    it("Map with string keys") do ->
      var m = map_new()
      m.set("neg", 100)
      m.set("zero", 200)
      match m.get("neg")
        Some(v) => assert_eq(v, 100)
        None => assert_eq(0, 1)
      end
      match m.get("zero")
        Some(v) => assert_eq(v, 200)
        None => assert_eq(0, 1)
      end
    end

    it("Map overwrite replaces value") do ->
      var m = map_new()
      m.set("key", 100)
      m.set("key", 200)
      match m.get("key")
        Some(v) => assert_eq(v, 200)
        None => assert_eq(0, 1)
      end
    end

    it("Map get on missing key returns None") do ->
      var m = map_new()
      m.set("exists", 100)
      match m.get("missing")
        Some(v) => assert_eq(0, 1)
        None => assert_eq(1, 1)
      end
    end

    it("Map delete removes key") do ->
      var m = map_new()
      m.set("del", 100)
      m.delete("del")
      match m.get("del")
        Some(v) => assert_eq(0, 1)
        None => assert_eq(1, 1)
      end
    end

    it("Map handles many entries") do ->
      var m = map_new()
      for i in 0..100
        m.set(str_from_int(i), i * 10)
      end
      match m.get("0")
        Some(v) => assert_eq(v, 0)
        None => assert_eq(0, 1)
      end
      match m.get("50")
        Some(v) => assert_eq(v, 500)
        None => assert_eq(0, 1)
      end
      match m.get("99")
        Some(v) => assert_eq(v, 990)
        None => assert_eq(0, 1)
      end
    end
  end

  # ==========================================================================
  # Collection Size Invariants
  # ==========================================================================
  describe("collection size invariants") do ->
    forall_i("Vec size is non-negative after operations") do n: Int ->
      var count = n % 20
      if count < 0
        count = 0 - count
      end
      var v = vec_new()
      for i in 0..count
        v.push(i)
      end
      qspec_assert(v.size >= 0)
      assert_eq(v.size, count)
    end
  end

  return qspec_main()
end
