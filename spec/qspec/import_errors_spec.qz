## Import Error Tests - Verifies clear error messages for import failures
##
## Contract:
##   1. Calling wrong arity on.
##   2. Import of valid module.
##   3. Missing module gives error.
##   4. Missing wildcard import source.
##   5. Multiple imports from valid.
##   6. Private function access rejected.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("import error messages") do ->
    it("missing module gives error") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import nonexistent\ndef main(): Int = 0"))
      assert_multi_compile_error(files, 0, "nonexistent")
    end

    it("private function access rejected") do ->
      var files: Vec = vec_new()
      files.push(as_int("lib.qz"))
      vec_push(files, as_int("def public_fn(): Int = 1\nprivate\ndef secret(): Int = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import lib\ndef main(): Int\n  return lib::secret()\nend"))
      assert_multi_compile_error(files, 1, "has no function")
    end

    it("private struct not accessible cross-module") do ->
      var files: Vec = vec_new()
      files.push(as_int("lib.qz"))
      vec_push(files, as_int("private\nstruct Hidden\n  val: Int\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import lib\ndef main(): Int\n  var h = lib::Hidden{val: 1}\n  return h.val\nend"))
      assert_multi_compile_error(files, 1, "Unknown struct")
    end

    it("undefined function in import chain") do ->
      var files: Vec = vec_new()
      files.push(as_int("lib.qz"))
      files.push(as_int("def existing(): Int = 1"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import lib\ndef main(): Int\n  return lib::nonexistent()\nend"))
      assert_multi_compile_error(files, 1, "has no function")
    end

    it("import of valid module compiles") do ->
      var files: Vec = vec_new()
      files.push(as_int("helper.qz"))
      files.push(as_int("def helper_fn(): Int = 7"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import helper\ndef main(): Int\n  return helper::helper_fn()\nend"))
      assert_multi_run_exits(files, 1, 7)
    end

    it("wildcard import of valid module compiles") do ->
      var files: Vec = vec_new()
      files.push(as_int("util.qz"))
      files.push(as_int("def util_val(): Int = 33"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from util\ndef main(): Int\n  return util_val()\nend"))
      assert_multi_run_exits(files, 1, 33)
    end

    it("multiple imports from valid modules compile") do ->
      var files: Vec = vec_new()
      files.push(as_int("a.qz"))
      files.push(as_int("def a_fn(): Int = 1"))
      files.push(as_int("b.qz"))
      files.push(as_int("def b_fn(): Int = 2"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import a\nimport b\ndef main(): Int\n  return a::a_fn() + b::b_fn()\nend"))
      assert_multi_run_exits(files, 2, 3)
    end

    it("public function accessible across modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("pub.qz"))
      files.push(as_int("def public_helper(): Int = 100"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import pub\ndef main(): Int\n  return pub::public_helper()\nend"))
      assert_multi_run_exits(files, 1, 100)
    end

    it("two modules can import the same third module") do ->
      var files: Vec = vec_new()
      files.push(as_int("shared.qz"))
      files.push(as_int("def shared_val(): Int = 5"))
      files.push(as_int("user1.qz"))
      vec_push(files, as_int("import shared\ndef u1_fn(): Int\n  return shared::shared_val()\nend"))
      files.push(as_int("user2.qz"))
      vec_push(files, as_int("import shared\ndef u2_fn(): Int\n  return shared::shared_val()\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import user1\nimport user2\ndef main(): Int\n  return user1::u1_fn() + user2::u2_fn()\nend"))
      assert_multi_run_exits(files, 3, 10)
    end

    it("missing wildcard import source gives error") do ->
      var files: Vec = vec_new()
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from ghost\ndef main(): Int = 0"))
      assert_multi_compile_error(files, 0, "ghost")
    end

    it("calling wrong arity on imported function errors") do ->
      var files: Vec = vec_new()
      files.push(as_int("helper.qz"))
      vec_push(files, as_int("def greet(name: String): Int\n  puts(name)\n  return 0\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from helper\ndef main(): Int\n  greet(\"a\", \"b\")\n  return 0\nend"))
      assert_multi_compile_error(files, 1, "arguments")
    end

    it("mutual imports compile successfully") do ->
      var files: Vec = vec_new()
      files.push(as_int("a.qz"))
      vec_push(files, as_int("import * from b\ndef a_func(): Int = 1"))
      files.push(as_int("b.qz"))
      vec_push(files, as_int("import * from a\ndef b_func(): Int = 2"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import a\ndef main(): Int\n  return a::a_func()\nend"))
      assert_multi_run_exits(files, 2, 1)
    end
    it("transitive import error shows import chain") do ->
      var files: Vec = vec_new()
      files.push(as_int("child.qz"))
      vec_push(files, as_int("import nonexistent\ndef child_fn(): Int = 1"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import child\ndef main(): Int\n  return child::child_fn()\nend"))
      assert_multi_compile_error(files, 1, "imported via")
    end

    it("import with alias syntax") do ->
      var files: Vec = vec_new()
      files.push(as_int("mymod.qz"))
      files.push(as_int("def helper_val(): Int = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import mymod as m\ndef main(): Int\n  return m::helper_val()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  return qspec_main()
end

