## Phase 4a.1 — effect Yield<T> declaration + registration acceptance
##
## Operation Piezoelectric Effects, Phase 4, Milestone 4a.1.
##
## Verifies that `std/gen.qz` declares `effect Yield<T>` and that the
## effect registers via `tc_register_effect_decl` with the expected
## `yield` op. Two tests:
##
##   1. `import * from std/gen` in a spec binary reaches this file — proves
##      the decl parsed, registered, and linked without breaking the rest
##      of the compilation pipeline.
##   2. `--dump-effect-decls` on a minimal importer reports
##      `EFFECT_DECL effect=Yield op=yield` — proves registration reached
##      the diagnostic sink, not just the parser.
##
## Behavioral tests (handled yield collects into a vec; unhandled yield
## fires QZ0611/QZ0610) are deferred to Milestone 4a.2 because `yield` is
## a reserved keyword in the lexer — calling `yield(v)` from user code
## requires the parser sugar that 4a.2 wires.

import * from qspec
import * from qspec/subprocess
import * from std/gen

def main(): Int
  describe("effect Yield<T> registration (piezo 4a.1)") do ->
    it("std/gen imports and compiles clean") do ->
      # Reaching this assertion means the spec binary compiled with
      # `import * from std/gen` at the top. A broken decl (parse error,
      # registry collision, op-name reservation mismatch) would have
      # prevented the binary from linking, so this `it` running at all
      # is the load-bearing assertion. The explicit assert_eq is just a
      # sentinel so the test has a formal pass/fail.
      assert_eq(1, 1)
    end

    it("--dump-effect-decls reports Yield/yield registered") do ->
      var src = "import * from std/gen\n\ndef main(): Int = 0\n"
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "effect=Yield op=yield")
        _record_failure(str_concat("Expected Yield/yield in decl dump; stderr: ", r.stderr_content))
      end
    end
  end
  return qspec_main()
end
