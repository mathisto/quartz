## Effect-Row Unification — B.4 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.4).
## Verifies tc_row_unify implements Rémy/Leijen-2014 Model B unification
## (allow-duplicates) over the row store added in B.1 and populated in
## B.3. Behavior is observed via the `--test-row-unify` developer flag,
## which constructs a fresh TypecheckState, runs eight curated cases via
## tc_run_unify_tests, and prints `ROW_UNIFY <slug>: PASS|FAIL` to stderr.
##
## Each case asserts a single PASS line — the embedded runner already
## compares expected vs actual; the spec just confirms the runner saw
## what it expected to see.

import * from qspec
import * from qspec/subprocess

extern "C" def system(cmd: CString): CInt

def _run_unify_tests(): SubResult
  _sub_init()
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    return SubResult { exit_code: -1, stdout_content: "", stderr_content: "QUARTZ_COMPILER not set" }
  end
  var sb = sb_new()
  sb.append(compiler)
  sb.append(" --test-row-unify > /tmp/_qspec_row_unify.out 2> /tmp/_qspec_row_unify.err")
  var raw = system(sb.to_string())
  var exit_code = band(shr(raw, 8), 255)
  return SubResult {
    exit_code: exit_code,
    stdout_content: read_file("/tmp/_qspec_row_unify.out"),
    stderr_content: read_file("/tmp/_qspec_row_unify.err")
  }
end

def _assert_pass(stderr: String, slug: String): Void
  _inc_assertions()
  var needle = "ROW_UNIFY #{slug}: PASS"
  if not str_contains(stderr, needle)
    var sb = sb_new()
    sb.append("Expected '#{needle}' in stderr but got: ")
    sb.append(stderr)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("tc_row_unify (Rémy-style, Model B allow-duplicates)") do ->
    var r = _run_unify_tests()

    it("empty unifies with empty (closed)") do ->
      _assert_pass(r.stderr_content, "empty_eq_empty")
    end

    it("[L] = [L] (closed, same single label)") do ->
      _assert_pass(r.stderr_content, "L_eq_L")
    end

    it("[L] ≠ [M] (closed, distinct labels fail)") do ->
      _assert_pass(r.stderr_content, "L_neq_M_closed")
    end

    it("[L | ρ] = [L, M] (closed) — ρ binds to extra labels") do ->
      _assert_pass(r.stderr_content, "L_open_eq_LM_closed")
    end

    it("[L, M] = [M, L] — order-insensitive multiset") do ->
      _assert_pass(r.stderr_content, "LM_eq_ML_unordered")
    end

    it("[L, L] = [L, L] — Model B allows duplicate labels") do ->
      _assert_pass(r.stderr_content, "LL_eq_LL_dup_allowed")
    end

    it("[L | ρ1] = [L | ρ2] — both open, tails bind together") do ->
      _assert_pass(r.stderr_content, "L_rho1_eq_L_rho2")
    end

    it("occurs check rejects [L | ρ] = ρ (cycle)") do ->
      _assert_pass(r.stderr_content, "occurs_L_rho_eq_rho")
    end
  end
  return qspec_main()
end
