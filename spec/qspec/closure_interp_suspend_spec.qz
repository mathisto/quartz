## Regression: string interpolation whose `#{...}` part is a colorless
## (suspending) call must spill the StringBuilder across the suspend.
##
## A higher-order function like `apply(f, x) = f(x)` makes an indirect call,
## so the effect machinery marks it EFFECT_SUSPEND. Calling it from `main`
## colorless-dispatches the call and lowers `main` into a `$poll` coroutine.
## A multi-part interpolation (`"a #{apply(..)} b"`) creates a StringBuilder
## BEFORE the suspending call and appends to it AFTER — across the resume
## block. Without spilling the builder to a generator-frame slot, its SSA
## value does not dominate the resume block and `llc` rejects the module
## ("Instruction does not dominate all uses!"). See A.44.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("closure-interp cross-suspend spill") do ->
    it("multi-part interp with a suspending HOF call compiles + runs") do ->
      assert_run_stdout_eq(interp_hof_src(), "result = 42!\n")
    end

    it("two interpolations each spanning a suspend") do ->
      assert_run_stdout_eq(two_interp_src(), "a=10 b=21\n")
    end
  end

  return qspec_main()
end

def interp_hof_src(): String = """
  def apply(f: Fn(Int): Int, x: Int): Int = f(x)
  def double(x: Int): Int = x * 2
  def main(): Int
    r = "result = \#{apply(double, 21)}!"
    puts(r)
    return 0
  end
  """

def two_interp_src(): String = """
  def apply(f: Fn(Int): Int, x: Int): Int = f(x)
  def identity(x: Int): Int = x
  def main(): Int
    puts("a=\#{apply(identity, 10)} b=\#{apply(identity, 21)}")
    return 0
  end
  """
