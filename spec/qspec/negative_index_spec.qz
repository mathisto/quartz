## Negative Indexing Tests
##
## Contract:
##   1. Last: `a[-1]` returns last element.
##   2. Second-to-last: `a[-2]` returns second-to-last.
##   3. First via neg: `a[-N]` returns first element of N-element vec.
##   4. Positive: positive indexing unaffected.
##   5. Binary sub: `a[2] - a[0]` not confused with negative index.
##   6. Assign last: `a[-1] = val` sets last element.
##   7. Assign second-to-last: `a[-2] = val` sets second-to-last.
##   8. Small vec: `a[-1]` works on 2-element vec.
import * from qspec

def main(): Int
  describe("vec negative index access") do ->
    it("a[-1] returns last element") do ->
      var a = [10, 20, 30, 40, 50]
      assert_eq(a[-1], 50)
    end

    it("a[-2] returns second-to-last element") do ->
      var a = [10, 20, 30, 40, 50]
      assert_eq(a[-2], 40)
    end

    it("a[-5] returns first element of 5-element vec") do ->
      var a = [10, 20, 30, 40, 50]
      assert_eq(a[-5], 10)
    end

    it("positive index still works unchanged") do ->
      var a = [10, 20, 30]
      assert_eq(a[0] + a[1] + a[2], 60)
    end
  end

  describe("negative index edge cases") do ->
    it("binary subtraction does not trigger negative index desugar") do ->
      var a = [10, 20, 30]
      x = a[2] - a[0]
      assert_eq(x, 20)
    end
  end

  describe("negative index assignment") do ->
    it("a[-1] = val sets last element") do ->
      var a = [10, 20, 30]
      a[-1] = 99
      assert_eq(a[2], 99)
    end

    it("a[-2] = val sets second-to-last element") do ->
      var a = [10, 20, 30]
      a[-2] = 88
      assert_eq(a[1], 88)
    end
  end

  describe("small vec negative index") do ->
    it("a[-1] works on 2-element vec") do ->
      var a = [100, 200]
      assert_eq(a[-1], 200)
    end
  end

  return qspec_main()
end
