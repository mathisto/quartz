## item 44 regression — decomposed @value-struct param + default trait method.
##
## A bounded-generic `describe_shape<T: Describe + Area>(s: T)` receives a
## value-layout struct BY VALUE. The monomorph takes the decomposed register
## param (`%p0.f0`), reconstructs it into a caller-frame stack box
## (codegen.qz:1199 `%pI.struct = alloca`), then calls a DEFAULT trait method
## (`describe_with_area`, which takes BOXED self). Pre-fix, codegen emitted a
## `tail call` for that — LLVM's `tail` marker frees the caller frame before the
## callee reads the stack box ⇒ garbage. The tail-call-UB veto only tracked
## MIR_ALLOC_STACK and byval-return origins, not the param-reconstruct alloca
## (synthesized in codegen, never a MIR instr). item 44 seeds each decomposed
## value-struct param's var as a stack origin in mir_compute_reg_origins so the
## veto fires (`tail call` -> `call`) and the box survives the callee.
##
## Exercised at gate-0 via `@value` (value-layout today; no default-flip needed).

import * from qspec

@value
struct Circle
  radius: Int
end

trait Area
  def area(self): Int
    return 0
  end
end

trait Describe
  def describe(self): String
    return "shape"
  end
  # Default method — takes boxed self, re-dispatches describe()/area().
  def describe_with_area(self): String = "#{self.describe()} area=#{self.area()}"
end

extend Circle with Area
  def area(self): Int = @radius * @radius * 3
end

extend Circle with Describe
  def describe(self): String = "circle(r=#{@radius})"
end

# Bounded generic: passes T BY VALUE, then calls a default trait method on it.
def describe_shape<T: Describe + Area>(s: T): String
  return s.describe_with_area()
end

def bounded_generic_default_method(): String = describe_shape(Circle { radius: 7 })

def main(): Int
  describe("@value bounded-generic + default trait method (item 44)") do ->
    it("decomposed value-struct param survives default-method dispatch") do ->
      # Pre-fix: garbage like "circle(r=8795766808) area=-7711131736080644416".
      assert_eq_str(bounded_generic_default_method(), "circle(r=7) area=147")
    end
  end

  return qspec_main()
end
