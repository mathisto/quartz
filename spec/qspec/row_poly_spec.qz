## Row Polymorphism (Record Type Parameters) Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("row polymorphism") do ->
    it("basic open record parameter dispatches on struct field") do ->
      assert_run_exits(row_basic_src(), 42)
    end
    it("open record works with multiple structs") do ->
      assert_run_exits(row_multi_struct_src(), 49)
    end
    it("open record with multiple required fields") do ->
      assert_run_exits(row_multi_field_src(), 42)
    end
    it("open record with String field") do ->
      assert_run_exits(row_string_field_src(), 5)
    end
    it("closed record (no rest) works") do ->
      assert_run_exits(row_closed_src(), 42)
    end
    it("open record as function return type") do ->
      assert_run_exits(row_return_type_src(), 42)
    end
    it("open record with endless def") do ->
      assert_run_exits(row_endless_def_src(), 42)
    end
    it("error on accessing non-existent field") do ->
      assert_compile_error(row_bad_field_src(), "has no field")
    end
    it("record with String field resolves type ID correctly") do ->
      assert_run_exits(row_string_field_resolved_src(), 5)
    end
    it("open record called with two different structs unifies fields") do ->
      assert_run_exits(row_unify_two_structs_src(), 49)
    end
    it("multiple open record params are independent") do ->
      assert_run_exits(row_multi_open_params_src(), 52)
    end
    it("record type shown in error messages with field info") do ->
      assert_compile_error(row_error_display_src(), "{ x: Int")
    end
    it("open record as function return used in field access") do ->
      assert_run_exits(row_return_field_access_src(), 42)
    end
    it("open record in match arm bodies") do ->
      assert_run_exits(row_match_arm_src(), 42)
    end
    it("chained field access on nested record") do ->
      assert_run_exits(row_nested_field_src(), 42)
    end
    it("open record with Bool field type") do ->
      assert_run_exits(row_bool_field_src(), 1)
    end
  end
  return qspec_main()
end

def row_basic_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.x
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_x(p)
  end
  """

def row_multi_struct_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  struct Vec3
    x: Int
    y: Int
    z: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.x
  def main(): Int
    a = get_x(Point { x: 42, y: 10 })
    b = get_x(Vec3 { x: 7, y: 2, z: 3 })
    return a + b
  end
  """

def row_multi_field_src(): String = """
  struct Pair
    x: Int
    y: Int
    z: Int
  end
  def sum_xy(r: { x: Int, y: Int | .. }): Int = r.x + r.y
  def main(): Int
    p = Pair { x: 20, y: 22, z: 99 }
    return sum_xy(p)
  end
  """

def row_string_field_src(): String = """
  struct Named
    name: String
    age: Int
  end
  def get_name(r: { name: String | .. }): String = r.name
  def main(): Int
    p = Named { name: "hello", age: 30 }
    return str_size(get_name(p))
  end
  """

def row_closed_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_x(r: { x: Int }): Int = r.x
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_x(p)
  end
  """

def row_return_type_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def make(): { x: Int | .. }
    return Point { x: 42, y: 10 }
  end
  def main(): Int
    p = make()
    return p.x
  end
  """

def row_endless_def_src(): String = """
  struct Vec3
    x: Int
    y: Int
    z: Int
  end
  def sum_xy(r: { x: Int, y: Int | .. }): Int = r.x + r.y
  def main(): Int
    v = Vec3 { x: 20, y: 22, z: 99 }
    return sum_xy(v)
  end
  """

def row_bad_field_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_z(r: { x: Int | .. }): Int = r.z
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_z(p)
  end
  """

def row_string_field_resolved_src(): String = """
  struct Named
    name: String
    value: Int
  end
  def get_name(r: { name: String | .. }): String = r.name
  def main(): Int
    n = Named { name: "world", value: 99 }
    s = get_name(n)
    return str_size(s)
  end
  """

def row_unify_two_structs_src(): String = """
  struct Pt
    x: Int
    y: Int
  end
  struct V3
    x: Int
    y: Int
    z: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.x
  def main(): Int
    a = get_x(Pt { x: 42, y: 10 })
    b = get_x(V3 { x: 7, y: 2, z: 3 })
    return a + b
  end
  """

def row_multi_open_params_src(): String = """
  struct A
    x: Int
    y: Int
  end
  struct B
    x: Int
    z: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.x
  def main(): Int
    a = A { x: 22, y: 5 }
    b = B { x: 30, z: 99 }
    return get_x(a) + get_x(b)
  end
  """

def row_error_display_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.z
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_x(p)
  end
  """

def row_return_field_access_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def make_point(): { x: Int | .. }
    return Point { x: 42, y: 10 }
  end
  def main(): Int
    p = make_point()
    return p.x
  end
  """

def row_match_arm_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_x(r: { x: Int | .. }): Int = r.x
  def main(): Int
    p = Point { x: 42, y: 10 }
    result = match 1
      1 => get_x(p)
      _ => 0
    end
    return result
  end
  """

def row_nested_field_src(): String = """
  struct Inner
    y: Int
  end
  struct Outer
    x: Inner
    z: Int
  end
  def get_inner(r: { x: Inner | .. }): Inner = r.x
  def main(): Int
    o = Outer { x: Inner { y: 42 }, z: 99 }
    return get_inner(o).y
  end
  """

def row_bool_field_src(): String = """
  struct Flags
    active: Bool
    count: Int
  end
  def is_active(r: { active: Bool | .. }): Bool = r.active
  def main(): Int
    f = Flags { active: true, count: 10 }
    if is_active(f)
      return 1
    end
    return 0
  end
  """
