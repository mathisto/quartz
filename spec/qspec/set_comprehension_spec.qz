## Set Comprehension Tests
##
## Contract:
##   1. Basic: `{x for x in vec}` creates set from source.
##   2. Dedup: duplicate elements are removed.
##   3. Filter: `{x for x in vec if cond}` filters elements.
##   4. Transform: `{expr for x in vec}` applies expression.
##   5. Combined: filter + transform in one comprehension.
##   6. Non-member: element not in source is not in set.
import * from qspec

def main(): Int
  describe("set comprehension") do ->
    it("creates set from vec elements") do ->
      var a = [10, 20, 30]
      var s = {x for x in a}
      var count = 0
      if set_has(s, 10)
        count += 1
      end
      if set_has(s, 20)
        count += 1
      end
      if set_has(s, 30)
        count += 1
      end
      assert_eq(count, 3)
    end
    it("deduplicates elements") do ->
      var a = [1, 1, 2, 2, 3]
      var s = {x for x in a}
      var count = 0
      if set_has(s, 1)
        count += 1
      end
      if set_has(s, 2)
        count += 1
      end
      if set_has(s, 3)
        count += 1
      end
      assert_eq(count, 3)
    end
    it("filters with if condition") do ->
      var a = [1, 2, 3, 4, 5, 6]
      var s = {x for x in a if x > 3}
      var count = 0
      if set_has(s, 4)
        count += 1
      end
      if set_has(s, 5)
        count += 1
      end
      if set_has(s, 6)
        count += 1
      end
      if set_has(s, 1)
        count += 10
      end
      assert_eq(count, 3)
    end
    it("transforms elements with expression") do ->
      var a = [1, 2, 3]
      var s = {x * 2 for x in a}
      var count = 0
      if set_has(s, 2)
        count += 1
      end
      if set_has(s, 4)
        count += 1
      end
      if set_has(s, 6)
        count += 1
      end
      assert_eq(count, 3)
    end

    it("filter + transform combined") do ->
      var a = [1, 2, 3, 4, 5]
      var s = {x * 10 for x in a if x > 2}
      assert_eq(set_has(s, 30), true)
      assert_eq(set_has(s, 40), true)
      assert_eq(set_has(s, 50), true)
      assert_eq(set_has(s, 10), false)
    end

    it("element not in source is not in set") do ->
      var a = [10, 20, 30]
      var s = {x for x in a}
      assert_eq(set_has(s, 99), false)
    end
  end
  return qspec_main()
end
