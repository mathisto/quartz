## Simd F32X8 Tests
##
## Contract:
##   1. Adds two vectors element-wise.
##   2. Divides two vectors element-wise.
##   3. Dot product of two.
##   4. Emits <8 x float>.
##   5. Extracts all eight lanes.
##   6. Fused multiply-add.
import * from qspec

def main(): Int
  describe("SIMD F32x8") do ->
    it("splat and extract lane 0") do ->
      assert_eq(sf8_splat(), 3)
    end
    it("extracts all eight lanes from splat") do ->
      assert_eq(sf8_all_lanes(), 40)
    end
    it("adds two vectors element-wise") do ->
      assert_eq(sf8_add(), 15)
    end
    it("subtracts two vectors element-wise") do ->
      assert_eq(sf8_sub(), 13)
    end
    it("multiplies two vectors element-wise") do ->
      assert_eq(sf8_mul(), 42)
    end
    it("divides two vectors element-wise") do ->
      assert_eq(sf8_div(), 25)
    end
    it("sums all eight lanes") do ->
      assert_eq(sf8_sum(), 40)
    end
    it("loads 8 floats from f32_vec") do ->
      assert_eq(sf8_load(), 36)
    end
    it("stores SIMD register back into f32_vec") do ->
      assert_eq(sf8_store(), 9)
    end
    it("fused multiply-add") do ->
      assert_eq(sf8_fma(), 14)
    end
    it("lane-wise square root") do ->
      assert_eq(sf8_sqrt(), 5)
    end
    it("lane-wise absolute value") do ->
      assert_eq(sf8_abs(), 7)
    end
    it("lane-wise minimum") do ->
      assert_eq(sf8_min(), 3)
    end
    it("lane-wise maximum") do ->
      assert_eq(sf8_max(), 10)
    end
    it("dot product of two 8-element vectors") do ->
      assert_eq(sf8_dot(), 36)
    end
    it("emits <8 x float> vector instructions (IR test)") do ->
      assert_ir_contains("def main(): Int\n  var v = simd_f32x8_splat(3.0)\n  return to_int(simd_f32x8_extract(v, 0))\nend\n", "insertelement <8 x float>")
    end
  end
  return qspec_main()
end

def sf8_splat(): Int
  var v = simd_f32x8_splat(3.0)
  return to_int(simd_f32x8_extract(v, 0))
end
def sf8_all_lanes(): Int
  var v = simd_f32x8_splat(5.0)
  var a = to_int(simd_f32x8_extract(v, 0))
  var b = to_int(simd_f32x8_extract(v, 1))
  var c = to_int(simd_f32x8_extract(v, 2))
  var d = to_int(simd_f32x8_extract(v, 3))
  var e = to_int(simd_f32x8_extract(v, 4))
  var f = to_int(simd_f32x8_extract(v, 5))
  var g = to_int(simd_f32x8_extract(v, 6))
  var h = to_int(simd_f32x8_extract(v, 7))
  return a + b + c + d + e + f + g + h
end
def sf8_add(): Int
  var a = simd_f32x8_splat(10.0)
  var b = simd_f32x8_splat(5.0)
  var c = simd_f32x8_add(a, b)
  return to_int(simd_f32x8_extract(c, 0))
end
def sf8_sub(): Int
  var a = simd_f32x8_splat(20.0)
  var b = simd_f32x8_splat(7.0)
  var c = simd_f32x8_sub(a, b)
  return to_int(simd_f32x8_extract(c, 4))
end
def sf8_mul(): Int
  var a = simd_f32x8_splat(6.0)
  var b = simd_f32x8_splat(7.0)
  var c = simd_f32x8_mul(a, b)
  return to_int(simd_f32x8_extract(c, 5))
end
def sf8_div(): Int
  var a = simd_f32x8_splat(100.0)
  var b = simd_f32x8_splat(4.0)
  var c = simd_f32x8_div(a, b)
  return to_int(simd_f32x8_extract(c, 7))
end
def sf8_sum(): Int
  var v = simd_f32x8_splat(5.0)
  return to_int(simd_f32x8_sum(v))
end
def sf8_load(): Int
  var v = vec_new<F32>()
  v.push(1.0)
  v.push(2.0)
  v.push(3.0)
  v.push(4.0)
  v.push(5.0)
  v.push(6.0)
  v.push(7.0)
  v.push(8.0)
  var s = simd_f32x8_load(v, 0)
  return to_int(simd_f32x8_sum(s))
end
def sf8_store(): Int
  var v = vec_new<F32>()
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  var s = simd_f32x8_splat(3.0)
  simd_f32x8_store(s, v, 0)
  var a = to_int(v[0])
  var b = to_int(v[3])
  var c = to_int(v[7])
  return a + b + c
end
def sf8_fma(): Int
  var a = simd_f32x8_splat(3.0)
  var b = simd_f32x8_splat(4.0)
  var c = simd_f32x8_splat(2.0)
  var r = simd_f32x8_fma(a, b, c)
  return to_int(simd_f32x8_extract(r, 0))
end
def sf8_sqrt(): Int
  var v = simd_f32x8_splat(25.0)
  var r = simd_f32x8_sqrt(v)
  return to_int(simd_f32x8_extract(r, 0))
end
def sf8_abs(): Int
  var pos = simd_f32x8_splat(7.0)
  var neg = simd_f32x8_sub(simd_f32x8_splat(0.0), pos)
  var r = simd_f32x8_abs(neg)
  return to_int(simd_f32x8_extract(r, 0))
end
def sf8_min(): Int
  var a = simd_f32x8_splat(10.0)
  var b = simd_f32x8_splat(3.0)
  var r = simd_f32x8_min(a, b)
  return to_int(simd_f32x8_extract(r, 0))
end
def sf8_max(): Int
  var a = simd_f32x8_splat(10.0)
  var b = simd_f32x8_splat(3.0)
  var r = simd_f32x8_max(a, b)
  return to_int(simd_f32x8_extract(r, 0))
end
def sf8_dot(): Int
  var a = vec_new<F32>()
  a.push(1.0)
  a.push(2.0)
  a.push(3.0)
  a.push(4.0)
  a.push(5.0)
  a.push(6.0)
  a.push(7.0)
  a.push(8.0)
  var b = vec_new<F32>()
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  b.push(1.0)
  var va = simd_f32x8_load(a, 0)
  var vb = simd_f32x8_load(b, 0)
  var prod = simd_f32x8_mul(va, vb)
  return to_int(simd_f32x8_sum(prod))
end
