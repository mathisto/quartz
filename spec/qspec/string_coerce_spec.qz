## String Ergonomics — Auto-Coercion and Repetition
##
## Tests:
##   1. String + Int auto-coerces via to_str()
##   2. Int + String auto-coerces via to_str()
##   3. String + F64 auto-coerces via f64_to_str()
##   4. String + Bool auto-coerces via to_str()
##   5. Chained coercions work left-to-right
##   6. Variable (not just literal) coercion works
##   7. String * Int repetition
##   8. Int * String repetition (commutative)
##   9. String * 0 returns empty string
##  10. String * 1 returns identity
##  11. Separator pattern: "-" * 40

import * from qspec

def print_str_plus_int(): Void
  puts("count: " + 42)
end

def print_int_plus_str(): Void
  puts(42 + " items")
end

def print_str_plus_f64(): Void
  var pi = 3.0
  var s = "pi=" + pi
  puts(s)
end

def print_str_plus_bool(): Void
  puts("flag: " + true)
end

def print_chained(): Void
  puts("a" + 1 + "b" + 2)
end

def print_var_coerce(): Void
  var x = 42
  puts("val=" + x)
end

def print_repeat(): Void
  puts("ha" * 3)
end

def print_repeat_commutative(): Void
  puts(3 * "ha")
end

def print_separator(): Void
  puts("-" * 20)
end

def print_repeat_zero(): Void
  var s = "x" * 0
  puts(str_byte_len(s).to_s())
end

def print_repeat_one(): Void
  puts("x" * 1)
end

def main(): Int
  describe("string auto-coercion with +") do ->
    it("coerces Int on right side") do ->
      assert_output("count: 42\n", print_str_plus_int)
    end

    it("coerces Int on left side") do ->
      assert_output("42 items\n", print_int_plus_str)
    end

    it("coerces F64 on right side") do ->
      assert_output("pi=3\n", print_str_plus_f64)
    end

    it("coerces Bool on right side") do ->
      assert_output("flag: true\n", print_str_plus_bool)
    end

    it("chains coercions left-to-right") do ->
      assert_output("a1b2\n", print_chained)
    end

    it("coerces variables not just literals") do ->
      assert_output("val=42\n", print_var_coerce)
    end
  end

  describe("string repetition with *") do ->
    it("repeats string N times") do ->
      assert_output("hahaha\n", print_repeat)
    end

    it("is commutative (Int * String)") do ->
      assert_output("hahaha\n", print_repeat_commutative)
    end

    it("produces separator pattern") do ->
      assert_output("--------------------\n", print_separator)
    end

    it("returns empty string for * 0") do ->
      assert_output("0\n", print_repeat_zero)
    end

    it("returns identity for * 1") do ->
      assert_output("x\n", print_repeat_one)
    end
  end

  return qspec_main()
end
