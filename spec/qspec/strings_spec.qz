## Strings Tests
##
## Contract:
##   1. Str_starts_with.
##   2. Str_ends_with.
##   3. String literals.
##   4. Escape sequences.
##   5. Print_int builtin.
##   6. Multiple prints.
##   7. Strings in functions.
##   8. Strings with control flow.
##   9. Str_len builtin.
##   10. Str_concat builtin.
##   11. String == operator.
##   12. Str_char_at builtin.
##   13. Str_from_int.
##   14. String edge cases.
##   15. String bracket indexing.
##   16. String slicing and searching.
##   17. Character classification.
##   18. System command execution.
##   19. Logical operator aliases.
##   20. Heredocs (triple-quoted strings).
##   21. Str_downcase.
##   22. Str_upcase.
##   23. Str_trim.
##   24. Str_replace.
##   25. Str_join.
##   26. String != operator.
##   27. String properties.

import * from qspec
import * from qspec/subprocess
import * from qspec/property

def main(): Int
  # ==========================================================================
  # str_starts_with
  # ==========================================================================

  describe("str_starts_with") do ->
    it("returns true when string starts with prefix") do ->
      if str_starts_with("hello world", "hello")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("returns false when not starting with prefix") do ->
      if str_starts_with("hello world", "world")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("returns true for empty prefix") do ->
      if str_starts_with("hello", "")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  # ==========================================================================
  # str_ends_with
  # ==========================================================================

  describe("str_ends_with") do ->
    it("returns true when string ends with suffix") do ->
      if str_ends_with("hello world", "world")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("returns false when not ending with suffix") do ->
      if str_ends_with("hello world", "hello")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("returns true for empty suffix") do ->
      if str_ends_with("hello", "")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  # ==========================================================================
  # String literals (stdout-dependent tests marked pending)
  # ==========================================================================

  describe("string literals") do ->
    it("prints a simple string with puts") do ->
      assert_output("hello\n", str_print_hello)
    end

    it("prints a string with puts (adds newline)") do ->
      assert_output("world\n", str_print_world)
    end

    it("prints multiple strings") do ->
      assert_output("line1\nline2\n", str_print_two_lines)
    end

    it("prints empty string") do ->
      assert_output("\n", str_print_empty)
    end

    it("prints string with spaces") do ->
      assert_output("hello world\n", str_print_spaces)
    end
  end

  # ==========================================================================
  # Escape sequences (stdout-dependent)
  # ==========================================================================

  describe("escape sequences") do ->
    it("handles newline escape") do ->
      assert_output("a\nb\n", str_print_newline_escape)
    end

    it("handles tab escape") do ->
      assert_output("a\tb\n", str_print_tab_escape)
    end

    it("handles carriage return escape") do ->
      s = "a\rb"
      assert_eq(s.size, 3)
      assert_eq(str_byte_at(s, 1), 13)
    end

    it("handles backslash escape") do ->
      s = "\\"
      assert_eq(s.size, 1)
      assert_eq(str_byte_at(s, 0), 92)
    end

    it("handles quote escape") do ->
      s = "\""
      assert_eq(s.size, 1)
      assert_eq(str_byte_at(s, 0), 34)
    end

    it("handles literal multiline strings") do ->
      s = "line1\nline2\nline3"
      assert_eq(s.size, 17)
    end

    it("handles multiple escapes") do ->
      assert_output("a\tb\nc\n", str_print_multi_escape)
    end
  end

  # ==========================================================================
  # print_int builtin (stdout-dependent)
  # ==========================================================================

  describe("print_int builtin") do ->
    it("prints an integer with newline") do ->
      assert_output("42\n", str_print_int_42)
    end

    it("prints zero") do ->
      assert_output("0\n", str_print_int_0)
    end

    it("prints computed value") do ->
      assert_output("30\n", str_print_int_computed)
    end

    it("prints variable value") do ->
      assert_output("99\n", str_print_int_var)
    end

    it("prints large number") do ->
      assert_output("1000000\n", str_print_int_large)
    end
  end

  # ==========================================================================
  # Multiple prints (stdout-dependent)
  # ==========================================================================

  describe("multiple prints") do ->
    it("prints strings on separate lines") do ->
      assert_output("alpha\nbeta\ngamma\n", str_print_three_lines)
    end

    it("builds formatted output") do ->
      s = "Count: " + str_from_int(42)
      assert_eq_str(s, "Count: 42")
    end

    it("prints in a loop") do ->
      assert_output("0\n1\n2\n", str_print_loop)
    end
  end

  # ==========================================================================
  # Strings in functions (stdout-dependent)
  # ==========================================================================

  describe("strings in functions") do ->
    it("prints from helper function") do ->
      assert_output("from helper\n", str_print_from_helper)
    end

    it("prints from multiple functions") do ->
      assert_output("func1\nfunc2\n", str_print_from_multi)
    end

    it("prints with parameter value") do ->
      assert_output("7\n", str_print_param_val)
    end
  end

  # ==========================================================================
  # Strings with control flow (stdout-dependent)
  # ==========================================================================

  describe("strings with control flow") do ->
    it("conditionally prints") do ->
      assert_output("yes\n", str_print_conditional)
    end

    it("prints in else branch") do ->
      assert_output("else\n", str_print_else)
    end

    it("prints countdown") do ->
      assert_output("3\n2\n1\n", str_print_countdown)
    end
  end

  # ==========================================================================
  # str_size builtin
  # ==========================================================================

  describe("str_size builtin") do ->
    it("returns length of string literal") do ->
      assert_eq("hello".size, 5)
    end

    it("returns 0 for empty string") do ->
      assert_eq("".size, 0)
    end

    it("counts escape sequences as single chars") do ->
      assert_eq("a\nb".size, 3)
    end
  end

  # ==========================================================================
  # str_concat builtin
  # ==========================================================================

  describe("str_concat builtin") do ->
    it("returns correct length after concat") do ->
      assert_eq(("abc" + "def").size, 6)
    end

    it("concatenates two strings") do ->
      assert_eq_str("hello" + " world", "hello world")
    end

    it("concatenates with empty string") do ->
      assert_eq_str("hello" + "", "hello")
    end

    it("chains multiple concats") do ->
      assert_eq_str("a" + "b" + "c", "abc")
    end
  end

  # ==========================================================================
  # string == operator
  # ==========================================================================

  describe("string == operator") do ->
    it("returns true for equal strings") do ->
      if "hello" == "hello"
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("returns false for different strings") do ->
      if "hello" == "world"
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("compares empty strings") do ->
      if "" == ""
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("distinguishes different lengths") do ->
      if "ab" == "abc"
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("works with concatenated strings") do ->
      if "hel" + "lo" == "hello"
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  # ==========================================================================
  # str_char_at builtin
  # ==========================================================================

  describe("str_char_at builtin") do ->
    it("returns ASCII value of first character") do ->
      assert_eq(str_char_at("Hello", 0), 72)
    end

    it("returns ASCII value at offset") do ->
      assert_eq(str_char_at("Hello", 4), 111)
    end

    it("works with string variables") do ->
      s = "ABC"
      assert_eq(str_char_at(s, 1), 66)
    end

    it("can iterate through string characters") do ->
      s = "Hi"
      sum = str_char_at(s, 0) + str_char_at(s, 1)
      assert_eq(sum, 177)
    end

    it("works with computed index") do ->
      s = "abcde"
      i = 2
      assert_eq(str_char_at(s, i), 99)
    end
  end

  # ==========================================================================
  # str_from_int (stdout-dependent tests)
  # ==========================================================================

  describe("str_from_int") do ->
    it("converts positive integer to string") do ->
      assert_eq_str(str_from_int(42), "42")
    end

    it("converts zero to string") do ->
      assert_eq_str(str_from_int(0), "0")
    end

    it("converts negative integer to string") do ->
      assert_eq_str(str_from_int(-123), "-123")
    end

    it("works with str_concat for building strings") do ->
      s = "Count: " + str_from_int(99)
      assert_eq_str(s, "Count: 99")
    end

    it("can build register names like codegen does") do ->
      reg = "%t" + str_from_int(5)
      assert_eq_str(reg, "%t5")
    end
  end

  # ==========================================================================
  # String edge cases (stdout-dependent)
  # ==========================================================================

  describe("string edge cases") do ->
    it("handles string with only escapes") do ->
      s = "\n\t"
      assert_eq(s.size, 2)
    end

    it("handles many strings in sequence") do ->
      assert_output("a\nb\nc\nd\ne\n", str_print_sequence)
    end

    it("handles string with numbers") do ->
      assert_eq_str("num" + "123", "num123")
    end

    it("handles string with special chars") do ->
      s = "a-b_c.d"
      assert_eq(s.size, 7)
    end
  end

  # ==========================================================================
  # String bracket indexing (s[i] → str_char_at rewrite)
  # ==========================================================================

  describe("string bracket indexing") do ->
    it("bracket index returns byte value") do ->
      s = "Hello"
      assert_eq(s[0], 72)
      assert_eq(s[4], 111)
    end

    it("bracket index with variable") do ->
      s = "abc"
      i = 1
      assert_eq(s[i], 98)
    end

    it("bracket index in conditional") do ->
      s = "--flag"
      assert_eq(s[0] == 45, 1)
    end
  end

  # ==========================================================================
  # String slicing and searching
  # ==========================================================================

  describe("string slicing and searching") do ->
    it("extracts substring with str_slice") do ->
      s = "hello world"
      sub = str_slice(s, 0, 5)
      assert_eq(sub.size, 5)
      assert_eq_str(sub, "hello")
    end

    it("finds substring position with str_find") do ->
      s = "hello world"
      match str_find(s, "world")
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end

    it("returns None when substring not found") do ->
      s = "hello world"
      assert(str_find(s, "xyz").none?)
    end

    it("converts character code to string") do ->
      ch = str_from_char('A')
      assert_eq(ch.size, 1)
      assert_eq_str(ch, "A")
    end
  end

  # ==========================================================================
  # Character classification
  # ==========================================================================

  describe("character classification") do ->
    it("identifies digits") do ->
      assert_eq(is_digit(48), 1)
      assert_eq(is_digit(57), 1)
      assert_eq(is_digit(65), 0)
    end

    it("identifies letters") do ->
      assert_eq(is_alpha(65), 1)
      assert_eq(is_alpha(122), 1)
      assert_eq(is_alpha(48), 0)
    end

    it("identifies whitespace") do ->
      assert_eq(is_whitespace(32), 1)
      assert_eq(is_whitespace(10), 1)
      assert_eq(is_whitespace(65), 0)
    end
  end

  # ==========================================================================
  # System command execution
  # ==========================================================================

  describe("system command execution") do ->
    it("executes shell command") do ->
      assert_eq(system("exit 0"), 0)
    end
  end

  # ==========================================================================
  # Logical operator aliases
  # ==========================================================================

  describe("logical operator aliases") do ->
    it("supports && as alias for and") do ->
      if 1 == 1 && 2 == 2
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("supports || as alias for or") do ->
      if 1 == 2 || 2 == 2
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Heredocs (stdout-dependent)
  # ==========================================================================

  describe("heredocs (triple-quoted strings)") do ->
    it("supports basic triple-quoted strings") do ->
      s = """hello world"""
      assert_eq_str(s, "hello world")
    end

    it("allows embedded double quotes") do ->
      s = """She said "hello" and left."""
      assert_eq(s.size, 26)
    end

    it("supports interpolation in heredocs") do ->
      var hash = "#"
      var src = "def main(): Int\n  var x = 42\n  var s = \"\"\"Value is " + hash + "{str_from_int(x)}\"\"\"\n  puts(s)\n  return 0\nend\n"
      assert_run_stdout_eq(src, "Value is 42\n")
    end

    it("preserves multiple lines") do ->
      s = """line1\nline2\nline3"""
      assert_eq(s.size, 17)
    end
  end

  # ==========================================================================
  # str_downcase / str_upcase / str_trim / str_replace (stdout-dependent)
  # ==========================================================================

  describe("str_downcase") do ->
    it("converts string to lowercase") do ->
      s = "HELLO WORLD"
      lower = s.downcase()
      assert_eq_str(lower, "hello world")
    end

    it("handles already lowercase string") do ->
      s = "already lowercase"
      assert_eq_str(s.downcase(), "already lowercase")
    end
  end

  describe("str_upcase") do ->
    it("converts string to uppercase") do ->
      s = "hello world"
      upper = s.upcase()
      assert_eq_str(upper, "HELLO WORLD")
    end
  end

  describe("str_trim") do ->
    it("trims whitespace from both ends") do ->
      s = "  hello  "
      trimmed = s.trim()
      assert_eq_str(trimmed, "hello")
    end

    it("handles string with no leading/trailing whitespace") do ->
      s = "hello"
      assert_eq_str(s.trim(), "hello")
    end

    it("handles tabs and newlines") do ->
      s = "\t\nhello\t\n"
      assert_eq_str(s.trim(), "hello")
    end
  end

  describe("str_replace") do ->
    it("replaces all occurrences") do ->
      s = "aXbXcX"
      assert_eq_str(str_replace(s, "X", "Y"), "aYbYcY")
    end

    it("handles no occurrences") do ->
      s = "hello world"
      assert_eq_str(s.replace("xyz", "abc"), "hello world")
    end

    it("handles empty old string") do ->
      s = "hello"
      assert_eq_str(str_replace(s, "", "x"), "hello")
    end
  end

  # ==========================================================================
  # str_join (uses Vec, may need special handling)
  # ==========================================================================

  describe("str_join") do ->
    it("joins vector elements with separator") do ->
      var v = vec_new()
      v.push(as_int("hello"))
      v.push(as_int("world"))
      assert_eq_str(str_join(v, ", "), "hello, world")
    end

    it("handles single element") do ->
      var v = vec_new()
      v.push(as_int("only"))
      assert_eq_str(str_join(v, ", "), "only")
    end
  end

  # ==========================================================================
  # String != operator
  # ==========================================================================

  describe("string != operator") do ->
    it("returns true when strings are not equal") do ->
      if "hello" != "world"
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("returns false when strings are equal") do ->
      if "hello" != "hello"
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("works with string variables") do ->
      var a = "foo"
      var b = "bar"
      if a != b
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("works in match-like conditional chains") do ->
      var a = check_str("skip")
      var b = check_str("keep")
      assert_eq(a * 10 + b, 1)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("string properties") do ->
    forall_i("str_from_int/str_to_int roundtrip") do x: Int ->
      if x >= 0
        assert_eq(str_to_int(str_from_int(x)), x)
      else
        assert_eq(1, 1)
      end
    end

    forall_i("str_size(str_from_int(x)) > 0") do x: Int ->
      assert_gt(str_from_int(x).size, 0)
    end

    forall_i("== is reflexive on strings") do x: Int ->
      var s = str_from_int(x)
      if s == s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end

def check_str(s: String): Int
  if s != "skip"
    return 1
  end
  return 0
end

# Helper functions for assert_output (avoid nested closures)

def str_print_hello(): Void
  puts("hello")
end

def str_print_world(): Void
  puts("world")
end

def str_print_two_lines(): Void
  puts("line1")
  puts("line2")
end

def str_print_empty(): Void
  puts("")
end

def str_print_spaces(): Void
  puts("hello world")
end

def str_print_newline_escape(): Void
  puts("a\nb")
end

def str_print_tab_escape(): Void
  puts("a\tb")
end

def str_print_multi_escape(): Void
  puts("a\tb\nc")
end

def str_print_int_42(): Void
  print_int(42)
end

def str_print_int_0(): Void
  print_int(0)
end

def str_print_int_computed(): Void
  print_int(10 + 20)
end

def str_print_int_var(): Void
  var x = 99
  print_int(x)
end

def str_print_int_large(): Void
  print_int(1000000)
end

def str_print_three_lines(): Void
  puts("alpha")
  puts("beta")
  puts("gamma")
end

def str_print_loop(): Void
  var i = 0
  while i < 3
    print_int(i)
    i = i + 1
  end
end

def str_print_from_helper(): Void
  puts("from helper")
end

def str_print_func1(): Void
  puts("func1")
end

def str_print_func2(): Void
  puts("func2")
end

def str_print_from_multi(): Void
  str_print_func1()
  str_print_func2()
end

def str_print_param_val(): Void
  str_print_int_n(7)
end

def str_print_int_n(n: Int): Void
  print_int(n)
end

def str_print_conditional(): Void
  var x = 10
  if x > 5
    puts("yes")
  else
    puts("no")
  end
end

def str_print_else(): Void
  var x = 0
  if x > 5
    puts("if")
  else
    puts("else")
  end
end

def str_print_countdown(): Void
  var i = 3
  while i > 0
    print_int(i)
    i = i - 1
  end
end

def str_print_sequence(): Void
  puts("a")
  puts("b")
  puts("c")
  puts("d")
  puts("e")
end
