## std/tui/widgets/tabs behaviour tests.
##
## Coverage:
##   - Constructors: tab_item, tabs_new (empty + populated), default
##     active = 0
##   - Builders: tabs_with_active clamps, tabs_with_styles replaces,
##     tabs_append grows, tabs_styles_default exposes non-trivial styles
##   - Accessors: tabs_active_item, tabs_active_index
##   - Update: ←/h, →/l cycle (with wrap), 1..9 jumps
##   - Events: Activated on change, Idle on no-op / same-index jump
##   - View: empty → "", labels visible, active tab carries inverse SGR

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/tabs as tb
import std/tui/layout as ly
import style

enum SpecMsg
  Noop
end

# ============================================================
# Test fixtures
# ============================================================

def make_payload(n: Int): Int = n

def make_three_tabs()
  var items = vec_new<tb::TabItem<Int>>()
  vec_push(items, tb::tab_item("One",   1))
  vec_push(items, tb::tab_item("Two",   2))
  vec_push(items, tb::tab_item("Three", 3))
  return tb::tabs_new(items)
end

def make_empty_tabs()
  var items = vec_new<tb::TabItem<Int>>()
  return tb::tabs_new(items)
end

def feed_key(t: tb::Tabs<Int>, code: Int): tb::Tabs<Int>
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = tb::tabs_update(t, msg)
  return triple.0
end

def feed_event(t: tb::Tabs<Int>, code: Int): tb::TabsEvent
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = tb::tabs_update(t, msg)
  return triple.2
end

# ============================================================
# Constructors / builders
# ============================================================

def test_tab_item_holds_label_and_payload(): Void
  var it: tb::TabItem<Int> = tb::tab_item("hello", 42)
  assert_eq_str(it.label, "hello")
  assert_eq(it.payload, 42)
end

def test_tabs_new_empty_has_zero_size_and_active_zero(): Void
  var t = make_empty_tabs()
  assert_eq(t.items.size, 0)
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_tabs_new_populated_starts_active_zero(): Void
  var t = make_three_tabs()
  assert_eq(t.items.size, 3)
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_tabs_styles_default_active_is_nontrivial(): Void
  var s = tb::tabs_styles_default()
  ## Active style should be bold+inverse — at least the inverse attr
  ## needs to land in the rendered escape sequence.
  var active: Style = s.active
  var rendered = active.render_at("X", 16)
  if str_contains(rendered, "\x1b[")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_tabs_styles_default_separator_is_nontrivial(): Void
  var s = tb::tabs_styles_default()
  var sep: Style = s.separator
  var rendered = sep.render_at("X", 16)
  if str_contains(rendered, "\x1b[")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_tabs_with_active_clamps_overflow(): Void
  var t = make_three_tabs()
  t = tb::tabs_with_active(t, 99)
  assert_eq(tb::tabs_active_index(t), 2)
end

def test_tabs_with_active_clamps_negative(): Void
  var t = make_three_tabs()
  t = tb::tabs_with_active(t, -5)
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_tabs_with_styles_replaces_wholesale(): Void
  var t = make_three_tabs()
  var custom = tb::TabsStyles {
    active:    Style.new().underline(),
    inactive:  Style.new().dim(),
    separator: Style.new()
  }
  t = tb::tabs_with_styles(t, custom)
  ## Verify by re-rendering — separator no longer carries muted color.
  var sep: Style = t.styles.separator
  var rendered = sep.render_at("X", 16)
  ## A plain (no fg/bg/attrs) style returns the text as-is.
  assert_eq_str(rendered, "X")
end

def test_tabs_append_grows_items(): Void
  var t = make_empty_tabs()
  t = tb::tabs_append(t, "First", 1)
  t = tb::tabs_append(t, "Second", 2)
  assert_eq(t.items.size, 2)
end

# ============================================================
# Accessors
# ============================================================

def test_tabs_active_item_returns_correct_item(): Void
  var t = make_three_tabs()
  t = tb::tabs_with_active(t, 1)
  var it: tb::TabItem<Int> = tb::tabs_active_item(t)
  assert_eq_str(it.label, "Two")
  assert_eq(it.payload, 2)
end

def test_tabs_active_index_returns_active(): Void
  var t = make_three_tabs()
  t = tb::tabs_with_active(t, 2)
  assert_eq(tb::tabs_active_index(t), 2)
end

# ============================================================
# Update — keys
# ============================================================

def test_right_advances_active(): Void
  var t = make_three_tabs()
  t = feed_key(t, terminal::KEY_RIGHT())
  assert_eq(tb::tabs_active_index(t), 1)
end

def test_right_wraps_at_last(): Void
  var t = tb::tabs_with_active(make_three_tabs(), 2)
  t = feed_key(t, terminal::KEY_RIGHT())
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_left_decrements_active(): Void
  var t = tb::tabs_with_active(make_three_tabs(), 2)
  t = feed_key(t, terminal::KEY_LEFT())
  assert_eq(tb::tabs_active_index(t), 1)
end

def test_left_at_zero_wraps_to_last(): Void
  var t = make_three_tabs()
  t = feed_key(t, terminal::KEY_LEFT())
  assert_eq(tb::tabs_active_index(t), 2)
end

def test_h_aliases_left(): Void
  var t = make_three_tabs()
  t = feed_key(t, 'h')
  assert_eq(tb::tabs_active_index(t), 2)
end

def test_l_aliases_right(): Void
  var t = make_three_tabs()
  t = feed_key(t, 'l')
  assert_eq(tb::tabs_active_index(t), 1)
end

def test_digit_one_jumps_to_zero(): Void
  var t = tb::tabs_with_active(make_three_tabs(), 2)
  t = feed_key(t, '1')
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_digit_three_jumps_to_two(): Void
  var t = make_three_tabs()
  t = feed_key(t, '3')
  assert_eq(tb::tabs_active_index(t), 2)
end

def test_digit_nine_ignored_when_out_of_range(): Void
  var t = tb::tabs_with_active(make_three_tabs(), 1)
  t = feed_key(t, '9')
  assert_eq(tb::tabs_active_index(t), 1)
end

def test_unknown_key_no_change(): Void
  var t = make_three_tabs()
  t = feed_key(t, 'z')
  assert_eq(tb::tabs_active_index(t), 0)
end

def test_unknown_key_emits_idle(): Void
  var t = make_three_tabs()
  var ev = feed_event(t, 'z')
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_empty_tabs_right_is_noop(): Void
  var t = make_empty_tabs()
  var triple = tb::tabs_update(t,
    tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_RIGHT(), modifiers: 0 }))
  var after: tb::Tabs<Int> = triple.0
  assert_eq(tb::tabs_active_index(after), 0)
  var ev: tb::TabsEvent = triple.2
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Events
# ============================================================

def test_activated_event_carries_new_index(): Void
  var t = make_three_tabs()
  var ev = feed_event(t, terminal::KEY_RIGHT())
  match ev
    Activated(idx) => assert_eq(idx, 1)
    _ => assert_eq(0, 1)
  end
end

def test_same_index_jump_emits_idle(): Void
  var t = make_three_tabs()
  ## Already at index 0 — pressing '1' should be a no-op.
  var ev = feed_event(t, '1')
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# View
# ============================================================

def test_empty_tabs_view_returns_empty_string(): Void
  var t = make_empty_tabs()
  assert_eq_str(tb::tabs_view(t), "")
end

def test_view_contains_every_label(): Void
  var t = make_three_tabs()
  var view = tb::tabs_view(t)
  var plain = ly::strip_styles(view)
  if str_contains(plain, "One") and str_contains(plain, "Two") and str_contains(plain, "Three")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_view_active_tab_carries_inverse_sgr(): Void
  ## render_at(_, 16) forces escape emission; tabs_view itself uses
  ## render() which is a plain-text no-op in non-TTY context. So we
  ## verify the active style emits inverse SGR by re-rendering the
  ## active label directly with a forced depth and checking that the
  ## inverse attribute (\x1b[7) appears in the output.
  var t = make_three_tabs()
  var s_active: Style = t.styles.active
  var rendered = s_active.render_at("[ One ]", 16)
  if str_contains(rendered, "\x1b[")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  ## SGR 7 is the inverse attribute. The renderer may combine codes
  ## (e.g. "\x1b[1;7m"), so substring-match the "7" within the
  ## leading escape.
  if str_contains(rendered, "7")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("constructors and builders") do ->
    it("tab_item holds label and payload") do ->
      test_tab_item_holds_label_and_payload()
    end
    it("tabs_new with empty items has size 0 and active 0") do ->
      test_tabs_new_empty_has_zero_size_and_active_zero()
    end
    it("tabs_new with populated items has active 0") do ->
      test_tabs_new_populated_starts_active_zero()
    end
    it("tabs_styles_default active is non-trivial") do ->
      test_tabs_styles_default_active_is_nontrivial()
    end
    it("tabs_styles_default separator is non-trivial") do ->
      test_tabs_styles_default_separator_is_nontrivial()
    end
    it("tabs_with_active clamps overflow to last") do ->
      test_tabs_with_active_clamps_overflow()
    end
    it("tabs_with_active clamps negative to 0") do ->
      test_tabs_with_active_clamps_negative()
    end
    it("tabs_with_styles replaces styles wholesale") do ->
      test_tabs_with_styles_replaces_wholesale()
    end
    it("tabs_append grows items list") do ->
      test_tabs_append_grows_items()
    end
  end

  describe("accessors") do ->
    it("tabs_active_item returns the active item") do ->
      test_tabs_active_item_returns_correct_item()
    end
    it("tabs_active_index returns active") do ->
      test_tabs_active_index_returns_active()
    end
  end

  describe("update keys") do ->
    it("KEY_RIGHT advances active by 1") do ->
      test_right_advances_active()
    end
    it("KEY_RIGHT at last wraps to 0") do ->
      test_right_wraps_at_last()
    end
    it("KEY_LEFT decrements active by 1") do ->
      test_left_decrements_active()
    end
    it("KEY_LEFT at 0 wraps to last") do ->
      test_left_at_zero_wraps_to_last()
    end
    it("'h' aliases KEY_LEFT") do ->
      test_h_aliases_left()
    end
    it("'l' aliases KEY_RIGHT") do ->
      test_l_aliases_right()
    end
    it("'1' jumps to index 0") do ->
      test_digit_one_jumps_to_zero()
    end
    it("'3' jumps to index 2") do ->
      test_digit_three_jumps_to_two()
    end
    it("'9' is ignored when out of range") do ->
      test_digit_nine_ignored_when_out_of_range()
    end
    it("unknown key leaves active unchanged") do ->
      test_unknown_key_no_change()
    end
    it("unknown key emits Idle") do ->
      test_unknown_key_emits_idle()
    end
    it("KEY_RIGHT on empty tabs is no-op + Idle") do ->
      test_empty_tabs_right_is_noop()
    end
  end

  describe("events") do ->
    it("Activated event carries the new index") do ->
      test_activated_event_carries_new_index()
    end
    it("same-index jump emits Idle") do ->
      test_same_index_jump_emits_idle()
    end
  end

  describe("view") do ->
    it("empty tabs render as empty string") do ->
      test_empty_tabs_view_returns_empty_string()
    end
    it("view contains every label") do ->
      test_view_contains_every_label()
    end
    it("active tab carries inverse SGR escape") do ->
      test_view_active_tab_carries_inverse_sgr()
    end
  end

  return qspec_main()
end
