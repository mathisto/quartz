## Handler-Block Row Narrowing — C.2 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.2).
## Verifies that `with <EffectName> do -> body end` narrows the body's
## effect row by pushing <EffectName> onto the handler-effect stack;
## callees whose rows carry that effect no longer trigger QZ0610 even
## when the enclosing function's `can` clause doesn't declare it.
##
## C.2's claim-detection rule (pre-evidence-vtable): a bare PascalCase
## NODE_IDENT whose name matches a registered effect decl is an effect
## claim. Lowercase idents, calls, and literals fall through to
## ordinary tc_expr (C.1 semantics). QZ0613 fires when the handler
## looks like an effect claim (PascalCase bare ident) but references
## no registered effect decl.
##
## C.4 will wire NODE_WITH to MIR_HANDLE_INSTALL/UNINSTALL; C.5 will
## replace the name-match convention with a structural Handler<E>
## type. Until then the effect claim mechanism is the bare-name form
## tested here.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("handler-block row narrowing (piezo C.2) — QZ0613 + QZ0610 silencing") do ->
    it("bare `with Throws` handles a Throws-rowed callee inside an otherwise-empty can") do ->
      assert_compile_succeeds("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = 1
def safe(): Int can = with Throws do ->
  risky()
end

def main(): Int = safe()
""")
    end

    it("bare `with Log` lets a `can Trace` caller invoke a `can Log, Trace` callee") do ->
      assert_compile_succeeds("""
effect Log
end
effect Trace
end

def both(): Int can Log, Trace = 1
def caller(): Int can Trace = with Log do ->
  both()
end

def main(): Int = caller()
""")
    end

    it("handler narrowing only applies inside the with block — QZ0610 fires outside") do ->
      assert_compile_error("""
effect Throws
end

def risky(): Int can Throws = 1
def caller(): Int can = risky()

def main(): Int = caller()
""", "QZ0610")
    end

    it("nested `with`s compose — both effects handled") do ->
      assert_compile_succeeds("""
effect Log
end
effect Throws
end

def both(): Int can Log, Throws = 1
def caller(): Int can = with Log do ->
  with Throws do ->
    both()
  end
end

def main(): Int = caller()
""")
    end

    it("`with UnknownEffect` emits QZ0613 when no effect decl is registered") do ->
      assert_compile_error("""
def caller(): Int can = with NoSuchEffect do ->
  1
end

def main(): Int = caller()
""", "QZ0613")
    end

    it("lowercase handler idents fall through to normal typecheck (no narrowing, no QZ0613)") do ->
      assert_compile_succeeds("""
def my_handler(): Int = 0

def plain(): Int
  return with my_handler() do ->
    42
  end
end

def main(): Int = plain()
""")
    end

    it("handler narrowing does NOT narrow a callee effect that isn't on the stack") do ->
      assert_compile_error("""
effect Log
end
effect Throws
end

def both(): Int can Log, Throws = 1
def caller(): Int can = with Log do ->
  both()
end

def main(): Int = caller()
""", "QZ0610")
    end
  end
  return qspec_main()
end
