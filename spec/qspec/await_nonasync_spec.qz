## Non-async await fix — T3b.5 Completion-Watch Blocking

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("non-async await: async+sched_spawn+await") do ->
    it("basic async spawn and await returns correct value") do ->
      assert_run_exits_timeout(basic_async_spawn_src(), 0)
    end
    it("multiple sequential awaits all return correct values") do ->
      assert_run_exits_timeout(multi_await_src(), 0)
    end
    it("10 tasks spawned and awaited concurrently") do ->
      assert_run_exits_timeout(concurrent_10_src(), 0)
    end
  end

  describe("non-async await: go+await") do ->
    it("go variable tracked as lazy-async, await works") do ->
      assert_run_exits_timeout(go_await_src(), 0)
    end
  end

  describe("non-async await: spawn+await (no scheduler)") do ->
    it("spawn uses pthread_join path, not completion pipes") do ->
      assert_run_exits_timeout(spawn_await_src(), 0)
    end
  end

  describe("non-async await: already-done task") do ->
    it("fast-path when task completes before await") do ->
      assert_run_exits_timeout(already_done_src(), 0)
    end
  end

  return qspec_main()
end

def basic_async_spawn_src(): String = """
  def work(x: Int): Int
    return x * 2
  end
  def main(): Int
    sched_init(2)
    var t = async work(21)
    sched_spawn(t)
    var r = await t
    sched_shutdown()
    if r == 42
      return 0
    end
    return 1
  end
  """

def multi_await_src(): String = """
  def work(x: Int): Int
    return x + 1
  end
  def main(): Int
    sched_init(2)
    var t1 = async work(10)
    sched_spawn(t1)
    var t2 = async work(20)
    sched_spawn(t2)
    var t3 = async work(30)
    sched_spawn(t3)
    var r1 = await t1
    var r2 = await t2
    var r3 = await t3
    sched_shutdown()
    if r1 == 11 and r2 == 21 and r3 == 31
      return 0
    end
    return 1
  end
  """

def concurrent_10_src(): String = """
  def work(id: Int): Int
    return id
  end
  def main(): Int
    sched_init(4)
    var tasks = vec_new()
    for i in 0..10
      var t = async work(i)
      sched_spawn(t)
      tasks.push(t)
    end
    var sum = 0
    for i in 0..10
      var r = await tasks[i]
      sum += r
    end
    sched_shutdown()
    if sum == 45
      return 0
    end
    return 1
  end
  """

def go_await_src(): String = """
  def work(x: Int): Int
    return x + 10
  end
  def main(): Int
    sched_init(2)
    var t = go work(32)
    var r = await t
    sched_shutdown()
    if r == 42
      return 0
    end
    return 1
  end
  """

def spawn_await_src(): String = """
  def work(x: Int): Int
    return x * 2
  end
  def main(): Int
    var t = go work(21)
    var r = await t
    if r == 42
      return 0
    end
    return 1
  end
  """

def already_done_src(): String = """
  def work(x: Int): Int
    return x
  end
  def main(): Int
    sched_init(4)
    var t = async work(99)
    sched_spawn(t)
    sched_yield()
    sched_yield()
    sched_yield()
    var r = await t
    sched_shutdown()
    if r == 99
      return 0
    end
    return 1
  end
  """
