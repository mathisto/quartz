# Compile-fail coverage for B.15c — the nil-literal wall (QZ0213).
#
# `nil` is not a typed value: flowing the syntactic `nil` literal into a
# heap/reference-typed slot (String, struct, enum, Option, Vec, …) is a hard
# compile error — use Option<T> + None. `nil` stays legal for scalar/Int and
# CPtr (FFI null) slots. This is the nil-literal subset of the eventual
# bare-Int wall; see docs/design/B15_NIL_ELIMINATION.md §7.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("nil-literal wall (B.15c, QZ0213)") do ->
    it("rejects `nil` into a struct slot") do ->
      var src = """
        struct Widget
          x: Int
        end
        def main(): Int
          w: Widget = nil
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `nil` into a String slot") do ->
      var src = """
        def main(): Int
          s: String = nil
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `nil` into a Vec slot") do ->
      var src = """
        def main(): Int
          v: Vec<Int> = nil
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `nil` into an Option slot (Q3-strict: use None)") do ->
      var src = """
        def main(): Int
          o: Option<Int> = nil
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("ACCEPTS `nil` into an Int slot (nil == 0, scalar)") do ->
      var src = """
        def main(): Int
          i: Int = nil
          return i
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("ACCEPTS `nil` into a CPtr slot (FFI null sentinel)") do ->
      var src = """
        def main(): Int
          p: CPtr = nil
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    # B.15d/N3.1 step-4c — newtypes classify by their WRAPPED type. An
    # Int-backed newtype is an i64 handle/index (scalar), so `nil`/bare-Int is
    # legal; a reference-backed newtype inherits its wrapped type's wall.
    it("ACCEPTS `nil` into an Int-backed newtype param (scalar handle)") do ->
      var src = """
        newtype NodeId = Int
        def handle(n: NodeId): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("rejects `nil` into a reference-backed newtype param") do ->
      var src = """
        newtype Email = String
        def handle(e: Email): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `return nil` from a struct-returning fn") do ->
      var src = """
        struct Widget
          x: Int
        end
        def make(): Widget
          return nil
        end
        def main(): Int
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("ACCEPTS `return nil` from a CPtr-returning fn (FFI)") do ->
      var src = """
        def get_ptr(): CPtr
          return nil
        end
        def main(): Int
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    # Arg-site wall (B.15c follow-up): `nil` flowing into a boxed parameter.
    it("rejects `nil` passed to a struct parameter") do ->
      var src = """
        struct Widget
          x: Int
        end
        def handle(w: Widget): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `nil` passed to a String parameter") do ->
      var src = """
        def handle(s: String): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("rejects `nil` passed to an Option parameter (Q3-strict: use None)") do ->
      var src = """
        def handle(o: Option<Int>): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end

    it("ACCEPTS `nil` passed to an Int parameter (nil == 0, scalar)") do ->
      var src = """
        def handle(i: Int): Int
          return i
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("ACCEPTS `nil` passed to a CPtr parameter (FFI null sentinel)") do ->
      var src = """
        def handle(p: CPtr): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    # Union interaction: `Int | Nil` is the union-world spelling of nullable —
    # `nil` is a legal inhabitant there and must NOT trip the wall. A union
    # WITHOUT a Nil member still rejects `nil`.
    it("ACCEPTS `nil` passed to a union with an explicit Nil member") do ->
      var src = """
        def handle(x: Int | Nil): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("rejects `nil` passed to a union without a Nil member") do ->
      var src = """
        def handle(x: Int | String): Int
          return 0
        end
        def main(): Int
          return handle(nil)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0213"), true)
    end
  end

  return qspec_main()
end
