## Operator Traits Tests
##
## Tests that trait implementations (both @derive and manual impl)
## correctly enable operator dispatch through op_* methods.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("@derive(Eq) enables operators") do ->
    it("== returns true for equal structs") do ->
      assert_run_exits(derive_eq_op_eq_src(), 1)
    end
    it("== returns false for unequal structs") do ->
      assert_run_exits(derive_eq_op_ne_src(), 1)
    end
    it("!= returns false for equal structs via derived op_ne") do ->
      assert_run_exits(derive_eq_op_ne_equal_src(), 0)
    end
    it("!= returns true for unequal structs via derived op_ne") do ->
      assert_run_exits(derive_eq_op_ne_bang_src(), 1)
    end
  end

  describe("@derive(Ord) enables operators") do ->
    it("< returns true when less") do ->
      assert_run_exits(derive_ord_lt_src(), 1)
    end
    it(">= via trait default") do ->
      assert_run_exits(derive_ord_ge_src(), 1)
    end
    it("<= via trait default") do ->
      assert_run_exits(derive_ord_le_src(), 1)
    end
    it("> via trait default") do ->
      assert_run_exits(derive_ord_gt_src(), 1)
    end
  end

  describe("impl Add/Sub enables operators") do ->
    it("impl Add for struct enables +") do ->
      assert_run_exits(impl_add_src(), 42)
    end
    it("impl Sub for struct enables -") do ->
      assert_run_exits(impl_sub_src(), 42)
    end
    it("chained arithmetic: a + b + c") do ->
      assert_run_exits(chained_add_src(), 60)
    end
  end

  describe("impl Index enables []") do ->
    it("struct with op_index supports subscript") do ->
      assert_run_exits(impl_index_src(), 42)
    end
  end

  describe("comparison operators return Bool") do ->
    it("overloaded == returns Bool, usable in if") do ->
      assert_run_exits(eq_returns_bool_src(), 42)
    end
    it("overloaded < returns Bool, usable in if") do ->
      assert_run_exits(lt_returns_bool_src(), 42)
    end
  end

  describe("mixed traits") do ->
    it("struct with both Add and Eq") do ->
      assert_run_exits(mixed_add_eq_src(), 1)
    end
  end

  return qspec_main()
end

def derive_eq_op_eq_src(): String = """
  import traits
  @derive(Eq)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    a = Point { x: 10, y: 20 }
    b = Point { x: 10, y: 20 }
    if a == b
      return 1
    end
    return 0
  end
  """

def derive_eq_op_ne_src(): String = """
  import traits
  @derive(Eq)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    a = Point { x: 10, y: 20 }
    b = Point { x: 10, y: 99 }
    if a == b
      return 0
    end
    return 1
  end
  """

def derive_eq_op_ne_bang_src(): String = """
  import traits
  @derive(Eq)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    a = Point { x: 10, y: 20 }
    b = Point { x: 10, y: 99 }
    if a != b
      return 1
    end
    return 0
  end
  """

def derive_eq_op_ne_equal_src(): String = """
  import traits
  @derive(Eq)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    a = Point { x: 10, y: 20 }
    b = Point { x: 10, y: 20 }
    if a != b
      return 1
    end
    return 0
  end
  """

def derive_ord_lt_src(): String = """
  import traits
  @derive(Ord)
  struct Score
    pts: Int
  end
  def main(): Int
    a = Score { pts: 10 }
    b = Score { pts: 20 }
    if a < b
      return 1
    end
    return 0
  end
  """

def derive_ord_ge_src(): String = """
  import traits
  @derive(Ord)
  struct Score
    pts: Int
  end
  def main(): Int
    a = Score { pts: 20 }
    b = Score { pts: 10 }
    if a >= b
      return 1
    end
    return 0
  end
  """

def derive_ord_le_src(): String = """
  import traits
  @derive(Ord)
  struct Score
    pts: Int
  end
  def main(): Int
    a = Score { pts: 10 }
    b = Score { pts: 20 }
    if a <= b
      return 1
    end
    return 0
  end
  """

def derive_ord_gt_src(): String = """
  import traits
  @derive(Ord)
  struct Score
    pts: Int
  end
  def main(): Int
    a = Score { pts: 20 }
    b = Score { pts: 10 }
    if a > b
      return 1
    end
    return 0
  end
  """

def impl_add_src(): String = """
  import traits
  struct Vec2
    x: Int
    y: Int
  end
  extend Vec2 with Add
    def op_add(a: Vec2, b: Vec2): Vec2
      return Vec2 { x: a.x + b.x, y: a.y + b.y }
    end
  end
  def main(): Int
    a = Vec2 { x: 10, y: 12 }
    b = Vec2 { x: 10, y: 10 }
    c = a + b
    return c.x + c.y
  end
  """

def impl_sub_src(): String = """
  import traits
  struct Vec2
    x: Int
    y: Int
  end
  extend Vec2 with Sub
    def op_sub(a: Vec2, b: Vec2): Vec2
      return Vec2 { x: a.x - b.x, y: a.y - b.y }
    end
  end
  def main(): Int
    a = Vec2 { x: 50, y: 30 }
    b = Vec2 { x: 20, y: 18 }
    c = a - b
    return c.x + c.y
  end
  """

def chained_add_src(): String = """
  import traits
  struct Num
    val: Int
  end
  extend Num with Add
    def op_add(a: Num, b: Num): Num
      return Num { val: a.val + b.val }
    end
  end
  def main(): Int
    a = Num { val: 10 }
    b = Num { val: 20 }
    c = Num { val: 30 }
    d = a + b + c
    return d.val
  end
  """

def impl_index_src(): String = """
  import traits
  struct Grid
    width: Int
    data: Vec<Int>
  end
  extend Grid with Index
    def op_index(g: Grid, key: Int): Int
      return vec_get(g.data, key)
    end
  end
  def main(): Int
    var d: Vec<Int> = vec_new()
    vec_push(d, 10)
    vec_push(d, 42)
    vec_push(d, 99)
    g = Grid { width: 3, data: d }
    return g[1]
  end
  """

def eq_returns_bool_src(): String = """
  struct Pt
    x: Int
  end
  extend Pt
    def op_eq(other: Pt): Bool
      return self.x == other.x
    end
  end
  def main(): Int
    a = Pt { x: 42 }
    b = Pt { x: 42 }
    if a == b
      return 42
    end
    return 0
  end
  """

def lt_returns_bool_src(): String = """
  struct Pt
    x: Int
  end
  extend Pt
    def op_lt(other: Pt): Bool
      return self.x < other.x
    end
  end
  def main(): Int
    a = Pt { x: 1 }
    b = Pt { x: 99 }
    if a < b
      return 42
    end
    return 0
  end
  """

def mixed_add_eq_src(): String = """
  import traits
  @derive(Eq)
  struct Num
    val: Int
  end
  extend Num with Add
    def op_add(a: Num, b: Num): Num
      return Num { val: a.val + b.val }
    end
  end
  def main(): Int
    a = Num { val: 10 }
    b = Num { val: 20 }
    c = a + b
    d = Num { val: 30 }
    if c == d
      return 1
    end
    return 0
  end
  """
