## panic-as-Throws (B.9 Phase 2)
##
## Contract:
##   1. `panic(msg)` inside `with Throws { throw: h } do -> ... end` is
##      caught by the handler.
##   2. The handler receives `"panic: " + msg` as its String argument.
##   3. The handler's return value becomes the with-block's value.
##   4. Execution continues after the with-block (panic does not abort).
##   5. `panic(msg)` outside any user `with Throws` block falls back to
##      the legacy abort path (preserves panic_caught/jmpbuf compatibility).

import * from qspec
import * from std/throws

# Module-level capture for panic-handler results so it() blocks can verify.
var b9_caught_msg = ""
var b9_caught_count = 0

def b9_recover(op_name: Int, argc: Int, argv: Int): Int
  b9_caught_msg = as_type<String>(load(argv, 0))
  b9_caught_count += 1
  return 42  # Handler return value flows back as with-block result
end

def b9_panic_inside_throws(): Int
  with Throws { throw: b9_recover } do ->
    panic("first")
    99  # NOT reached — panic unwinds via Throws.throw kind=2
  end
end

def b9_panic_chain(): Int
  var hits = 0
  with Throws { throw: b9_recover } do ->
    panic("alpha")
    0
  end
  hits += 1
  with Throws { throw: b9_recover } do ->
    panic("beta")
    0
  end
  hits += 1
  return hits
end

def main(): Int
  describe("panic as Throws.throw (B.9 Phase 2)") do ->
    it("panic inside with-Throws is caught with prefixed message") do ->
      b9_caught_msg = ""
      var r = b9_panic_inside_throws()
      assert_eq(r, 42)
      assert_eq_str(b9_caught_msg, "panic: first")
    end

    it("execution resumes after the with-block") do ->
      b9_caught_count = 0
      var hits = b9_panic_chain()
      assert_eq(hits, 2)
      assert_eq(b9_caught_count, 2)
      assert_eq_str(b9_caught_msg, "panic: beta")
    end

    it("regular throw still works alongside panic") do ->
      var r = with Throws { throw: b9_recover } do ->
        throw("regular throw")
        0
      end
      assert_eq(r, 42)
      assert_eq_str(b9_caught_msg, "regular throw")
    end
  end

  return qspec_main()
end
