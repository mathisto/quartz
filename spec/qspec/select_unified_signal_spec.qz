## C.13 Phase 5 — SignalSelectable trait dispatch. Synchronous-only
## invariants (no select-on-future). The contended active-fire test
## (worker raises, main observes via select) lives in
## spec/qz/select_unified_signal_smoke.qz — qspec describe/it lambdas
## don't compose with the `go worker(); raise()` pattern.

import * from qspec
import * from std/sync/composition/signal

extern "C" def raise(sig: CInt): CInt

def test_signalable_default_when_no_signal(): Int
  var s = signalable(SIGUSR2())  # SIGUSR2 unlikely to fire from a stray source
  var result = 0
  select
    case _ = s => result = 1
    default => result = 99
  end
  return result
end

def test_signalable_consumes_flag(): Int
  # Synchronous raise → select observes via try_poll → arm fires.
  # SIGUSR2 chosen to avoid clobbering SIGUSR1 used by the active-wake smoke.
  var s = signalable(SIGUSR2())
  raise(SIGUSR2())
  var result = 0
  select
    case sig = s => result = sig
    default => result = -1
  end
  return result
end

def test_signalable_second_poll_is_none(): Int
  # After the flag is consumed, the next select with the same
  # SignalSelectable must observe None (default arm wins).
  var s = signalable(SIGUSR2())
  raise(SIGUSR2())
  # First select consumes the flag.
  select
    case _ = s => 0
    default => 0
  end
  # Second select should default since no new signal arrived.
  var result = 0
  select
    case _ = s => result = 1
    default => result = 99
  end
  return result
end

def test_signalable_underscore_binding(): Int
  var s = signalable(SIGUSR2())
  raise(SIGUSR2())
  var result = 0
  select
    case _ = s => result = 11
    default => result = 22
  end
  return result
end

def main(): Int
  describe("select unified — SignalSelectable trait dispatch") do ->
    it("default arm fires when no signal has been delivered") do ->
      assert_eq(test_signalable_default_when_no_signal(), 99)
    end
    it("signalable arm fires after raise() — flag consumed via CAS") do ->
      # SIGUSR2 == 12
      assert_eq(test_signalable_consumes_flag(), 12)
    end
    it("second poll returns None — flag CAS is destructive") do ->
      assert_eq(test_signalable_second_poll_is_none(), 99)
    end
    it("signalable arm with `_` wildcard binding fires the body") do ->
      assert_eq(test_signalable_underscore_binding(), 11)
    end
  end

  return qspec_main()
end
