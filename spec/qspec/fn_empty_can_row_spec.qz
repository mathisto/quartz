## Regression — `Fn(...): T can` and `impl Trait can` (empty closed row)
##
## Pre-fix (2026-05-02), `Fn(): Void can` and `impl Iterator<Int> can` both
## SIGSEGV'd in tc_parse_type_impl: the suffix slice computation used
## `_can_idx + 5` (assuming a trailing space after " can"), but for end-of-
## annotation matches the marker has no trailing space → `start > end` →
## `qz_alloc_str(-1)` + `memcpy(-1)` blew up.
##
## Fix: `_can_idx + 4` at all 6 sites; `str_trim` already runs on the
## resulting suffix, so leading whitespace from the trailing-space case is
## handled. Empty closed row is semantically equivalent to no `can` clause.

import * from qspec

def fecr_render(): Void
  ## intentionally empty
end

def fecr_apply(f: Fn(): Void can): Int
  f()
  return 42
end

def fecr_apply_with_label(f: Fn(): Void can Sched): Int
  f()
  return 42
end

def main(): Int
  describe("Fn type with empty closed `can` row") do ->
    it("accepts `var f: Fn(): Void can = bare_fn`") do ->
      var f: Fn(): Void can = fecr_render
      f()
      assert_eq(1, 1)
    end

    it("accepts empty `can` in parameter position") do ->
      assert_eq(fecr_apply(fecr_render), 42)
    end

    it("treats empty `can` row as equivalent to no `can`") do ->
      var g: Fn(): Void = fecr_render
      var h: Fn(): Void can = fecr_render
      g()
      h()
      assert_eq(2, 2)
    end

    it("still accepts labelled `can Sched`") do ->
      assert_eq(fecr_apply_with_label(fecr_render), 42)
    end
  end

  return qspec_main()
end
