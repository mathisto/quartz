## Mutable Borrows Tests
##
## Contract:
##   1. `&mut x` syntax: parsed as exclusive borrow of mutable binding.
##   2. Write-back: mutation through `&mut` modifies the original.
##   3. Sequential borrows: after release, re-borrow OK.
##   4. Immutable binding: `&mut` of immutable = QZ1208.
##   5. Double exclusive: two `&mut` of same var = QZ1205.
##   6. Conflicting: `&` then `&mut` = QZ1206. `&mut` then `&` = QZ1206.
##   7. Mutation while borrowed: assign/compound-assign while active = QZ1209.
##   8. Return borrow of local: `return &x`/`return &mut x` = QZ1210.
##   9. Store borrow in struct: QZ1211.
##  10. Ephemeral release: call-site borrow released after call.
##  11. Borrow release on reassignment: `p = 0` releases old borrow.
##  12. Linear struct borrow: `&h` doesn't consume linear value.
##  13. Multiple shared borrows: `&x` + `&x` simultaneously OK.

import * from qspec
import * from qspec/subprocess

struct MBCounter
  val: Int
end

struct MBBox
  value: Int
end

struct MBData
  x: Int
end

struct MBPoint
  x: Int
  y: Int
end

linear struct MBHandle
  fd: Int
end

extend MBHandle with Drop
  def drop(self): Void
  end
end

def main(): Int
  describe("basic &mut borrow") do ->
    it("parses &mut T type annotation") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &mut x
          return 0
        end
        """, 0)
    end
    it("mutation through &mut writes back to original") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def set_x(p: &mut Pt, v: Int): Void
          p.x = v
        end
        def main(): Int
          var p = Pt { x: 0 }
          set_x(&mut p, 42)
          return p.x
        end
        """, 42)
    end
    it("allows sequential &mut borrows after release") do ->
      assert_run_exits("""
        struct Ct
          n: Int
        end
        def inc(c: &mut Ct): Void
          c.n = c.n + 1
        end
        def main(): Int
          var c = Ct { n: 40 }
          inc(&mut c)
          inc(&mut c)
          return c.n
        end
        """, 42)
    end
  end

  describe("backward compatibility") do ->
    it("&T immutable borrow still works") do ->
      assert_eq(mb_immutable_borrow(), 7)
    end

    it("&func_name function reference still works") do ->
      assert_eq(mb_func_ref(), 42)
    end
  end

  describe("error: immutable binding") do ->
    it("cannot &mut an immutable binding (QZ1208)") do ->
      assert_compile_error("""
        def main(): Int
          x = 42
          p = &mut x
          return 0
        end
        """, "QZ1208")
    end
  end

  describe("error: double exclusive borrow") do ->
    it("cannot create two &mut borrows of same variable (QZ1205)") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p1 = &mut x
          p2 = &mut x
          return 0
        end
        """, "QZ1205")
    end
  end

  describe("error: conflicting borrows") do ->
    it("cannot &mut when shared borrows exist (QZ1206)") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p1 = &x
          p2 = &mut x
          return 0
        end
        """, "QZ1206")
    end
    it("cannot & when exclusive borrow exists (QZ1206)") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p1 = &mut x
          p2 = &x
          return 0
        end
        """, "QZ1206")
    end
  end

  describe("&mut with linear struct") do ->
    it("borrow does not consume linear value") do ->
      assert_eq(mb_linear_borrow(), 99)
    end
  end

  describe("error: mutation while borrowed (QZ1209)") do ->
    it("cannot mutate with shared borrow") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p = &x
          x = 99
          return 0
        end
        """, "QZ1209")
    end
    it("cannot mutate with exclusive borrow") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p = &mut x
          x = 99
          return 0
        end
        """, "QZ1209")
    end
    it("cannot compound-assign while borrowed") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p = &x
          x += 1
          return 0
        end
        """, "QZ1209")
    end
    it("borrow without mutation compiles OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          p = &x
          return 0
        end
        """, 0)
    end
    it("sequential: ephemeral borrow then mutate OK") do ->
      assert_run_exits("""
        def peek(r: &Int): Int = 0
        def main(): Int
          var x = 42
          peek(&x)
          x = 99
          return x
        end
        """, 99)
    end
  end

  describe("error: return borrow of local (QZ1210)") do ->
    it("cannot return &x where x is local") do ->
      assert_compile_error("""
        def bad(): Int
          var x = 42
          return &x
        end
        def main(): Int
          return 0
        end
        """, "QZ1210")
    end
    it("cannot return &mut x where x is local") do ->
      assert_compile_error("""
        def bad(): Int
          var x = 42
          return &mut x
        end
        def main(): Int
          return 0
        end
        """, "QZ1210")
    end
    it("return value (no borrow) compiles OK") do ->
      assert_run_exits("""
        def good(): Int
          var x = 42
          return x
        end
        def main(): Int
          return good()
        end
        """, 42)
    end
  end

  describe("ephemeral shared borrow release") do ->
    it("shared borrow released after call, then &mut OK") do ->
      assert_run_exits("""
        def peek(r: &Int): Int = 0
        def main(): Int
          var x = 42
          peek(&x)
          var p = &mut x
          return 0
        end
        """, 0)
    end
    it("stored shared borrow blocks &mut (QZ1206)") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          p = &x
          q = &mut x
          return 0
        end
        """, "QZ1206")
    end
  end

  describe("error: store borrow in struct (QZ1211)") do ->
    it("cannot store &x in struct field") do ->
      assert_compile_error("""
        struct Holder
          ptr: Int
        end
        def main(): Int
          var x = 42
          h = Holder { ptr: &x }
          return 0
        end
        """, "QZ1211")
    end
    it("cannot store indirect borrow in struct field") do ->
      assert_compile_error("""
        struct Holder
          ptr: Int
        end
        def main(): Int
          var x = 42
          var r = &x
          h = Holder { ptr: r }
          return 0
        end
        """, "QZ1211")
    end
    it("struct init with non-borrow binding OK") do ->
      assert_run_exits("""
        struct Holder
          val: Int
        end
        def main(): Int
          var x = 42
          h = Holder { val: x }
          return 0
        end
        """, 0)
    end
    it("struct init without borrows compiles OK") do ->
      assert_run_exits("""
        struct Holder
          val: Int
        end
        def main(): Int
          h = Holder { val: 42 }
          return 0
        end
        """, 0)
    end
  end

  describe("borrow release on reassignment") do ->
    it("reassigning borrow holder releases old borrow") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var p = &x
          p = 0
          var q = &mut x
          return 0
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Multiple shared borrows
  # ===========================================================================
  describe("multiple shared borrows") do ->
    it("two shared borrows of same variable OK") do ->
      assert_run_exits("""
        def peek(r: &Int): Int = r + 0
        def main(): Int
          var x = 42
          var r1 = &x
          var r2 = &x
          return r1 + r2
        end
        """, 84)
    end
  end

  # ===========================================================================
  # Mutation after &mut release
  # ===========================================================================
  describe("mutation after &mut release") do ->
    it("mutation OK after ephemeral &mut call") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def set_x(p: &mut Pt, v: Int): Void
          p.x = v
        end
        def main(): Int
          var p = Pt { x: 0 }
          set_x(&mut p, 42)
          p.x = 99
          return p.x
        end
        """, 99)
    end
  end

  # ===========================================================================
  # Field/index assign while borrowed
  # ===========================================================================
  describe("field/index assign while borrowed") do ->
    it("field assign while borrowed = QZ1209") do ->
      assert_compile_error("""
        struct Pt
          x: Int
        end
        def main(): Int
          var p = Pt { x: 42 }
          var r = &p
          p.x = 99
          return 0
        end
        """, "QZ1209")
    end

    it("index assign while borrowed = QZ1209") do ->
      assert_compile_error("""
        def main(): Int
          var arr = [1, 2, 3]
          var r = &arr
          arr[0] = 99
          return 0
        end
        """, "QZ1209")
    end
  end

  # ===========================================================================
  # &mut write-back runtime verification
  # ===========================================================================
  describe("&mut write-back runtime") do ->
    it("sequential &mut calls accumulate writes") do ->
      assert_run_exits("""
        struct Counter
          n: Int
        end
        def add(c: &mut Counter, v: Int): Void
          c.n = c.n + v
        end
        def main(): Int
          var c = Counter { n: 0 }
          add(&mut c, 10)
          add(&mut c, 20)
          add(&mut c, 12)
          return c.n
        end
        """, 42)
    end
  end

  return qspec_main()
end

## &mut test functions removed — QZ1205 false positive in single-file compilation
## The RSpec version passes because each test compiles independently

def mb_point_sum(p: &MBPoint): Int
  return p.x + p.y
end

def mb_immutable_borrow(): Int
  var p = MBPoint { x: 3, y: 4 }
  return mb_point_sum(&p)
end

def mb_double(x: Int): Int
  return x * 2
end

def mb_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def mb_func_ref(): Int
  return mb_apply(&mb_double, 21)
end

def mb_peek(h: &MBHandle): Int
  return h.fd
end

def mb_linear_borrow(): Int
  var h = MBHandle { fd: 99 }
  val = mb_peek(&h)
  return val
end
