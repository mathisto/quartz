## Generics Advanced Tests
##
## Contract:
##   1. Vec<T> field: `GAContainer<Int>` with Vec<Int> works.
##   2. Multi-param: `GANested<T,U>` with first:T, second:Vec<U>.
##   3. Nested size: container .items.size tracks pushes.
##   4. Type alias: `type IntBox = Box<Int>` compiles and runs.
##   5. Cross-module: imported non-generic struct works.
##   6. Container arithmetic: sum of items via vec_get.
##   7. Multi-push: multiple pushes tracked in container.
import * from qspec
import * from qspec/subprocess
import struct_module

struct GAContainer<T>
  items: Vec<T>
end

struct GANested<T, U>
  first: T
  second: Vec<U>
end

def main(): Int
  describe("generics advanced") do ->
    it("substitutes T in Vec<T> field") do ->
      var c = GAContainer<Int> { items: vec_new() }
      c.items.push(42)
      assert_eq(c.items[0], 42)
    end

    it("substitutes multiple params in nested fields") do ->
      var n = GANested<Int, Int> { first: 10, second: vec_new() }
      n.second.push(20)
      assert_eq(n.first + n.second[0], 30)
    end

    it("substitutes Vec<Vec<T>> deeply nested") do ->
      var c = GAContainer<Int> { items: vec_new() }
      c.items.push(1)
      c.items.push(2)
      c.items.push(3)
      assert_eq(c.items.size, 3)
    end

    it("substitutes type param in generic type alias") do ->
      assert_run_exits(ga_type_alias_src(), 42)
    end
    it("instantiates imported non-generic struct") do ->
      r = struct_module::mod_rect_new(6, 7)
      assert_eq(struct_module::mod_rect_area(r), 42)
    end

    it("container items size tracks pushes") do ->
      var c = GAContainer<Int> { items: vec_new() }
      assert_eq(c.items.size, 0)
      c.items.push(1)
      c.items.push(2)
      assert_eq(c.items.size, 2)
    end

    it("nested fields arithmetic") do ->
      var n = GANested<Int, Int> { first: 5, second: vec_new() }
      n.second.push(10)
      n.second.push(15)
      assert_eq(n.first + n.second[0] + n.second[1], 30)
    end

    it("uses imported struct via factory (multi-file)") do ->
      var files: Vec = vec_new()
      files.push(as_int("factory.qz"))
      vec_push(files, as_int("""
        struct Pair
          a: Int
          b: Int
        end
        def make_pair(x: Int, y: Int): Pair = Pair { a: x, b: y }
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import factory
        def main(): Int
          var p = factory::make_pair(10, 20)
          return p.a
        end
        """))
      assert_multi_run_exits(files, 1, 10)
    end
  end
  return qspec_main()
end

def ga_type_alias_src(): String = """
  struct Box<T>
    value: T
  end
  type IntBox = Box<Int>
  def main(): Int
    b = IntBox { value: 42 }
    return b.value
  end
  """
