## SURF.FLOW A2 — equality-guard narrowing against the `None` sentinel.
## `x == Option::None` partitions an Option into None (then) vs Some (else);
## `x != Option::None` partitions it Some (then) vs None (else). This is the sound
## equality analog of `.none?` / `is None`, added to the guard classifier's
## OP_EQ/OP_NE arm.
##
## NOTE on the sentinel spelling: a bare `None` does NOT resolve as a value
## expression in Quartz today (QZ0403 "Undefined variable: None" — `None`/`Some`
## are only valid in pattern / `is` position, not as bare value exprs). The valid
## value-expression form of the sentinel is `Option::None` (NODE_ENUM_ACCESS,
## variant "None"), which is what A2 targets and what this spec exercises. Bare-
## `None`-as-value is a separate name-resolution feature, out of A2's scope.
##
## Observation model (identical to flow_narrow_p2_spec): a CORRECT narrowing
## extracts the Option payload (inner value → use_int → +100), an un-narrowed read
## passes the raw Option word (a garbage integer, NOT the payload). We assert the
## exact inner value where narrowing must fire, and `!= narrowed_value` where a
## refinement must NOT be present (invalidation / non-Option non-misfire).
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

# --- `x == Option::None` else-narrows the subject to Some ---

## `if o == Option::None ... else <o is Some>` — the else-branch narrows o to inner
## Int. Headline A/B: golden mis-types the else read (raw word); A2 narrows → 142.
def eq_none_else_narrow(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o == Option::None
    r = -1
  else
    r = use_int(o)
  end
  return r
end

## Same, on a niche Option<String>: else read yields the inner "payload".
def eq_none_else_narrow_niche_str(): String
  os: Option<String> = option_some("payload")
  var r = "MISS"
  if os == Option::None
    r = "WAS_NONE"
  else
    r = use_str(os)
  end
  return r
end

## Guard-style early-exit with `== Option::None`: the then-branch diverges (return)
## ⇒ the read after the if narrows to Some.
def eq_none_guard_return(): Int
  o: Option<Int> = option_some(42)
  if o == Option::None
    return -1
  end
  return use_int(o)
end

# --- operand-order: `Option::None == x` ---

## `if Option::None == o ... else <o narrowed>` — LHS is the None sentinel.
def none_eq_operand_order(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if Option::None == o
    r = -1
  else
    r = use_int(o)
  end
  return r
end

# --- `x != Option::None` then-narrows the subject to Some ---

## `if o != Option::None <o is Some>` — the then-branch narrows o to inner Int.
## `!=` is a DISTINCT binary op (OP_NE=8), not `not (==)`, so this exercises the
## dedicated OP_NE handling (A1's negation branch does NOT compose here).
def neq_none_then_narrow(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o != Option::None
    r = use_int(o)
  end
  return r
end

## operand-order for `!=`: `Option::None != o` then-narrows o.
def none_neq_operand_order(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if Option::None != o
    r = use_int(o)
  end
  return r
end

## `!= Option::None` else-branch: on the false path o is None ⇒ NOT narrowed. A bare
## read in the else must be the raw word, NOT 142.
def neq_none_else_no_narrow(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o != Option::None
    r = 1
  else
    r = use_int(o)   # o is None here — un-narrowed raw word, NOT 142
  end
  return r
end

# --- SOUNDNESS: invalidation after `== None`/`!= None` narrowing ---

## Reassigning a narrowed `var` between the guard and the use drops the narrowing.
## After `vo = option_some(2)`, the bare read must be un-narrowed (garbage), NOT the
## stale 102. If invalidation were broken, the stale narrow would extract 2 → 102.
def neq_none_reassign_invalidates(): Int
  var vo: Option<Int> = option_some(1)
  var r = 0
  if vo != Option::None
    vo = option_some(2)
    r = use_int(vo)   # invalidated: garbage; broken: 102
  end
  return r
end

## After the reassign-invalidation the value still reads correctly via unwrap (2).
def neq_none_reassign_then_unwrap(): Int
  var vo: Option<Int> = option_some(1)
  var r = 0
  if vo != Option::None
    vo = option_some(2)
    r = vo.unwrap()   # must read the NEW value 2
  end
  return r
end

# --- NEGATIVE: `== Option::None` on a non-Option subject must NOT misfire ---

## Comparing a non-Option value against the None sentinel must not narrow anything.
## `n` is a plain Int; the else read is just the Int (5). If A2 wrongly treated `n`
## as an Option and "narrowed" it, the read would be a garbage extraction, not 5.
## (The base-resolution tail requires TYPE_OPTION before emitting any fact.)
def eq_none_non_option_no_misfire(): Int
  n = 5
  var r = 0
  if n == Option::None
    r = -1
  else
    r = use_int_raw(n)   # plain Int passthrough → 5
  end
  return r
end

def main(): Int
  describe("SURF.FLOW A2 — `x == Option::None` else-narrows to Some") do ->
    it("narrows o to inner T in the else of `o == Option::None`") do ->
      assert_eq(eq_none_else_narrow(), 142)
    end
    it("narrows a niche Option<String> in the `== Option::None` else") do ->
      assert_eq_str(eq_none_else_narrow_niche_str(), "payload")
    end
    it("narrows after `if o == Option::None return end` (guard-style)") do ->
      assert_eq(eq_none_guard_return(), 142)
    end
    it("narrows with the `Option::None == o` operand order") do ->
      assert_eq(none_eq_operand_order(), 142)
    end
  end

  describe("SURF.FLOW A2 — `x != Option::None` then-narrows to Some") do ->
    it("narrows o to inner T in the then of `o != Option::None`") do ->
      assert_eq(neq_none_then_narrow(), 142)
    end
    it("narrows with the `Option::None != o` operand order") do ->
      assert_eq(none_neq_operand_order(), 142)
    end
    it("does NOT narrow o in the `!= Option::None` else (o is None there)") do ->
      assert_eq(neq_none_else_no_narrow() == 142, false)
    end
  end

  describe("SURF.FLOW A2 — SOUNDNESS: invalidation + non-misfire") do ->
    it("drops narrowing when the var is reassigned after `!= Option::None`") do ->
      assert_eq(neq_none_reassign_invalidates() == 102, false)
    end
    it("still reads the reassigned var correctly via unwrap") do ->
      assert_eq(neq_none_reassign_then_unwrap(), 2)
    end
    it("does NOT misfire on `== Option::None` against a non-Option subject") do ->
      assert_eq(eq_none_non_option_no_misfire(), 5)
    end
  end

  return qspec_main()
end
