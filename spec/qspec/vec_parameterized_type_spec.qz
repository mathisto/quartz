## Parameterized Vec<T> Type Tests
##
## Contract:
##   1. Vec<t> in return type position.
##   2. Vec<t> in struct field types.
##   3. Type inference from vec_new().
##   4. Method resolution for .push().
##   5. Index syntax on vec<t>.
##   6. Method syntax on vec<t> parameters.
##   7. Method syntax on map<k,v> parameters.
##   8. Type display.

import * from qspec
import * from qspec/subprocess

struct VptContainer
  items: Vec<Int>
end

def vpt_vec_int_return(): Int
  var v = vec_new()
  v.push(42)
  return v.size
end

def vpt_struct_field(): Int
  var c = VptContainer { items: vec_new() }
  c.items.push(1)
  c.items.push(2)
  c.items.push(3)
  return c.items.size
end

def vpt_infer(): Int
  var v = vec_new()
  v.push(1)
  v.push(2)
  v.push(3)
  return v.size
end

def vpt_push_param(v: Vec<Int>): Int
  v.push(10)
  v.push(20)
  return v.size
end

def vpt_pop_param(v: Vec<Int>): Int
  match v.pop()
    Some(val) => return val
    _ => return 0
  end
end

def vpt_size_param(v: Vec<Int>): Int
  return v.size
end

def vpt_empty_param(v: Vec<Int>): Int
  if v.empty?
    return 1
  end
  return 0
end

def vpt_hm_size(m: Map<String, Int>): Int
  return m.size
end

def vpt_vec_string_return(): Int
  var strs: Vec<String> = vec_new()
  strs.push("hello")
  strs.push("world")
  return strs.size
end

def main(): Int
  describe("Vec<T> in return type position") do ->
    it("allows Vec<Int> as return type") do ->
      assert_eq(vpt_vec_int_return(), 1)
    end

    it("allows Vec<String> as return type") do ->
      assert_eq(vpt_vec_string_return(), 2)
    end
  end

  describe("Vec<T> in struct field types") do ->
    it("allows Vec<Int> as struct field type") do ->
      assert_eq(vpt_struct_field(), 3)
    end
  end

  describe("type inference from vec_new()") do ->
    it("infers Vec type from vec_new() for method calls") do ->
      assert_eq(vpt_infer(), 3)
    end
  end

  describe("method resolution for .push()") do ->
    it("allows v.push(x) on Vec<Int> typed parameter") do ->
      var v = vec_new()
      assert_eq(vpt_push_param(v), 2)
    end

    it("allows v.pop() on Vec<Int> typed parameter") do ->
      var v = vec_new()
      v.push(42)
      v.push(99)
      assert_eq(vpt_pop_param(v), 99)
    end
  end

  describe("index syntax on Vec<T>") do ->
    it("allows v[i] read access") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[1], 20)
    end

    it("allows v[i] = x write access") do ->
      var v = vec_new()
      v.push(0)
      v[0] = 42
      assert_eq(v[0], 42)
    end
  end

  describe("method syntax on Vec<T> parameters") do ->
    it("allows .size on Vec<Int> typed parameter") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(vpt_size_param(v), 3)
    end

    it("allows .empty? on Vec<Int> typed parameter") do ->
      var v = vec_new()
      assert_eq(vpt_empty_param(v), 1)
    end
  end

  describe("method syntax on Map<K,V> parameters") do ->
    it("allows .size on Map<String, Int> typed parameter") do ->
      var m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      assert_eq(vpt_hm_size(m), 2)
    end
  end

  describe("type display") do ->
    it("shows Vec<Int> in error messages (compile-error test)") do ->
      assert_compile_error("def main(): Int\n  var v: Vec<Int> = vec_new()\n  vec_push(v, \"hello\")\n  return 0\nend\n", "expected element type Int")
    end
  end

  return qspec_main()
end
