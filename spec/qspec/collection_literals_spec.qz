## Collection Literals Tests
##
## Contract:
##   1. Vec literals.
##   2. Map construction.
##   3. Map literals in closures.

import * from qspec

def main(): Int
  describe("vec literals") do ->
    it("creates empty vec with []") do ->
      v = []
      assert_eq(v.size, 0)
    end

    it("creates vec with elements [a, b, c]") do ->
      v = [1, 2, 3]
      assert_eq(v.size, 3)
      assert_eq(v[0], 1)
      assert_eq(v[1], 2)
      assert_eq(v[2], 3)
    end

    it("infers element type from contents") do ->
      v = [10, 20, 30]
      x = v[0]
      assert_eq(x, 10)
    end

    it("allows nested vec literals") do ->
      v = [[1, 2], [3, 4]]
      inner = v[0]
      assert_eq(inner[1], 2)
    end

    it("allows trailing comma") do ->
      v = [1, 2, 3,]
      assert_eq(v.size, 3)
    end
  end

  describe("map construction") do ->
    it("creates empty map") do ->
      m = map_new()
      assert_eq(m.size(), 0)
    end

    it("creates map with entries") do ->
      m = map_new()
      m.set("foo", 1)
      m.set("bar", 2)
      match m.get("foo")
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match m.get("bar")
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
    end

    it("supports multiple entries") do ->
      m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      assert_eq(m.size(), 2)
    end

    it("supports expression values") do ->
      x = 40
      m = map_new()
      m.set("answer", x + 2)
      match m.get("answer")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end
  end

  describe("map literals in closures") do ->
    it("parses string-colon map in do-block") do ->
      m = {"name": 42}
      match m.get("name")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("parses multi-entry string-colon map in do-block") do ->
      m = {"a": 1, "b": 2, "c": 3}
      match m.get("a")
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match m.get("b")
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match m.get("c")
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
    end

    it("parses string-fatarrow map in do-block") do ->
      m = {"hello" => 10}
      match m.get("hello")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
    end

    ## NOTE: shorthand {key: val} stores key as symbol, not string —
    ## map_get with string key crashes; test only verifies creation + size
    it("parses shorthand ident-colon map in do-block") do ->
      m = {foo: 1, bar: 2}
      assert_eq(m.size(), 2)
    end

    it("parses empty map in do-block") do ->
      m = {}
      assert_eq(m.size(), 0)
    end
  end

  return qspec_main()
end
