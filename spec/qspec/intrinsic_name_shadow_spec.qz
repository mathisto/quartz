## QZ1410 — User `def NAME` that collides with a registered intrinsic
## must produce a hard typecheck error, not a silent miscompile.
##
## HISTORY: TUI v0.3.2 step 1 (2026-05-04) hit this with a helper
## `def to_int(b: Bool): Int` whose call sites were rewritten to the
## intrinsic's `fptosi double` codegen at MIR-lower time, bypassing the
## user function entirely. Output was 0\n0 instead of 1\n0; no warning
## was emitted. Filed at docs/bugs/INTRINSIC_NAME_SHADOW_SILENT_MISCOMPILE.md.
##
## FIX: tc_register_function_signature_named now checks for the collision
## against `tc_is_builtin` and emits a clear error. Stdlib paths
## (`/std/`, `/self-hosted/`) are exempt by convention — many stdlib
## modules ship a Quartz-level def alongside an intrinsic of the same
## name (e.g. `def str_split` in std/string.qz, `def unwrap` in
## std/prelude.qz).
##
## Contract:
##   1. User def shadowing an intrinsic by name produces a hard error.
##   2. The error message names the colliding function.
##   3. Renaming the user def to a non-intrinsic name compiles cleanly.
##   4. Stdlib defs (verified via the build itself, which imports
##      prelude on every invocation) continue to compile.
##   5. User def whose name does NOT collide with an intrinsic compiles.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ1410 intrinsic name shadow") do ->

    it("rejects user def 'to_int' that shadows F64->Int intrinsic") do ->
      assert_compile_error("""
def to_int(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def main(): Int
  return to_int(true)
end
""", "shadows a builtin intrinsic")
    end

    it("rejects user def 'task_id' that shadows scheduler intrinsic") do ->
      assert_compile_error("""
def task_id(): Int
  return 42
end

def main(): Int
  return task_id()
end
""", "shadows a builtin intrinsic")
    end

    it("error message names the colliding function") do ->
      assert_compile_error("""
def sched_init(n: Int): Void
  return
end

def main(): Int
  return 0
end
""", "Function 'sched_init'")
    end

    it("renamed user def compiles and runs correctly") do ->
      assert_run_exits("""
def b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def main(): Int
  return b2i(true) + b2i(false)
end
""", 1)
    end

    it("non-colliding user def name compiles cleanly") do ->
      assert_run_exits("""
def my_helper(x: Int, y: Int): Int
  return x + y
end

def main(): Int
  return my_helper(2, 3) - 5
end
""", 0)
    end

  end
  return qspec_main()
end
