## Phase 6.2.a — Quake verbosity + log effect migration acceptance spec.
##
## Operation Piezoelectric Effects, Phase 6 (user-tool dogfooding),
## subphase 6.2.a.
##
## Validates the migration of std/quake.qz's verbosity model from a
## process-global `var _verbose: Int = 0` to a `Reader<Int>` ambient
## installed at `quake_main()` entry, and the routing of `_print_cmd`
## through the `Log` effect so test harnesses can capture command
## echoes without subprocess-stdout-grepping.
##
## Migration semantics:
## - `sh*` helpers read verbosity via `ask()` instead of `_verbose`. They
##   carry `can Reader` because `Reader` is NOT in the typecheck blessed
##   set (unlike Throws/Log/FileIo/Intern/Yield); the cascade lands at
##   `Fn(): Void` task-action closure types where row checking is
##   permissive at the function-type boundary, so user Quakefiles need
##   zero annotations.
## - `_print_cmd` no longer calls `puts(...)` directly; it routes through
##   `log::raw(...)` so the installed Log handler intercepts command
##   echoes. `quake_main()` installs `_quake_log_stdout` (puts-to-stdout)
##   to preserve pre-6.2.a output behavior in production.
## - `quake_main()` is split into argv-parse + `_quake_dispatch(name)`.
##   Spec tests skip argv parsing and drive the Reader/Log scopes
##   directly — bypassing `quake_main`'s inner installs (which would
##   shadow per the body-wrap-shadows-outer-customization pattern).
##
## What this spec covers:
## - Module-shape sanity: std/quake imports cleanly with std/reader +
##   std/log dependencies wired through.
## - Reader install: `with Reader(N) do -> sh(...) end` makes `ask()`
##   inside `sh()` return N; verbose/normal/quiet levels behave
##   correctly relative to the `>= 1` echo gate.
## - Log capture: `with Log { emit: cap } do -> sh("true") end` captures
##   the `_print_cmd` echo when verbosity >= 1.
## - Composition: `with Reader(1), Log { emit: cap }` stacks cleanly;
##   capture handler sees the echo.
## - Nested Reader scopes: inner `with Reader(2)` shadows outer
##   `with Reader(0)` — verbose echo fires under inner only.
## - sh_capture also routes through Log (spot-check that the migration
##   covered all sh* helpers, not just `sh()`).
##
## What this spec does NOT cover (filed for follow-on):
## - End-to-end via real `quake` binary `--verbose`/`--quiet` flags:
##   the qspec subprocess harness lacks an `_with_args` runner. Smoke-
##   tested manually at migration time (see commit message). A future
##   `assert_run_stdout_eq_with_argv` helper unlocks the e2e test.
## - Reader-blessed-relaxation: today every `sh*` helper carries
##   `can Reader`. If/when Reader joins the blessed set with a runtime
##   default install, the annotations can drop. Filed as a Phase 7+
##   ergonomics improvement.
## - Buffered stdout interleaving: `_print_cmd`'s echo prints AFTER the
##   subprocess output because libc's stdout is line-buffered and
##   `system()` forks the child before parent's buffer flushes. This
##   is pre-existing behavior (matches pre-6.2.a `puts(...)`); spec
##   uses `sh("true")` to side-step the issue. Filed as a Tier 4 wart.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("quake verbosity + log effect migration (Phase 6.2.a)") do ->

    it("std/quake compiles with std/reader + std/log dependencies") do ->
      # Empty main that imports quake. Catches import-graph regressions
      # (missing std/reader, std/log; circular import; effect-decl
      # collision). Exit 0 = the import + module init runs cleanly.
      assert_run_exits("""
import * from quake

def main(): Int
  return 0
end
""", 0)
    end

    it("ask() inside sh() reads from outer with Reader install") do ->
      # The headline migration test: a `with Reader(2) do -> sh(...) end`
      # outer install propagates to `ask()` inside `sh()`. Without the
      # install, `ask()` would error (Reader is not blessed). With it,
      # `ask() >= 1` is true so the verbose echo fires through Log.
      # `colors_disable()` keeps the captured msg ASCII-only so the
      # assertion expected-string stays readable.
      assert_run_stdout_eq("""
import * from quake

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("LOG: " + msg)
  return 0
end

def main(): Int
  colors_disable()
  with Reader(2) do ->
    with Log { emit: cap } do ->
      with Exec { exec: default_exec_handler } do ->
        var _r = sh("true")
      end
    end
  end
  return 0
end
""", "LOG:   $ true\n")
    end

    it("ask()=0 (normal) suppresses verbose echo") do ->
      # Default verbosity → no `_print_cmd` call → no Log emit. The
      # capture handler never fires; only the marker line at the end
      # reaches stdout. Confirms the `if ask() >= 1` gate.
      assert_run_stdout_eq("""
import * from quake

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts("LOG: " + as_string(load(argv, 0)))
  return 0
end

def main(): Int
  colors_disable()
  with Reader(0) do ->
    with Log { emit: cap } do ->
      with Exec { exec: default_exec_handler } do ->
        var _r = sh("true")
      end
    end
  end
  puts("done")
  return 0
end
""", "done\n")
    end

    it("ask()=-1 (quiet) also suppresses verbose echo") do ->
      # Quiet mode: -1 < 1, so the verbose echo gate is closed.
      # Together with the previous test, this anchors the `>= 1`
      # threshold semantics rather than a bare-truthy check.
      assert_run_stdout_eq("""
import * from quake

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts("LOG: " + as_string(load(argv, 0)))
  return 0
end

def main(): Int
  colors_disable()
  with Reader(-1) do ->
    with Log { emit: cap } do ->
      with Exec { exec: default_exec_handler } do ->
        var _r = sh("true")
      end
    end
  end
  puts("done")
  return 0
end
""", "done\n")
    end

    it("nested with Reader: inner scope shadows outer") do ->
      # Outer `with Reader(0)` would suppress; inner `with Reader(2)`
      # shadows and triggers the echo. Confirms Reader's evidence-slot
      # stack push/pop semantics from Phase 2.b apply through the sh()
      # cascade.
      assert_run_stdout_eq("""
import * from quake

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts("LOG: " + as_string(load(argv, 0)))
  return 0
end

def main(): Int
  colors_disable()
  with Reader(0) do ->
    with Log { emit: cap } do ->
      with Exec { exec: default_exec_handler } do ->
        with Reader(2) do ->
          var _inner = sh("true")
        end
      end
    end
  end
  return 0
end
""", "LOG:   $ true\n")
    end

    it("sh_capture echoes through Log when verbosity >= 1") do ->
      # The migration applied identically to all five sh* helpers. This
      # spot-checks `sh_capture` alongside the bare `sh()` cases above.
      # `sh_capture("true")` runs the no-output cmd; the echo line
      # reaches stdout through the Log handler.
      assert_run_stdout_eq("""
import * from quake

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts("LOG: " + as_string(load(argv, 0)))
  return 0
end

def main(): Int
  colors_disable()
  with Reader(1) do ->
    with Log { emit: cap } do ->
      with Exec { exec: default_exec_handler } do ->
        var _out = sh_capture("true")
      end
    end
  end
  return 0
end
""", "LOG:   $ true\n")
    end

  end
  return qspec_main()
end
