## Drop auto-insertion coverage (backlog B2 / roadmap R2.2)
##
## Systematic coverage of the binding-death shapes that must (or must not)
## trigger auto-inserted Drop calls. Complements drop_spec.qz (which covers
## the happy-path RAII cases). This spec pins the full matrix of scope-exit
## points and locks the ratified NON-drop cases (throw-unwind, ownership
## escape, arena wholesale reclaim, mem_forget).
##
## Observation model — PURE IN-PROCESS. Every case is a named top-level
## helper that constructs/drops `trait Drop` values whose `drop()` bodies
## `puts` a marker. Each case is asserted with `assert_output` (the qspec
## in-process stdout-capture matcher, std/qspec/matchers.qz:398) so drop
## COUNT and ORDER are observed directly from captured stdout. NO subprocess
## is spawned, NO source string is compiled, and QUARTZ_COMPILER is never
## read — that pattern is banned on this machine (inner-compile OOM / orphan
## launcher loop). Per CLAUDE.md, assert_output takes a NAMED helper fn, not
## an inline closure.
##
## Three suspected coverage gaps were probed at the IR + runtime level
## (see backlog B2). Confirmed-REAL gaps are recorded as it_pending so this
## spec stays green while documenting the exact wrong behavior for the fix:
##   - GAP-1 (REAL): same-scope `var x` shadowing of a Drop struct shares one
##     stack slot -> first value leaked, second value double-dropped.
##   - GAP-2 (REAL): reassigning a `var` holding a Drop struct leaks the OLD
##     value and double-drops the NEW value. Reproduces in ALL shapes probed
##     (puts-literal/self-reading drop, same-module/imported) — broader than
##     the audit's imported-module-prefix hypothesis.
##   - GAP-3 (REFUTED): a bare call returning a Drop value inside a match arm
##     is captured as a __drop_tmp at the enclosing statement and dropped
##     exactly once. Kept as a real passing assertion below.
##   - GAP-4 (REAL, discovered here): `var r = make()` binding a call-returned
##     Drop value is never dropped at scope exit (leak); inline construct is.

import * from qspec
import * from std/throws

## One Drop trait, distinct marker structs per shape (so markers never
## collide across cases and each shape's drop is unambiguous on stdout).
trait Drop
  def drop(self): Void
  end
end

# --------------------------------------------------------------------------
# Marker structs — one per shape. Each drop() prints a shape-unique marker.
# --------------------------------------------------------------------------
struct B
  x: Int
end
extend B with Drop
  def drop(self): Void
    puts("drop B")
  end
end

struct G
  x: Int
end
extend G with Drop
  def drop(self): Void
    puts("drop G")
  end
end

struct E
  x: Int
end
extend E with Drop
  def drop(self): Void
    puts("drop E")
  end
end

struct L
  x: Int
end
extend L with Drop
  def drop(self): Void
    puts("drop L")
  end
end

struct C
  x: Int
end
extend C with Drop
  def drop(self): Void
    puts("drop C")
  end
end

struct N
  x: Int
end
extend N with Drop
  def drop(self): Void
    puts("drop N")
  end
end

struct M
  x: Int
end
extend M with Drop
  def drop(self): Void
    puts("drop M")
  end
end

struct M2
  x: Int
end
extend M2 with Drop
  def drop(self): Void
    puts("drop M2")
  end
end

struct MW
  x: Int
end
extend MW with Drop
  def drop(self): Void
    puts("drop MW")
  end
end

struct Trk
  x: Int
end
extend Trk with Drop
  def drop(self): Void
    puts("drop Trk")
  end
end

struct P
  x: Int
end
extend P with Drop
  def drop(self): Void
    puts("drop P")
  end
end

struct S
  x: Int
end
extend S with Drop
  def drop(self): Void
    puts("drop S")
  end
end

struct Inner
  x: Int
end
struct Outer
  inner: Inner
  y: Int
end
extend Inner with Drop
  def drop(self): Void
    puts("drop Inner")
  end
end
extend Outer with Drop
  def drop(self): Void
    puts("drop Outer")
  end
end

struct MF
  x: Int
end
extend MF with Drop
  def drop(self): Void
    puts("drop MF")
  end
end

struct TG
  x: Int
end
extend TG with Drop
  def drop(self): Void
    puts("drop TG")
  end
end

# GAP-4 marker: a Drop struct bound via a plain (non-escaping) call return.
struct CI
  x: Int
end
extend CI with Drop
  def drop(self): Void
    puts("drop CI")
  end
end

# GAP-1 marker: a Drop struct whose drop() prints its `x` so the FIRST shadowed
# value (SH{x:11}) and the SECOND value (SH{x:22}) are distinguishable in captured
# stdout. Same-scope `var x = SH{11}; var x = SH{22}` must drop BOTH values exactly
# once at scope exit (LIFO: the second value first, then the first): "drop SH 22"
# then "drop SH 11", never the first value leaked or the second double-dropped.
struct SH
  x: Int
end
extend SH with Drop
  def drop(self): Void
    var xv = self.x
    puts("drop SH #{xv}")
  end
end

# GAP-2 marker: a Drop struct whose drop() prints its `x` so the OLD value
# (RA{x:11}) and the NEW value (RA{x:22}) are distinguishable in captured
# stdout. Reassigning a `var` holding one must drop the OLD value once (at the
# assignment) then the NEW value once (at scope exit): "drop RA 11" then
# "drop RA 22", never the old value leaked or the new value double-dropped.
struct RA
  x: Int
end
extend RA with Drop
  def drop(self): Void
    # NB: bind self.x to a local before the call — passing a Copy-typed field of a
    # by-value `self` DIRECTLY to a call in a drop() body trips a spurious QZ1216
    # "use of moved field" (move-checker false positive; filed separately, not a
    # drop-soundness bug). The local read is a plain copy and compiles.
    var xv = self.x
    puts("drop RA #{xv}")
  end
end

# --------------------------------------------------------------------------
# Named case helpers — each is passed to assert_output; the marker(s) their
# drop() bodies emit ARE the captured stdout under observation.
# --------------------------------------------------------------------------

# Block-scope exit: inner block droppable dies before outer statement.
def case_block_exit(): Void
  if 1
    b = B { x: 1 }
    puts("in block")
  end
  puts("after block")
end

# Early return: local dies on the taken return path (inside the helper),
# then control returns to the case body which prints "after".
def early_return_f(flag: Int): Int
  g = G { x: 1 }
  if flag == 1
    return 10
  end
  puts("not reached")
  return 20
end
def case_early_return(): Void
  early_return_f(1)
  puts("after")
end

# Return-the-droppable: ownership escapes the producing function, so the
# producer must NOT drop the value it returns. make() prints "made" and does
# NOT emit "drop E" at ITS scope exit. The CALLER now OWNS the returned value,
# so its binding `r` IS dropped at the caller's scope exit (GAP-4 fix): "drop E"
# fires after "after". Producer-non-drop + caller-drop = exactly one drop.
def escape_make(): E
  puts("made")
  return E { x: 1 }
end
def case_escape(): Void
  var r = escape_make()
  puts("after")
end

# break: loop-body local dies on the break-out path.
def case_break(): Void
  var i = 0
  while i < 5
    t = L { x: i }
    i = i + 1
    if i == 2
      break
    end
  end
  puts("done")
end

# continue: loop-body local dies each iteration incl. the continued one.
def case_continue(): Void
  var i = 0
  while i < 3
    t = C { x: i }
    i = i + 1
    if i == 2
      continue
    end
  end
  puts("done")
end

# Nested-if branch-local: only the taken branch's local drops.
def case_nested_if(): Void
  var k = 1
  if k == 1
    a = N { x: 1 }
    puts("then")
  else
    b = N { x: 2 }
    puts("else")
  end
  puts("after")
end

# Match arm-local (first arm): drops exactly once at arm exit.
def case_match_first(): Void
  var x = 1
  match x
    1 =>
      g = M { x: 10 }
      puts("arm1")
    _ =>
      puts("other")
  end
  puts("after")
end

# Match arm-local (non-first arm): only the selected arm's local drops.
def case_match_nonfirst(): Void
  var x = 2
  match x
    1 =>
      puts("arm1")
    2 =>
      g = M2 { x: 20 }
      puts("arm2")
    _ =>
      puts("other")
  end
  puts("after")
end

# Match wildcard arm-local: drops exactly once.
def case_match_wildcard(): Void
  var x = 99
  match x
    1 =>
      puts("arm1")
    _ =>
      g = MW { x: 50 }
      puts("wild")
  end
  puts("after")
end

# GAP-3 (REFUTED): bare call returning a Drop value as a match-arm-body
# statement is captured (__drop_tmp) and dropped exactly once.
def trk_make(n: Int): Trk
  return Trk { x: n }
end
def case_match_barecall(): Void
  var k = 1
  match k
    1 =>
      trk_make(10)
    _ =>
      trk_make(20)
  end
  puts("after")
end

# Move-into-call: passing ownership to a function that consumes it; the
# callee drops the parameter at its exit, caller does not re-drop.
def consume_p(p: P): Int
  puts("consuming")
  return p.x
end
def case_move_into_call(): Void
  var r = consume_p(P { x: 42 })
  puts("after")
end

# Statement-expression temporary: a discarded Drop return at statement
# position is captured as __drop_tmp and dropped at scope exit.
def s_make(): S
  return S { x: 1 }
end
def case_stmt_temporary(): Void
  s_make()
  puts("after")
end

# Nested struct with Drop fields: field drops fire on the owner's death.
def case_nested_fields(): Void
  o = Outer { inner: Inner { x: 1 }, y: 2 }
  puts("alive")
end

# mem_forget: suppresses the drop of the named binding only.
def case_mem_forget(): Void
  a = MF { x: 1 }
  b = MF { x: 2 }
  mem_forget(a)
  puts("done")
end

# throw-unwind accept-leak (RATIFIED): Drop does NOT run when a scope is
# torn down by a throw/panic unwind. Observed in-process by wrapping a body
# that holds a live Drop local in `with Throws { throw: h } do`; the marker
# "drop TG" is ABSENT from captured stdout (only "caught\nafter\n").
def tg_handler(op_name: Int, argc: Int, argv: Int): Int
  puts("caught")
  return 0
end
def tg_risky(): Void
  g = TG { x: 1 }
  throw("boom")
  puts("unreachable")
end
def case_throw_unwind(): Void
  with Throws { throw: tg_handler } do ->
    tg_risky()
  end
  puts("after")
end

# Arena wholesale reclaim: arena-owned memory is freed by arena_destroy, NOT
# by per-value Drop. Raw arena intrinsics, no per-value marker.
def case_arena(): Void
  var a = arena_new()
  var p1 = arena_alloc(a, 32)
  var p2 = arena_alloc(a, 32)
  puts("allocated")
  arena_destroy(a)
  puts("destroyed")
end

# GAP-4 (FIXED): `var r = make()` binding a CALL-returned Drop value must be
# dropped exactly once at scope exit, identically to the inline-construct
# sibling `var r = CI{...}`. ci_make() prints "made ci" and does NOT drop
# (ownership escapes to the caller). The caller's `r` binding drops at scope
# exit -> "drop CI" fires after "after".
def ci_make(): CI
  puts("made ci")
  return CI { x: 7 }
end
def case_call_init_drop(): Void
  var r = ci_make()
  puts("after")
end

# GAP-2 (FIXED): reassigning a `var` holding a Drop struct drops the OLD value
# exactly once at the assignment, then the NEW value exactly once at scope exit.
# Expected stdout: the reassignment drops RA{11} ("drop RA 11"), then "mid",
# then scope exit drops the current value RA{22} ("drop RA 22").
# Root cause: a bare `d = RA{…}` reassignment lowers to a NODE_LET rebind
# (is_mut==0), routed through mir_lower_stmt_let — NOT NODE_ASSIGN. The struct-
# init branch pushed a SECOND droppable entry for `d`, so scope exit dropped the
# current value TWICE (old value leaked), and the LET path never released the old
# value. Fix: skip the duplicate push on a rebind and release the old value at the
# store site (mir_rebind_drop_old_value), mirroring the cow-rebind handler.
def case_var_reassign_drop(): Void
  var d = RA { x: 11 }
  d = RA { x: 22 }
  puts("mid")
end

# GAP-1 (FIXED): same-scope `var x` shadowing of a Drop struct. Two fresh `var x`
# bindings each push a droppable entry with the SAME name+depth. Before the fix both
# entries resolved their value at scope exit via load-by-name — which (allocas are
# name-keyed) read the LATEST slot value for BOTH — so the first value leaked and the
# second was double-dropped. Fix: on a fresh (non-rebind) shadow, spill the older
# binding's value into a distinct versioned slot before the new value overwrites the
# shared slot, and retarget the older droppable entry to it. Scope exit then drops
# each value exactly once (LIFO): the second SH{22} first, then the first SH{11}.
def case_shadow_drop(): Void
  var x = SH { x: 11 }
  var x = SH { x: 22 }
  puts("mid")
end

def main(): Int
  describe("Drop coverage — scope-exit shapes") do ->

    it("drops a block-scoped local at block exit") do ->
      assert_output("in block\ndrop B\nafter block\n", case_block_exit)
    end

    it("drops on early return before other statements") do ->
      assert_output("drop G\nafter\n", case_early_return)
    end

    it("does NOT drop a value in the returning function; caller owns + drops it (GAP-4)") do ->
      assert_output("made\nafter\ndrop E\n", case_escape)
    end

    it("drops loop-body local on break") do ->
      assert_output("drop L\ndrop L\ndone\n", case_break)
    end

    it("drops loop-body local on continue") do ->
      assert_output("drop C\ndrop C\ndrop C\ndone\n", case_continue)
    end

    it("drops only the taken nested-if branch local") do ->
      assert_output("then\ndrop N\nafter\n", case_nested_if)
    end

    it("drops first-arm match local exactly once") do ->
      assert_output("arm1\ndrop M\nafter\n", case_match_first)
    end

    it("drops non-first-arm match local exactly once") do ->
      assert_output("arm2\ndrop M2\nafter\n", case_match_nonfirst)
    end

    it("drops wildcard-arm match local exactly once") do ->
      assert_output("wild\ndrop MW\nafter\n", case_match_wildcard)
    end

    it("drops a bare-call Drop return inside a match arm exactly once") do ->
      assert_output("drop Trk\nafter\n", case_match_barecall)
    end

    it("drops a value moved into a call exactly once (callee owns it)") do ->
      assert_output("consuming\ndrop P\nafter\n", case_move_into_call)
    end

    it("drops a discarded statement-expression Drop temporary") do ->
      assert_output("after\ndrop S\n", case_stmt_temporary)
    end

    it("drops nested Drop fields when the owner dies") do ->
      assert_output("alive\ndrop Outer\ndrop Inner\n", case_nested_fields)
    end

    it("mem_forget suppresses drop of the named binding only") do ->
      assert_output("done\ndrop MF\n", case_mem_forget)
    end

    it("does NOT run Drop on throw-unwind (ratified accept-leak)") do ->
      assert_output("caught\nafter\n", case_throw_unwind)
    end

    it("reclaims arena memory wholesale (no per-value drop)") do ->
      assert_output("allocated\ndestroyed\n", case_arena)
    end

    # ------------------------------------------------------------------
    # GAP-1 (FIXED) — same-scope `var x` shadowing of a Drop struct. Two fresh
    # `var x` declarations each push a droppable entry with the same name+depth,
    # sharing ONE name-keyed alloca. Before the fix emit_drops_for_scope's
    # load-by-name read the LATEST slot value for BOTH ⇒ first value leaked +
    # second double-dropped. Fix: on a fresh (non-rebind) shadow,
    # mir_shadow_spill_prior_value spills the older binding's value into a distinct
    # versioned slot before the new value overwrites the shared slot, and retargets
    # the older droppable entry to it — so each value drops exactly once at scope
    # exit (LIFO: second SH{22} first, then first SH{11}).
    # ------------------------------------------------------------------
    it("drops both same-scope shadowed `var x` Drop values exactly once (GAP-1)") do ->
      assert_output("mid\ndrop SH 22\ndrop SH 11\n", case_shadow_drop)
    end

    # ------------------------------------------------------------------
    # GAP-2 (FIXED) — reassigning a `var` holding a Drop struct now drops the
    # OLD value exactly once at the assignment and the NEW value exactly once at
    # scope exit. A bare `d = D{…}` reassignment lowers to a NODE_LET rebind
    # (mir_lower_stmt_let), not NODE_ASSIGN: the struct-init branch pushed a
    # SECOND droppable entry (scope exit dropped the new value twice) and the LET
    # path never released the old value (leak). Fix: skip the duplicate push on a
    # rebind (mir_lower_stmt_handlers.qz) and release the old value + retarget the
    # entry at the store site (mir_rebind_drop_old_value, mir.qz), mirroring the
    # cow-rebind handler.
    # ------------------------------------------------------------------
    it("reassigning a var holding a Drop struct drops old once then new once (GAP-2)") do ->
      assert_output("drop RA 11\nmid\ndrop RA 22\n", case_var_reassign_drop)
    end

    # ------------------------------------------------------------------
    # GAP-4 (FIXED) — binding a Drop value produced by a CALL (`var r =
    # make()`) is now dropped exactly once at scope exit, identically to the
    # inline-construct sibling (`var r = E{...}`). The CALL-init droppable
    # push (mir_lower_stmt_handlers.qz ~1112) previously fired only for
    # cow-layout values; the non-cow `else` arm now pushes the binding
    # droppable when its (bare) type needs drop, mirroring the
    # NODE_STRUCT_INIT push. Guarded (mir_is_droppable_pushed) to exactly one
    # entry — no double-free.
    # ------------------------------------------------------------------
    it("drops a call-init `var r = make()` Drop value exactly once (GAP-4)") do ->
      assert_output("made ci\nafter\ndrop CI\n", case_call_init_drop)
    end

  end
  return qspec_main()
end
