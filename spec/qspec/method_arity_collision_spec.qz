## D4 — Regression lock for PSQ-1 (method vs free-function arity collision)
##
## Background: PSQ-1 originally reported that a free function named `fail`
## colliding with an impl method `Progress.fail(self, msg)` caused the
## typechecker to reject the free-function call with
##
##   Function fail requires at least 2 arguments, got 1
##
## i.e. the typechecker was picking the UFCS-expanded method (2 params) over
## the exact-arity free function (1 param). The workaround in tree renamed
## `Progress.fail` → `Progress.fail_with`.
##
## When D4 went to fix this, the bug no longer reproduced — some earlier
## commit closed it implicitly. This spec locks in the current correct
## behavior so it does not regress:
##   1. Free function `fail(1)` beats impl method `T.fail(2)` on 1-arg calls
##   2. Method still works via dot syntax: `p.fail("x")`
##   3. Method still works via UFCS when no colliding free function exists
##   4. Multi-overload free function resolution still works (arity_overload)
##   5. Wildcard-imported impl methods don't clobber local free functions

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("PSQ-1 — method-arity collision regression lock") do ->

    it("free function beats impl method at matching arity") do ->
      assert_run_exits("""
        struct Progress
          name: String
        end
        extend Progress
          def fail(self, msg: String): Int
            return 2
          end
        end
        def fail(msg: String): Int = 1
        def main(): Int
          return 0 if fail("x") == 1
          return 1
        end
        """, 0)
    end

    it("impl method still callable via dot syntax") do ->
      assert_run_exits("""
        struct Progress
          name: String
        end
        extend Progress
          def fail(self, msg: String): Int
            return 2
          end
        end
        def fail(msg: String): Int = 1
        def main(): Int
          var p = Progress { name: "p" }
          return 0 if p.fail("x") == 2
          return 1
        end
        """, 0)
    end

    it("impl method callable via UFCS when no free function collides") do ->
      assert_run_exits("""
        struct Progress
          name: String
        end
        extend Progress
          def step(self, msg: String): Int
            return 7
          end
        end
        def main(): Int
          var p = Progress { name: "p" }
          return 0 if p.step("x") == 7
          return 1
        end
        """, 0)
    end

    it("arity overloading still works for free functions") do ->
      assert_run_exits("""
        def g(a: Int): Int = 1
        def g(a: Int, b: Int): Int = 2
        def main(): Int
          return 0 if g(1) == 1 and g(1, 2) == 2
          return 1
        end
        """, 0)
    end

    it("wildcard-imported method does not clobber local free function") do ->
      # Use the real std/progress module which defines Progress with impl
      # methods. Then define a local `def fail(msg: String)` and call it.
      # This is the exact shape that PSQ-1 reported as broken.
      assert_run_exits("""
        import * from progress
        def fail(msg: String): Int = 42
        def main(): Int
          return 0 if fail("x") == 42
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
