## QSpec coverage for Phase E.4.a slice 4 — Vec<reference-typed-T>
## returns from goroutines via `arena_promote_vec_ref`.
##
## Phase E.4.a slice 2 (`go fn(): Vec<8-byte-value>`) handles primitive
## elements via raw-byte copy (`arena_promote_vec_value`). This covers
## `Vec<Int>`, `Vec<Float>`, etc. — element slots are already-promoted
## i64 values.
##
## Slice 4 extends to `Vec<reference-typed-T>` where T is itself
## arena-allocated and would dangle after `arena_destroy(ar)` if just
## byte-copied. The new helper `arena_promote_vec_ref(v, elem_kind,
## elem_aux)` is a polymorphic dispatcher that, per element, applies:
##   - elem_kind=2 → `arena_promote_string` (slice 1's helper)
##   - elem_kind=4 → `arena_promote_struct_value` (slice 3.a's helper)
## Other element kinds fall through to libc-heap fallback (correctness
## preserved). Vec<Vec<U>> is deferred to a future slice.
##
## What these tests prove:
##
##   E4a.s4.a — `go fn(): Vec<String>` body builds Vec of arena-allocated
##              Strings; await reads each element with correct content
##              (verifies per-element String promote).
##   E4a.s4.b — `go fn(): Vec<UniformStruct>` body builds Vec of
##              uniform-value-field structs; await reads each struct's
##              fields correctly (verifies per-element struct promote).
##   E4a.s4.c — Multi-worker (sched_init(0)) with parallel
##              Vec<String>-returning goroutines — no cross-task
##              corruption.
##   E4a.s4.d — Vec<Int> regression — slice 2's primitive fast path still
##              fires; not routed through slice 4's dispatcher.
##   E4a.s4.e — `go fn(): Vec<Vec<Int>>` body builds nested Vec; each
##              inner Vec is per-element-promoted via slice 2's helper
##              called through `as_vec` coercion (one level of nesting).

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# E4a.s4.a — Vec<String> with arena-allocated string elements.
# -----------------------------------------------------------------------------

var _VEC_STRING: String = """import * from std/sync/composition/go
import * from std/alloc

def build_strings(): Vec<String>
  var v = vec_new<String>()
  for i in 0..5
    v.push(\"item-\" + str_from_int(i))
  end
  return v
end

def main(): Int
  sched_init(1)
  var fut = go build_strings()
  var v = await fut
  if v.size == 5 and v[0] == \"item-0\" and v[2] == \"item-2\" and v[4] == \"item-4\"
    puts(\"vec-string-ok\")
  else
    puts(\"failed:size=\" + str_from_int(v.size))
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s4.b — Vec<UniformStruct> with arena-allocated struct elements.
# -----------------------------------------------------------------------------

var _VEC_STRUCT: String = """import * from std/sync/composition/go
import * from std/alloc

struct Pair
  a: Int
  b: Int
end

def build_pairs(): Vec<Pair>
  var v = vec_new<Pair>()
  for i in 0..5
    v.push(Pair { a: i, b: i * 2 })
  end
  return v
end

def main(): Int
  sched_init(1)
  var fut = go build_pairs()
  var v = await fut
  var ok = 0
  if v.size == 5
    var ok_count = 0
    for i in 0..5
      var p = v[i]
      if p.a == i and p.b == i * 2
        ok_count = ok_count + 1
      end
    end
    if ok_count == 5
      ok = 1
    end
  end
  if ok == 1
    puts(\"vec-struct-ok\")
  else
    puts(\"failed:size=\" + str_from_int(v.size))
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s4.c — Multi-worker parallel Vec<String> returns.
# -----------------------------------------------------------------------------

var _PARALLEL_VEC_STRING: String = """import * from std/sync/composition/go
import * from std/alloc

def labeled(n: Int): Vec<String>
  var v = vec_new<String>()
  v.push(\"task-\" + str_from_int(n))
  v.push(\"done-\" + str_from_int(n))
  return v
end

def main(): Int
  sched_init(0)
  var f1 = go labeled(1)
  var f2 = go labeled(2)
  var f3 = go labeled(3)
  var v1 = await f1
  var v2 = await f2
  var v3 = await f3
  if v1[0] == \"task-1\" and v2[0] == \"task-2\" and v3[0] == \"task-3\" and v1[1] == \"done-1\" and v2[1] == \"done-2\" and v3[1] == \"done-3\"
    puts(\"parallel-vec-string-ok\")
  else
    puts(\"failed\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s4.d — Vec<Int> regression: slice 2's kind=3 path still fires for
# primitive-element Vecs. Asserts content survives, count plausible.
# -----------------------------------------------------------------------------

var _VEC_INT_REGRESSION: String = """import * from std/sync/composition/go
import * from std/alloc

def build_ints(): Vec<Int>
  var v = vec_new<Int>()
  for i in 0..10
    v.push(i * 3)
  end
  return v
end

def main(): Int
  sched_init(1)
  var fut = go build_ints()
  var v = await fut
  if v.size == 10 and v[0] == 0 and v[5] == 15 and v[9] == 27
    puts(\"vec-int-ok\")
  else
    puts(\"failed:size=\" + str_from_int(v.size))
  end
  sched_shutdown()
  return 0
end
"""

var _NESTED_VEC: String = """import * from std/sync/composition/go
import * from std/alloc

def build_nested(): Vec<Vec<Int>>
  var v = vec_new<Vec<Int>>()
  for i in 0..3
    var inner = vec_new<Int>()
    for j in 0..4
      inner.push(i * 10 + j)
    end
    v.push(inner)
  end
  return v
end

def main(): Int
  sched_init(1)
  var fut = go build_nested()
  var v = await fut
  var ok = 0
  if v.size == 3
    var sum = 0
    for i in 0..3
      var inner = v[i]
      if inner.size == 4
        for j in 0..4
          sum = sum + inner[j]
        end
      end
    end
    if sum == 138
      ok = 1
    end
  end
  if ok == 1
    puts(\"nested-vec-ok\")
  else
    puts(\"failed\")
  end
  sched_shutdown()
  return 0
end
"""

def main(): Int
  describe("Phase E.4.a slice 4 — Vec<reference-typed> returns from goroutines via per-element promote") do ->
    it("Vec<String> elements promoted out of arena via arena_promote_string per element") do ->
      assert_run_stdout_eq(_VEC_STRING, "vec-string-ok\n")
    end

    it("Vec<UniformStruct> elements promoted out of arena via arena_promote_struct_value per element") do ->
      assert_run_stdout_eq(_VEC_STRUCT, "vec-struct-ok\n")
    end

    it("parallel Vec<String> goroutines under multi-worker scheduler (sched_init(0))") do ->
      assert_run_stdout_eq(_PARALLEL_VEC_STRING, "parallel-vec-string-ok\n")
    end

    it("Vec<Int> regression: slice 2's primitive fast path still fires (not routed through slice 4)") do ->
      assert_run_stdout_eq(_VEC_INT_REGRESSION, "vec-int-ok\n")
    end

    it("Vec<Vec<Int>> nested promote — inner Vecs deep-copied via as_vec coercion") do ->
      assert_run_stdout_eq(_NESTED_VEC, "nested-vec-ok\n")
    end
  end
  return qspec_main()
end
