## Maranget Pattern Exhaustiveness Checker Tests
##
## Contract:
##   1. Nested pattern exhaustiveness (Some(Ok(_)), Some(Err(_)), None).
##   2. Witness generation (missing pattern displayed in error).
##   3. Or-pattern handling.
##   4. Bool exhaustiveness.
##   5. Guard handling (conservative — guarded arms don't cover).
##   6. Unreachable arm detection (QZ0108).
##   7. Result exhaustiveness.
##   8. Multiple missing variants.

import * from qspec
import * from qspec/subprocess

enum MxShape
  Circle
  Square
  Triangle
end

enum MxTraffic
  Red
  Yellow
  Green
end

def main(): Int
  describe("Maranget exhaustiveness — basic enums") do ->
    it("accepts all variants covered") do ->
      assert_eq(mx_shape_sides(MxShape::Triangle), 3)
    end

    it("accepts wildcard catch-all") do ->
      assert_eq(mx_is_circle(MxShape::Square), 0)
    end

    it("rejects missing variant with witness") do ->
      assert_compile_error("enum S\n  A\n  B\n  C\nend\ndef main(): Int\n  s = S::A\n  return match s\n    S::A => 1\n    S::B => 2\n  end\nend\n", "non-exhaustive")
    end

    it("rejects single-variant enum without match") do ->
      assert_compile_error("enum One\n  Only\nend\ndef main(): Int\n  o = One::Only\n  return match o\n  end\nend\n", "at least one arm")
    end

    it("reports missing variant name in witness") do ->
      assert_compile_error("enum D\n  North\n  South\n  East\n  West\nend\ndef main(): Int\n  d = D::North\n  return match d\n    D::North => 0\n    D::South => 1\n    D::East => 2\n  end\nend\n", "West")
    end
  end

  describe("Maranget exhaustiveness — Bool") do ->
    it("accepts true and false covered") do ->
      assert_eq(mx_bool_name(true), 1)
      assert_eq(mx_bool_name(false), 0)
    end

    it("rejects missing true") do ->
      assert_compile_error("def main(): Int\n  b = false\n  return match b\n    false => 0\n  end\nend\n", "non-exhaustive")
    end

    it("rejects missing false") do ->
      assert_compile_error("def main(): Int\n  b = true\n  return match b\n    true => 1\n  end\nend\n", "non-exhaustive")
    end
  end

  describe("Maranget exhaustiveness — Int/String") do ->
    it("rejects Int without wildcard") do ->
      assert_compile_error("def main(): Int\n  x = 1\n  return match x\n    1 => 10\n    2 => 20\n  end\nend\n", "non-exhaustive")
    end

    it("accepts Int with wildcard") do ->
      assert_eq(mx_int_class(5), 99)
    end

    it("rejects String without wildcard") do ->
      assert_compile_error("def main(): Int\n  s = \"hi\"\n  return match s\n    \"a\" => 1\n  end\nend\n", "non-exhaustive")
    end

    it("accepts String with wildcard") do ->
      assert_eq(mx_str_match("hello"), 1)
    end
  end

  describe("Maranget exhaustiveness — or-patterns") do ->
    it("accepts or-pattern covering remaining variants") do ->
      assert_eq(mx_traffic_stop(MxTraffic::Yellow), 1)
    end

    it("rejects or-pattern that still misses variants") do ->
      assert_compile_error("enum T\n  A\n  B\n  C\n  D\nend\ndef main(): Int\n  t = T::A\n  return match t\n    T::A | T::B => 1\n    T::C => 2\n  end\nend\n", "non-exhaustive")
    end
  end

  describe("Maranget exhaustiveness — guards") do ->
    it("does not count guarded arm as covering") do ->
      assert_compile_error("enum G\n  X\n  Y\nend\ndef g_val(g: G): Int = 1\ndef main(): Int\n  g = G::X\n  return match g\n    G::X if g_val(g) > 0 => 1\n    G::Y => 2\n  end\nend\n", "non-exhaustive")
    end
  end

  describe("Maranget exhaustiveness — unreachable arms") do ->
    it("warns on duplicate enum variant") do ->
      assert_compile_warning("enum U\n  A\n  B\nend\ndef main(): Int\n  u = U::A\n  return match u\n    U::A => 1\n    U::B => 2\n    U::A => 3\n  end\nend\n", "QZ0108")
    end

    it("warns on wildcard after complete coverage") do ->
      assert_compile_warning("enum V\n  X\n  Y\nend\ndef main(): Int\n  v = V::X\n  return match v\n    V::X => 1\n    V::Y => 2\n    _ => 3\n  end\nend\n", "QZ0108")
    end

    it("warns on redundant bool arm") do ->
      assert_compile_warning("def main(): Int\n  b = true\n  return match b\n    true => 1\n    false => 0\n    true => 2\n  end\nend\n", "QZ0108")
    end
  end

  return qspec_main()
end

def mx_shape_sides(s: MxShape): Int
  match s
    MxShape::Circle => return 0
    MxShape::Square => return 4
    MxShape::Triangle => return 3
  end
end

def mx_is_circle(s: MxShape): Int
  match s
    MxShape::Circle => 1
    _ => 0
  end
end

def mx_bool_name(b: Bool): Int
  match b
    true => 1
    false => 0
  end
end

def mx_int_class(n: Int): Int
  match n
    0 => 10
    1 => 20
    _ => 99
  end
end

def mx_str_match(s: String): Int
  match s
    "hello" => 1
    _ => 0
  end
end

def mx_traffic_stop(t: MxTraffic): Int
  match t
    MxTraffic::Red | MxTraffic::Yellow => 1
    MxTraffic::Green => 0
  end
end
