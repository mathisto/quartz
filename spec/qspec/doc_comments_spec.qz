## Doc Comments Tests
##
## Contract:
##   1. ## syntax: parsed without affecting code execution.
##   2. ## on struct: struct with doc comment works normally.
##   3. ## on enum: enum with doc comment works normally.
##   4. ## multiline: consecutive ## lines preserved.
##   5. str_split: splits string on delimiter correctly.

import * from qspec

## A documented struct for testing
struct DcPoint
  x: Int
  y: Int
end

## Result of an operation
enum DcResult
  Ok(value: Int)
  Err(code: Int)
end

## Adds two numbers together.
def dc_add(a: Int, b: Int): Int
  return a + b
end

## First line of doc.
## Second line of doc.
def dc_double(x: Int): Int
  return x * 2
end

def dc_greet(): Int
  return 1
end

## Helper for str_split tests

def dc_split_count(): Int
  var text = "a,b,c"
  var parts = str_split(text, ",")
  return parts.size
end

def dc_split_no_match(): Int
  var text = "hello"
  var parts = str_split(text, ",")
  return parts.size
end

def dc_split_content(): Int
  var text = "hello,world"
  var parts = str_split(text, ",")
  var first = parts[0]
  var second = parts[1]
  if first == "hello"
    if second == "world"
      return 1
    end
  end
  return 0
end

def main(): Int
  describe("## syntax parsing") do ->
    it("parses doc comments on functions") do ->
      assert_eq(dc_add(1, 2), 3)
    end

    it("parses multi-line doc comments") do ->
      assert_eq(dc_double(21), 42)
    end

    it("parses doc comments on structs") do ->
      var p = DcPoint { x: 3, y: 4 }
      assert_eq(p.x + p.y, 7)
    end

    it("parses doc comments on enums") do ->
      var r = DcResult::Ok(42)
      match r
        Ok(v) => assert_eq(v, 42)
        Err(c) => assert_eq(c, 42)
      end
    end

    it("distinguishes doc comments from regular comments") do ->
      assert_eq(dc_greet(), 1)
    end
  end

  describe("str_split builtin") do ->
    it("splits a string by delimiter") do ->
      assert_eq(dc_split_count(), 3)
    end

    it("returns single element for no delimiter match") do ->
      assert_eq(dc_split_no_match(), 1)
    end

    it("preserves split content") do ->
      assert_eq(dc_split_content(), 1)
    end
  end

  return qspec_main()
end
