import * from qspec

# --- Helpers for assert_output ---

def print_factorial_0(): Void = puts("#{factorial(0)}")
def print_factorial_5(): Void = puts("#{factorial(5)}")
def print_fib_0(): Void = puts("#{fib(0)}")
def print_fib_1(): Void = puts("#{fib(1)}")
def print_fib_6(): Void = puts("#{fib(6)}")
def print_classify_neg(): Void = puts(classify(-5))
def print_classify_zero(): Void = puts(classify(0))
def print_classify_pos(): Void = puts(classify(42))
def print_bool_desc_true(): Void = puts(bool_desc(true))
def print_bool_desc_false(): Void = puts(bool_desc(false))
def print_add_0_5(): Void = puts("#{add(0, 5)}")
def print_add_3_0(): Void = puts("#{add(3, 0)}")
def print_add_3_4(): Void = puts("#{add(3, 4)}")
def print_wildcard(): Void = puts(wild(99))
def print_guard_complex(): Void = puts(range_label(50))
def print_guard_low(): Void = puts(range_label(-1))
def print_guard_high(): Void = puts(range_label(200))
def print_endless_block(): Void = puts("#{block_form(0)}")
def print_endless_block_other(): Void = puts("#{block_form(5)}")
def print_string_hello(): Void = puts(greet("hello"))
def print_string_bye(): Void = puts(greet("bye"))
def print_string_other(): Void = puts(greet("xyz"))
def print_guard_order_5(): Void = puts("#{guarded_add(5)}")
def print_guard_order_15(): Void = puts("#{guarded_add(15)}")
def print_guard_order_neg(): Void = puts("#{guarded_add(-3)}")

# --- Multi-clause function definitions ---

# Basic integer literal match
def factorial(0): Int = 1
def factorial(n: Int): Int = n * factorial(n - 1)

# Fibonacci (3 clauses)
def fib(0): Int = 0
def fib(1): Int = 1
def fib(n: Int): Int = fib(n - 1) + fib(n - 2)

# Guards with when
def classify(n: Int): String when n < 0 = "negative"
def classify(n: Int): String when n == 0 = "zero"
def classify(n: Int): String = "positive"

# Bool literal match
def bool_desc(true): String = "yes"
def bool_desc(false): String = "no"

# Multi-param with literal at position 1
def add(0, m: Int): Int = m
def add(n: Int, 0): Int = n
def add(n: Int, m: Int): Int = n + m

# Wildcard catch-all
def wild(_): String = "anything"

# Complex guard
def range_label(n: Int): String when n >= 0 and n < 100 = "in range"
def range_label(n: Int): String = "out of range"

# Block form (not endless def)
def block_form(0): Int
  return 42
end
def block_form(n: Int): Int
  return n * 2
end

# String literal matching
def greet("hello"): String = "hi there"
def greet("bye"): String = "see ya"
def greet(s: String): String = "unknown: " + s

# Guard ordering sensitivity — first matching guard wins
def guarded_add(n: Int): Int when n > 10 = n + 100
def guarded_add(n: Int): Int when n > 0 = n + 10
def guarded_add(n: Int): Int = n

def main(): Int
  describe("Multi-clause function definitions") do ->
    it("integer literal match — base case") do ->
      assert_output("1\n", print_factorial_0)
    end

    it("integer literal match — recursive case") do ->
      assert_output("120\n", print_factorial_5)
    end

    it("fibonacci — 3 clauses") do ->
      assert_output("0\n", print_fib_0)
    end

    it("fibonacci — second base case") do ->
      assert_output("1\n", print_fib_1)
    end

    it("fibonacci — recursive case") do ->
      assert_output("8\n", print_fib_6)
    end

    it("guards — negative") do ->
      assert_output("negative\n", print_classify_neg)
    end

    it("guards — zero") do ->
      assert_output("zero\n", print_classify_zero)
    end

    it("guards — positive") do ->
      assert_output("positive\n", print_classify_pos)
    end

    it("bool literal match — true") do ->
      assert_output("yes\n", print_bool_desc_true)
    end

    it("bool literal match — false") do ->
      assert_output("no\n", print_bool_desc_false)
    end

    it("multi-param — literal at position 0") do ->
      assert_output("5\n", print_add_0_5)
    end

    it("multi-param — literal at position 1") do ->
      assert_output("3\n", print_add_3_0)
    end

    it("multi-param — general case") do ->
      assert_output("7\n", print_add_3_4)
    end

    it("wildcard catch-all") do ->
      assert_output("anything\n", print_wildcard)
    end

    it("complex guard expression") do ->
      assert_output("in range\n", print_guard_complex)
    end

    it("guard fallthrough — low") do ->
      assert_output("out of range\n", print_guard_low)
    end

    it("guard fallthrough — high") do ->
      assert_output("out of range\n", print_guard_high)
    end

    it("block form — literal match") do ->
      assert_output("42\n", print_endless_block)
    end

    it("block form — general case") do ->
      assert_output("10\n", print_endless_block_other)
    end

    it("string literal match — hello") do ->
      assert_output("hi there\n", print_string_hello)
    end

    it("string literal match — bye") do ->
      assert_output("see ya\n", print_string_bye)
    end

    it("string literal match — fallthrough") do ->
      assert_output("unknown: xyz\n", print_string_other)
    end

    it("guard ordering — first matching wins (n>10)") do ->
      assert_output("115\n", print_guard_order_15)
    end

    it("guard ordering — second guard (n>0)") do ->
      assert_output("15\n", print_guard_order_5)
    end

    it("guard ordering — fallthrough (n<0)") do ->
      assert_output("-3\n", print_guard_order_neg)
    end
  end

  return qspec_main()
end
