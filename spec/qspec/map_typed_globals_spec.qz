## Map deep type threading + typed global variable declarations (F.2 Gaps #5/6)
## Gap #5: Map<K,V> with nested generic value types
## Gap #6: Module-level var declarations with type annotations
##
## Contract:
##   1. Deep typing: Map<String, Vec<Int>> compiles and runs.
##   2. Typed global Vec: `var g: Vec<String> = vec_new()` works.
##   3. Typed global simple: `var g: Int = 7` works.
##   4. Typed global Map: `var g: Map<String, String>` works.
##   5. Typed global mutation: typed global var can be mutated.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Map deep type threading") do ->
    it("Map<String, Vec<Int>> compiles and runs") do ->
      assert_run_exits(map_deep_src(), 30)
    end
  end

  describe("typed global variable declarations") do ->
    it("var name: Vec<String> = vec_new()") do ->
      assert_run_exits(typed_global_vec_src(), 44)
    end
    it("var name: Int = expr (simple type annotation)") do ->
      assert_run_exits(typed_global_simple_src(), 7)
    end
    it("var name: Map<String, String> typed global") do ->
      assert_run_exits(typed_global_map_src(), 42)
    end
    it("typed global var can be mutated") do ->
      assert_run_exits(typed_global_mutation_src(), 10)
    end
  end
  return qspec_main()
end

def map_deep_src(): String
  return """
def make_data(): Map<String, Vec<Int>>
  var m: Map<String, Vec<Int>> = map_new()
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  m.set("nums", v)
  return m
end
def main(): Int
  var data = make_data()
  var nums = 0
  match data.get("nums")
    Some(v) => nums = v
    _ => return 0
  end
  return nums[0] + nums[1]
end
"""
end

def typed_global_vec_src(): String
  return """
var g_names: Vec<String> = vec_new()
var g_data: Map<String, Int> = map_new()
def main(): Int
  g_names.push("hello")
  g_names.push("world")
  g_data.set("count", 42)
  var count = 0
  match g_data.get("count")
    Some(v) => count = v
    _ => return 0
  end
  return g_names.size + count
end
"""
end

def typed_global_simple_src(): String
  return """
var g_count: Int = 7
def main(): Int
  return g_count
end
"""
end

def typed_global_map_src(): String
  return """
var g_map: Map<String, Int> = map_new()
def main(): Int
  g_map.set("answer", 42)
  var result = 0
  match g_map.get("answer")
    Some(v) => result = v
    _ => return 0
  end
  return result
end
"""
end

def typed_global_mutation_src(): String
  return """
var g_val: Int = 5
def double_it(): Void
  g_val = g_val * 2
end
def main(): Int
  double_it()
  return g_val
end
"""
end
