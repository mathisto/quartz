## Range Listcomp Tests
##
## Contract:
##   1. Double: `[x*2 for x in 0..5]` doubles each element.
##   2. Empty: `0..0` produces empty list.
##   3. Square: `[x*x for x in 1..6]` squares elements.
##   4. Filter: `[x for x in 0..10 if x > 6]` filters.
##   5. Transform+filter: combined expression and condition.
##   6. Single: `1..2` produces single-element list.
##   7. Identity: `[x for x in 0..3]` copies elements.
import * from qspec

def main(): Int
  describe("range-based list comprehensions") do ->
    it("doubles each element from range") do ->
      result = [x * 2 for x in 0..5]
      assert_eq(result.size, 5)
      assert_eq(result[0], 0)
      assert_eq(result[1], 2)
      assert_eq(result[4], 8)
    end

    it("empty range produces empty list") do ->
      result = [x for x in 0..0]
      assert_eq(result.size, 0)
    end

    it("squares from range") do ->
      result = [x * x for x in 1..6]
      assert_eq(result.size, 5)
      assert_eq(result[0], 1)
      assert_eq(result[1], 4)
      assert_eq(result[4], 25)
    end

    it("range with filter condition") do ->
      result = [x for x in 0..10 if x > 6]
      assert_eq(result.size, 3)
      assert_eq(result[0], 7)
      assert_eq(result[1], 8)
      assert_eq(result[2], 9)
    end

    it("range with transform and filter") do ->
      result = [x * x for x in 0..10 if x > 6]
      assert_eq(result.size, 3)
      assert_eq(result[0], 49)
    end

    it("single element range") do ->
      result = [x for x in 1..2]
      assert_eq(result.size, 1)
      assert_eq(result[0], 1)
    end

    it("identity transform") do ->
      result = [x for x in 0..3]
      assert_eq(result.size, 3)
      assert_eq(result[0], 0)
      assert_eq(result[2], 2)
    end
  end
  return qspec_main()
end
