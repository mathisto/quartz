## Memory Ordering Tests
##
## Contract:
##   1. Acq_rel exchange works at.
##   2. Acquire cas works at.
##   3. Acquire load works at.
##   4. All five orderings produce.
##   5. Atomic_add emits acq_rel ordering.
##   6. Atomic_add emits relaxed ordering.
import * from qspec

def main(): Int
  describe("memory ordering") do ->
    it("acquire load works at runtime") do ->
      assert_eq(mo_acquire_load(), 42)
    end
    it("relaxed load works at runtime") do ->
      assert_eq(mo_relaxed_load(), 99)
    end
    it("release store works at runtime") do ->
      assert_eq(mo_release_store(), 55)
    end
    it("relaxed add works at runtime") do ->
      assert_eq(mo_relaxed_add(), 25)
    end
    it("release sub works at runtime") do ->
      assert_eq(mo_release_sub(), 170)
    end
    it("acquire CAS works at runtime") do ->
      assert_eq(mo_acquire_cas(), 50)
    end
    it("acq_rel exchange works at runtime") do ->
      assert_eq(mo_acqrel_exchange(), 10)
    end
    it("explicit seq_cst matches default") do ->
      assert_eq(mo_explicit_seqcst(), 20)
    end
    it("backward compat without ordering param") do ->
      assert_eq(mo_backward_compat(), 12)
    end
    it("fence does not crash at runtime") do ->
      assert_eq(mo_fence_runtime(), 0)
    end
    it("compiler_fence does not crash") do ->
      assert_eq(mo_compiler_fence(), 0)
    end
    it("store-release + load-acquire pattern") do ->
      assert_eq(mo_acqrel_pattern(), 42)
    end
    it("atomic_load defaults to seq_cst in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  val = atomic_load(ptr)
  qz_free(ptr)
  return val
end
""", "seq_cst")
    end

    it("atomic_load emits acquire ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  val = atomic_load(ptr, 2)
  qz_free(ptr)
  return val
end
""", "acquire")
    end

    it("atomic_load emits monotonic ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  val = atomic_load(ptr, 0)
  qz_free(ptr)
  return val
end
""", "monotonic")
    end

    it("atomic_store emits release ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  atomic_store(ptr, 42, 3)
  qz_free(ptr)
  return 0
end
""", "release")
    end

    it("atomic_store emits monotonic ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  atomic_store(ptr, 42, 0)
  qz_free(ptr)
  return 0
end
""", "monotonic")
    end

    it("atomic_add emits relaxed ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  val = atomic_add(ptr, 1, 0)
  qz_free(ptr)
  return val
end
""", "atomicrmw add")
    end

    it("atomic_add emits acq_rel ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  val = atomic_add(ptr, 1, 4)
  qz_free(ptr)
  return val
end
""", "acq_rel")
    end

    it("atomic_sub emits release ordering in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  ptr_write<Int>(ptr, 100)
  val = atomic_sub(ptr, 1, 3)
  qz_free(ptr)
  return val
end
""", "atomicrmw sub")
    end

    it("atomic_compare_exchange emits cmpxchg in IR") do ->
      assert_ir_contains("""
def main(): Int
  ptr = qz_malloc(8)
  ptr_write<Int>(ptr, 100)
  val = atomic_compare_exchange(ptr, 100, 200, 2)
  qz_free(ptr)
  return val
end
""", "cmpxchg")
    end

    it("atomic_exchange emits acq_rel") do ->
      assert_ir_contains("""
        def main(): Int
          var a = atomic_new(0)
          atomic_exchange(a, 1, 4)
          return 0
        end
        """, "atomicrmw xchg")
    end

    it("fence emits LLVM fence instruction in IR") do ->
      assert_ir_contains("""
def main(): Int
  fence(5)
  return 0
end
""", "fence seq_cst")
    end

    it("compiler_fence emits singlethread fence in IR") do ->
      assert_ir_contains("""
def main(): Int
  compiler_fence(5)
  return 0
end
""", "singlethread")
    end

    it("all five orderings produce correct IR (multi-assertion)") do ->
      src = """
        def main(): Int
          ptr = qz_malloc(8)
          atomic_store(ptr, 1, 0)
          v1 = atomic_load(ptr, 2)
          atomic_store(ptr, 2, 3)
          v2 = atomic_add(ptr, 1, 4)
          atomic_store(ptr, 3, 5)
          qz_free(ptr)
          return 0
        end
        """
      assert_ir_contains(src, "monotonic")
      assert_ir_contains(src, "acquire")
      assert_ir_contains(src, "release")
      assert_ir_contains(src, "acq_rel")
      assert_ir_contains(src, "seq_cst")
    end
  end
  return qspec_main()
end

def mo_acquire_load(): Int
  counter = atomic_new(42)
  return atomic_load(counter, 2)
end

def mo_relaxed_load(): Int
  counter = atomic_new(99)
  return atomic_load(counter, 0)
end

def mo_release_store(): Int
  counter = atomic_new(0)
  atomic_store(counter, 55, 3)
  return atomic_load(counter)
end

def mo_relaxed_add(): Int
  counter = atomic_new(10)
  old = atomic_add(counter, 5, 0)
  return old + atomic_load(counter)
end

def mo_release_sub(): Int
  counter = atomic_new(100)
  old = atomic_sub(counter, 30, 3)
  return old + atomic_load(counter)
end

def mo_acquire_cas(): Int
  counter = atomic_new(50)
  old = atomic_compare_exchange(counter, 50, 99, 2)
  if atomic_load(counter) == 99
    return old
  end
  return 0
end

def mo_acqrel_exchange(): Int
  counter = atomic_new(10)
  old = atomic_exchange(counter, 42, 4)
  return old
end

def mo_explicit_seqcst(): Int
  counter = atomic_new(10)
  atomic_store(counter, 20, 5)
  val = atomic_load(counter, 5)
  return val
end

def mo_backward_compat(): Int
  counter = atomic_new(0)
  atomic_store(counter, 10)
  old_add = atomic_add(counter, 5)
  old_sub = atomic_sub(counter, 3)
  val = atomic_load(counter)
  return val
end

def mo_fence_runtime(): Int
  fence(5)
  fence(2)
  fence(3)
  return 0
end

def mo_compiler_fence(): Int
  compiler_fence(5)
  compiler_fence(2)
  compiler_fence(3)
  return 0
end

def mo_acqrel_pattern(): Int
  data = atomic_new(0)
  flag = atomic_new(0)
  atomic_store(data, 42, 0)
  atomic_store(flag, 1, 3)
  fence(2)
  if atomic_load(flag, 2) == 1
    return atomic_load(data, 0)
  end
  return 0
end
