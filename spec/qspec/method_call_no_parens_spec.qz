## Dot-method paren elision (B.6)
##
## Contract:
##   1. obj.method (no parens) calls obj.method() when method is zero-arg
##   2. Works for impl methods on user structs
##   3. Works for open UFCS (free function whose first param matches receiver)
##   4. Field-vs-method precedence: field wins when both exist with same name
##   5. Chains: obj.method.method
##   6. Bare `foo` still resolves to the function value, not a call

import * from qspec

struct B6Point
  x: Int
  y: Int
end

extend B6Point
  def magnitude(self): Int = @x + @y
  def doubled(self): B6Point = B6Point { x: @x * 2, y: @y * 2 }
end

# Open UFCS: free function whose first param is a value type
def b6_triple(n: Int): Int = n * 3
def b6_negate(n: Int): Int = 0 - n

# Open UFCS: free function whose first param is a struct
def b6_describe(p: B6Point): Int = p.x * 100 + p.y

# Field-vs-method precedence: struct has field `tag` AND method `tag`
struct B6FieldMethod
  tag: Int
end

extend B6FieldMethod
  def tag(self): Int = 999  # Same name as field — field should win
end

# For chained no-parens: returns a struct, then call zero-arg method on result
def b6_chain_demo(): Int
  p = B6Point { x: 3, y: 4 }
  return p.doubled.magnitude  # ((3*2) + (4*2)) = 14
end

# Bare-fn-still-a-value test: pass a function as a value, don't auto-call
def b6_apply(f: Fn(Int): Int, n: Int): Int = f(n)

def main(): Int
  describe("dot-method paren elision") do ->
    it("impl method, no parens, returns value") do ->
      p = B6Point { x: 3, y: 4 }
      assert_eq(p.magnitude, 7)
    end

    it("open UFCS on Int, no parens") do ->
      assert_eq(5.b6_triple, 15)
    end

    it("open UFCS on Int, no parens, chained") do ->
      assert_eq(5.b6_triple.b6_negate, -15)
    end

    it("open UFCS on struct, no parens") do ->
      p = B6Point { x: 3, y: 4 }
      assert_eq(p.b6_describe, 304)
    end

    it("impl method chain, no parens at terminal") do ->
      assert_eq(b6_chain_demo(), 14)
    end

    it("explicit parens still work (refactoring safety)") do ->
      p = B6Point { x: 3, y: 4 }
      assert_eq(p.magnitude(), 7)
    end

    it("field-vs-method precedence: field wins") do ->
      r = B6FieldMethod { tag: 7 }
      # `r.tag` is the field (value 7), not the method (which would return 999)
      assert_eq(r.tag, 7)
      # `r.tag()` is unambiguously the method call
      assert_eq(r.tag(), 999)
    end

    it("bare function name remains a value reference") do ->
      # `b6_triple` (bareword, no dot) is still a function value, not a call.
      # Passing it via Fn-typed parameter must work as today.
      assert_eq(b6_apply(b6_triple, 4), 12)
    end
  end

  return qspec_main()
end
