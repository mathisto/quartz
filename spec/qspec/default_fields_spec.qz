## Default Struct Field Values
## Verifies that struct fields with default values can be omitted
## during initialization, and that the defaults are used correctly.
##
## Contract:
##   1. Default omit: omitting field with default uses the default.
##   2. Explicit override: providing value for default field overrides it.
##   3. Multiple defaults: struct with multiple default fields.
##   4. All defaults: struct where every field has a default.
##   5. Partial override: override some defaults, keep others.
##   6. Arithmetic: default values accessible in expressions.
##   7. Override all: override all default fields.
##   8. String default: default string field preserved.
##   9. Single default: struct with 1 required and 1 default field.

import * from qspec

struct DFPoint
  x: Int
  y: Int
  z: Int = 0
end

struct DFConfig
  name: String
  debug: Int = 0
  retries: Int = 3
end

struct DFAllDefaults
  a: Int = 10
  b: Int = 20
  c: Int = 30
end

def main(): Int
  describe("default struct field values") do ->
    it("uses default value when field is omitted") do ->
      var p = DFPoint { x: 1, y: 2 }
      assert_eq(p.x, 1)
      assert_eq(p.y, 2)
      assert_eq(p.z, 0)
    end

    it("allows explicit override of default value") do ->
      var p = DFPoint { x: 1, y: 2, z: 42 }
      assert_eq(p.x, 1)
      assert_eq(p.y, 2)
      assert_eq(p.z, 42)
    end

    it("supports multiple default fields") do ->
      var c = DFConfig { name: "app" }
      assert_eq_str(c.name, "app")
      assert_eq(c.debug, 0)
      assert_eq(c.retries, 3)
    end

    it("allows all fields to have defaults") do ->
      var a = DFAllDefaults {}
      assert_eq(a.a, 10)
      assert_eq(a.b, 20)
      assert_eq(a.c, 30)
    end

    it("allows partial override of defaults") do ->
      var c = DFConfig { name: "test", retries: 5 }
      assert_eq_str(c.name, "test")
      assert_eq(c.debug, 0)
      assert_eq(c.retries, 5)
    end

    it("arithmetic on default values") do ->
      var a = DFAllDefaults {}
      assert_eq(a.a + a.b + a.c, 60)
    end

    it("override all defaults") do ->
      var a = DFAllDefaults { a: 1, b: 2, c: 3 }
      assert_eq(a.a + a.b + a.c, 6)
    end

    it("default string field preserved on omission") do ->
      var c = DFConfig { name: "server" }
      assert_eq_str(c.name, "server")
      assert_eq(c.retries, 3)
    end

    it("single default field with required field") do ->
      var p = DFPoint { x: 100, y: 200 }
      assert_eq(p.x, 100)
      assert_eq(p.y, 200)
      assert_eq(p.z, 0)
      var p2 = DFPoint { x: 100, y: 200, z: 300 }
      assert_eq(p2.z, 300)
    end
  end

  return qspec_main()
end
