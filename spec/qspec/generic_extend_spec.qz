## Generic Extend Block Tests (Phase F-Gamma)
## Tests that extend blocks on generic types produce correctly mangled
## method names and work with monomorphization.
##
## Contract:
##   1. Qualified: `GBox::get(b)` calls extended generic method.
##   2. UFCS: `b.get()` dispatches to extended generic method.
##   3. Multi-param: `extend Pair<A,B>` with sum method.
##   4. Stdlib: extend works on stdlib types like Vec<T>.
##   5. T parameter: extend method taking T parameter.
##   6. Return T: extend method returning field of type T.
##   7. Two methods: extend block with two methods.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic extend block name mangling") do ->
    it("extend GBox<T> method via qualified call GBox::get") do ->
      assert_run_exits(gex_qualified_call_src(), 42)
    end

    it("extend GBox<T> method via UFCS dot syntax") do ->
      assert_run_exits(gex_ufcs_dot_src(), 42)
    end

    it("extend Pair<A, B> with multi-param generic") do ->
      assert_run_exits(gex_multi_param_src(), 30)
    end

    it("extend on stdlib Vec<T> type") do ->
      assert_run_exits(gex_stdlib_extend_src(), 42)
    end

    it("generic extend method with T parameter") do ->
      assert_run_exits(gex_method_with_t_param_src(), 42)
    end

    it("extend method returning T from field") do ->
      assert_run_exits(gex_return_t_src(), 42)
    end

    it("extend block with two methods") do ->
      assert_run_exits(gex_two_methods_src(), 52)
    end
  end

  return qspec_main()
end

## =============================================================================
## Helper source generators
## =============================================================================

def gex_qualified_call_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def get(): T = self.value
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return GBox::get(b)
  end
  """

def gex_ufcs_dot_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def get(): T = self.value
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return b.get()
  end
  """

def gex_multi_param_src(): String = """
  struct Pair<A, B>
    first: A
    second: B
  end
  extend Pair<A, B> {
    def sum(): Int = self.first + self.second
  }
  def main(): Int
    p = Pair<Int, Int> { first: 10, second: 20 }
    return p.sum()
  end
  """

def gex_stdlib_extend_src(): String = """
  def my_first(v: Vec<Int>): Int = vec_get(v, 0)
  def main(): Int
    var v: Vec<Int> = vec_new()
    vec_push(v, 42)
    return my_first(v)
  end
  """

def gex_method_with_t_param_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def replace(new_val: T): T = new_val
  }
  def main(): Int
    b = GBox<Int> { value: 10 }
    return GBox::replace(b, 42)
  end
  """

def gex_return_t_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def unwrap(): T = self.value
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return b.unwrap()
  end
  """

def gex_two_methods_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def get(): T = self.value
    def add(n: Int): Int = self.value + n
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return b.add(10)
  end
  """
