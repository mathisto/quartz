## Hybrid Open UFCS + Traits Integration Tests
##
## End-to-end test exercising all 5 phases together:
##   Phase 1: Open UFCS — free functions as methods
##   Phase 2: Self type — resolves to implementing type
##   Phase 3: Default methods — delegation, Self, override
##   Phase 4: Bounded generics — x.method() through trait bounds
##   Phase 5: Coherence — duplicate impl detection

import * from qspec

# ============================================================================
# Domain model: a small shape system
# ============================================================================

struct Circle
  radius: Int
end

struct Rect
  width: Int
  height: Int
end

# -- Traits --

trait Area
  def area(self): Int
    return 0
  end
end

trait Perimeter
  def perimeter(self): Int
    return 0
  end
end

trait Describe
  def describe(self): String
    return "shape"
  end
  # Default method using Self (Phase 2+3)
  def describe_with_area(self): String = "#{self.describe()} area=#{self.area()}"
end

# -- Impls --

extend Circle with Area
  def area(self): Int = @radius * @radius * 3
end

extend Rect with Area
  def area(self): Int = @width * @height
end

extend Circle with Perimeter
  def perimeter(self): Int = @radius * 2 * 6
end

extend Rect with Perimeter
  def perimeter(self): Int = (@width + @height) * 2
end

extend Circle with Describe
  def describe(self): String = "circle(r=#{@radius})"
end

extend Rect with Describe
  def describe(self): String = "rect(#{@width}x#{@height})"
end

# -- Open UFCS functions (Phase 1) --

def scale(c: Circle, factor: Int): Circle
  return Circle { radius: c.radius * factor }
end

def diagonal_sq(r: Rect): Int
  return r.width * r.width + r.height * r.height
end

def is_square(r: Rect): Bool = r.width == r.height

# -- Bounded generic functions (Phase 4) --

def total_area<T: Area>(shapes: Vec<T>): Int
  var sum = 0
  for i in 0..shapes.size
    sum += shapes[i].area()
  end
  return sum
end

def largest_area<T: Area>(a: T, b: T): Int
  aa = a.area()
  ab = b.area()
  if aa > ab
    return aa
  end
  return ab
end

def describe_shape<T: Describe + Area>(s: T): String
  return s.describe_with_area()
end

# ============================================================================
# Test helpers
# ============================================================================

def ht_circle_area(): Int
  c = Circle { radius: 5 }
  return c.area()
end

def ht_rect_perimeter(): Int
  r = Rect { width: 3, height: 4 }
  return r.perimeter()
end

def ht_open_ufcs_scale(): Int
  c = Circle { radius: 2 }
  big = c.scale(3)
  return big.radius
end

def ht_open_ufcs_chain(): Int
  c = Circle { radius: 1 }
  return c.scale(2).scale(3).area()
end

def ht_default_describe(): String
  c = Circle { radius: 5 }
  return c.describe_with_area()
end

def ht_bounded_total(): Int
  var circles = vec_new<Circle>()
  circles.push(Circle { radius: 1 })
  circles.push(Circle { radius: 2 })
  circles.push(Circle { radius: 3 })
  return total_area(circles)
end

def ht_bounded_largest(): Int
  c = Circle { radius: 10 }
  r = Rect { width: 20, height: 20 }
  return largest_area(r, r)
end

def ht_bounded_multi_trait(): String
  c = Circle { radius: 7 }
  return describe_shape(c)
end

def ht_literal_ufcs(): Int
  return [3, 1, 4, 1, 5].sum()
end

def ht_method_on_literal(): Bool
  return [10, 20, 30].contains(20)
end

# ============================================================================
# Tests
# ============================================================================

def main(): Int
  describe("hybrid UFCS + traits integration") do ->
    it("impl methods via dot syntax") do ->
      assert_eq(ht_circle_area(), 75)
      assert_eq(ht_rect_perimeter(), 14)
    end

    it("open UFCS: free function as method") do ->
      assert_eq(ht_open_ufcs_scale(), 6)
    end

    it("open UFCS chaining through impl + free") do ->
      assert_eq(ht_open_ufcs_chain(), 108)
    end

    it("default method delegates to overridden impl method") do ->
      assert_eq_str(ht_default_describe(), "circle(r=5) area=75")
    end

    it("bounded generic iterates and calls trait method") do ->
      assert_eq(ht_bounded_total(), 42)
    end

    it("bounded generic selects larger area") do ->
      assert_eq(ht_bounded_largest(), 400)
    end

    it("multiple trait bounds in bounded generic") do ->
      assert_eq_str(ht_bounded_multi_trait(), "circle(r=7) area=147")
    end

    it("UFCS on vec literal") do ->
      assert_eq(ht_literal_ufcs(), 14)
    end

    it("method call on literal") do ->
      assert_eq(ht_method_on_literal(), true)
    end

    it("open UFCS predicate on struct") do ->
      assert_eq(Rect { width: 5, height: 5 }.is_square(), true)
      assert_eq(Rect { width: 3, height: 7 }.is_square(), false)
    end
  end

  return qspec_main()
end
