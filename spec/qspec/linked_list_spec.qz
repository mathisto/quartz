## Linked List Tests
##
## Contract:
##   1. Ll_new.
##   2. Push_back and pop_front.
##   3. Push_front and pop_back.
##   4. Peek.
##   5. Get.
##   6. Contains.
##   7. To_vec.
##   8. Slot recycling.
import * from qspec
import * from collections/linked_list

def main(): Int
  describe("ll_new") do ->
    it("creates an empty list") do ->
      var ll = ll_new()
      assert_eq(ll.size(), 0)
      assert_eq(ll.is_empty(), 1)
      ll.free()
    end
  end

  describe("push_back and pop_front") do ->
    it("maintains FIFO order") do ->
      assert_eq(ll_fifo_test(), 1)
    end
  end

  describe("push_front and pop_back") do ->
    it("maintains order") do ->
      assert_eq(ll_push_front_test(), 1)
    end
  end

  describe("peek") do ->
    it("peeks at front and back") do ->
      assert_eq(ll_peek_test(), 1)
    end

    it("returns None on empty") do ->
      var ll = ll_new()
      assert(ll.peek_front().none?)
      assert(ll.peek_back().none?)
      ll.free()
    end
  end

  describe("get") do ->
    it("gets by index") do ->
      assert_eq(ll_get_test(), 1)
    end

    it("returns 0 for out of bounds") do ->
      var ll = ll_new()
      assert_eq(ll.get(0), 0)
      ll.free()
    end
  end

  describe("contains") do ->
    it("finds existing value") do ->
      assert_eq(ll_contains_test(), 1)
    end
  end

  describe("to_vec") do ->
    it("converts to Vec in order") do ->
      assert_eq(ll_to_vec_test(), 1)
    end
  end

  describe("slot recycling") do ->
    it("reuses freed slots") do ->
      assert_eq(ll_recycle_test(), 1)
    end
  end

  return qspec_main()
end

def ll_fifo_test(): Int
  var ll = ll_new()
  ll.push_back(10)
  ll.push_back(20)
  ll.push_back(30)
  var a = 0
  var b = 0
  var c = 0
  match ll.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  ll.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def ll_push_front_test(): Int
  var ll = ll_new()
  ll.push_front(10)
  ll.push_front(20)
  ll.push_front(30)
  # order: 30, 20, 10
  var a = 0
  var b = 0
  var c = 0
  match ll.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  ll.free()
  if a == 30
    if b == 20
      if c == 10
        return 1
      end
    end
  end
  return 0
end

def ll_peek_test(): Int
  var ll = ll_new()
  ll.push_back(10)
  ll.push_back(20)
  ll.push_back(30)
  var f = 0
  var b = 0
  match ll.peek_front()
    Some(v) => f = v
    _ => return 0
  end
  match ll.peek_back()
    Some(v) => b = v
    _ => return 0
  end
  ll.free()
  if f == 10
    if b == 30
      return 1
    end
  end
  return 0
end

def ll_get_test(): Int
  var ll = ll_new()
  ll.push_back(10)
  ll.push_back(20)
  ll.push_back(30)
  var a = ll.get(0)
  var b = ll.get(1)
  var c = ll.get(2)
  ll.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def ll_contains_test(): Int
  var ll = ll_new()
  ll.push_back(10)
  ll.push_back(20)
  ll.push_back(30)
  var has_20 = ll.contains(20)
  var has_99 = ll.contains(99)
  ll.free()
  if has_20
    if not has_99
      return 1
    end
  end
  return 0
end

def ll_to_vec_test(): Int
  var ll = ll_new()
  ll.push_back(1)
  ll.push_back(2)
  ll.push_back(3)
  var v = ll.to_vec()
  ll.free()
  if v.size == 3
    if v[0] == 1
      if v[1] == 2
        if v[2] == 3
          v.free()
          return 1
        end
      end
    end
  end
  v.free()
  return 0
end

def ll_recycle_test(): Int
  var ll = ll_new()
  ll.push_back(1)
  ll.push_back(2)
  ll.push_back(3)
  # Remove middle-ish and add new — slots should be reused
  ll.pop_front()
  ll.pop_front()
  ll.push_back(4)
  ll.push_back(5)
  # Should have: 3, 4, 5
  var a = 0
  var b = 0
  var c = 0
  match ll.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match ll.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  ll.free()
  if a == 3
    if b == 4
      if c == 5
        return 1
      end
    end
  end
  return 0
end
