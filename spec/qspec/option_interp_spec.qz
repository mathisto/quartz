## QZ0211 — Option/Result interpolation rejection
##
## Contract:
##   1. interpolating Option<T> directly is rejected with QZ0211.
##   2. interpolating Result<T,E> directly is rejected with QZ0211.
##   3. puts(opt) without interpolation is also rejected with QZ0211.
##   4. Workaround: opt.unwrap_or(default) typechecks AND prints the value.
##   5. Workaround: pattern-match form works.
##   6. Bare String / Int interpolation is unaffected.
##
## Backslash-escaped \#{...} in triple-quoted heredocs is a literal #{...}
## in the resulting String, so the spec source actually contains the
## interpolation form we want to reject.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ0211 Option Result interp rejection") do ->
    it("rejects bare Option from str find") do ->
      assert_compile_error("""
def main(): Int
  s = "alice,bob"
  opt = s.find(",")
  puts("opt = \#{opt}")
  return 0
end
""", "QZ0211")
    end

    it("rejects Result interpolation") do ->
      assert_compile_error("""
def divide(a: Int, b: Int): Result<Int, String>
  if b == 0
    return Err("divide by zero")
  end
  return Ok(a / b)
end
def main(): Int
  var r = divide(10, 2)
  puts("r = \#{r}")
  return 0
end
""", "QZ0211")
    end

    it("rejects puts opt without interpolation") do ->
      assert_compile_error("""
def main(): Int
  s = "alice,bob"
  opt = s.find(",")
  puts(opt)
  return 0
end
""", "QZ0211")
    end

    it("accepts unwrap or workaround") do ->
      assert_run_stdout_eq("""
def main(): Int
  s = "alice,bob"
  opt = s.find(",")
  puts("at = \#{opt.unwrap_or(-1)}")
  return 0
end
""", "at = 5\n")
    end

    it("accepts match form workaround") do ->
      assert_run_stdout_eq("""
def main(): Int
  s = "alice,bob"
  opt = s.find(",")
  match opt
    Some(v) => puts("found at \#{v}")
    None => puts("not found")
  end
  return 0
end
""", "found at 5\n")
    end

    it("does not regress bare String interpolation") do ->
      assert_run_stdout_eq("""
def main(): Int
  name = "Quartz"
  puts("hi \#{name}")
  return 0
end
""", "hi Quartz\n")
    end

    it("does not regress bare Int interpolation") do ->
      assert_run_stdout_eq("""
def main(): Int
  n = 42
  puts("answer = \#{n}")
  return 0
end
""", "answer = 42\n")
    end
  end

  return qspec_main()
end
