## Method Syntax Tests
##
## Contract:
##   1. Vec methods.
##   2. String methods.
##   3. Method chaining.

import * from qspec

def main(): Int
  describe("vec methods") do ->
    it("v.size returns size") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      assert_eq(v.size, 3)
    end

    it("v.push(x) appends element") do ->
      var v = vec_new()
      v.push(42)
      assert_eq(v[0], 42)
    end

    it("v.pop() removes and returns last") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      match v.pop()
        Some(x) => assert_eq(x, 20)
        _ => assert_eq(0, 1)
      end
      assert_eq(v.size, 1)
    end

    it("v.get(i) is explicit get") do ->
      var v = vec_new()
      v.push(99)
      assert_eq(v.get(0), 99)
    end

    it("v.set(i, x) is explicit set") do ->
      var v = vec_new()
      v.push(0)
      v.set(0, 42)
      assert_eq(v[0], 42)
    end
  end

  describe("string methods") do ->
    it("s.size returns string length") do ->
      s = "hello"
      assert_eq(s.size, 5)
    end

    it("s.find(needle) returns Option<Int>") do ->
      s = "hello world"
      match s.find("world")
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end

    it("s.slice(start, end) returns substring") do ->
      s = "hello world"
      sub = s.slice(0, 5)
      assert_eq_str(sub, "hello")
    end

    it("s.to_i converts string to int") do ->
      s = "42"
      assert_eq(str_to_int(s), 42)
    end

    it("n.to_s converts int to string") do ->
      n = 42
      assert_eq_str("#{n}", "42")
    end
  end

  describe("method chaining") do ->
    it("chains slice and size") do ->
      s = "hello world"
      assert_eq(s.slice(0, 5).size, 5)
    end
  end

  return qspec_main()
end
