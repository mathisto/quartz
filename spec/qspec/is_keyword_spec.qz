## Is Keyword Tests

import * from qspec

def main(): Int
  describe("is keyword") do ->
    it("checks Option::Some variant") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(42)
          if opt is Some
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("checks Option::None variant") do ->
      assert_run_exits("""
        def main(): Int
          var opt = option_none()
          if opt is None
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("returns false for non-matching variant") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(42)
          if opt is None
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("checks Result::Ok variant") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Ok(1)
          if r is Ok
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("checks Result::Err variant") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Err(0)
          if r is Err
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("Result::Ok is not Err") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Ok(1)
          if r is Err
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("works with not") do ->
      assert_run_exits("""
        def main(): Int
          var opt = option_none()
          if not (opt is Some)
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("works in postfix guard") do ->
      assert_run_exits("""
        def check(): Int
          var opt = option_none()
          return 0 if opt is Some
          return 99
        end
        def main(): Int
          return check()
        end
        """, 99)
    end

    it("works with user-defined enum") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          var c = Color::Green
          if c is Green
            return 2
          end
          return 0
        end
        """, 2)
    end

    it("user enum non-matching returns false") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          var c = Color::Red
          if c is Blue
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("works with payload enum variant") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Rect(w: Int)
        end
        def main(): Int
          var s = Shape::Circle(5)
          if s is Circle
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("works in boolean expression with and") do ->
      assert_run_exits("""
        def main(): Int
          var a = Option::Some(1)
          var b = Option::Some(2)
          if a is Some and b is Some
            return 3
          end
          return 0
        end
        """, 3)
    end
  end

  return qspec_main()
end
