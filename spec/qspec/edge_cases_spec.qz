## Edge Cases Tests
##
## Contract:
##   1. Absolute value.
##   2. Assert builtin.
##   3. Deeply nested if statements.
##   4. Deeply nested parentheses.
##   5. Deeply nested while loops.
##   6. Defines many functions.
import * from qspec

def main(): Int
  describe("edge cases") do ->
    it("minimal main function") do ->
      assert_eq(0, 0)
    end
    it("deeply nested if statements") do ->
      assert_eq(ec_nested_ifs(42), 42)
    end
    it("deeply nested while loops") do ->
      assert_eq(ec_nested_whiles(), 8)
    end
    it("deeply nested parentheses") do ->
      assert_eq(((((((((42))))))))  , 42)
    end
    it("nested function calls") do ->
      assert_eq(ec_inc(ec_inc(ec_inc(ec_inc(ec_inc(0))))), 5)
    end
    it("zero in various contexts") do ->
      x = 0
      y = 0 + 0
      z = 0 * 999
      assert_eq(42 + x + y + z, 42)
    end
    it("large multiplication") do ->
      big = 1000 * 1000
      assert_eq(big / 1000 / 1000 + 41, 42)
    end
    it("division that results in zero") do ->
      x = 5 / 10
      assert_eq(42 + x, 42)
    end
    it("modulo with various values") do ->
      a = 10 % 3
      b = 10 % 5
      c = 10 % 10
      assert_eq(a, 1)
      assert_eq(b, 0)
      assert_eq(c, 0)
    end
    it("uses many local variables") do ->
      assert_eq(ec_many_vars(), 14)
    end
    it("reassigns many variables") do ->
      assert_eq(ec_reassign(), 42)
    end
    it("defines many functions") do ->
      assert_eq(ec_f1(1) + ec_f2(2) + ec_f3(3) + ec_f4(4) + ec_f5(5), 15)
    end
    it("gcd algorithm") do ->
      assert_eq(ec_gcd(84, 42), 42)
    end
    it("power function") do ->
      assert_eq(ec_power(2, 5) + 10, 42)
    end
    it("max of two") do ->
      assert_eq(ec_max(42, 10), 42)
    end
    it("min of two") do ->
      assert_eq(ec_min(42, 100), 42)
    end
    it("absolute value") do ->
      assert_eq(ec_abs(42), ec_abs(-42))
    end
    it("assert builtin") do ->
      assert(1 == 1)
      assert(42 > 0)
      assert(true)
      assert_eq(1, 1)
    end
  end
  return qspec_main()
end
def ec_inc(x: Int): Int = x + 1
def ec_nested_ifs(x: Int): Int
  if x > 0
    if x > 10
      if x > 20
        if x > 30
          if x > 40
            return x
          end
        end
      end
    end
  end
  return 0
end
def ec_nested_whiles(): Int
  var count = 0
  var i = 0
  while i < 2
    var j = 0
    while j < 2
      var k = 0
      while k < 2
        count += 1
        k = k + 1
      end
      j += 1
    end
    i = i + 1
  end
  return count
end
def ec_many_vars(): Int
  a1 = 1
  a2 = 2
  a3 = 3
  a4 = 4
  a5 = 5
  a6 = a1 + a2
  a7 = a3 + a4
  a8 = a5 + a6
  a9 = a7 + a8
  a10 = a9 - a1
  return a10
end
def ec_reassign(): Int
  var x = 1
  x = x * 2
  x = x + 10
  x = x * 3
  x = x + 6
  return x
end
def ec_f1(x: Int): Int = x
def ec_f2(x: Int): Int = x
def ec_f3(x: Int): Int = x
def ec_f4(x: Int): Int = x
def ec_f5(x: Int): Int = x
def ec_gcd(a: Int, b: Int): Int
  var x = a
  var y = b
  while y != 0
    t = y
    y = x % y
    x = t
  end
  return x
end
def ec_power(base: Int, exp: Int): Int
  var result = 1
  var i = 0
  while i < exp
    result = result * base
    i = i + 1
  end
  return result
end
def ec_max(a: Int, b: Int): Int
  if a > b
    return a
  end
  return b
end
def ec_min(a: Int, b: Int): Int
  if a < b
    return a
  end
  return b
end
def ec_abs(x: Int): Int
  if x < 0
    return -x
  end
  return x
end
