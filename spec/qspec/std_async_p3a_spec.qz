## std/async — Phase 3 Milestone P3.A acceptance spec.
##
## Operation Piezoelectric Effects, Phase 3, Milestone P3.A.
##
## Validates the dormant `Async` effect declaration lands cleanly:
##
##   * `import std/async` succeeds (cross-module decl registration).
##   * `effect Async { await, spawn, suspend, yield }` appears in the
##     typecheck registry with classified op kinds.
##   * `can Async` parses on a function signature and propagates through
##     the effect row via HM-style inference.
##   * Declaration is dormant: `can Async` callers **typecheck** without
##     routing through the scheduler — P3.B wires the default handler,
##     P3.C onward migrates NODE_AWAIT/NODE_GO/io_suspend to
##     `perform(Async, ...)`.
##
## Three of the four Async ops classify **kind=3** (operation,
## continuation-preserving) per memo §2.4 — the `= operation` marker on
## `await` / `suspend` / `yield` upgrades the default 0/1 kind to 3 via
## tc_body_is_operation_marker in typecheck_walk.qz.
##
## `spawn` is intentionally **kind=1** (function-kind): it submits a
## closure to the scheduler and returns a handle. Control continues in
## the caller; no continuation is captured. Forcing kind=3 would
## $poll-lower every `go`-containing function (including synchronous
## `main`) — large regression surface with no benefit. See P3.D design
## memo and std/async.qz's doc comment.
##
## P3.0 (F.3c-real) shipped the kind=3 runtime machinery; P3.A wires it
## to the Async declaration. Subsequent milestones (P3.B handler,
## P3.C await migration, P3.D spawn migration, P3.E io/yield) cut
## NODE_AWAIT / NODE_GO / io_suspend / sched_yield over to the new path.

import * from qspec
import * from qspec/subprocess

def _decl_dump(src: String): SubResult = subprocess_compile_with_flags(src, "--dump-effect-decls")

def _row_dump(src: String): SubResult = subprocess_compile_with_flags(src, "--dump-effect-rows")

def _assert_contains(haystack: String, needle: String): Void
  _inc_assertions()
  if not str_contains(haystack, needle)
    var sb = sb_new()
    sb.append("Expected stderr to contain '")
    sb.append(needle)
    sb.append("' but got: ")
    sb.append(haystack)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("std/async Phase 3 P3.A decl + classifier") do ->
    it("import std/async registers Async with 4 ops (await/suspend/yield kind=3, spawn kind=1)") do ->
      var r = _decl_dump("""
import std/async

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Async op=await kind=3")
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Async op=spawn kind=1")
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Async op=suspend kind=3")
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Async op=yield kind=3")
    end

    it("`= operation` marker forces kind=3 on a user effect decl") do ->
      # Direct test of the classifier entry point: any abstract op tagged
      # `= operation` upgrades from kind=0/1 to kind=3, independent of
      # param count. Future effects (Ndet.choose once landed) rely on this.
      var r = _decl_dump("""
effect Custom
  def no_arg_value(): Int = operation
  def one_arg_fn(x: Int): Int = operation
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Custom op=no_arg_value kind=3")
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Custom op=one_arg_fn kind=3")
    end

    it("`can Async` parses on a function signature and reaches the row registry") do ->
      var r = _row_dump("""
import std/async

def task_placeholder(): Int can Async = 0

def main(): Int = task_placeholder()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "labels=Async tail=")
    end

    it("`can Async` row composes with another effect label") do ->
      var r = _row_dump("""
import std/async

def scheduled_log(): Int can Async, Log = 0

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "labels=Async,Log tail=")
    end

    it("cross-module duplicate effect Async fires QZ0612") do ->
      # Declaring `effect Async` locally while also importing std/async
      # hits the registered-name guard — same D.7 cross-module protection
      # that std/log relies on.
      assert_compile_error("""
import std/async

effect Async
  def await(handle: Int): Int
end

def main(): Int = 0
""", "QZ0612")
    end

    it("importing std/async does not break programs that never mention Async") do ->
      # Dormancy smoke test — std/async's declaration must not force
      # `can Async` onto every imported function, or the whole codebase
      # would need annotations when it doesn't use async at all.
      assert_run_exits("""
import std/async

def main(): Int
  puts("no async here")
  return 0
end
""", 0)
    end
  end
  return qspec_main()
end
