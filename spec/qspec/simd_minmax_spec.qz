## Simd Minmax Tests
##
## Contract:
##   1. Simd_f32x4_abs takes absolute value.
##   2. Simd_f32x4_max selects maximum.
##   3. Simd_f32x4_min selects minimum.
##   4. Simd_f64x2_abs takes absolute value.
##   5. Simd_f64x2_max selects maximum.
##   6. Simd_f64x2_min selects minimum.
import * from qspec

def main(): Int
  describe("SIMD min/max/abs") do ->
    it("simd_f32x4_min selects minimum") do ->
      assert_output("min ok\n", smm_f32x4_min)
    end
    it("simd_f32x4_max selects maximum") do ->
      assert_output("max ok\n", smm_f32x4_max)
    end
    it("simd_f32x4_abs takes absolute value") do ->
      assert_output("abs ok\n", smm_f32x4_abs)
    end
    it("simd_f64x2_min selects minimum") do ->
      assert_output("min ok\n", smm_f64x2_min)
    end
    it("simd_f64x2_max selects maximum") do ->
      assert_output("max ok\n", smm_f64x2_max)
    end
    it("simd_f64x2_abs takes absolute value") do ->
      assert_output("abs ok\n", smm_f64x2_abs)
    end
    it("simd_i32x4_min selects minimum") do ->
      assert_output("3\n", smm_i32x4_min)
    end
    it("simd_i32x4_max selects maximum") do ->
      assert_output("10\n", smm_i32x4_max)
    end
    it("simd_i32x4_abs takes absolute value") do ->
      assert_output("4\n", smm_i32x4_abs)
    end
  end
  return qspec_main()
end

def smm_f32x4_min(): Void
  a = simd_f32x4_splat(3.0)
  b = simd_f32x4_splat(5.0)
  r = simd_f32x4_min(a, b)
  val = simd_f32x4_extract(r, 0)
  if val == 3.0
    puts("min ok")
  else
    puts("min fail")
  end
end
def smm_f32x4_max(): Void
  a = simd_f32x4_splat(3.0)
  b = simd_f32x4_splat(5.0)
  r = simd_f32x4_max(a, b)
  val = simd_f32x4_extract(r, 0)
  if val == 5.0
    puts("max ok")
  else
    puts("max fail")
  end
end
def smm_f32x4_abs(): Void
  a = simd_f32x4_splat(-4.0)
  r = simd_f32x4_abs(a)
  val = simd_f32x4_extract(r, 0)
  if val == 4.0
    puts("abs ok")
  else
    puts("abs fail")
  end
end
def smm_f64x2_min(): Void
  a = simd_f64x2_splat(7.0)
  b = simd_f64x2_splat(2.0)
  r = simd_f64x2_min(a, b)
  val = simd_f64x2_extract(r, 0)
  if val == 2.0
    puts("min ok")
  else
    puts("min fail")
  end
end
def smm_f64x2_max(): Void
  a = simd_f64x2_splat(7.0)
  b = simd_f64x2_splat(2.0)
  r = simd_f64x2_max(a, b)
  val = simd_f64x2_extract(r, 0)
  if val == 7.0
    puts("max ok")
  else
    puts("max fail")
  end
end
def smm_f64x2_abs(): Void
  a = simd_f64x2_splat(-9.5)
  r = simd_f64x2_abs(a)
  val = simd_f64x2_extract(r, 0)
  if val == 9.5
    puts("abs ok")
  else
    puts("abs fail")
  end
end
def smm_i32x4_min(): Void
  a = simd_i32x4_splat(10)
  b = simd_i32x4_splat(3)
  r = simd_i32x4_min(a, b)
  print_int(simd_i32x4_extract(r, 0))
end
def smm_i32x4_max(): Void
  a = simd_i32x4_splat(10)
  b = simd_i32x4_splat(3)
  r = simd_i32x4_max(a, b)
  print_int(simd_i32x4_extract(r, 0))
end
def smm_i32x4_abs(): Void
  a = simd_i32x4_splat(-4)
  r = simd_i32x4_abs(a)
  print_int(simd_i32x4_extract(r, 0))
end
