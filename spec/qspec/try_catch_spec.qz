## Try-Catch Expressions Tests
##
## Contract:
##   1. Ok path: `try expr catch Err(e) fallback` unwraps Ok value.
##   2. Err path: executes catch handler on Err.
##   3. Err binding: `Err(e)` pattern binds error value.
##   4. Wildcard: `catch _` ignores error variant.
##   5. Block form: multi-line try...catch...end.
##   6. Nested: sequential try-catch expressions.
##   7. Chained: multiple try-catch in sequence.
##   8. Fallback computation: catch handler performs arithmetic.

import * from qspec

enum TcResult
  Ok(value: Int)
  Err(error: Int)
end

## Helper functions for try-catch tests

def tc_get_ok(): TcResult
  return TcResult::Ok(42)
end

def tc_get_err(): TcResult
  return TcResult::Err(99)
end

def tc_get_err123(): TcResult
  return TcResult::Err(123)
end

def tc_get_err999(): TcResult
  return TcResult::Err(999)
end

def tc_divide(a: Int, b: Int): TcResult
  if b == 0
    return TcResult::Err(0)
  end
  return TcResult::Ok(a / b)
end

def tc_outer(): TcResult
  return TcResult::Ok(10)
end

def tc_inner(): TcResult
  return TcResult::Err(5)
end

## Output helpers

def tc_print_unwrap_ok(): Void
  x = try tc_get_ok() catch Err(e) 0
  print_int(x)
end

def tc_print_catch_err(): Void
  x = try tc_get_err() catch Err(e) 0
  print_int(x)
end

def tc_print_bind_err(): Void
  x = try tc_get_err123() catch Err(e) e
  print_int(x)
end

def tc_print_wildcard(): Void
  x = try tc_get_err999() catch _ 0
  print_int(x)
end

def tc_print_block_ok(): Void
  x = try
    tc_divide(10, 2)
  catch Err(_)
    0
  end
  print_int(x)
end

def tc_print_block_err(): Void
  x = try
    tc_divide(10, 0)
  catch Err(_)
    0
  end
  print_int(x)
end

def tc_print_nested(): Void
  x = try tc_outer() catch Err(_) 0
  y = try tc_inner() catch Err(e) e
  print_int(x + y)
end

def tc_print_chained(): Void
  a = try tc_divide(100, 5) catch Err(_) 0
  b = try tc_divide(a, 2) catch Err(_) 0
  print_int(b)
end

def tc_print_fallback_expr(): Void
  x = try tc_get_err() catch Err(e) e * 2 + 1
  print_int(x)
end

def main(): Int
  describe("basic try-catch") do ->
    it("unwraps Ok value from Result") do ->
      assert_output("42\n", tc_print_unwrap_ok)
    end

    it("executes handler on Err value") do ->
      assert_output("0\n", tc_print_catch_err)
    end
  end

  describe("pattern binding") do ->
    it("binds error value with Err(e) pattern") do ->
      assert_output("123\n", tc_print_bind_err)
    end

    it("uses wildcard pattern to ignore error") do ->
      assert_output("0\n", tc_print_wildcard)
    end
  end

  describe("block form") do ->
    it("supports multi-line try-catch with end") do ->
      assert_output("5\n", tc_print_block_ok)
    end

    it("handles error in block form") do ->
      assert_output("0\n", tc_print_block_err)
    end
  end

  describe("nested try-catch") do ->
    it("supports nested try-catch expressions") do ->
      assert_output("15\n", tc_print_nested)
    end
  end

  describe("advanced try-catch") do ->
    it("chained try-catch feeds Ok into next try") do ->
      assert_output("10\n", tc_print_chained)
    end

    it("catch handler performs arithmetic on error") do ->
      assert_output("199\n", tc_print_fallback_expr)
    end
  end

  return qspec_main()
end
