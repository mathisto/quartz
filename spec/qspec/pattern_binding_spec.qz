## Pattern Binding in Conditionals — LF2.2: `if PATTERN = EXPR`
##
## Contract:
##   1. Basic binding: `if Some(v) = expr` binds payload on match.
##   2. Else path: non-matching pattern takes else branch.
##   3. No-else: continues after if when pattern doesn't match.
##   4. Qualified pattern: fully qualified enum variant works.
##   5. No-payload: `if None = expr` matches variant without payload.
##   6. Elsif chain: `elsif PATTERN = EXPR` chains pattern tests.
##   7. Expression position: `if PATTERN = EXPR then ... else ... end`.
##   8. Nested: pattern binding inside another pattern binding.
##   9. User-defined enums: PBResult, PBMulti work with binding.
##  10. Wildcard: `if _ = expr` always matches.
##  11. Early return: return from pattern binding body.
##  12. Loop: pattern binding inside while loop.
##  13. Shadowing: inner binding shadows outer variable.
##  14. Multi-payload: `Pair(a, b) =` binds multiple fields.
##  15. Unqualified: `Some(v)` without `PBOption::` prefix.

import * from qspec

enum PBOption
  Some(value: Int)
  None
end

enum PBResult
  Ok(value: Int)
  Err(code: Int)
end

enum PBMulti
  Pair(first: Int, second: Int)
  Single(value: Int)
  Empty
end

def pb_make_some(v: Int): PBOption = PBOption::Some(v)
def pb_make_none(): PBOption = PBOption::None

def pb_make_ok(v: Int): PBResult = PBResult::Ok(v)
def pb_make_err(v: Int): PBResult = PBResult::Err(v)

def pb_make_pair(a: Int, b: Int): PBMulti = PBMulti::Pair(a, b)
def pb_make_single(v: Int): PBMulti = PBMulti::Single(v)
def pb_make_empty(): PBMulti = PBMulti::Empty

## Test helpers — named functions for assert_output

def pb_test_basic(): Void
  if PBOption::Some(v) = pb_make_some(42)
    print_int(v)
  end
end

def pb_test_none_path(): Void
  if PBOption::Some(v) = pb_make_none()
    print_int(v)
  else
    puts("none")
  end
end

def pb_test_no_else(): Void
  if PBOption::Some(v) = pb_make_some(7)
    print_int(v)
  end
  puts("after")
end

def pb_test_qualified(): Void
  if PBOption::Some(v) = pb_make_some(5)
    print_int(v)
  end
end

def pb_test_no_payload(): Void
  if PBOption::None = pb_make_none()
    puts("yes")
  end
end

def pb_test_elsif_pat_pat(): Void
  if PBOption::Some(x) = pb_make_none()
    print_int(x)
  elsif PBOption::Some(y) = pb_make_some(3)
    print_int(y)
  else
    puts("neither")
  end
end

def pb_test_elsif_pat_expr(): Void
  if PBOption::Some(v) = pb_make_none()
    print_int(v)
  elsif 1 == 1
    puts("fallback")
  end
end

def pb_test_expr_position(): Int
  var r = if PBOption::Some(v) = pb_make_some(10) then v else 0 end
  return r
end

def pb_test_nested_inner(x: Int): PBOption
  return pb_make_some(x * 2)
end

def pb_test_nested(): Void
  if PBOption::Some(a) = pb_make_some(5)
    if PBOption::Some(b) = pb_test_nested_inner(a)
      print_int(b)
    end
  end
end

def pb_test_result(): Void
  if PBResult::Ok(val) = pb_make_ok(99)
    print_int(val)
  end
end

def pb_test_user_enum(): Void
  if PBMulti::Single(x) = pb_make_single(7)
    print_int(x)
  end
end

def pb_test_wildcard(): Void
  if _ = pb_make_some(1)
    puts("always")
  end
end

def pb_test_return(): Int
  if PBOption::Some(v) = pb_make_some(55)
    return v
  end
  return 0
end

def pb_test_loop(): Void
  var i = 0
  while i < 3
    if PBOption::Some(v) = pb_make_some(i * 10)
      print_int(v)
    end
    i += 1
  end
end

def pb_test_shadowing(): Void
  var v = 100
  if PBOption::Some(v) = pb_make_some(42)
    print_int(v)
  end
  print_int(v)
end

def pb_test_multi_payload(): Void
  if PBMulti::Pair(a, b) = pb_make_pair(3, 7)
    print_int(a)
    print_int(b)
  end
end

def pb_test_no_match_expr(): Int
  var r = if PBOption::Some(v) = pb_make_none() then v else 99 end
  return r
end

def pb_test_three_way(): Void
  if PBOption::Some(x) = pb_make_none()
    print_int(x)
  elsif PBOption::Some(y) = pb_make_some(77)
    print_int(y)
  else
    puts("none")
  end
end

def pb_test_unqualified(): Void
  if Some(v) = pb_make_some(33)
    print_int(v)
  end
end

def main(): Int
  describe("pattern binding basic") do ->
    it("binds payload from matching enum") do ->
      assert_output("42\n", pb_test_basic)
    end

    it("takes else path on non-match") do ->
      assert_output("none\n", pb_test_none_path)
    end

    it("continues after if when no else") do ->
      assert_output("7\nafter\n", pb_test_no_else)
    end

    it("works with qualified pattern") do ->
      assert_output("5\n", pb_test_qualified)
    end

    it("matches no-payload variant") do ->
      assert_output("yes\n", pb_test_no_payload)
    end
  end

  describe("pattern binding elsif") do ->
    it("chains pattern + pattern") do ->
      assert_output("3\n", pb_test_elsif_pat_pat)
    end

    it("chains pattern + expression") do ->
      assert_output("fallback\n", pb_test_elsif_pat_expr)
    end

    it("three-way: pattern + pattern + else") do ->
      assert_output("77\n", pb_test_three_way)
    end
  end

  describe("pattern binding expression position") do ->
    it("returns value from matching arm") do ->
      assert_eq(pb_test_expr_position(), 10)
    end

    it("returns else value on non-match") do ->
      assert_eq(pb_test_no_match_expr(), 99)
    end
  end

  describe("pattern binding advanced") do ->
    it("works with nested pattern bindings") do ->
      assert_output("10\n", pb_test_nested)
    end

    it("works with user-defined enum") do ->
      assert_output("99\n", pb_test_result)
    end

    it("works with different enum variant") do ->
      assert_output("7\n", pb_test_user_enum)
    end

    it("wildcard always matches") do ->
      assert_output("always\n", pb_test_wildcard)
    end

    it("supports early return from body") do ->
      assert_eq(pb_test_return(), 55)
    end

    it("works inside loops") do ->
      assert_output("0\n10\n20\n", pb_test_loop)
    end

    it("shadows outer variable in body") do ->
      assert_output("42\n42\n", pb_test_shadowing)
    end

    it("binds multi-payload enum") do ->
      assert_output("3\n7\n", pb_test_multi_payload)
    end

    it("works with unqualified variant name") do ->
      assert_output("33\n", pb_test_unqualified)
    end
  end

  return qspec_main()
end
