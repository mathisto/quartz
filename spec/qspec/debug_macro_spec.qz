## @debug Macro Tests
##
## Contract:
##   1. Stderr output: $debug prints value to stderr.
##   2. Expression eval: $debug evaluates expression before printing.
##   3. Transparent: $debug returns the expression value.
##   4. Edge values: zero, negative, large values.
##   5. Composition: debug value assignable, usable in arithmetic.
##   6. Multiple: sequential $debug calls all execute.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("$debug macro") do ->
    it("prints integer value to stderr") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(42)
  return 0
end
""", "42")
    end

    it("evaluates expression and prints result to stderr") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(10 + 20)
  return 0
end
""", "30")
    end

    it("returns the expression value transparently") do ->
      assert_run_stdout_eq("""
def main(): Int
  x = $debug(42)
  print_int(x)
  return 0
end
""", "42\n")
    end

    it("debug with zero") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(0)
  return 0
end
""", "0")
    end

    it("debug with negative value") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(-7)
  return 0
end
""", "-7")
    end

    it("debug with multiplication expression") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(6 * 7)
  return 0
end
""", "42")
    end

    it("debug with variable reference") do ->
      assert_run_stderr_contains("""
def main(): Int
  var x = 99
  $debug(x)
  return 0
end
""", "99")
    end

    it("debug value can be assigned") do ->
      assert_run_exits("""
def main(): Int
  var x = $debug(5)
  return x
end
""", 5)
    end

    it("debug value can be used in arithmetic") do ->
      assert_run_exits("""
def main(): Int
  var x = $debug(3) + $debug(4)
  return x
end
""", 7)
    end

    it("multiple debug calls in sequence") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(1)
  $debug(2)
  $debug(3)
  return 0
end
""", "1")
    end

    it("debug with large value") do ->
      assert_run_stderr_contains("""
def main(): Int
  $debug(1000000)
  return 0
end
""", "1000000")
    end

    it("debug compiles in function body") do ->
      assert_compile_succeeds("""
def helper(): Int
  return $debug(42)
end
def main(): Int
  return helper()
end
""")
    end

    it("debug in if condition compiles") do ->
      assert_compile_succeeds("""
def main(): Int
  if $debug(1) > 0
    return 1
  end
  return 0
end
""")
    end

  end

  return qspec_main()
end

