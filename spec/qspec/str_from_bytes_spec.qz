## str_from_bytes intrinsic — conformance tests.
##
## str_from_bytes(Vec<Int>) -> String builds a byte-exact String from a
## vector of byte values: the inverse of str_bytes. Unlike str_from_char /
## str_from_codepoint (which UTF-8-encode a codepoint), str_from_bytes emits
## one raw byte per element — values are truncated to their low 8 bits and
## NUL bytes are preserved (the result is length-prefixed, not C-terminated).
## This is the primitive binary writers need: build a Vec<Int> of bytes, then
## write_file the str_from_bytes result.

import * from qspec

def main(): Int
  describe("str_from_bytes") do ->
    it("round-trips through str_bytes") do ->
      v = vec_new<Int>()
      v.push(1)
      v.push(127)
      v.push(255)
      v.push(0)
      v.push(64)
      rt = str_bytes(str_from_bytes(v))
      assert_eq(rt.size, 5)
      assert_eq(rt[0], 1)
      assert_eq(rt[1], 127)
      assert_eq(rt[2], 255)
      assert_eq(rt[3], 0)
      assert_eq(rt[4], 64)
    end

    it("length counts every byte, including embedded NUL") do ->
      v = vec_new<Int>()
      v.push(72)
      v.push(0)
      v.push(73)
      s = str_from_bytes(v)
      assert_eq(str_byte_len(s), 3)
      assert_eq(str_byte_at(s, 0), 72)
      assert_eq(str_byte_at(s, 1), 0)
      assert_eq(str_byte_at(s, 2), 73)
    end

    it("truncates each element to its low 8 bits") do ->
      v = vec_new<Int>()
      v.push(256 + 65)   # -> 65
      v.push(512 + 1)    # -> 1
      v.push(0 - 1)      # -> 255
      s = str_from_bytes(v)
      assert_eq(str_byte_at(s, 0), 65)
      assert_eq(str_byte_at(s, 1), 1)
      assert_eq(str_byte_at(s, 2), 255)
    end

    it("an empty vector yields an empty string") do ->
      v = vec_new<Int>()
      assert_eq(str_byte_len(str_from_bytes(v)), 0)
    end

    it("survives a write_file / read_file disk round-trip") do ->
      v = vec_new<Int>()
      var i = 0
      while i < 256
        v.push(i)
        i += 1
      end
      write_file("/tmp/qz_str_from_bytes_spec.bin", str_from_bytes(v))
      back = str_bytes(read_file("/tmp/qz_str_from_bytes_spec.bin"))
      assert_eq(back.size, 256)
      var ok = 1
      var j = 0
      while j < 256
        if back[j] != j
          ok = 0
        end
        j += 1
      end
      assert_eq(ok, 1)
    end

    it("pairs with str_bytes for an ASCII string identity") do ->
      original = "hello, hyperdrive"
      rebuilt = str_from_bytes(str_bytes(original))
      assert_eq_str(rebuilt, original)
    end
  end

  return qspec_main()
end
