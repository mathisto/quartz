##! Regression tests for UNKNOWN-VARIANT-MATCH.
##!
##! Before the fix (Apr 2026), match arms referencing a variant that
##! didn't exist on the subject's enum silently type-checked, then emitted
##! invalid LLVM IR (e.g. a `load` from an alloca named after the would-be
##! variant). llc rejected the IR but there was no compiler-visible error,
##! and the user got a confusing downstream failure instead of QZ0210.
##!
##! The fix validates variant patterns in two places:
##!   1. NODE_ENUM_ACCESS — `Foo(v) =>` and `MyEnum::Foo(v) =>`
##!   2. NODE_IDENT — PascalCase bare idents in payloadless variant position
##!
##! These tests don't directly assert on the compiler error (we'd need a
##! compile-and-capture harness for that — see `error_codes_spec.qz` for
##! the usual pattern). Instead they exercise the positive cases to make
##! sure legitimate patterns still compile.

import * from qspec

enum Color
  Red
  Green
  Blue
end

enum Maybe<T>
  Just(value: T)
  Nothing
end

def color_tag(c: Color): Int
  match c
    Red => return 1
    Green => return 2
    Blue => return 3
  end
end

def maybe_or(m: Maybe<Int>, fallback: Int): Int
  match m
    Just(v) => return v
    Nothing => return fallback
  end
end

def qualified_color_tag(c: Color): Int
  match c
    Color::Red => return 10
    Color::Green => return 20
    Color::Blue => return 30
  end
end

def main(): Int
  describe("match arm variant validation") do ->
    it("accepts unqualified variants of the subject enum") do ->
      assert_eq(color_tag(Color::Red), 1)
      assert_eq(color_tag(Color::Green), 2)
      assert_eq(color_tag(Color::Blue), 3)
    end

    it("accepts unqualified variants with payloads") do ->
      assert_eq(maybe_or(Maybe::Just(42), 0), 42)
      assert_eq(maybe_or(Maybe::Nothing, 99), 99)
    end

    it("accepts fully qualified variant patterns") do ->
      assert_eq(qualified_color_tag(Color::Red), 10)
      assert_eq(qualified_color_tag(Color::Green), 20)
      assert_eq(qualified_color_tag(Color::Blue), 30)
    end
  end

  return qspec_main()
end
