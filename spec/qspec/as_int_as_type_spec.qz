## As Int As Type Tests
##
## Contract:
##   1. Identity int: `as_int_generic(42)` returns 42.
##   2. Identity type: `as_type(99)` returns 99.
##   3. Struct pointer: `as_int_generic(struct)` returns non-zero.
##   4. Restore: `as_type<T>(as_int(struct))` restores struct.
##   5. Vec storage: store/restore struct through Vec<Int>.
##   6. Round-trip: `as_type<T>(as_int(p)).x + .y` preserves.
##   7. Zero: `as_int_generic(0)` returns 0.
##   8. Negative: `as_int_generic(-1)` returns -1.
## NOTE (item 11d, F4 value-default flip): every struct here is marked `@repr(C)`
## to pin it to REFERENCE layout. `as_int`/`as_type` are pointer-identity
## reinterprets, valid ONLY for reference-layout structs; under the value-default
## flip a plain struct becomes value-layout and `as_int(p)` (correctly) raises
## QZ0221. This spec's purpose is `as_int`/`as_type<T>` round-tripping of struct
## pointers — the layout is incidental — so pinning keeps coverage at both flip
## states. Sibling of item 45 (as_type_module_qualified). Do NOT remove `@repr(C)`.
import * from qspec
import * from qspec/subprocess

@repr(C)
struct ATPoint
  x: Int
  y: Int
end

def main(): Int
  describe("as_int_generic / as_type") do ->
    it("converts Int to Int (identity)") do ->
      x = 42
      i = as_int_generic(x)
      assert_eq(i, 42)
    end
    it("as_type returns identity value") do ->
      x = 99
      y = as_type(x)
      assert_eq(y, 99)
    end
    it("as_int_generic stores struct pointer") do ->
      var p = ATPoint { x: 10, y: 20 }
      i = as_int_generic(p)
      assert_ne(i, 0)
    end
    it("restores struct from Int with as_type<T>") do ->
      assert_run_exits(at_restore_src(), 10)
    end
    it("works with Vec storage pattern") do ->
      assert_run_exits(at_vec_store_src(), 20)
    end
    it("preserves struct through round-trip") do ->
      assert_run_exits(at_roundtrip_src(), 30)
    end
    it("as_int_generic(0) returns 0") do ->
      assert_eq(as_int_generic(0), 0)
    end
    it("as_int_generic preserves negative values") do ->
      assert_eq(as_int_generic(-1), -1)
    end
  end
  return qspec_main()
end

def at_restore_src(): String = """
  @repr(C)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 10, y: 20 }
    var i = as_int(p)
    var restored = as_type<Point>(i)
    return restored.x
  end
  """

def at_vec_store_src(): String = """
  @repr(C)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var v = vec_new()
    var p = Point { x: 10, y: 20 }
    vec_push(v, as_int(p))
    var raw = vec_get(v, 0)
    var restored = as_type<Point>(raw)
    return restored.y
  end
  """

def at_roundtrip_src(): String = """
  @repr(C)
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var p = Point { x: 10, y: 20 }
    var i = as_int(p)
    var q = as_type<Point>(i)
    return q.x + q.y
  end
  """
