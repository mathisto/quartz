## Regression spec for bare `import x` + cross-module enum variant access.
##
## Pre-fix bug: `import x` (no `as` clause) registered the file's
## functions and types under the file-basename namespace via the
## resolver, so `x::Type` and `x::function()` resolved fine — but the
## parser's `module::Enum::Variant` disambiguator at parser.qz:1935
## only fired for names registered in `ps.import_aliases`. Bare imports
## never pushed to that vec, so `x::EnumType::Variant` mangled into a
## single ident `x$EnumType$Variant` (the lowercase-LHS module-path
## branch) instead of producing NODE_ENUM_ACCESS. The typechecker then
## reported "Undefined variable: x$EnumType$Variant".
##
## The asymmetry was especially confusing because match arms (which
## resolve enum-name from the scrutinee, not via the parser's
## disambiguator) worked fine, while the same `x::EnumType::Variant`
## text in expression position failed.
##
## Workaround was `import x as x` (explicit self-alias), which DID push
## "x" to import_aliases. This spec proves bare imports now work too.
##
## Sister spec: `import_alias_enum_variant_spec.qz` covers the
## explicit-alias path. The two should stay in lockstep.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("bare-import enum variant access") do ->

    it("constructs a no-payload variant via bare import") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("model.qz"))
      var model_src = """
enum AppMsg
  Tick
  Quit
end
"""
      vec_push(files, as_int(model_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import model
def main(): Int
  var msg: model::AppMsg = model::AppMsg::Tick
  return 0
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 0)
    end

    it("constructs a payload variant and matches it") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("model.qz"))
      var model_src = """
enum Foo
  A
  B
  C(value: Int)
end
"""
      vec_push(files, as_int(model_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import model
def main(): Int
  var f: model::Foo = model::Foo::C(42)
  match f
    A => return 100
    B => return 101
    C(v) => return v
  end
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("works alongside type and function access via the same prefix") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("model.qz"))
      var model_src = """
enum Msg
  Step
  Halt
end
struct State
  ticks: Int
end
def state_initial(): State = State { ticks: 0 }
"""
      vec_push(files, as_int(model_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import model
def main(): Int
  var s: model::State = model::state_initial()
  var m: model::Msg = model::Msg::Step
  var n = match m
    Step => s.ticks + 7
    Halt => 0
  end
  return n
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 7)
    end

    it("does not regress lowercase module-prefixed function calls") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("hp.qz"))
      var hp_src = """
def helper(): Int = 99
"""
      vec_push(files, as_int(hp_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import hp
def main(): Int = hp::helper()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 99)
    end

    it("does not regress UPPERCASE function calls via bare import") do ->
      ## The tricky case: `import constants; constants::MAGIC_NUMBER()`
      ## has uppercase RHS that would otherwise look like an enum
      ## variant. The implicit-alias drop produces a bare ident
      ## "MAGIC_NUMBER" which must still resolve via the registry's
      ## suffix-fallback (matches `constants$MAGIC_NUMBER`).
      var files: Vec = vec_new()
      vec_push(files, as_int("constants.qz"))
      var constants_src = """
def MAGIC_NUMBER(): Int = 137
"""
      vec_push(files, as_int(constants_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import constants
def main(): Int = constants::MAGIC_NUMBER()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 137)
    end

    it("supports hierarchical bare imports (path/basename)") do ->
      ## `import sub/inner` should register "inner" (the last segment)
      ## as the implicit alias, matching the resolver's short-name
      ## prefix calculation.
      var files: Vec = vec_new()
      vec_push(files, as_int("sub/inner.qz"))
      var inner_src = """
enum Tag
  One
  Two
end
"""
      vec_push(files, as_int(inner_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import sub/inner
def main(): Int
  var t: inner::Tag = inner::Tag::Two
  match t
    One => return 1
    Two => return 2
  end
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 2)
    end

  end
  return qspec_main()
end
