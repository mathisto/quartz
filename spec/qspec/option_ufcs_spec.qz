## Option/Result UFCS Tests
##
## Contract: Option and Result support dot-syntax for all operations.
## opt.unwrap(), opt.map(f), res.is_ok(), res.map(f), etc.

import * from qspec

def double_it(x: Int): Int = x * 2
def wrap_some(x: Int): Option<Int> = Option::Some(x * 10)
def wrap_ok(x: Int): Result<Int, Int> = Result::Ok(x * 10)

def main(): Int
  describe("Option UFCS") do ->
    it("opt.unwrap() extracts Some value") do ->
      opt = Option::Some(42)
      assert_eq(opt.unwrap(), 42)
    end

    it("opt.unwrap_or() returns value for Some") do ->
      opt = Option::Some(42)
      assert_eq(opt.unwrap_or(0), 42)
    end

    it("opt.unwrap_or() returns fallback for None") do ->
      opt = option_none()
      assert_eq(opt.unwrap_or(99), 99)
    end

    it("opt.is_some() returns true for Some") do ->
      opt = Option::Some(1)
      assert_eq(opt.is_some(), true)
    end

    it("opt.is_some() returns false for None") do ->
      opt = option_none()
      assert_eq(opt.is_some(), false)
    end

    it("opt.is_none() returns true for None") do ->
      opt = option_none()
      assert_eq(opt.is_none(), true)
    end

    it("opt.is_none() returns false for Some") do ->
      opt = Option::Some(1)
      assert_eq(opt.is_none(), false)
    end

    it("opt.map(f) transforms Some value") do ->
      opt = Option::Some(21)
      result = opt.map(double_it)
      assert_eq(result.unwrap(), 42)
    end

    it("opt.map(f) preserves None") do ->
      opt = option_none()
      result = opt.map(double_it)
      assert_eq(result.is_none(), true)
    end

    it("opt.and_then(f) chains Some computations") do ->
      opt = Option::Some(5)
      result = opt.and_then(wrap_some)
      assert_eq(result.unwrap(), 50)
    end

    it("opt.and_then(f) short-circuits None") do ->
      opt = option_none()
      result = opt.and_then(wrap_some)
      assert_eq(result.is_none(), true)
    end

    it("chaining: opt.map(f).unwrap_or(default)") do ->
      opt = Option::Some(5)
      assert_eq(opt.map(double_it).unwrap_or(0), 10)
    end
  end

  describe("Result UFCS") do ->
    it("res.unwrap() extracts Ok value") do ->
      res = Result::Ok(42)
      assert_eq(res.unwrap(), 42)
    end

    it("res.unwrap_err() extracts Err value") do ->
      res = Result::Err(99)
      assert_eq(res.unwrap_err(), 99)
    end

    it("res.unwrap_or() returns value for Ok") do ->
      res = Result::Ok(42)
      assert_eq(res.unwrap_or(0), 42)
    end

    it("res.unwrap_or() returns fallback for Err") do ->
      res = Result::Err(99)
      assert_eq(res.unwrap_or(0), 0)
    end

    it("res.is_ok() returns true for Ok") do ->
      res = Result::Ok(1)
      assert_eq(res.is_ok(), true)
    end

    it("res.is_ok() returns false for Err") do ->
      res = Result::Err(1)
      assert_eq(res.is_ok(), false)
    end

    it("res.is_err() returns true for Err") do ->
      res = Result::Err(1)
      assert_eq(res.is_err(), true)
    end

    it("res.is_err() returns false for Ok") do ->
      res = Result::Ok(1)
      assert_eq(res.is_err(), false)
    end

    it("res.map(f) transforms Ok value") do ->
      res = Result::Ok(21)
      mapped = res.map(double_it)
      assert_eq(mapped.unwrap(), 42)
    end

    it("res.map(f) preserves Err") do ->
      res = Result::Err(99)
      mapped = res.map(double_it)
      assert_eq(mapped.is_err(), true)
    end

    it("res.and_then(f) chains Ok computations") do ->
      res = Result::Ok(5)
      chained = res.and_then(wrap_ok)
      assert_eq(chained.unwrap(), 50)
    end

    it("res.and_then(f) short-circuits Err") do ->
      res = Result::Err(99)
      chained = res.and_then(wrap_ok)
      assert_eq(chained.is_err(), true)
    end

    it("chaining: res.map(f).unwrap_or(default)") do ->
      res = Result::Ok(5)
      assert_eq(res.map(double_it).unwrap_or(0), 10)
    end
  end

  return qspec_main()
end
