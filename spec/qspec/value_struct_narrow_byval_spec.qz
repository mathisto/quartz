## B.10 narrow-byval fold-in — by-value return ABI for @value structs with
## narrow-integer fields (U8/I8/U16/I16/U32/I32).
##
## Before this slice, only all-wide (i64-slot) @value structs returned by value
## (`ret {i64 x N}`); any narrow field forced a heap-boxed pointer return
## (`__qz_alloc` per return). Now narrow fields ride the same aggregate ABI: the
## callee loads each field through the typed `%struct.Name` layout (zext/sext to
## the widened i64 slot) and the caller reconstructs (trunc back to iN).
##
## What these tests prove:
##   narrow.a — narrow fields BEFORE a wide field round-trip with correct byte
##              offsets (the wide field is NOT at flat index*8 once narrow fields
##              precede it — the typed-GEP path is what gets this right).
##   narrow.b — signed narrow fields sext correctly, including negatives.
##   narrow.c — an all-narrow struct (no wide field) round-trips.
##   narrow.d — a two-level return chain (callee result reconstructed, then
##              returned again by value) round-trips through both ABI boundaries.

import * from qspec
import * from qspec/subprocess

# narrow.a — unsigned narrow fields + a trailing wide Int; offset-shift case.
var _NARROW_MIXED: String = """@value
struct Pixel
  r: U8
  g: U8
  b: U8
  a: Int
end

def make_pix(rr: U8, gg: U8, bb: U8, aa: Int): Pixel
  return Pixel { r: rr, g: gg, b: bb, a: aa }
end

def main(): Int
  p = make_pix(10, 20, 30, 9999)
  puts(str_from_int(p.r) + \",\" + str_from_int(p.g) + \",\" + str_from_int(p.b) + \",\" + str_from_int(p.a))
  return 0
end
"""

# narrow.b — signed narrow fields, negatives exercise sext on the return load.
var _NARROW_SIGNED: String = """@value
struct Sig
  a: I8
  b: I16
  c: I32
end

def mk(): Sig
  return Sig { a: -5, b: -300, c: -100000 }
end

def main(): Int
  s = mk()
  puts(str_from_int(s.a) + \",\" + str_from_int(s.b) + \",\" + str_from_int(s.c))
  return 0
end
"""

# narrow.c — all-narrow struct, no wide field.
var _NARROW_ALL: String = """@value
struct Rgb
  r: U8
  g: U8
  b: U8
end

def mk(rr: U8, gg: U8, bb: U8): Rgb
  return Rgb { r: rr, g: gg, b: bb }
end

def main(): Int
  c = mk(200, 100, 50)
  puts(str_from_int(c.r) + \",\" + str_from_int(c.g) + \",\" + str_from_int(c.b))
  return 0
end
"""

# narrow.d — two-level return: forward() reconstructs make_pix()'s aggregate
# then returns it by value again (TERM_RETURN reads the reconstruct buffer).
var _NARROW_CHAIN: String = """@value
struct Pixel
  r: U8
  g: U8
  b: U8
  a: Int
end

def make_pix(rr: U8, gg: U8, bb: U8, aa: Int): Pixel
  return Pixel { r: rr, g: gg, b: bb, a: aa }
end

def forward(): Pixel
  return make_pix(3, 6, 9, 12345)
end

def main(): Int
  p = forward()
  puts(str_from_int(p.r) + \",\" + str_from_int(p.g) + \",\" + str_from_int(p.b) + \",\" + str_from_int(p.a))
  return 0
end
"""

def main(): Int
  describe("B.10 narrow-byval — @value structs with narrow-integer fields return by value") do ->
    it("unsigned narrow fields before a wide Int round-trip at correct offsets") do ->
      assert_run_stdout_eq(_NARROW_MIXED, "10,20,30,9999\n")
    end

    it("signed narrow fields sext correctly, including negatives") do ->
      assert_run_stdout_eq(_NARROW_SIGNED, "-5,-300,-100000\n")
    end

    it("all-narrow struct (no wide field) round-trips") do ->
      assert_run_stdout_eq(_NARROW_ALL, "200,100,50\n")
    end

    it("two-level return chain round-trips through both ABI boundaries") do ->
      assert_run_stdout_eq(_NARROW_CHAIN, "3,6,9,12345\n")
    end
  end
  return qspec_main()
end
