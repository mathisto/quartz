## Generic Ptype Edge Cases Tests
##
## Contract:
##   1. Bare vec: bare Vec matches `Vec<T>` in function params.
##   2. Return vec: function returning `Vec<Int>`.
##   3. Box<T>: generic struct `Box<T>` with field access.
##   4. Pair<T,U>: generic struct `Pair<T, U>` with two params.
##   5. Nested: `Map<String, Vec<Int>>` nested containers.
##   6. Option: `Option<Int>` match with Some/None.
##   7. Nested vec: `Vec<Vec<Int>>` nested push/get.
##   8. Mutate: generic struct field mutation.
##   9. Size: Vec<Int> `.size` returns correct count.
import * from qspec

def main(): Int
  describe("generic ptype edge cases") do ->
    it("Vec<Vec<Int>> nested push/get") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var inner: Vec<Int> = vec_new()
      inner.push(42)
      outer.push(inner)
      row = outer[0]
      assert_eq(row[0], 42)
    end
    it("Map<String, Vec<Int>> nested containers") do ->
      var m: Map<String, Vec<Int>> = map_new()
      var vt: Vec<Int> = vec_new()
      vt.push(99)
      m.set("items", vt)
      match m.get("items")
        Some(items) => assert_eq(items[0], 99)
        _ => assert_eq(0, 1)
      end
    end
    it("Option<Int> match with Some/None") do ->
      a = gpe_unwrap_or(Option::Some(42), 0)
      b = gpe_unwrap_or(Option::None, 99)
      assert_eq(a + b, 141)
    end
    it("bare Vec matches Vec<T> in function params") do ->
      vt = vec_new()
      vt.push(1)
      vt.push(2)
      assert_eq(gpe_count(vt), 2)
    end
    it("function returning Vec<Int>") do ->
      vt = gpe_make_vec()
      assert_eq(vt[0], 10)
    end
    it("generic struct Box<T> with field access") do ->
      var b = GPEBox<Int> { value: 77 }
      assert_eq(b.value, 77)
    end
    it("generic struct Pair<T, U> with two params") do ->
      var p = GPEPair<Int, Int> { first: 3, second: 4 }
      assert_eq(p.first + p.second, 7)
    end
    it("generic struct field mutation") do ->
      var b = GPEBox<Int> { value: 10 }
      b.value = 42
      assert_eq(b.value, 42)
    end
    it("Vec<Int> size returns correct count") do ->
      var v = gpe_make_vec()
      assert_eq(v.size, 1)
    end
  end
  return qspec_main()
end

struct GPEBox<T>
  value: T
end

struct GPEPair<T, U>
  first: T
  second: U
end

def gpe_unwrap_or(opt: Int, fallback: Int): Int
  return match opt
    Some(v) => v
    None => fallback
    _ => fallback
  end
end
def gpe_count(v: Vec<Int>): Int = v.size
def gpe_make_vec(): Vec<Int>
  var vt = vec_new()
  vt.push(10)
  return vt
end
