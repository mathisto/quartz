## Binary DSL — Sub-phase 1.4 STEP 3: `as` operator bitcast for packed structs.
##
## `moder as u32`    → packed struct to backing integer  (direction 0)
## `raw as GpioModer` → backing integer to packed struct  (direction 1)
##
## Both sides of the cast lower to MIR_PACKED_BITCAST — at runtime the
## value is already a 64-bit integer, so the bitcast is a no-op for
## data, but the typed surface lets later passes reason about register
## layouts.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — `as` operator (STEP 3)") do ->

    it("packed struct → u32 packs fields into backing integer") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 10, w: 3 }
          var raw = f as u8
          # MSB-first: v=10=0b1010 in bits 7..4, w=3=0b0011 in bits 3..0
          # → 0b10100011 = 163
          return raw
        end
        """, 163)
    end

    it("u8 → packed struct distributes bits into fields") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var raw = 163  # 0b10100011 → v=10, w=3
          var f = raw as Flags
          return f.v + f.w
        end
        """, 13)
    end

    it("packed struct bitcast roundtrip links and runs") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 0b1010, w: 0b0011 }
          var raw = f as u8
          return raw - raw
        end
        """, 0)
    end
  end

  return qspec_main()
end
