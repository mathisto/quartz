## Raw Strings Tests
##
## Contract:
##   1. Raw strings: backslashes preserved literally.
##   2. No interpolation: `#{}` treated as literal characters.
##   3. Empty raw string: zero length.
##   4. Concatenation: raw + regular string composable.

import * from qspec

def rs_backslash_n(): Void
  var s = r"hello\nworld"
  puts("#{s.size}")
end

def rs_backslash_t(): Void
  var s = r"hello\tworld"
  puts("#{s.size}")
end

def rs_concat(): Void
  var raw = r"path\to"
  var normal = "/file"
  puts(raw + normal)
end

def main(): Int
  describe("raw string literals") do ->
    it("preserves backslashes") do ->
      assert_output("12\n", rs_backslash_n)
    end

    it("preserves backslash-t") do ->
      assert_output("12\n", rs_backslash_t)
    end

    it("empty raw string") do ->
      var s = r""
      assert_eq(s.size, 0)
    end

    it("no interpolation in raw strings") do ->
      var x = 42
      var s = r"value is #{x}"
      assert_eq(s.size, 13)
    end

    it("concatenation with regular strings") do ->
      assert_output("path\\to/file\n", rs_concat)
    end

    it("preserves double backslash") do ->
      var s = r"a\\b"
      assert_eq(s.size, 4)
    end

    it("raw string equality check") do ->
      var a = r"hello\n"
      var b = r"hello\n"
      assert_eq_str(a, b)
    end

    it("raw string with many special chars") do ->
      var s = r"\t\n\r\0"
      assert_eq(s.size, 8)
    end
  end

  return qspec_main()
end
