import * from qspec
import * from style

# Cache-ro regression: standalone type-name-receiver call without a
# subsequent chain. Tests Phase 2's NODE_IDENT-for-type recognition in
# mir_infer_expr_type isolated from chain inference.
#
# Repro: `Style.new()` — receiver IDENT names a struct type, not a
# variable. `mir_infer_expr_type(NODE_IDENT for "Style")` currently
# returns "" because Style isn't a variable. Path A's UFCS fallback bails;
# str1 stays as bare "new"; mir_lower emits a different call shape than
# the body-TC'd path would have.
#
# Note: this isolates the bare type-name-receiver case from the chain
# case. The chain spec exercises both Phase 1 and Phase 2; this spec
# exercises ONLY Phase 2's type-name recognition.

def main(): Int
  describe("cache-ro type-name receiver") do ->
    it("Style.new() returns a usable Style") do ->
      var s = Style.new()
      var out = s.render_at("x", 0)
      assert_eq_str(out, "x")
    end

    it("Style.error() preset constructor works") do ->
      var s = Style.error()
      var out = s.render_at("err", 0)
      assert_eq_str(out, "err")
    end

    it("Style.muted() preset constructor works") do ->
      var s = Style.muted()
      var out = s.render_at("muted", 0)
      assert_eq_str(out, "muted")
    end
  end
  return qspec_main()
end
