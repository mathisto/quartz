## kind=2 resumable-op classification — F.2 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone F (chunk F.2).
##
## Extends C.7's classifier so effect ops whose default body calls
## `resume(...)` are tagged kind=2 ("operation" / resumable). Runtime
## continuation threading is F.3 scope; this spec asserts the surface
## annotation only, observable via `--dump-effect-decls`.
##
## Classification rule (F.2):
##   kind=0  zero-param op, body absent or does not call `resume`
##   kind=1  has params, body absent or does not call `resume`
##   kind=2  body (retained by parser) contains a call named `resume`,
##           regardless of param count
##
## The walk is a bounded DFS over the op's NODE_FUNCTION body: any
## NODE_CALL whose callee is a NODE_IDENT with name "resume" upgrades
## the op's kind to 2. Conservative — matches resume-named calls inside
## nested blocks, ifs, matches, and lambdas in the body.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect-op kind=2 classification (piezo F.2)") do ->
    it("endless-def body with tail resume classifies as kind=2") do ->
      var src = """
effect Reader
  def ask(): Int = resume(0)
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Reader op=ask kind=2")
        _record_failure(str_concat("Expected kind=2 for ask() body using resume; stderr: ", r.stderr_content))
      end
    end

    it("single-param op with resume in body classifies as kind=2") do ->
      var src = """
effect State
  def put(v: Int): Int = resume(v)
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=State op=put kind=2")
        _record_failure(str_concat("Expected kind=2 for put(v) body using resume; stderr: ", r.stderr_content))
      end
    end

    it("multi-param op with resume in body classifies as kind=2") do ->
      # Renamed from Yield to Yielder; prelude auto-imports std/gen's
      # Yield<T> effect, so the bare `Yield` name now collides.
      var src = """
effect Yielder
  def emit(a: Int, b: Int): Int = resume(a + b)
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Yielder op=emit kind=2")
        _record_failure(str_concat("Expected kind=2 for emit(a,b) body using resume; stderr: ", r.stderr_content))
      end
    end

    it("abstract op (no body) keeps kind=0 for zero-arg") do ->
      var src = """
effect Pure
  def now(): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Pure op=now kind=0")
        _record_failure(str_concat("Expected kind=0 for abstract zero-arg op; stderr: ", r.stderr_content))
      end
    end

    it("abstract op (no body) keeps kind=1 for has-params") do ->
      var src = """
effect Throws
  def throw(msg: String): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Throws op=throw kind=1")
        _record_failure(str_concat("Expected kind=1 for abstract has-params op; stderr: ", r.stderr_content))
      end
    end

    it("body without resume stays kind=1 (constant body)") do ->
      var src = """
effect Const
  def always_seven(x: Int): Int = 7
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Const op=always_seven kind=1")
        _record_failure(str_concat("Expected kind=1 for body without resume; stderr: ", r.stderr_content))
      end
    end

    it("body with resume nested inside if upgrades to kind=3 (P3.0b)") do ->
      # Updated for Phase 3 P3.0b: kind=2 (tail resume / unwind) now
      # matches ONLY the endless-def shape `= resume(expr)`. A resume
      # buried inside an if-branch is non-tail relative to the enclosing
      # function body, so the classifier promotes it to kind=3
      # (continuation-preserving — reserved for P3.0c's $poll state-
      # machine lowering). The F.2 milestone's original kind=2
      # expectation was correct at F.2 time; P3.0b refined the split.
      var src = """
effect Guard
  def check(n: Int): Int
    if n > 0
      return resume(n)
    end
    return 0
  end
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Guard op=check kind=3")
        _record_failure(str_concat("Expected kind=3 for resume nested in if (P3.0b split); stderr: ", r.stderr_content))
      end
    end

    it("mixed-kind ops within one effect classify independently") do ->
      var src = """
effect Mixed
  def pure_value(): Int
  def fn_default(x: Int): Int = x
  def resumable(x: Int): Int = resume(x)
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Mixed op=pure_value kind=0")
        _record_failure("Expected Mixed.pure_value kind=0")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Mixed op=fn_default kind=1")
        _record_failure("Expected Mixed.fn_default kind=1")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Mixed op=resumable kind=2")
        _record_failure("Expected Mixed.resumable kind=2")
      end
    end
  end
  return qspec_main()
end
