## Optimization Flag Tests
##
## Contract:
##   1. Compile error detected for.
##   2. Compiles successfully with -o2.
##   3. Empty program compiles.
##   4. For loop compiles and.
##   5. If-else compiles and runs.
##   6. Nested function calls compile.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Optimization Flag") do ->
    it("compiles successfully with -O2") do ->
      assert_compile_succeeds("""
        def main(): Int
          42
        end
      """)
    end

    it("program runs correctly without optimization") do ->
      assert_run_exits("""
        def factorial(n: Int): Int
          if n <= 1
            return 1
          end
          return n * factorial(n - 1)
        end

        def main(): Int
          var r = factorial(5)
          r
        end
      """, 120)
    end

    it("simple arithmetic compiles") do ->
      assert_compile_succeeds("""
        def main(): Int
          var x = 10 + 20
          return x
        end
      """)
    end

    it("simple arithmetic produces correct result") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10 + 20
          return x
        end
      """, 30)
    end

    it("nested function calls compile") do ->
      assert_compile_succeeds("""
        def add(a: Int, b: Int): Int = a + b
        def double(x: Int): Int = add(x, x)
        def main(): Int
          return double(21)
        end
      """)
    end

    it("nested function calls produce correct result") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def double(x: Int): Int = add(x, x)
        def main(): Int
          return double(21)
        end
      """, 42)
    end

    it("while loop compiles and runs correctly") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          var i = 1
          while i <= 10
            sum = sum + i
            i = i + 1
          end
          return sum
        end
      """, 55)
    end

    it("for loop compiles and runs correctly") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0..5
            sum = sum + i
          end
          return sum
        end
      """, 10)
    end

    it("if-else compiles and runs correctly") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          if x > 40
            return 1
          else
            return 0
          end
        end
      """, 1)
    end

    it("struct creation compiles") do ->
      assert_compile_succeeds("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          var p = Point { x: 3, y: 4 }
          return p.x + p.y
        end
      """)
    end

    it("struct fields produce correct values") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          var p = Point { x: 3, y: 4 }
          return p.x + p.y
        end
      """, 7)
    end

    it("empty program compiles") do ->
      assert_compile_succeeds("""
        def main(): Int
          return 0
        end
      """)
    end

    it("compile error detected for undefined variable") do ->
      assert_compile_error("""
        def main(): Int
          return undefined_var
        end
      """, "error")
    end

  end

  return qspec_main()
end

