## Async Channel Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("async channels") do ->
    it("channel_notify_fd returns a valid fd") do ->
      assert_run_exits(notify_fd_src(), 0)
    end
    it("channel_notify_fd is idempotent (same fd on repeat calls)") do ->
      assert_run_exits(notify_fd_idempotent_src(), 0)
    end
    it("async_recv gets value from buffered channel") do ->
      assert_run_exits(async_recv_buffered_src(), 0)
    end
    it("async_recv returns -1 on closed empty channel") do ->
      assert_run_exits(async_recv_closed_src(), 0)
    end
    it("producer-consumer via async channel operations") do ->
      assert_run_exits(producer_consumer_src(), 0)
    end
    it("multiple async receivers fan out from one channel") do ->
      assert_run_exits(fan_out_src(), 0)
    end
  end
  return qspec_main()
end

def notify_fd_src(): String = """
  def main(): Int
    var ch = channel_new(1)
    var fd = channel_notify_fd(ch)
    if fd >= 0
      channel_free(ch)
      return 0
    end
    channel_free(ch)
    return 1
  end
  """

def notify_fd_idempotent_src(): String = """
  def main(): Int
    var ch = channel_new(1)
    var fd1 = channel_notify_fd(ch)
    var fd2 = channel_notify_fd(ch)
    if fd1 == fd2
      channel_free(ch)
      return 0
    end
    channel_free(ch)
    return 1
  end
  """

def async_recv_buffered_src(): String = """
  def async_recv(ch: Int): Int
    while true
      var opt = try_recv(ch)
      if option_is_some(opt)
        return load(opt, 1)
      end
      if channel_closed(ch)
        return -1
      end
      sched_yield()
    end
    return 0
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    send(ch, 42)
    var f = async async_recv(ch)
    sched_spawn(f)
    sched_shutdown()
    if load(f, 0) == -1
      if load(f, 1) == 42
        channel_free(ch)
        return 0
      end
    end
    channel_free(ch)
    return 1
  end
  """

def async_recv_closed_src(): String = """
  def async_recv(ch: Int): Int
    while true
      var opt = try_recv(ch)
      if option_is_some(opt)
        return load(opt, 1)
      end
      if channel_closed(ch)
        return -1
      end
      sched_yield()
    end
    return 0
  end
  def main(): Int
    var ch = channel_new(4)
    channel_close(ch)
    sched_init(2)
    var f = async async_recv(ch)
    sched_spawn(f)
    sched_shutdown()
    if load(f, 0) == -1
      if load(f, 1) == -1
        channel_free(ch)
        return 0
      end
    end
    channel_free(ch)
    return 1
  end
  """

def producer_consumer_src(): String = """
  def consumer(ch: Int): Int
    var sum = 0
    while true
      var opt = try_recv(ch)
      if option_is_some(opt)
        sum += load(opt, 1)
      else
        if channel_closed(ch)
          return sum
        end
        sched_yield()
      end
    end
    return sum
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    var f = async consumer(ch)
    sched_spawn(f)
    send(ch, 10)
    send(ch, 20)
    send(ch, 30)
    channel_close(ch)
    sched_shutdown()
    if load(f, 0) == -1
      if load(f, 1) == 60
        channel_free(ch)
        return 0
      end
    end
    channel_free(ch)
    return 1
  end
  """

def fan_out_src(): String = """
  def worker(ch: Int): Int
    while true
      var opt = try_recv(ch)
      if option_is_some(opt)
        return load(opt, 1)
      end
      if channel_closed(ch)
        return -1
      end
      sched_yield()
    end
    return 0
  end
  def main(): Int
    sched_init(4)
    var ch = channel_new(8)
    send(ch, 10)
    send(ch, 20)
    send(ch, 30)
    var f1 = async worker(ch)
    var f2 = async worker(ch)
    var f3 = async worker(ch)
    sched_spawn(f1)
    sched_spawn(f2)
    sched_spawn(f3)
    sched_shutdown()
    var sum = 0
    if load(f1, 0) == -1
      sum += load(f1, 1)
    end
    if load(f2, 0) == -1
      sum += load(f2, 1)
    end
    if load(f3, 0) == -1
      sum += load(f3, 1)
    end
    channel_free(ch)
    if sum == 60
      return 0
    end
    return 1
  end
  """
