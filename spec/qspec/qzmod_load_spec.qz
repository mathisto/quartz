## qzmod_load — Phase 1.2 round-trip + advisory-failure acceptance.
##
## Mirror image of qzmod_emit_spec.qz. Each test emits a known-shape
## .qzmod directory, then loads it back and asserts either:
##   - the load succeeds with structurally-equivalent data, OR
##   - the load fails with ok=0 + a non-empty diagnostic reason
##     (advisory cache, never crashes).
##
## Coverage:
##   1. Empty input emit → load → ok=1, all section vecs empty.
##   2. One-function emit → load → ok=1, func_names + sig_blob match.
##   3. One-struct emit → load → struct_names + fields_blob match.
##   4. Missing header.txt → ok=0 + reason.
##   5. Compiler-hash mismatch → ok=0 + reason.
##   6. Source-hash mismatch → ok=0 + reason.
##   7. Dep-iface-hash mismatch → ok=0 + reason.
##   8. Tampered section file (post-emit byte flip) → ok=0 + reason
##      via the integrity output_hash recompute step.

import * from qspec
import qzmod_format
import qzmod_emit
import qzmod_load
import file_io
import * from str_compat

def _ql_temp_root(): String = "/tmp/qzmod_load_test"

def _ql_temp_dir(label: String): String
  return "#{_ql_temp_root()}/#{label}"
end

def _ql_empty_deps_names(): Vec<String> = vec_new<String>()
def _ql_empty_deps_hashes(): Vec<String> = vec_new<String>()

def _ql_flags_hash(): String = "1234567890abcdef"
def _ql_source_hash(): String = "abcdef0123456789"

# =============================================================================
# Shared emit helpers — produce a known directory for each test, returning
# the emit's `output_hash` for cross-verification.
# =============================================================================

def _ql_emit_empty(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/empty_load")
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

def _ql_emit_one_func(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/one_func_load")
  input.func_names.push("foo")
  var p_types = vec_new()
  p_types.push(1)
  p_types.push(2)
  input.func_param_types.push(p_types)
  input.func_return_types.push(1)
  input.func_required_counts.push(2)
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

def _ql_emit_one_struct(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/one_struct_load")
  input.struct_names.push("Point")
  var fnames = vec_new<String>()
  fnames.push("x")
  fnames.push("y")
  input.struct_field_names.push(fnames)
  var ftypes = vec_new()
  ftypes.push(1)
  ftypes.push(1)
  input.struct_field_types.push(ftypes)
  input.struct_is_linear.push(0)
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

# =============================================================================
# Test bodies
# =============================================================================

def _ql_empty_emit_then_load_ok(): Int
  var dir = _ql_temp_dir("empty_ok")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  return result.ok
end

def _ql_empty_load_returns_no_funcs(): Int
  var dir = _ql_temp_dir("empty_no_funcs")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.func_names.size == 0
    return 1
  end
  return 0
end

def _ql_one_func_load_has_name(): Int
  var dir = _ql_temp_dir("one_func_name")
  var _h = _ql_emit_one_func(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_func_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.func_names.size != 1
    return 0
  end
  if str_eq(result.func_names[0], "foo")
    return 1
  end
  return 0
end

def _ql_one_func_sig_blob_intact(): Int
  var dir = _ql_temp_dir("one_func_sig")
  var _h = _ql_emit_one_func(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_func_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  # Expected: [n_params=2, return=1, required=2, p0=1, p1=2]
  var blob = result.func_sig_blob
  if blob.size != 5
    return 0
  end
  if blob[0] != 2
    return 0
  end
  if blob[1] != 1
    return 0
  end
  if blob[2] != 2
    return 0
  end
  if blob[3] != 1
    return 0
  end
  if blob[4] != 2
    return 0
  end
  return 1
end

def _ql_one_struct_load_has_name(): Int
  var dir = _ql_temp_dir("one_struct_name")
  var _h = _ql_emit_one_struct(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_struct_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.struct_names.size != 1
    return 0
  end
  if str_eq(result.struct_names[0], "Point")
    return 1
  end
  return 0
end

def _ql_one_struct_fields_blob_intact(): Int
  var dir = _ql_temp_dir("one_struct_fields")
  var _h = _ql_emit_one_struct(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_struct_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  # Pool order: Point(0), x(1), y(2).
  # Expected blob: [n_fields=2, is_linear=0, x_idx=1, type=1, y_idx=2, type=1]
  var blob = result.struct_fields_blob
  if blob.size != 6
    return 0
  end
  if blob[0] != 2
    return 0
  end
  if blob[1] != 0
    return 0
  end
  if blob[2] != 1
    return 0
  end
  if blob[3] != 1
    return 0
  end
  if blob[4] != 2
    return 0
  end
  if blob[5] != 1
    return 0
  end
  return 1
end

## Missing header.txt → load is a clean miss (ok=0), no crash.
def _ql_load_missing_header(): Int
  var dir = _ql_temp_dir("missing_header")
  # Don't emit anything — directory may not even exist.
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/missing", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok == 0 and str_byte_len(result.error_reason) > 0
    return 1
  end
  return 0
end

## Wrong compiler_hash on the load call → cache rejected as "wrong binary".
def _ql_load_compiler_hash_mismatch(): Int
  var dir = _ql_temp_dir("compiler_mismatch")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", "deadbeefdeadbeef",   # NOT the real compiler hash
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok == 0 and str_byte_len(result.error_reason) > 0
    return 1
  end
  return 0
end

## Wrong source_hash → cache rejected as "source changed".
def _ql_load_source_hash_mismatch(): Int
  var dir = _ql_temp_dir("source_mismatch")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    "ffffffffffffffff",   # different from _ql_source_hash()
    _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok == 0 and str_byte_len(result.error_reason) > 0
    return 1
  end
  return 0
end

## Dep-iface-hash list differs → cache rejected.
def _ql_load_dep_iface_hash_mismatch(): Int
  var dir = _ql_temp_dir("dep_mismatch")
  var _h = _ql_emit_empty(dir)
  # Caller's view says "I have one dep with hash X" but emit recorded zero
  # deps. Position-mismatched length is enough to trip the gate.
  var bogus_deps = vec_new<String>()
  bogus_deps.push("aaaaaaaaaaaaaaaa")
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), bogus_deps
  )
  if result.ok == 0 and str_byte_len(result.error_reason) > 0
    return 1
  end
  return 0
end

## Output_hash integrity: overwrite a section file post-emit so its
## bytes no longer match what the header recorded. The recompute-and-
## compare step must catch this and return ok=0.
def _ql_load_tampered_section_caught(): Int
  var dir = _ql_temp_dir("tampered")
  var _h = _ql_emit_one_func(dir)
  # Tamper with a section file: overwrite strings.bin with arbitrary
  # contents. This invalidates the on-disk output_hash relative to what
  # header.txt says.
  var strings_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_strings())
  var _wr = fio_write(strings_path, "tampered junk")
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_func_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok == 0 and str_byte_len(result.error_reason) > 0
    return 1
  end
  return 0
end

# =============================================================================
# Phase 1.4.a — TYPES section + global symbol tables round-trip
# =============================================================================

def _ql_emit_one_ptype(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/one_ptype_load")
  input.ptype_bases.push(10)  # mock TYPE_OPTION
  input.ptype_arg1s.push(1)   # mock TYPE_INT
  input.ptype_arg2s.push(0)
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

def _ql_one_ptype_types_section_roundtrip(): Int
  var dir = _ql_temp_dir("one_ptype_types")
  var _h = _ql_emit_one_ptype(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/one_ptype_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.types_tag.size != 1 or result.types_arg1.size != 1 or result.types_arg2.size != 1
    return 0
  end
  if result.types_tag[0] != 10
    return 0
  end
  if result.types_arg1[0] != 1
    return 0
  end
  if result.types_arg2[0] != 0
    return 0
  end
  return 1
end

def _ql_empty_ptype_types_section_absent(): Int
  var dir = _ql_temp_dir("empty_ptype_load")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  # Empty input had no ptypes → loader sees absent files → zero-length Vecs.
  if result.types_tag.size != 0 or result.types_arg1.size != 0 or result.types_arg2.size != 0
    return 0
  end
  return 1
end

# =============================================================================
# Phase 1.4.b.1 — ptype_names + fn_type_annotations round-trip via load
# =============================================================================

def _ql_emit_ptype_with_names(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/ptype_with_names")
  input.ptype_bases.push(10)
  input.ptype_arg1s.push(1)
  input.ptype_arg2s.push(0)
  input.ptype_names.push("Point")
  input.fn_type_annotations.push("Fn(Int) -> Int")
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

def _ql_ptype_names_roundtrip(): Int
  var dir = _ql_temp_dir("ptype_names_load")
  var _h = _ql_emit_ptype_with_names(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/ptype_with_names", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.ptype_names.size != 1
    return 0
  end
  if not str_eq(result.ptype_names[0], "Point")
    return 0
  end
  return 1
end

def _ql_fn_type_annotations_roundtrip(): Int
  var dir = _ql_temp_dir("fn_type_load")
  var _h = _ql_emit_ptype_with_names(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/ptype_with_names", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.fn_type_annotations.size != 1
    return 0
  end
  if not str_eq(result.fn_type_annotations[0], "Fn(Int) -> Int")
    return 0
  end
  return 1
end

def _ql_empty_ptype_names_absent(): Int
  var dir = _ql_temp_dir("empty_ptype_names_load")
  var _h = _ql_emit_empty(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/empty_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.ptype_names.size != 0 or result.fn_type_annotations.size != 0
    return 0
  end
  return 1
end

# =============================================================================
# Phase 1.4.c.0 — type_params + super_traits + field_annotations round-trip
# =============================================================================

def _ql_emit_struct_with_extras(dir: String): String
  var input = qzmod_emit::qzmod_input_new("mock/struct_extras")
  input.struct_names.push("GBox")
  input.struct_field_names.push(vec_new<String>())
  input.struct_field_types.push(vec_new<Int>())
  input.struct_is_linear.push(0)
  input.struct_type_params.push("T")
  var anns = vec_new<String>()
  anns.push("T")
  input.struct_field_annotations.push(anns)
  return qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
end

def _ql_struct_type_params_roundtrip(): Int
  var dir = _ql_temp_dir("struct_extras_load")
  var _h = _ql_emit_struct_with_extras(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/struct_extras", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.struct_type_params.size != 1
    return 0
  end
  if not str_eq(result.struct_type_params[0], "T")
    return 0
  end
  return 1
end

def _ql_struct_field_annotations_roundtrip(): Int
  var dir = _ql_temp_dir("struct_field_anns_load")
  var _h = _ql_emit_struct_with_extras(dir)
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/struct_extras", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.struct_field_annotations.size != 1
    return 0
  end
  var inner = result.struct_field_annotations[0]
  if inner.size != 1
    return 0
  end
  if not str_eq(inner[0], "T")
    return 0
  end
  return 1
end

def _ql_trait_extras_roundtrip(): Int
  var input = qzmod_emit::qzmod_input_new("mock/trait_extras_load")
  input.trait_names.push("Stringify")
  input.trait_method_names.push(vec_new<String>())
  input.trait_method_sigs.push(vec_new<Int>())
  input.trait_method_defaults.push(vec_new<Int>())
  input.trait_type_params.push("")
  input.trait_super_traits.push("Display")
  var dir = _ql_temp_dir("trait_extras_load")
  var _h = qzmod_emit::qzmod_emit_module(
    input, _ql_source_hash(), _ql_flags_hash(),
    _ql_empty_deps_names(), _ql_empty_deps_hashes(), dir
  )
  var result = qzmod_load::qzmod_load_module(
    dir, "mock/trait_extras_load", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok != 1
    return 0
  end
  if result.trait_type_params.size != 1 or result.trait_super_traits.size != 1
    return 0
  end
  if not str_eq(result.trait_super_traits[0], "Display")
    return 0
  end
  if not str_eq(result.trait_type_params[0], "")
    return 0
  end
  return 1
end

## Empty module_dir argument → silent miss, no panic.
def _ql_load_empty_dir_returns_miss(): Int
  var result = qzmod_load::qzmod_load_module(
    "", "mock/empty_arg", qzmod_format::qzmod_compiler_hash(),
    _ql_source_hash(), _ql_flags_hash(), _ql_empty_deps_hashes()
  )
  if result.ok == 0
    return 1
  end
  return 0
end

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("qzmod_load · empty round-trip") do ->
    it("empty emit + load yields ok=1") do ->
      assert_eq(_ql_empty_emit_then_load_ok(), 1)
    end

    it("empty load result has no funcs") do ->
      assert_eq(_ql_empty_load_returns_no_funcs(), 1)
    end
  end

  describe("qzmod_load · one function round-trip") do ->
    it("func_names round-trips to ['foo']") do ->
      assert_eq(_ql_one_func_load_has_name(), 1)
    end

    it("sig_blob bytes match emit exactly") do ->
      assert_eq(_ql_one_func_sig_blob_intact(), 1)
    end
  end

  describe("qzmod_load · one struct round-trip") do ->
    it("struct_names round-trips to ['Point']") do ->
      assert_eq(_ql_one_struct_load_has_name(), 1)
    end

    it("fields_blob preserves layout + name-pool indices") do ->
      assert_eq(_ql_one_struct_fields_blob_intact(), 1)
    end
  end

  describe("qzmod_load · advisory-cache failure modes") do ->
    it("missing header.txt → ok=0 with reason") do ->
      assert_eq(_ql_load_missing_header(), 1)
    end

    it("compiler_hash mismatch → ok=0 with reason") do ->
      assert_eq(_ql_load_compiler_hash_mismatch(), 1)
    end

    it("source_hash mismatch → ok=0 with reason") do ->
      assert_eq(_ql_load_source_hash_mismatch(), 1)
    end

    it("dep_iface_hashes mismatch → ok=0 with reason") do ->
      assert_eq(_ql_load_dep_iface_hash_mismatch(), 1)
    end

    it("tampered section file caught by output_hash recompute") do ->
      assert_eq(_ql_load_tampered_section_caught(), 1)
    end

    it("empty module_dir argument → ok=0 (no panic)") do ->
      assert_eq(_ql_load_empty_dir_returns_miss(), 1)
    end
  end

  describe("qzmod_load · TYPES section round-trip (Phase 1.4.a)") do ->
    it("one ptype → types_tag/arg1/arg2 match emit bytes") do ->
      assert_eq(_ql_one_ptype_types_section_roundtrip(), 1)
    end

    it("empty ptype arena → load result has empty TYPES vecs") do ->
      assert_eq(_ql_empty_ptype_types_section_absent(), 1)
    end
  end

  describe("qzmod_load · ptype identity + fn_type registry (Phase 1.4.b.1)") do ->
    it("ptype_names round-trips through types_names.bin") do ->
      assert_eq(_ql_ptype_names_roundtrip(), 1)
    end

    it("fn_type_annotations round-trips through fn_type_annotations.bin") do ->
      assert_eq(_ql_fn_type_annotations_roundtrip(), 1)
    end

    it("empty input → ptype_names + fn_type_annotations absent (empty Vec)") do ->
      assert_eq(_ql_empty_ptype_names_absent(), 1)
    end
  end

  describe("qzmod_load · generic / super-trait / annotations (Phase 1.4.c.0)") do ->
    it("struct_type_params round-trips through structs_type_params.bin") do ->
      assert_eq(_ql_struct_type_params_roundtrip(), 1)
    end

    it("struct_field_annotations round-trip through pool-indexed blob") do ->
      assert_eq(_ql_struct_field_annotations_roundtrip(), 1)
    end

    it("trait_type_params + trait_super_traits round-trip in parallel") do ->
      assert_eq(_ql_trait_extras_roundtrip(), 1)
    end
  end

  return qspec_main()
end
