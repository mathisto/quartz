## FIX.2 Unicode Awareness — Codepoint semantics tests
##
## Contract:
##   1. .size returns codepoint count (not byte count)
##   2. s[i] returns codepoint value at codepoint index
##   3. .slice(a, b) extracts by codepoint range
##   4. str_find returns codepoint offset
##   5. Byte-level UFCS methods (.byte_at, .byte_slice, .byte_len, .byte_find, .bytes) work
##   6. Byte-level and codepoint-level can be mixed on same string

import * from qspec

# ---- .size returns codepoint count ----

def test_size_ascii(): Void
  assert_eq("hello".size(), 5)
end

def test_size_empty(): Void
  assert_eq("".size(), 0)
end

def test_size_2byte(): Void
  # e-acute (U+00E9) = 1 codepoint, 2 bytes
  var s = str_from_codepoint(233)
  assert_eq(s.size(), 1)
end

def test_size_3byte(): Void
  # CJK character (U+4E2D) = 1 codepoint, 3 bytes
  var s = str_from_codepoint(20013)
  assert_eq(s.size(), 1)
end

def test_size_4byte(): Void
  # Emoji (U+1F600) = 1 codepoint, 4 bytes
  var s = str_from_codepoint(128512)
  assert_eq(s.size(), 1)
end

def test_size_mixed(): Void
  # "a" + e-acute + CJK = 3 codepoints
  var s = "a" + str_from_codepoint(233) + str_from_codepoint(20013)
  assert_eq(s.size(), 3)
  # But byte length is 1 + 2 + 3 = 6
  assert_eq(str_byte_len(s), 6)
end

# ---- UFCS byte-level methods ----

def test_byte_len_ufcs(): Void
  var s = str_from_codepoint(233)
  assert_eq(s.byte_len(), 2)
end

def test_byte_at_ufcs(): Void
  # e-acute (U+00E9) = 0xC3 0xA9
  var s = str_from_codepoint(233)
  assert_eq(s.byte_at(0), 195)
  assert_eq(s.byte_at(1), 169)
end

def test_byte_slice_ufcs(): Void
  assert_eq_str("hello".byte_slice(1, 4), "ell")
end

def test_byte_find_ufcs(): Void
  var result = "hello world".byte_find("world")
  assert_eq(option_is_some(result), 1)
  assert_eq(option_get(result), 6)
end

def print_bytes_hi(): Void
  var bytes = "Hi".bytes()
  var i = 0
  while i < vec_size(bytes)
    print_int(bytes[i])
    i += 1
  end
end

def test_bytes_ufcs(): Void
  assert_output("72\n105\n", print_bytes_hi)
end

# ---- Mixed byte + codepoint on same string ----

def test_mixed_access(): Void
  # e-acute: 1 codepoint, 2 bytes
  var s = str_from_codepoint(233)
  assert_eq(s.size(), 1)
  assert_eq(s.byte_len(), 2)
end

def main(): Int
  describe(".size codepoint count") do ->
    it("returns 5 for ASCII") do ->
      test_size_ascii()
    end

    it("returns 0 for empty") do ->
      test_size_empty()
    end

    it("returns 1 for 2-byte char") do ->
      test_size_2byte()
    end

    it("returns 1 for 3-byte char") do ->
      test_size_3byte()
    end

    it("returns 1 for 4-byte char") do ->
      test_size_4byte()
    end

    it("counts codepoints in mixed string") do ->
      test_size_mixed()
    end
  end

  describe("UFCS byte methods") do ->
    it(".byte_len() returns byte count") do ->
      test_byte_len_ufcs()
    end

    it(".byte_at() returns raw bytes") do ->
      test_byte_at_ufcs()
    end

    it(".byte_slice() slices by bytes") do ->
      test_byte_slice_ufcs()
    end

    it(".byte_find() finds by byte offset") do ->
      test_byte_find_ufcs()
    end

    it(".bytes() returns byte Vec") do ->
      test_bytes_ufcs()
    end
  end

  describe("mixed byte + codepoint") do ->
    it("can use both on same string") do ->
      test_mixed_access()
    end
  end

  return qspec_main()
end
