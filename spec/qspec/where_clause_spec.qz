## SURF.2 — `where` clauses for trait bounds + effect-row variable
##
## Decided syntax (LOCKED, docs/design/SURFACE_SYNTAX_RATIONALE.md §2):
## hoist trait bounds AND the effect row out of the signature spine into a
## trailing `where` clause:
##
##   def merge<K, V>(a: Map<K, Vec<V>>, b: Map<K, Vec<V>>): Result<...>
##     where K: Hash, V: Show, e
##
## `where` lists trait bounds (`K: Hash`) and the effect-row variable (`e`,
## a bare identifier, no colon). A single trivial inline bound (`<T: Show>`)
## stays legal. An inline `can e` AND a where-effect-var are mutually
## exclusive — the effect row has exactly one home.
##
## This is purely additive surface sugar: the where clause desugars into the
## SAME trait-bound machinery (type_param_bounds string -> tc_validate_trait_bounds)
## and the SAME effect-row scratchpad (ps.last_can_* -> ast_func_set_can_row)
## that the inline forms feed. Existing inline programs are unaffected.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("SURF.2 where clauses") do ->
    # ---- trait-bound where clause: enforced ----
    it("satisfying type arg compiles and runs (where on continuation line)") do ->
      assert_run_exits("""
        trait Show
          def show(self): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Show
          def show(self): Int
            return 42
          end
        end
        def render<T>(v: T): Int
          where T: Show
          return v.show()
        end
        def main(): Int
          f = Foo { x: 1 }
          return render<Foo>(f)
        end
        """, 42)
    end

    it("violating type arg is rejected (bound enforced)") do ->
      assert_compile_error("""
        trait Show
          def show(self): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        struct Bar
          y: Int
        end
        extend Foo with Show
          def show(self): Int
            return 42
          end
        end
        def render<T>(v: T): Int
          where T: Show
          return v.show()
        end
        def main(): Int
          b = Bar { y: 1 }
          return render<Bar>(b)
        end
        """, "does not implement trait")
    end

    it("multiple bounds in where clause, on same line") do ->
      assert_run_exits("""
        trait Show
          def show(self): Int
            return 0
          end
        end
        trait Tag
          def tag(self): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Show
          def show(self): Int
            return 3
          end
        end
        extend Foo with Tag
          def tag(self): Int
            return 4
          end
        end
        def render<T>(v: T): Int where T: Show + Tag
          return v.show() + v.tag()
        end
        def main(): Int
          f = Foo { x: 1 }
          return render<Foo>(f)
        end
        """, 7)
    end

    # ---- effect-row variable in where clause ----
    it("effect-row variable in where clause compiles and runs") do ->
      assert_run_exits("""
        def f<T>(x: Int): Int
          where e
          return x + 1
        end
        def main(): Int
          return f<Int>(41)
        end
        """, 42)
    end

    it("effect-row variable equivalent to inline can e (same behavior)") do ->
      assert_run_exits("""
        def inline_form(x: Int): Int can e = x + 5
        def where_form(x: Int): Int
          where e
          return x + 5
        end
        def main(): Int
          return where_form(10) - inline_form(10)
        end
        """, 0)
    end

    it("trait bound and effect-row variable together in one where clause") do ->
      assert_run_exits("""
        trait Show
          def show(self): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Show
          def show(self): Int
            return 9
          end
        end
        def render<T>(v: T): Int where T: Show, e
          return v.show()
        end
        def main(): Int
          f = Foo { x: 1 }
          return render<Foo>(f)
        end
        """, 9)
    end

    # ---- mutual exclusion: inline can AND where-effect-var ----
    it("rejects both inline can AND where effect-row variable") do ->
      assert_compile_error("""
        def f<T>(x: Int): Int can Log
          where e
          return x + 1
        end
        def main(): Int
          return f<Int>(10)
        end
        """, "Effect row given both")
    end

    # ---- regression: inline forms still legal ----
    it("single trivial inline bound stays legal") do ->
      assert_run_exits("""
        trait Show
          def show(self): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Show
          def show(self): Int
            return 11
          end
        end
        def render<T: Show>(v: T): Int
          return v.show()
        end
        def main(): Int
          f = Foo { x: 1 }
          return render<Foo>(f)
        end
        """, 11)
    end

    it("inline trailing can clause unaffected") do ->
      assert_run_exits("""
        def withcan(x: Int): Int can Log = x + 5
        def main(): Int
          return withcan(0)
        end
        """, 5)
    end
  end

  return qspec_main()
end
