## Network Timeout Spec — Tests for connection and I/O timeouts
##
## Tests connect timeout, read timeout, write timeout on TCP and TLS streams.
##
## Contract:
##   1. TCP connect timeout.
##   2. TCP read timeout.
##   3. TLS connect timeout.
##   4. TLS read timeout.
##   5. Send timeout.

import * from qspec
import std/net/tcp
import std/net/tls
import std/time

# =============================================================================
# Helpers
# =============================================================================

def print_tcp_connect_timeout(): Void
  var start = time_epoch_ms()
  match tcp_connect_timeout("10.255.255.1", 80, 1000)
    Ok(stream) => {
      puts("unexpected_success")
      tcp_close(stream)
    }
    Err(e) => {
      var elapsed = time_epoch_ms() - start
      if elapsed >= 800 and elapsed <= 3000
        puts("timeout_ok")
      else
        puts("timeout_elapsed_" + str_from_int(elapsed))
      end
      0
    }
  end
end

def print_tcp_read_timeout(): Void
  match tcp_listen(0)
    Ok(server) => {
      var port = server.port

      match tcp_connect("127.0.0.1", port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              tcp_set_timeout(client, 500)

              var start = time_epoch_ms()
              match tcp_read(client, 1024)
                Ok(data) => {
                  puts("unexpected_data")
                  0
                }
                Err(e) => {
                  var elapsed = time_epoch_ms() - start
                  if elapsed >= 300 and elapsed <= 2000
                    puts("read_timeout_ok")
                  else
                    puts("read_timeout_elapsed_" + str_from_int(elapsed))
                  end
                  0
                }
              end
              tcp_close(server_conn)
            }
            Err(e) => {
              puts("accept_error")
              0
            }
          end
          tcp_close(client)
        }
        Err(e) => {
          puts("connect_error")
          0
        }
      end
      tcp_close_listener(server)
      0
    }
    Err(e) => {
      puts("listen_error")
      0
    }
  end
end

def print_tls_connect_timeout(): Void
  var ctx = tls_ctx_new_client()
  var start = time_epoch_ms()
  match tls_connect_timeout(ctx, "10.255.255.1", 443, 1000)
    Ok(stream) => {
      puts("unexpected_success")
      tls_close(stream)
      0
    }
    Err(e) => {
      var elapsed = time_epoch_ms() - start
      if elapsed >= 800 and elapsed <= 3000
        puts("tls_timeout_ok")
      else
        puts("tls_timeout_elapsed_" + str_from_int(elapsed))
      end
      0
    }
  end
  tls_ctx_free(ctx)
end

def print_send_timeout(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              # Set short send timeout (100ms)
              tcp_set_send_timeout(client, 100)
              # Build a 64KB data block
              var sb = sb_new()
              for _k in 0..1024
                sb_append(sb, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
              end
              var big_data = sb_to_string(sb)
              # Flood writes until send buffer fills and times out
              var timed_out = 0
              var writes = 0
              while writes < 10000 and timed_out == 0
                match tcp_write(client, big_data)
                  Ok(n) => { writes += 1 }
                  Err(e) => { timed_out = 1 }
                end
              end
              if timed_out
                puts("send_timeout_ok")
              else
                puts("no_timeout")
              end
              tcp_close(server_conn)
            }
            Err(e) => {
              puts("accept_error")
              0
            }
          end
          tcp_close(client)
        }
        Err(e) => {
          puts("connect_error")
          0
        }
      end
      tcp_close_listener(server)
      0
    }
    Err(e) => {
      puts("listen_error")
      0
    }
  end
end

def print_tls_read_timeout(): Void
  var ctx = tls_ctx_new_client()
  match tls_connect(ctx, "httpbin.org", 443)
    Ok(stream) => {
      tls_set_timeout(stream, 500)

      var start = time_epoch_ms()
      match tls_read(stream, 1024)
        Ok(data) => {
          puts("unexpected_data: " + data)
          0
        }
        Err(e) => {
          var elapsed = time_epoch_ms() - start
          if elapsed >= 300 and elapsed <= 2000
            puts("tls_read_timeout_ok")
          else
            puts("tls_read_timeout_elapsed_" + str_from_int(elapsed))
          end
          0
        }
      end
      tls_close(stream)
      0
    }
    Err(e) => {
      puts(str_concat("connect_error: ", e.message))
      0
    }
  end
  tls_ctx_free(ctx)
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("TCP connect timeout") do ->
    it("times out connecting to non-routable address") do ->
      assert_output("timeout_ok\n", print_tcp_connect_timeout)
    end
  end

  describe("TCP read timeout") do ->
    it("times out reading from silent server") do ->
      assert_output("read_timeout_ok\n", print_tcp_read_timeout)
    end
  end

  describe("TLS connect timeout") do ->
    it("times out TLS-connecting to non-routable address") do ->
      assert_output("tls_timeout_ok\n", print_tls_connect_timeout)
    end
  end

  describe("TLS read timeout") do ->
    it("times out reading from TLS connection") do ->
      assert_output("tls_read_timeout_ok\n", print_tls_read_timeout)
    end
  end

  describe("Send timeout") do ->
    it("times out writing to full send buffer") do ->
      assert_output("send_timeout_ok\n", print_send_timeout)
    end
  end

  return qspec_main()
end
