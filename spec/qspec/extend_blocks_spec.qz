## Extend Blocks Tests
##
## Contract:
##   1. Basic extension methods.
##   2. Direct call syntax.
##   3. Extension on structs.
##   4. Method chaining.
##   5. Advanced features.

import * from qspec

extend Int
  def double(): Int = self * 2
  def plus(n: Int): Int = self + n
  def half(): Int = self / 2
  def compute(): Int
    a = self * 2
    b = a + 10
    return b
  end
  def triple(): Int = self * 3
  def factorial(): Int
    if self <= 1
      return 1
    end
    return self * (self - 1).factorial()
  end
end

extend Bool
  def as_int_val(): Int
    if self
      return 1
    end
    return 0
  end
end

struct EPoint
  x: Int
  y: Int
end

extend EPoint
  def sum(): Int = self.x + self.y
end

def main(): Int
  describe("basic extension methods") do ->
    it("extends Int with a method") do ->
      x = 21
      assert_eq(x.double(), 42)
    end
    it("extends Int with multiple methods") do ->
      x = 10
      assert_eq(x.double().plus(5), 25)
    end
    it("extension method with multi-statement body") do ->
      assert_eq(5.compute(), 20)
    end
  end

  describe("direct call syntax") do ->
    it("can call extension method with Type$method syntax") do ->
      assert_eq(Int::triple(7), 21)
    end
  end

  describe("extension on structs") do ->
    it("extends a struct with a method") do ->
      p = EPoint { x: 10, y: 32 }
      assert_eq(p.sum(), 42)
    end
  end

  describe("method chaining") do ->
    it("chains multiple extension methods") do ->
      assert_eq(10.double().plus(10).half(), 15)
    end
  end

  describe("advanced features") do ->
    it("recursive extension method calls") do ->
      assert_eq(5.factorial(), 120)
    end
    it("extends Bool with a method") do ->
      t = true
      assert_eq(t.as_int_val(), 1)
    end
  end

  return qspec_main()
end
