## Strict newtype tests (STRICT_NEWTYPES)
##
## Contract:
##   1. `@strict newtype` declarations parse and register the strict flag.
##   2. Implicit conversion across the strict boundary is rejected at:
##      let, function arg, function return, branch condition, match
##      scrutinee, array index, relational ops, bit-shift right-operand.
##   3. Crossing the boundary requires `as_type<T>(v)` — typecheck-relaxed,
##      identity at codegen.
##   4. Arithmetic on like-typed strict-newtype values (same ptype id)
##      typechecks via tc_types_match exact-id equality.
##   5. Loose newtypes (declared without `@strict`) preserve existing
##      behaviour — no migration cost.

import * from qspec
import * from qspec/subprocess

# Module-level strict newtype used by positive-path tests.
@strict
newtype StSecret<T> = T

@strict
newtype StTag = Int

# Loose newtype baseline — must remain unchanged.
newtype StLooseId = Int

# Crossing-boundary wrappers — the audit-greppable callsite. In production
# crypto code these live in std/core/crypto/secret.qz; here inline for the spec.
def st_wrap_int(t: Int): StSecret<Int> = as_type<StSecret<Int>>(t)
def st_unwrap_int(s: StSecret<Int>): Int = as_type<Int>(s)

# Polymorphic crossing-boundary wrappers (STRICT_NEWTYPES_GENERIC_BINDING).
# These mirror the shape exposed by std/core/crypto/secret.qz post-fix.
def st_wrap<T>(t: T): StSecret<T> = as_type<StSecret<T>>(t)
def st_unwrap<T>(s: StSecret<T>): T = as_type<T>(s)

# Used by positive-path arithmetic tests.
def st_add(a: StSecret<Int>, b: StSecret<Int>): StSecret<Int>
  # `+` between two same-id strict newtypes type-checks via exact-id match.
  # Arithmetic is permitted; relational ops are not.
  return as_type<StSecret<Int>>(as_type<Int>(a) + as_type<Int>(b))
end

def main(): Int
  describe("positive paths") do ->
    it("declares @strict newtype and accepts as_type<>-crossed values") do ->
      var s = st_wrap_int(42)
      var v = st_unwrap_int(s)
      assert_eq(v, 42)
    end

    it("supports same-id arithmetic on strict-newtype values") do ->
      var a = st_wrap_int(2)
      var b = st_wrap_int(3)
      var c = st_add(a, b)
      assert_eq(st_unwrap_int(c), 5)
    end

    # STRICT_NEWTYPES_GENERIC_BINDING (2026-05-22) — polymorphic helpers
    # over `Secret<T>` bind T at the call site. Before the fix, the
    # strict short-circuit in tc_types_match returned false on bare-vs-
    # ptype matching off the same newtype base, forcing monomorphic
    # workarounds. The fix permits same-base bare↔ptype + ptype↔ptype
    # with strict inner-arg equality.
    it("binds T in polymorphic st_wrap<T> / st_unwrap<T>") do ->
      var s: StSecret<Int> = st_wrap<Int>(11)
      var v: Int = st_unwrap<Int>(s)
      assert_eq(v, 11)
    end

    it("infers T in polymorphic st_wrap / st_unwrap (no explicit arg)") do ->
      var s: StSecret<Int> = st_wrap(22)
      var v: Int = st_unwrap(s)
      assert_eq(v, 22)
    end

    it("preserves loose newtype behaviour unchanged") do ->
      # Loose newtype: implicit Int<->LooseId still works.
      var id: StLooseId = 99
      var n: Int = id
      assert_eq(n, 99)
    end
  end

  describe("rejections (compile-time)") do ->
    it("rejects implicit construction at let position") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def main(): Int
          x: S<Int> = 5
          return 0
        end
      """, "QZ0201")
    end

    it("rejects implicit unwrap at function argument") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def takes_s(s: S<Int>): Int = 0
        def main(): Int
          y: Int = 7
          return takes_s(y)
        end
      """, "QZ0201")
    end

    # STRICT_NEWTYPE_UNWRAP_AT_ARG (2026-05-22) — symmetric direction.
    # Before the fix the arg-validator only entered when EXPECTED was newtype/
    # strict, so passing a strict newtype value to a param typed as the
    # underlying wrapped type compiled silently. With the fix the asymmetric
    # case is rejected at the same site.
    it("rejects implicit unwrap (strict -> wrapped) at function argument") do ->
      assert_compile_error("""
        @strict
        newtype Vault = Int
        def vault_seal(v: Int): Vault = as_type<Vault>(v)
        def takes_int(n: Int): Int = n
        def main(): Int
          var sealed: Vault = vault_seal(42)
          return takes_int(sealed)
        end
      """, "QZ0201")
    end

    # Same shape with a ptype-form strict newtype (Secret<Int>) — same
    # rejection path.
    it("rejects implicit unwrap (strict ptype -> wrapped) at function argument") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def wrap(v: Int): S<Int> = as_type<S<Int>>(v)
        def takes_int(n: Int): Int = n
        def main(): Int
          var s: S<Int> = wrap(7)
          return takes_int(s)
        end
      """, "QZ0201")
    end

    it("rejects implicit construction at function return") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(): S<Int>
          return 42
        end
        def main(): Int = 0
      """, "QZ0200")
    end

    it("rejects branch on strict-newtype condition") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(t: Int): S<Int> = as_type<S<Int>>(t)
        def main(): Int
          s = make(1)
          if s
            return 1
          end
          return 0
        end
      """, "QZ0200")
    end

    it("rejects match on strict-newtype scrutinee") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(t: Int): S<Int> = as_type<S<Int>>(t)
        def main(): Int
          s = make(1)
          var r = match s
            _ => 0
          end
          return r
        end
      """, "QZ0200")
    end

    it("rejects array index by strict-newtype value") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(t: Int): S<Int> = as_type<S<Int>>(t)
        def main(): Int
          s = make(0)
          v = vec_new<Int>()
          v.push(99)
          return v[s]
        end
      """, "QZ0200")
    end

    it("rejects relational operators on strict-newtype operands") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(t: Int): S<Int> = as_type<S<Int>>(t)
        def main(): Int
          a = make(1)
          b = make(2)
          if a == b
            return 1
          end
          return 0
        end
      """, "QZ0200")
    end

    it("rejects bit-shift with a strict-newtype operand") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def make(t: Int): S<Int> = as_type<S<Int>>(t)
        def main(): Int
          s = make(3)
          return 1 << s
        end
      """, "QZ0200")
    end

    it("rejects @strict on a non-newtype declaration") do ->
      assert_compile_error("""
        @strict
        struct Bogus
          x: Int
        end
        def main(): Int = 0
      """, "QZ0101")
    end

    # STRICT_NEWTYPES_GENERIC_BINDING — same-base ptype-vs-ptype matching
    # is allowed only when the INNER arg ids match exactly. The fix must
    # NOT regress to admit `Secret<String>` against `Secret<Int>` via the
    # i64-existential-erasure path. Caught and fixed during 2026-05-22
    # implementation.
    it("rejects same-base strict ptype with mismatched inner args") do ->
      assert_compile_error("""
        @strict
        newtype S<T> = T
        def takes_int_s(s: S<Int>): Int = as_type<Int>(s)
        def main(): Int
          var ss: S<String> = as_type<S<String>>("hi")
          return takes_int_s(ss)
        end
      """, "QZ0201")
    end

    it("rejects different strict newtype bases (Vault vs Token)") do ->
      assert_compile_error("""
        @strict
        newtype Vault<T> = T
        @strict
        newtype Token<T> = T
        def takes_vault(s: Vault<Int>): Int = as_type<Int>(s)
        def main(): Int
          var t: Token<Int> = as_type<Token<Int>>(7)
          return takes_vault(t)
        end
      """, "QZ0201")
    end
  end

  describe("loose newtypes preserved") do ->
    it("permits implicit Int -> LooseNewtype at let") do ->
      var id: StLooseId = 12
      assert_eq(as_type<Int>(id), 12)
    end

    it("permits implicit LooseNewtype -> Int at let") do ->
      var id: StLooseId = 13
      var n: Int = id
      assert_eq(n, 13)
    end
  end

  # STRICT_NEWTYPES_QZMOD — strictness must survive the cross-module
  # qzmod cache path. These specs declare `@strict newtype` in module A
  # and consume it from module B; without the parallel-array flag the
  # consumer would silently default to loose and the rejection paths
  # below would compile-succeed (regression for any future audit).
  describe("strict newtypes cross-module (STRICT_NEWTYPES_QZMOD)") do ->
    it("rejects implicit construction of an imported strict newtype at function arg") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("vault.qz"))
      var vault_src = """
@strict
newtype Vault = Int

def takes_vault(s: Vault): Int = as_type<Int>(s)
"""
      vec_push(files, as_int(vault_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import vault as v

def main(): Int
  # Bare Int passed where v::Vault is expected — must be rejected even
  # after the strict-flag survives the qzmod cross-module path. The
  # arg-validator's strict branch (typecheck_expr_handlers.qz §3631)
  # fires because the expected param type is the strict newtype.
  return v::takes_vault(42)
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_compile_error(files, 1, "Type mismatch")
    end

    # STRICT_NEWTYPE_UNWRAP_AT_ARG cross-module direction — a strict newtype
    # value flowing OUT of a module B and into a loose-Int param of module A
    # must also be rejected. Exercises the same fix across the qzmod cache.
    it("rejects cross-module implicit unwrap (strict -> wrapped) at function arg") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("vault.qz"))
      var vault_src = """
@strict
newtype Vault = Int

def vault_seal(v: Int): Vault = as_type<Vault>(v)
"""
      vec_push(files, as_int(vault_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import vault as v

def takes_int(n: Int): Int = n

def main(): Int
  var sealed: v::Vault = v::vault_seal(42)
  return takes_int(sealed)
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_compile_error(files, 1, "Type mismatch")
    end

    it("rejects implicit construction of an imported strict newtype at let") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("vault.qz"))
      var vault_src = """
@strict
newtype Vault = Int
"""
      vec_push(files, as_int(vault_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import vault as v

def main(): Int
  # Implicit Int -> Vault at let must be rejected across modules.
  var sealed: v::Vault = 42
  return 0
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_compile_error(files, 1, "QZ0201")
    end

    it("accepts as_type<>-crossed value of an imported strict newtype") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("vault.qz"))
      var vault_src = """
@strict
newtype Vault = Int

def vault_seal(v: Int): Vault = as_type<Vault>(v)
def vault_open(s: Vault): Int = as_type<Int>(s)
"""
      vec_push(files, as_int(vault_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import vault as v

def main(): Int
  var sealed: v::Vault = v::vault_seal(42)
  return v::vault_open(sealed)
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("preserves cross-module loose newtype behavior (no regression)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("vault.qz"))
      var vault_src = """
newtype LooseVault = Int

def loose_seal(v: Int): LooseVault = v
"""
      vec_push(files, as_int(vault_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import vault as v

def main(): Int
  var sealed: v::LooseVault = v::loose_seal(42)
  # Loose newtype: implicit Int<->LooseVault is permitted; the cross-module
  # path must NOT now over-strictify it just because the qzmod parallel
  # array exists.
  var n: Int = sealed
  return n
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  return qspec_main()
end
