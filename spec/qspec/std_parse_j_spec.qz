## std/parse + ParseError pilot — Milestone J acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone J.
##
## Validates the std/parse arithmetic expression parser and proves the
## full effect machinery on a realistic multi-arg structured-error use
## case. Exercises:
##   - Multi-arg op (line, col, msg) via E(post) argc/argv ABI
##   - kind=2 (operation-kind) op via G-extended static fast path
##     (handler lexically resolved in with-block; inline longjmp)
##   - Multi-function `can ParseError` propagation (parse_add → parse_mul →
##     parse_primary → parse_int — throw from any level reaches the
##     outer handler)
##   - Handler's return value becomes the with-block's value
##   - std/effects typed arg decode helpers (Milestone I)
##
## Handler shape used throughout: captures error position + message via
## the std/effects helpers and returns a sentinel value (-1) so the
## with-block evaluates to that sentinel on any parse failure.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("std/parse + ParseError pilot (piezo J)") do ->
    it("parses single-digit integer") do ->
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = -1

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("7")
  end
  puts(str_from_int(r))
  return 0
end
""", "7\n")
    end

    it("parses multi-digit integer") do ->
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = -1

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("12345")
  end
  puts(str_from_int(r))
  return 0
end
""", "12345\n")
    end

    it("respects operator precedence: 1+2*3 evaluates to 7") do ->
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = -1

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("1+2*3")
  end
  puts(str_from_int(r))
  return 0
end
""", "7\n")
    end

    it("parens override precedence: (1+2)*3 evaluates to 9") do ->
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = -1

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("(1+2)*3")
  end
  puts(str_from_int(r))
  return 0
end
""", "9\n")
    end

    it("whitespace is ignored between tokens") do ->
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = -1

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("  10  -  3  *  2  ")
  end
  puts(str_from_int(r))
  return 0
end
""", "4\n")
    end

    it("unclosed paren throws parse_error with correct position") do ->
      assert_run_stdout_eq("""
import std/parse
import std/effects

def cap(op_name: Int, argc: Int, argv: Int): Int
  var line = effects::effect_arg_int(argv, 0)
  var col  = effects::effect_arg_int(argv, 1)
  var msg  = effects::effect_arg_string(argv, 2)
  puts("err@" + str_from_int(line) + ":" + str_from_int(col) + ":" + msg)
  return -1
end

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("(1+2")
  end
  puts(str_from_int(r))
  return 0
end
""", "err@1:5:expected ')'\n-1\n")
    end

    it("unexpected non-digit input throws with correct position") do ->
      assert_run_stdout_eq("""
import std/parse
import std/effects

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg  = effects::effect_arg_string(argv, 2)
  puts(msg)
  return -1
end

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("1 + ?")
  end
  puts(str_from_int(r))
  return 0
end
""", "expected integer\n-1\n")
    end

    it("division by zero throws parse_error") do ->
      assert_run_stdout_eq("""
import std/parse
import std/effects

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(effects::effect_arg_string(argv, 2))
  return -1
end

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("10 / 0")
  end
  puts(str_from_int(r))
  return 0
end
""", "division by zero\n-1\n")
    end

    it("trailing garbage after valid expression throws") do ->
      assert_run_stdout_eq("""
import std/parse
import std/effects

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(effects::effect_arg_string(argv, 2))
  return -1
end

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("1+2 garbage")
  end
  puts(str_from_int(r))
  return 0
end
""", "unexpected trailing input\n-1\n")
    end

    it("handler's return value becomes the with-block's value") do ->
      # Exercises kind=2 semantics: after parse_error fires, longjmp
      # unwinds to the with-block's catch; the handler's 99 propagates
      # out as r. No later parse code runs.
      assert_run_stdout_eq("""
import std/parse
def cap(op_name: Int, argc: Int, argv: Int): Int = 99

def main(): Int
  var r = with ParseError { parse_error: cap } do ->
    parse::parse_expr("not_a_number")
  end
  puts(str_from_int(r))
  return 0
end
""", "99\n")
    end
  end
  return qspec_main()
end
