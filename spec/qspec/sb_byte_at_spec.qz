## sb_byte_at intrinsic + __sb_index_from / __sb_starts_with_at / __sb_contains
## helper tests (B.1 Phase 5.E).
##
## Verifies that sb_byte_at returns the correct byte at a given offset and
## that the str_compat scan helpers backed by it find substrings, match
## prefixes-at-offset, and report containment without materializing the
## StringBuilder as a String.

import * from qspec
import * from str_compat

def main(): Int
  describe("sb_byte_at") do ->
    it("returns ASCII byte at index 0") do ->
      var sb = sb_new()
      sb_append(sb, "Hello")
      assert_eq(sb_byte_at(sb, 0), 'H')
    end

    it("returns ASCII byte at last index") do ->
      var sb = sb_new()
      sb_append(sb, "Quartz")
      assert_eq(sb_byte_at(sb, 5), 'z')
    end

    it("zero-extends to i64 (no sign bit set on >127)") do ->
      var sb = sb_new()
      sb_append_byte(sb, 200)
      assert_eq(sb_byte_at(sb, 0), 200)
    end

    it("works with pre-grown capacity") do ->
      var sb = sb_new_with_capacity(1024)
      sb_append(sb, "ABC")
      assert_eq(sb_byte_at(sb, 0), 'A')
      assert_eq(sb_byte_at(sb, 1), 'B')
      assert_eq(sb_byte_at(sb, 2), 'C')
    end

    it("composes with sb_size for safe iteration") do ->
      var sb = sb_new()
      sb_append(sb, "abc")
      var sum = 0
      var i = 0
      while i < sb_size(sb)
        sum += sb_byte_at(sb, i)
        i += 1
      end
      # 'a' + 'b' + 'c' = 97 + 98 + 99 = 294
      assert_eq(sum, 294)
    end
  end

  describe("__sb_index_from") do ->
    it("finds substring at offset 0") do ->
      var sb = sb_new()
      sb_append(sb, "find foo here")
      assert_eq(__sb_index_from(sb, "foo", 0), 5)
    end

    it("respects start offset") do ->
      var sb = sb_new()
      sb_append(sb, "foo bar foo baz")
      assert_eq(__sb_index_from(sb, "foo", 1), 8)
    end

    it("returns -1 when not found") do ->
      var sb = sb_new()
      sb_append(sb, "abcdef")
      assert_eq(__sb_index_from(sb, "xyz", 0), -1)
    end

    it("empty sub returns start") do ->
      var sb = sb_new()
      sb_append(sb, "abc")
      assert_eq(__sb_index_from(sb, "", 1), 1)
    end
  end

  describe("__sb_starts_with_at") do ->
    it("matches prefix at offset 0") do ->
      var sb = sb_new()
      sb_append(sb, "declare i64 @foo()")
      assert_eq(__sb_starts_with_at(sb, "declare", 0), 1)
    end

    it("matches prefix at non-zero offset") do ->
      var sb = sb_new()
      sb_append(sb, "  declare i64")
      assert_eq(__sb_starts_with_at(sb, "declare", 2), 1)
    end

    it("returns 0 on mismatch") do ->
      var sb = sb_new()
      sb_append(sb, "define i64 @bar()")
      assert_eq(__sb_starts_with_at(sb, "declare", 0), 0)
    end

    it("returns 0 when prefix runs past buffer end") do ->
      var sb = sb_new()
      sb_append(sb, "ab")
      assert_eq(__sb_starts_with_at(sb, "abcdef", 0), 0)
    end
  end

  describe("__sb_contains") do ->
    it("returns 1 when sub is present") do ->
      var sb = sb_new()
      sb_append(sb, "the quick brown fox")
      assert_eq(__sb_contains(sb, "brown"), 1)
    end

    it("returns 0 when sub is absent") do ->
      var sb = sb_new()
      sb_append(sb, "the quick brown fox")
      assert_eq(__sb_contains(sb, "purple"), 0)
    end
  end

  return qspec_main()
end
