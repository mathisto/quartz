## Regression — LAMBDA_CAPTURE_BODY_NOT_REWRITTEN_TO_ENV
##
## A lambda body that constructs an enum variant from a captured outer
## local must capture the local into the closure env. Pre-fix, the MIR
## capture walker (mir_collect_captures_walk in self-hosted/backend/mir.qz)
## had no case for NODE_ENUM_ACCESS — payloads in `children` slipped past,
## so `seq` in `-> FrameMsg::App(seq)` was never collected. The closure
## env was alloc(8) (only the fn pointer slot), the lambda body emitted
## `%seq` references with no matching alloca, and llc rejected with
## "use of undefined value '%seq'".
##
## Same hole existed in tc_collect_captures_walk (typecheck_capture.qz),
## affecting Send/Sync analysis on closures that construct enum variants
## from outer locals.
##
## Closed 2026-05-06; bug doc moved to docs/bugs/done/.

import * from qspec

enum LcbFrameMsg
  App(n: Int)
  Tick
end

enum LcbCmd
  None
  After(ms: Int, thunk: Fn(): LcbFrameMsg)
end

def lcb_make_app_thunk(seq: Int): Fn(): LcbFrameMsg
  var thunk: Fn(): LcbFrameMsg = -> LcbFrameMsg::App(seq)
  return thunk
end

def lcb_expire_cmd(seq: Int, ttl_ms: Int): LcbCmd
  var thunk: Fn(): LcbFrameMsg = -> LcbFrameMsg::App(seq)
  return LcbCmd::After(ttl_ms, thunk)
end

def lcb_thunk_value(t: Fn(): LcbFrameMsg): Int
  var msg = t()
  match msg
    LcbFrameMsg::App(n) => return n
    _ => return -1
  end
end

def lcb_cmd_thunk_value(c: LcbCmd): Int
  match c
    LcbCmd::After(ms, t) => return lcb_thunk_value(t)
    _ => return -1
  end
end

def main(): Int
  describe("lambda body captures into enum constructor") do ->
    it("captures Int into bare enum payload") do ->
      var t = lcb_make_app_thunk(42)
      assert_eq(lcb_thunk_value(t), 42)
    end

    it("distinct closures hold distinct captured values") do ->
      var t1 = lcb_make_app_thunk(7)
      var t2 = lcb_make_app_thunk(99)
      assert_eq(lcb_thunk_value(t1), 7)
      assert_eq(lcb_thunk_value(t2), 99)
    end

    it("enum-wrapped Cmd::After thunk preserves capture") do ->
      var c = lcb_expire_cmd(123, 100)
      assert_eq(lcb_cmd_thunk_value(c), 123)
    end
  end

  return qspec_main()
end
