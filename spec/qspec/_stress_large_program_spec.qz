## STRESS: Large Program Compilation Test
##
## Adversarial test: a single ~500-line Quartz program exercising many features
## simultaneously — structs, enums, generics, pattern matching, closures,
## for-in loops, string interpolation, Vec/Map, traits, impl blocks,
## compound assignment, const declarations, and multi-function composition.
##
## Tests the compiler's ability to handle real-world-sized code without
## crashes, miscompilations, or excessive resource consumption.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("stress: large program compilation") do ->
    it_pending("compiles and runs legacy ~500-line corpus (disabled pending syntax refresh)")
    if false
    it("compiles and runs ~500-line program exercising many features") do ->
      assert_run_exits("""

        ## =====================================================================
        ## Constants and configuration
        ## =====================================================================
        const MAX_ITEMS = 64
        const INITIAL_CAPACITY = 16
        const VERSION_MAJOR = 1
        const VERSION_MINOR = 0

        ## =====================================================================
        ## Structs — various sizes and nesting levels
        ## =====================================================================
        struct Point
          x: Int
          y: Int
        end

        struct Color
          r: Int
          g: Int
          b: Int
        end

        struct Rect
          origin: Point
          width: Int
          height: Int
        end

        struct Particle
          pos: Point
          vel: Point
          color: Color
          mass: Int
          alive: Bool
        end

        struct Config
          name: String
          max_particles: Int
          gravity: Int
          debug: Bool
        end

        ## =====================================================================
        ## Enums — simple, with payloads, and generic
        ## =====================================================================
        enum Direction
          North
          South
          East
          West
        end

        enum Shape
          Circle(radius: Int)
          Rectangle(width: Int, height: Int)
          Triangle(base: Int, height: Int)
          Empty
        end

        enum Maybe<T>
          Just(value: T)
          Nothing
        end

        enum Result<T, E>
          Ok(value: T)
          Err(error: E)
        end

        ## =====================================================================
        ## Associated functions and methods
        ## =====================================================================
        def Point.origin(): Point = Point { x: 0, y: 0 }

        def Point.make(x: Int, y: Int): Point = Point { x: x, y: y }

        def point_add(a: Point, b: Point): Point
          return Point { x: a.x + b.x, y: a.y + b.y }
        end

        def point_scale(p: Point, s: Int): Point
          return Point { x: p.x * s, y: p.y * s }
        end

        def point_distance_sq(a: Point, b: Point): Int
          dx = a.x - b.x
          dy = a.y - b.y
          return dx * dx + dy * dy
        end

        def rect_area(r: Rect): Int = r.width * r.height

        def rect_contains(r: Rect, p: Point): Bool
          return p.x >= r.origin.x and p.x < r.origin.x + r.width and
                 p.y >= r.origin.y and p.y < r.origin.y + r.height
        end

        def shape_area(s: Shape): Int
          match s
            Shape::Circle(r) => r * r * 3
            Shape::Rectangle(w, h) => w * h
            Shape::Triangle(b, h) => b * h / 2
            Shape::Empty => 0
          end
        end

        def shape_name(s: Shape): String
          match s
            Shape::Circle(r) => "circle"
            Shape::Rectangle(w, h) => "rectangle"
            Shape::Triangle(b, h) => "triangle"
            Shape::Empty => "empty"
          end
        end

        ## =====================================================================
        ## Generic functions
        ## =====================================================================
        def identity<T>(x: T): T = x

        def max_val<T>(a: T, b: T): T
          if a > b
            return a
          end
          return b
        end

        def min_val<T>(a: T, b: T): T
          if a < b
            return a
          end
          return b
        end

        def clamp<T>(val: T, lo: T, hi: T): T
          if val < lo
            return lo
          end
          if val > hi
            return hi
          end
          return val
        end

        def unwrap_or<T>(m: Maybe<T>, fallback: T): T
          match m
            Maybe::Just(v) => v
            Maybe::Nothing => fallback
          end
        end

        ## =====================================================================
        ## Higher-order functions and closures
        ## =====================================================================
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)

        def apply_twice(f: Fn(Int): Int, x: Int): Int = f(f(x))

        def compose(f: Fn(Int): Int, g: Fn(Int): Int, x: Int): Int = f(g(x))

        def make_adder(n: Int): Fn(Int): Int
          return x -> x + n
        end

        def make_multiplier(n: Int): Fn(Int): Int
          return x -> x * n
        end

        def make_clamper(lo: Int, hi: Int): Fn(Int): Int
          return x -> clamp(x, lo, hi)
        end

        ## Apply a function to each element of a Vec and return sum.
        def map_sum(v: Int, f: Fn(Int): Int): Int
          var total = 0
          for i in 0..vec_size(v)
            total += f(v[i])
          end
          return total
        end

        ## =====================================================================
        ## Direction logic
        ## =====================================================================
        def direction_dx(d: Direction): Int
          match d
            Direction::North => 0
            Direction::South => 0
            Direction::East => 1
            Direction::West => -1
          end
        end

        def direction_dy(d: Direction): Int
          match d
            Direction::North => 1
            Direction::South => -1
            Direction::East => 0
            Direction::West => 0
          end
        end

        def move_point(p: Point, d: Direction, steps: Int): Point
          dx = direction_dx(d) * steps
          dy = direction_dy(d) * steps
          return Point { x: p.x + dx, y: p.y + dy }
        end

        ## =====================================================================
        ## Particle system simulation
        ## =====================================================================
        def make_particle(x: Int, y: Int, vx: Int, vy: Int): Particle
          return Particle {
            pos: Point { x: x, y: y },
            vel: Point { x: vx, y: vy },
            color: Color { r: 255, g: 128, b: 0 },
            mass: 1,
            alive: true
          }
        end

        def update_particle(p: Particle, gravity: Int): Particle
          new_pos = point_add(p.pos, p.vel)
          new_vel = Point { x: p.vel.x, y: p.vel.y - gravity }
          return Particle {
            pos: new_pos,
            vel: new_vel,
            color: p.color,
            mass: p.mass,
            alive: new_pos.y >= 0
          }
        end

        ## =====================================================================
        ## String building and formatting
        ## =====================================================================
        def format_point(p: Point): String
          return "(" + str_from_int(p.x) + ", " + str_from_int(p.y) + ")"
        end

        def format_rect(r: Rect): String
          return "Rect[" + str_from_int(r.origin.x) + "," + str_from_int(r.origin.y) + " " + str_from_int(r.width) + "x" + str_from_int(r.height) + "]"
        end

        def repeat_string(s: String, n: Int): String
          var sb = sb_new()
          for i in 0..n
            sb.append(s)
          end
          result = sb.to_string()
          sb.free()
          return result
        end

        def join_ints(v: Int, sep: String): String
          var sb = sb_new()
          for i in 0..vec_size(v)
            if i > 0
              sb.append(sep)
            end
            sb.append(str_from_int(v[i]))
          end
          result = sb.to_string()
          sb.free()
          return result
        end

        ## =====================================================================
        ## Algorithms
        ## =====================================================================
        def fibonacci(n: Int): Int
          if n <= 1
            return n
          end
          var a = 0
          var b = 1
          for i in 2...n
            var tmp = a + b
            a = b
            b = tmp
          end
          return b
        end

        def factorial(n: Int): Int
          if n <= 1
            return 1
          end
          var result = 1
          for i in 2...n
            result *= i
          end
          return result
        end

        def gcd(a: Int, b: Int): Int
          var x = a
          var y = b
          while y > 0
            var t = y
            y = x % y
            x = t
          end
          return x
        end

        def is_prime(n: Int): Bool
          if n < 2
            return false
          end
          if n < 4
            return true
          end
          if n % 2 == 0
            return false
          end
          var i = 3
          while i * i <= n
            if n % i == 0
              return false
            end
            i += 2
          end
          return true
        end

        def count_primes(limit: Int): Int
          var count = 0
          for i in 2..limit
            if is_prime(i)
              count += 1
            end
          end
          return count
        end

        ## =====================================================================
        ## Vec-heavy operations
        ## =====================================================================
        def make_range(start: Int, count: Int): Int
          var v = vec_new()
          for i in 0..count
            v.push(start + i)
          end
          return v
        end

        def vec_sum(v: Int): Int
          var total = 0
          for i in 0..vec_size(v)
            total += v[i]
          end
          return total
        end

        def vec_contains(v: Int, target: Int): Bool
          for i in 0..vec_size(v)
            if v[i] == target
              return true
            end
          end
          return false
        end

        def vec_reverse_sum(v: Int): Int
          var total = 0
          var i = v.size - 1
          while i >= 0
            total += v[i]
            i -= 1
          end
          return total
        end

        ## =====================================================================
        ## Map operations
        ## =====================================================================
        def build_lookup_table(count: Int): Int
          var m = map_new()
          for i in 0..count
            m.set("key_" + str_from_int(i), i * i)
          end
          return m
        end

        ## =====================================================================
        ## Trait and impl
        ## =====================================================================
        trait Describable
          def describe(self: Int): String
            return ""
          end
        end

        extend Point with Describable
          def describe(self: Int): String
            return format_point(self)
          end
        end

        ## =====================================================================
        ## Main: exercise everything
        ## =====================================================================
        def main(): Int
          var errors = 0

          ## --- Constants ---
          if MAX_ITEMS != 64
            errors += 1
          end
          if INITIAL_CAPACITY != 16
            errors += 1
          end

          ## --- Struct construction and field access ---
          p1 = Point { x: 10, y: 20 }
          p2 = Point.make(30, 40)
          p3 = point_add(p1, p2)
          if p3.x != 40 or p3.y != 60
            errors += 1
          end

          p4 = point_scale(p1, 3)
          if p4.x != 30 or p4.y != 60
            errors += 1
          end

          dist = point_distance_sq(Point.origin(), Point.make(3, 4))
          if dist != 25
            errors += 1
          end

          ## --- Nested struct access ---
          r = Rect { origin: Point { x: 5, y: 5 }, width: 10, height: 20 }
          if rect_area(r) != 200
            errors += 1
          end
          if rect_contains(r, Point { x: 7, y: 7 }) != true
            errors += 1
          end
          if rect_contains(r, Point { x: 100, y: 100 }) != false
            errors += 1
          end

          ## --- Enum pattern matching ---
          shapes = vec_new()
          shapes.push(1)
          c = Shape::Circle(5)
          rec = Shape::Rectangle(4, 6)
          tri = Shape::Triangle(10, 8)
          emp = Shape::Empty
          if shape_area(c) != 75
            errors += 1
          end
          if shape_area(rec) != 24
            errors += 1
          end
          if shape_area(tri) != 40
            errors += 1
          end
          if shape_area(emp) != 0
            errors += 1
          end
          shapes.free()

          ## --- Generic functions ---
          if identity(42) != 42
            errors += 1
          end
          if max_val(10, 20) != 20
            errors += 1
          end
          if min_val(10, 20) != 10
            errors += 1
          end
          if clamp(5, 0, 10) != 5
            errors += 1
          end
          if clamp(-5, 0, 10) != 0
            errors += 1
          end
          if clamp(15, 0, 10) != 10
            errors += 1
          end

          ## --- Generic enum ---
          m1 = Maybe::Just(42)
          m2 = Maybe::Nothing
          if unwrap_or(m1, 0) != 42
            errors += 1
          end
          if unwrap_or(m2, 99) != 99
            errors += 1
          end

          ## --- Closures and HOFs ---
          add5 = make_adder(5)
          triple = make_multiplier(3)
          bound = make_clamper(0, 100)
          if apply(add5, 10) != 15
            errors += 1
          end
          if apply(triple, 14) != 42
            errors += 1
          end
          if apply(bound, 150) != 100
            errors += 1
          end
          if apply(bound, -10) != 0
            errors += 1
          end
          if apply_twice(add5, 10) != 20
            errors += 1
          end
          if compose(add5, triple, 10) != 35
            errors += 1
          end

          ## --- Direction enum + movement ---
          var pos = Point.origin()
          pos = move_point(pos, Direction::North, 5)
          pos = move_point(pos, Direction::East, 3)
          pos = move_point(pos, Direction::South, 2)
          if pos.x != 3 or pos.y != 3
            errors += 1
          end

          ## --- Particle simulation ---
          var part = make_particle(0, 100, 1, 5)
          if part.alive != true
            errors += 1
          end
          part = update_particle(part, 2)
          if part.pos.x != 1 or part.pos.y != 105
            errors += 1
          end
          if part.vel.y != 3
            errors += 1
          end

          ## --- String interpolation and formatting ---
          s1 = format_point(Point { x: 42, y: 99 })
          if str_size(s1) == 0
            errors += 1
          end
          s2 = repeat_string("ab", 3)
          if s2 != "ababab"
            errors += 1
          end

          ## --- Algorithms ---
          if fibonacci(10) != 55
            errors += 1
          end
          if fibonacci(0) != 0
            errors += 1
          end
          if fibonacci(1) != 1
            errors += 1
          end
          if factorial(5) != 120
            errors += 1
          end
          if factorial(1) != 1
            errors += 1
          end
          if gcd(48, 18) != 6
            errors += 1
          end
          if gcd(100, 25) != 25
            errors += 1
          end
          if is_prime(2) != true
            errors += 1
          end
          if is_prime(7) != true
            errors += 1
          end
          if is_prime(4) != false
            errors += 1
          end
          if is_prime(1) != false
            errors += 1
          end
          if count_primes(20) != 8
            errors += 1
          end

          ## --- Vec operations ---
          nums = make_range(1, 10)
          if nums.size != 10
            errors += 1
          end
          if vec_sum(nums) != 55
            errors += 1
          end
          if vec_reverse_sum(nums) != 55
            errors += 1
          end
          if vec_contains(nums, 5) != true
            errors += 1
          end
          if vec_contains(nums, 99) != false
            errors += 1
          end
          nums.free()

          ## --- Map-sum with closures ---
          data = make_range(0, 5)
          total = map_sum(data, x -> x * x)
          if total != 30
            errors += 1
          end
          data.free()

          ## --- Join ints ---
          vals = make_range(1, 4)
          joined = join_ints(vals, ",")
          if joined != "1,2,3,4"
            errors += 1
          end
          vals.free()

          ## --- Map ---
          table = build_lookup_table(10)
          match table.get("key_3")
            Some(v) => {
              if v != 9
                errors += 1
              end
            }
            _ => errors += 1
          end
          match table.get("key_7")
            Some(v) => {
              if v != 49
                errors += 1
              end
            }
            _ => errors += 1
          end
          if table.has("key_0") != true
            errors += 1
          end
          table.free()

          ## --- Compound assignment stress ---
          var counter = 0
          for i in 0..100
            counter += 1
          end
          if counter != 100
            errors += 1
          end

          var acc = 1024
          for i in 0..10
            acc /= 2
          end
          if acc != 1
            errors += 1
          end

          ## --- Nested loops with break/continue ---
          var found = 0
          for i in 0..10
            for j in 0..10
              if i * 10 + j == 42
                found = 1
                break
              end
            end
            if found
              break
            end
          end
          if found != 1
            errors += 1
          end

          var skip_count = 0
          for i in 0..20
            continue if i % 3 == 0
            skip_count += 1
          end
          if skip_count != 13
            errors += 1
          end

          ## --- While loop with complex condition ---
          var n = 1
          while n < 1000 and n % 7 != 0
            n += 1
          end
          if n != 7
            errors += 1
          end

          ## --- String operations ---
          greeting = "Hello, Quartz!"
          if str_size(greeting) != 14
            errors += 1
          end

          return errors
        end
        """, 0)
    end
    end # if false
  end
  return qspec_main()
end
