## Generic Types Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic enum definitions") do ->
    it("defines Option<T> generic enum") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def main(): Int = 0
        """, 0)
    end

    it("defines Result<T, E> generic enum with two type params") do ->
      assert_run_exits("""
        enum MyResult<T, E>
          Ok(val: Int)
          Err(err: Int)
        end
        def main(): Int = 0
        """, 0)
    end

    it("instantiates generic enum variant") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def main(): Int
          x = MyOption::Some(42)
          return 0
        end
        """, 0)
    end
  end

  describe("generic type annotations") do ->
    it("accepts Option<Int> as parameter type annotation") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def take_opt(o: MyOption<Int>): Int
          return 0
        end
        def main(): Int
          x = MyOption::Some(1)
          return take_opt(x)
        end
        """, 0)
    end

    it("accepts Option<Int> as return type annotation") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def make_opt(): MyOption<Int>
          return MyOption::Some(42)
        end
        def main(): Int
          make_opt()
          return 0
        end
        """, 0)
    end
  end

  describe("Fn type annotations") do ->
    it("accepts function type Fn(Int): Int as parameter") do ->
      assert_eq(gt_apply(gt_double, 21), 42)
    end

    it("accepts multi-arg function type Fn(Int, Int): Int") do ->
      assert_eq(gt_apply2(gt_add, 20, 22), 42)
    end
  end

  describe("vec_push with String type arg") do ->
    it("accepts String values on Vec<String>") do ->
      assert_eq(gt_vec_string_test(), 42)
    end
  end

  return qspec_main()
end

def gt_apply(f: Fn(Int): Int, x: Int): Int = f(x)
def gt_apply2(f: Fn(Int, Int): Int, a: Int, b: Int): Int = f(a, b)
def gt_double(x: Int): Int = x * 2
def gt_add(x: Int, y: Int): Int = x + y

def gt_vec_string_test(): Int
  var v = vec_new()
  v.push("hello")
  v.push("world")
  if v.size != 2
    return 0
  end
  s0 = as_string(v[0])
  s1 = as_string(v[1])
  if s0 == "hello" and s1 == "world"
    return 42
  end
  return 0
end
