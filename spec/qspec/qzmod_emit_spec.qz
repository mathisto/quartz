  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_newtypes_strict())
  if fio_exists(path)
    return 0
  end
  return 1
end

def _qe_strict_newtype_loads_into_hit(): Int
  var input = qzmod_emit::qzmod_input_new("mock/strict_nt_load")
  input.newtype_names.push("Loose")
  input.newtype_wrapped_types.push("Int")
  input.newtype_type_ids.push(1000)
  input.newtype_strict_flags.push(0)
  input.newtype_names.push("Strict")
  input.newtype_wrapped_types.push("Int")
  input.newtype_type_ids.push(1001)
  input.newtype_strict_flags.push(1)
  var dir = _qe_temp_dir("strict_nt_load")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var hit = qzmod_load::qzmod_load_module(
    dir, "mock/strict_nt_load", qzmod_format::qzmod_compiler_hash(),
    _qe_source_hash_demo(), _qe_flags_hash_demo(), _qe_empty_deps_hashes()
  )
  if hit.ok != 1
    return 0
  end
  if hit.newtype_strict_flags.size != 2
    return 0
  end
  if hit.newtype_strict_flags[0] != 0 or hit.newtype_strict_flags[1] != 1
    return 0
  end
  return 1
end

def _qe_trait_type_params_super_traits_roundtrip(): Int
  var input = qzmod_emit::qzmod_input_new("mock/trait_extras")
  input.trait_names.push("Foo")
  input.trait_method_names.push(vec_new<String>())
  input.trait_method_sigs.push(vec_new<Int>())
  input.trait_method_defaults.push(vec_new<Int>())
  input.trait_type_params.push("T")
  input.trait_super_traits.push("Display+Debug")
  var dir = _qe_temp_dir("trait_extras")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var ttp = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_traits_type_params())
  var tst = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_traits_super_traits())
  if not fio_exists(ttp) or not fio_exists(tst)
    return 0
  end
  var ttp_v = strvec_load(ttp)
  var tst_v = strvec_load(tst)
  if ttp_v.size != 1 or tst_v.size != 1
    return 0
  end
  if not str_eq(ttp_v[0], "T")
    return 0
  end
  if not str_eq(tst_v[0], "Display+Debug")
    return 0
  end
  return 1
end

def _qe_struct_field_anns_roundtrip(): Int
  var input = qzmod_emit::qzmod_input_new("mock/sfa")
  input.struct_names.push("Point")
  input.struct_field_names.push(vec_new<String>())
  input.struct_field_types.push(vec_new<Int>())
  input.struct_is_linear.push(0)
  input.struct_type_params.push("")
  var anns = vec_new<String>()
  anns.push("Int")
  anns.push("String")
  input.struct_field_annotations.push(anns)
  var dir = _qe_temp_dir("sfa")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var blob_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_structs_field_anns_blob())
  var off_path  = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_structs_field_anns_off())
  if not fio_exists(blob_path) or not fio_exists(off_path)
    return 0
  end
  var blob = vec_load(blob_path)
  var off  = vec_load(off_path)
  if off.size != 1
    return 0
  end
  if blob[off[0]] != 2
    return 0
  end
  # Pool-resolved values verified via load round-trip in qzmod_load_spec.
  return 1
end

# =============================================================================
# MIR bodies — INC.1.2 producer integration.
# =============================================================================
#
# The producer side of MIR shipping. `_tc_emit_qzmod_one` populates
# `input.mir_funcs` with handles to every MirFunc whose `origin_module`
# matches the module being emitted; `qzmod_emit_module` walks that list
# at emit time, calls `mir_pickle_function` per slot, and writes three
# parallel files: `mir_bodies.bin` (concatenated pickle blobs),
# `mir_bodies_off.bin` (per-fn start offset), and `mir_bodies_name.bin`
# (strvec parallel to offsets).
#
# These tests build synthetic MirFuncs (no MIR lowering needed), push
# their handles into `input.mir_funcs`, run `qzmod_emit_module`, then
# vec_load + strvec_load the three files back and run
# `mir_unpickle_function` to confirm round-trip parity.

## Construct a synthetic MirFunc with a tiny body — one block, one
## MIR_CONST_INT instruction, TERM_RETURN terminator. Enough surface area
## to exercise the pickle/unpickle path without depending on MIR lowering.
def _qe_synthetic_mirfunc(name: String, origin: String): MirFunc
  var f = mir::mir_new_function(name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(f, origin)
  var b = mir::mir_new_block("entry")
  var ci = mir::mir_new_instr(mir::MIR_CONST_INT, 1, mir::MIR_TYPE_INT)
  ci.operand1 = 42
  b.instructions.push(ci)
  b.term_kind = mir::TERM_RETURN
  b.term_data = 1
  b.terminated = 1
  f.blocks.push(b)
  return f
end

def _qe_mir_bodies_three_funcs_emit_three_files(): Int
  var input = qzmod_emit::qzmod_input_new("mock/mir_bodies_a")
  input.mir_funcs.push(_qe_synthetic_mirfunc("alpha", "mock/mir_bodies_a"))
  input.mir_funcs.push(_qe_synthetic_mirfunc("beta", "mock/mir_bodies_a"))
  input.mir_funcs.push(_qe_synthetic_mirfunc("gamma", "mock/mir_bodies_a"))

  var dir = _qe_temp_dir("mir_bodies_three")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )

  var blob_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies())
  var off_path  = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies_off())
  var name_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies_name())
  if not fio_exists(blob_path) or not fio_exists(off_path) or not fio_exists(name_path)
    return 0
  end

  var off = vec_load(off_path)
  var names = strvec_load(name_path)
  if off.size != 3 or names.size != 3
    return 0
  end
  if not str_eq(names[0], "alpha")
    return 0
  end
  if not str_eq(names[1], "beta")
    return 0
  end
  if not str_eq(names[2], "gamma")
    return 0
  end
  # First slot must start at offset 0; later slots monotonically increase.
  if off[0] != 0
    return 0
  end
  if off[1] <= off[0] or off[2] <= off[1]
    return 0
  end
  return 1
end

def _qe_mir_bodies_unpickle_matches(): Int
  var input = qzmod_emit::qzmod_input_new("mock/mir_bodies_b")
  var orig = _qe_synthetic_mirfunc("zeta", "mock/mir_bodies_b")
  input.mir_funcs.push(orig)

  var dir = _qe_temp_dir("mir_bodies_unpickle")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )

  var blob = vec_load(qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies()))
  var off  = vec_load(qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies_off()))
  var strings = strvec_load(qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_strings()))

  if off.size != 1 or off[0] < 0
    return 0
  end
  var maybe = qzmod_load::mir_unpickle_function(blob, off[0], strings)
  if not maybe.some?
    return 0
  end
  var got = maybe.unwrap()
  if not str_eq(got.mir_func_get_name(), "zeta")
    return 0
  end
  if not str_eq(got.mir_func_get_origin_module(), "mock/mir_bodies_b")
    return 0
  end
  if got.blocks.size != 1
    return 0
  end
  return 1
end

## Sentinel handle (0 in input.mir_funcs) lands as offset -1 + empty
## name. Important for forward-decls / bounded generics where no MIR
## body exists — the consumer needs to detect "skip" and fall back.
def _qe_mir_bodies_sentinel_writes_minus_one(): Int
  var input = qzmod_emit::qzmod_input_new("mock/mir_bodies_c")
  input.mir_funcs.push(_qe_synthetic_mirfunc("real", "mock/mir_bodies_c"))
  input.mir_funcs.push(as_type<mir::MirFunc>(0))
  input.mir_funcs.push(_qe_synthetic_mirfunc("real2", "mock/mir_bodies_c"))

  var dir = _qe_temp_dir("mir_bodies_sentinel")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )

  var off = vec_load(qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies_off()))
  var names = strvec_load(qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies_name()))
  if off.size != 3 or names.size != 3
    return 0
  end
  if off[1] != -1
    return 0
  end
  if not str_eq(names[1], "")
    return 0
  end
  if not str_eq(names[0], "real") or not str_eq(names[2], "real2")
    return 0
  end
  return 1
end

## Empty input.mir_funcs → no mir_bodies files written. Preserves
## byte-identical output_hash for modules with no shippable funcs (e.g.
## constants-only modules).
def _qe_mir_bodies_empty_no_files(): Int
  var input = qzmod_emit::qzmod_input_new("mock/mir_bodies_empty")
  var dir = _qe_temp_dir("mir_bodies_empty")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var blob_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_mir_bodies())
  if fio_exists(blob_path)
    return 0
  end
  return 1
end

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("qzmod_emit · empty input") do ->
    it("emit returns non-empty output_hash") do ->
      assert_eq(_qe_empty_emit_hash_nonempty(), 1)
    end

    it("header.txt parses back to is_valid=1") do ->
      assert_eq(_qe_empty_emit_header_parses(), 1)
    end

    it("strings.bin is absent (empty pool = section omitted)") do ->
      assert_eq(_qe_empty_emit_no_strings_bin(), 1)
    end

    it("emitted output_hash recomputes from disk to the same value") do ->
      assert_eq(_qe_output_hash_recomputes(), 1)
    end

    it("empty output_dir returns \"\" without crashing") do ->
      assert_eq_str(_qe_empty_output_dir_returns_empty(), "")
    end
  end

  describe("qzmod_emit · one function") do ->
    it("strings.bin records the function name") do ->
      assert_eq(_qe_one_func_emits_strings_bin(), 1)
    end

    it("funcs_name.bin records the single name index") do ->
      assert_eq(_qe_one_func_emits_funcs_name_bin(), 1)
    end

    it("funcs_sig_blob.bin encodes [n_params, return, required, params...]") do ->
      assert_eq(_qe_one_func_emits_sig_blob(), 1)
    end
  end

  describe("qzmod_emit · one struct") do ->
    it("structs_fields_blob.bin encodes [n_fields, is_linear, name_idx, type_id, ...]") do ->
      assert_eq(_qe_one_struct_emits_fields_blob(), 1)
    end
  end

  describe("qzmod_emit · header fields") do ->
    it("header.compiler_hash records the running compiler binary's hash") do ->
      assert_eq(_qe_header_records_compiler_hash(), 1)
    end

    it("header.source_hash records the source_hash passed in") do ->
      assert_eq(_qe_header_records_source_hash(), 1)
    end
  end

  describe("qzmod_emit · TYPES section (Phase 1.4.a)") do ->
    it("empty ptype arena emits no types_*.bin files") do ->
      assert_eq(_qe_empty_ptype_no_types_files(), 1)
    end

    it("one ptype emits types_tag.bin with the base") do ->
      assert_eq(_qe_one_ptype_emits_types_tag(), 1)
    end

    it("one ptype emits types_arg1.bin / types_arg2.bin with arg values") do ->
      assert_eq(_qe_one_ptype_emits_args(), 1)
    end

    it("output_hash recomputes deterministically with TYPES section present") do ->
      assert_eq(_qe_output_hash_recomputes_with_types(), 1)
    end
  end

  describe("qzmod_emit · ptype identity + fn_type registry (Phase 1.4.b.1)") do ->
    it("ptype_names round-trips through types_names.bin") do ->
      assert_eq(_qe_ptype_names_roundtrip(), 1)
    end

    it("empty ptype_names → types_names.bin absent") do ->
      assert_eq(_qe_empty_ptype_names_no_file(), 1)
    end

    it("fn_type_annotations round-trips through fn_type_annotations.bin") do ->
      assert_eq(_qe_fn_type_annotations_roundtrip(), 1)
    end

    it("empty fn_type_annotations → fn_type_annotations.bin absent") do ->
      assert_eq(_qe_empty_fn_type_annotations_no_file(), 1)
    end
  end

  describe("qzmod_emit · generic / super-trait / annotations (Phase 1.4.c.0)") do ->
    it("struct_type_params round-trips through structs_type_params.bin") do ->
      assert_eq(_qe_struct_type_params_roundtrip(), 1)
    end

    it("empty struct_type_params → structs_type_params.bin absent") do ->
      assert_eq(_qe_empty_struct_type_params_no_file(), 1)
    end

    it("trait_type_params + trait_super_traits round-trip in parallel") do ->
      assert_eq(_qe_trait_type_params_super_traits_roundtrip(), 1)
    end

    it("struct_field_annotations round-trip via pool-indexed blob") do ->
      assert_eq(_qe_struct_field_anns_roundtrip(), 1)
    end
  end

  describe("qzmod_emit · STRICT_NEWTYPES_QZMOD (MINOR=1)") do ->
    it("@strict newtype writes newtypes_strict.bin parallel to newtype_names") do ->
      assert_eq(_qe_strict_newtype_emits_strict_bin(), 1)
    end

    it("all-loose newtypes → newtypes_strict.bin absent (byte-identical fallback)") do ->
      assert_eq(_qe_all_loose_no_strict_bin(), 1)
    end

    it("emitted strict flag round-trips through qzmod_load_module") do ->
      assert_eq(_qe_strict_newtype_loads_into_hit(), 1)
    end
  end

  describe("qzmod_emit · MIR bodies (INC.1.2)") do ->
    it("three funcs → three offsets + three names in parallel") do ->
      assert_eq(_qe_mir_bodies_three_funcs_emit_three_files(), 1)
    end

    it("unpickled MirFunc matches original name + origin_module") do ->
      assert_eq(_qe_mir_bodies_unpickle_matches(), 1)
    end

    it("sentinel handle (0) lands as offset = -1 + empty name") do ->
      assert_eq(_qe_mir_bodies_sentinel_writes_minus_one(), 1)
    end

    it("empty input.mir_funcs writes no mir_bodies files (byte-identical fallback)") do ->
      assert_eq(_qe_mir_bodies_empty_no_files(), 1)
    end
  end

  return qspec_main()
end
