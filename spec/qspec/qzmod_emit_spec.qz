# =============================================================================
# Phase 1.4.a — TYPES section round-trip
# =============================================================================

## Build an input with one synthetic ptype entry: a fake `Option<Int>` —
## base=TYPE_OPTION (10), arg1=TYPE_INT (1), arg2=0. Numbers are illustrative;
## the emit path is type-agnostic for Phase 1.4.a.
def _qe_one_ptype_input(): qzmod_emit::QzmodEmitInput
  var input = qzmod_emit::qzmod_input_new("mock/one_ptype")
  input.ptype_bases.push(10)  # mock TYPE_OPTION
  input.ptype_arg1s.push(1)   # mock TYPE_INT
  input.ptype_arg2s.push(0)
  return input
end

def _qe_empty_ptype_no_types_files(): Int
  var input = qzmod_emit::qzmod_input_new("mock/empty_ptype")
  var dir = _qe_temp_dir("empty_ptype")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var tag_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_types_tag())
  if fio_exists(tag_path)
    return 0
  end
  return 1
end

def _qe_one_ptype_emits_types_tag(): Int
  var input = _qe_one_ptype_input()
  var dir = _qe_temp_dir("one_ptype_tag")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var tag_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_types_tag())
  if not fio_exists(tag_path)
    return 0
  end
  var tags = vec_load(tag_path)
  if tags.size != 1
    return 0
  end
  if tags[0] != 10
    return 0
  end
  return 1
end

def _qe_one_ptype_emits_args(): Int
  var input = _qe_one_ptype_input()
  var dir = _qe_temp_dir("one_ptype_args")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var arg1_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_types_arg1())
  var arg2_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_types_arg2())
  if not fio_exists(arg1_path)
    return 0
  end
  if not fio_exists(arg2_path)
    return 0
  end
  var a1 = vec_load(arg1_path)
  var a2 = vec_load(arg2_path)
  if a1.size != 1 or a2.size != 1
    return 0
  end
  if a1[0] != 1 or a2[0] != 0
    return 0
  end
  return 1
end


## Output hash recomputes deterministically with TYPES section present.
def _qe_output_hash_recomputes_with_types(): Int
  var input = _qe_one_ptype_input()
  var dir = _qe_temp_dir("output_hash_with_types")
  var emitted = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var recomputed = qzmod_format::qzmod_compute_output_hash(dir)
  if str_eq(emitted, recomputed)
    return 1
  end
  return 0
end

