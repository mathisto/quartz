# =============================================================================
# STRICT_NEWTYPES_QZMOD — per-newtype `@strict` flag round-trip
# =============================================================================
#
# Three properties, mirroring the funcs_effect_state byte-identical pattern:
#   1. `@strict newtype` writes newtypes_strict.bin with the flags vec.
#   2. All-loose newtypes → file absent (output_hash byte-identical to
#      pre-STRICT_NEWTYPES_QZMOD modules).
#   3. The bytes survive `qzmod_load_module` and land in
#      `QzmodLoadResult.newtype_strict_flags` parallel to newtype_names.

def _qe_strict_newtype_emits_strict_bin(): Int
  var input = qzmod_emit::qzmod_input_new("mock/strict_nt")
  input.newtype_names.push("Loose")
  input.newtype_wrapped_types.push("Int")
  input.newtype_type_ids.push(1000)
  input.newtype_strict_flags.push(0)
  input.newtype_names.push("Strict")
  input.newtype_wrapped_types.push("Int")
  input.newtype_type_ids.push(1001)
  input.newtype_strict_flags.push(1)
  var dir = _qe_temp_dir("strict_nt")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_newtypes_strict())
  if not fio_exists(path)
    return 0
  end
  var loaded = vec_load(path)
  if loaded.size != 2
    return 0
  end
  if loaded[0] != 0 or loaded[1] != 1
    return 0
  end
  return 1
end

def _qe_all_loose_no_strict_bin(): Int
  var input = qzmod_emit::qzmod_input_new("mock/loose_only_nt")
  input.newtype_names.push("LooseA")
  input.newtype_wrapped_types.push("Int")
  input.newtype_type_ids.push(1000)
