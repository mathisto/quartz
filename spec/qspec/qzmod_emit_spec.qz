## qzmod_emit — Phase 1.1 round-trip acceptance.
##
## Per design memo `docs/design/QZMOD_FORMAT.md`, Phase 1.1 ships the
## bytes-on-disk encoder. The acceptance bar is structural:
##   1. Empty input emits header.txt only (no .bin files).
##   2. Populated input emits the appropriate per-section .bin files.
##   3. Computed output_hash recomputes to the same value (recompute via
##      qzmod_compute_output_hash matches header.output_hash) — backdating
##      property holds (Principle #3).
##   4. Empty-output-dir parameter returns "" (silent advisory failure —
##      Principle #6).
##
## Type-ID semantics for Phase 1.1: emit stores producer-global tc.registry
## IDs verbatim. Cross-module local-type-table indirection is Phase 1.2
## work. The round-trip in this spec is same-process, so the IDs are valid
## as written.

import * from qspec
import qzmod_format
import qzmod_emit
import qzmod_load
import mir
import file_io
import * from str_compat

# =============================================================================
# Per-test temp directory derivation. Each `it` block uses a unique label,
# so collisions inside a single qspec run are impossible. `mkdir` is
# idempotent on the cache root, so reruns work without cleanup.
# =============================================================================

def _qe_temp_root(): String = "/tmp/qzmod_emit_test"

def _qe_temp_dir(label: String): String
  return "#{_qe_temp_root()}/#{label}"
end

# =============================================================================
# Helpers — empty deps + flags-hash for header round-trip
# =============================================================================

def _qe_empty_deps_names(): Vec<String> = vec_new<String>()
def _qe_empty_deps_hashes(): Vec<String> = vec_new<String>()

def _qe_flags_hash_demo(): String = "1234567890abcdef"
def _qe_source_hash_demo(): String = "abcdef0123456789"

## Construct a one-function input view. Demo function `foo` takes
## (Int, String) → Int with required=2.
def _qe_one_func_input(): qzmod_emit::QzmodEmitInput
  var input = qzmod_emit::qzmod_input_new("mock/one_func")
  input.func_names.push("foo")
  var p_types = vec_new()
  p_types.push(1)  # mock TYPE_INT
  p_types.push(2)  # mock TYPE_STRING
  input.func_param_types.push(p_types)
  input.func_return_types.push(1)  # mock TYPE_INT
  input.func_required_counts.push(2)
  return input
end

# =============================================================================
# Test bodies — each returns an Int/String that the assert API consumes.
# =============================================================================

def _qe_empty_emit_hash_nonempty(): Int
  var input = qzmod_emit::qzmod_input_new("mock/empty")
  var dir = _qe_temp_dir("empty")
  var hash = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  if str_byte_len(hash) > 0
    return 1
  end
  return 0
end

def _qe_empty_emit_header_parses(): Int
  var input = qzmod_emit::qzmod_input_new("mock/empty_hdr")
  var dir = _qe_temp_dir("empty_hdr")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var header_path = qzmod_format::qzmod_header_path(dir)
  if not fio_exists(header_path)
    return 0
  end
  var content = fio_read(header_path)
  var hdr = qzmod_format::qzmod_header_parse(content)
  return hdr.is_valid
end

def _qe_empty_emit_no_strings_bin(): Int
  var input = qzmod_emit::qzmod_input_new("mock/empty_files")
  var dir = _qe_temp_dir("empty_files")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  # Empty input → string pool empty → strings.bin absent.
  var strings_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_strings())
  if fio_exists(strings_path)
    return 0
  end
  return 1
end

## Output-hash determinism: header records `qzmod_compute_output_hash(dir)`;
## a fresh recomputation must equal that value. This is Principle #3
## (output-fingerprint invalidation) in mechanical form.
def _qe_output_hash_recomputes(): Int
  var input = qzmod_emit::qzmod_input_new("mock/hash_recompute")
  var dir = _qe_temp_dir("hash_recompute")
  var emitted_hash = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var recomputed = qzmod_format::qzmod_compute_output_hash(dir)
  if str_eq(emitted_hash, recomputed)
    return 1
  end
  return 0
end

def _qe_empty_output_dir_returns_empty(): String
  var input = qzmod_emit::qzmod_input_new("mock/empty_dir")
  return qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    ""
  )
end

def _qe_one_func_emits_strings_bin(): Int
  var input = _qe_one_func_input()
  var dir = _qe_temp_dir("one_func")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var strings_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_strings())
  if not fio_exists(strings_path)
    return 0
  end
  var loaded = strvec_load(strings_path)
  if loaded.size == 0
    return 0
  end
  # First interned string should be the function name.
  if str_eq(loaded[0], "foo")
    return 1
  end
  return 0
end

def _qe_one_func_emits_funcs_name_bin(): Int
  var input = _qe_one_func_input()
  var dir = _qe_temp_dir("one_func_name")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var names_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_funcs_name())
  if not fio_exists(names_path)
    return 0
  end
  var name_idx = vec_load(names_path)
  if name_idx.size != 1
    return 0
  end
  # The single function's name index points to slot 0 of strings.bin.
  if name_idx[0] != 0
    return 0
  end
  return 1
end

def _qe_one_func_emits_sig_blob(): Int
  var input = _qe_one_func_input()
  var dir = _qe_temp_dir("one_func_sig")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var sig_blob_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_funcs_sig_blob())
  if not fio_exists(sig_blob_path)
    return 0
  end
  var blob = vec_load(sig_blob_path)
  # Encoding: [n_params, return_type, required_count, param0, param1]
  # For our one fn: [2, 1, 2, 1, 2]
  if blob.size != 5
    return 0
  end
  if blob[0] != 2
    return 0
  end
  if blob[1] != 1
    return 0
  end
  if blob[2] != 2
    return 0
  end
  if blob[3] != 1
    return 0
  end
  if blob[4] != 2
    return 0
  end
  return 1
end

## A struct with two fields produces structs_name.bin + structs_fields_blob.bin
## + structs_fields_off.bin. Field encoding: [n_fields, is_linear,
## field0_name_idx, field0_type, field1_name_idx, field1_type].
def _qe_one_struct_emits_fields_blob(): Int
  var input = qzmod_emit::qzmod_input_new("mock/one_struct")
  input.struct_names.push("Point")
  var fnames = vec_new<String>()
  fnames.push("x")
  fnames.push("y")
  input.struct_field_names.push(fnames)
  var ftypes = vec_new()
  ftypes.push(1)  # TYPE_INT
  ftypes.push(1)  # TYPE_INT
  input.struct_field_types.push(ftypes)
  input.struct_is_linear.push(0)

  var dir = _qe_temp_dir("one_struct")
  var _h = qzmod_emit::qzmod_emit_module(
    input,
    _qe_source_hash_demo(), _qe_flags_hash_demo(),
    _qe_empty_deps_names(), _qe_empty_deps_hashes(),
    dir
  )
  var fields_path = qzmod_format::qzmod_section_path(dir, qzmod_format::qzmod_file_structs_fields_blob())
  if not fio_exists(fields_path)
    return 0
  end
  var blob = vec_load(fields_path)
  # Pool ordering: "Point" (0), "x" (1), "y" (2).
  # Expected: [2, 0, 1, 1, 2, 1]
  if blob.size != 6
    return 0
  end
  if blob[0] != 2
    return 0
  end
  if blob[1] != 0
    return 0
  end
  if blob[2] != 1
    return 0
  end
  if blob[3] != 1
    return 0
  end
  if blob[4] != 2
    return 0
  end
  if blob[5] != 1
    return 0
  end
  return 1
end

