## std/tui/widgets/confirm behaviour tests.
##
## Coverage:
##   - Constructor defaults (Yes selected; "Yes" / "No" labels)
##   - Builders (with_labels, with_default, with_styles)
##   - Key dispatch:
##     - Esc → Cancelled
##     - Enter on Yes / No → Confirmed / Cancelled
##     - Y / y / N / n hotkeys (select AND commit)
##     - Left / h → Yes (left button), Right / l → No (right button)
##     - Unhandled → Idle
##   - confirm_view contains prompt + both labels
##   - Selection toggle visible in view
##   - confirm_overlay returns a sized Overlay

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/confirm as cf
import std/tui/widgets/overlay as ov

enum CFMsg
  Noop
end

# Helper: drive a key through confirm_update and return the triple's
# state for assertion. The match-arm-on-event pattern lives in each
# test rather than a shared helper to keep the qspec output readable.
def feed_state(c: cf::Confirm, code: Int): cf::Confirm
  var msg: tui::FrameMsg<CFMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = cf::confirm_update(c, msg)
  return triple.0
end

# ============================================================
# Constructors / builders
# ============================================================

def test_new_defaults_yes_selected(): Void
  var c = cf::confirm_new("Quit?")
  if c.selected
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  assert_eq_str(c.yes_label, "Yes")
  assert_eq_str(c.no_label, "No")
  assert_eq_str(c.prompt, "Quit?")
end

def test_with_labels_replaces_buttons(): Void
  var c = cf::confirm_with_labels(cf::confirm_new("Discard run?"), "Discard", "Keep")
  assert_eq_str(c.yes_label, "Discard")
  assert_eq_str(c.no_label, "Keep")
end

def test_with_default_no_selected(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Reset?"), false)
  if c.selected
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_with_styles_replaces_styles_only(): Void
  var custom = cf::ConfirmStyles {
    prompt:          Style.new().bold(),
    button:          Style.new(),
    button_selected: Style.new().underline()
  }
  var c = cf::confirm_with_styles(cf::confirm_new("Hi?"), custom)
  assert_eq_str(c.prompt, "Hi?")
  assert_eq_str(c.yes_label, "Yes")
end

# ============================================================
# Key dispatch — events
# ============================================================

def assert_event(c: cf::Confirm, code: Int, want_confirmed: Bool, want_cancelled: Bool): Void
  var msg: tui::FrameMsg<CFMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = cf::confirm_update(c, msg)
  var ev = triple.2
  match ev
    cf::ConfirmEvent::Confirmed => {
      if want_confirmed
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    }
    cf::ConfirmEvent::Cancelled => {
      if want_cancelled
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    }
    cf::ConfirmEvent::Idle => {
      if want_confirmed or want_cancelled
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    }
  end
end

def test_esc_emits_cancelled_when_yes_selected(): Void
  var c = cf::confirm_new("Q?")
  assert_event(c, 27, false, true)
end

def test_esc_emits_cancelled_when_no_selected(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  assert_event(c, 27, false, true)
end

def test_enter_on_yes_emits_confirmed(): Void
  var c = cf::confirm_new("Q?")  # default Yes
  assert_event(c, terminal::KEY_ENTER(), true, false)
end

def test_enter_on_no_emits_cancelled(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  assert_event(c, terminal::KEY_ENTER(), false, true)
end

def test_y_uppercase_hotkey_confirms_from_no(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  assert_event(c, 'Y', true, false)
end

def test_y_lowercase_hotkey_confirms(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  assert_event(c, 'y', true, false)
end

def test_n_uppercase_hotkey_cancels_from_yes(): Void
  var c = cf::confirm_new("Q?")
  assert_event(c, 'N', false, true)
end

def test_n_lowercase_hotkey_cancels(): Void
  var c = cf::confirm_new("Q?")
  assert_event(c, 'n', false, true)
end

def test_left_emits_idle_when_already_yes(): Void
  # Default starts at Yes; Left moves to / stays at Yes — Idle either way.
  var c = cf::confirm_new("Q?")
  assert_event(c, terminal::KEY_LEFT(), false, false)  # Idle
end

def test_right_emits_idle_when_already_no(): Void
  var c = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  assert_event(c, terminal::KEY_RIGHT(), false, false)  # Idle
end

def test_unhandled_key_emits_idle(): Void
  var c = cf::confirm_new("Q?")
  # 'Q' itself isn't a hotkey — should be Idle
  assert_event(c, 'Q', false, false)
end

# ============================================================
# Key dispatch — selection state changes
# ============================================================

def test_left_moves_selection_to_yes(): Void
  # Start at No; Left lands on Yes (left button).
  var start = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  var c = feed_state(start, terminal::KEY_LEFT())
  if c.selected
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_h_moves_selection_to_yes(): Void
  var start = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  var c = feed_state(start, 'h')
  if c.selected
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_right_moves_selection_to_no(): Void
  # Start at Yes (default); Right lands on No (right button).
  var c = feed_state(cf::confirm_new("Q?"), terminal::KEY_RIGHT())
  if c.selected
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_l_moves_selection_to_no(): Void
  var c = feed_state(cf::confirm_new("Q?"), 'l')
  if c.selected
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_y_hotkey_sets_selection_to_yes_even_from_no(): Void
  var start = cf::confirm_with_default(cf::confirm_new("Q?"), false)
  var c = feed_state(start, 'y')
  if c.selected
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_n_hotkey_sets_selection_to_no_even_from_yes(): Void
  var c = feed_state(cf::confirm_new("Q?"), 'N')
  if c.selected
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

# ============================================================
# View + overlay shape
# ============================================================

def test_view_contains_prompt(): Void
  var c = cf::confirm_new("Discard run progress?")
  var v = cf::confirm_view(c)
  if str_contains(v, "Discard run progress?")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_view_contains_both_button_labels(): Void
  var c = cf::confirm_with_labels(cf::confirm_new("Q?"), "Quit", "Stay")
  var v = cf::confirm_view(c)
  if str_contains(v, "Quit") and str_contains(v, "Stay")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_overlay_has_nonzero_dimensions(): Void
  var c = cf::confirm_new("Q?")
  var o = cf::confirm_overlay(c)
  if o.width > 0 and o.height > 0
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def main(): Int
  describe("constructors and builders") do ->
    it("new() defaults to Yes selected") do ->
      test_new_defaults_yes_selected()
    end
    it("with_labels replaces button labels") do ->
      test_with_labels_replaces_buttons()
    end
    it("with_default(false) selects No") do ->
      test_with_default_no_selected()
    end
    it("with_styles preserves prompt and labels") do ->
      test_with_styles_replaces_styles_only()
    end
  end

  describe("key dispatch — events") do ->
    it("Esc emits Cancelled when Yes is selected") do ->
      test_esc_emits_cancelled_when_yes_selected()
    end
    it("Esc emits Cancelled when No is selected") do ->
      test_esc_emits_cancelled_when_no_selected()
    end
    it("Enter on Yes emits Confirmed") do ->
      test_enter_on_yes_emits_confirmed()
    end
    it("Enter on No emits Cancelled") do ->
      test_enter_on_no_emits_cancelled()
    end
    it("Y hotkey emits Confirmed from No") do ->
      test_y_uppercase_hotkey_confirms_from_no()
    end
    it("y hotkey emits Confirmed") do ->
      test_y_lowercase_hotkey_confirms()
    end
    it("N hotkey emits Cancelled from Yes") do ->
      test_n_uppercase_hotkey_cancels_from_yes()
    end
    it("n hotkey emits Cancelled") do ->
      test_n_lowercase_hotkey_cancels()
    end
    it("Left arrow emits Idle (selection adjusts only)") do ->
      test_left_emits_idle_when_already_yes()
    end
    it("Right arrow emits Idle (selection adjusts only)") do ->
      test_right_emits_idle_when_already_no()
    end
    it("unhandled key emits Idle") do ->
      test_unhandled_key_emits_idle()
    end
  end

  describe("key dispatch — selection state") do ->
    it("Left moves selection to Yes (left button)") do ->
      test_left_moves_selection_to_yes()
    end
    it("h moves selection to Yes (left button)") do ->
      test_h_moves_selection_to_yes()
    end
    it("Right moves selection to No (right button)") do ->
      test_right_moves_selection_to_no()
    end
    it("l moves selection to No (right button)") do ->
      test_l_moves_selection_to_no()
    end
    it("y hotkey sets selection to Yes (from No)") do ->
      test_y_hotkey_sets_selection_to_yes_even_from_no()
    end
    it("N hotkey sets selection to No (from Yes)") do ->
      test_n_hotkey_sets_selection_to_no_even_from_yes()
    end
  end

  describe("view and overlay") do ->
    it("view contains the prompt text") do ->
      test_view_contains_prompt()
    end
    it("view contains both button labels") do ->
      test_view_contains_both_button_labels()
    end
    it("overlay has non-zero width and height") do ->
      test_overlay_has_nonzero_dimensions()
    end
  end

  return qspec_main()
end
