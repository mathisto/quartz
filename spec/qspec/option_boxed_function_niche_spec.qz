## Option<Function/closure> niche-representation tests (item 6.4c).
##
## Under the 6.4c flip, Function joins the niche: a Quartz `Function` value is a
## SINGLE word — either a bare function pointer (low bit 0, a real code address) or
## a tagged closure `env|1` (low bit 1). Neither is ever 0, so `None` = 0 is an
## unambiguous extra inhabitant. Some(f) = f verbatim (single word, no tag box).
##
## THE KEY SOUNDNESS CHECK (closure smoke): the niche payload-bind is IDENTITY (the
## word is stored/loaded verbatim). This spec PROVES the low-bit closure tag + the
## captured environment survive the Option round-trip — a CAPTURING closure pushed
## into Some(...) and pulled back out must still carry its `env|1` tag and CALL
## with its captured value intact. If the niche corrupted the low bit, the recovered
## value would be read as a bare fn-ptr and either crash or call the wrong code.
##
## Tuple stays TAGGED (separate gate, deferred) — locked at the IR level, not here.
import * from qspec

def make_adder(n: Int): Fn(Int): Int
  # Captures `n` => env|1 tagged closure (low bit 1).
  return x: Int -> x + n
end

def bare_double(x: Int): Int
  return x * 2
end

def roundtrip_fn(o: Option<Fn(Int): Int>): Option<Fn(Int): Int>
  return o
end

def main(): Int
  describe("Option<Fn(Int):Int> niche — captured closure round-trip (THE key test)") do ->
    it("Some(capturing closure) is Some") do ->
      var o: Option<Fn(Int): Int> = option_some(make_adder(100))
      assert_eq(o is Some, 1)
    end
    it("unwrap recovers the closure and it CALLS with captured env intact") do ->
      var o: Option<Fn(Int): Int> = option_some(make_adder(100))
      var f = o.unwrap()
      # 100 (captured) + 5 = 105 — proves env|1 tag + captured n survived the niche.
      assert_eq(f(5), 105)
    end
    it("match Some(g) reaches the closure and calls it") do ->
      var o: Option<Fn(Int): Int> = option_some(make_adder(7))
      var r = match o
        Some(g) => g(3)
        None => -1
      end
      # 7 + 3 = 10
      assert_eq(r, 10)
    end
    it("two distinct closures keep independent captured envs through Some") do ->
      var a: Option<Fn(Int): Int> = option_some(make_adder(1))
      var b: Option<Fn(Int): Int> = option_some(make_adder(1000))
      var fa = a.unwrap()
      var fb = b.unwrap()
      # 1+10=11 and 1000+10=1010 — no env crosstalk through the niche.
      assert_eq(fa(10) + fb(10), 1021)
    end
  end

  describe("Option<Fn(Int):Int> niche — bare (non-capturing) function value") do ->
    it("Some(bare fn-ptr) is Some and calls correctly") do ->
      var o: Option<Fn(Int): Int> = option_some(bare_double)
      var h = o.unwrap()
      assert_eq(h(21), 42)
    end
    it("match Some(bare fn) calls the function") do ->
      var o: Option<Fn(Int): Int> = option_some(bare_double)
      var r = match o
        Some(h) => h(9)
        None => -1
      end
      assert_eq(r, 18)
    end
  end

  describe("Option<Fn(Int):Int> niche — None") do ->
    it("None is None true") do ->
      var o: Option<Fn(Int): Int> = option_none()
      assert_eq(o is None, 1)
    end
    it("None is Some false") do ->
      var o: Option<Fn(Int): Int> = option_none()
      assert_eq(o is Some, 0)
    end
    it("match None fires the None arm") do ->
      var o: Option<Fn(Int): Int> = option_none()
      var r = match o
        Some(g) => g(0)
        None => 999
      end
      assert_eq(r, 999)
    end
  end

  describe("Option<Fn(Int):Int> niche — round-trip through arg + return") do ->
    it("Some(closure) survives a call boundary and still calls with env") do ->
      var o = roundtrip_fn(option_some(make_adder(50)))
      var f = o.unwrap()
      assert_eq(f(8), 58)
    end
    it("None survives a call boundary as None") do ->
      var o = roundtrip_fn(option_none())
      assert_eq(o is None, 1)
    end
  end

  describe("Vec<Option<Fn(Int):Int>> niche — element push/read parity") do ->
    it("push Some(closure) and None, read both back correctly") do ->
      var v: Vec<Option<Fn(Int): Int>> = vec_new()
      v.push(option_some(make_adder(20)))
      v.push(option_none())
      # element 0 = Some(closure): call with captured 20.
      var e0 = v[0]
      var f0 = e0.unwrap()
      assert_eq(f0(5), 25)
      # element 1 = None.
      assert_eq(v[1] is None, 1)
    end
    it("Some element is Some, None element is not Some") do ->
      var v: Vec<Option<Fn(Int): Int>> = vec_new()
      v.push(option_some(bare_double))
      v.push(option_none())
      assert_eq(v[0] is Some, 1)
      assert_eq(v[1] is Some, 0)
    end
  end

  describe("Option<Fn(Int):Int> niche — UN-ANNOTATED local") do ->
    it("var f = option_some(closure) reads is Some (no annotation)") do ->
      var f = option_some(make_adder(3))
      assert_eq(f is Some, 1)
    end
    it("un-annotated some? predicate is true for Some(closure)") do ->
      var f = option_some(make_adder(3))
      assert_eq(f.some?, 1)
    end
    # NOTE: calling THROUGH an un-annotated `f.unwrap()` (e.g. `var g = f.unwrap();
    # g(4)`) is a typecheck INFERENCE gap, not a niche bug — `option_some(closure)`
    # without an `Option<Fn(...)>` annotation doesn't propagate the Fn payload into
    # unwrap's return type, so the result isn't callable. Same on the golden binary
    # (representation-independent). Annotated unwrap-and-call is covered above.
  end

  return qspec_main()
end
