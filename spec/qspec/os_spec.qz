## std/os.qz — typed wrappers over the OS intrinsics.
##
## Covers only hermetic, deterministic behavior:
##   - os_argc()/os_arg(0) sanity
##   - os_setenv -> os_getenv -> os_env round-trip
##   - os_env of an unset var is None
##   - os_cwd non-empty
##   - os_system("true") == 0
##
## Booleans and Option<String> results are folded to Int via named helpers so
## they can be checked with assert_eq (the qspec Int matcher).
## os_exit is deliberately NOT exercised (it would kill the test process); the
## only os_chdir touched is a no-op chdir back to os_cwd().

import * from qspec
import os

def b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def opt_is_some(o: Option<String>): Int
  match o
    Option::Some(_) => return 1
    Option::None => return 0
  end
end

def opt_value_or_empty(o: Option<String>): String
  match o
    Option::Some(v) => return v
    Option::None => return ""
  end
end

def main(): Int
  describe("os args") do ->
    it("os_argc is at least 1") do ->
      assert_eq(b2i(os_argc() >= 1), 1)
    end

    it("os_arg(0) is non-empty") do ->
      assert_eq(b2i(os_arg(0).size > 0), 1)
    end

    it("os_args size matches os_argc") do ->
      assert_eq(os_args().size, os_argc())
    end
  end

  describe("os environment") do ->
    it("os_setenv succeeds") do ->
      assert_eq(b2i(os_setenv("QZ_OS_SPEC_VAR", "hi")), 1)
    end

    it("os_getenv reads back a set var") do ->
      var _ok = os_setenv("QZ_OS_SPEC_VAR", "hi")
      assert_eq_str(os_getenv("QZ_OS_SPEC_VAR"), "hi")
    end

    it("os_env is Some for a set var") do ->
      var _ok = os_setenv("QZ_OS_SPEC_VAR", "hi")
      assert_eq(opt_is_some(os_env("QZ_OS_SPEC_VAR")), 1)
    end

    it("os_env yields the set value") do ->
      var _ok = os_setenv("QZ_OS_SPEC_VAR", "hi")
      assert_eq_str(opt_value_or_empty(os_env("QZ_OS_SPEC_VAR")), "hi")
    end

    it("os_env is None for an unset var") do ->
      assert_eq(opt_is_some(os_env("QZ_DEFINITELY_UNSET_XYZ_9999")), 0)
    end
  end

  describe("os cwd") do ->
    it("os_cwd is non-empty") do ->
      assert_eq(b2i(os_cwd().size > 0), 1)
    end

    it("os_chdir to current cwd is a no-op success") do ->
      assert_eq(b2i(os_chdir(os_cwd())), 1)
    end
  end

  describe("os system") do ->
    it("os_system true returns 0") do ->
      assert_eq(os_system("true"), 0)
    end
  end

  return qspec_main()
end
