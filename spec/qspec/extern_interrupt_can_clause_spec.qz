## extern-def `can` clause parser acceptance
##
## Closes EXTERN_INTERRUPT_CAN_CLAUSE_PARSE_REJECT.md (filed 2026-04-30
## during Phase E of the Sched-effect work, deferred from A.5b).
##
## The parser accepts `can E` after the return type of `extern "<conv>" def`
## with-body forms (matching the regular-def path). Bodyless extern decls
## reject the clause — there's no body to constrain.
##
## NOTE: x86-interrupt headers are exercised via assert_compile_succeeds
## subprocess (parse-only, doesn't reach codegen) because the host arm64
## backend rejects the x86-interrupt calling convention at LLVM-IR
## codegen time. Effect-row attachment happens at parse → AST → typecheck,
## all of which the subprocess reaches before the failing codegen stage.
## extern "C" with-body defs run end-to-end fine.

import * from qspec

# extern "C" with-body — runs end-to-end. Effect row makes it through
# parse and typecheck.
extern "C" def __test_extern_c_with_body(x: Int): Int can Sched
  return x
end

def main(): Int
  describe("extern def with can clause") do ->
    it("extern C with body and can clause compiles and links") do ->
      assert_eq(__test_extern_c_with_body(42), 42)
    end

    it("extern x86-interrupt with single can label parses") do ->
      assert_compile_succeeds("""
        extern \"x86-interrupt\" def my_isr(frame: Int): Void can Sched
          return
        end

        def main(): Int
          return 0
        end
      """)
    end

    it("extern x86-interrupt with multi can labels parses") do ->
      assert_compile_succeeds("""
        extern \"x86-interrupt\" def my_isr(frame: Int): Void can Sched, FileIo
          return
        end

        def main(): Int
          return 0
        end
      """)
    end

    it("extern x86-interrupt with bare can parses") do ->
      assert_compile_succeeds("""
        extern \"x86-interrupt\" def my_isr(frame: Int): Void can
          return
        end

        def main(): Int
          return 0
        end
      """)
    end

    it("extern x86-interrupt with tail-variable can parses") do ->
      assert_compile_succeeds("""
        extern \"x86-interrupt\" def my_isr(frame: Int): Void can Sched | e
          return
        end

        def main(): Int
          return 0
        end
      """)
    end

    it("bodyless extern with can clause is rejected") do ->
      assert_compile_fails("""
        extern \"C\" def imported_fn(x: Int): Int can Sched

        def main(): Int
          return 0
        end
      """)
    end

    it("bodyless extern without can clause still works") do ->
      assert_compile_succeeds("""
        extern \"C\" def imported_fn(x: Int): Int

        def main(): Int
          return 0
        end
      """)
    end
  end
  return qspec_main()
end
