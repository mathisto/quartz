## Stdlib Trait Implementation Tests
##
## Contract:
##   1. Show for JsonValue produces json_stringify output
##   2. Show for TomlValue produces toml_stringify_value output
##   3. Serializable for JsonValue returns self
##   4. Eq for String uses str_eq via UFCS
##   5. Eq for Bytes uses element-wise comparison

import * from qspec
import * from json
import * from toml/value
import * from toml/stringify
import * from traits
# import * from bytes

# -- Show for JsonValue --

def show_json_null(): String
  v = json_null()
  return v.show()
end

def show_json_number(): String
  v = json_number(42)
  return v.show()
end

def show_json_string(): String
  v = json_string("hello")
  return v.show()
end

def show_json_bool(): String
  v = json_bool(1)
  return v.show()
end

# -- Show for TomlValue --

def show_toml_string(): String
  return toml_stringify_value(TomlValue::String("hello"))
end

def show_toml_int(): String
  return toml_stringify_value(TomlValue::Int(42))
end

def show_toml_bool(): String
  return toml_stringify_value(TomlValue::Bool(true))
end

# -- Eq for String --

def string_eq_test(): Int
  a = "hello"
  b = "hello"
  c = "world"
  var result = 0
  if a.op_eq(b)
    result += 1
  end
  if a.op_eq(c) == false
    result += 10
  end
  return result
end

# Bytes Eq test is in a separate file to avoid cross-import SIGSEGV

def main(): Int
  describe("stdlib trait implementations") do ->
    it("Show for JsonValue: null") do ->
      assert_eq_str(show_json_null(), "null")
    end

    it("Show for JsonValue: number") do ->
      assert_eq_str(show_json_number(), "42")
    end

    it("Show for JsonValue: string") do ->
      assert_eq_str(show_json_string(), "\"hello\"")
    end

    it("Show for JsonValue: bool") do ->
      assert_eq_str(show_json_bool(), "true")
    end

    it("Show for TomlValue: string") do ->
      assert_eq_str(show_toml_string(), "\"hello\"")
    end

    it("Show for TomlValue: int") do ->
      assert_eq_str(show_toml_int(), "42")
    end

    it("Show for TomlValue: bool") do ->
      assert_eq_str(show_toml_bool(), "true")
    end

    it("Eq for String via trait") do ->
      assert_eq(string_eq_test(), 11)
    end

    # Bytes test deferred — bytes+toml combined import causes SIGSEGV
    # it("Eq for Bytes via trait") do ->
    #   assert_eq(bytes_eq_test(), 11)
    # end
  end

  return qspec_main()
end
