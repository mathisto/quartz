# Warn-only coverage for B.15d/N3.1 step-4 item 5a — the STRUCTURAL bare-Int
# wall audit. Two NEW syntactic positions join the existing let/return/call-arg
# QZ0214/QZ0215 trio:
#   1. struct-field initializers      (`Box { s: 0 }`  where `s: String`)
#   2. array/vector-element literals  (`v: Vec<String> = [0]`)
#
# These sites are WARN-ONLY behind a separate flip switch
# (tc_n3_wall_structural_is_error → false), so compilation SUCCEEDS (exit 0) and
# the QZ0215 structural-audit warning appears on stderr. Metering/draining/
# flipping to error are later items. We assert the WARNING fires (and that
# legit / sanctioned / scalar / union shapes do NOT fire).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("structural bare-Int wall (item 5a, warn-only QZ0215)") do ->

    # ---- struct-field-init site: SHOULD warn (warn-only → exit 0) ----

    # Bare-Int LITERAL into a String field: the structural audit warns AND the
    # pre-existing field-type check (tc_types_match String vs Int) independently
    # hard-errors, so exit_code is non-zero for an orthogonal reason. We assert
    # only that OUR warn-only QZ0215 structural audit fired (the audit is the
    # subject under test; the literal/String type mismatch is separate behavior).
    it("warns on bare Int into a String struct field") do ->
      var src = """
        struct Box
          s: String
        end
        def main(): Int
          b = Box { s: 0 }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(str_contains(r.stderr_content, "structural audit"), true)
      assert_eq(str_contains(r.stderr_content, "QZ0215"), true)
    end

    it("warns on bare Int into a nested-struct field (warn-only)") do ->
      var src = """
        struct Inner
          n: Int
        end
        struct Outer
          inner: Inner
        end
        def main(): Int
          o = Outer { inner: 0 }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), true)
    end

    it("warns on an Int VARIABLE into a String struct field (warn-only)") do ->
      var src = """
        struct Box
          s: String
        end
        def main(): Int
          x = 7
          b = Box { s: x }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), true)
    end

    it("warns on bare Int into a Vec<String> struct field (warn-only)") do ->
      var src = """
        struct Holder
          items: Vec<String>
        end
        def main(): Int
          h = Holder { items: 0 }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), true)
    end

    # ---- struct-field-init site: should NOT warn ----

    it("does NOT warn on an Int field initialized to 0 (Counter { n: 0 })") do ->
      var src = """
        struct Counter
          n: Int
        end
        def main(): Int
          c = Counter { n: 0 }
          return c.n
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), false)
    end

    it("does NOT warn on a legit String value into a String field") do ->
      var src = """
        struct Box
          s: String
        end
        def main(): Int
          b = Box { s: "hello" }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), false)
    end

    it("does NOT warn on an `Int | Nil` union struct field set to 0") do ->
      var src = """
        struct MaybeBox
          v: Int | Nil
        end
        def main(): Int
          m = MaybeBox { v: 0 }
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), false)
    end

    # ---- array/vector-element site: SHOULD warn (warn-only → exit 0) ----

    it("warns on a bare Int element in a Vec<String> slot (warn-only)") do ->
      var src = """
        def main(): Int
          v: Vec<String> = [0]
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), true)
    end

    # ---- array/vector-element site: should NOT warn ----

    it("does NOT warn on Int elements in a Vec<Int> slot") do ->
      var src = """
        def main(): Int
          v: Vec<Int> = [0, 1, 2]
          return v[0]
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), false)
    end

    it("does NOT warn on String elements in a Vec<String> slot") do ->
      var src = """
        def main(): Int
          v: Vec<String> = ["a", "b"]
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "structural audit"), false)
    end

  end

  return qspec_main()
end
