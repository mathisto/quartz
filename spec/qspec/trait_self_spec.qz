## Trait Self Type Tests
##
## Contract:
##   1. Self resolves to implementing type in impl blocks
##   2. Self works in trait method params
##   3. Self works in trait method return types
##   4. Self works in default methods

import * from qspec

struct TsPoint
  x: Int
  y: Int
end

trait TsCloneable
  def ts_clone(self): Self
    return self
  end
end

trait TsComparable
  def ts_eq(self, other: Self): Bool
    return false
  end
  def ts_neq(self, other: Self): Bool = not self.ts_eq(other)
end

extend TsPoint with TsCloneable
  def ts_clone(self): Self
    return TsPoint { x: @x, y: @y }
  end
end

extend TsPoint with TsComparable
  def ts_eq(self, other: Self): Bool
    return @x == other.x and @y == other.y
  end
end

def ts_clone_test(): Int
  p = TsPoint { x: 3, y: 4 }
  q = p.ts_clone()
  return q.x + q.y
end

def ts_eq_test(): Int
  a = TsPoint { x: 1, y: 2 }
  b = TsPoint { x: 1, y: 2 }
  c = TsPoint { x: 3, y: 4 }
  if a.ts_eq(b)
    if a.ts_neq(c)
      return 1
    end
  end
  return 0
end

def main(): Int
  describe("Self type in traits") do ->
    it("Self resolves in clone return type") do ->
      assert_eq(ts_clone_test(), 7)
    end

    it("Self resolves in eq parameter") do ->
      assert_eq(ts_eq_test(), 1)
    end

    it("default method with Self works (ts_neq)") do ->
      a = TsPoint { x: 1, y: 2 }
      b = TsPoint { x: 1, y: 2 }
      assert_eq(a.ts_neq(b), false)
    end
  end

  return qspec_main()
end
