import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("volatile_load") do ->
    it("reads a value from a pointer with volatile semantics") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 42, 8)
      var val = volatile_load(p, 8)
      assert_eq(val, 42)
    end

    it("reads back a different stored value") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 99, 8)
      var val = volatile_load(p, 8)
      assert_eq(val, 99)
    end
  end

  describe("volatile_store") do ->
    it("writes a value to a pointer with volatile semantics") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 123, 8)
      var val = volatile_load(p, 8)
      assert_eq(val, 123)
    end

    it("overwrites a previously stored value") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 10, 8)
      volatile_store(p, 20, 8)
      var val = volatile_load(p, 8)
      assert_eq(val, 20)
    end
  end

  describe("narrow volatile access") do ->
    it("volatile_store<U8> stores a byte value") do ->
      assert_ir_contains("""
        def main(): Int
          var p = ptr_alloc(1)
          volatile_store<U8>(p, 65)
          return volatile_load<U8>(p)
        end
      """, "store volatile i8")
    end

    it("volatile_load<U8> loads a byte value") do ->
      assert_ir_contains("""
        def main(): Int
          var p = ptr_alloc(1)
          volatile_store<U8>(p, 65)
          return volatile_load<U8>(p)
        end
      """, "load volatile i8")
    end

    it("volatile_store<U16> stores a 16-bit value") do ->
      assert_ir_contains("""
        def main(): Int
          var p = ptr_alloc(1)
          volatile_store<U16>(p, 1000)
          return volatile_load<U16>(p)
        end
      """, "store volatile i16")
    end

    it("volatile_load<U32> loads a 32-bit value") do ->
      assert_ir_contains("""
        def main(): Int
          var p = ptr_alloc(1)
          volatile_store<U32>(p, 70000)
          return volatile_load<U32>(p)
        end
      """, "load volatile i32")
    end

    it("volatile_store<U8> round-trips correctly") do ->
      var p = ptr_alloc(1)
      ptr_write_byte(p, 0)
      volatile_store(p, 200, 1)
      var val = volatile_load(p, 1)
      assert_eq(val, 200)
    end

    it("volatile_store<U16> round-trips correctly") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 0, 8)
      volatile_store(p, 1000, 2)
      var val = volatile_load(p, 2)
      assert_eq(val, 1000)
    end

    it("volatile_load<U32> round-trips correctly") do ->
      var p = ptr_alloc(1)
      volatile_store(p, 0, 8)
      volatile_store(p, 70000, 4)
      var val = volatile_load(p, 4)
      assert_eq(val, 70000)
    end
  end

  describe("volatile round-trip") do ->
    it("can write and read back multiple Int values") do ->
      var p = ptr_alloc(4)
      volatile_store(p, 100, 8)
      volatile_store(p + 8, 200, 8)
      volatile_store(p + 16, 300, 8)
      volatile_store(p + 24, 400, 8)
      var v0 = volatile_load(p, 8)
      var v1 = volatile_load(p + 8, 8)
      var v2 = volatile_load(p + 16, 8)
      var v3 = volatile_load(p + 24, 8)
      assert_eq(v0, 100)
      assert_eq(v1, 200)
      assert_eq(v2, 300)
      assert_eq(v3, 400)
    end
  end

  return qspec_main()
end
