## Effect Declaration Registration — B.2 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.2).
## Verifies the parser emits NODE_EFFECT_DECL nodes (instead of the no-op
## `ast_import("","")` placeholder Milestone A used) and that the typecheck
## pre-pass reads the children to call `tc_register_effect_decl`.
##
## In-process tests cover the green path: an effect with no ops, one with
## a single op signature, and one with multiple op signatures all reach
## the end of compilation. The fact that the spec binary itself compiled,
## linked, and ran with the effect declarations present is the assertion —
## any failure to register would have surfaced as a compile error.
##
## A subprocess test covers the negative path: declaring two effects with
## the same name in one compilation unit must raise QZ0612.

import * from qspec
import * from qspec/subprocess

effect EffectDeclEmpty
end

effect EffectDeclSingle
  def single_op(x: Int): Int
end

effect EffectDeclMulti
  def first_op(x: Int): Int
  def second_op(s: String): Void
  def third_op(): Bool
end

def edecl_seven(): Int = 7
def edecl_double(x: Int): Int = x * 2

def main(): Int
  describe("effect Name ... end registers via NODE_EFFECT_DECL") do ->
    it("empty effect compiles clean") do ->
      assert_eq(edecl_seven(), 7)
    end

    it("single-op effect compiles clean") do ->
      assert_eq(edecl_double(3), 6)
    end

    it("multi-op effect compiles clean") do ->
      assert_eq(edecl_seven() + 1, 8)
    end

    it("duplicate effect declaration emits QZ0612") do ->
      assert_compile_error("""
effect DupBob
  def boop(x: Int): Int
end

effect DupBob
  def beep(s: String): Void
end

def main(): Int = 0
""", "QZ0612")
    end
  end
  return qspec_main()
end
