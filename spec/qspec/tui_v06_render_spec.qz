## QSpec coverage for std/tui/render.qz — Phase 6.3 of the v0.6 cell engine.
##
## Coverage:
##   - Renderer construction (front + back blank, equal dimensions)
##   - renderer_resize resets both buffers
##   - renderer_with_back replaces back, preserves front
##   - renderer_swap promotes back → front; subsequent diff is empty
##   - renderer_diff:
##       * empty when front == back (with or without sync)
##       * single-cell diff produces a cursor-move + SGR + egc + reset
##       * sync=true wraps in DEC 2026 begin/end markers
##       * sync=false produces no DEC 2026 markers
##       * adjacent same-row diffs avoid extra cursor-moves
##       * adjacent same-style cells avoid extra SGR sequences
##   - Cursor positioning is 1-based and row-major
##
## Assertions check substring presence and absence rather than exact
## byte sequences — the diff string's exact shape is implementation-
## defined within the SGR-state-machine semantics.
##
## See docs/design/TUI_V06_CELL_ENGINE.md D7.

import * from qspec
import std/tui/render as rd
import std/tui/plane as pl
import std/tui/cell as cl
import std/tui/blend as bl
import style

# Helpers — build cells with specific styling.
def _red_cell(): cl::Cell
  return cl::cell_with_fg(cl::cell_char("R"), cl::channel_rgb(rgb_color(255, 0, 0)))
end

def _blue_cell(): cl::Cell
  return cl::cell_with_fg(cl::cell_char("B"), cl::channel_rgb(rgb_color(0, 0, 255)))
end

# String contains helper — wraps str_contains for readability.
def _contains(haystack: String, needle: String): Bool
  return str_contains(haystack, needle)
end

def main(): Int
  describe("rd::renderer_new") do ->
    it("front and back are blank planes at (w, h)") do ->
      var r = rd::renderer_new(3, 2)
      assert_eq(r.w, 3)
      assert_eq(r.h, 2)
      var front: pl::Plane = r.front
      var back: pl::Plane = r.back
      assert_eq(front.w, 3)
      assert_eq(front.h, 2)
      assert_eq(back.w, 3)
      assert_eq(back.h, 2)
    end
  end

  describe("rd::renderer_resize") do ->
    it("rebuilds both buffers at new size") do ->
      var r0 = rd::renderer_new(3, 2)
      var r1 = rd::renderer_resize(r0, 5, 4)
      assert_eq(r1.w, 5)
      assert_eq(r1.h, 4)
      var front: pl::Plane = r1.front
      assert_eq(front.w, 5)
      assert_eq(front.h, 4)
    end
  end

  describe("rd::renderer_with_back / renderer_swap") do ->
    it("with_back replaces back, preserves front") do ->
      var r0 = rd::renderer_new(2, 1)
      var new_back = pl::plane_putc(pl::plane_create(2, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var back: pl::Plane = r1.back
      var front: pl::Plane = r1.front
      var bc = pl::plane_getc(back, 0, 0)
      var fc = pl::plane_getc(front, 0, 0)
      assert_eq_str(bc.egc, "R")
      assert_eq_str(fc.egc, " ")
    end

    it("swap promotes back to front") do ->
      var r0 = rd::renderer_new(2, 1)
      var new_back = pl::plane_putc(pl::plane_create(2, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var r2 = rd::renderer_swap(r1)
      var front: pl::Plane = r2.front
      var fc = pl::plane_getc(front, 0, 0)
      assert_eq_str(fc.egc, "R")
    end

    it("after swap, diff is empty (front == back)") do ->
      var r0 = rd::renderer_new(2, 1)
      var new_back = pl::plane_putc(pl::plane_create(2, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var r2 = rd::renderer_swap(r1)
      var diff = rd::renderer_diff(r2, false)
      assert_eq_str(diff, "")
    end
  end

  describe("rd::renderer_diff — empty cases") do ->
    it("empty when front == back, sync=false → empty string") do ->
      var r = rd::renderer_new(3, 2)
      var diff = rd::renderer_diff(r, false)
      assert_eq_str(diff, "")
    end

    it("equal front+back with sync=true → just the markers") do ->
      var r = rd::renderer_new(3, 2)
      var diff = rd::renderer_diff(r, true)
      # Markers only — no cell output, no SGR reset.
      assert_eq_str(diff, "\x1b[?2026h\x1b[?2026l")
    end
  end

  describe("rd::renderer_diff — single-cell diff") do ->
    it("emits cursor-move + SGR + egc + reset for one changed cell") do ->
      var r0 = rd::renderer_new(2, 1)
      var new_back = pl::plane_putc(pl::plane_create(2, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff(r1, false)
      # 1-based cursor move to (row=1, col=1).
      if _contains(diff, "\x1b[1;1H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Truecolor red SGR.
      if _contains(diff, "\x1b[38;2;255;0;0m")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # The egc.
      if _contains(diff, "R")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Reset at the end.
      if _contains(diff, "\x1b[0m")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("cell at (1, 0) emits cursor move to row=1, col=2") do ->
      var r0 = rd::renderer_new(3, 2)
      var new_back = pl::plane_putc(pl::plane_create(3, 2), 1, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff(r1, false)
      if _contains(diff, "\x1b[1;2H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("cell at (0, 1) emits cursor move to row=2, col=1") do ->
      var r0 = rd::renderer_new(2, 2)
      var new_back = pl::plane_putc(pl::plane_create(2, 2), 0, 1, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff(r1, false)
      if _contains(diff, "\x1b[2;1H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("rd::renderer_diff — sync wrapper (DEC 2026)") do ->
    it("sync=true wraps in begin/end markers") do ->
      var r0 = rd::renderer_new(1, 1)
      var new_back = pl::plane_putc(pl::plane_create(1, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff(r1, true)
      if _contains(diff, "\x1b[?2026h")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if _contains(diff, "\x1b[?2026l")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("sync=false produces no DEC 2026 markers") do ->
      var r0 = rd::renderer_new(1, 1)
      var new_back = pl::plane_putc(pl::plane_create(1, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff(r1, false)
      if _contains(diff, "\x1b[?2026h")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      if _contains(diff, "\x1b[?2026l")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("renderer_diff_synced is a sync=true convenience") do ->
      var r0 = rd::renderer_new(1, 1)
      var new_back = pl::plane_putc(pl::plane_create(1, 1), 0, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, new_back)
      var diff = rd::renderer_diff_synced(r1)
      if _contains(diff, "\x1b[?2026h")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("rd::renderer_diff — cursor-move minimization") do ->
    it("two adjacent same-row diffs emit only one cursor move") do ->
      var r0 = rd::renderer_new(3, 1)
      var back = pl::plane_create(3, 1)
      var b1 = pl::plane_putc(back, 0, 0, _red_cell())
      var b2 = pl::plane_putc(b1, 1, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, b2)
      var diff = rd::renderer_diff(r1, false)
      # Move to (1,1) — first diff position.
      if _contains(diff, "\x1b[1;1H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # No move to (1,2) — adjacent cells are continuation, not a new move.
      if _contains(diff, "\x1b[1;2H")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("two diffs across a gap each emit their own cursor move") do ->
      var r0 = rd::renderer_new(4, 1)
      var back = pl::plane_create(4, 1)
      var b1 = pl::plane_putc(back, 0, 0, _red_cell())
      var b2 = pl::plane_putc(b1, 3, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, b2)
      var diff = rd::renderer_diff(r1, false)
      # Move to (1,1).
      if _contains(diff, "\x1b[1;1H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # And move to (1,4) — col 3 is 1-based 4, gap of two cells.
      if _contains(diff, "\x1b[1;4H")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("rd::renderer_diff — SGR state minimization") do ->
    it("two adjacent same-style cells share one SGR setup") do ->
      var r0 = rd::renderer_new(2, 1)
      var back = pl::plane_create(2, 1)
      var b1 = pl::plane_putc(back, 0, 0, _red_cell())
      var b2 = pl::plane_putc(b1, 1, 0, _red_cell())
      var r1 = rd::renderer_with_back(r0, b2)
      var diff = rd::renderer_diff(r1, false)
      # Exactly one truecolor-red SGR — the second cell reuses the
      # active state instead of re-emitting the same sequence.
      assert_eq(str_count(diff, "\x1b[38;2;255;0;0m"), 1)
    end

    it("style change between adjacent cells emits a new SGR") do ->
      var r0 = rd::renderer_new(2, 1)
      var back = pl::plane_create(2, 1)
      var b1 = pl::plane_putc(back, 0, 0, _red_cell())
      var b2 = pl::plane_putc(b1, 1, 0, _blue_cell())
      var r1 = rd::renderer_with_back(r0, b2)
      var diff = rd::renderer_diff(r1, false)
      if _contains(diff, "\x1b[38;2;255;0;0m")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if _contains(diff, "\x1b[38;2;0;0;255m")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("rd::renderer_diff — full-frame churn (Tier B end-to-end)") do ->
    it("composing planes via merge_down + diff produces non-empty output") do ->
      # Demo of the full pipeline: build a back via plane_merge_down_with,
      # install it, diff against blank front. Should produce at least one
      # cursor move + SGR + egc.
      var canvas = pl::plane_fill(pl::plane_create(3, 1),
                                  cl::cell_with_fg(cl::cell_char("·"),
                                                    cl::channel_rgb(rgb_color(50, 50, 50))))
      var sprite = pl::plane_with_pos(
                     pl::plane_fill(pl::plane_create(1, 1), _red_cell()),
                     1, 0)
      var composed = pl::plane_merge_down_with(sprite, canvas, bl::BlendMode::None)
      var r0 = rd::renderer_new(3, 1)
      var r1 = rd::renderer_with_back(r0, composed)
      var diff = rd::renderer_diff(r1, false)
      if str_byte_len(diff) > 0
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if _contains(diff, "R")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("immediate re-diff after swap produces empty output") do ->
      var canvas = pl::plane_fill(pl::plane_create(2, 1), _blue_cell())
      var r0 = rd::renderer_new(2, 1)
      var r1 = rd::renderer_with_back(r0, canvas)
      # First diff non-empty (we changed back).
      var diff1 = rd::renderer_diff(r1, false)
      if str_byte_len(diff1) > 0
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # After swap, front == back; second diff empty.
      var r2 = rd::renderer_swap(r1)
      var diff2 = rd::renderer_diff(r2, false)
      assert_eq_str(diff2, "")
    end
  end

  return qspec_main()
end
