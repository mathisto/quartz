## QSpec Example - Dogfood test demonstrating the framework
##
## Compile: ../quartz-bootstrap/bin/quartz spec/qspec_demo.qz > /tmp/qspec_demo.ll
## Link:    clang -O2 -x ir /tmp/qspec_demo.ll -o /tmp/qspec_demo
## Run:     /tmp/qspec_demo

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Basic Tests (expect style)
  # ==========================================================================

  describe("Arithmetic") do ->
    it("adds two integers") do ->
      expect(1 + 2).to_eq(3)
    end

    it("multiplies") do ->
      expect(6 * 7).to_eq(42)
    end

    it("subtraction") do ->
      expect(10 - 3).to_eq(7)
    end
  end

  describe("Booleans") do ->
    it("true is true") do ->
      expect_bool(true).to_be_true()
    end

    it("false is false") do ->
      expect_bool(false).to_be_false()
    end

    it("negation with not") do ->
      expect(42).negate().to_eq(0)
    end
  end

  describe("Strings") do ->
    it("equality") do ->
      assert_eq_str("hello", "hello")
    end

    it("concatenation") do ->
      var s = "hello" + " world"
      assert_eq_str(s, "hello world")
    end
  end

  # ==========================================================================
  # Vec Tests
  # ==========================================================================

  describe("Vec") do ->
    it("starts empty") do ->
      var v = vec_new()
      expect(v.size).to_eq(0)
    end

    it("push and get") do ->
      var v = vec_new<Int>()
      v.push(42)
      expect(v.size).to_eq(1)
      expect(vec_get(v, 0)).to_eq(42)
    end

    it("push multiple elements") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      v.push(30)
      expect(v.size).to_eq(3)
      expect(vec_get(v, 0)).to_eq(10)
      expect(vec_get(v, 1)).to_eq(20)
      expect(vec_get(v, 2)).to_eq(30)
    end

    it("set overwrites") do ->
      var v = vec_new<Int>()
      v.push(1)
      vec_set(v, 0, 99)
      expect(vec_get(v, 0)).to_eq(99)
    end
  end

  # ==========================================================================
  # Comparison Tests
  # ==========================================================================

  describe("Comparisons") do ->
    it("greater than") do ->
      expect(10).to_be_gt(5)
    end

    it("less than") do ->
      expect(3).to_be_lt(10)
    end

    it("greater or equal") do ->
      expect(5).to_be_gte(5)
      expect(6).to_be_gte(5)
    end

    it("less or equal") do ->
      expect(5).to_be_lte(5)
      expect(4).to_be_lte(5)
    end
  end

  # ==========================================================================
  # Assert-style shorthand
  # ==========================================================================

  describe("Assert Style") do ->
    it("assert_eq") do ->
      assert_eq(1 + 1, 2)
    end

    it("assert_ne") do ->
      assert_ne(1, 2)
    end

    it("assert_gt") do ->
      assert_gt(10, 5)
    end

    it("assert_lt") do ->
      assert_lt(5, 10)
    end
  end

  # ==========================================================================
  # Pending and Skipped Tests
  # ==========================================================================

  describe("Future Features") do ->
    it_pending("float arithmetic")
    it_pending("pattern match assertions")

    xit("skipped test") do ->
      expect(1).to_eq(2)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("Properties") do ->
    forall_ii("addition is commutative") do x: Int, y: Int ->
      assert_eq(x + y, y + x)
    end

    forall_i("addition identity") do x: Int ->
      assert_eq(x + 0, x)
    end

    forall_i("multiplication by 1") do x: Int ->
      assert_eq(x * 1, x)
    end

    forall_i("double and halve") do x: Int ->
      var doubled = x * 2
      assert_eq(doubled / 2, x)
    end
  end

  # ==========================================================================
  # Hooks
  # ==========================================================================

  describe("Hooks Demo") do ->
    var counter = vec_new<Int>()
    counter.push(0)

    before(-> vec_set(counter, 0, 0))

    it("counter starts at 0 after before hook") do ->
      expect(vec_get(counter, 0)).to_eq(0)
    end
  end

  # ==========================================================================
  # Run all tests and format output
  # ==========================================================================

  return qspec_main()
end
