# B.10 P3.4-ii-a oracle — >16B NARROW-packed struct-by-value, the C->Quartz
# direction. C `run_tests` (struct_large_narrow_driver.c) passes @repr(C) structs
# >16B with sub-8-byte int fields BY VALUE (byval) into these Quartz `extern "C"`
# functions and receives narrow structs BY VALUE back (sret). The callee-side
# byval-param bind + sret-return copy must use the true-size packed `%struct.Name`
# layout — verified by linking against real C. Round-trip (Quartz main -> C
# run_tests -> Quartz fns) avoids a duplicate-`main` clash.

@value @repr(C) struct N6
  a: I32
  b: I32
  c: I32
  d: I32
  e: I32
  f: I32
end

@value @repr(C) struct NW
  a: I64
  b: I32
  c: I32
  d: I32
end

# byval param -> scalar
extern "C" def qz_n6_sum(v: N6): Int = v.a + v.b + v.c + v.d + v.e + v.f
extern "C" def qz_nw_sum(v: NW): Int = v.a + v.b + v.c + v.d

# sret returns
extern "C" def qz_make_n6(base: I32): N6 = N6 { a: base, b: base + 1, c: base + 2, d: base + 3, e: base + 4, f: base + 5 }
extern "C" def qz_make_nw(a: I64, b: I32, c: I32, d: I32): NW = NW { a: a, b: b, c: c, d: d }

extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
