# B.10 P3.4-ii-b oracle — >16B F32 struct-by-value, the C->Quartz direction.
# C `run_tests` (struct_large_float_driver.c) passes @repr(C) structs >16B with
# F32 fields BY VALUE (byval) into these Quartz `extern "C"` functions and
# receives F32 structs BY VALUE back (sret). The callee-side byval-param
# reconstruct (fpext) + sret-return repack (fptrunc) into/out of the C-layout
# %struct.Name.cabi must match the real platform C ABI — verified by linking
# against real C. Round-trip avoids a duplicate-`main` clash.

@value @repr(C) struct F6
  a: F32
  b: F32
  c: F32
  d: F32
  e: F32
  f: F32
end

@value @repr(C) struct FMix6
  a: I32
  b: I32
  c: I32
  d: F32
  e: F32
  f: F32
end

@value @repr(C) struct FW
  a: F32
  b: F32
  c: I64
  d: I64
end

# byval param -> scalar (sum*4 is exact: inputs are quarter-units)
extern "C" def qz_f6_sum4(v: F6): Int = to_int((v.a + v.b + v.c + v.d + v.e + v.f) * to_f32(4.0))

extern "C" def qz_fmix6_chk(v: FMix6): Int
  if v.a == 1 and v.b == 2 and v.c == 3 and v.d == to_f32(1.5) and v.f == to_f32(3.5)
    return 1
  end
  return 0
end

extern "C" def qz_fw_chk(v: FW): Int
  if v.a == to_f32(1.5) and v.b == to_f32(2.5) and v.c == 100 and v.d == 200
    return 1
  end
  return 0
end

# sret returns (integer-valued floats keep the assertion exact)
extern "C" def qz_mk_f6(a: I32): F6 = F6 { a: to_f32(a), b: to_f32(a + 1), c: to_f32(a + 2), d: to_f32(a + 3), e: to_f32(a + 4), f: to_f32(a + 5) }
extern "C" def qz_mk_fmix6(a: I32, d: I32): FMix6 = FMix6 { a: a, b: a + 1, c: a + 2, d: to_f32(d), e: to_f32(d + 1), f: to_f32(d + 2) }

extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
