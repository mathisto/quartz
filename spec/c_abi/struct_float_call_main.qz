# B.10 P3.4b oracle — F32 struct-by-value, the Quartz->C direction.
# Quartz `main` builds @repr(C) structs with F32 fields and calls C functions
# (struct_float_call_lib.c) that take/return them BY VALUE. F32 fields are stored
# 8-byte double-bits internally but C wants a packed 4-byte `float`, so the
# caller-side coercion must boundary-repack (fptrunc out / fpext in) — verified by
# linking against real C and asserting numeric results.

@value @repr(C) struct Vec2f
  x: F32
  y: F32
end

@value @repr(C) struct Vec3f
  x: F32
  y: F32
  z: F32
end

@value @repr(C) struct Vec4f
  x: F32
  y: F32
  z: F32
  w: F32
end

@value @repr(C) struct Mixf
  a: I32
  b: F32
end

@value @repr(C) struct FMix
  a: F32
  b: I64
end

# struct param by value -> scalar
extern "C" def v2f_sum4(v: Vec2f): Int
extern "C" def v3f_sum4(v: Vec3f): Int
extern "C" def v4f_sum4(v: Vec4f): Int
extern "C" def mixf_chk(m: Mixf): Int
extern "C" def fmix_chk(m: FMix): Int

# struct return by value
extern "C" def make_v2f(a4: I32, b4: I32): Vec2f
extern "C" def make_mixf(a: I32, b4: I32): Mixf
extern "C" def make_fmix(a4: I32, b: I64): FMix

# round an exact quarter-unit F32 to its *4 integer (1.5 -> 6) for assertion
def f4(x: F32): Int = to_int(x * to_f32(4.0))

def main(): Int
  var v2 = Vec2f { x: to_f32(1.5), y: to_f32(2.5) }
  var s2 = v2f_sum4(v2)
  var v3 = Vec3f { x: to_f32(1.5), y: to_f32(2.5), z: to_f32(0.5) }
  var s3 = v3f_sum4(v3)
  var v4 = Vec4f { x: to_f32(1.5), y: to_f32(2.5), z: to_f32(0.5), w: to_f32(0.75) }
  var s4 = v4f_sum4(v4)
  var m = Mixf { a: 7, b: to_f32(1.5) }
  var mok = mixf_chk(m)
  var fm = FMix { a: to_f32(2.5), b: 9000 }
  var fok = fmix_chk(fm)

  # struct returns by value
  var rv = make_v2f(6, 10)
  var rm = make_mixf(42, 6)
  var rf = make_fmix(10, 12345)

  var ret_ok = 0
  if f4(rv.x) == 6 and f4(rv.y) == 10 and rm.a == 42 and f4(rm.b) == 6 and f4(rf.a) == 10 and rf.b == 12345
    ret_ok = 1
  end

  var all = 0
  if s2 == 16 and s3 == 18 and s4 == 21 and mok == 1 and fok == 1 and ret_ok == 1
    all = 1
  end

  puts("v2f=#{s2} v3f=#{s3} v4f=#{s4} mixf=#{mok} fmix=#{fok} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
