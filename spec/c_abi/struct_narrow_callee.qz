# B.10 P3.4a oracle — narrow-integer struct-by-value, the C->Quartz direction.
# C `run_tests` (struct_narrow_driver.c) passes @repr(C) structs with sub-8-byte
# int fields BY VALUE into these Quartz `extern "C"` functions and receives narrow
# structs BY VALUE back. The callee-side coercion (packed-layout reconstruct of
# params + coerce-out of returns) must match the real platform C ABI — verified by
# linking against real C and asserting numeric results. Round-trip (Quartz main ->
# C run_tests -> Quartz struct fns) avoids a duplicate-`main` clash.

@value @repr(C) struct Vec2i
  x: I32
  y: I32
end

@value @repr(C) struct Rgba
  r: U8
  g: U8
  b: U8
  a: U8
end

@value @repr(C) struct Pixel
  r: U8
  g: U8
  b: U8
  v: I64
end

@value @repr(C) struct Tri
  a: I32
  b: I32
  c: I32
end

# struct param by value -> scalar
extern "C" def qz_v2i_sum(v: Vec2i): Int = v.x + v.y
extern "C" def qz_rgba_sum(c: Rgba): Int = c.r + c.g + c.b + c.a
extern "C" def qz_tri_sum(t: Tri): Int = t.a + t.b + t.c

extern "C" def qz_pixel_ok(p: Pixel): Int
  if p.r == 1 and p.g == 2 and p.b == 3 and p.v == 9000
    return 1
  end
  return 0
end

# struct RETURNS by value (C reads them out of the coerce registers)
extern "C" def qz_make_vec2i(a: I32, b: I32): Vec2i = Vec2i { x: a, y: b }
extern "C" def qz_make_rgba(r: I32, g: I32, b: I32, a: I32): Rgba = Rgba { r: r, g: g, b: b, a: a }
extern "C" def qz_make_tri(a: I32, b: I32, c: I32): Tri = Tri { a: a, b: b, c: c }

extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
