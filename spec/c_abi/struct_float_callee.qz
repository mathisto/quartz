# B.10 P3.4b oracle — F32 struct-by-value, the C->Quartz direction.
# C `run_tests` (struct_float_driver.c) passes @repr(C) structs with F32 fields
# BY VALUE into these Quartz `extern "C"` functions and receives F32 structs BY
# VALUE back. The callee-side coercion must boundary-repack each F32 (fpext params
# in, fptrunc returns out) to match the real platform C ABI — verified by linking
# against real C and asserting numeric results. Round-trip (Quartz main -> C
# run_tests -> Quartz fns) avoids a duplicate-`main` clash.

@value @repr(C) struct Vec2f
  x: F32
  y: F32
end

@value @repr(C) struct Vec3f
  x: F32
  y: F32
  z: F32
end

@value @repr(C) struct Vec4f
  x: F32
  y: F32
  z: F32
  w: F32
end

@value @repr(C) struct Mixf
  a: I32
  b: F32
end

@value @repr(C) struct FMix
  a: F32
  b: I64
end

# struct param by value -> scalar (sum*4 is exact: inputs are quarter-units)
extern "C" def qz_v2f_sum4(v: Vec2f): Int = to_int((v.x + v.y) * to_f32(4.0))
extern "C" def qz_v3f_sum4(v: Vec3f): Int = to_int((v.x + v.y + v.z) * to_f32(4.0))
extern "C" def qz_v4f_sum4(v: Vec4f): Int = to_int((v.x + v.y + v.z + v.w) * to_f32(4.0))

extern "C" def qz_mixf_chk(m: Mixf): Int
  if m.a == 7 and m.b == to_f32(1.5)
    return 1
  end
  return 0
end

extern "C" def qz_fmix_chk(m: FMix): Int
  if m.a == to_f32(2.5) and m.b == 9000
    return 1
  end
  return 0
end

# struct RETURNS by value (C reads them out of the coerce registers). Integer-
# valued floats keep the assertion exact without F32 division.
extern "C" def qz_make_v2f(a: I32, b: I32): Vec2f = Vec2f { x: to_f32(a), y: to_f32(b) }
extern "C" def qz_make_mixf(a: I32, b: I32): Mixf = Mixf { a: a, b: to_f32(b) }
extern "C" def qz_make_fmix(a: I32, b: I64): FMix = FMix { a: to_f32(a), b: b }

extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
