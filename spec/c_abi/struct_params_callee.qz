# P3.1a/b oracle: C calls these Quartz extern "C" functions, passing structs BY
# VALUE (P3.1a, params) and receiving structs BY VALUE (P3.1b, returns).
# Round-trip (Quartz main -> C run_tests -> Quartz struct fns) avoids a main clash.

@value struct Pair
  a: Int
  b: Int
end

@value struct V2
  x: F64
  y: F64
end

@value struct Mix
  i: Int
  d: F64
end

extern "C" def qz_pair_sum(p: Pair): Int = p.a + p.b
extern "C" def qz_pair_diff(p: Pair): Int = p.a - p.b

extern "C" def qz_v2_ok(v: V2): Int
  if v.x == 3.0 and v.y == 4.0
    return 1
  end
  return 0
end

extern "C" def qz_mix_ok(m: Mix): Int
  if m.i == 42 and m.d == 2.5
    return 1
  end
  return 0
end

# P3.1b — struct RETURNS by value. C reads these out of the coerce registers.
# Their F64 params also exercise scalar-double param passing (FP registers).
extern "C" def qz_make_pair(a: Int, b: Int): Pair = Pair { a: a, b: b }
extern "C" def qz_make_v2(x: F64, y: F64): V2 = V2 { x: x, y: y }
extern "C" def qz_make_mix(i: Int, d: F64): Mix = Mix { i: i, d: d }

# P3.1b — scalar F64 param + scalar F64 return (both in FP registers).
extern "C" def qz_scale2(x: F64): F64 = x * 2.0

extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
