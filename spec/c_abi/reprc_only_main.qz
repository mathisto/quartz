# B.10 P3 regression — `@repr(C)` struct-by-value WITHOUT `@value`.
#
# Pins the fix for docs/bugs/done/REPR_C_STRUCT_BYVAL_NEEDS_VALUE_ATTR.md: a
# struct marked `@repr(C)` and crossing an `extern "C"` boundary BY VALUE must get
# the C-ABI classifier treatment (register/HFA coerce) on its own — the natural
# FFI spelling, no second `@value` attribute. Every other c_abi oracle struct is
# `@value @repr(C)`, so this is the ONLY case exercising `@repr(C)` alone. If the
# MIR struct registry ever stops being populated for plain `@repr(C)` structs
# again, the classifier falls back to the boxed-i64 convention and this crashes /
# returns garbage. Narrow-int (Pt) + F32 (V2f), both struct params and returns.

@repr(C) struct Pt
  x: I32
  y: I32
end

@repr(C) struct V2f
  x: F32
  y: F32
end

# struct param by value -> scalar
extern "C" def pt_sum(p: Pt): Int
extern "C" def v2f_sum4(v: V2f): Int
# struct return by value
extern "C" def make_pt(x: I32, y: I32): Pt
extern "C" def make_v2f(a4: I32, b4: I32): V2f

# round an exact quarter-unit F32 to its *4 integer (1.5 -> 6) for assertion
def f4(x: F32): Int = to_int(x * to_f32(4.0))

def main(): Int
  var p = make_pt(3, 4)                 # struct return by value
  var ps = pt_sum(p)                    # struct param by value -> 7
  var rp = Pt { x: 10, y: 20 }
  var rps = pt_sum(rp)                  # 30
  var v = make_v2f(6, 10)              # V2f{1.5, 2.5} returned by value
  var vs = v2f_sum4(v)                 # (1.5+2.5)*4 = 16

  var ok = 0
  if ps == 7 and rps == 30 and f4(v.x) == 6 and f4(v.y) == 10 and vs == 16
    ok = 1
  end

  puts("pt_ret=#{p.x},#{p.y} pt_sum=#{ps},#{rps} v2f_sum=#{vs} vx=#{f4(v.x)} vy=#{f4(v.y)} ALL=#{ok}")
  if ok == 1
    return 0
  end
  return 1
end
