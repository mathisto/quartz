# B.10 P3.3 oracle — the C->Quartz direction for LARGE (>16B) structs. These
# Quartz `extern "C"` functions HAVE BODIES, so they are the callee: a C driver
# (struct_large_driver.c) builds structs and calls them by value. A >16B non-HFA
# struct arrives INDIRECTLY (a pointer to the C-made copy on AArch64, the stack
# arg area on SysV); a >16B return goes out through a hidden sret pointer. The
# callee-side signature + sret terminator must match the real platform C ABI.

@value struct P3
  a: Int
  b: Int
  c: Int
end

@value struct Big6
  a: F64
  b: F64
  c: F64
  d: F64
  e: F64
  f: F64
end

@value struct M3
  i: Int
  d: F64
  k: Int
end

# byval param -> scalar
extern "C" def qz_p3_sum(p: P3): Int
  return p.a + p.b + p.c
end

extern "C" def qz_big6_ok(b: Big6): Int
  if b.a + b.b + b.c + b.d + b.e + b.f == 21.0
    return 1
  end
  return 0
end

extern "C" def qz_m3_ok(m: M3): Int
  if m.i == 1 and m.d == 2.5 and m.k == 3
    return 1
  end
  return 0
end

# sret return
extern "C" def qz_make_p3(a: Int, b: Int, c: Int): P3
  return P3 { a: a, b: b, c: c }
end

extern "C" def qz_make_m3(i: Int, d: F64, k: Int): M3
  return M3 { i: i, d: d, k: k }
end

# byval-in + sret-out on one call
extern "C" def qz_p3_rot(p: P3): P3
  return P3 { a: p.c, b: p.a, c: p.b }
end

# Round-trip (Quartz main -> C run_tests -> Quartz struct fns) avoids a main clash
# in the single linked binary, mirroring struct_params_callee.qz.
extern "C" def run_tests(): Int

def main(): Int
  return run_tests()
end
