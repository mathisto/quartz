# B.10 P3.3 oracle — the Quartz->C direction for LARGE (>16B) structs. Quartz
# `main` constructs structs and calls C functions (struct_large_call_lib.c) that
# take/return them BY VALUE. A >16B non-HFA struct crosses the C boundary
# INDIRECTLY: a `byval` pointer for a param, a hidden `sret` pointer for a
# return. The caller-side emission must match the real platform C ABI — the only
# way to verify is to link against real C and run, asserting numeric results.

@value struct P3
  a: Int
  b: Int
  c: Int
end

@value struct Quad
  a: Int
  b: Int
  c: Int
  d: Int
end

@value struct Big6
  a: F64
  b: F64
  c: F64
  d: F64
  e: F64
  f: F64
end

@value struct M3
  i: Int
  d: F64
  k: Int
end

# byval param -> scalar
extern "C" def c_p3_sum(p: P3): Int
extern "C" def c_quad_sum(q: Quad): Int
extern "C" def c_big6_ok(b: Big6): Int
extern "C" def c_m3_ok(m: M3): Int

# sret return
extern "C" def c_make_p3(a: Int, b: Int, c: Int): P3
extern "C" def c_make_big6(base: F64): Big6
extern "C" def c_make_m3(i: Int, d: F64, k: Int): M3

# byval-in + sret-out on one call
extern "C" def c_p3_rot(p: P3): P3

def main(): Int
  var p = P3 { a: 10, b: 20, c: 30 }
  var p3sum = c_p3_sum(p)
  var q = Quad { a: 1, b: 2, c: 3, d: 4 }
  var quadsum = c_quad_sum(q)
  var b6 = Big6 { a: 1.0, b: 2.0, c: 3.0, d: 4.0, e: 5.0, f: 6.0 }
  var b6ok = c_big6_ok(b6)
  var m = M3 { i: 1, d: 2.5, k: 3 }
  var m3ok = c_m3_ok(m)

  # sret returns
  var rp = c_make_p3(7, 8, 9)
  var rb = c_make_big6(10.0)
  var rm = c_make_m3(5, 6.5, 11)

  # byval-in + sret-out
  var rot = c_p3_rot(P3 { a: 1, b: 2, c: 3 })

  var ret_ok = 0
  if rp.a == 7 and rp.b == 8 and rp.c == 9 and rb.a == 10.0 and rb.f == 15.0 and rm.i == 5 and rm.d == 6.5 and rm.k == 11 and rot.a == 3 and rot.b == 1 and rot.c == 2
    ret_ok = 1
  end

  var all = 0
  if p3sum == 60 and quadsum == 10 and b6ok == 1 and m3ok == 1 and ret_ok == 1
    all = 1
  end

  puts("p3_sum=#{p3sum} quad_sum=#{quadsum} big6_ok=#{b6ok} m3_ok=#{m3ok} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
