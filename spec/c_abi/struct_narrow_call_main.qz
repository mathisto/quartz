# B.10 P3.4a oracle — narrow-integer struct-by-value, the Quartz->C direction.
# Quartz `main` builds @repr(C) structs with sub-8-byte int fields and calls C
# functions (struct_narrow_call_lib.c) that take/return them BY VALUE. The
# caller-side coercion must match the real platform C ABI — verified by linking
# against real C and asserting numeric results. On SysV a 4-byte struct coerces
# to i32 and a 12-byte struct to {i64,i32}; on AArch64 both ride i64/[2 x i64].

@value @repr(C) struct Vec2i
  x: I32
  y: I32
end

@value @repr(C) struct Rgba
  r: U8
  g: U8
  b: U8
  a: U8
end

@value @repr(C) struct I16x2
  a: I16
  b: I16
end

@value @repr(C) struct Pixel
  r: U8
  g: U8
  b: U8
  v: I64
end

@value @repr(C) struct Tri
  a: I32
  b: I32
  c: I32
end

# struct param by value -> scalar
extern "C" def v2i_sum(v: Vec2i): Int
extern "C" def rgba_sum(c: Rgba): Int
extern "C" def i16_sum(v: I16x2): Int
extern "C" def pixel_ok(p: Pixel): Int
extern "C" def tri_sum(t: Tri): Int

# struct return by value
extern "C" def make_vec2i(a: I32, b: I32): Vec2i
extern "C" def make_rgba(r: I32, g: I32, b: I32, a: I32): Rgba
extern "C" def make_tri(a: I32, b: I32, c: I32): Tri

# struct in -> struct out
extern "C" def tri_inc(t: Tri): Tri

def main(): Int
  var v = Vec2i { x: 10, y: 3 }
  var vs = v2i_sum(v)
  var c = Rgba { r: 1, g: 2, b: 3, a: 4 }
  var cs = rgba_sum(c)
  var i16 = I16x2 { a: 100, b: 23 }
  var i16s = i16_sum(i16)
  var px = Pixel { r: 1, g: 2, b: 3, v: 9000 }
  var pok = pixel_ok(px)
  var t = Tri { a: 5, b: 6, c: 7 }
  var ts = tri_sum(t)

  # struct returns by value
  var rv = make_vec2i(42, 8)
  var rc = make_rgba(11, 22, 33, 44)
  var rt = make_tri(1, 2, 3)

  # struct in -> struct out
  var ti = tri_inc(Tri { a: 10, b: 20, c: 30 })

  var ret_ok = 0
  if rv.x == 42 and rv.y == 8 and rc.r == 11 and rc.g == 22 and rc.b == 33 and rc.a == 44 and rt.a == 1 and rt.b == 2 and rt.c == 3 and ti.a == 11 and ti.b == 21 and ti.c == 31
    ret_ok = 1
  end

  var all = 0
  if vs == 13 and cs == 10 and i16s == 123 and pok == 1 and ts == 18 and ret_ok == 1
    all = 1
  end

  puts("v2i=#{vs} rgba=#{cs} i16=#{i16s} pixel=#{pok} tri=#{ts} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
