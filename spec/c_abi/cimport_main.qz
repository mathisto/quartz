# B.11b @cImport oracle — the convenience layer end to end (MEMORY_MODEL_V3.md
# §13.6a, P3.6a). `cimport "cimport_header.h"` makes the compiler shell out to
# clang's AST dump, translate the C declarations into `@value @repr(C)` structs
# + `extern "C"` defs (cimport_gen), and load them as a generated module. We then
# build C structs, call the C functions (cimport_lib.c) by value, and assert the
# numeric results — proving the WHOLE Phase 3 stack works *through* @cImport on a
# real C link. Run on host (AAPCS) + x86_64 SysV (Rosetta) via run.sh.

cimport "cimport_header.h"

def scale10(x: F32): Int = to_int(x * to_f32(10.0))

def main(): Int
  var s = ci_addi(40, 2)
  var p = ci_make_point(3, 4)
  var v = CVec2f { fx: to_f32(1.5), fy: to_f32(2.0) }
  var r = ci_vscale(v, to_f32(4.0))
  var d = ci_dscale(2.5, to_f32(4.0))
  var c = ci_counter(200, 100)
  # Enum constants generated by @cImport, passed as int-rank args: CST_ERR is
  # implicit (CST_WARN=5 → 6) → 106; CST_OK=0 → 100; CM_HI=10 → 20.
  var sc = ci_status_code(CST_ERR)
  var so = ci_status_code(CST_OK)
  var mb = ci_mode_base(CM_HI)
  # #define constants generated by @cImport (P3.6b): CI_MAX=64, CI_FLAG=0x10=16,
  # CI_SCALE=3 → 83. The function-like CI_SQUARE is skipped (not a const).
  var mac = ci_addi(CI_MAX + CI_FLAG, CI_SCALE)
  # String #define (P3.6b-strings): CI_LABEL "ci" → a module-level string const,
  # compiled and usable like any other string (unblocked by 4cd19500).
  var label_ok = 0
  if CI_LABEL == "ci"
    label_ok = 1
  end
  # Typedef aliases (P3.6c): CU32 -> unsigned int (U32), CHandle -> CU32 -> U32.
  # ci_alias_sum's params/return resolve through the alias map. 11 + 22 = 33.
  var al = ci_alias_sum(11, 22)
  # Pointer struct fields (P3.6c-ptrfields): CSpan = {data: CPtr, len: I32}. C
  # hands us a real pointer (ci_span_data → {10,20,30}); ci_make_span returns the
  # struct BY VALUE with the pointer field intact; ci_span_sum takes it BY VALUE
  # and dereferences data[0..len] → 60. Proves a live pointer round-trips through
  # a by-value struct in both directions.
  var sp_data = ci_span_data()
  var span = ci_make_span(sp_data, 3)
  var span_sum = ci_span_sum(span)

  var ok = 0
  if s == 42 and p.x == 3 and p.y == 4 and scale10(r.fx) == 60 and scale10(r.fy) == 80 and to_int(d * 10.0) == 100 and (c as Int) == 300 and sc == 106 and so == 100 and mb == 20 and mac == 83 and label_ok == 1 and (al as Int) == 33 and span.len == 3 and span_sum == 60
    ok = 1
  end

  puts("addi=#{s} point=#{p.x},#{p.y} vscale=#{scale10(r.fx)},#{scale10(r.fy)} dscale=#{to_int(d * 10.0)} counter=#{c as Int} status=#{sc},#{so} mode=#{mb} macros=#{mac} label=#{CI_LABEL} alias=#{al as Int} span=#{span_sum} ALL=#{ok}")
  if ok == 1
    return 0
  end
  return 1
end
