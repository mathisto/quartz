# B.10 P3.1c oracle — the Quartz->C direction. Quartz `main` constructs structs
# and calls C functions (struct_call_lib.c) that take/return them BY VALUE. The
# caller-side coercion (arg load into the target's coerce aggregate + struct
# return reconstruction) must match the real platform C ABI — the only way to
# verify that is to link against real C and run, asserting numeric results.

@value struct Pair
  a: Int
  b: Int
end

@value struct V2
  x: F64
  y: F64
end

@value struct Mix
  i: Int
  d: F64
end

# struct param by value -> scalar
extern "C" def c_pair_sum(p: Pair): Int
extern "C" def c_pair_diff(p: Pair): Int
extern "C" def c_v2_is34(v: V2): Int
extern "C" def c_mix_ok(m: Mix): Int

# struct return by value
extern "C" def c_make_pair(a: Int, b: Int): Pair
extern "C" def c_make_v2(x: F64, y: F64): V2
extern "C" def c_make_mix(i: Int, d: F64): Mix

# struct in -> struct out (both coercions on one call)
extern "C" def c_pair_swap(p: Pair): Pair
extern "C" def c_v2_scale(v: V2, k: F64): V2

def main(): Int
  var p = Pair { a: 10, b: 3 }
  var sum = c_pair_sum(p)
  var diff = c_pair_diff(p)
  var v = V2 { x: 3.0, y: 4.0 }
  var vok = c_v2_is34(v)
  var m = Mix { i: 42, d: 2.5 }
  var mok = c_mix_ok(m)

  # struct returns by value
  var rp = c_make_pair(5, 9)
  var rv = c_make_v2(1.5, 2.5)
  var rm = c_make_mix(7, 8.5)

  # struct-in / struct-out on one call
  var sw = c_pair_swap(Pair { a: 1, b: 2 })
  var vs = c_v2_scale(V2 { x: 2.0, y: 3.0 }, 2.0)

  var ret_ok = 0
  if rp.a == 5 and rp.b == 9 and rv.x == 1.5 and rv.y == 2.5 and rm.i == 7 and rm.d == 8.5 and sw.a == 2 and sw.b == 1 and vs.x == 4.0 and vs.y == 6.0
    ret_ok = 1
  end

  var all = 0
  if sum == 13 and diff == 7 and vok == 1 and mok == 1 and ret_ok == 1
    all = 1
  end

  puts("pair_sum=#{sum} pair_diff=#{diff} v2_ok=#{vok} mix_ok=#{mok} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
