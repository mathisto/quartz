# B.10 P3.4-ii-a oracle — >16B NARROW-packed struct-by-value, the Quartz->C
# direction. Quartz `main` builds @repr(C) structs >16B with sub-8-byte int
# fields and calls C functions (struct_large_narrow_call_lib.c) that take/return
# them BY VALUE (indirect: byval param / sret return). The boundary memory type
# must be the true-size packed `%struct.Name` (24B), not `[N x i64]` (48B) —
# verified by linking against real C and asserting numeric results.

@value @repr(C) struct N6
  a: I32
  b: I32
  c: I32
  d: I32
  e: I32
  f: I32
end

@value @repr(C) struct NW
  a: I64
  b: I32
  c: I32
  d: I32
end

# byval param -> scalar
extern "C" def c_n6_sum(v: N6): Int
extern "C" def c_nw_sum(v: NW): Int

# sret return
extern "C" def c_make_n6(base: I32): N6
extern "C" def c_make_nw(a: I64, b: I32, c: I32, d: I32): NW

# byval-in + sret-out on one call
extern "C" def c_n6_inc(v: N6): N6

def main(): Int
  var n = N6 { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6 }
  var n6sum = c_n6_sum(n)
  var w = NW { a: 1000, b: 7, c: 8, d: 9 }
  var nwsum = c_nw_sum(w)

  # sret returns
  var rn = c_make_n6(10)
  var rw = c_make_nw(5000, 1, 2, 3)

  # byval-in + sret-out
  var inc = c_n6_inc(N6 { a: 10, b: 20, c: 30, d: 40, e: 50, f: 60 })

  var ret_ok = 0
  if rn.a == 10 and rn.b == 11 and rn.f == 15 and rw.a == 5000 and rw.b == 1 and rw.d == 3 and inc.a == 11 and inc.c == 31 and inc.f == 61
    ret_ok = 1
  end

  var all = 0
  if n6sum == 21 and nwsum == 1024 and ret_ok == 1
    all = 1
  end

  puts("n6_sum=#{n6sum} nw_sum=#{nwsum} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
