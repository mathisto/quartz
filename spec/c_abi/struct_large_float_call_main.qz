# B.10 P3.4-ii-b oracle — >16B F32 struct-by-value, the Quartz->C direction.
# Quartz `main` builds @repr(C) structs >16B with F32 fields and calls C
# functions (struct_large_float_call_lib.c) that take/return them BY VALUE
# (indirect: byval param / sret return). The boundary memory is a C-layout
# %struct.Name.cabi buffer the caller repacks each F32 into (fptrunc out / fpext
# in) — verified by linking against real C and asserting numeric results.

@value @repr(C) struct F6
  a: F32
  b: F32
  c: F32
  d: F32
  e: F32
  f: F32
end

@value @repr(C) struct FMix6
  a: I32
  b: I32
  c: I32
  d: F32
  e: F32
  f: F32
end

@value @repr(C) struct FW
  a: F32
  b: F32
  c: I64
  d: I64
end

# byval param -> scalar
extern "C" def f6_sum4(v: F6): Int
extern "C" def fmix6_chk(v: FMix6): Int
extern "C" def fw_chk(v: FW): Int

# sret return
extern "C" def mk_f6(a4: I32): F6
extern "C" def mk_fmix6(a: I32, d4: I32): FMix6

# byval-in + sret-out
extern "C" def f6_inc(v: F6): F6

def f4(x: F32): Int = to_int(x * to_f32(4.0))

def main(): Int
  var v = F6 { a: to_f32(1.5), b: to_f32(2.5), c: to_f32(0.5), d: to_f32(0.75), e: to_f32(0.25), f: to_f32(1.0) }
  var s = f6_sum4(v)  # (1.5+2.5+0.5+0.75+0.25+1.0)*4 = 6.5*4 = 26
  var m = FMix6 { a: 1, b: 2, c: 3, d: to_f32(1.5), e: to_f32(2.5), f: to_f32(3.5) }
  var mok = fmix6_chk(m)
  var w = FW { a: to_f32(1.5), b: to_f32(2.5), c: 100, d: 200 }
  var wok = fw_chk(w)

  # sret returns
  var rf = mk_f6(6)        # {1.5, 1.75, 2.0, 2.25, 2.5, 2.75}
  var rm = mk_fmix6(10, 8) # {10,11,12, 2.0,2.25,2.5}

  # byval-in + sret-out
  var inc = f6_inc(F6 { a: to_f32(1.0), b: to_f32(2.0), c: to_f32(3.0), d: to_f32(4.0), e: to_f32(5.0), f: to_f32(6.0) })

  var ret_ok = 0
  if f4(rf.a) == 6 and f4(rf.f) == 11 and rm.a == 10 and rm.c == 12 and f4(rm.d) == 8 and f4(rm.f) == 10 and f4(inc.a) == 8 and f4(inc.f) == 28
    ret_ok = 1
  end

  var all = 0
  if s == 26 and mok == 1 and wok == 1 and ret_ok == 1
    all = 1
  end

  puts("f6=#{s} fmix6=#{mok} fw=#{wok} ret_ok=#{ret_ok} ALL=#{all}")

  if all == 1
    return 0
  end
  return 1
end
