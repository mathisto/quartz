{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "#{", "close": "}", "notIn": ["comment"] }
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:def|if|unless|while|for|match|select|struct|enum|trait|impl|extend|macro|do|arena|loop|task_group)\\b",
      "end": "^\\s*end\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:def|if|elsif|else|unless|while|for|match|select|struct|enum|trait|impl|extend|macro|do|arena|loop|task_group)\\b.*$|\\{\\s*$",
    "decreaseIndentPattern": "^\\s*(?:end|elsif|else|\\})\\s*$"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_$]*[?!]?",
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:def|if|unless|while|for|match|select|struct|enum|trait|impl|extend|macro|do|arena|loop|task_group)\\b.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:elsif|else)\\b.*$",
      "action": { "indent": "indent" },
      "afterText": ".*"
    },
    {
      "beforeText": ".*=>\\s*\\{\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*end\\s*$",
      "action": { "indent": "outdent" }
    }
  ]
}
