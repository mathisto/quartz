{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quartz",
  "scopeName": "source.quartz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex-literal" },
    { "include": "#char-literal" },
    { "include": "#raw-string" },
    { "include": "#symbols" },
    { "include": "#attributes" },
    { "include": "#macro-invocation" },
    { "include": "#function-definition" },
    { "include": "#extern-declaration" },
    { "include": "#struct-definition" },
    { "include": "#enum-definition" },
    { "include": "#trait-definition" },
    { "include": "#impl-block" },
    { "include": "#extend-block" },
    { "include": "#type-alias" },
    { "include": "#newtype" },
    { "include": "#macro-definition" },
    { "include": "#keywords" },
    { "include": "#numeric-literals" },
    { "include": "#constants" },
    { "include": "#type-names" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.module.quartz",
          "match": "^(##!)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.quartz" },
            "2": { "name": "comment.block.documentation.module.quartz" }
          }
        },
        {
          "name": "comment.block.documentation.quartz",
          "match": "(##)(?!!)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.quartz" },
            "2": {
              "patterns": [
                {
                  "name": "storage.type.annotation.quartz",
                  "match": "@(?:param|returns|example|see|since|note)\\b"
                },
                {
                  "name": "comment.block.documentation.quartz"
                }
              ]
            }
          }
        },
        {
          "name": "comment.line.number-sign.quartz",
          "match": "(#)(?!#)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.quartz" },
            "2": { "name": "comment.line.number-sign.quartz" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.quartz",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.quartz" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.quartz" }
          },
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escape" }
          ]
        }
      ]
    },
    "string-interpolation": {
      "name": "meta.interpolation.quartz",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.quartz" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.quartz" }
      },
      "contentName": "source.quartz.embedded",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.quartz",
      "match": "\\\\(?:[nrt\\\\\"#0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
    },
    "raw-string": {
      "name": "string.quoted.other.raw.quartz",
      "begin": "r\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.quartz" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.quartz" }
      }
    },
    "regex-literal": {
      "name": "string.regexp.quartz",
      "begin": "~r\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.regexp.begin.quartz" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.regexp.end.quartz" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.regexp.quartz",
          "match": "\\\\."
        }
      ]
    },
    "char-literal": {
      "name": "string.quoted.single.quartz",
      "match": "'(?:[^'\\\\]|\\\\(?:[nrt\\\\']|x[0-9a-fA-F]{2}))'",
      "captures": {
        "0": { "name": "constant.character.quartz" }
      }
    },
    "symbols": {
      "name": "constant.other.symbol.quartz",
      "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.quartz",
          "match": "(@(?:packed|heap|naked|outer|value|thread_local))\\b",
          "captures": {
            "1": { "name": "keyword.other.attribute.quartz" }
          }
        },
        {
          "name": "meta.attribute.quartz",
          "begin": "(@(?:repr|cfg|derive|asm|c))\\(",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "keyword.other.attribute.quartz" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.end.quartz" }
          },
          "patterns": [
            {
              "name": "string.quoted.double.quartz",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                { "include": "#string-escape" }
              ]
            },
            {
              "name": "entity.name.type.quartz",
              "match": "[A-Z][a-zA-Z0-9_]*"
            },
            {
              "name": "variable.parameter.quartz",
              "match": "[a-z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.quartz",
              "match": "[,:]"
            }
          ]
        },
        {
          "name": "meta.attribute.field.quartz",
          "match": "(@)([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.attribute.quartz" },
            "2": { "name": "variable.other.field.quartz" }
          }
        }
      ]
    },
    "macro-invocation": {
      "patterns": [
        {
          "comment": "Built-in macros: $try, $unwrap, $assert, $debug",
          "name": "meta.macro-invocation.builtin.quartz",
          "match": "(\\$)(try|unwrap|assert|debug)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.definition.macro.quartz" },
            "2": { "name": "support.function.macro.builtin.quartz" }
          }
        },
        {
          "comment": "User-defined macro invocation",
          "name": "meta.macro-invocation.quartz",
          "match": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.definition.macro.quartz" },
            "2": { "name": "entity.name.function.macro.quartz" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "for await x in channel — must precede general 'for' keyword",
          "name": "keyword.control.flow.quartz",
          "match": "\\b(for)\\s+(await)\\b",
          "captures": {
            "1": { "name": "keyword.control.flow.quartz" },
            "2": { "name": "keyword.control.concurrency.quartz" }
          }
        },
        {
          "name": "keyword.control.flow.quartz",
          "match": "\\b(if|elsif|else|unless|match|end|while|for|in|loop|break|continue|return|do|then|try|catch|select|when)\\b"
        },
        {
          "name": "keyword.control.concurrency.quartz",
          "match": "\\b(go|async|await|yield|spawn)\\b"
        },
        {
          "name": "keyword.declaration.quartz",
          "match": "\\b(def|var|const|struct|enum|trait|impl|extend|import|cimport|from|as|type|newtype|macro|quote|unquote|unquote_each|private|priv|where|public)\\b"
        },
        {
          "name": "keyword.other.quartz",
          "match": "\\b(defer|arena|extern|task_group|static_assert)\\b"
        },
        {
          "name": "keyword.operator.logical.quartz",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.self.quartz",
          "match": "\\b(self|Self)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "comment": "Const def: const def name(params): Type = expr",
          "name": "meta.function.const.quartz",
          "match": "\\b(const)\\s+(def)\\s+([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?)",
          "captures": {
            "1": { "name": "storage.modifier.const.quartz" },
            "2": { "name": "keyword.declaration.function.quartz" },
            "3": { "name": "entity.name.function.quartz" }
          }
        },
        {
          "comment": "Associated function: def Type.method(params): ReturnType",
          "name": "meta.function.associated.quartz",
          "match": "\\b(def)\\s+([A-Z][a-zA-Z0-9_]*)(\\.)(([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?))",
          "captures": {
            "1": { "name": "keyword.declaration.function.quartz" },
            "2": { "name": "entity.name.type.quartz" },
            "3": { "name": "punctuation.accessor.dot.quartz" },
            "4": { "name": "entity.name.function.quartz" }
          }
        },
        {
          "comment": "Generic function: def name<T>(params): ReturnType",
          "name": "meta.function.generic.quartz",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?)(<)",
          "captures": {
            "1": { "name": "keyword.declaration.function.quartz" },
            "2": { "name": "entity.name.function.quartz" },
            "3": { "name": "punctuation.definition.typeparameters.begin.quartz" }
          }
        },
        {
          "comment": "Regular function: def name(params): ReturnType",
          "name": "meta.function.quartz",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?)",
          "captures": {
            "1": { "name": "keyword.declaration.function.quartz" },
            "2": { "name": "entity.name.function.quartz" }
          }
        }
      ]
    },
    "extern-declaration": {
      "patterns": [
        {
          "comment": "Extern function: extern \"C\" def/fn name(...)",
          "name": "meta.extern.quartz",
          "match": "\\b(extern)\\s+(\"C\")\\s+(def|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.extern.quartz" },
            "2": { "name": "string.quoted.double.quartz" },
            "3": { "name": "keyword.declaration.function.quartz" },
            "4": { "name": "entity.name.function.extern.quartz" }
          }
        },
        {
          "comment": "Extern variable: extern var name",
          "name": "meta.extern.quartz",
          "match": "\\b(extern)\\s+(var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.extern.quartz" },
            "2": { "name": "keyword.declaration.quartz" },
            "3": { "name": "variable.other.quartz" }
          }
        }
      ]
    },
    "struct-definition": {
      "name": "meta.struct.quartz",
      "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.struct.quartz" },
        "2": { "name": "entity.name.type.struct.quartz" }
      }
    },
    "enum-definition": {
      "name": "meta.enum.quartz",
      "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.enum.quartz" },
        "2": { "name": "entity.name.type.enum.quartz" }
      }
    },
    "trait-definition": {
      "name": "meta.trait.quartz",
      "match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.trait.quartz" },
        "2": { "name": "entity.name.type.trait.quartz" }
      }
    },
    "impl-block": {
      "patterns": [
        {
          "comment": "Generic impl: impl Trait<T> for Type",
          "name": "meta.impl.quartz",
          "match": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)(<[^>]*>)\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.quartz" },
            "2": { "name": "entity.name.type.trait.quartz" },
            "3": { "name": "punctuation.definition.typeparameters.quartz" },
            "4": { "name": "keyword.declaration.for.quartz" },
            "5": { "name": "entity.name.type.quartz" }
          }
        },
        {
          "comment": "Plain impl: impl Trait for Type",
          "name": "meta.impl.quartz",
          "match": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.quartz" },
            "2": { "name": "entity.name.type.trait.quartz" },
            "3": { "name": "keyword.declaration.for.quartz" },
            "4": { "name": "entity.name.type.quartz" }
          }
        },
        {
          "comment": "Bare impl: impl Type",
          "name": "meta.impl.quartz",
          "match": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.quartz" },
            "2": { "name": "entity.name.type.quartz" }
          }
        }
      ]
    },
    "extend-block": {
      "name": "meta.extend.quartz",
      "match": "\\b(extend)\\s+([A-Z][a-zA-Z0-9_<>, ]*)",
      "captures": {
        "1": { "name": "keyword.declaration.extend.quartz" },
        "2": { "name": "entity.name.type.quartz" }
      }
    },
    "type-alias": {
      "name": "meta.type-alias.quartz",
      "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.declaration.type.quartz" },
        "2": { "name": "entity.name.type.alias.quartz" },
        "3": { "name": "keyword.operator.assignment.quartz" }
      }
    },
    "newtype": {
      "name": "meta.newtype.quartz",
      "match": "\\b(newtype)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.declaration.newtype.quartz" },
        "2": { "name": "entity.name.type.newtype.quartz" },
        "3": { "name": "keyword.operator.assignment.quartz" }
      }
    },
    "macro-definition": {
      "name": "meta.macro.quartz",
      "match": "\\b(macro)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.macro.quartz" },
        "2": { "name": "entity.name.function.macro.quartz" }
      }
    },
    "numeric-literals": {
      "patterns": [
        {
          "name": "constant.numeric.float.quartz",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?(?:_?f(?:32|64))?\\b"
        },
        {
          "name": "constant.numeric.hex.quartz",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.quartz",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.quartz",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.quartz",
          "match": "\\b[0-9][0-9_]*(?:_?(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64))?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.quartz",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.quartz",
          "match": "\\b(nil)\\b"
        },
        {
          "name": "variable.other.constant.quartz",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "support.type.builtin.quartz",
          "match": "\\b(Int|String|Bool|Void|F64|F32|Float64|Float32|Float|Never|Nil)\\b"
        },
        {
          "name": "support.type.collection.quartz",
          "match": "\\b(Vec|HashMap|IntMap|Set|Array|StringBuilder)\\b"
        },
        {
          "name": "support.type.option-result.quartz",
          "match": "\\b(Option|Result|Some|None|Ok|Err)\\b"
        },
        {
          "name": "support.type.pointer.quartz",
          "match": "\\b(CPtr|CInt|CLong|CChar|CSize)\\b"
        },
        {
          "name": "support.type.function.quartz",
          "match": "\\b(Fn)\\b"
        },
        {
          "name": "support.type.other.quartz",
          "match": "\\b(Regex|Arena|Mutex|Channel|TaskGroup)\\b"
        },
        {
          "comment": "Optional type shorthand T? (desugars to Option<T>)",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(\\?)",
          "captures": {
            "1": { "name": "support.type.optional.quartz" },
            "2": { "name": "keyword.operator.optional.quartz" }
          }
        },
        {
          "comment": "User-defined type names (PascalCase)",
          "name": "entity.name.type.quartz",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(?=\\s*(?:<|\\{|\\.|::))"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": "Module-qualified call with $",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\$([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.quartz" },
            "2": { "name": "entity.name.function.quartz" }
          }
        },
        {
          "comment": "Enum variant access (Type::Variant)",
          "match": "([A-Z][a-zA-Z0-9_]*)(::)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.quartz" },
            "2": { "name": "punctuation.accessor.double-colon.quartz" },
            "3": { "name": "variable.other.enummember.quartz" }
          }
        },
        {
          "comment": "Regular function call",
          "match": "([a-zA-Z_][a-zA-Z0-9_$]*(?:[?!])?)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.quartz" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.quartz",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.quartz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.regex.quartz",
          "match": "=~\\?|=~|!~"
        },
        {
          "name": "keyword.operator.assignment.compound.quartz",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|="
        },
        {
          "name": "keyword.operator.assignment.quartz",
          "match": "="
        },
        {
          "name": "keyword.operator.pipeline.quartz",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.safe-navigation.quartz",
          "match": "\\?\\.|\\?\\?"
        },
        {
          "name": "keyword.operator.range.quartz",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.bitwise.quartz",
          "match": "<<|>>|\\^|~|&(?!&)|\\|(?!\\||>)"
        },
        {
          "name": "keyword.operator.arithmetic.quartz",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.quartz",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.quartz",
          "match": "\\."
        },
        {
          "name": "punctuation.section.parens.begin.quartz",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.quartz",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.quartz",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.quartz",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.quartz",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.quartz",
          "match": "\\}"
        },
        {
          "name": "punctuation.terminator.colon.quartz",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Identifier ending with ? (predicate)",
          "name": "entity.name.function.predicate.quartz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\?"
        },
        {
          "comment": "Identifier ending with ! (mutating)",
          "name": "entity.name.function.mutating.quartz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!"
        },
        {
          "comment": "Generic identifier",
          "name": "variable.other.quartz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_$]*\\b"
        }
      ]
    }
  }
}
