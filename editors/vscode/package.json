{
  "name": "quartz-lang",
  "displayName": "Quartz Language",
  "description": "Language server, syntax highlighting, snippets, and format-on-save for the Quartz programming language",
  "version": "0.2.0",
  "publisher": "quartz-lang",
  "license": "MIT",
  "homepage": "https://github.com/quartz-lang/quartz",
  "bugs": {
    "url": "https://github.com/quartz-lang/quartz/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-lang/quartz"
  },
  "icon": "icons/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "quartz",
    "qz",
    "systems programming",
    "llvm",
    "self-hosted"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:quartz",
    "workspaceContains:**/*.qz",
    "workspaceContains:Quakefile.qz"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quartz",
        "aliases": [
          "Quartz",
          "quartz",
          "qz"
        ],
        "extensions": [
          ".qz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/quartz-light.png",
          "dark": "./icons/quartz-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "quartz",
        "scopeName": "source.quartz",
        "path": "./syntaxes/quartz.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quartz",
        "path": "./snippets/quartz.json"
      }
    ],
    "commands": [
      {
        "command": "quartz.run",
        "title": "Run Current File",
        "category": "Quartz"
      },
      {
        "command": "quartz.build",
        "title": "Build Project",
        "category": "Quartz"
      },
      {
        "command": "quartz.test",
        "title": "Run Tests",
        "category": "Quartz"
      },
      {
        "command": "quartz.format",
        "title": "Format Document",
        "category": "Quartz"
      }
    ],
    "keybindings": [
      {
        "command": "quartz.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == quartz"
      },
      {
        "command": "quartz.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == quartz"
      },
      {
        "command": "quartz.test",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == quartz"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "quartz.run",
          "when": "resourceLangId == quartz",
          "group": "navigation@1"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "quartz",
        "owner": "quartz",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(error|warning)\\[(\\w+)\\]:\\s+(.+)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s+(.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "quake",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Quake task to run (e.g., build, qspec, format)"
          }
        }
      }
    ],
    "configuration": {
      "title": "Quartz",
      "properties": {
        "quartz.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run quartz --format on save"
        },
        "quartz.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the quartz compiler binary. If empty, searches PATH for 'quartz'."
        },
        "quartz.quakePath": {
          "type": "string",
          "default": "",
          "description": "Path to the quake build tool binary. If empty, searches PATH for 'quake'."
        },
        "quartz.formatArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments to pass to the formatter"
        },
        "quartz.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Quartz Language Server for diagnostics, hover, completion, and more."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
