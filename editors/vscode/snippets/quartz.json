{
  "Function Definition": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:params}): ${3:ReturnType}",
      "  ${0}",
      "end"
    ],
    "description": "Define a function"
  },
  "Endless Function": {
    "prefix": "defe",
    "body": [
      "def ${1:name}(${2:params}): ${3:ReturnType} = ${0}"
    ],
    "description": "Define a single-expression function (endless def)"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "def main(): Int",
      "  ${0}",
      "  return 0",
      "end"
    ],
    "description": "Define the main entry point"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "  ${2:field}: ${3:Type}",
      "end"
    ],
    "description": "Define a struct"
  },
  "Generic Struct": {
    "prefix": "structg",
    "body": [
      "struct ${1:Name}<${2:T}>",
      "  ${3:field}: ${4:T}",
      "end"
    ],
    "description": "Define a generic struct"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}",
      "  ${2:Variant1}",
      "  ${3:Variant2}",
      "end"
    ],
    "description": "Define an enum"
  },
  "Enum with Payload": {
    "prefix": "enump",
    "body": [
      "enum ${1:Name}",
      "  ${2:Variant1}(${3:field}: ${4:Type})",
      "  ${5:Variant2}",
      "end"
    ],
    "description": "Define an enum with payload variants"
  },
  "Generic Enum": {
    "prefix": "enumg",
    "body": [
      "enum ${1:Name}<${2:T}>",
      "  ${3:Some}(value: ${2:T})",
      "  ${4:None}",
      "end"
    ],
    "description": "Define a generic enum"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:expr}",
      "  ${2:pattern} => ${3:result}",
      "  _ => ${0:default}",
      "end"
    ],
    "description": "Pattern match expression"
  },
  "For..in Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10}",
      "  ${0}",
      "end"
    ],
    "description": "For..in range loop"
  },
  "For..in Collection": {
    "prefix": "forc",
    "body": [
      "for ${1:item} in ${2:collection}",
      "  ${0}",
      "end"
    ],
    "description": "For..in collection loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "  ${0}",
      "end"
    ],
    "description": "While loop"
  },
  "If Block": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "  ${0}",
      "end"
    ],
    "description": "If conditional block"
  },
  "If/Else Block": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}",
      "  ${2}",
      "else",
      "  ${0}",
      "end"
    ],
    "description": "If/else conditional block"
  },
  "If/Elsif/Else Block": {
    "prefix": "ifee",
    "body": [
      "if ${1:condition}",
      "  ${2}",
      "elsif ${3:condition}",
      "  ${4}",
      "else",
      "  ${0}",
      "end"
    ],
    "description": "If/elsif/else conditional block"
  },
  "Unless Block": {
    "prefix": "unless",
    "body": [
      "unless ${1:condition}",
      "  ${0}",
      "end"
    ],
    "description": "Unless (negated if) block"
  },
  "Trait Definition": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name}",
      "  def ${2:method}(self${3:, other: Self}): ${4:Bool}",
      "    ${0}",
      "  end",
      "end"
    ],
    "description": "Define a trait"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type}",
      "  def ${3:method}(self${4:, other: $2}): ${5:Bool}",
      "    ${0}",
      "  end",
      "end"
    ],
    "description": "Implement a trait for a type"
  },
  "Extend Block": {
    "prefix": "extend",
    "body": [
      "extend ${1:Type}",
      "  def ${2:method}(): ${3:ReturnType} = ${0}",
      "end"
    ],
    "description": "Extend a type with new methods"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "import ${0:module}"
    ],
    "description": "Import a module"
  },
  "Import From": {
    "prefix": "from",
    "body": [
      "from ${1:module} import ${0:items}"
    ],
    "description": "Import specific items from a module"
  },
  "Import Wildcard": {
    "prefix": "importw",
    "body": [
      "import * from ${0:module}"
    ],
    "description": "Import all items from a module"
  },
  "Lambda (Arrow)": {
    "prefix": "fn",
    "body": [
      "${1:x} -> ${0:expr}"
    ],
    "description": "Arrow lambda expression"
  },
  "Lambda (Multi-param)": {
    "prefix": "fnm",
    "body": [
      "(${1:x}, ${2:y}) -> ${0:expr}"
    ],
    "description": "Multi-parameter arrow lambda"
  },
  "Do Block": {
    "prefix": "do",
    "body": [
      "do ${1:x} ->",
      "  ${0}",
      "end"
    ],
    "description": "Do..end block with parameter"
  },
  "Type Alias": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${0:Type}"
    ],
    "description": "Type alias"
  },
  "Newtype": {
    "prefix": "newtype",
    "body": [
      "newtype ${1:Name} = ${0:Type}"
    ],
    "description": "Newtype definition"
  },
  "Const Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${0:value}"
    ],
    "description": "Compile-time constant"
  },
  "Const Function": {
    "prefix": "constdef",
    "body": [
      "const def ${1:name}(${2:params}): ${3:ReturnType} = ${0:expr}"
    ],
    "description": "Compile-time constant function"
  },
  "Extern C Function": {
    "prefix": "extern",
    "body": [
      "extern \"C\" def ${1:name}(${2:params}): ${0:ReturnType}"
    ],
    "description": "External C function declaration"
  },
  "Defer": {
    "prefix": "defer",
    "body": [
      "defer ${0:cleanup_call()}"
    ],
    "description": "Defer statement (runs at function exit)"
  },
  "Macro Definition": {
    "prefix": "macro",
    "body": [
      "macro ${1:name}(${2:args}) do",
      "  quote do",
      "    ${0}",
      "  end",
      "end"
    ],
    "description": "Macro definition with quote/unquote"
  },
  "QSpec Test File": {
    "prefix": "test",
    "body": [
      "import * from qspec",
      "",
      "def main(): Int",
      "  describe(\"${1:feature}\") do ctx ->",
      "    it(ctx, \"${2:does something}\") do ->",
      "      assert_eq(${3:actual}, ${4:expected})",
      "    end",
      "",
      "    ${0}",
      "  end",
      "",
      "  return qspec_main()",
      "end"
    ],
    "description": "QSpec test file template"
  },
  "QSpec It Block": {
    "prefix": "it",
    "body": [
      "it(ctx, \"${1:description}\") do ->",
      "  ${0}",
      "end"
    ],
    "description": "QSpec test case"
  },
  "QSpec Pending": {
    "prefix": "itp",
    "body": [
      "it_pending(ctx, \"${0:todo description}\")"
    ],
    "description": "QSpec pending test"
  },
  "QSpec Assert Eq": {
    "prefix": "aeq",
    "body": [
      "assert_eq(${1:actual}, ${2:expected})"
    ],
    "description": "Assert integer equality"
  },
  "QSpec Assert Eq String": {
    "prefix": "aeqs",
    "body": [
      "assert_eq_str(${1:actual}, ${2:expected})"
    ],
    "description": "Assert string equality"
  },
  "QSpec Assert Output": {
    "prefix": "aout",
    "body": [
      "assert_output(\"${1:expected output}\", ${2:helper_fn})"
    ],
    "description": "Assert stdout output (use named helper function)"
  },
  "Vec New": {
    "prefix": "vec",
    "body": [
      "var ${1:v} = vec_new()",
      "${0}"
    ],
    "description": "Create new vector"
  },
  "HashMap New": {
    "prefix": "hmap",
    "body": [
      "var ${1:m} = hashmap_new()",
      "${0}"
    ],
    "description": "Create new hashmap"
  },
  "StringBuilder": {
    "prefix": "sb",
    "body": [
      "var ${1:sb} = sb_new()",
      "${2:sb}.append(${0})",
      "defer sb_free(${2:sb})"
    ],
    "description": "Create and use a StringBuilder"
  },
  "Doc Comment": {
    "prefix": "doc",
    "body": [
      "## ${1:Brief description.}",
      "##",
      "## @param ${2:name} ${3:description}",
      "## @returns ${0:description}"
    ],
    "description": "Documentation comment"
  },
  "Module Doc Comment": {
    "prefix": "moddoc",
    "body": [
      "##! # ${1:Module Name}",
      "##!",
      "##! ${0:Description of the module.}"
    ],
    "description": "Module documentation comment"
  },
  "Cfg Attribute": {
    "prefix": "cfg",
    "body": [
      "@cfg(${1:os}: \"${2:macos}\")"
    ],
    "description": "Conditional compilation attribute"
  },
  "Repr C Struct": {
    "prefix": "reprc",
    "body": [
      "@repr(C)",
      "struct ${1:Name}",
      "  ${2:field}: ${3:CInt}",
      "end"
    ],
    "description": "C-compatible struct"
  },
  "Try Macro": {
    "prefix": ["try!", "dtry"],
    "body": [
      "\\$try(${0:expr})"
    ],
    "description": "$try macro (unwrap Option/Result, early return None/Err)"
  },
  "Unwrap Macro": {
    "prefix": ["unwrap!", "dunwrap"],
    "body": [
      "\\$unwrap(${0:expr})"
    ],
    "description": "$unwrap macro (panic on None)"
  },
  "Assert Macro": {
    "prefix": ["assert!", "dassert"],
    "body": [
      "\\$assert(${0:condition})"
    ],
    "description": "$assert macro (panic if false)"
  },
  "Debug Macro": {
    "prefix": ["debug!", "ddebug"],
    "body": [
      "\\$debug(${0:expr})"
    ],
    "description": "$debug macro (print to stderr, return value)"
  },
  "Async Expression": {
    "prefix": "async",
    "body": [
      "async ${0:expr}"
    ],
    "description": "Async expression (returns eager Future)"
  },
  "Await Handle": {
    "prefix": "await",
    "body": [
      "await ${0:handle}"
    ],
    "description": "Await a Future or Task handle"
  },
  "Go Task": {
    "prefix": "go",
    "body": [
      "go ${0:expr}"
    ],
    "description": "Spawn a concurrent task"
  },
  "For Await Channel": {
    "prefix": "forawait",
    "body": [
      "for await ${1:msg} in ${2:channel}",
      "  ${0}",
      "end"
    ],
    "description": "For await loop over a channel"
  },
  "Select Statement": {
    "prefix": "sel",
    "body": [
      "select",
      "  ${1:channel} => ${2:handler}",
      "  ${0}",
      "end"
    ],
    "description": "Select over multiple channels"
  },
  "Channel Creation": {
    "prefix": "chan",
    "body": [
      "var ${1:ch} = channel_new(${0:capacity})"
    ],
    "description": "Create a new channel"
  },
  "Generator Function": {
    "prefix": "gen",
    "body": [
      "def ${1:name}(${2:params}): impl Iterator<${3:Int}>",
      "  ${0}",
      "  yield ${4:value}",
      "end"
    ],
    "description": "Generator function with yield"
  },
  "Match with Range": {
    "prefix": "matchr",
    "body": [
      "match ${1:expr}",
      "  ${2:0}..${3:10} => ${4:result}",
      "  _ => ${0:default}",
      "end"
    ],
    "description": "Pattern match with range patterns"
  },
  "Optional Return Function": {
    "prefix": "defopt",
    "body": [
      "def ${1:name}(${2:params}): ${3:Int}?",
      "  ${0}",
      "end"
    ],
    "description": "Function returning optional type T?"
  },
  "Multi-Clause Function": {
    "prefix": "defm",
    "body": [
      "def ${1:name}(${2:0}) = ${3:base_case}",
      "def ${1:name}(${4:n}) = ${0:recursive_case}"
    ],
    "description": "Multi-clause function definition (pattern matching on arguments)"
  },
  "Infinite Loop": {
    "prefix": "loop",
    "body": [
      "loop",
      "  ${0}",
      "end"
    ],
    "description": "Infinite loop"
  },
  "Match Option": {
    "prefix": "matchopt",
    "body": [
      "match ${1:expr}",
      "  Some(${2:v}) => ${3}",
      "  None => ${0}",
      "end"
    ],
    "description": "Match on Option (Some/None)"
  },
  "Match Result": {
    "prefix": "matchres",
    "body": [
      "match ${1:expr}",
      "  Ok(${2:v}) => ${3}",
      "  Err(${4:e}) => ${0}",
      "end"
    ],
    "description": "Match on Result (Ok/Err)"
  },
  "Derive Attribute": {
    "prefix": "derive",
    "body": [
      "@derive(${0:Trait})"
    ],
    "description": "Derive attribute"
  },
  "Task Group": {
    "prefix": "taskgroup",
    "body": [
      "task_group |${1:g}|",
      "  ${0}",
      "end"
    ],
    "description": "Task group block"
  },
  "C Import": {
    "prefix": "cimport",
    "body": [
      "cimport \"${0:header.h}\""
    ],
    "description": "C header import"
  },
  "Impl Type": {
    "prefix": "impltype",
    "body": [
      "impl ${1:Type}",
      "  def ${2:method}(self): ${3:ReturnType}",
      "    ${0}",
      "  end",
      "end"
    ],
    "description": "Bare impl block for a type"
  }
}
