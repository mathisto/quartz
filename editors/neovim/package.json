{
  "name": "tree-sitter-quartz",
  "version": "0.1.0",
  "description": "TreeSitter parser for the Quartz programming language",
  "main": "grammar.js",
  "keywords": ["quartz", "tree-sitter", "parser"],
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-lang/tree-sitter-quartz"
  },
  "license": "MIT",
  "tree-sitter": [
    {
      "scope": "source.quartz",
      "file-types": ["qz"],
      "highlights": "queries/highlights.scm",
      "indents": "queries/indents.scm"
    }
  ]
}
