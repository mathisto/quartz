## QSpec Property Testing - forall sugar with generators and shrinking
##
## First-class property-based testing for Quartz.
## No mainstream systems language has this built into its test framework.
##
## Usage:
##   import qspec
##   import qspec/property
##
##   describe("addition") do ->
##     forall_ii(ctx, "is commutative") do x: Int, y: Int ->
##       assert_eq(x + y, y + x)
##     end
##   end

import * from colors
import qspec/matchers
import qspec/runner

# =============================================================================
# Random Number Generation (LCG)
# =============================================================================

# Linear congruential generator state
_rng_state = vec_new()

def _init_rng(): Void
  if vec_size(_rng_state) == 0
    # Seed with a fixed value (deterministic by default for reproducibility)
    vec_push(_rng_state, 12345678)
  end
end

## Seed the RNG with a specific value
def qspec_seed(seed: Int): Void
  _init_rng()
  vec_set(_rng_state, 0, seed)
end

## Generate next pseudo-random integer
def gen_next(): Int
  _init_rng()
  var state = vec_get(_rng_state, 0)
  # LCG: state = (state * 6364136223846793005 + 1442695040888963407) mod 2^63
  # Simplified for i64: multiply, add, mask
  state = state * 6364136223846793 + 1442695040888963
  if state < 0
    state = 0 - state
  end
  vec_set(_rng_state, 0, state)
  return state
end

## Generate random Int in [lo, hi] inclusive
def gen_int(lo: Int, hi: Int): Int
  var range = hi - lo + 1
  if range <= 0
    return lo
  end
  var r = gen_next() % range
  if r < 0
    r = 0 - r
  end
  return lo + r
end

## Generate random non-negative Int up to max
def gen_nat(max: Int): Int
  return gen_int(0, max)
end

## Generate random Bool
def gen_bool(): Bool
  return gen_int(0, 1) == 1
end

## Generate random String of given max length
def gen_string(max_len: Int): String
  var len = gen_int(0, max_len)
  var sb = sb_new()
  var i = 0
  while i < len
    # Printable ASCII: 32-126
    sb.append_char(gen_int(32, 126))
    i += 1
  end
  return sb.to_string()
end

## Generate random Vec<Int> of given max length, with values in [lo, hi]
def gen_vec_int(max_len: Int, lo: Int, hi: Int): Int
  var len = gen_int(0, max_len)
  var v = vec_new()
  var i = 0
  while i < len
    v.push(gen_int(lo, hi))
    i += 1
  end
  return v
end

# =============================================================================
# Shrinking
# =============================================================================

## Shrink an Int toward zero
def shrink_int(value: Int): Int
  # Returns a vec of candidate shrinks, ordered from most shrunk to least
  var candidates = vec_new()
  if value == 0
    return candidates
  end

  # Always try 0
  vec_push(candidates, 0)

  # Try halving toward zero
  var half = value / 2
  if half != 0 and half != value
    vec_push(candidates, half)
  end

  # Try subtracting 1
  if value > 0
    vec_push(candidates, value - 1)
  elsif value < 0
    vec_push(candidates, value + 1)
  end

  return candidates
end

# =============================================================================
# Property Test Configuration
# =============================================================================

var _PROPERTY_ITERATIONS = 100
_MAX_SHRINK_STEPS = 50

def qspec_set_iterations(n: Int): Void
  _PROPERTY_ITERATIONS = n
end

# =============================================================================
# forall — Single Int parameter
# =============================================================================

## Property test: forall x: Int in default range
def forall_i(name: String, prop: Fn(Int): Void): Void
  it(name, -> _run_forall_i(name, prop))
end

priv def _run_forall_i(name: String, prop: Fn(Int): Void): Void
  var assertion_count = matcher_assertion_count()
  var failure_count = matcher_failure_count()
  var i = 0
  while i < _PROPERTY_ITERATIONS
    var x = gen_int(-10000, 10000)
    _property_reset(assertion_count, failure_count)
    prop(x)
    if matcher_failure_count() > failure_count
      # Property failed — try to shrink
      var shrunk = _shrink_i(x, prop, assertion_count, failure_count)
      var sb = sb_new()
      sb.append("Property failed after ")
      sb.append((i + 1).to_s())
      sb.append(" cases. Shrunk to: x = ")
      sb.append(shrunk.to_s())
      # Re-run with shrunk value to get the actual failure message
      _property_reset(assertion_count, failure_count)
      prop(shrunk)
      if matcher_failure_count() > failure_count
        sb.append(" | ")
        sb.append(matcher_get_failure(failure_count))
      end
      _property_reset(assertion_count, failure_count)
      _inc_assertions()
      _record_failure(sb.to_string())
      return
    end
    i += 1
  end
  _property_reset(assertion_count, failure_count)
  _inc_assertions()
end

priv def _property_reset(assertion_count: Int, failure_count: Int): Void
  _matcher_restore(assertion_count, failure_count)
end

priv def _shrink_i(failing: Int, prop: Fn(Int): Void, assertion_count: Int, failure_count: Int): Int
  var current = failing
  var step = 0
  while step < _MAX_SHRINK_STEPS
    var candidates = shrink_int(current)
    var improved = false
    var j = 0
    while j < vec_size(candidates)
      var candidate = vec_get(candidates, j)
      _property_reset(assertion_count, failure_count)
      prop(candidate)
      if matcher_failure_count() > failure_count
        current = candidate
        improved = true
        break
      end
      j += 1
    end
    if not improved
      break
    end
    step += 1
  end
  return current
end

# =============================================================================
# forall — Two Int parameters
# =============================================================================

## Property test: forall x: Int, y: Int
def forall_ii(name: String, prop: Fn(Int, Int): Void): Void
  it(name, -> _run_forall_ii(name, prop))
end

priv def _run_forall_ii(name: String, prop: Fn(Int, Int): Void): Void
  var assertion_count = matcher_assertion_count()
  var failure_count = matcher_failure_count()
  var i = 0
  while i < _PROPERTY_ITERATIONS
    var x = gen_int(-10000, 10000)
    var y = gen_int(-10000, 10000)
    _property_reset(assertion_count, failure_count)
    prop(x, y)
    if matcher_failure_count() > failure_count
      # Shrink both parameters
      var shrunk = _shrink_ii(x, y, prop, assertion_count, failure_count)
      var sx = vec_get(shrunk, 0)
      var sy = vec_get(shrunk, 1)
      var sb = sb_new()
      sb.append("Property failed after ")
      sb.append((i + 1).to_s())
      sb.append(" cases. Shrunk to: x = ")
      sb.append(sx.to_s())
      sb.append(", y = ")
      sb.append(sy.to_s())
      _property_reset(assertion_count, failure_count)
      prop(sx, sy)
      if matcher_failure_count() > failure_count
        sb.append(" | ")
        sb.append(matcher_get_failure(failure_count))
      end
      _property_reset(assertion_count, failure_count)
      _inc_assertions()
      _record_failure(sb.to_string())
      return
    end
    i += 1
  end
  _property_reset(assertion_count, failure_count)
  _inc_assertions()
end

priv def _shrink_ii(x: Int, y: Int, prop: Fn(Int, Int): Void, assertion_count: Int, failure_count: Int): Int
  var result = vec_new()
  var cx = x
  var cy = y
  var step = 0
  while step < _MAX_SHRINK_STEPS
    var improved = false

    # Try shrinking x
    var x_cands = shrink_int(cx)
    var j = 0
    while j < vec_size(x_cands)
      var cand = vec_get(x_cands, j)
      _property_reset(assertion_count, failure_count)
      prop(cand, cy)
      if matcher_failure_count() > failure_count
        cx = cand
        improved = true
        break
      end
      j += 1
    end

    # Try shrinking y
    var y_cands = shrink_int(cy)
    j = 0
    while j < vec_size(y_cands)
      var cand = vec_get(y_cands, j)
      _property_reset(assertion_count, failure_count)
      prop(cx, cand)
      if matcher_failure_count() > failure_count
        cy = cand
        improved = true
        break
      end
      j += 1
    end

    if not improved
      break
    end
    step += 1
  end
  result.push(cx)
  result.push(cy)
  return result
end

# =============================================================================
# Property Helpers (convenience)
# =============================================================================

## Test that a function is commutative: f(a, b) == f(b, a)
def property_commutative(name: String, f: Fn(Int, Int): Int): Void
  forall_ii(name) do x: Int, y: Int ->
    assert_eq(f(x, y), f(y, x))
  end
end

## Test that a function has an identity element: f(x, e) == x
def property_identity(name: String, f: Fn(Int, Int): Int, identity: Int): Void
  forall_i(name) do x: Int ->
    assert_eq(f(x, identity), x)
  end
end

## Test idempotence: f(f(x)) == f(x)
def property_idempotent(name: String, f: Fn(Int): Int): Void
  forall_i(name) do x: Int ->
    assert_eq(f(f(x)), f(x))
  end
end
