# =============================================================================
# Timeout-Wrapped Run — for scheduler programs that may hang/OOM
# =============================================================================

## Run a compiled Quartz program with a timeout to prevent hangs.
## If the program doesn't exit within _sub_timeout_secs, it is killed.
## Returns exit code 124 for compatibility; `SubResult.supervision` is the
## authority that distinguishes a deadline from a program's normal exit 124.
def subprocess_run_with_timeout(source: String): SubResult
  _sub_begin_result()
  var compiler = _sub_compiler_str
  if str_byte_len(compiler) == 0
    return _sub_result(-1, "", "QUARTZ_COMPILER not set")
  end

  var id = _sub_next_id()
  var src = _sub_tmp(id, ".qz")
  var ir = _sub_tmp(id, ".ll")
  var cerr = _sub_tmp(id, ".cerr")
  var rout = _sub_tmp(id, ".out")
  var rerr = _sub_tmp(id, ".rerr")

  write_file(src, source)

  # Step 1: Compile under the same bounded stage supervisor.
  var sb = sb_new()
  sb_append(sb, compiler)
  sb_append(sb, " --no-cache")
  var std_path = _sub_std_str
  if str_byte_len(std_path) > 0
    sb_append(sb, " -I ")
    sb_append(sb, std_path)
  end
  sb_append(sb, " ")
  sb_append(sb, src)
  sb_append(sb, " > ")
  sb_append(sb, ir)
  sb_append(sb, " 2> ")
  sb_append(sb, cerr)

  var compile_raw = _sub_stage_raw(_sub_supervised("nested-compile", id, _sub_compile_argv(src, "", ""), vec_new<String>(), vec_new<String>(), ir, cerr, false))
  if band(compile_raw, 127) != 0 or band(shr(compile_raw, 8), 255) != 0
    var cerr_content = read_file(cerr)
    file_delete(src)
    file_delete(ir)
    file_delete(cerr)
    return _sub_result(-1, "", "compilation failed: " + cerr_content)
  end

  # Step 2: native compile (llc -O0) → link → run (timeout-wrapped)
  var ir_content = read_file(ir)
  var obj = _sub_tmp(id, ".o")
  var bin = _sub_tmp(id, ".bin")
  var run_exit = _sub_native_run(ir, ir_content, obj, bin, rout, rerr)
  if run_exit == -2 or run_exit == -3
    var fail_msg = "llc failed"
    if run_exit == -3
      fail_msg = "link failed"
    end
    file_delete(src)
    file_delete(ir)
    file_delete(cerr)
    return _sub_result(-1, "", fail_msg)
  end

  var stdout_content = read_file(rout)
  var stderr_content = read_file(rerr)

  file_delete(src)
  file_delete(ir)
  file_delete(cerr)
  file_delete(rout)
  file_delete(rerr)

  return _sub_result(run_exit, stdout_content, stderr_content)
end

## Assert that program exits with specific exit code (with timeout).
def assert_run_exits_timeout(source: String, code: Int): Void
  _inc_assertions()
  var r = subprocess_run_with_timeout(source)
  if r.exit_code == -1
    var sb = sb_new()
    sb_append(sb, "Failed to compile/run: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
    return
  end
  if r.exit_code != code
    var sb = sb_new()
    sb_append(sb, "Expected exit code ")
    sb_append(sb, str_from_int(code))
    sb_append(sb, " but got ")
    sb_append(sb, str_from_int(r.exit_code))
    _record_failure(sb_to_string(sb))
  end
end

# =============================================================================
# Multi-File Compilation Support
# =============================================================================

## Create a temp directory path for multi-file compilation.
def _sub_multi_dir(id: Int): String
  var sb = sb_new()
  sb_append(sb, _sub_root_str)
  sb_append(sb, "/_qspec_multi_")
  sb_append(sb, str_from_int(_sub_pid))
  sb_append(sb, "_")
  sb_append(sb, str_from_int(id))
  return sb_to_string(sb)
end

def _sub_valid_relative_path(path: String): Bool
  if str_byte_len(path) == 0 or str_starts_with(path, "/")
    return false
  end
  var parts = str_split(path, "/")
  for i in 0..parts.size
    var part = parts[i]
    if str_byte_len(part) == 0 or part == "." or part == ".."
      return false
    end
    for j in 0..str_byte_len(part)
      var ch = str_byte_at(part, j)
      var safe = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-' or ch == '.'
      if not safe
        return false
      end
    end
  end
  return true
end

## Write multi-file sources to a temp directory.
## files: Vec with alternating [filename, source] pairs.
## main_idx: which pair (0-based) is the main file.
## Returns: Vec of [dir_path, main_file_path] as int handles.
def _sub_write_multi(files: Vec, main_idx: Int): Vec
  _sub_init()
  var invalid: Vec = vec_new()
  if vec_size(files) == 0 or vec_size(files) % 2 != 0 or main_idx < 0 or main_idx >= vec_size(files) / 2
    return invalid
  end
  var check_idx = 0
  while check_idx < vec_size(files)
    if not _sub_valid_relative_path(as_string(vec_get(files, check_idx)))
      return invalid
    end
    check_idx += 2
  end
  var id = _sub_next_id()
  var dir = _sub_multi_dir(id)
  mkdir(dir)

  var main_path = ""
  var i = 0
  while i < vec_size(files)
    var fname = as_string(vec_get(files, i))
    var src = as_string(vec_get(files, i + 1))
    if str_contains(fname, "/")
      var subdir_sb = sb_new()
      sb_append(subdir_sb, dir)
      sb_append(subdir_sb, "/")
      sb_append(subdir_sb, path_dir(fname))
      mkdir(sb_to_string(subdir_sb))
    end
    var fpath_sb = sb_new()
    sb_append(fpath_sb, dir)
    sb_append(fpath_sb, "/")
    sb_append(fpath_sb, fname)
    var fpath = sb_to_string(fpath_sb)
    write_file(fpath, src)
    if i / 2 == main_idx
      main_path = fpath
    end
    i = i + 2
  end

  var result: Vec = vec_new()
  result.push(as_int(dir))
  result.push(as_int(main_path))
  return result
end

## Clean up multi-file temp directory.
def _sub_cleanup_multi(dir: String, files: Vec): Void
  var i = 0
  while i < vec_size(files)
    var fname = as_string(vec_get(files, i))
    var sb = sb_new()
    sb_append(sb, dir)
    sb_append(sb, "/")
    sb_append(sb, fname)
    file_delete(sb_to_string(sb))
    i = i + 2
  end
  var ir_sb = sb_new()
  sb_append(ir_sb, dir)
  sb_append(ir_sb, "/out.ll")
  file_delete(sb_to_string(ir_sb))
  var err_sb = sb_new()
  sb_append(err_sb, dir)
  sb_append(err_sb, "/out.err")
  file_delete(sb_to_string(err_sb))
  var rout_sb = sb_new()
  sb_append(rout_sb, dir)
  sb_append(rout_sb, "/run.out")
  file_delete(sb_to_string(rout_sb))
  var rerr_sb = sb_new()
  sb_append(rerr_sb, dir)
  sb_append(rerr_sb, "/run.err")
  file_delete(sb_to_string(rerr_sb))
  return
end

## Compile a multi-file project.
## files: Vec with alternating [filename, source] pairs.
## main_idx: which pair (0-based) is the main file to compile.
## Returns SubResult with IR in stdout_content, errors in stderr_content.
def subprocess_compile_multi(files: Vec, main_idx: Int): SubResult
  _sub_begin_result()
  var compiler = _sub_compiler_str
  if str_byte_len(compiler) == 0
    return _sub_result(-1, "", "QUARTZ_COMPILER not set")
  end

  var paths = _sub_write_multi(files, main_idx)
  if vec_size(paths) != 2
    return _sub_result(-1, "", "invalid multi-file relative path")
  end
  var dir = as_string(vec_get(paths, 0))
  var main_path = as_string(vec_get(paths, 1))

  var ir_sb = sb_new()
  sb_append(ir_sb, dir)
  sb_append(ir_sb, "/out.ll")
  var ir_path = sb_to_string(ir_sb)

  var err_sb = sb_new()
  sb_append(err_sb, dir)
  sb_append(err_sb, "/out.err")
  var err_path = sb_to_string(err_sb)

  var sb = sb_new()
  sb_append(sb, compiler)
  sb_append(sb, " --no-cache -I ")
  sb_append(sb, dir)
  var std_path = _sub_std_str
  if str_byte_len(std_path) > 0
    sb_append(sb, " -I ")
    sb_append(sb, std_path)
  end
  sb_append(sb, " ")
  sb_append(sb, main_path)
  sb_append(sb, " > ")
  sb_append(sb, ir_path)
  sb_append(sb, " 2> ")
  sb_append(sb, err_path)

  var raw = _sub_stage_raw(_sub_supervised("nested-compile", _sub_next_id(), _sub_compile_argv(main_path, "", dir), vec_new<String>(), vec_new<String>(), ir_path, err_path, false))
  var signaled = band(raw, 127)
  var exit_code = 0
  if signaled != 0
    exit_code = 128 + signaled
  else
    exit_code = band(shr(raw, 8), 255)
  end

  var ir_content = read_file(ir_path)
  var err_content = read_file(err_path)
  _sub_cleanup_multi(dir, files)

  return _sub_result(exit_code, ir_content, err_content)
end

## Compile and run a multi-file project.
## files: Vec with alternating [filename, source] pairs.
## main_idx: which pair (0-based) is the main file to compile.
def subprocess_run_multi(files: Vec, main_idx: Int): SubResult
  _sub_begin_result()
  var compiler = _sub_compiler_str
  if str_byte_len(compiler) == 0
    return _sub_result(-1, "", "QUARTZ_COMPILER not set")
  end

  var paths = _sub_write_multi(files, main_idx)
  if vec_size(paths) != 2
    return _sub_result(-1, "", "invalid multi-file relative path")
  end
  var dir = as_string(vec_get(paths, 0))
  var main_path = as_string(vec_get(paths, 1))

  var ir_sb = sb_new()
  sb_append(ir_sb, dir)
  sb_append(ir_sb, "/out.ll")
  var ir_path = sb_to_string(ir_sb)

  var err_sb = sb_new()
  sb_append(err_sb, dir)
  sb_append(err_sb, "/out.err")
  var err_path = sb_to_string(err_sb)

  # Step 1: Compile
  var sb = sb_new()
  sb_append(sb, compiler)
  sb_append(sb, " --no-cache -I ")
  sb_append(sb, dir)
  var std_path = _sub_std_str
  if str_byte_len(std_path) > 0
    sb_append(sb, " -I ")
    sb_append(sb, std_path)
  end
  sb_append(sb, " ")
  sb_append(sb, main_path)
  sb_append(sb, " > ")
  sb_append(sb, ir_path)
  sb_append(sb, " 2> ")
  sb_append(sb, err_path)

  var compile_raw = _sub_stage_raw(_sub_supervised("nested-compile", _sub_next_id(), _sub_compile_argv(main_path, "", dir), vec_new<String>(), vec_new<String>(), ir_path, err_path, false))
  if band(compile_raw, 127) != 0 or band(shr(compile_raw, 8), 255) != 0
    var cerr_content = read_file(err_path)
    _sub_cleanup_multi(dir, files)
    return _sub_result(-1, "", "compilation failed: " + cerr_content)
  end

  # Step 2: native compile (llc -O0) → link → run
  var rout_sb = sb_new()
  sb_append(rout_sb, dir)
  sb_append(rout_sb, "/run.out")
  var rout_path = sb_to_string(rout_sb)

  var rerr_sb = sb_new()
  sb_append(rerr_sb, dir)
  sb_append(rerr_sb, "/run.err")
  var rerr_path = sb_to_string(rerr_sb)

  var obj_sb = sb_new()
  sb_append(obj_sb, dir)
  sb_append(obj_sb, "/out.o")
  var obj_path = sb_to_string(obj_sb)
  var bin_sb = sb_new()
  sb_append(bin_sb, dir)
  sb_append(bin_sb, "/out.bin")
  var bin_path = sb_to_string(bin_sb)

  var ir_content_multi = read_file(ir_path)
  var run_exit = _sub_native_run(ir_path, ir_content_multi, obj_path, bin_path, rout_path, rerr_path)
  if run_exit == -2 or run_exit == -3
    var fail_msg = "llc failed"
    if run_exit == -3
      fail_msg = "link failed"
    end
    _sub_cleanup_multi(dir, files)
    return _sub_result(-1, "", fail_msg)
  end

  var stdout_content = read_file(rout_path)
  var stderr_content = read_file(rerr_path)
  _sub_cleanup_multi(dir, files)

  return _sub_result(run_exit, stdout_content, stderr_content)
end

# =============================================================================
# Multi-File High-Level Assertions
# =============================================================================

## Assert multi-file project compiles successfully.
def assert_multi_compile_succeeds(files: Vec, main_idx: Int): Void
  _inc_assertions()
  var r = subprocess_compile_multi(files, main_idx)
  if r.exit_code != 0
    var sb = sb_new()
    sb_append(sb, "Expected multi-file compilation to succeed but it failed: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
  end
end

## Assert multi-file project fails to compile with expected error.
def assert_multi_compile_error(files: Vec, main_idx: Int, expected: String): Void
  _inc_assertions()
  var r = subprocess_compile_multi(files, main_idx)
  if r.exit_code == 0
    _record_failure("Expected multi-file compilation to fail but it succeeded")
    return
  end
  if not str_contains(r.stderr_content, expected)
    var sb = sb_new()
    sb_append(sb, "Expected compile error to contain '")
    sb_append(sb, expected)
    sb_append(sb, "' but stderr was: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
  end
end

## Assert multi-file project runs and exits with expected code.
def assert_multi_run_exits(files: Vec, main_idx: Int, expected_code: Int): Void
  _inc_assertions()
  var r = subprocess_run_multi(files, main_idx)
  if r.exit_code == -1
    var sb = sb_new()
    sb_append(sb, "Failed to compile/run multi-file: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
    return
  end
  if r.exit_code != expected_code
    var sb = sb_new()
    sb_append(sb, "Expected exit code ")
    sb_append(sb, str_from_int(expected_code))
    sb_append(sb, " but got ")
    sb_append(sb, str_from_int(r.exit_code))
    _record_failure(sb_to_string(sb))
  end
end

## Assert multi-file project runs and stdout matches expected.
def assert_multi_run_output(files: Vec, main_idx: Int, expected: String): Void
  _inc_assertions()
  var r = subprocess_run_multi(files, main_idx)
  if r.exit_code == -1
    var sb = sb_new()
    sb_append(sb, "Failed to compile/run multi-file: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
    return
  end
  if r.stdout_content != expected
    var sb = sb_new()
    sb_append(sb, "Expected stdout '")
    sb_append(sb, expected)
    sb_append(sb, "' but got '")
    sb_append(sb, r.stdout_content)
    sb_append(sb, "'")
    _record_failure(sb_to_string(sb))
  end
end

## Assert multi-file project's IR contains a pattern.
def assert_multi_ir_contains(files: Vec, main_idx: Int, pattern: String): Void
  _inc_assertions()
  var r = subprocess_compile_multi(files, main_idx)
  if r.exit_code != 0
    var sb = sb_new()
    sb_append(sb, "Multi-file compilation failed (expected IR check): ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
    return
  end
  if not str_contains(r.stdout_content, pattern)
    var sb = sb_new()
    sb_append(sb, "Expected IR to contain '")
    sb_append(sb, pattern)
    sb_append(sb, "' but it was not found")
    _record_failure(sb_to_string(sb))
  end
end

## Assert that source code compiles successfully BUT produces a warning on stderr
## Unlike assert_compile_error, this checks for warnings that don't prevent compilation.
def assert_compile_warning(source: String, expected: String): Void
  _inc_assertions()
  var r = subprocess_compile(source)
  if r.exit_code != 0
    var sb = sb_new()
    sb_append(sb, "Expected compilation to succeed (with warning) but it failed: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
    return
  end
  if not str_contains(r.stderr_content, expected)
    var sb = sb_new()
    sb_append(sb, "Expected compile warning to contain '")
    sb_append(sb, expected)
    sb_append(sb, "' but stderr was: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
  end
end

## ========================================================================
## Lint helpers
## ========================================================================

## Run `quartz lint` on source, returning stdout+stderr as SubResult.
def subprocess_lint(source: String): SubResult
  _sub_begin_result()
  var compiler = _sub_compiler_str
  if str_byte_len(compiler) == 0
    return _sub_result(-1, "", "QUARTZ_COMPILER not set")
  end
  var id = _sub_next_id()
  var src = _sub_tmp(id, ".qz")
  var out = _sub_tmp(id, ".out")
  var err = _sub_tmp(id, ".err")
  write_file(src, source)
  var sb = sb_new()
  sb_append(sb, compiler)
  sb_append(sb, " lint ")
  sb_append(sb, src)
  sb_append(sb, " > ")
  sb_append(sb, out)
  sb_append(sb, " 2> ")
  sb_append(sb, err)
  var lint_argv = vec_new<String>(); lint_argv.push(compiler); lint_argv.push("lint"); lint_argv.push(src)
  var raw = _sub_stage_raw(_sub_supervised("nested-compile", id, lint_argv, vec_new<String>(), vec_new<String>(), out, err, false))
  var signaled = band(raw, 127)
  var exit_code = 0
  if signaled != 0
    exit_code = 128 + signaled
  else
    exit_code = band(shr(raw, 8), 255)
  end
  var out_content = read_file(out)
  var err_content = read_file(err)
  file_delete(src)
  file_delete(out)
  file_delete(err)
  return _sub_result(exit_code, out_content, err_content)
end

## Assert that linting source produces a warning with the given code.
def assert_lint_warns(source: String, expected_code: String): Void
  _inc_assertions()
  var r = subprocess_lint(source)
  if not str_contains(r.stderr_content, expected_code)
    var sb = sb_new()
    sb_append(sb, "Expected lint warning ")
    sb_append(sb, expected_code)
    sb_append(sb, " but stderr was: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
  end
end

## Assert that linting source produces no warnings.
def assert_lint_clean(source: String): Void
  _inc_assertions()
  var r = subprocess_lint(source)
  if r.exit_code != 0
    var sb = sb_new()
    sb_append(sb, "Expected clean lint but got exit code ")
    sb_append(sb, str_from_int(r.exit_code))
    sb_append(sb, " stderr: ")
    sb_append(sb, r.stderr_content)
    _record_failure(sb_to_string(sb))
  end
end
