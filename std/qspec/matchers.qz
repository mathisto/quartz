## QSpec Matchers - Assertion library
##
## Provides the `expect` function and matcher methods for fluent assertions.
## Both `expect(x).to_eq(y)` style and `assert_eq(x, y)` shorthand supported.
##
## Usage:
##   import qspec/matchers
##
##   expect(42).to_eq(42)
##   expect(true).to_be_true()
##   assert_eq(1 + 1, 2)

import * from colors

# =============================================================================
# TestFailure — structured assertion-failure record
#
# Each matcher pushes a TestFailure on assertion failure instead of a raw
# string. `message` is the human-readable headline (used by both the legacy
# `matcher_get_failure(idx): String` accessor and as the headline in the
# multi-line formatter output). `expected` / `actual` carry the unformatted
# operands so the formatter can render an aligned columns view, an optional
# diff, etc. `matcher` identifies which assertion fired ("to_eq",
# "assert_output", "assert_eq_str") for the formatter's chip.
# =============================================================================

struct TestFailure
  matcher: String
  expected: String
  actual: String
  message: String
  notes: Vec<String>
end

def test_failure_simple(message: String): TestFailure
  return TestFailure {
    matcher: "",
    expected: "",
    actual: "",
    message: message,
    notes: vec_new<String>(),
  }
end

# =============================================================================
# Test Status Tracking (module-level state)
# =============================================================================

# Global failure list: typed value storage of structured failure records.
_failures = vec_new<TestFailure>()
_assertion_count = vec_new()

def _init_matchers(): Void
  if vec_size(_assertion_count) == 0
    vec_push(_assertion_count, 0)  # total assertions
  end
end

def matcher_assertion_count(): Int
  _init_matchers()
  return vec_get(_assertion_count, 0)
end

def matcher_failure_count(): Int
  return vec_size(_failures)
end

## Get the failure at idx as its message string. Preserved for back-compat
## with property.qz, which reads the headline and re-records it inside a
## composed message ("counterexample 3 failed: <headline>").
# Routes through matcher_get_failure_struct so the field read happens on a
# value typed `TestFailure` (declared return type) rather than directly on an
# untracked module-global Vec element (which would resolve `.message` via the
# global field-name→offset table). Returns "" for an out-of-range index.
def matcher_get_failure(idx: Int): String
  return matcher_get_failure_struct(idx).message
end

## Get the failure at idx as a structured record. Returns an empty record
## (message == "") when idx is out of range.
def matcher_get_failure_struct(idx: Int): TestFailure
  if idx < 0 or idx >= vec_size(_failures)
    return test_failure_simple("")
  end
  return vec_get(_failures, idx)
end

def matcher_clear(): Void
  _init_matchers()
  vec_set(_assertion_count, 0, 0)
  vec_truncate(_failures, 0)
end

def _inc_assertions(): Void
  _init_matchers()
  var n = vec_get(_assertion_count, 0)
  vec_set(_assertion_count, 0, n + 1)
end

## Internal state boundary for qspec/property trial isolation. Failure state can
## only be truncated to a previously observed prefix; it cannot be expanded.
def _matcher_restore(assertion_count: Int, failure_count: Int): Void
  _init_matchers()
  vec_set(_assertion_count, 0, assertion_count)
  if failure_count >= 0 and failure_count < vec_size(_failures)
    vec_truncate(_failures, failure_count)
  end
end

## Record a string-only failure. Wraps in a TestFailure with empty
## matcher/expected/actual fields. Used by property.qz's quickcheck loop
## and other producers that compose their own headline.
def _record_failure(msg: String): Void
  vec_push(_failures, test_failure_simple(msg))
end

## Record a structured failure built by a matcher.
def _record_failure_struct(tf: TestFailure): Void
  vec_push(_failures, tf)
end

# =============================================================================
# Expectation Struct
# =============================================================================

struct Expectation
  actual_int: Int
  actual_str: String
  negated: Int       # 0 = normal, 1 = negated
  kind: Int          # 0 = int, 1 = string, 2 = bool
end

# =============================================================================
# expect() constructors
# =============================================================================

def expect(value: Int): Expectation
  return Expectation {
    actual_int: value,
    actual_str: value.to_s(),
    negated: 0,
    kind: 0
  }
end

def expect_str(value: String): Expectation
  return Expectation {
    actual_int: as_int(value),
    actual_str: value,
    negated: 0,
    kind: 1
  }
end

def expect_bool(value: Bool): Expectation
  var v = 0
  var s = "false"
  if value
    v = 1
    s = "true"
  end
  return Expectation {
    actual_int: v,
    actual_str: s,
    negated: 0,
    kind: 2
  }
end

# =============================================================================
# Negation
# =============================================================================

def negate(e: Expectation): Expectation
  var neg = 1
  if e.negated != 0
    neg = 0
  end
  return Expectation {
    actual_int: e.actual_int,
    actual_str: e.actual_str,
    negated: neg,
    kind: e.kind
  }
end

# =============================================================================
# Core failure helper
# =============================================================================

def _fail_expectation(e: Expectation, matcher_name: String, verb: String, expected_str: String): Void
  var sb = sb_new()
  sb.append("Expected ")
  sb.append(cyan(e.actual_str))
  if e.negated == 1
    sb.append(" not")
  end
  sb.append(" ")
  sb.append(verb)
  sb.append(" ")
  sb.append(cyan(expected_str))
  var notes = vec_new<String>()
  if e.negated == 1
    notes.push("matcher was negated via not()")
  end
  _record_failure_struct(TestFailure {
    matcher: matcher_name,
    expected: expected_str,
    actual: e.actual_str,
    message: sb.to_string(),
    notes: notes,
  })
end

# =============================================================================
# Matchers
# =============================================================================

## Expects actual to equal expected (by value)
def to_eq(e: Expectation, expected: Int): Void
  _inc_assertions()
  var passed = e.actual_int == expected
  if e.negated == 1
    passed = e.actual_int != expected
  end
  if passed == false
    _fail_expectation(e, "to_eq", "to equal", expected.to_s())
  end
end

## Expects actual string to equal expected string
def to_eq_str(e: Expectation, expected: String): Void
  _inc_assertions()
  var actual = as_string(e.actual_int)
  var passed = actual == expected
  if e.negated == 1
    passed = actual != expected
  end
  if passed == false
    _fail_expectation(e, "to_eq_str", "to equal", expected)
  end
end

## Expects actual to be greater than expected
def to_be_gt(e: Expectation, expected: Int): Void
  _inc_assertions()
  var passed = e.actual_int > expected
  if e.negated == 1
    passed = e.actual_int <= expected
  end
  if passed == false
    _fail_expectation(e, "to_be_gt", "to be greater than", expected.to_s())
  end
end

## Expects actual to be less than expected
def to_be_lt(e: Expectation, expected: Int): Void
  _inc_assertions()
  var passed = e.actual_int < expected
  if e.negated == 1
    passed = e.actual_int >= expected
  end
  if passed == false
    _fail_expectation(e, "to_be_lt", "to be less than", expected.to_s())
  end
end

## Expects actual to be greater than or equal to expected
def to_be_gte(e: Expectation, expected: Int): Void
  _inc_assertions()
  var passed = e.actual_int >= expected
  if e.negated == 1
    passed = e.actual_int < expected
  end
  if passed == false
    _fail_expectation(e, "to_be_gte", "to be >=", expected.to_s())
  end
end

## Expects actual to be less than or equal to expected
def to_be_lte(e: Expectation, expected: Int): Void
  _inc_assertions()
  var passed = e.actual_int <= expected
  if e.negated == 1
    passed = e.actual_int > expected
  end
  if passed == false
    _fail_expectation(e, "to_be_lte", "to be <=", expected.to_s())
  end
end

## Expects actual to be truthy (non-zero / true)
def to_be_true(e: Expectation): Void
  _inc_assertions()
  var passed = e.actual_int != 0
  if e.negated == 1
    passed = e.actual_int == 0
  end
  if passed == false
    _fail_expectation(e, "to_be_true", "to be", "true")
  end
end

## Expects actual to be falsy (zero / false)
def to_be_false(e: Expectation): Void
  _inc_assertions()
  var passed = e.actual_int == 0
  if e.negated == 1
    passed = e.actual_int != 0
  end
  if passed == false
    _fail_expectation(e, "to_be_false", "to be", "false")
  end
end

# =============================================================================
# assert_* shorthand
# =============================================================================

## Assert boolean condition is true
def qspec_assert(cond: Bool): Void
  _inc_assertions()
  if not cond
    _record_failure_struct(TestFailure {
      matcher: "qspec_assert",
      expected: "true",
      actual: "false",
      message: "Assertion failed",
      notes: vec_new<String>(),
    })
  end
end

## Assert two integers are equal
def assert_eq(actual: Int, expected: Int): Void
  _inc_assertions()
  if actual != expected
    _record_failure_struct(TestFailure {
      matcher: "assert_eq",
      expected: expected.to_s(),
      actual: actual.to_s(),
      message: "Expected #{cyan(expected.to_s())}, got #{cyan(actual.to_s())}",
      notes: vec_new<String>(),
    })
  end
end

## Assert two strings are equal
def assert_eq_str(actual: String, expected: String): Void
  _inc_assertions()
  if actual != expected
    _record_failure_struct(TestFailure {
      matcher: "assert_eq_str",
      expected: expected,
      actual: actual,
      message: "Expected #{cyan(expected)}, got #{cyan(actual)}",
      notes: vec_new<String>(),
    })
  end
end

## Assert two integers are NOT equal
def assert_ne(actual: Int, expected: Int): Void
  _inc_assertions()
  if actual == expected
    _record_failure_struct(TestFailure {
      matcher: "assert_ne",
      expected: "not " + expected.to_s(),
      actual: actual.to_s(),
      message: "Expected value to not equal #{cyan(expected.to_s())}",
      notes: vec_new<String>(),
    })
  end
end

## Assert actual > expected
def assert_gt(actual: Int, expected: Int): Void
  _inc_assertions()
  if actual <= expected
    _record_failure_struct(TestFailure {
      matcher: "assert_gt",
      expected: "> " + expected.to_s(),
      actual: actual.to_s(),
      message: "Expected #{cyan(actual.to_s())} to be > #{cyan(expected.to_s())}",
      notes: vec_new<String>(),
    })
  end
end

## Assert actual < expected
def assert_lt(actual: Int, expected: Int): Void
  _inc_assertions()
  if actual >= expected
    _record_failure_struct(TestFailure {
      matcher: "assert_lt",
      expected: "< " + expected.to_s(),
      actual: actual.to_s(),
      message: "Expected #{cyan(actual.to_s())} to be < #{cyan(expected.to_s())}",
      notes: vec_new<String>(),
    })
  end
end

## Assert that a closure's stdout output equals expected string
def assert_output(expected: String, f: Fn(): Void): Void
  _inc_assertions()
  var handle = capture_output_start()
  f()
  var actual = capture_output_end(handle)
  if actual != expected
    _record_failure_struct(TestFailure {
      matcher: "assert_output",
      expected: expected,
      actual: actual,
      message: "Expected output #{cyan(expected)}, got #{cyan(actual)}",
      notes: vec_new<String>(),
    })
  end
end

## Assert that a closure's stdout output contains expected substring
def assert_output_contains(expected: String, f: Fn(): Void): Void
  _inc_assertions()
  var handle = capture_output_start()
  f()
  var actual = capture_output_end(handle)
  if not str_contains(actual, expected)
    var notes = vec_new<String>()
    notes.push("substring match")
    _record_failure_struct(TestFailure {
      matcher: "assert_output_contains",
      expected: expected,
      actual: actual,
      message: "Expected output to contain #{cyan(expected)}, got #{cyan(actual)}",
      notes: notes,
    })
  end
end
