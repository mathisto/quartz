## QSpec Formatter - Beautiful CLI output
##
## Three output modes:
##   Pretty (default) — Indented tree with ✓/✗ and timing
##   Progress          — Live progress bar with ✓✗ stream
##   Dots              — Minimal .F* output for CI
##
## Usage:
##   import qspec/formatter
##
##   qspec_format_pretty(suites)
##   qspec_format_summary()

import * from colors
import * from progress
import qspec/runner

# =============================================================================
# Format mode
# =============================================================================

_FORMAT_PRETTY = 0
_FORMAT_PROGRESS = 1
_FORMAT_DOTS = 2

_format_mode = vec_new()

def _init_format(): Void
  if vec_size(_format_mode) == 0
    vec_push(_format_mode, _FORMAT_PRETTY)
  end
end

def format_set_pretty(): Void
  _init_format()
  vec_set(_format_mode, 0, _FORMAT_PRETTY)
end

def format_set_progress(): Void
  _init_format()
  vec_set(_format_mode, 0, _FORMAT_PROGRESS)
end

def format_set_dots(): Void
  _init_format()
  vec_set(_format_mode, 0, _FORMAT_DOTS)
end

def format_mode(): Int
  _init_format()
  return vec_get(_format_mode, 0)
end

# A failed test captured for the end-of-run report: its display name plus the
# structured failure record. Typed value storage replaces the old heterogeneous
# `Vec<Int>` = [as_int(name), failure_handle] encoding, which erased the
# F4-eligible TestFailure through as_int (QZ0221 wall). Only collected for tests
# that actually failed (status == FAIL is the discriminant), so `failure` is
# always a real record — no Option needed.
struct CollectedFailure
  name: String
  failure: TestFailure
end

# Collect failures for end-of-run report
_collected_failures = vec_new<CollectedFailure>()

## Capture a failed test's structured record for the end-of-run summary. Only
## called from the FAIL branch, so the record is always real.
def _collect_failure(name: String, tc: Int): Void
  var count = qspec_test_failure_count(tc)
  var i = 0
  while i < count
    vec_push(_collected_failures, CollectedFailure { name: name, failure: qspec_test_failure_struct_at(tc, i) })
    i += 1
  end
end

## Typed accessor for a collected entry. A module-global Vec's element type is not
## tracked across function boundaries, so a direct `_collected_failures[i].field`
## read resolves the field offset via the global field-name table (miscompiles when
## a name collides at another offset — e.g. `failure` is at a different offset in
## `Test`). Returning through a declared `CollectedFailure` type re-anchors tracking
## so the caller's field reads use the correct struct-relative offsets.
def _collected_at(i: Int): CollectedFailure
  return _collected_failures[i]
end

# =============================================================================
# Indent Helper
# =============================================================================

def _indent(depth: Int): String
  var sb = sb_new()
  var i = 0
  while i < depth
    sb.append("  ")
    i += 1
  end
  return sb.to_string()
end

# =============================================================================
# Duration Formatting
# =============================================================================

def _format_duration(us: Int): String
  if us < 1000
    return "#{us.to_s()}µs"
  end
  if us < 1000000
    var ms = us / 1000
    return "#{ms.to_s()}ms"
  end
  var sec_whole = us / 1000000
  var sec_frac = (us % 1000000) / 100000
  var sb = sb_new()
  sb.append(sec_whole.to_s())
  sb.append(".")
  sb.append(sec_frac.to_s())
  sb.append("s")
  return sb.to_string()
end

# =============================================================================
# Pretty Formatter
# =============================================================================

def _format_test_pretty(tc: Int, depth: Int): Void
  var name = qspec_test_name(tc)
  var status = qspec_test_status(tc)
  var duration = qspec_test_duration(tc)
  var prefix = _indent(depth)
  var dur_str = gray("(#{_format_duration(duration)})")

  if status == 1  # PASS
    puts(prefix + green("✓ ") + name + " " + dur_str)
  elsif status == 2  # FAIL
    puts(prefix + red("✗ ") + red(name))
    _collect_failure(name, tc)
  elsif status == 3  # PENDING
    puts(prefix + yellow("○ ") + yellow(name))
  elsif status == 4  # SKIPPED
    puts(prefix + gray("- ") + gray(name))
  end
end

def _format_suite_pretty(suite: Int, depth: Int): Void
  var name = qspec_suite_name(suite)
  puts("#{_indent(depth)}#{bold(name)}")

  var entries = qspec_suite_entries(suite)
  var kinds = qspec_suite_entry_kinds(suite)
  var i = 0
  while i < vec_size(entries)
    var entry = vec_get(entries, i)
    if vec_get(kinds, i) == 0
      _format_test_pretty(entry, depth + 1)
    else
      _format_suite_pretty(entry, depth + 1)
    end
    i += 1
  end
end

## Format all suites in pretty mode
def qspec_format_pretty(): Void
  puts("")
  var suites = qspec_root_suites()
  var i = 0
  while i < vec_size(suites)
    _format_suite_pretty(vec_get(suites, i), 1)
    i += 1
  end
end

# =============================================================================
# Dots Formatter
# =============================================================================

def _format_test_dot(tc: Int): Void
  var status = qspec_test_status(tc)
  if status == 1
    puts(green("."))
  elsif status == 2
    puts(red("F"))
    var name = qspec_test_name(tc)
    _collect_failure(name, tc)
  elsif status == 3
    puts(yellow("*"))
  elsif status == 4
    puts(gray("-"))
  end
end

def _format_suite_dots(suite: Int): Void
  var entries = qspec_suite_entries(suite)
  var kinds = qspec_suite_entry_kinds(suite)
  var i = 0
  while i < vec_size(entries)
    var entry = vec_get(entries, i)
    if vec_get(kinds, i) == 0
      _format_test_dot(entry)
    else
      _format_suite_dots(entry)
    end
    i += 1
  end
end

## Format all suites in dots mode
def qspec_format_dots(): Void
  puts("")
  puts("  ")
  var suites = qspec_root_suites()
  var i = 0
  while i < vec_size(suites)
    _format_suite_dots(vec_get(suites, i))
    i += 1
  end
  puts("")
end

# =============================================================================
# Progress Formatter
# =============================================================================

def _count_tests_in_suite(suite: Int): Int
  var count = vec_size(qspec_suite_tests(suite))
  var children = qspec_suite_children(suite)
  var i = 0
  while i < vec_size(children)
    count = count + _count_tests_in_suite(vec_get(children, i))
    i += 1
  end
  return count
end

## Format in progress mode with running bar
def qspec_format_progress(): Void
  puts("")
  # Count total tests
  var total = 0
  var suites = qspec_root_suites()
  var i = 0
  while i < vec_size(suites)
    total = total + _count_tests_in_suite(vec_get(suites, i))
    i += 1
  end

  # Show progress summary
  var passed = qspec_passed()
  var failed = qspec_failed()
  var done = passed + failed + qspec_pending() + qspec_skipped()

  # Show dots stream
  i = 0
  while i < vec_size(suites)
    _format_suite_dots(vec_get(suites, i))
    i += 1
  end

  puts("")
  puts("  #{bold(progress_bar_string(done, total, 30))}")
  puts("")
end

# =============================================================================
# Summary (shared across all formatters)
# =============================================================================

## Escape newlines / tabs / carriage returns so a multi-line value renders
## on a single structured-block line. Used for the expected/actual columns
## in the failure summary; the headline message keeps real characters.
def _escape_for_block(s: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == '\n'
      sb.append("\\n")
    elsif c == '\t'
      sb.append("\\t")
    elsif c == '\r'
      sb.append("\\r")
    else
      sb_append_char(sb, c)
    end
    i += 1
  end
  return sb.to_string()
end

## True for matchers whose expected/actual operands are strings worth
## rendering as a position-aligned char-level diff (typo-class mismatches
## become instantly scannable). For non-string matchers (assert_eq on Ints,
## to_be_gt, etc.) the diff would be misleading.
def _is_string_diff_matcher(name: String): Bool
  if name == "assert_eq_str"
    return true
  end
  if name == "to_eq_str"
    return true
  end
  if name == "assert_output"
    return true
  end
  if name == "assert_output_contains"
    return true
  end
  return false
end

## True if every byte in `s` is ASCII (< 0x80). Pure-ASCII strings are safe
## to color byte-by-byte; multi-byte UTF-8 sequences would have ANSI escapes
## inserted mid-codepoint and render as garbled bytes, so non-ASCII inputs
## fall back to plain cyan rendering.
def _is_ascii(s: String): Bool
  var n = str_byte_len(s)
  var i = 0
  while i < n
    if str_byte_at(s, i) >= 128
      return false
    end
    i += 1
  end
  return true
end

## Render `mine` highlighting bytes that differ from `theirs` at the same
## position (or that have no counterpart because mine is longer). Differing
## chars are wrapped in red when `use_red == true`, green otherwise.
## Newlines/tabs/CR are escape-printed inline so the diff view stays on
## one line per operand.
##
## Specialized red/green flag rather than a `Fn(String): String` callback —
## the callback shape produced an SSA-dominance IR-verifier failure under
## opt's mem2reg pass (likely interaction between Fn-typed params and the
## color-state-mutating `red`/`green` globals); the Bool flag sidesteps it
## cleanly. Sister friction memo: `feedback_fn_typed_field_call_friction.md`.
def _diff_render(mine: String, theirs: String, use_red: Bool): String
  var sb = sb_new()
  var nm = str_byte_len(mine)
  var nt = str_byte_len(theirs)
  var i = 0
  while i < nm
    var c = str_byte_at(mine, i)
    var ch = ""
    if c == '\n'
      ch = "\\n"
    elsif c == '\t'
      ch = "\\t"
    elsif c == '\r'
      ch = "\\r"
    else
      ch = str_from_char(c)
    end
    var differs = true
    if i < nt
      var ct = str_byte_at(theirs, i)
      if ct == c
        differs = false
      end
    end
    if differs
      if use_red
        sb.append(red(ch))
      else
        sb.append(green(ch))
      end
    else
      sb.append(ch)
    end
    i += 1
  end
  return sb.to_string()
end

## Render the structured fields of a TestFailure underneath the headline
## message in the failure summary.
def _render_failure_block(tf: TestFailure): Void
  if str_byte_len(tf.matcher) > 0
    puts("       " + gray("matcher  ") + tf.matcher)
  end
  var has_exp = str_byte_len(tf.expected) > 0
  var has_act = str_byte_len(tf.actual) > 0
  var use_diff = _is_string_diff_matcher(tf.matcher) and has_exp and has_act and _is_ascii(tf.expected) and _is_ascii(tf.actual)
  if has_exp
    if use_diff
      puts("       " + gray("expected ") + _diff_render(tf.expected, tf.actual, true))
    else
      puts("       " + gray("expected ") + cyan(_escape_for_block(tf.expected)))
    end
  end
  if has_act
    if use_diff
      puts("       " + gray("actual   ") + _diff_render(tf.actual, tf.expected, false))
    else
      puts("       " + gray("actual   ") + cyan(_escape_for_block(tf.actual)))
    end
  end
  if use_diff
    var ne = str_byte_len(tf.expected)
    var na = str_byte_len(tf.actual)
    if ne != na
      var delta = na - ne
      if delta > 0
        puts("       " + gray("note     ") + "actual is #{delta.to_s()} byte(s) longer")
      else
        puts("       " + gray("note     ") + "actual is #{(0 - delta).to_s()} byte(s) shorter")
      end
    end
  end
  var n = 0
  while n < vec_size(tf.notes)
    puts("       " + gray("note     ") + tf.notes[n])
    n += 1
  end
end

## Print the test summary with failures
def qspec_format_summary(): Void
  # Print failures if any
  var framework_count = qspec_framework_failure_count()
  if vec_size(_collected_failures) > 0 or framework_count > 0
    puts("")
    puts("  " + red(bold("FAILURES:")))
    puts("")
    var i = 0
    while i < vec_size(_collected_failures)
      var entry = _collected_at(i)
      var name = entry.name
      var failure = entry.failure
      var num = (i + 1).to_s()
      puts("  " + red(num + ") ") + bold(name))
      var msg = failure.message
      if str_byte_len(msg) > 0
        puts("     #{msg}")
      end
      _render_failure_block(failure)
      puts("")
      i += 1
    end
    var framework_idx = 0
    while framework_idx < framework_count
      var num = (vec_size(_collected_failures) + framework_idx + 1).to_s()
      puts("  " + red(num + ") ") + bold("QSpec lifecycle"))
      puts("     #{qspec_framework_failure_message(framework_idx)}")
      puts("")
      framework_idx += 1
    end
  end

  # Horizontal rule
  puts("  #{gray(horizontal_rule(40))}")
  puts("")

  # Stats line
  var sb = sb_new()
  sb.append("  ")
  sb.append(bold(qspec_total().to_s()))
  sb.append(" tests, ")

  var passed = qspec_passed()
  if passed > 0
    sb.append(green("#{passed.to_s()} passed"))
  else
    sb.append("#{passed.to_s()} passed")
  end

  var failed = qspec_failed()
  if failed > 0
    sb.append(", ")
    sb.append(red("#{failed.to_s()} failed"))
  end

  var pending = qspec_pending()
  if pending > 0
    sb.append(", ")
    sb.append(yellow("#{pending.to_s()} pending"))
  end

  var skipped = qspec_skipped()
  if skipped > 0
    sb.append(", ")
    sb.append(gray("#{skipped.to_s()} skipped"))
  end

  puts(sb.to_string())

  # Timing
  var dur = qspec_duration_us()
  puts("  Finished in #{_format_duration(dur)}")

  # Final verdict
  puts("")
  if failed == 0
    puts("  " + green(bold("✅ All green")))
  else
    puts("  " + red(bold("❌ Tests failed")))
  end
  puts("")
end

# =============================================================================
# Unified Format + Summary
# =============================================================================

## Run the appropriate formatter based on mode, then print summary
def qspec_format(): Void
  var mode = format_mode()
  if mode == _FORMAT_PRETTY
    qspec_format_pretty()
  elsif mode == _FORMAT_PROGRESS
    qspec_format_progress()
  elsif mode == _FORMAT_DOTS
    qspec_format_dots()
  end
  qspec_format_summary()
end
