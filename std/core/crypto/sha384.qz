## std/core/crypto/sha384 — SHA-384 as SHA-512 with different IVs + 48-byte output
##
## NET.5c.0 substrate. TLS 1.3 cipher suite TLS_AES_256_GCM_SHA384 binds
## HKDF-SHA-384 + transcript-SHA-384.
##
## Per FIPS 180-4 §5.3.4 + §6.2: SHA-384 uses the SAME compression function
## as SHA-512 — the only differences are (a) the initial hash value H(0)
## (different 8 × u64 constants) and (b) the output is truncated to the
## leftmost 384 bits = 48 bytes. We reuse `sha512_new` / `sha512_update`
## verbatim, overwrite the chain state with SHA-384's IVs immediately
## after init, and truncate the digest on finalize.
##
## Validation: FIPS 180-2 §D.3 + RFC 4231 HMAC-SHA-384 test vectors.

import * from ffi/socket
import * from std/core/crypto/sha512

# Write the 8 SHA-384 IV bytes into the chain-state buffer. SHA-512's
# context layout stores `h` at offset 0 of the ctx and as 8 LE-u64s; we
# write byte-by-byte to sidestep the hex-literal-vs-negative-i64
# question. Bytes are little-endian (the LSB of each u64 goes first).
#
# IVs from FIPS 180-4 §5.3.4 — first 64 bits of the fractional parts of
# the square roots of the 9th..16th primes.
def _write_iv(h: Int, off: Int,
              b0: Int, b1: Int, b2: Int, b3: Int,
              b4: Int, b5: Int, b6: Int, b7: Int): Void
  ptr_write_byte(h + off + 0, b0)
  ptr_write_byte(h + off + 1, b1)
  ptr_write_byte(h + off + 2, b2)
  ptr_write_byte(h + off + 3, b3)
  ptr_write_byte(h + off + 4, b4)
  ptr_write_byte(h + off + 5, b5)
  ptr_write_byte(h + off + 6, b6)
  ptr_write_byte(h + off + 7, b7)
end

## Allocate and init a streaming SHA-384 context. The returned ctx is
## a SHA-512 ctx with chain state overwritten by SHA-384 IVs; consumers
## use the SHA-512 update / our 48-byte finalize.
def sha384_new(): Int
  var ctx = sha512_new()
  # h starts at ctx offset 0 (matches sha512.qz's _OFF_H).
  # H[0] = 0xcbbb9d5dc1059ed8 (LE byte order: d8 9e 05 c1 5d 9d bb cb)
  _write_iv(ctx,  0, 0xd8, 0x9e, 0x05, 0xc1, 0x5d, 0x9d, 0xbb, 0xcb)
  # H[1] = 0x629a292a367cd507
  _write_iv(ctx,  8, 0x07, 0xd5, 0x7c, 0x36, 0x2a, 0x29, 0x9a, 0x62)
  # H[2] = 0x9159015a3070dd17
  _write_iv(ctx, 16, 0x17, 0xdd, 0x70, 0x30, 0x5a, 0x01, 0x59, 0x91)
  # H[3] = 0x152fecd8f70e5939
  _write_iv(ctx, 24, 0x39, 0x59, 0x0e, 0xf7, 0xd8, 0xec, 0x2f, 0x15)
  # H[4] = 0x67332667ffc00b31
  _write_iv(ctx, 32, 0x31, 0x0b, 0xc0, 0xff, 0x67, 0x26, 0x33, 0x67)
  # H[5] = 0x8eb44a8768581511
  _write_iv(ctx, 40, 0x11, 0x15, 0x58, 0x68, 0x87, 0x4a, 0xb4, 0x8e)
  # H[6] = 0xdb0c2e0d64f98fa7
  _write_iv(ctx, 48, 0xa7, 0x8f, 0xf9, 0x64, 0x0d, 0x2e, 0x0c, 0xdb)
  # H[7] = 0x47b5481dbefa4fa4
  _write_iv(ctx, 56, 0xa4, 0x4f, 0xfa, 0xbe, 0x1d, 0x48, 0xb5, 0x47)
  return ctx
end

## Feed `input_len` bytes into the SHA-384 context. Compression function
## is identical to SHA-512 — reuse it.
def sha384_update(ctx: Int, input: Int, input_len: Int): Void
  sha512_update(ctx, input, input_len)
end

## Finalise: emit the 48-byte digest into `output`. Frees ctx.
def sha384_finalize(ctx: Int, output: Int): Void
  var tmp = malloc(64)
  sha512_finalize(ctx, tmp)
  memcpy(output, tmp, 48)
  free(tmp)
end

## Compute the 48-byte SHA-384 digest of `input` into `output`.
def sha384(input: Int, input_len: Int, output: Int): Void
  var ctx = sha384_new()
  sha384_update(ctx, input, input_len)
  sha384_finalize(ctx, output)
end

def SHA384_BLOCK_SIZE(): Int = 128
def SHA384_DIGEST_SIZE(): Int = 48
