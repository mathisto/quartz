## std/core/crypto/subtle - Constant-time helpers for cryptographic code
##
## Branchless equality, selection, and comparison primitives whose timing
## does not depend on the values being compared. Use these any time secret
## data drives a comparison or a select. Never use `==`, `<`, `if`, or
## array-index-by-secret in crypto-sensitive paths.
##
## All primitives operate on `Int` (Quartz's 64-bit integer). Width-suffixed
## variants (`_byte`, `_u32`) treat their inputs as unsigned values of that
## width. Mask-returning variants produce an all-ones / all-zeros mask of
## the named width so callers can compose with bitwise AND / OR / XOR.
##
## Caveats:
## - The LLVM optimizer does not preserve constant-time semantics across all
##   passes. These helpers reject the obvious source-level branches; they
##   cannot stop a backend pass from synthesizing one. Pair with `dudect`-style
##   timing tests when constant-time is load-bearing. See
##   docs/design/CRYPTO_STDLIB_DESIGN.md for the broader plan.
## - `ct_eq_bytes` short-circuits on length mismatch. Lengths are not secret
##   in any WireGuard- / Noise-shaped use; if your protocol treats length as
##   secret, do not use this helper.

# ---- Equality (returns all-ones mask of named width if equal, 0 if not) ----

## Returns 0xFF if the low 8 bits of `a` and `b` are equal, 0 otherwise.
## Branchless. Suitable for composing into running byte-level masks.
def ct_eq_byte(a: Int, b: Int): Int
  var x = (a ^ b) & 255
  # x == 0  =>  x - 1 = -1 (all ones)  =>  >>8 spreads ones into low byte
  # x != 0  =>  x - 1 in [0, 254]      =>  >>8 = 0
  return ((x - 1) >> 8) & 255
end

## Returns 0xFFFFFFFF if the low 32 bits of `a` and `b` are equal, 0 otherwise.
def ct_eq_u32(a: Int, b: Int): Int
  var x = (a ^ b) & 4294967295
  # 4294967295 = 0xFFFFFFFF
  return ((x - 1) >> 32) & 4294967295
end

## Returns -1 (all 64 bits set) if `a == b`, 0 otherwise.
## Useful for comparing 64-bit integer tags, hash-table keys, etc.
def ct_eq_int(a: Int, b: Int): Int
  var diff = a ^ b
  # (diff | -diff) has bit 63 set iff diff != 0; lshr 63 gives 1 iff diff != 0.
  # Subtract 1: 0 - 1 = -1 (all ones) iff diff == 0; 1 - 1 = 0 iff diff != 0.
  return (((diff | (0 - diff)) >> 63) & 1) - 1
end

# ---- Selection (branchless ternary on a mask) ----

## If `mask` is 0xFF (all 8 bits set), returns the low byte of `a`.
## If `mask` is 0x00, returns the low byte of `b`.
## Result is undefined for other mask values; pair with `ct_eq_byte` etc.
def ct_select_byte(mask: Int, a: Int, b: Int): Int
  # Identity: b XOR ((a XOR b) AND mask) selects a where mask=1, b where mask=0.
  # Truncate to byte at the boundary so callers can chain.
  return (b ^ ((a ^ b) & mask)) & 255
end

## If `mask` is 0xFFFFFFFF, returns low 32 bits of `a`; if 0, returns low 32 of `b`.
def ct_select_u32(mask: Int, a: Int, b: Int): Int
  return (b ^ ((a ^ b) & mask)) & 4294967295
end

## If `mask` is -1 (all 64 bits set), returns `a`; if 0, returns `b`.
def ct_select_int(mask: Int, a: Int, b: Int): Int
  return b ^ ((a ^ b) & mask)
end

# ---- Comparison (returns mask) ----

## Returns 0xFFFFFFFF if `a < b` as unsigned 32-bit, 0 otherwise.
## Useful for branchless field-element conditional reduction.
def ct_less_u32(a: Int, b: Int): Int
  var amask = a & 4294967295
  var bmask = b & 4294967295
  # Signed 64-bit subtraction: if amask < bmask, result has bits 32..63 = 1.
  # lshr 32 brings those ones into the low 32; mask to width.
  return ((amask - bmask) >> 32) & 4294967295
end

# ---- Buffer comparison and conditional copy ----

## Returns 1 if `len` bytes at `a_ptr` equal `len` bytes at `b_ptr`, else 0.
## Walks the full buffer with no early exit; timing depends only on `len`.
##
## This helper is intended for fixed-length tag / MAC / digest comparison.
## Callers must ensure both buffers have at least `len` valid bytes.
def ct_eq_bytes(a_ptr: Int, b_ptr: Int, len: Int): Int
  var diff = 0
  var i = 0
  while i < len
    var ax = ptr_read_byte(a_ptr + i)
    var bx = ptr_read_byte(b_ptr + i)
    diff = diff | (ax ^ bx)
    i += 1
  end
  # diff == 0 iff every byte matched.
  # ct_eq_byte returns 0xFF for equal, 0 for not. Truncate to a 0/1 result.
  return (ct_eq_byte(diff, 0) >> 7) & 1
end

## Branchlessly copies `len` bytes from `src_ptr` to `dst_ptr` if `mask` is 0xFF;
## leaves `dst_ptr` unchanged if `mask` is 0. Walks the full buffer either way.
def ct_copy_if_byte(mask: Int, dst_ptr: Int, src_ptr: Int, len: Int): Void
  var i = 0
  while i < len
    var d = ptr_read_byte(dst_ptr + i)
    var s = ptr_read_byte(src_ptr + i)
    var picked = ct_select_byte(mask, s, d)
    ptr_write_byte(dst_ptr + i, picked)
    i += 1
  end
end
