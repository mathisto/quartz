## std/core/crypto/sha256 — Pure-Quartz SHA-256 (FIPS 180-4 §6.2)
##
## NET.5c.0 substrate. TLS 1.3 cipher suites TLS_AES_128_GCM_SHA256 and
## TLS_CHACHA20_POLY1305_SHA256 both bind HKDF-SHA-256 + transcript-SHA-256;
## NET.5c.2 transcript layer + NET.5c.3 key schedule + NET.5c.0 HMAC + HKDF
## all consume this.
##
## Mirrors `sha512.qz`'s shape exactly — same streaming context layout,
## same compression-function structure, same one-shot wrapper. Differences:
## word size (u32 vs u64), block size (64 vs 128 bytes), rounds (64 vs 80),
## constants (Ch/Maj are identical algebraically; Sigma rotation amounts
## differ per FIPS 180-4 §4.1.2), length field (64-bit BE vs 128-bit BE),
## and digest size (32 vs 64 bytes).
##
## Validation: FIPS 180-2 §D.1 + NIST CAVS SHA-256 short-message KAT.
## See `spec/qz/sha2_smoke.qz`.

import * from ffi/socket

# =============================================================================
# u32 ARX helpers
# =============================================================================

# Logical shift right on u32 (Quartz `>>` is arithmetic on i64; mask to width).
def _sha256_u32_lsr(x: Int, n: Int): Int
  return (x >> n) & ((1 << (32 - n)) - 1)
end

# Right-rotate u32 by n in [1, 31].
def _sha256_u32_rotr(x: Int, n: Int): Int
  return _sha256_u32_lsr(x, n) | ((x << (32 - n)) & 0xffffffff)
end

# u32 addition mod 2^32 — wrap-around via mask.
def _sha256_u32_add(a: Int, b: Int): Int = (a + b) & 0xffffffff

# Read 4 bytes at p as big-endian u32 (FIPS 180-4 §3.1).
def _sha256_u32_read_be(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(p + 1)
  var b2 = ptr_read_byte(p + 2)
  var b3 = ptr_read_byte(p + 3)
  return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

# Write u32 v at p as 4 bytes, big-endian.
def _sha256_u32_write_be(p: Int, v: Int): Void
  ptr_write_byte(p,     _sha256_u32_lsr(v, 24) & 0xff)
  ptr_write_byte(p + 1, _sha256_u32_lsr(v, 16) & 0xff)
  ptr_write_byte(p + 2, _sha256_u32_lsr(v, 8) & 0xff)
  ptr_write_byte(p + 3, v & 0xff)
end

# Internal LE storage helpers (so chain state pulls/pushes don't pay BE-swap
# cost on every round). The digest emit at the end converts back to BE.
def _sha256_u32_read_le(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(p + 1)
  var b2 = ptr_read_byte(p + 2)
  var b3 = ptr_read_byte(p + 3)
  return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
end

def _sha256_u32_write_le(p: Int, v: Int): Void
  ptr_write_byte(p,     v & 0xff)
  ptr_write_byte(p + 1, _sha256_u32_lsr(v, 8) & 0xff)
  ptr_write_byte(p + 2, _sha256_u32_lsr(v, 16) & 0xff)
  ptr_write_byte(p + 3, _sha256_u32_lsr(v, 24) & 0xff)
end

# =============================================================================
# Initial hash value H(0) — FIPS 180-4 §5.3.3
# =============================================================================
#
# First 32 bits of the fractional parts of the square roots of the first 8 primes.

def _sha256_IV_0(): Int = 0x6a09e667
def _sha256_IV_1(): Int = 0xbb67ae85
def _sha256_IV_2(): Int = 0x3c6ef372
def _sha256_IV_3(): Int = 0xa54ff53a
def _sha256_IV_4(): Int = 0x510e527f
def _sha256_IV_5(): Int = 0x9b05688c
def _sha256_IV_6(): Int = 0x1f83d9ab
def _sha256_IV_7(): Int = 0x5be0cd19

# =============================================================================
# K constants — FIPS 180-4 §4.2.2
# =============================================================================
#
# First 32 bits of the fractional parts of the cube roots of the first 64
# primes. Lazily-initialised table; same shape as sha512's K table.

var _sha256_k_table: Int = 0
var _sha256_k_ready: Int = 0

def _sha256_ensure_k_table(): Int
  if _sha256_k_ready == 1 then return _sha256_k_table end
  _sha256_k_table = malloc(256)   # 64 × 4 bytes
  var k = _sha256_k_table
  _sha256_u32_write_le(k +   0, 0x428a2f98)
  _sha256_u32_write_le(k +   4, 0x71374491)
  _sha256_u32_write_le(k +   8, 0xb5c0fbcf)
  _sha256_u32_write_le(k +  12, 0xe9b5dba5)
  _sha256_u32_write_le(k +  16, 0x3956c25b)
  _sha256_u32_write_le(k +  20, 0x59f111f1)
  _sha256_u32_write_le(k +  24, 0x923f82a4)
  _sha256_u32_write_le(k +  28, 0xab1c5ed5)
  _sha256_u32_write_le(k +  32, 0xd807aa98)
  _sha256_u32_write_le(k +  36, 0x12835b01)
  _sha256_u32_write_le(k +  40, 0x243185be)
  _sha256_u32_write_le(k +  44, 0x550c7dc3)
  _sha256_u32_write_le(k +  48, 0x72be5d74)
  _sha256_u32_write_le(k +  52, 0x80deb1fe)
  _sha256_u32_write_le(k +  56, 0x9bdc06a7)
  _sha256_u32_write_le(k +  60, 0xc19bf174)
  _sha256_u32_write_le(k +  64, 0xe49b69c1)
  _sha256_u32_write_le(k +  68, 0xefbe4786)
  _sha256_u32_write_le(k +  72, 0x0fc19dc6)
  _sha256_u32_write_le(k +  76, 0x240ca1cc)
  _sha256_u32_write_le(k +  80, 0x2de92c6f)
  _sha256_u32_write_le(k +  84, 0x4a7484aa)
  _sha256_u32_write_le(k +  88, 0x5cb0a9dc)
  _sha256_u32_write_le(k +  92, 0x76f988da)
  _sha256_u32_write_le(k +  96, 0x983e5152)
  _sha256_u32_write_le(k + 100, 0xa831c66d)
  _sha256_u32_write_le(k + 104, 0xb00327c8)
  _sha256_u32_write_le(k + 108, 0xbf597fc7)
  _sha256_u32_write_le(k + 112, 0xc6e00bf3)
  _sha256_u32_write_le(k + 116, 0xd5a79147)
  _sha256_u32_write_le(k + 120, 0x06ca6351)
  _sha256_u32_write_le(k + 124, 0x14292967)
  _sha256_u32_write_le(k + 128, 0x27b70a85)
  _sha256_u32_write_le(k + 132, 0x2e1b2138)
  _sha256_u32_write_le(k + 136, 0x4d2c6dfc)
  _sha256_u32_write_le(k + 140, 0x53380d13)
  _sha256_u32_write_le(k + 144, 0x650a7354)
  _sha256_u32_write_le(k + 148, 0x766a0abb)
  _sha256_u32_write_le(k + 152, 0x81c2c92e)
  _sha256_u32_write_le(k + 156, 0x92722c85)
  _sha256_u32_write_le(k + 160, 0xa2bfe8a1)
  _sha256_u32_write_le(k + 164, 0xa81a664b)
  _sha256_u32_write_le(k + 168, 0xc24b8b70)
  _sha256_u32_write_le(k + 172, 0xc76c51a3)
  _sha256_u32_write_le(k + 176, 0xd192e819)
  _sha256_u32_write_le(k + 180, 0xd6990624)
  _sha256_u32_write_le(k + 184, 0xf40e3585)
  _sha256_u32_write_le(k + 188, 0x106aa070)
  _sha256_u32_write_le(k + 192, 0x19a4c116)
  _sha256_u32_write_le(k + 196, 0x1e376c08)
  _sha256_u32_write_le(k + 200, 0x2748774c)
  _sha256_u32_write_le(k + 204, 0x34b0bcb5)
  _sha256_u32_write_le(k + 208, 0x391c0cb3)
  _sha256_u32_write_le(k + 212, 0x4ed8aa4a)
  _sha256_u32_write_le(k + 216, 0x5b9cca4f)
  _sha256_u32_write_le(k + 220, 0x682e6ff3)
  _sha256_u32_write_le(k + 224, 0x748f82ee)
  _sha256_u32_write_le(k + 228, 0x78a5636f)
  _sha256_u32_write_le(k + 232, 0x84c87814)
  _sha256_u32_write_le(k + 236, 0x8cc70208)
  _sha256_u32_write_le(k + 240, 0x90befffa)
  _sha256_u32_write_le(k + 244, 0xa4506ceb)
  _sha256_u32_write_le(k + 248, 0xbef9a3f7)
  _sha256_u32_write_le(k + 252, 0xc67178f2)
  _sha256_k_ready = 1
  return _sha256_k_table
end

def _sha256_K(round: Int): Int = _sha256_u32_read_le(_sha256_k_table + round * 4)

# =============================================================================
# SHA-256 inner functions (FIPS 180-4 §4.1.2)
# =============================================================================

def _sha256_Ch(x: Int, y: Int, z: Int): Int = (x & y) ^ ((~x) & z & 0xffffffff)
def _sha256_Maj(x: Int, y: Int, z: Int): Int = (x & y) ^ (x & z) ^ (y & z)

# Σ₀(x) = ROTR²(x) ⊕ ROTR¹³(x) ⊕ ROTR²²(x)
def _sha256_BigSigma0(x: Int): Int = _sha256_u32_rotr(x, 2) ^ _sha256_u32_rotr(x, 13) ^ _sha256_u32_rotr(x, 22)

# Σ₁(x) = ROTR⁶(x) ⊕ ROTR¹¹(x) ⊕ ROTR²⁵(x)
def _sha256_BigSigma1(x: Int): Int = _sha256_u32_rotr(x, 6) ^ _sha256_u32_rotr(x, 11) ^ _sha256_u32_rotr(x, 25)

# σ₀(x) = ROTR⁷(x) ⊕ ROTR¹⁸(x) ⊕ SHR³(x) — SHR is logical (zero-fill).
def _sha256_SmallSigma0(x: Int): Int = _sha256_u32_rotr(x, 7) ^ _sha256_u32_rotr(x, 18) ^ _sha256_u32_lsr(x, 3)

# σ₁(x) = ROTR¹⁷(x) ⊕ ROTR¹⁹(x) ⊕ SHR¹⁰(x)
def _sha256_SmallSigma1(x: Int): Int = _sha256_u32_rotr(x, 17) ^ _sha256_u32_rotr(x, 19) ^ _sha256_u32_lsr(x, 10)

# =============================================================================
# Compression — process one 64-byte block into 32-byte chain state.
# =============================================================================

# h points to 8 u32 = 32 bytes of chain state (LE-stored, mutated in place).
# block points to 16 u32 = 64 bytes of message data (BE on disk).
def _sha256_compress(h: Int, block: Int): Void
  var w = malloc(256)   # 64 u32 message schedule

  # W[0..16] = block[0..16] big-endian → LE storage.
  var i = 0
  while i < 16
    _sha256_u32_write_le(w + i * 4, _sha256_u32_read_be(block + i * 4))
    i += 1
  end

  # W[t] = σ₁(W[t-2]) + W[t-7] + σ₀(W[t-15]) + W[t-16] for t in 16..64
  i = 16
  while i < 64
    var w_m2  = _sha256_u32_read_le(w + (i - 2)  * 4)
    var w_m7  = _sha256_u32_read_le(w + (i - 7)  * 4)
    var w_m15 = _sha256_u32_read_le(w + (i - 15) * 4)
    var w_m16 = _sha256_u32_read_le(w + (i - 16) * 4)
    var wi = _sha256_u32_add(_sha256_u32_add(_sha256_u32_add(_sha256_SmallSigma1(w_m2), w_m7), _sha256_SmallSigma0(w_m15)), w_m16)
    _sha256_u32_write_le(w + i * 4, wi)
    i += 1
  end

  var a = _sha256_u32_read_le(h + 0)
  var b = _sha256_u32_read_le(h + 4)
  var c = _sha256_u32_read_le(h + 8)
  var d = _sha256_u32_read_le(h + 12)
  var e = _sha256_u32_read_le(h + 16)
  var f = _sha256_u32_read_le(h + 20)
  var g = _sha256_u32_read_le(h + 24)
  var hh = _sha256_u32_read_le(h + 28)

  var t = 0
  while t < 64
    var t1 = _sha256_u32_add(_sha256_u32_add(_sha256_u32_add(_sha256_u32_add(hh, _sha256_BigSigma1(e)), _sha256_Ch(e, f, g)), _sha256_K(t)), _sha256_u32_read_le(w + t * 4))
    var t2 = _sha256_u32_add(_sha256_BigSigma0(a), _sha256_Maj(a, b, c))
    hh = g
    g = f
    f = e
    e = _sha256_u32_add(d, t1)
    d = c
    c = b
    b = a
    a = _sha256_u32_add(t1, t2)
    t += 1
  end

  _sha256_u32_write_le(h + 0,  _sha256_u32_add(_sha256_u32_read_le(h + 0),  a))
  _sha256_u32_write_le(h + 4,  _sha256_u32_add(_sha256_u32_read_le(h + 4),  b))
  _sha256_u32_write_le(h + 8,  _sha256_u32_add(_sha256_u32_read_le(h + 8),  c))
  _sha256_u32_write_le(h + 12, _sha256_u32_add(_sha256_u32_read_le(h + 12), d))
  _sha256_u32_write_le(h + 16, _sha256_u32_add(_sha256_u32_read_le(h + 16), e))
  _sha256_u32_write_le(h + 20, _sha256_u32_add(_sha256_u32_read_le(h + 20), f))
  _sha256_u32_write_le(h + 24, _sha256_u32_add(_sha256_u32_read_le(h + 24), g))
  _sha256_u32_write_le(h + 28, _sha256_u32_add(_sha256_u32_read_le(h + 28), hh))

  free(w)
end

# =============================================================================
# Streaming API
# =============================================================================
#
# Context layout (112 bytes):
#   offset 0..32    chain state h (8 LE u32s)
#   offset 32..96   partial block buffer (up to 64 bytes)
#   offset 96..104  buffer length (Int)
#   offset 104..112 total length in bytes (Int)

def _sha256_CTX_SIZE(): Int = 112
def _sha256_OFF_H(): Int = 0
def _sha256_OFF_BUF(): Int = 32
def _sha256_OFF_BUFLEN(): Int = 96
def _sha256_OFF_TOTALLEN(): Int = 104

# Buflen + totallen live as 8-byte Ints (LE) so the same pointer-byte
# helpers work; sha512.qz makes the same call.
def _sha256_ctx_buflen(ctx: Int): Int
  var b0 = ptr_read_byte(ctx + _sha256_OFF_BUFLEN())
  var b1 = ptr_read_byte(ctx + _sha256_OFF_BUFLEN() + 1)
  return b0 | (b1 << 8)
end

def _sha256_ctx_set_buflen(ctx: Int, v: Int): Void
  ptr_write_byte(ctx + _sha256_OFF_BUFLEN(),     v & 0xff)
  ptr_write_byte(ctx + _sha256_OFF_BUFLEN() + 1, _sha256_u32_lsr(v, 8) & 0xff)
end

# total len as 8-byte LE
def _sha256_ctx_totallen(ctx: Int): Int
  var i = 0
  var v = 0
  while i < 8
    var b = ptr_read_byte(ctx + _sha256_OFF_TOTALLEN() + i)
    v = v | (b << (i * 8))
    i = i + 1
  end
  return v
end

def _sha256_ctx_set_totallen(ctx: Int, v: Int): Void
  var i = 0
  while i < 8
    ptr_write_byte(ctx + _sha256_OFF_TOTALLEN() + i, _sha256_u32_lsr(v, i * 8) & 0xff)
    i = i + 1
  end
end

## Allocate and init a streaming SHA-256 context. Callers must finalise (which
## frees) or free explicitly.
def sha256_new(): Int
  _sha256_ensure_k_table()
  var ctx = malloc(_sha256_CTX_SIZE())
  memset(ctx, 0, _sha256_CTX_SIZE())
  var h = ctx + _sha256_OFF_H()
  _sha256_u32_write_le(h +  0, _sha256_IV_0())
  _sha256_u32_write_le(h +  4, _sha256_IV_1())
  _sha256_u32_write_le(h +  8, _sha256_IV_2())
  _sha256_u32_write_le(h + 12, _sha256_IV_3())
  _sha256_u32_write_le(h + 16, _sha256_IV_4())
  _sha256_u32_write_le(h + 20, _sha256_IV_5())
  _sha256_u32_write_le(h + 24, _sha256_IV_6())
  _sha256_u32_write_le(h + 28, _sha256_IV_7())
  return ctx
end

## Feed `input_len` bytes of `input` into the streaming hash.
def sha256_update(ctx: Int, input: Int, input_len: Int): Void
  var h = ctx + _sha256_OFF_H()
  var buf = ctx + _sha256_OFF_BUF()
  var buflen = _sha256_ctx_buflen(ctx)
  _sha256_ctx_set_totallen(ctx, _sha256_ctx_totallen(ctx) + input_len)

  var src = input
  var remaining = input_len

  if buflen > 0
    var want = 64 - buflen
    if want > remaining
      want = remaining
    end
    memcpy(buf + buflen, src, want)
    buflen = buflen + want
    src = src + want
    remaining = remaining - want
    if buflen == 64
      _sha256_compress(h, buf)
      buflen = 0
    end
  end

  while remaining >= 64
    _sha256_compress(h, src)
    src = src + 64
    remaining = remaining - 64
  end

  if remaining > 0
    memcpy(buf + buflen, src, remaining)
    buflen = buflen + remaining
  end

  _sha256_ctx_set_buflen(ctx, buflen)
end

## Finalise: pad, mix in length, emit 32-byte digest into `output`. Frees ctx.
def sha256_finalize(ctx: Int, output: Int): Void
  var h = ctx + _sha256_OFF_H()
  var buf = ctx + _sha256_OFF_BUF()
  var buflen = _sha256_ctx_buflen(ctx)
  var total_bytes = _sha256_ctx_totallen(ctx)

  ptr_write_byte(buf + buflen, 128)   # 0x80
  buflen = buflen + 1

  if buflen > 56
    memset(buf + buflen, 0, 64 - buflen)
    _sha256_compress(h, buf)
    buflen = 0
  end
  memset(buf + buflen, 0, 56 - buflen)

  # 64-bit BE bit-length at bytes 56..64.
  var bits = total_bytes << 3
  ptr_write_byte(buf + 56, _sha256_u32_lsr(bits, 56) & 0xff)
  ptr_write_byte(buf + 57, _sha256_u32_lsr(bits, 48) & 0xff)
  ptr_write_byte(buf + 58, _sha256_u32_lsr(bits, 40) & 0xff)
  ptr_write_byte(buf + 59, _sha256_u32_lsr(bits, 32) & 0xff)
  ptr_write_byte(buf + 60, _sha256_u32_lsr(bits, 24) & 0xff)
  ptr_write_byte(buf + 61, _sha256_u32_lsr(bits, 16) & 0xff)
  ptr_write_byte(buf + 62, _sha256_u32_lsr(bits, 8)  & 0xff)
  ptr_write_byte(buf + 63, bits & 0xff)

  _sha256_compress(h, buf)

  # Emit digest big-endian (FIPS 180-4 §6.2.2 step 4).
  var i = 0
  while i < 8
    _sha256_u32_write_be(output + i * 4, _sha256_u32_read_le(h + i * 4))
    i += 1
  end

  free(ctx)
end

## Compute the 32-byte SHA-256 digest of `input` (`input_len` bytes) into
## `output`. Output buffer must be at least 32 bytes.
def sha256(input: Int, input_len: Int, output: Int): Void
  var ctx = sha256_new()
  sha256_update(ctx, input, input_len)
  sha256_finalize(ctx, output)
end

# =============================================================================
# Spec constants (block size + digest size — useful for HMAC / HKDF callers)
# =============================================================================

def SHA256_BLOCK_SIZE(): Int = 64
def SHA256_DIGEST_SIZE(): Int = 32
