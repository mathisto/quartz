## std/core/crypto/poly1305 — Pure-Quartz Poly1305-MAC (RFC 8439 §2.5)
##
## NET.1 Phase 2 Step 2.15 — sixth native crypto primitive (after HChaCha20,
## BLAKE2s, HKDF, HMAC, ChaCha20 + AEAD composition). Replaces HACL\*
## `Hacl_MAC_Poly1305_mac` and drops `Hacl_MAC_Poly1305.c` from the build.
## This is the only NIST-track WireGuard primitive (FIPS 197 / RFC 8439 §2.5);
## Wycheproof loader (Step 2.15a, filed) becomes load-bearing here.
##
## Algorithm: GF(p) arithmetic where p = 2^130 - 5. Single-shot MAC over an
## arbitrary-length message under a 32-byte key K = r || s where:
##   - r (16 bytes) is "clamped" — specific bits of r are forced to zero so
##     that r * a stays within reduction-friendly bounds (RFC 8439 §2.5.1).
##   - s (16 bytes) is added unmodified to the final accumulator.
## For each 16-byte chunk c_i of msg (last chunk may be shorter):
##   - Form n_i = le_int(c_i || 0x01) — append a 1 byte then read as LE int.
##   - Update a := (a + n_i) * r mod p.
## Final tag = (a + s) mod 2^128, written little-endian into out_16.
##
## Representation: 5 × 26-bit limbs in i64 storage. This is the standard
## RFC-reference layout (HACL\* Poly1305_32 also uses 5×26-bit). Quartz Int
## is i64; 26-bit × 26-bit products fit in 52 bits, sums of 5 products fit
## in ~55 bits — all comfortably within signed 64-bit. No widening_mul
## intrinsic needed (Curve25519 territory). Modular reduction uses the
## 2^130 ≡ 5 (mod p) identity to fold the high half back into the low half
## per multiplication.
##
## Constant-time discipline:
##   - No data-dependent branches; loop count is `msg_len / 16`.
##   - Final reduction uses `subtle::ct_select_int` for the conditional
##     subtract-p step (a >= p ↔ select g over a).
##   - Short last block is built into a fixed 16-byte stack buffer with the
##     0x01 byte placed at a non-secret offset.
##
## Validation (per design memo "gated by Wycheproof + interop", Step 2.15
## opens the gate):
##   - 6 KAT vectors in crypto:smoke (RFC 8439 §2.5.2 + Python reference for
##     boundary cases: empty msg, 1B, 17B multi-block-with-short-last, 32B
##     all-zero, 64B 4-full-blocks).
##   - wg:smoke 48/48 stays green (Poly1305 in the AEAD path validates every
##     transport / cookie-reply tag through Noise IKpsk2).
##   - Cross-impl interop with wireguard-go stays green (proves byte-level
##     compatibility with the reference impl on the wire).
##   - Wycheproof loader (Step 2.15a) extends this corpus with Google's
##     adversarial vector set; filed as the immediate follow-up.
##
## See:
## - RFC 8439 §2.5 (Poly1305 algorithm)
## - poly1305-donna by Andrew Moon (5×26-bit reference impl style)
## - HACL\* Hacl_MAC_Poly1305_32 (cross-validated against during dev)
## - docs/design/CRYPTO_STDLIB_DESIGN.md (Phase 2 native-primitive plan)

import * from ffi/socket          # malloc/free/memcpy/memset/ptr_*
import std/core/crypto/subtle    # ct_select_int for final reduction

# =============================================================================
# u32 little-endian read helper.
# =============================================================================

def _p1305_read_u32_le(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(p + 1)
  var b2 = ptr_read_byte(p + 2)
  var b3 = ptr_read_byte(p + 3)
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
end

def _p1305_write_u32_le(p: Int, v: Int): Void
  ptr_write_byte(p,     v & 255)
  ptr_write_byte(p + 1, (v >> 8) & 255)
  ptr_write_byte(p + 2, (v >> 16) & 255)
  ptr_write_byte(p + 3, (v >> 24) & 255)
end

# =============================================================================
# Poly1305-MAC
# =============================================================================

## Poly1305-MAC(out_16, msg, msg_len, key) — single-shot MAC.
##
## Args:
## - out_16:  16-byte output buffer (the tag).
## - msg:     message bytes (may be empty: msg=0, msg_len=0).
## - msg_len: message length in bytes (any non-negative value).
## - key:     32-byte key buffer (r || s).
def poly1305_mac(out_16: Int, msg: Int, msg_len: Int, key: Int): Void
  # ---- 1. Read + clamp r from key[0..16] ---------------------------------
  # Clamp mask 0x0ffffffc 0ffffffc 0ffffffc 0fffffff (LE):
  #   t0 &= 0x0fffffff   (top 4 bits of word 0 cleared)
  #   t1 &= 0x0ffffffc   (top 4 + bottom 2 bits of word 1 cleared)
  #   t2 &= 0x0ffffffc
  #   t3 &= 0x0ffffffc
  var t0 = _p1305_read_u32_le(key) & 268435455       # 0x0fffffff
  var t1 = _p1305_read_u32_le(key + 4) & 268435452   # 0x0ffffffc
  var t2 = _p1305_read_u32_le(key + 8) & 268435452
  var t3 = _p1305_read_u32_le(key + 12) & 268435452

  # Split clamped 128-bit r into 5 × 26-bit limbs.
  # MASK26 = 0x3ffffff = 67108863
  var r0 = t0 & 67108863
  var r1 = ((t0 >> 26) | (t1 << 6)) & 67108863
  var r2 = ((t1 >> 20) | (t2 << 12)) & 67108863
  var r3 = ((t2 >> 14) | (t3 << 18)) & 67108863
  var r4 = (t3 >> 8) & 67108863

  # Precompute s_i = r_i * 5 for the 2^130 ≡ 5 (mod p) reduction trick.
  # Used in the high-limb folding during multiply.
  var s1 = r1 * 5
  var s2 = r2 * 5
  var s3 = r3 * 5
  var s4 = r4 * 5

  # ---- 2. Read s from key[16..32] (used at the very end) ------------------
  var sk0 = _p1305_read_u32_le(key + 16)
  var sk1 = _p1305_read_u32_le(key + 20)
  var sk2 = _p1305_read_u32_le(key + 24)
  var sk3 = _p1305_read_u32_le(key + 28)

  # ---- 3. Initialize accumulator a = 0 -----------------------------------
  var a0 = 0
  var a1 = 0
  var a2 = 0
  var a3 = 0
  var a4 = 0

  # ---- 4. Process each block of msg --------------------------------------
  # Stack-equivalent 16-byte buffer reused across short-last-block paths;
  # malloc'd once outside the loop only when msg has a short last block.
  var pad = malloc(16)

  var i = 0
  while i < msg_len
    var remaining = msg_len - i
    var n0 = 0
    var n1 = 0
    var n2 = 0
    var n3 = 0
    var hibit = 0   # 0x01 byte position: 1 means at bit 128, 0 means inside chunk

    if remaining >= 16
      # Full block: read 16 bytes + set the 0x01 marker at bit 128.
      n0 = _p1305_read_u32_le(msg + i)
      n1 = _p1305_read_u32_le(msg + i + 4)
      n2 = _p1305_read_u32_le(msg + i + 8)
      n3 = _p1305_read_u32_le(msg + i + 12)
      hibit = 1
    else
      # Short last block: zero-pad to 16 bytes with 0x01 inserted at the
      # end of the data. The 0x01 byte then lives inside the 16-byte buffer,
      # so hibit stays 0. Walk the full 16 bytes either way (constant-time-ish).
      var j = 0
      while j < 16
        if j < remaining
          ptr_write_byte(pad + j, ptr_read_byte(msg + i + j))
        elsif j == remaining
          ptr_write_byte(pad + j, 1)
        else
          ptr_write_byte(pad + j, 0)
        end
        j += 1
      end
      n0 = _p1305_read_u32_le(pad)
      n1 = _p1305_read_u32_le(pad + 4)
      n2 = _p1305_read_u32_le(pad + 8)
      n3 = _p1305_read_u32_le(pad + 12)
      hibit = 0
    end

    # Convert (n0,n1,n2,n3,hibit at bit 128) to 5×26-bit limbs and add to acc.
    a0 = a0 + (n0 & 67108863)
    a1 = a1 + (((n0 >> 26) | (n1 << 6)) & 67108863)
    a2 = a2 + (((n1 >> 20) | (n2 << 12)) & 67108863)
    a3 = a3 + (((n2 >> 14) | (n3 << 18)) & 67108863)
    # Limb 4 covers bits [104..130). n3>>8 gives 24 bits ([104..128)).
    # hibit goes at bit 128 = position 24 within limb 4.
    a4 = a4 + ((n3 >> 8) | (hibit << 24))

    # Multiply: a = (a * r) mod p, with reduction via 2^130 ≡ 5.
    # Limbs 5..8 of the 9-limb product fold into limbs 0..3 via *5.
    var d0 = a0 * r0 + a1 * s4 + a2 * s3 + a3 * s2 + a4 * s1
    var d1 = a0 * r1 + a1 * r0 + a2 * s4 + a3 * s3 + a4 * s2
    var d2 = a0 * r2 + a1 * r1 + a2 * r0 + a3 * s4 + a4 * s3
    var d3 = a0 * r3 + a1 * r2 + a2 * r1 + a3 * r0 + a4 * s4
    var d4 = a0 * r4 + a1 * r3 + a2 * r2 + a3 * r1 + a4 * r0

    # Carry propagation. Each d_k is up to ~55 bits; mask down to 26 and
    # carry the rest into the next limb. The wraparound from d4 → d0 picks
    # up the *5 from 2^130 ≡ 5.
    var c = d0 >> 26
    a0 = d0 & 67108863
    d1 = d1 + c
    c = d1 >> 26
    a1 = d1 & 67108863
    d2 = d2 + c
    c = d2 >> 26
    a2 = d2 & 67108863
    d3 = d3 + c
    c = d3 >> 26
    a3 = d3 & 67108863
    d4 = d4 + c
    c = d4 >> 26
    a4 = d4 & 67108863
    a0 = a0 + c * 5
    c = a0 >> 26
    a0 = a0 & 67108863
    a1 = a1 + c

    i = i + 16
  end

  free(pad)

  # ---- 5. Final reduction mod p ------------------------------------------
  # Run a full carry chain to ensure all limbs (except possibly bumping
  # back into a0 via the wrap) are in canonical 26-bit form.
  var c = a1 >> 26
  a1 = a1 & 67108863
  a2 = a2 + c
  c = a2 >> 26
  a2 = a2 & 67108863
  a3 = a3 + c
  c = a3 >> 26
  a3 = a3 & 67108863
  a4 = a4 + c
  c = a4 >> 26
  a4 = a4 & 67108863
  a0 = a0 + c * 5
  c = a0 >> 26
  a0 = a0 & 67108863
  a1 = a1 + c
  # All five limbs now in [0, 2^26). Value `a` lies in [0, 2*p) at most.

  # Compute g = a - p = a + 5 - 2^130.
  # In limbs: g0 = a0 + 5; carry forward; g4 = a4 + carry - 2^26 (= subtract
  # 2^130 since limb 4 has weight 2^104). g4 is signed in i64 — negative
  # value flags "a < p" (don't subtract).
  var g0 = a0 + 5
  c = g0 >> 26
  g0 = g0 & 67108863
  var g1 = a1 + c
  c = g1 >> 26
  g1 = g1 & 67108863
  var g2 = a2 + c
  c = g2 >> 26
  g2 = g2 & 67108863
  var g3 = a3 + c
  c = g3 >> 26
  g3 = g3 & 67108863
  # 2^26 = 67108864; subtracting clears the overflow bit when a >= p.
  var g4 = (a4 + c) - 67108864

  # Branchless conditional select: if g4 < 0 (top bit of i64 set), use a;
  # otherwise use g. mask = -1 if a < p else 0.
  var mask = (g4 >> 63) & 1
  # mask is 1 if g4 negative (a<p). Need -1 (all bits) for ct_select_int.
  mask = 0 - mask
  a0 = ct_select_int(mask, a0, g0)
  a1 = ct_select_int(mask, a1, g1)
  a2 = ct_select_int(mask, a2, g2)
  a3 = ct_select_int(mask, a3, g3)
  a4 = ct_select_int(mask, a4, g4 & 67108863)

  # ---- 6. Pack 5×26-bit limbs into 4 × u32 + add s + emit -----------------
  # Recompose the 130-bit value into four 32-bit words:
  #   w0 = a0       | a1 << 26  (low 32 bits of bit-pos [0..32))
  #   w1 = a1 >> 6  | a2 << 20  (bit-pos [32..64))
  #   w2 = a2 >> 12 | a3 << 14  (bit-pos [64..96))
  #   w3 = a3 >> 18 | a4 << 8   (bit-pos [96..128))
  var w0 = (a0 | (a1 << 26)) & 4294967295
  var w1 = ((a1 >> 6) | (a2 << 20)) & 4294967295
  var w2 = ((a2 >> 12) | (a3 << 14)) & 4294967295
  var w3 = ((a3 >> 18) | (a4 << 8)) & 4294967295

  # Add s with carry chain. tag = (a + s) mod 2^128.
  var f = w0 + sk0
  w0 = f & 4294967295
  var carry = f >> 32
  f = w1 + sk1 + carry
  w1 = f & 4294967295
  carry = f >> 32
  f = w2 + sk2 + carry
  w2 = f & 4294967295
  carry = f >> 32
  f = w3 + sk3 + carry
  w3 = f & 4294967295

  _p1305_write_u32_le(out_16,      w0)
  _p1305_write_u32_le(out_16 + 4,  w1)
  _p1305_write_u32_le(out_16 + 8,  w2)
  _p1305_write_u32_le(out_16 + 12, w3)
end
