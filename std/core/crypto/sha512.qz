  _u64_write_le(t + 79  * 8, 7801388544844847127)    # 0x6c44198c4a475817
  _k_table = t
  return t
end

def _K(round: Int): Int = _u64_read_le(_k_table + round * 8)

# =============================================================================
# Round functions (FIPS 180-4 §4.1.3)
# =============================================================================

# Ch(x, y, z) = (x ∧ y) ⊕ (¬x ∧ z) — bit-wise multiplex on x.
def _Ch(x: Int, y: Int, z: Int): Int = (x & y) ^ ((~x) & z)

# Maj(x, y, z) = (x ∧ y) ⊕ (x ∧ z) ⊕ (y ∧ z)
def _Maj(x: Int, y: Int, z: Int): Int = (x & y) ^ (x & z) ^ (y & z)

# Σ₀(x) = ROTR²⁸(x) ⊕ ROTR³⁴(x) ⊕ ROTR³⁹(x)
def _BigSigma0(x: Int): Int = _u64_rotr(x, 28) ^ _u64_rotr(x, 34) ^ _u64_rotr(x, 39)

# Σ₁(x) = ROTR¹⁴(x) ⊕ ROTR¹⁸(x) ⊕ ROTR⁴¹(x)
def _BigSigma1(x: Int): Int = _u64_rotr(x, 14) ^ _u64_rotr(x, 18) ^ _u64_rotr(x, 41)

# σ₀(x) = ROTR¹(x) ⊕ ROTR⁸(x) ⊕ SHR⁷(x) — SHR is logical (zero-fill).
def _SmallSigma0(x: Int): Int = _u64_rotr(x, 1) ^ _u64_rotr(x, 8) ^ _u64_lsr(x, 7)

# σ₁(x) = ROTR¹⁹(x) ⊕ ROTR⁶¹(x) ⊕ SHR⁶(x)
def _SmallSigma1(x: Int): Int = _u64_rotr(x, 19) ^ _u64_rotr(x, 61) ^ _u64_lsr(x, 6)

# =============================================================================
# Compression — process one 128-byte block into the 64-byte chain state.
# =============================================================================

# h points to 8 u64 = 64 bytes of chain state (mutated in place).
# block points to 16 u64 = 128 bytes of message data (read-only).
def _compress(h: Int, block: Int): Void
  var w = malloc(640)   # 80 u64 message schedule

  # W[0..16] = block[0..16] big-endian → little-endian storage (we read back
  # via _u64_read_le inside the loop so internal endianness is hidden).
  var i = 0
  while i < 16
    _u64_write_le(w + i * 8, _u64_read_be(block + i * 8))
    i += 1
  end

  # W[t] = σ₁(W[t-2]) + W[t-7] + σ₀(W[t-15]) + W[t-16] for t in 16..80
  i = 16
  while i < 80
    var w_m2  = _u64_read_le(w + (i - 2)  * 8)
    var w_m7  = _u64_read_le(w + (i - 7)  * 8)
    var w_m15 = _u64_read_le(w + (i - 15) * 8)
    var w_m16 = _u64_read_le(w + (i - 16) * 8)
    var wi = _SmallSigma1(w_m2) + w_m7 + _SmallSigma0(w_m15) + w_m16
    _u64_write_le(w + i * 8, wi)
    i += 1
  end

  # Initialize working vars from chain state.
  var a = _u64_read_le(h + 0)
  var b = _u64_read_le(h + 8)
  var c = _u64_read_le(h + 16)
  var d = _u64_read_le(h + 24)
  var e = _u64_read_le(h + 32)
  var f = _u64_read_le(h + 40)
  var g = _u64_read_le(h + 48)
  var hh = _u64_read_le(h + 56)

  # 80 rounds.
  var t = 0
  while t < 80
    var t1 = hh + _BigSigma1(e) + _Ch(e, f, g) + _K(t) + _u64_read_le(w + t * 8)
    var t2 = _BigSigma0(a) + _Maj(a, b, c)
    hh = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2
    t += 1
  end

  # Compute the i'th intermediate hash value H(i) and write back.
  _u64_write_le(h + 0,  _u64_read_le(h + 0)  + a)
  _u64_write_le(h + 8,  _u64_read_le(h + 8)  + b)
  _u64_write_le(h + 16, _u64_read_le(h + 16) + c)
  _u64_write_le(h + 24, _u64_read_le(h + 24) + d)
  _u64_write_le(h + 32, _u64_read_le(h + 32) + e)
  _u64_write_le(h + 40, _u64_read_le(h + 40) + f)
  _u64_write_le(h + 48, _u64_read_le(h + 48) + g)
  _u64_write_le(h + 56, _u64_read_le(h + 56) + hh)

  free(w)
end

# =============================================================================
# Streaming API
# =============================================================================
#
# Context layout (208 bytes total):
#
#   offset 0..64    chain state h (8 LE u64s, stored LE for fast read/write)
#   offset 64..192  partial block buffer (up to 128 bytes)
#   offset 192..200 buffer length (Int — bytes currently in partial buffer)
#   offset 200..208 total length in bytes (Int — bytes hashed including
#                                          the partial buffer; capped at i64)
#
# SHA-512's spec calls for a 128-bit total-bit-length pad. We only support
# total byte-lengths up to 2^60 (i64 / 8 bytes/bit) — anyone hashing more
## than an exabyte through a single context can file a follow-up.

def _SHA512_CTX_SIZE(): Int = 208
def _OFF_H(): Int = 0
def _OFF_BUF(): Int = 64
def _OFF_BUFLEN(): Int = 192
def _OFF_TOTALLEN(): Int = 200

def _ctx_buflen(ctx: Int): Int = _u64_read_le(ctx + _OFF_BUFLEN())
def _ctx_set_buflen(ctx: Int, v: Int): Void = _u64_write_le(ctx + _OFF_BUFLEN(), v)
def _ctx_totallen(ctx: Int): Int = _u64_read_le(ctx + _OFF_TOTALLEN())
def _ctx_set_totallen(ctx: Int, v: Int): Void = _u64_write_le(ctx + _OFF_TOTALLEN(), v)

## Allocate and initialise a streaming SHA-512 context. Returns the context
## pointer; callers must finalise (which frees) or free explicitly.
def sha512_new(): Int
  _ensure_k_table()
  var ctx = malloc(_SHA512_CTX_SIZE())
  memset(ctx, 0, _SHA512_CTX_SIZE())
  var h = ctx + _OFF_H()
  _u64_write_le(h + 0,  _IV_0())
  _u64_write_le(h + 8,  _IV_1())
  _u64_write_le(h + 16, _IV_2())
  _u64_write_le(h + 24, _IV_3())
  _u64_write_le(h + 32, _IV_4())
  _u64_write_le(h + 40, _IV_5())
  _u64_write_le(h + 48, _IV_6())
  _u64_write_le(h + 56, _IV_7())
  return ctx
end

## Feed `input_len` bytes of `input` into the streaming hash.
def sha512_update(ctx: Int, input: Int, input_len: Int): Void
  var h = ctx + _OFF_H()
  var buf = ctx + _OFF_BUF()
  var buflen = _ctx_buflen(ctx)
  _ctx_set_totallen(ctx, _ctx_totallen(ctx) + input_len)

  var src = input
  var remaining = input_len

  # Top up the partial buffer if it's non-empty and we have data.
  if buflen > 0
    var want = 128 - buflen
    if want > remaining
      want = remaining
    end
    memcpy(buf + buflen, src, want)
    buflen = buflen + want
    src = src + want
    remaining = remaining - want
    if buflen == 128
      _compress(h, buf)
      buflen = 0
    end
  end

  # Process full blocks directly from the input buffer.
  while remaining >= 128
    _compress(h, src)
    src = src + 128
    remaining = remaining - 128
  end

  # Stash the tail in the partial buffer.
  if remaining > 0
    memcpy(buf + buflen, src, remaining)
    buflen = buflen + remaining
  end

  _ctx_set_buflen(ctx, buflen)
end

## Finalise: pad, mix in length, emit 64-byte digest into `output`. Frees ctx.
def sha512_finalize(ctx: Int, output: Int): Void
  var h = ctx + _OFF_H()
  var buf = ctx + _OFF_BUF()
  var buflen = _ctx_buflen(ctx)
  var total_bytes = _ctx_totallen(ctx)

  # Append 0x80; pad with zeros so the final 16 bytes of the last block carry
  # the message length in bits as a 128-bit big-endian integer. The high 64
  # bits of that length are always zero in our impl (we cap totallen at i64).
  ptr_write_byte(buf + buflen, 128)   # 0x80
  buflen = buflen + 1

  if buflen > 112
    # Not enough room for the length field in this block — zero-fill to 128,
    # compress, then start a fresh block for the length suffix.
    memset(buf + buflen, 0, 128 - buflen)
    _compress(h, buf)
    buflen = 0
  end

  # Zero-fill up to byte 112; bytes 112..128 hold the 128-bit BE length.
  memset(buf + buflen, 0, 112 - buflen)

  # High 64 bits of bit-length = 0 (we cap at i64-bytes; i64 × 8 < 2^67 but
  # the high half is *strictly* zero only if total_bytes < 2^61. Anyone
  # hashing > 2 EB through one context is on their own.)
  _u64_write_be(buf + 112, 0)
  # Low 64 bits: total_bits = total_bytes * 8. SHA-512 spec is bits;
  # we cap at i64 / 8 by construction of the streaming API.
  _u64_write_be(buf + 120, total_bytes << 3)

  _compress(h, buf)

  # Emit digest big-endian (FIPS 180-4 §6.4.2 step 4 — the 64-byte hash is
  # the chain state H₀ ‖ H₁ ‖ … ‖ H₇ as 8 big-endian u64s).
  var i = 0
  while i < 8
    _u64_write_be(output + i * 8, _u64_read_le(h + i * 8))
    i += 1
  end

  free(ctx)
end

# =============================================================================
# One-shot API
# =============================================================================

## Compute the 64-byte SHA-512 digest of `input` (`input_len` bytes) into
## `output`. Output buffer must be at least 64 bytes.
def sha512(input: Int, input_len: Int, output: Int): Void
  var ctx = sha512_new()
  sha512_update(ctx, input, input_len)
  sha512_finalize(ctx, output)
end
