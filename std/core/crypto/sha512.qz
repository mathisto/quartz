  _u64_write_le(t + 29  * 8, -3051310485924567259)   # 0xd5a79147930aa725
  _u64_write_le(t + 30  * 8, 489312712824947311)     # 0x06ca6351e003826f
  _u64_write_le(t + 31  * 8, 1452737877330783856)    # 0x142929670a0e6e70
