  _u64_write_le(t + 33  * 8, 3322285676063803686)    # 0x2e1b21385c26c926
  _u64_write_le(t + 34  * 8, 5560940570517711597)    # 0x4d2c6dfc5ac42aed
  _u64_write_le(t + 35  * 8, 5996557281743188959)    # 0x53380d139d95b3df
