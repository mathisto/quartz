  _u64_write_le(t + 46  * 8, -860691631967231958)    # 0xf40e35855771202a
  _u64_write_le(t + 47  * 8, 1182934255886127544)    # 0x106aa07032bbd1b8
  _u64_write_le(t + 48  * 8, 1847814050463011016)    # 0x19a4c116b8d2d0c8
