  _u64_write_le(t + 23  * 8, 8573033837759648693)    # 0x76f988da831153b5
  _u64_write_le(t + 24  * 8, -7476448914759557205)   # 0x983e5152ee66dfab
  _u64_write_le(t + 25  * 8, -6327057829258317296)   # 0xa831c66d2db43210
