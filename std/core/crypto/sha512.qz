## std/core/crypto/sha512 — Pure-Quartz SHA-512 (FIPS 180-4)
##
## NET.2 prerequisite. Ed25519's keygen / sign / verify all run their inputs
## through SHA-512 — the 32-byte seed is hashed to derive the clamped scalar
## and prefix, the nonce r is SHA-512(prefix || msg) mod L, the challenge k
## is SHA-512(R || A || msg) mod L. SHA-512 is also a free win once the
## ARX-over-u64 substrate exists: NET.3 (ML-KEM hybrid) needs SHA-3-256/512
## and SHAKE128/256 — those are different primitives but share the
## "ptr-buffer, byte-LE I/O, malloc'd state" pattern with this file.
##
## Implementation notes:
##
## - The compression function is straight FIPS 180-4 §6.4. 80-round message
##   schedule (W[0..15] = block words; W[t] = σ₁(W[t-2]) + W[t-7] + σ₀(W[t-15])
##   + W[t-16] for t in 16..80). Then the inner-round update on (a..h).
##
## - Quartz `>>` is arithmetic shift right (ashr). u64 rotate-right and the
##   `SHR` in σ₀/σ₁ both need a logical-shift, which we synthesise as
##   `(x >> n) & ((1 << (64 - n)) - 1)` — the mask zeros out any
##   sign-extended 1s in the upper n bits. Same pattern curve25519.qz uses for
##   its `(s >> 51) & 8191` carry extraction.
##
## - K constants ship as a 640-byte lazily-initialised table (80 entries × 8
##   bytes, little-endian). Mirrors the way blake2s.qz handles its SIGMA
##   table. Could be 80 `def _K_NN(): Int = ...` calls but the compression
##   loop would have to fan out into a switch; the table lookup is cleaner.
##
## - All buffers are caller-owned. Output buffer must hold ≥ 64 bytes.
##
## Validation gates:
##
## - FIPS 180-4 §D.4 test vectors (empty, "abc", 56-byte ABC-string, long
##   block). All four land in `spec/qspec/sha512_spec.qz`.
## - Cross-impl: `printf 'abc' | openssl dgst -sha512` must agree.
## - Streaming = one-shot equivalence (an `sha512` of N bytes equals
##   `sha512_new` + `sha512_update` × k chunks + `sha512_finalize`).
##
## See:
## - FIPS 180-4 https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf §6.4
## - docs/design/ED25519_DESIGN.md "SHA-512 internals"

import * from ffi/socket  # malloc/free/memcpy/memset, ptr_read_byte/ptr_write_byte

# =============================================================================
# u64 ARX helpers
# =============================================================================

# Logical shift right (zero-fill). Quartz `>>` is ashr; mask off the upper
# n bits so a set bit-63 doesn't sign-extend into them.
# Caller guarantees n in [1, 63].
def _u64_lsr(x: Int, n: Int): Int
  return (x >> n) & ((1 << (64 - n)) - 1)
end

# Right-rotate u64 by n in [1, 63].
def _u64_rotr(x: Int, n: Int): Int
  return _u64_lsr(x, n) | (x << (64 - n))
end

# Read 8 bytes at p as a big-endian u64. SHA-512 reads its message block in
# big-endian (FIPS 180-4 §3.1 — bytes 0..7 of an octet sequence map to the
# high..low bits of the first u64).
def _u64_read_be(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(p + 1)
  var b2 = ptr_read_byte(p + 2)
  var b3 = ptr_read_byte(p + 3)
  var b4 = ptr_read_byte(p + 4)
  var b5 = ptr_read_byte(p + 5)
  var b6 = ptr_read_byte(p + 6)
  var b7 = ptr_read_byte(p + 7)
  return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
end

# Write u64 v to p as 8 bytes, big-endian — used to emit the digest.
def _u64_write_be(p: Int, v: Int): Void
  ptr_write_byte(p,     _u64_lsr(v, 56) & 255)
  ptr_write_byte(p + 1, _u64_lsr(v, 48) & 255)
  ptr_write_byte(p + 2, _u64_lsr(v, 40) & 255)
  ptr_write_byte(p + 3, _u64_lsr(v, 32) & 255)
  ptr_write_byte(p + 4, _u64_lsr(v, 24) & 255)
  ptr_write_byte(p + 5, _u64_lsr(v, 16) & 255)
  ptr_write_byte(p + 6, _u64_lsr(v, 8)  & 255)
  ptr_write_byte(p + 7, v & 255)
end

# Read/write u64 LE — used internally for the K table and chain state buffer.
def _u64_read_le(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(p + 1)
  var b2 = ptr_read_byte(p + 2)
  var b3 = ptr_read_byte(p + 3)
  var b4 = ptr_read_byte(p + 4)
  var b5 = ptr_read_byte(p + 5)
  var b6 = ptr_read_byte(p + 6)
  var b7 = ptr_read_byte(p + 7)
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
end

def _u64_write_le(p: Int, v: Int): Void
  ptr_write_byte(p,     v & 255)
  ptr_write_byte(p + 1, _u64_lsr(v, 8)  & 255)
  ptr_write_byte(p + 2, _u64_lsr(v, 16) & 255)
  ptr_write_byte(p + 3, _u64_lsr(v, 24) & 255)
  ptr_write_byte(p + 4, _u64_lsr(v, 32) & 255)
  ptr_write_byte(p + 5, _u64_lsr(v, 40) & 255)
  ptr_write_byte(p + 6, _u64_lsr(v, 48) & 255)
  ptr_write_byte(p + 7, _u64_lsr(v, 56) & 255)
end

# =============================================================================
# Constants — IV (FIPS 180-4 §5.3.5) and K (§4.2.3)
# =============================================================================

# IV: first 64 bits of the fractional parts of the square roots of the first
# 8 primes.
def _IV_0(): Int = 7640891576956012808    # 0x6a09e667f3bcc908
def _IV_1(): Int = -4942790177534073029   # 0xbb67ae8584caa73b
def _IV_2(): Int = 4354685564936845355    # 0x3c6ef372fe94f82b
def _IV_3(): Int = -6534734903238641935   # 0xa54ff53a5f1d36f1
def _IV_4(): Int = 5840696475078001361    # 0x510e527fade682d1
def _IV_5(): Int = -7276294671716946913   # 0x9b05688c2b3e6c1f
def _IV_6(): Int = 2270897969802886507    # 0x1f83d9abfb41bd6b
def _IV_7(): Int = 6620516959819538809    # 0x5be0cd19137e2179

# K: first 64 bits of the fractional parts of the cube roots of the first
# 80 primes. Stored as a lazily-initialised 640-byte LE table indexed by
# round (0..79).
var _k_table: Int = 0

def _ensure_k_table(): Int
  if _k_table != 0
    return _k_table
  end
  var t = malloc(640)
  _u64_write_le(t + 0   * 8, 4794697086780616226)    # 0x428a2f98d728ae22
  _u64_write_le(t + 1   * 8, 8158064640168781261)    # 0x7137449123ef65cd
  _u64_write_le(t + 2   * 8, -5349999486874862801)   # 0xb5c0fbcfec4d3b2f
  _u64_write_le(t + 3   * 8, -1606136188198331460)   # 0xe9b5dba58189dbbc
  _u64_write_le(t + 4   * 8, 4131703408338449720)    # 0x3956c25bf348b538
  _u64_write_le(t + 5   * 8, 6480981068601479193)    # 0x59f111f1b605d019
  _u64_write_le(t + 6   * 8, -7908458776815382629)   # 0x923f82a4af194f9b
  _u64_write_le(t + 7   * 8, -6116909921290321640)   # 0xab1c5ed5da6d8118
  _u64_write_le(t + 8   * 8, -2880145864133508542)   # 0xd807aa98a3030242
  _u64_write_le(t + 9   * 8, 1334009975649890238)    # 0x12835b0145706fbe
  _u64_write_le(t + 10  * 8, 2608012711638119052)    # 0x243185be4ee4b28c
  _u64_write_le(t + 11  * 8, 6128411473006802146)    # 0x550c7dc3d5ffb4e2
  _u64_write_le(t + 12  * 8, 8268148722764581231)    # 0x72be5d74f27b896f
