## std/core/crypto/hmac — HMAC-SHA-256 and HMAC-SHA-384 (RFC 2104)
##
## NET.5c.0 substrate. TLS 1.3's HKDF-Extract / HKDF-Expand-Label is built
## on HMAC over the negotiated hash; the TLS 1.3 cipher suite chooses
## between SHA-256 and SHA-384.
##
## HMAC(K, m) = H((K_pad ⊕ opad) ‖ H((K_pad ⊕ ipad) ‖ m))
##
## where:
##   - H is the underlying hash function
##   - block_size = 64 (SHA-256) or 128 (SHA-384)
##   - K_pad = K if len(K) ≤ block_size, else H(K), then zero-padded to block_size
##   - ipad = 0x36 repeated block_size times
##   - opad = 0x5c repeated block_size times
##
## RFC 2104 §2 + RFC 4868. Validation: RFC 4231 §4 test vectors (all 7).

import * from ffi/socket
import * from std/core/crypto/sha256
import * from std/core/crypto/sha384

# =============================================================================
# HMAC-SHA-256
# =============================================================================

# Build the block-sized HMAC key by hashing if too long, zero-padding if short.
def _hmac256_key_pad(key: Int, key_len: Int, out: Int): Void
  memset(out, 0, SHA256_BLOCK_SIZE())
  if key_len > SHA256_BLOCK_SIZE()
    sha256(key, key_len, out)
  end
  if key_len <= SHA256_BLOCK_SIZE()
    memcpy(out, key, key_len)
  end
end

## Compute HMAC-SHA-256(key, msg) into `output` (32 bytes).
def hmac_sha256(key: Int, key_len: Int, msg: Int, msg_len: Int, output: Int): Void
  var bs = SHA256_BLOCK_SIZE()
  var k_pad = malloc(bs)
  _hmac256_key_pad(key, key_len, k_pad)

  # Inner: H((k ⊕ ipad) ‖ msg)
  var ipad_block = malloc(bs)
  var i = 0
  while i < bs
    ptr_write_byte(ipad_block + i, ptr_read_byte(k_pad + i) ^ 0x36)
    i = i + 1
  end
  var inner = sha256_new()
  sha256_update(inner, ipad_block, bs)
  if msg_len > 0 then sha256_update(inner, msg, msg_len) end
  var inner_digest = malloc(SHA256_DIGEST_SIZE())
  sha256_finalize(inner, inner_digest)

  # Outer: H((k ⊕ opad) ‖ inner_digest)
  var opad_block = malloc(bs)
  i = 0
  while i < bs
    ptr_write_byte(opad_block + i, ptr_read_byte(k_pad + i) ^ 0x5c)
    i = i + 1
  end
  var outer = sha256_new()
  sha256_update(outer, opad_block, bs)
  sha256_update(outer, inner_digest, SHA256_DIGEST_SIZE())
  sha256_finalize(outer, output)

  free(inner_digest)
  free(opad_block)
  free(ipad_block)
  free(k_pad)
end

# =============================================================================
# HMAC-SHA-384
# =============================================================================

def _hmac384_key_pad(key: Int, key_len: Int, out: Int): Void
  memset(out, 0, SHA384_BLOCK_SIZE())
  if key_len > SHA384_BLOCK_SIZE()
    sha384(key, key_len, out)
  end
  if key_len <= SHA384_BLOCK_SIZE()
    memcpy(out, key, key_len)
  end
end

## Compute HMAC-SHA-384(key, msg) into `output` (48 bytes).
def hmac_sha384(key: Int, key_len: Int, msg: Int, msg_len: Int, output: Int): Void
  var bs = SHA384_BLOCK_SIZE()
  var k_pad = malloc(bs)
  _hmac384_key_pad(key, key_len, k_pad)

  var ipad_block = malloc(bs)
  var i = 0
  while i < bs
    ptr_write_byte(ipad_block + i, ptr_read_byte(k_pad + i) ^ 0x36)
    i = i + 1
  end
  var inner = sha384_new()
  sha384_update(inner, ipad_block, bs)
  if msg_len > 0 then sha384_update(inner, msg, msg_len) end
  var inner_digest = malloc(SHA384_DIGEST_SIZE())
  sha384_finalize(inner, inner_digest)

  var opad_block = malloc(bs)
  i = 0
  while i < bs
    ptr_write_byte(opad_block + i, ptr_read_byte(k_pad + i) ^ 0x5c)
    i = i + 1
  end
  var outer = sha384_new()
  sha384_update(outer, opad_block, bs)
  sha384_update(outer, inner_digest, SHA384_DIGEST_SIZE())
  sha384_finalize(outer, output)

  free(inner_digest)
  free(opad_block)
  free(ipad_block)
  free(k_pad)
end
