## std/algo/grid_bfs.qz — breadth-first search over a 2D walkable grid.
##
## Standard BFS on a `width x height` rectangular grid with
## 4-connectivity (W/E/N/S). The grid is described abstractly: the
## caller supplies an `is_blocked: Fn(Int, Int): Bool` predicate that
## closes over their own world state and returns true for cells that
## can NOT be entered. This module knows nothing about walls, doors,
## monsters, terrain — it only knows about (x, y) coordinates and a
## block predicate. Generic for roguelikes, dungeon-crawlers, grid
## puzzles, pathfinding demos, etc.
##
## Two entry points:
##
##   bfs_step(width, height, sx, sy, tx, ty, is_blocked): Int
##     Returns the FIRST direction the source should move toward the
##     target, encoded as 0=W, 1=E, 2=N, 3=S, or -1 for "no step"
##     (source == target, OOB, no path).
##
##   bfs_path(width, height, sx, sy, tx, ty, is_blocked): Vec<(Int, Int)>
##     Returns the full reconstructed path as a Vec of (x, y) pairs,
##     source-first and target-last. Empty Vec for "no path" (OOB or
##     unreachable). Single-element Vec [source] when source == target
##     (a zero-step path is still a valid path containing one cell).
##
## **Implementation.** Standard BFS with a queue of cells (parallel
## `qx` / `qy` `Vec<Int>` arrays for O(1) push and indexed read) and a
## `came_from` array indexed by `y * width + x`. Each cell stores the
## direction we arrived from (0..3); -1 means unvisited; -2 marks the
## source itself. After the frontier hits the target, walk back through
## `came_from` toward the source, reversing each direction to find the
## predecessor. For `bfs_step` the trace stops as soon as the
## predecessor IS the source — the recorded direction at that point is
## the answer. For `bfs_path` the trace records every cell from target
## back to source, then reverses the list.
##
## **Complexity.** O(width * height) time and space. Adequate for any
## practical 2D grid (10K cells handles in <1ms on this compiler's
## codegen).
##
## **A* not included.** A weighted/heuristic variant for non-uniform
## terrain is filed as a follow-up; ship when a consumer needs it.
##
## @since v0.7

# =============================================================================
# Direction constants
# =============================================================================

## Direction codes returned by `bfs_step`. Match the convention used by
## brogue-tribute's monster-step code so a port doesn't have to remap.
def DIR_WEST(): Int  = 0
def DIR_EAST(): Int  = 1
def DIR_NORTH(): Int = 2
def DIR_SOUTH(): Int = 3

# =============================================================================
# Internal helpers
# =============================================================================

## Apply direction `d` to (x, y), returning the moved-to cell as a
## tuple. Mirrors the encoding above.
def _step(x: Int, y: Int, d: Int): (Int, Int)
  if d == 0
    return (x - 1, y)
  end
  if d == 1
    return (x + 1, y)
  end
  if d == 2
    return (x, y - 1)
  end
  return (x, y + 1)
end

## Reverse of `_step`: from cell (x, y) reached by direction `d`,
## return the predecessor (the cell BFS expanded from).
def _unstep(x: Int, y: Int, d: Int): (Int, Int)
  if d == 0
    return (x + 1, y)
  end
  if d == 1
    return (x - 1, y)
  end
  if d == 2
    return (x, y + 1)
  end
  return (x, y - 1)
end

## Range check on (x, y) against the grid bounds.
def _in_bounds(x: Int, y: Int, w: Int, h: Int): Bool
  return x >= 0 and y >= 0 and x < w and y < h
end

## Run the BFS frontier expansion from (sx, sy) and stop when (tx, ty)
## is dequeued. Populates `came_from` (length `w*h`, init -1) with the
## direction code (0..3) for each visited cell, plus -2 at the source.
## Returns true if the target was reached, false otherwise.
def _bfs_walk(
  w: Int, h: Int,
  sx: Int, sy: Int, tx: Int, ty: Int,
  is_blocked: Fn(Int, Int): Bool,
  came_from: Vec<Int>
): Bool
  var qx = vec_new<Int>()
  var qy = vec_new<Int>()
  qx.push(sx)
  qy.push(sy)
  came_from[sy * w + sx] = -2

  var head = 0
  while head < qx.size
    var cx = qx[head]
    var cy = qy[head]
    head += 1

    if cx == tx and cy == ty
      return true
    end

    var d = 0
    while d < 4
      var nxt = _step(cx, cy, d)
      var nx = nxt.0
      var ny = nxt.1
      var skip = false
      if not _in_bounds(nx, ny, w, h)
        skip = true
      end
      if not skip
        if is_blocked(nx, ny)
          skip = true
        end
      end
      if not skip
        if came_from[ny * w + nx] != -1
          skip = true
        end
      end
      if not skip
        came_from[ny * w + nx] = d
        qx.push(nx)
        qy.push(ny)
      end
      d += 1
    end
  end
  return false
end

## Allocate a `w*h` came_from array initialized to -1 (unvisited).
def _make_came_from(w: Int, h: Int): Vec<Int>
  var v = vec_new<Int>()
  var n = w * h
  var i = 0
  while i < n
    v.push(-1)
    i += 1
  end
  return v
end

# =============================================================================
# Public API
# =============================================================================

## Single-step BFS. Returns the direction (0=W, 1=E, 2=N, 3=S) the
## source should move next to follow the shortest path toward the
## target. Returns -1 in any "no step" case:
##
## - Source and target are the same cell (already there).
## - Source or target outside the grid.
## - No path connects source to target through unblocked cells.
##
## See `bfs_path` if you want the full reconstructed path instead.
def bfs_step(
  width: Int, height: Int,
  sx: Int, sy: Int, tx: Int, ty: Int,
  is_blocked: Fn(Int, Int): Bool
): Int
  if not _in_bounds(sx, sy, width, height)
    return -1
  end
  if not _in_bounds(tx, ty, width, height)
    return -1
  end
  if sx == tx and sy == ty
    return -1
  end

  var came_from = _make_came_from(width, height)
  var found = _bfs_walk(width, height, sx, sy, tx, ty, is_blocked, came_from)
  if not found
    return -1
  end

  # Walk back from target toward source. The recorded direction at the
  # cell whose predecessor IS the source IS the answer.
  var cx = tx
  var cy = ty
  while true
    var d = came_from[cy * width + cx]
    if d == -2
      return -1
    end
    var prev = _unstep(cx, cy, d)
    var px = prev.0
    var py = prev.1
    if px == sx and py == sy
      return d
    end
    cx = px
    cy = py
  end
  return -1
end

## Full-path BFS. Returns the shortest path from (sx, sy) to (tx, ty)
## as a `Vec<(x, y)>`, source-first and target-last. Behaviors:
##
## - Source == target: single-element Vec containing the source. A
##   zero-step path is still a valid path of length one.
## - Source or target OOB, or no path: empty Vec.
##
## Length of the returned Vec equals (number of steps + 1). For an
## empty grid, this is `manhattan_distance + 1`.
def bfs_path(
  width: Int, height: Int,
  sx: Int, sy: Int, tx: Int, ty: Int,
  is_blocked: Fn(Int, Int): Bool
): Vec<(Int, Int)>
  var path = vec_new()
  if not _in_bounds(sx, sy, width, height)
    return path
  end
  if not _in_bounds(tx, ty, width, height)
    return path
  end
  if sx == tx and sy == ty
    path.push((sx, sy))
    return path
  end

  var came_from = _make_came_from(width, height)
  var found = _bfs_walk(width, height, sx, sy, tx, ty, is_blocked, came_from)
  if not found
    return path
  end

  # Trace back target -> source, collecting cells in reverse, then
  # flip into source-first order.
  var rev = vec_new()
  var cx = tx
  var cy = ty
  while true
    rev.push((cx, cy))
    var d = came_from[cy * width + cx]
    if d == -2
      # We've reached the source.
      var i = rev.size - 1
      while i >= 0
        path.push(rev[i])
        i -= 1
      end
      return path
    end
    var prev = _unstep(cx, cy, d)
    cx = prev.0
    cy = prev.1
  end
  return path
end
