_state = vec_new<Int>()

def _init_state(): Void
  if _state.empty?
    _state.push(1)
  end
end

def _esc(): String
  return str_concat(str_from_char(27), "[")
end

def _sgr(code: Int): String
  return str_concat(str_concat(_esc(), code.to_s()), "m")
end

def _reset(): String
  return _sgr(0)
end

def _wrap(s: String, code: Int): String
  _init_state()
  if _state[0] == 0
    return s
  end
  return str_concat(str_concat(_sgr(code), s), _reset())
end

def colors_enabled(): Bool
  _init_state()
  return _state[0] == 1
end

def colors_enable(): Void
  _init_state()
  _state[0] = 1
end

def colors_disable(): Void
  _init_state()
  _state[0] = 0
end

def colors_auto(): Void
  _init_state()
  no_color = getenv("NO_COLOR")
  if not no_color.empty?
    _state[0] = 0
  else
    _state[0] = 1
  end
end

def red(s: String): String
  return _wrap(s, 31)
end

def green(s: String): String
  return _wrap(s, 32)
end

def yellow(s: String): String
  return _wrap(s, 33)
end

def blue(s: String): String
  return _wrap(s, 34)
end

def magenta(s: String): String
  return _wrap(s, 35)
end

def cyan(s: String): String
  return _wrap(s, 36)
end

def white(s: String): String
  return _wrap(s, 37)
end

def black(s: String): String
  return _wrap(s, 30)
end

def bright_red(s: String): String
  return _wrap(s, 91)
end

def bright_green(s: String): String
  return _wrap(s, 92)
end

def bright_yellow(s: String): String
  return _wrap(s, 93)
end

def bright_blue(s: String): String
  return _wrap(s, 94)
end

def bright_magenta(s: String): String
  return _wrap(s, 95)
end

def bright_cyan(s: String): String
  return _wrap(s, 96)
end

def bright_white(s: String): String
  return _wrap(s, 97)
end

def bright_black(s: String): String
  return _wrap(s, 90)
end

def gray(s: String): String
  return bright_black(s)
end

def grey(s: String): String
  return bright_black(s)
end

def on_red(s: String): String
  return _wrap(s, 41)
end

def on_green(s: String): String
  return _wrap(s, 42)
end

def on_yellow(s: String): String
  return _wrap(s, 43)
end

def on_blue(s: String): String
  return _wrap(s, 44)
end

def on_magenta(s: String): String
  return _wrap(s, 45)
end

def on_cyan(s: String): String
  return _wrap(s, 46)
end

def on_white(s: String): String
  return _wrap(s, 47)
end

def on_black(s: String): String
  return _wrap(s, 40)
end

def bold(s: String): String
  return _wrap(s, 1)
end

def dim(s: String): String
  return _wrap(s, 2)
end

def faint(s: String): String
  return dim(s)
end

def italic(s: String): String
  return _wrap(s, 3)
end

def underline(s: String): String
  return _wrap(s, 4)
end

def strikethrough(s: String): String
  return _wrap(s, 9)
end

def strike(s: String): String
  return strikethrough(s)
end

def reverse_video(s: String): String
  return _wrap(s, 7)
end

def inverse(s: String): String
  return reverse_video(s)
end

def fg(s: String, code: Int): String
  return _wrap(s, code)
end

def bg(s: String, code: Int): String
  return _wrap(s, code)
end

def style(s: String, code: Int): String
  return _wrap(s, code)
end

def ansi(code: Int): String
  _init_state()
  if _state[0] == 0
    return ""
  end
  return _sgr(code)
end

def reset(): String
  _init_state()
  if _state[0] == 0
    return ""
  end
  return _reset()
end

def _is_digit(c: Int): Bool
  return c >= '0' and c <= '9'
end

def strip_ansi(s: String): String
  var result = ""
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == 27
      i = i + 1
      if i < len and str_byte_at(s, i) == '['
        i = i + 1
        while i < len
          var cc = str_byte_at(s, i)
          if cc == 'm'
            i = i + 1
            break
          end
          i = i + 1
        end
      end
    else
      result = str_concat(result, str_from_char(c))
      i = i + 1
    end
  end
  return result
end

def visible_len(s: String): Int
  return str_byte_len(strip_ansi(s))
end

def pad_right(s: String, width: Int): String
  var vlen = visible_len(s)
  if vlen >= width
    return s
  end
  var padding = ""
  var i = 0
  while i < width - vlen
    padding = str_concat(padding, " ")
    i = i + 1
  end
  return str_concat(s, padding)
end

def pad_left(s: String, width: Int): String
  var vlen = visible_len(s)
  if vlen >= width
    return s
  end
  var padding = ""
  var i = 0
  while i < width - vlen
    padding = str_concat(padding, " ")
    i = i + 1
  end
  return str_concat(padding, s)
end

def pad_center(s: String, width: Int): String
  var vlen = visible_len(s)
  if vlen >= width
    return s
  end
  var total_pad = width - vlen
  var left_pad = total_pad / 2
  var right_pad = total_pad - left_pad
  var left = ""
  var i = 0
  while i < left_pad
    left = str_concat(left, " ")
    i = i + 1
  end
  var right = ""
  i = 0
  while i < right_pad
    right = str_concat(right, " ")
    i = i + 1
  end
  return str_concat(str_concat(left, s), right)
end

# =============================================================================
# Cursor Control
# =============================================================================

def cursor_up(n: Int): String
  return str_concat(str_concat(_esc(), n.to_s()), "A")
end

def cursor_down(n: Int): String
  return str_concat(str_concat(_esc(), n.to_s()), "B")
end

def cursor_forward(n: Int): String
  return str_concat(str_concat(_esc(), n.to_s()), "C")
end

def cursor_back(n: Int): String
  return str_concat(str_concat(_esc(), n.to_s()), "D")
end

def clear_line(): String
  return str_concat(_esc(), "2K")
end

def clear_to_eol(): String
  return str_concat(_esc(), "0K")
end

def save_cursor(): String
  return str_concat(_esc(), "s")
end

def restore_cursor(): String
  return str_concat(_esc(), "u")
end

def hide_cursor(): String
  return str_concat(_esc(), "?25l")
end

def show_cursor(): String
  return str_concat(_esc(), "?25h")
end

def move_to_column(n: Int): String
  return str_concat(str_concat(_esc(), n.to_s()), "G")
end

def carriage_return(): String
  return str_from_char('\r')
end

# =============================================================================
# 256-Color Support
# =============================================================================

def fg256(s: String, code: Int): String
  _init_state()
  if _state[0] == 0
    return s
  end
  var prefix = str_concat(str_concat(str_concat(_esc(), "38;5;"), code.to_s()), "m")
  return str_concat(str_concat(prefix, s), _reset())
end

def bg256(s: String, code: Int): String
  _init_state()
  if _state[0] == 0
    return s
  end
  var prefix = str_concat(str_concat(str_concat(_esc(), "48;5;"), code.to_s()), "m")
  return str_concat(str_concat(prefix, s), _reset())
end

# =============================================================================
# True Color (24-bit RGB)
# =============================================================================

def rgb(s: String, r: Int, g: Int, b: Int): String
  _init_state()
  if _state[0] == 0
    return s
  end
  var sb = sb_new()
  sb.append(_esc())
  sb.append("38;2;")
  sb.append(r.to_s())
  sb.append(";")
  sb.append(g.to_s())
  sb.append(";")
  sb.append(b.to_s())
  sb.append("m")
  sb.append(s)
  sb.append(_reset())
  return sb.to_string()
end

def bg_rgb(s: String, r: Int, g: Int, b: Int): String
  _init_state()
  if _state[0] == 0
    return s
  end
  var sb = sb_new()
  sb.append(_esc())
  sb.append("48;2;")
  sb.append(r.to_s())
  sb.append(";")
  sb.append(g.to_s())
  sb.append(";")
  sb.append(b.to_s())
  sb.append("m")
  sb.append(s)
  sb.append(_reset())
  return sb.to_string()
end

# =============================================================================
# Horizontal Rule
# =============================================================================

def horizontal_rule(width: Int): String
  var sb = sb_new()
  var i = 0
  while i < width
    sb.append("━")
    i += 1
  end
  return sb.to_string()
end
