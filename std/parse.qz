## std/parse — minimal arithmetic expression parser + ParseError pilot.
##
## Operation Piezoelectric Effects, Phase 2, Milestone J.
##
## Proves the effect machinery on a realistic structured-error use case.
## The parser handles integer arithmetic with `+`, `-`, `*`, `/`, and
## parentheses, with standard precedence. Whitespace is ignored. Error
## reporting threads through the `ParseError` effect carrying three
## positional args: line, col, msg.
##
## Usage:
##   import std/parse
##   import std/effects
##
##   def capture(op_name: Int, argc: Int, argv: Int): Int
##     var line = effects::effect_arg_int(argv, 0)
##     var col  = effects::effect_arg_int(argv, 1)
##     var msg  = effects::effect_arg_string(argv, 2)
##     puts("parse error at #{line}:#{col}: #{msg}")
##     return 0  # (unreachable — handler unwinds)
##   end
##
##   def main(): Int
##     var result = with ParseError { parse_error: capture } do ->
##       parse_expr("1 + 2 * 3")
##     end
##     puts(str_from_int(result))
##     return 0
##   end
##
## `parse_error` is a kind=2 (operation-kind) effect op: the handler's
## return value becomes the with-block's value, and parse-site execution
## after `parse_error(...)` never runs (the with-block's setjmp catches
## the longjmp the runtime emits when kind=2 + a non-null buf is on the
## stack). See docs/research/EFFECTS_IMPLEMENTATION_PLAN.md for the
## full operation-kind semantics.

effect ParseError
  def parse_error(line: Int, col: Int, msg: String): Int = resume(0)
end

## Parser state — a mutable cursor over the source string. Threaded
## through every parse function. Line/col are 1-based; advance updates
## them as the cursor crosses newlines.
struct ParseState
  src: String
  pos: Int
  line: Int
  col: Int
end

def ps_new(src: String): ParseState
  return ParseState { src: src, pos: 0, line: 1, col: 1 }
end

def ps_at_end(p: ParseState): Bool = p.pos >= str_byte_len(p.src)

## Byte at current cursor, or -1 at end of input.
def ps_peek(p: ParseState): Int
  if ps_at_end(p)
    return -1
  end
  return str_byte_at(p.src, p.pos)
end

def ps_advance(p: ParseState): Void
  if ps_at_end(p)
    return
  end
  var b = str_byte_at(p.src, p.pos)
  p.pos = p.pos + 1
  if b == 10
    p.line = p.line + 1
    p.col = 1
  else
    p.col = p.col + 1
  end
end

def ps_skip_ws(p: ParseState): Void
  while not ps_at_end(p)
    var b = ps_peek(p)
    if b == 32 or b == 9 or b == 10 or b == 13
      ps_advance(p)
    else
      return
    end
  end
end

def ps_is_digit(b: Int): Bool = b >= '0' and b <= '9'

## Parse a non-empty digit run. Emits `parse_error` if the current
## position isn't a digit.
def parse_int(p: ParseState): Int can ParseError
  ps_skip_ws(p)
  if not ps_is_digit(ps_peek(p))
    parse_error(p.line, p.col, "expected integer")
    return 0
  end
  var n = 0
  while ps_is_digit(ps_peek(p))
    n = n * 10 + (ps_peek(p) - '0')
    ps_advance(p)
  end
  return n
end

## `primary = int | '(' add ')'`
def parse_primary(p: ParseState): Int can ParseError
  ps_skip_ws(p)
  if ps_peek(p) == '('
    ps_advance(p)
    var v = parse_add(p)
    ps_skip_ws(p)
    if ps_peek(p) != ')'
      parse_error(p.line, p.col, "expected ')'")
      return 0
    end
    ps_advance(p)
    return v
  end
  return parse_int(p)
end

## `mul = primary (('*' | '/') primary)*` — higher precedence than add.
def parse_mul(p: ParseState): Int can ParseError
  var lhs = parse_primary(p)
  ps_skip_ws(p)
  while ps_peek(p) == '*' or ps_peek(p) == '/'
    var op = ps_peek(p)
    ps_advance(p)
    var rhs = parse_primary(p)
    if op == '*'
      lhs = lhs * rhs
    else
      if rhs == 0
        parse_error(p.line, p.col, "division by zero")
        return 0
      end
      lhs = lhs / rhs
    end
    ps_skip_ws(p)
  end
  return lhs
end

## `add = mul (('+' | '-') mul)*` — lowest precedence.
def parse_add(p: ParseState): Int can ParseError
  var lhs = parse_mul(p)
  ps_skip_ws(p)
  while ps_peek(p) == '+' or ps_peek(p) == '-'
    var op = ps_peek(p)
    ps_advance(p)
    var rhs = parse_mul(p)
    if op == '+'
      lhs = lhs + rhs
    else
      lhs = lhs - rhs
    end
    ps_skip_ws(p)
  end
  return lhs
end

## Parse entry point: evaluates `src` as an arithmetic expression.
## Emits `parse_error` on any lex/parse/eval failure; kind=2 semantics
## mean callers that wrap in `with ParseError { parse_error: h } do ...`
## receive the handler's return value as the with-block's value.
def parse_expr(src: String): Int can ParseError
  var p = ps_new(src)
  var v = parse_add(p)
  ps_skip_ws(p)
  if not ps_at_end(p)
    parse_error(p.line, p.col, "unexpected trailing input")
    return 0
  end
  return v
end
