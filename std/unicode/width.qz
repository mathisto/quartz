## Unicode Visible Width (wcwidth-style)
##
## `unicode_width(cp)` returns the number of terminal cells a codepoint
## occupies when rendered: 0 for combining marks and zero-width
## controls, 2 for East Asian Wide / Fullwidth and Emoji_Presentation,
## 1 for everything else.
##
## East Asian Ambiguous codepoints (Greek, Cyrillic, box-drawing, …)
## render as 1 cell in non-CJK terminals and 2 cells in CJK terminals.
## The default is 1; call `uc_set_east_asian_ambiguous_width(2)` once
## at startup if the host is a CJK locale.
##
## This module is split out from `std/unicode` so width-only consumers
## (e.g. `std/tui/layout`) don't pay parse + typecheck cost for the
## case-folding and grapheme-break tables — `import std/unicode/width`
## is leaner than `import std/unicode` when only width is needed.
##
## Width is reported per-codepoint. Grapheme clusters that span
## multiple codepoints (Emoji ZWJ sequences, regional-indicator pairs,
## ◌ + combining marks) sum to the visually-rendered width because the
## non-base codepoints contribute 0. Tightening that to true
## grapheme-cluster width is a follow-up if real misalignment surfaces.

import * from unicode/tables
import * from unicode/width_data

## Module-level slot for the ambiguous-width setting. Default 1.
var _eaw_ambiguous_width = 1

## Override the cell width assigned to East Asian Ambiguous codepoints.
## Pass 1 for non-CJK terminals (default), 2 for CJK terminals.
def uc_set_east_asian_ambiguous_width(w: Int): Void
  _eaw_ambiguous_width = w
end

## Read the current ambiguous-width setting.
def uc_east_asian_ambiguous_width(): Int = _eaw_ambiguous_width

## Visible cell width of `cp`. Result is 0, 1, or 2 (or whatever was
## passed to `uc_set_east_asian_ambiguous_width` for ambiguous chars).
def unicode_width(cp: Int): Int
  ## Control characters render as 0 cells (terminal swallows them).
  ## C0 (0x00..0x1F) and DEL (0x7F); C1 (0x80..0x9F) handled by the
  ## zero-width table below since UCD lists them as Cc.
  if cp < 0x20
    return 0
  end
  if cp == 0x7F
    return 0
  end
  if unicode_range_contains(uc_width_zero_ranges(), cp)
    return 0
  end
  if unicode_range_contains(uc_width_wide_ranges(), cp)
    return 2
  end
  if unicode_range_contains(uc_width_ambiguous_ranges(), cp)
    return _eaw_ambiguous_width
  end
  return 1
end
