## Unicode Normalization — NFD and NFC
##
## Implements Unicode canonical decomposition (NFD) and canonical
## composition (NFC) per UAX #15.
##
## Hangul syllable decomposition/composition is algorithmic.

import * from unicode/normalize_data
import * from unicode/tables

## ---------------------------------------------------------------------------
## Hangul constants (algorithmic, no table needed)
## ---------------------------------------------------------------------------

def HANGUL_SBASE(): Int = 0xAC00
def HANGUL_LBASE(): Int = 0x1100
def HANGUL_VBASE(): Int = 0x1161
def HANGUL_TBASE(): Int = 0x11A7
def HANGUL_LCOUNT(): Int = 19
def HANGUL_VCOUNT(): Int = 21
def HANGUL_TCOUNT(): Int = 28
def HANGUL_NCOUNT(): Int = 588
def HANGUL_SCOUNT(): Int = 11172

## ---------------------------------------------------------------------------
## CCC lookup
## ---------------------------------------------------------------------------

## Get the Canonical Combining Class of a codepoint.
## Returns 0 for starters, > 0 for combining marks.
def unicode_ccc(cp: Int): Int
  var ranges = nd_ccc_ranges()
  var values = nd_ccc_values()
  var lo = 0
  var hi = ranges.size - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var entry = ranges[mid]
    var start = entry >> 21
    var stop = entry & 0x1FFFFF
    if cp < start
      hi = mid - 1
    else
      if cp > stop
        lo = mid + 1
      else
        return values[mid]
      end
    end
  end
  return 0
end

## ---------------------------------------------------------------------------
## Decomposition
## ---------------------------------------------------------------------------

## Decompose a single codepoint. Appends decomposed codepoints to result vec.
## Recursively decomposes until fully decomposed (NFD).
def _decompose_cp(cp: Int, result: Vec<Int>): Void
  ## Hangul syllable decomposition (algorithmic)
  var sindex = cp - HANGUL_SBASE()
  if sindex >= 0 and sindex < HANGUL_SCOUNT()
    var l = HANGUL_LBASE() + sindex / HANGUL_NCOUNT()
    var v = HANGUL_VBASE() + (sindex % HANGUL_NCOUNT()) / HANGUL_TCOUNT()
    var t = HANGUL_TBASE() + sindex % HANGUL_TCOUNT()
    result.push(l)
    result.push(v)
    if t != HANGUL_TBASE()
      result.push(t)
    end
    return
  end

  ## Look up in 2-codepoint decomposition table
  var keys = nd_decomp_keys()
  var vals = nd_decomp_vals()
  var lo = 0
  var hi = keys.size - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var key = keys[mid]
    if cp < key
      hi = mid - 1
    else
      if cp > key
        lo = mid + 1
      else
        ## Found: decompose each component recursively
        var packed = vals[mid]
        var cp1 = packed >> 21
        var cp2 = packed & 0x1FFFFF
        _decompose_cp(cp1, result)
        _decompose_cp(cp2, result)
        return
      end
    end
  end

  ## Check long decomposition table
  var long_table = nd_decomp_long()
  var long_len = long_table.size
  var i = 0
  while i < long_len
    var src = long_table[i]
    var n = long_table[i + 1]
    if src == cp
      var j = 0
      while j < n
        _decompose_cp(long_table[i + 2 + j], result)
        j = j + 1
      end
      return
    end
    i = i + 2 + n
  end

  ## No decomposition: codepoint is already in canonical form
  result.push(cp)
end

## Sort combining marks by CCC (stable sort using insertion sort).
## Only sorts within each "block" between starters (CCC=0).
def _sort_by_ccc(cps: Vec<Int>): Void
  var n = cps.size
  if n < 2
    return
  end
  ## Find blocks between starters and sort each block
  var block_start = 0
  while block_start < n
    ## Skip starter
    if unicode_ccc(cps[block_start]) == 0
      block_start = block_start + 1
      ## Find end of combining mark run
      var block_end = block_start
      while block_end < n and unicode_ccc(cps[block_end]) != 0
        block_end = block_end + 1
      end
      ## Insertion sort the combining marks [block_start, block_end)
      var i = block_start + 1
      while i < block_end
        var j = i
        while j > block_start and unicode_ccc(cps[j - 1]) > unicode_ccc(cps[j])
          var tmp = cps[j]
          cps[j] = cps[j - 1]
          cps[j - 1] = tmp
          j = j - 1
        end
        i = i + 1
      end
      block_start = block_end
    else
      block_start = block_start + 1
    end
  end
end

## ---------------------------------------------------------------------------
## NFD — Canonical Decomposition
## ---------------------------------------------------------------------------

## Decompose a string to NFD (Canonical Decomposition).
def unicode_nfd(s: String): String
  var cps: Vec<Int> = vec_new()
  var pos = 0
  var byte_len = str_byte_len(s)

  ## Decode and decompose each codepoint
  while pos < byte_len
    var b0 = str_byte_at(s, pos)
    var cp = 0
    if b0 < 128
      cp = b0
      pos = pos + 1
    else
      if b0 < 224
        cp = ((b0 & 0x1F) << 6) | (str_byte_at(s, pos + 1) & 0x3F)
        pos = pos + 2
      else
        if b0 < 240
          cp = ((b0 & 0x0F) << 12) | ((str_byte_at(s, pos + 1) & 0x3F) << 6) | (str_byte_at(s, pos + 2) & 0x3F)
          pos = pos + 3
        else
          cp = ((b0 & 0x07) << 18) | ((str_byte_at(s, pos + 1) & 0x3F) << 12) | ((str_byte_at(s, pos + 2) & 0x3F) << 6) | (str_byte_at(s, pos + 3) & 0x3F)
          pos = pos + 4
        end
      end
    end
    _decompose_cp(cp, cps)
  end

  ## Sort combining marks by CCC
  _sort_by_ccc(cps)

  ## Encode back to UTF-8
  var sb = sb_new()
  var i = 0
  while i < cps.size
    sb_append(sb, str_from_codepoint(cps[i]))
    i = i + 1
  end
  return sb_to_string(sb)
end

## ---------------------------------------------------------------------------
## NFC — Canonical Composition (NFD + recompose)
## ---------------------------------------------------------------------------

## Look up canonical composition for a pair of codepoints.
## Returns the composed codepoint, or -1 if no composition exists.
def _compose_pair(a: Int, b: Int): Int
  ## Hangul LV composition
  var lindex = a - HANGUL_LBASE()
  if lindex >= 0 and lindex < HANGUL_LCOUNT()
    var vindex = b - HANGUL_VBASE()
    if vindex >= 0 and vindex < HANGUL_VCOUNT()
      return HANGUL_SBASE() + (lindex * HANGUL_VCOUNT() + vindex) * HANGUL_TCOUNT()
    end
  end

  ## Hangul LVT composition (LV + T)
  var sindex = a - HANGUL_SBASE()
  if sindex >= 0 and sindex < HANGUL_SCOUNT() and (sindex % HANGUL_TCOUNT()) == 0
    var tindex = b - HANGUL_TBASE()
    if tindex > 0 and tindex < HANGUL_TCOUNT()
      return a + tindex
    end
  end

  ## Table lookup
  var key = (a << 21) | b
  var keys = nd_comp_keys()
  var vals = nd_comp_vals()
  var lo = 0
  var hi = keys.size - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var k = keys[mid]
    if key < k
      hi = mid - 1
    else
      if key > k
        lo = mid + 1
      else
        return vals[mid]
      end
    end
  end
  return -1
end

## Compose a string to NFC (Canonical Composition).
## First decomposes to NFD, then recomposes canonical pairs.
def unicode_nfc(s: String): String
  ## Step 1: Decompose to NFD
  var nfd = unicode_nfd(s)

  ## Step 2: Collect codepoints
  var cps: Vec<Int> = vec_new()
  var pos = 0
  var byte_len = str_byte_len(nfd)
  while pos < byte_len
    var b0 = str_byte_at(nfd, pos)
    var cp = 0
    if b0 < 128
      cp = b0
      pos = pos + 1
    else
      if b0 < 224
        cp = ((b0 & 0x1F) << 6) | (str_byte_at(nfd, pos + 1) & 0x3F)
        pos = pos + 2
      else
        if b0 < 240
          cp = ((b0 & 0x0F) << 12) | ((str_byte_at(nfd, pos + 1) & 0x3F) << 6) | (str_byte_at(nfd, pos + 2) & 0x3F)
          pos = pos + 3
        else
          cp = ((b0 & 0x07) << 18) | ((str_byte_at(nfd, pos + 1) & 0x3F) << 12) | ((str_byte_at(nfd, pos + 2) & 0x3F) << 6) | (str_byte_at(nfd, pos + 3) & 0x3F)
          pos = pos + 4
        end
      end
    end
    cps.push(cp)
  end

  ## Step 3: Canonical composition algorithm
  var n = cps.size
  if n == 0
    return ""
  end

  var result: Vec<Int> = vec_new()
  result.push(cps[0])
  var last_starter_idx = 0

  var i = 1
  while i < n
    var cp = cps[i]
    var last_starter = result[last_starter_idx]
    var cp_ccc = unicode_ccc(cp)

    ## Check if composition is blocked:
    ## A combining mark blocks composition if there's an intervening
    ## mark with CCC >= this mark's CCC (and CCC > 0).
    var blocked = false
    if cp_ccc > 0
      var k = result.size - 1
      while k > last_starter_idx
        var intervening_ccc = unicode_ccc(result[k])
        if intervening_ccc >= cp_ccc
          blocked = true
        end
        k = k - 1
      end
    end

    if not blocked
      var composed = _compose_pair(last_starter, cp)
      if composed >= 0
        result[last_starter_idx] = composed
        i = i + 1
        continue
      end
    end

    result.push(cp)
    if cp_ccc == 0
      last_starter_idx = result.size - 1
    end
    i = i + 1
  end

  ## Encode back to UTF-8
  var sb = sb_new()
  var j = 0
  while j < result.size
    sb_append(sb, str_from_codepoint(result[j]))
    j = j + 1
  end
  return sb_to_string(sb)
end

## Compare two strings for canonical equivalence.
def unicode_eq_canonical(a: String, b: String): Bool
  return unicode_nfc(a) == unicode_nfc(b)
end
