## Unicode Grapheme Cluster Segmentation (UAX #29)
##
## Implements Extended Grapheme Cluster boundaries per Unicode Standard
## Annex #29. A grapheme cluster is what humans perceive as a "character":
##   - "e" + combining acute = 1 grapheme
##   - flag emoji (2 regional indicators) = 1 grapheme
##   - ZWJ emoji sequences = 1 grapheme

import traits
import * from unicode/tables
import * from unicode/grapheme_data

## ---------------------------------------------------------------------------
## Grapheme Break Category Lookup
## ---------------------------------------------------------------------------

## Get the Grapheme Break category for a codepoint.
def _gb_category(cp: Int): Int
  if cp == 0x000D
    return GB_CR()
  end
  if cp == 0x000A
    return GB_LF()
  end
  if cp == 0x200D
    return GB_ZWJ()
  end
  if unicode_range_contains(uc_gb_regional_indicator(), cp)
    return GB_REGIONAL_INDICATOR()
  end
  if unicode_range_contains(uc_gb_prepend(), cp)
    return GB_PREPEND()
  end
  if unicode_range_contains(uc_gb_hangul_l(), cp)
    return GB_HANGUL_L()
  end
  if unicode_range_contains(uc_gb_hangul_v(), cp)
    return GB_HANGUL_V()
  end
  if unicode_range_contains(uc_gb_hangul_t(), cp)
    return GB_HANGUL_T()
  end
  if unicode_range_contains(uc_gb_hangul_lv(), cp)
    return GB_HANGUL_LV()
  end
  if unicode_range_contains(uc_gb_hangul_lvt(), cp)
    return GB_HANGUL_LVT()
  end
  if unicode_range_contains(uc_gb_extend(), cp)
    return GB_EXTEND()
  end
  if unicode_range_contains(uc_gb_spacing_mark(), cp)
    return GB_SPACING_MARK()
  end
  if unicode_range_contains(uc_gb_control(), cp)
    return GB_CONTROL()
  end
  if unicode_range_contains(uc_gb_extended_pictographic(), cp)
    return GB_EXTENDED_PICTOGRAPHIC()
  end
  return GB_OTHER()
end

## ---------------------------------------------------------------------------
## UAX #29 Break Rules
## ---------------------------------------------------------------------------

def _should_break(prev_cat: Int, curr_cat: Int, ri_count: Int, in_emoji_seq: Int): Bool
  ## GB3: Do not break between CR and LF
  if prev_cat == GB_CR() and curr_cat == GB_LF()
    return false
  end
  ## GB4: Break after Control, CR, LF
  if prev_cat == GB_CONTROL() or prev_cat == GB_CR() or prev_cat == GB_LF()
    return true
  end
  ## GB5: Break before Control, CR, LF
  if curr_cat == GB_CONTROL() or curr_cat == GB_CR() or curr_cat == GB_LF()
    return true
  end
  ## GB6: Do not break Hangul L before L, V, LV, LVT
  if prev_cat == GB_HANGUL_L()
    if curr_cat == GB_HANGUL_L() or curr_cat == GB_HANGUL_V() or curr_cat == GB_HANGUL_LV() or curr_cat == GB_HANGUL_LVT()
      return false
    end
  end
  ## GB7: Do not break Hangul LV or V before V or T
  if prev_cat == GB_HANGUL_LV() or prev_cat == GB_HANGUL_V()
    if curr_cat == GB_HANGUL_V() or curr_cat == GB_HANGUL_T()
      return false
    end
  end
  ## GB8: Do not break Hangul LVT or T before T
  if prev_cat == GB_HANGUL_LVT() or prev_cat == GB_HANGUL_T()
    if curr_cat == GB_HANGUL_T()
      return false
    end
  end
  ## GB9: Do not break before Extend or ZWJ
  if curr_cat == GB_EXTEND() or curr_cat == GB_ZWJ()
    return false
  end
  ## GB9a: Do not break before SpacingMark
  if curr_cat == GB_SPACING_MARK()
    return false
  end
  ## GB9b: Do not break after Prepend
  if prev_cat == GB_PREPEND()
    return false
  end
  ## GB11: Do not break within emoji ZWJ sequences
  if in_emoji_seq == 1 and prev_cat == GB_ZWJ() and curr_cat == GB_EXTENDED_PICTOGRAPHIC()
    return false
  end
  ## GB12/13: Do not break within Regional Indicator pairs
  if prev_cat == GB_REGIONAL_INDICATOR() and curr_cat == GB_REGIONAL_INDICATOR()
    if ri_count % 2 == 1
      return false
    end
  end
  ## GB999: Otherwise, break everywhere
  return true
end

## ---------------------------------------------------------------------------
## Inline UTF-8 decode helper (returns codepoint, updates pos via side channel)
## ---------------------------------------------------------------------------

## Shared mutable state for decode results (avoids struct field access issue)
var _gi_decode_pos = 0

## Decode a UTF-8 codepoint at the given byte position in string s.
## Sets _gi_decode_pos to the byte position AFTER the decoded codepoint.
## Decode a UTF-8 codepoint at position, update _gi_decode_pos to next byte.
def _gi_decode(s: String, pos: Int): Int
  var b0 = str_byte_at(s, pos)
  if b0 < 128
    _gi_decode_pos = pos + 1
    return b0
  end
  if b0 < 224
    var cp = ((b0 & 0x1F) << 6) | (str_byte_at(s, pos + 1) & 0x3F)
    _gi_decode_pos = pos + 2
    return cp
  end
  if b0 < 240
    var cp = ((b0 & 0x0F) << 12) | ((str_byte_at(s, pos + 1) & 0x3F) << 6) | (str_byte_at(s, pos + 2) & 0x3F)
    _gi_decode_pos = pos + 3
    return cp
  end
  var cp = ((b0 & 0x07) << 18) | ((str_byte_at(s, pos + 1) & 0x3F) << 12) | ((str_byte_at(s, pos + 2) & 0x3F) << 6) | (str_byte_at(s, pos + 3) & 0x3F)
  _gi_decode_pos = pos + 4
  return cp
end

## ---------------------------------------------------------------------------
## GraphemeIter — iterates over grapheme cluster substrings
## ---------------------------------------------------------------------------

struct GraphemeIter
  s: String
  pos: Int
  len: Int
end

extend GraphemeIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.pos >= self.len
      return Option::None
    end

    var start = self.pos

    ## Read first codepoint
    var first_cp = _gi_decode(self.s, self.pos)
    self.pos = _gi_decode_pos
    var prev_cat = _gb_category(first_cp)

    ## Track state for RI counting and emoji ZWJ sequences
    var ri_count = 0
    if prev_cat == GB_REGIONAL_INDICATOR()
      ri_count = 1
    end
    var in_emoji_seq = 0
    if prev_cat == GB_EXTENDED_PICTOGRAPHIC()
      in_emoji_seq = 1
    end

    ## Scan forward until we find a break
    while self.pos < self.len
      var save_pos = self.pos
      var cp = _gi_decode(self.s, self.pos)
      var new_pos = _gi_decode_pos
      var curr_cat = _gb_category(cp)

      if _should_break(prev_cat, curr_cat, ri_count, in_emoji_seq)
        ## Break here: don't advance past this codepoint
        return Option::Some(as_int(str_byte_slice(self.s, start, save_pos)))
      end

      self.pos = new_pos

      ## Update state
      if curr_cat == GB_REGIONAL_INDICATOR()
        ri_count = ri_count + 1
      else
        ri_count = 0
      end

      if curr_cat == GB_EXTENDED_PICTOGRAPHIC()
        in_emoji_seq = 1
      else
        if curr_cat != GB_EXTEND() and curr_cat != GB_ZWJ()
          in_emoji_seq = 0
        end
      end

      prev_cat = curr_cat
    end

    ## End of string: return remaining bytes as last grapheme
    return Option::Some(as_int(str_byte_slice(self.s, start, self.len)))
  end
end

## Create a grapheme cluster iterator for a string.
def str_graphemes(s: String): GraphemeIter
  return GraphemeIter { s: s, pos: 0, len: str_byte_len(s) }
end

## Count the number of grapheme clusters in a string.
def str_grapheme_count(s: String): Int
  var count = 0
  for g in str_graphemes(s)
    count = count + 1
  end
  return count
end
