## Unicode Table Lookup Infrastructure
##
## Provides O(log n) binary search over sorted codepoint range tables
## and mapping tables for Unicode property lookups.

## Check if a codepoint falls within any range in a sorted table.
## Each element is packed as (start << 21) | end.
## Ranges are inclusive: [start, end].
def unicode_range_contains(table: Vec<Int>, cp: Int): Bool
  var lo = 0
  var hi = vec_size(table) - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var entry = vec_get(table, mid)
    var start = entry >> 21
    var stop = entry & 0x1FFFFF
    if cp < start
      hi = mid - 1
    else
      if cp > stop
        lo = mid + 1
      else
        return true
      end
    end
  end
  return false
end

## Look up a mapping in parallel sorted arrays.
## keys and values must be the same length and sorted by key.
## Returns the mapped value if found, otherwise returns cp unchanged.
def unicode_mapping_lookup(keys: Vec<Int>, values: Vec<Int>, cp: Int): Int
  var lo = 0
  var hi = vec_size(keys) - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var key = vec_get(keys, mid)
    if cp < key
      hi = mid - 1
    else
      if cp > key
        lo = mid + 1
      else
        return vec_get(values, mid)
      end
    end
  end
  return cp
end
