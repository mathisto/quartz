## String formatting functions
##
## Usage:
##   format1("Hello, {}!", "world")         # => "Hello, world!"
##   format2("{} + {} = 3", "1", "2")       # => "1 + 2 = 3"
##   format3("{}, {}, {}", "a", "b", "c")   # => "a, b, c"
##
## All arguments must be strings. Use .to_s() to convert.

def format1(template: String, a: String): String
  var sb = sb_new()
  var len = str_byte_len(template)
  var i = 0
  var used = 0
  while i < len
    var c = template.byte_at(i)
    if c == '{' and i + 1 < len and template.byte_at(i + 1) == '}'
      if used == 0
        sb.append(a)
        used = 1
      end
      i += 2
    else
      sb.append_char(c)
      i += 1
    end
  end
  return sb.to_string()
end

def format2(template: String, a: String, b: String): String
  var sb = sb_new()
  var len = str_byte_len(template)
  var i = 0
  var arg_idx = 0
  while i < len
    var c = template.byte_at(i)
    if c == '{' and i + 1 < len and template.byte_at(i + 1) == '}'
      if arg_idx == 0
        sb.append(a)
      elsif arg_idx == 1
        sb.append(b)
      end
      arg_idx += 1
      i += 2
    else
      sb.append_char(c)
      i += 1
    end
  end
  return sb.to_string()
end

def format3(template: String, a: String, b: String, c: String): String
  var sb = sb_new()
  var len = str_byte_len(template)
  var i = 0
  var arg_idx = 0
  while i < len
    var ch = template.byte_at(i)
    if ch == '{' and i + 1 < len and template.byte_at(i + 1) == '}'
      if arg_idx == 0
        sb.append(a)
      elsif arg_idx == 1
        sb.append(b)
      elsif arg_idx == 2
        sb.append(c)
      end
      arg_idx += 1
      i += 2
    else
      sb.append_char(ch)
      i += 1
    end
  end
  return sb.to_string()
end
