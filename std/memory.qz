## std/memory - Memory allocation primitives
##
## Provides the Allocator trait and wrapper types for Arena and Pool allocators.
##
## Usage:
##   import std/memory
##
##   def main(): Int
##     a = arena_create()
##     ptr = alloc(a, 64)
##     free(a, ptr)
##     arena_wrapper_destroy(a)
##     return 0
##   end

## Drop trait - called when value goes out of scope
trait Drop
  def drop(self): Void
  end
end

## Allocator trait - unified interface for memory allocation strategies
trait Allocator
  ## Allocate `size` bytes and return a pointer (Int)
  def allocate(self, size: Int): Int
    return 0
  end

  ## Deallocate memory at `ptr` (may be no-op for some allocators)
  def deallocate(self, ptr: Int): Void
  end
end

## Arena type alias - for raw arena handles from arena intrinsics
## Backward compatibility: allows `a: Arena` with arena_new() result
type ArenaHandle = Int

## Arena struct - first-class arena allocator with automatic cleanup
## Implements Drop for RAII-style resource management
struct Arena
  handle: Int
end

extend Arena with Drop
  def drop(self): Void
    arena_destroy(self.handle)
  end
end

extend Arena with Allocator
  def allocate(self, size: Int): Int
    return arena_alloc(self.handle, size)
  end

  def deallocate(self, ptr: Int): Void
    # No-op: arena memory freed all at once via drop/destroy
  end
end

## Create a new Arena allocator with automatic cleanup via Drop
def arena_create(): Arena
  return Arena { handle: arena_new() }
end

## Reset the arena (reuse memory without freeing)
def arena_wrapper_reset(a: Arena): Void
  arena_reset(a.handle)
end

## Get bytes currently allocated
def arena_wrapper_bytes_used(a: Arena): Int
  return arena_bytes_used(a.handle)
end

## Get total capacity
def arena_wrapper_capacity(a: Arena): Int
  return arena_capacity(a.handle)
end

## PoolWrapper - fixed-size block allocator wrapper
## Fast allocation/deallocation of fixed-size blocks.
## Good for objects of uniform size.
struct PoolWrapper
  pool_handle: Int
end

extend PoolWrapper with Allocator
  def allocate(self, size: Int): Int
    # Note: size is ignored, Pool uses fixed block size
    return pool_alloc(self.pool_handle)
  end

  def deallocate(self, ptr: Int): Void
    pool_free(self.pool_handle, ptr)
  end
end

## Create a new Pool allocator
## block_size: size of each block in bytes
## block_count: number of blocks to pre-allocate
def pool_create(block_size: Int, block_count: Int): PoolWrapper
  return PoolWrapper { pool_handle: pool_new(block_size, block_count) }
end

## Destroy the pool and free all memory
def pool_wrapper_destroy(p: PoolWrapper): Void
  pool_destroy(p.pool_handle)
end

## Get total block capacity
def pool_wrapper_capacity(p: PoolWrapper): Int
  return pool_capacity(p.pool_handle)
end

## Get number of free blocks available
def pool_wrapper_free_count(p: PoolWrapper): Int
  return pool_free_count(p.pool_handle)
end

## Generic allocation helper - allocate using any Allocator
## Named allocator_alloc to avoid collision with builtin alloc
def allocator_alloc<A: Allocator>(allocator: A, size: Int): Int
  return allocate(allocator, size)
end

## Generic deallocation helper - deallocate using any Allocator
def allocator_free<A: Allocator>(allocator: A, ptr: Int): Void
  deallocate(allocator, ptr)
end
