# BSpec - Be Testing Framework
# Primary goal: Discover language holes while implementing

import colors  # Same directory import

# =============================================================================
# LANGUAGE HOLE #1: No way to get command-line arguments
# Impact: Cannot implement --simple/--pretty/--full output format flags
# Workaround: None possible - need args_get(index) or similar intrinsic
# =============================================================================

# =============================================================================
# LANGUAGE HOLE #2: No way to store heterogeneous closures
# Impact: describe() and it() take lambdas, but Vec stores Int handles
#         How do we store Fn(Void): Void in a collection?
# Workaround: ???
# =============================================================================

# -----------------------------------------------------------------------------
# Test Result Types
# -----------------------------------------------------------------------------

enum TestStatus
  Passed
  Failed
  Pending
  Skipped
end

struct TestFailure
  expected: String
  actual: String
  message: String
end

struct TestResult
  name: String
  status: TestStatus
  failure: Int  # 0 or pointer to TestFailure - HOLE: no Option<TestFailure>
  duration_ms: Int
end

# -----------------------------------------------------------------------------
# Test Case Storage
# -----------------------------------------------------------------------------

struct TestCase
  name: String
  # LANGUAGE HOLE #3: How to store the test function?
  # We want: test_fn: Fn(Void): Void
  # But can we store lambdas in structs?
  test_fn: Int  # Storing as Int handle - loses all type safety
  is_focused: Int   # HOLE #4: No Bool type, using Int (0/1)
  is_skipped: Int
end

struct TestSuite
  name: String
  tests: Int      # Vec handle
  suites: Int     # Vec of child suites - nested describes
  setup_fn: Int   # Optional setup lambda
  teardown_fn: Int
end

# -----------------------------------------------------------------------------
# Global State
# -----------------------------------------------------------------------------

# LANGUAGE HOLE #5: No top-level var allowed
# Impact: Cannot have mutable global state for test registration
# The spec says "NO top-level var - Only def, struct, enum, import allowed"
# 
# We NEED something like:
#   var g_root_suite: Int = 0
#   var g_current_suite: Int = 0
#
# Workaround: Pass state explicitly everywhere? Extremely awkward for DSL.

# =============================================================================
# Attempting to work around global state limitation
# =============================================================================

# Create a "context" struct that must be threaded through everything
struct BSpecContext
  root_suite: Int
  current_suite: Int
  results: Int  # Vec of TestResult
  output_mode: Int  # 0=simple, 1=pretty, 2=full
  total: Int
  passed: Int
  failed: Int
  pending: Int
  skipped: Int
end

def bspec_new(): Int
  # HOLE #6: alloc returns Int, but we want BSpecContext
  # No way to say "allocate a BSpecContext"
  # Have to manually manage memory layout
  
  ctx = vec_new()  # Abuse vec as "struct" storage
  
  # Store fields as vec elements - EXTREMELY awkward
  vec_push(ctx, 0)  # root_suite
  vec_push(ctx, 0)  # current_suite  
  vec_push(ctx, vec_new())  # results
  vec_push(ctx, 1)  # output_mode = pretty
  vec_push(ctx, 0)  # total
  vec_push(ctx, 0)  # passed
  vec_push(ctx, 0)  # failed
  vec_push(ctx, 0)  # pending
  vec_push(ctx, 0)  # skipped
  
  return ctx
end

# Accessors - HOLE #7: No way to have methods on structs
# Every access requires these verbose helper functions
def bspec_get_root(ctx: Int): Int
  return vec_get(ctx, 0)
end

def bspec_set_root(ctx: Int, suite: Int): Void
  vec_set(ctx, 0, suite)
end

def bspec_get_current(ctx: Int): Int
  return vec_get(ctx, 1)
end

def bspec_set_current(ctx: Int, suite: Int): Void
  vec_set(ctx, 1, suite)
end

def bspec_get_results(ctx: Int): Int
  return vec_get(ctx, 2)
end

def bspec_get_output_mode(ctx: Int): Int
  return vec_get(ctx, 3)
end

def bspec_inc_total(ctx: Int): Void
  var current = vec_get(ctx, 4)
  vec_set(ctx, 4, current + 1)
end

def bspec_inc_passed(ctx: Int): Void
  var current = vec_get(ctx, 5)
  vec_set(ctx, 5, current + 1)
end

def bspec_inc_failed(ctx: Int): Void
  var current = vec_get(ctx, 6)
  vec_set(ctx, 6, current + 1)
end

# -----------------------------------------------------------------------------
# Suite Creation
# -----------------------------------------------------------------------------

def suite_new(name: String): Int
  suite = vec_new()
  vec_push(suite, as_int(name))  # name
  vec_push(suite, vec_new())     # tests
  vec_push(suite, vec_new())     # child suites
  vec_push(suite, 0)             # setup_fn
  vec_push(suite, 0)             # teardown_fn
  return suite
end

def suite_get_name(suite: Int): String
  return as_string(vec_get(suite, 0))
end

def suite_get_tests(suite: Int): Int
  return vec_get(suite, 1)
end

def suite_get_children(suite: Int): Int
  return vec_get(suite, 2)
end

def suite_add_test(suite: Int, test: Int): Void
  tests = suite_get_tests(suite)
  vec_push(tests, test)
end

def suite_add_child(suite: Int, child: Int): Void
  children = suite_get_children(suite)
  vec_push(children, child)
end

# -----------------------------------------------------------------------------
# Test Case Creation
# -----------------------------------------------------------------------------

def test_new(name: String, test_fn: Int): Int
  test = vec_new()
  vec_push(test, as_int(name))  # name
  vec_push(test, test_fn)       # test function (as Int handle)
  vec_push(test, 0)             # is_focused
  vec_push(test, 0)             # is_skipped
  return test
end

def test_get_name(test: Int): String
  return as_string(vec_get(test, 0))
end

def test_get_fn(test: Int): Int
  return vec_get(test, 1)
end

def test_is_focused(test: Int): Int
  return vec_get(test, 2)
end

def test_is_skipped(test: Int): Int
  return vec_get(test, 3)
end

# =============================================================================
# DSL Functions
# =============================================================================

# LANGUAGE HOLE #8: The DSL we WANT to write:
#
#   describe "Parser" do
#     it "parses numbers" do
#       expect(parse("42")).to_eq(42)
#     end
#   end
#
# But Be doesn't have:
#   - Block arguments (do...end passing a block)
#   - Implicit block execution
#   - Method chaining with dot notation on non-structs
#
# What we CAN write:
#
#   describe("Parser", |ctx|
#     it(ctx, "parses numbers", ||
#       expect(parse("42")).to_eq(42)  # HOLE: .to_eq won't work
#     end)
#   end)
#
# But even THIS has problems - need to verify lambda storage works

def describe(ctx: Int, name: String, block: Fn(Int): Void): Void
  suite = suite_new(name)
  
  # Save current suite, set new one as current
  parent = bspec_get_current(ctx)
  bspec_set_current(ctx, suite)
  
  # If no root yet, this is root
  if bspec_get_root(ctx) == 0
    bspec_set_root(ctx, suite)
  else
    # Add as child of parent
    suite_add_child(parent, suite)
  end
  
  # Execute the block to register tests
  # HOLE #9: Can we call a lambda stored as parameter?
  block(ctx)
  
  # Restore parent as current
  bspec_set_current(ctx, parent)
end

def it(ctx: Int, name: String, test_fn: Fn(): Void): Void
  current = bspec_get_current(ctx)
  
  # HOLE #10: Storing Fn(): Void as Int - how?
  # Do we have a way to convert function to Int?
  # test = test_new(name, ???)
  
  # Attempting to store lambda directly...
  test = test_new(name, 0)  # Placeholder - this won't actually store the fn
  
  suite_add_test(current, test)
  bspec_inc_total(ctx)
end

# Pending test (no block)
def it_pending(ctx: Int, name: String): Void
  current = bspec_get_current(ctx)
  test = test_new(name, 0)
  vec_set(test, 3, 1)  # Mark as pending/skipped
  suite_add_test(current, test)
  bspec_inc_total(ctx)
end

# =============================================================================
# Matchers
# =============================================================================

# LANGUAGE HOLE #11: No method chaining / fluent API
# We want: expect(value).to_eq(expected)
# We'd need expect() to return something with a .to_eq method
#
# Option A: Return a struct, call method on it
#   - But Be doesn't have methods on structs
#
# Option B: expect_eq(actual, expected)  
#   - Loses fluent readability
#   - "expect_eq(1 + 1, 2)" vs "expect(1 + 1).to_eq(2)"

struct Expectation
  actual: Int
  actual_str: String  # For error messages
end

def expect(value: Int): Expectation
  return Expectation { actual: value, actual_str: value.to_s() }
end

def expect_str(value: String): Expectation
  return Expectation { actual: as_int(value), actual_str: value }
end

# HOLE #12: Even if we return Expectation, we can't chain .to_eq()
# because Be has no UFCS for structs (or does it?)
#
# Testing if this works: exp.to_eq(5)

def to_eq(exp: Expectation, expected: Int): Int
  if exp.actual == expected
    return 1  # Pass
  else
    return 0  # Fail
  end
end

def to_eq_str(exp: Expectation, expected: String): Int
  # HOLE #13: String comparison
  # Are strings compared by value or by handle?
  actual_s = as_string(exp.actual)
  if actual_s == expected
    return 1
  else
    return 0
  end
end

def to_be_true(exp: Expectation): Int
  if exp.actual != 0
    return 1
  else
    return 0
  end
end

def to_be_false(exp: Expectation): Int
  if exp.actual == 0
    return 1
  else
    return 0
  end
end

# =============================================================================
# Test Runner
# =============================================================================

def run_suite(ctx: Int, suite: Int, indent: Int): Void
  name = suite_get_name(suite)
  
  # Print suite name with indentation
  var i = 0
  while i < indent
    puts("  ", false)
    i = i + 1
  end
  puts(name)
  
  # Run all tests in this suite
  tests = suite_get_tests(suite)
  var t = 0
  while t < tests.size
    test = vec_get(tests, t)
    run_test(ctx, test, indent + 1)
    t = t + 1
  end
  
  # Run child suites
  children = suite_get_children(suite)
  var c = 0
  while c < children.size
    child = vec_get(children, c)
    run_suite(ctx, child, indent + 1)
    c = c + 1
  end
end

def run_test(ctx: Int, test: Int, indent: Int): Void
  name = test_get_name(test)
  
  # Check if skipped/pending
  if test_is_skipped(test) != 0
    print_indent(indent)
    puts(colors.yellow("- " + name))
    bspec_inc_pending(ctx)
    return
  end
  
  # HOLE #14: Actually running the test function
  # We stored test_fn as Int, but how do we CALL it?
  # There's no way to convert Int back to Fn and invoke it!
  #
  # test_fn = test_get_fn(test)
  # test_fn()  # ERROR: test_fn is Int, not callable
  #
  # This is a FUNDAMENTAL blocker.
  
  # For now, just mark as passed (fake)
  print_indent(indent)
  puts(colors.green("✓ " + name))
  bspec_inc_passed(ctx)
end

def print_indent(n: Int): Void
  var i = 0
  while i < n
    puts("  ", false)
    i = i + 1
  end
end

def bspec_inc_pending(ctx: Int): Void
  var current = vec_get(ctx, 7)
  vec_set(ctx, 7, current + 1)
end

# =============================================================================
# Main Entry Point
# =============================================================================

def bspec_run(ctx: Int): Int
  root = bspec_get_root(ctx)
  
  if root == 0
    puts("No tests defined")
    return 1
  end
  
  puts("")
  run_suite(ctx, root, 0)
  puts("")
  
  # Print summary
  total = vec_get(ctx, 4)
  passed = vec_get(ctx, 5)
  failed = vec_get(ctx, 6)
  pending = vec_get(ctx, 7)
  
  var summary = total.to_s() + " tests, "
  summary = summary + passed.to_s()
  summary = summary + " passed"
  
  if failed > 0
    summary = summary + ", "
    summary = summary + colors.red(failed.to_s() + " failed")
  end
  
  if pending > 0
    summary = summary + ", "
    summary = summary + colors.yellow(pending.to_s() + " pending")
  end
  
  puts(summary)
  
  if failed > 0
    return 1
  else
    return 0
  end
end

# =============================================================================
# SUMMARY OF LANGUAGE HOLES DISCOVERED
# =============================================================================
#
# CRITICAL (Blockers):
# 1. No CLI arguments - can't implement output format flags
# 3. Can't store lambdas as Int and call them back - FUNDAMENTAL blocker
# 5. No top-level var - can't have global test registry
# 14. No way to invoke a function stored as Int handle
#
# SEVERE (Major workarounds needed):
# 4. No Bool type - using Int 0/1 everywhere
# 6. No typed allocation - alloc returns Int, loses type info
# 7. No methods on structs - verbose helper functions everywhere
# 11. No method chaining - can't do expect(x).to_eq(y)
#
# ANNOYING (Paper cuts):
# 2. Can't store typed lambdas in Vec
# 8. No block arguments (do...end)
# 9. Lambda invocation syntax unclear
# 10. Lambda-to-Int conversion unclear
# 12. UFCS for struct methods - does it work?
# 13. String comparison semantics unclear
#
# =============================================================================
