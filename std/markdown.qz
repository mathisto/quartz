# Markdown to HTML — Standard Library
#
# Converts Markdown text to HTML. Supports headings, code blocks, tables,
# bold, italic, inline code, links, blockquotes, horizontal rules,
# unordered lists, ordered lists, and paragraphs.
#
# Example:
#   import std/markdown
#   var html = md_to_html("# Hello\n\nSome **bold** text.")
#   var page = md_to_html_page("# Hello\n\nWorld.", "My Page")

# str_starts_with, str_ends_with, str_contains, str_trim, str_split are builtins

# =============================================================================
# HTML Escape
# =============================================================================

## Escape &, <, >, " for safe HTML embedding.
def html_escape(s: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == '&'
      sb.append("&amp;")
    elsif c == '<'
      sb.append("&lt;")
    elsif c == '>'
      sb.append("&gt;")
    elsif c == '"'
      sb.append("&quot;")
    else
      # Append the raw source byte verbatim — append_char would re-encode a
      # byte >127 as a codepoint, corrupting multibyte UTF-8 sequences.
      sb.append(str_byte_slice(s, i, i + 1))
    end
    i += 1
  end
  return sb.to_string()
end

# =============================================================================
# Inline Formatting
# =============================================================================

## Format inline elements: `code`, **bold**, *italic*, [links](url).
def inline_format(s: String): String
  var sb = sb_new()
  var i = 0
  var slen = str_byte_len(s)
  while i < slen
    var c = str_byte_at(s, i)

    # Inline code
    if c == '`'
      var end_pos = i + 1
      while end_pos < slen
        if str_byte_at(s, end_pos) == '`'
          break
        end
        end_pos += 1
      end
      if end_pos < slen
        var code = str_byte_slice(s, i + 1, end_pos)
        sb.append("<code>")
        sb.append(html_escape(code))
        sb.append("</code>")
        i = end_pos + 1
        continue
      end
    end

    # Bold **text**
    if c == '*'
      if i + 1 < slen
        if str_byte_at(s, i + 1) == '*'
          var end_pos = i + 2
          while end_pos + 1 < slen
            if str_byte_at(s, end_pos) == '*' and str_byte_at(s, end_pos + 1) == '*'
              break
            end
            end_pos += 1
          end
          if end_pos + 1 < slen
            var text = str_byte_slice(s, i + 2, end_pos)
            sb.append("<strong>")
            sb.append(text)
            sb.append("</strong>")
            i = end_pos + 2
            continue
          end
        end
      end
    end

    # Italic *text*
    if c == '*'
      if i + 1 < slen
        var end_pos = i + 1
        while end_pos < slen
          if str_byte_at(s, end_pos) == '*'
            break
          end
          end_pos += 1
        end
        if end_pos < slen and end_pos > i + 1
          var text = str_byte_slice(s, i + 1, end_pos)
          sb.append("<em>")
          sb.append(text)
          sb.append("</em>")
          i = end_pos + 1
          continue
        end
      end
    end

    # Link [text](url)
    if c == '['
      var close_bracket = i + 1
      while close_bracket < slen
        if str_byte_at(s, close_bracket) == ']'
          break
        end
        close_bracket += 1
      end
      if close_bracket < slen and close_bracket + 1 < slen
        if str_byte_at(s, close_bracket + 1) == '('
          var close_paren = close_bracket + 2
          while close_paren < slen
            if str_byte_at(s, close_paren) == ')'
              break
            end
            close_paren += 1
          end
          if close_paren < slen
            var text = str_byte_slice(s, i + 1, close_bracket)
            var url = str_byte_slice(s, close_bracket + 2, close_paren)
            sb.append("<a href=\"")
            sb.append(url)
            sb.append("\">")
            sb.append(text)
            sb.append("</a>")
            i = close_paren + 1
            continue
          end
        end
      end
    end

    # Append the raw source byte verbatim — append_char would re-encode a
    # byte >127 as a codepoint, corrupting multibyte UTF-8 sequences.
    sb.append(str_byte_slice(s, i, i + 1))
    i += 1
  end
  return sb.to_string()
end

# =============================================================================
# Table Helpers
# =============================================================================

## Split a markdown table row (|col1|col2|) into trimmed cell strings.
def split_table_row(line: String): Vec<String>
  var cells = vec_new<String>()
  var i = 1
  var start = 1
  var len = str_byte_len(line)
  while i < len
    if str_byte_at(line, i) == '|'
      var cell = str_trim(str_byte_slice(line, start, i))
      if str_byte_len(cell) > 0
        cells.push(cell)
      end
      start = i + 1
    end
    i += 1
  end
  return cells
end

# =============================================================================
# Anchor Generation
# =============================================================================

## Generate a URL-safe anchor ID from heading text.
def make_anchor(text: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(text)
  while i < len
    var c = str_byte_at(text, i)
    if c == '`'
      # skip backticks
      i += 1
      continue
    end
    if c == ' '
      sb.append_char('-')
    elsif c >= 'A' and c <= 'Z'
      sb.append_char(c + 32)
    elsif (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_' or c == '-'
      sb.append_char(c)
    end
    i += 1
  end
  return sb.to_string()
end

# =============================================================================
# Ordered List Detection
# =============================================================================

## Check if a line starts with a digit followed by ". " (e.g. "1. item").
def _is_ordered_list_item(line: String): Bool
  var len = str_byte_len(line)
  if len < 3
    return false
  end
  var i = 0
  while i < len
    var c = str_byte_at(line, i)
    if c >= '0' and c <= '9'
      i += 1
    else
      break
    end
  end
  if i == 0
    return false
  end
  if i + 1 < len and str_byte_at(line, i) == '.' and str_byte_at(line, i + 1) == ' '
    return true
  end
  return false
end

## Extract the text after "N. " from an ordered list line.
def _ordered_list_text(line: String): String
  var len = str_byte_len(line)
  var i = 0
  while i < len
    var c = str_byte_at(line, i)
    if c >= '0' and c <= '9'
      i += 1
    else
      break
    end
  end
  # Skip ". "
  return str_byte_slice(line, i + 2, len)
end

# =============================================================================
# Markdown to HTML
# =============================================================================

## Convert a Markdown string to an HTML fragment.
def md_to_html(md: String): String
  var sb = sb_new()
  var lines = str_split(md, "\n")
  var i = 0
  var in_code_block = 0
  var in_table = 0
  var in_ul = 0
  var in_ol = 0

  while i < lines.size
    var line = lines[i]

    # Code blocks
    if str_starts_with(line, "```")
      # Close any open list
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      if in_code_block
        sb.append("</code></pre>\n")
        in_code_block = 0
      else
        var lang = ""
        if str_byte_len(line) > 3
          lang = str_byte_slice(line, 3, str_byte_len(line))
        end
        if str_byte_len(lang) > 0
          # Typed info string "lang:variant" (e.g. "ruby:starter") splits into a
          # language- class plus a data-block-type attribute.
          var parts = str_split(lang, ":")
          if parts.size > 1
            sb.append("<pre><code class=\"language-")
            sb.append(parts[0])
            sb.append("\" data-block-type=\"")
            sb.append(parts[1])
            sb.append("\">")
          else
            sb.append("<pre><code class=\"language-")
            sb.append(lang)
            sb.append("\">")
          end
        else
          sb.append("<pre><code>")
        end
        in_code_block = 1
      end
      i += 1
      continue
    end

    if in_code_block
      sb.append(html_escape(line))
      sb.append("\n")
      i += 1
      continue
    end

    # Table rows
    if str_starts_with(line, "|")
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      if in_table == 0
        sb.append("<table>\n<thead><tr>")
        in_table = 1
        var cells = split_table_row(line)
        var ci = 0
        while ci < cells.size
          sb.append("<th>")
          sb.append(inline_format(cells[ci]))
          sb.append("</th>")
          ci += 1
        end
        sb.append("</tr></thead>\n<tbody>\n")
        # Skip separator row
        i += 1
        if i < lines.size
          if str_starts_with(lines[i], "|")
            i += 1
          end
        end
        continue
      else
        sb.append("<tr>")
        var cells = split_table_row(line)
        var ci = 0
        while ci < cells.size
          sb.append("<td>")
          sb.append(inline_format(cells[ci]))
          sb.append("</td>")
          ci += 1
        end
        sb.append("</tr>\n")
        i += 1
        continue
      end
    else
      if in_table
        sb.append("</tbody></table>\n")
        in_table = 0
      end
    end

    # Headings
    if str_starts_with(line, "### ")
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      var text = str_byte_slice(line, 4, str_byte_len(line))
      var anchor = make_anchor(text)
      sb.append("<h3 id=\"")
      sb.append(anchor)
      sb.append("\">")
      sb.append(inline_format(text))
      sb.append("</h3>\n")
      i += 1
      continue
    end
    if str_starts_with(line, "## ")
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      var text = str_byte_slice(line, 3, str_byte_len(line))
      var anchor = make_anchor(text)
      sb.append("<h2 id=\"")
      sb.append(anchor)
      sb.append("\">")
      sb.append(inline_format(text))
      sb.append("</h2>\n")
      i += 1
      continue
    end
    if str_starts_with(line, "# ")
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      var text = str_byte_slice(line, 2, str_byte_len(line))
      sb.append("<h1>")
      sb.append(inline_format(text))
      sb.append("</h1>\n")
      i += 1
      continue
    end

    # Blockquote
    if str_starts_with(line, "> ")
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      var text = str_byte_slice(line, 2, str_byte_len(line))
      sb.append("<blockquote>")
      sb.append(inline_format(text))
      sb.append("</blockquote>\n")
      i += 1
      continue
    end

    # Horizontal rule
    if line == "---"
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      sb.append("<hr>\n")
      i += 1
      continue
    end

    # Unordered list
    if str_starts_with(line, "- ")
      if in_ol == 1
        sb.append("</ol>\n")
        in_ol = 0
      end
      if in_ul == 0
        sb.append("<ul>\n")
        in_ul = 1
      end
      var text = str_byte_slice(line, 2, str_byte_len(line))
      sb.append("<li>")
      sb.append(inline_format(text))
      sb.append("</li>\n")
      i += 1
      continue
    end

    # Ordered list
    if _is_ordered_list_item(line)
      if in_ul == 1
        sb.append("</ul>\n")
        in_ul = 0
      end
      if in_ol == 0
        sb.append("<ol>\n")
        in_ol = 1
      end
      var text = _ordered_list_text(line)
      sb.append("<li>")
      sb.append(inline_format(text))
      sb.append("</li>\n")
      i += 1
      continue
    end

    # Close open lists on non-list lines
    if in_ul == 1
      sb.append("</ul>\n")
      in_ul = 0
    end
    if in_ol == 1
      sb.append("</ol>\n")
      in_ol = 0
    end

    # Empty line
    if str_byte_len(line) == 0
      i += 1
      continue
    end

    # Regular paragraph
    sb.append("<p>")
    sb.append(inline_format(line))
    sb.append("</p>\n")
    i += 1
  end

  # Close any unclosed elements
  if in_ul == 1
    sb.append("</ul>\n")
  end
  if in_ol == 1
    sb.append("</ol>\n")
  end
  if in_table
    sb.append("</tbody></table>\n")
  end
  if in_code_block
    sb.append("</code></pre>\n")
  end

  return sb.to_string()
end

# =============================================================================
# Full Page Wrapper
# =============================================================================

## Convert Markdown to a complete HTML page with minimal, tasteful CSS.
def md_to_html_page(md: String, title: String): String
  var body = md_to_html(md)
  var sb = sb_new()
  sb.append("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>")
  sb.append(html_escape(title))
  sb.append("</title>\n<style>\n")
  sb.append(_md_page_css())
  sb.append("</style>\n</head>\n<body>\n<main>\n")
  sb.append(body)
  sb.append("</main>\n</body>\n</html>\n")
  return sb.to_string()
end

def _md_page_css(): String
  var sb = sb_new()
  sb.append("body { font-family: system-ui, sans-serif; line-height: 1.6; color: #24292e; background: #fff; margin: 0; padding: 0; }\n")
  sb.append("main { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }\n")
  sb.append("h1, h2, h3 { margin-top: 1.5em; margin-bottom: 0.5em; border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }\n")
  sb.append("h1 { font-size: 2em; } h2 { font-size: 1.5em; } h3 { font-size: 1.25em; border-bottom: none; }\n")
  sb.append("code { background: #f6f8fa; padding: 0.2em 0.4em; border-radius: 3px; font-size: 85%; }\n")
  sb.append("pre { background: #f6f8fa; padding: 1em; border-radius: 6px; overflow-x: auto; }\n")
  sb.append("pre code { background: none; padding: 0; font-size: 85%; }\n")
  sb.append("table { border-collapse: collapse; width: 100%; margin: 1em 0; }\n")
  sb.append("th, td { border: 1px solid #dfe2e5; padding: 0.5em 1em; text-align: left; }\n")
  sb.append("th { background: #f6f8fa; font-weight: 600; }\n")
  sb.append("blockquote { margin: 1em 0; padding: 0 1em; color: #6a737d; border-left: 4px solid #dfe2e5; }\n")
  sb.append("a { color: #0366d6; text-decoration: none; } a:hover { text-decoration: underline; }\n")
  sb.append("hr { border: none; border-top: 1px solid #eaecef; margin: 2em 0; }\n")
  sb.append("ul, ol { padding-left: 2em; }\n")
  sb.append("li { margin: 0.25em 0; }\n")
  return sb.to_string()
end
