## Standard Vec Utilities
##
## Pure Quartz functions extending Vec with Option-returning accessors,
## higher-order collection operations, and immutable-interface wrappers
## around the in-place intrinsics (vec_clone, vec_extend, vec_delete).
##
## The intrinsics are polymorphic over element type; the helpers here that
## take `Vec<T>` and return `Vec<T>` are the canonical immutable-style
## entry points — they clone the input rather than mutating it. Callers
## that already own a fresh Vec should reach for the intrinsics directly
## to avoid the copy.

## Return the first element, or None if empty.
def vec_first(v: Vec<Int>): Option<Int>
  if v.size > 0
    return Option::Some(v[0])
  end
  return Option::None
end

## Return the last element, or None if empty.
def vec_last(v: Vec<Int>): Option<Int>
  if v.size > 0
    return Option::Some(v[v.size - 1])
  end
  return Option::None
end

## Apply f to each element, return a new Vec with the results.
def vec_map(v: Vec<Int>, f: Fn(Int): Int): Vec<Int>
  var result: Vec<Int> = vec_new()
  var transform: Fn(Int): Int = f
  for i in 0..v.size
    result.push(transform(v[i]))
  end
  return result
end

## Return a new Vec containing only elements matching the predicate.
def vec_filter(v: Vec<Int>, pred: Fn(Int): Bool): Vec<Int>
  var result: Vec<Int> = vec_new()
  var predicate: Fn(Int): Bool = pred
  for i in 0..v.size
    if predicate(v[i])
      result.push(v[i])
    end
  end
  return result
end

# ----- Immutable-interface generic helpers (clone-then-mutate) ------------

## Return a new Vec equal to `src` with the element at `idx` removed.
## `src` is not mutated. Out-of-range `idx` is clamped to no-op.
def vec_remove_at<T>(src: Vec<T>, idx: Int): Vec<T>
  var out: Vec<T> = vec_clone(src)
  if idx >= 0 and idx < out.size
    vec_delete(out, idx)
  end
  return out
end

## Return a new Vec containing all elements of `a` followed by all
## elements of `b`. Neither input is mutated.
def vec_concat<T>(a: Vec<T>, b: Vec<T>): Vec<T>
  var out: Vec<T> = vec_clone(a)
  vec_extend(out, b)
  return out
end

## Pop up to `n` elements from the END of `src`, returning
## (drawn, remaining). Drawn is in pop order — most-recently-pushed
## element is at index 0 of `drawn`. `src` is not mutated. If `n`
## exceeds `src.size`, all elements are drawn and `remaining` is empty.
def vec_pop_n_from_end<T>(src: Vec<T>, n: Int): (Vec<T>, Vec<T>)
  var drawn: Vec<T> = vec_new<T>()
  var remaining: Vec<T> = vec_clone(src)
  var i = 0
  while i < n and remaining.size > 0
    var top = remaining[remaining.size - 1]
    drawn.push(top)
    vec_delete(remaining, remaining.size - 1)
    i = i + 1
  end
  return (drawn, remaining)
end
