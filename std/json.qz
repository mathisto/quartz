## JSON Library for Be
##
## A complete JSON parser and serializer following RFC 8259.
## Supports parsing, value manipulation, and stringification.

import * from error
import * from traits

# ============================================================================
# JSON Value Types
# ============================================================================

enum JsonValue
  Null
  Bool(value: Int)                          # 0 = false, 1 = true
  Number(value: Int)                        # Integer value
  Float(value: F64)
  String(value: String)
  Array(items: Vec<JsonValue>)
  Object(fields: Map<String, JsonValue>)
end

## Union type alias for primitive JSON scalar values (v5.25).
## Not a replacement for JsonValue — a convenience type for functions
## that only accept scalar primitives (no arrays/objects/null).
type JsonPrimitive = Int | F64 | String | Bool

# Deprecated: use ParseError from error module instead
struct JsonLocation
  line: Int
  column: Int
end

# Deprecated: use ParseError from error module instead
struct JsonError
  message: String
  location: JsonLocation
end

# Deprecated: use Result<JsonValue, ParseError> instead
enum JsonResult
  Ok(value: JsonValue)
  Err(error: JsonError)
end

# ============================================================================
# Lexer Types
# ============================================================================

enum JsonTokenKind
  String
  Number
  True
  False
  Null
  LBrace
  RBrace
  LBracket
  RBracket
  Colon
  Comma
  Eof
  Error
end

struct JsonToken
  kind: JsonTokenKind
  value: String
  line: Int
  column: Int
end

struct JsonLexer
  source: String
  pos: Int
  line: Int
  column: Int
end

# ============================================================================
# Parser Types
# ============================================================================

struct JsonParser
  lexer: JsonLexer
  current: JsonToken
  had_error: Int
  error_message: String
  error_line: Int
  error_column: Int
end

# ============================================================================
# Value Constructors
# ============================================================================

def json_null(): JsonValue
  return JsonValue::Null
end

def json_bool(b: Int): JsonValue
  return JsonValue::Bool(b)
end

def json_number(n: Int): JsonValue
  return JsonValue::Number(n)
end

def json_float(f: F64): JsonValue
  return JsonValue::Float(f)
end

def json_string(s: String): JsonValue
  return JsonValue::String(s)
end

def json_array(): JsonValue
  return JsonValue::Array(vec_new<JsonValue>())
end

def json_object(): JsonValue
  return JsonValue::Object(map_new<String, JsonValue>())
end

# ============================================================================
# Type Predicates
# ============================================================================

def json_is_null(v: JsonValue): Bool
  match v
    JsonValue::Null => return true
    _ => return false
  end
end

def json_is_bool(v: JsonValue): Bool
  match v
    JsonValue::Bool(b) => return true
    _ => return false
  end
end

def json_is_number(v: JsonValue): Bool
  match v
    JsonValue::Number(n) => return true
    _ => return false
  end
end

def json_is_float(v: JsonValue): Bool
  match v
    JsonValue::Float(f) => return true
    _ => return false
  end
end

def json_is_string(v: JsonValue): Bool
  match v
    JsonValue::String(s) => return true
    _ => return false
  end
end

def json_is_array(v: JsonValue): Bool
  match v
    JsonValue::Array(a) => return true
    _ => return false
  end
end

def json_is_object(v: JsonValue): Bool
  match v
    JsonValue::Object(o) => return true
    _ => return false
  end
end

# ============================================================================
# Value Extractors
# ============================================================================

def json_as_bool(v: JsonValue): Int
  match v
    JsonValue::Null => return 0
    JsonValue::Bool(b) => return b
    JsonValue::Number(n) => return 0
    JsonValue::Float(f) => return 0
    JsonValue::String(s) => return 0
    JsonValue::Array(a) => return 0
    JsonValue::Object(o) => return 0
  end
end

def json_as_number(v: JsonValue): Int
  match v
    JsonValue::Null => return 0
    JsonValue::Bool(b) => return 0
    JsonValue::Number(n) => return n
    JsonValue::Float(f) => return 0
    JsonValue::String(s) => return 0
    JsonValue::Array(a) => return 0
    JsonValue::Object(o) => return 0
  end
end

def json_as_string(v: JsonValue): String
  match v
    JsonValue::Null => return ""
    JsonValue::Bool(b) => return ""
    JsonValue::Number(n) => return ""
    JsonValue::Float(f) => return ""
    JsonValue::String(s) => return s
    JsonValue::Array(a) => return ""
    JsonValue::Object(o) => return ""
  end
end

def json_as_array(v: JsonValue): Vec<JsonValue>
  match v
    JsonValue::Array(a) => return a
    _ => return vec_new<JsonValue>()
  end
end

def json_as_object(v: JsonValue): Map<String, JsonValue>
  match v
    JsonValue::Object(o) => return o
    _ => return map_new<String, JsonValue>()
  end
end

# ============================================================================
# Array Operations
# ============================================================================

def json_array_push(arr: JsonValue, val: JsonValue): Void
  match arr
    JsonValue::Null => return
    JsonValue::Bool(b) => return
    JsonValue::Number(n) => return
    JsonValue::Float(f) => return
    JsonValue::String(s) => return
    JsonValue::Array(items) => items.push(val)
    JsonValue::Object(o) => return
  end
end

def json_array_get_impl(items: Vec<JsonValue>, idx: Int): JsonValue
  if idx < 0
    return JsonValue::Null
  end
  if idx >= items.size
    return JsonValue::Null
  end
  return items[idx]
end

def json_array_get(arr: JsonValue, idx: Int): JsonValue
  match arr
    JsonValue::Null => return JsonValue::Null
    JsonValue::Bool(b) => return JsonValue::Null
    JsonValue::Number(n) => return JsonValue::Null
    JsonValue::Float(f) => return JsonValue::Null
    JsonValue::String(s) => return JsonValue::Null
    JsonValue::Array(items) => return json_array_get_impl(items, idx)
    JsonValue::Object(o) => return JsonValue::Null
  end
end

def json_array_size(arr: JsonValue): Int
  match arr
    JsonValue::Null => return 0
    JsonValue::Bool(b) => return 0
    JsonValue::Number(n) => return 0
    JsonValue::Float(f) => return 0
    JsonValue::String(s) => return 0
    JsonValue::Array(items) => return items.size
    JsonValue::Object(o) => return 0
  end
end

# ============================================================================
# Object Operations
# ============================================================================

def json_object_set(obj: JsonValue, key: String, val: JsonValue): Void
  match obj
    JsonValue::Null => return
    JsonValue::Bool(b) => return
    JsonValue::Number(n) => return
    JsonValue::Float(f) => return
    JsonValue::String(s) => return
    JsonValue::Array(a) => return
    JsonValue::Object(fields) => fields.set(key, val)
  end
end

def json_object_get_impl(fields: Map<String, JsonValue>, key: String): JsonValue
  match fields.get(key)
    Some(v) => return v
    _ => return JsonValue::Null
  end
end

def json_object_get(obj: JsonValue, key: String): JsonValue
  match obj
    JsonValue::Null => return JsonValue::Null
    JsonValue::Bool(b) => return JsonValue::Null
    JsonValue::Number(n) => return JsonValue::Null
    JsonValue::Float(f) => return JsonValue::Null
    JsonValue::String(s) => return JsonValue::Null
    JsonValue::Array(a) => return JsonValue::Null
    JsonValue::Object(fields) => return json_object_get_impl(fields, key)
  end
end

def json_object_has(obj: JsonValue, key: String): Bool
  match obj
    JsonValue::Object(fields) => return fields.has(key)
    _ => return false
  end
end

def json_object_keys(obj: JsonValue): Vec<String>
  match obj
    JsonValue::Object(fields) => return fields.keys()
    _ => return vec_new<String>()
  end
end

# ============================================================================
# Path Access
# ============================================================================

def json_get_path(v: JsonValue, path: String): JsonValue
  var current = v
  var start = 0
  var i = 0
  var len = str_byte_len(path)
  
  while i <= len
    var c = 0
    if i < len
      c = str_byte_at(path, i)
    end
    
    if c == '.' or i == len
      if i > start
        var segment = str_byte_slice(path, start, i)
        var is_numeric = 1
        var j = 0
        while j < str_byte_len(segment)
          var ch = str_byte_at(segment, j)
          if ch < '0' or ch > '9'
            is_numeric = 0
          end
          j = j + 1
        end
        
        if is_numeric == 1 and not segment.empty?
          var idx = segment.to_i()
          current = json_array_get(current, idx)
        else
          current = json_object_get(current, segment)
        end
      end
      start = i + 1
    end
    i = i + 1
  end
  
  return current
end

def json_get_string(v: JsonValue, path: String): String
  return json_as_string(json_get_path(v, path))
end

def json_get_number(v: JsonValue, path: String): Int
  return json_as_number(json_get_path(v, path))
end

def json_get_bool(v: JsonValue, path: String): Int
  return json_as_bool(json_get_path(v, path))
end

# ============================================================================
# Error Helpers
# ============================================================================

def json_error(msg: String, line: Int, col: Int): JsonError
  var loc = JsonLocation { line: line, column: col }
  return JsonError { message: msg, location: loc }
end

def json_ok(v: JsonValue): JsonResult
  return JsonResult::Ok(v)
end

def json_err(msg: String, line: Int, col: Int): JsonResult
  return JsonResult::Err(json_error(msg, line, col))
end

# ============================================================================
# Lexer Functions
# ============================================================================

def json_lexer_new(source: String): JsonLexer
  return JsonLexer {
    source: source,
    pos: 0,
    line: 1,
    column: 1
  }
end

def json_lexer_at_end(lexer: JsonLexer): Int
  if lexer.pos >= str_byte_len(lexer.source)
    return 1
  end
  return 0
end

def json_lexer_peek(lexer: JsonLexer): Int
  if json_lexer_at_end(lexer) == 1
    return 0
  end
  return str_byte_at(lexer.source, lexer.pos)
end

def json_lexer_advance(lexer: JsonLexer): Int
  if json_lexer_at_end(lexer) == 1
    return 0
  end
  var c = str_byte_at(lexer.source, lexer.pos)
  lexer.pos = lexer.pos + 1
  if c == '\n'
    lexer.line = lexer.line + 1
    lexer.column = 1
  else
    lexer.column = lexer.column + 1
  end
  return c
end

def json_lexer_skip_whitespace(lexer: JsonLexer): Void
  while json_lexer_at_end(lexer) == 0
    var c = json_lexer_peek(lexer)
    if c == ' ' or c == '\t' or c == '\n' or c == '\r'
      json_lexer_advance(lexer)
    else
      return
    end
  end
end

def json_token(kind: JsonTokenKind, value: String, line: Int, col: Int): JsonToken
  return JsonToken {
    kind: kind,
    value: value,
    line: line,
    column: col
  }
end

def json_token_simple(kind: JsonTokenKind, line: Int, col: Int): JsonToken
  return json_token(kind, "", line, col)
end

def json_token_error(msg: String, line: Int, col: Int): JsonToken
  return json_token(JsonTokenKind::Error, msg, line, col)
end

def json_escape_char(c: Int): Int
  if c == 'n'
    return 10
  end
  if c == 't'
    return 9
  end
  if c == 'r'
    return 13
  end
  if c == '"'
    return 34
  end
  if c == '\\'
    return 92
  end
  if c == '/'
    return 47
  end
  if c == 'b'
    return 8
  end
  if c == 'f'
    return 12
  end
  if c == 'u'
    return -2
  end
  return -1
end

# ============================================================================
# Unicode Escape Helpers
# ============================================================================

def json_hex_digit_value(c: Int): Int
  if c >= '0' and c <= '9'
    return c - 48
  end
  if c >= 'A' and c <= 'F'
    return c - 55
  end
  if c >= 'a' and c <= 'f'
    return c - 87
  end
  return -1
end

def json_parse_unicode_hex4(lexer: JsonLexer): Int
  var result = 0
  var i = 0
  while i < 4
    if json_lexer_at_end(lexer) == 1
      return -1
    end
    var c = json_lexer_advance(lexer)
    var digit = json_hex_digit_value(c)
    if digit < 0
      return -1
    end
    result = result * 16 + digit
    i = i + 1
  end
  return result
end

def json_codepoint_to_utf8(cp: Int): String
  if cp < 0
    return "?"
  end
  if cp == 0
    return "?"
  end
  if cp < 128
    return str_from_char(cp)
  end
  if cp < 2048
    var b1 = 192 + (cp / 32)
    var b2 = 128 + (cp % 64)
    return "#{str_from_char(b1)}#{str_from_char(b2)}"
  end
  if cp < 65536
    var b1 = 224 + (cp / 4096)
    var b2 = 128 + ((cp / 64) % 64)
    var b3 = 128 + (cp % 64)
    return "#{str_from_char(b1)}#{str_from_char(b2)}#{str_from_char(b3)}"
  end
  if cp < 1114112
    var b1 = 240 + (cp / 262144)
    var b2 = 128 + ((cp / 4096) % 64)
    var b3 = 128 + ((cp / 64) % 64)
    var b4 = 128 + (cp % 64)
    return "#{str_from_char(b1)}#{str_from_char(b2)}#{str_from_char(b3)}#{str_from_char(b4)}"
  end
  return "?"
end

def json_lexer_scan_string(lexer: JsonLexer): JsonToken
  var start_line = lexer.line
  var start_col = lexer.column
  json_lexer_advance(lexer)
  var result = ""
  
  while json_lexer_at_end(lexer) == 0
    var c = json_lexer_peek(lexer)
    
    if c == '"'
      json_lexer_advance(lexer)
      return json_token(JsonTokenKind::String, result, start_line, start_col)
    end
    
    if c == '\n' or c == '\r'
      return json_token_error("Newline in string", lexer.line, lexer.column)
    end
    
    if c == '\\'
      json_lexer_advance(lexer)
      if json_lexer_at_end(lexer) == 1
        return json_token_error("Unterminated string escape", start_line, start_col)
      end
      var escaped = json_lexer_advance(lexer)
      var mapped = json_escape_char(escaped)
      if mapped == -2
        var cp = json_parse_unicode_hex4(lexer)
        if cp < 0
          return json_token_error("Invalid unicode escape", lexer.line, lexer.column)
        end
        # Check for surrogate pair (high surrogate: U+D800-U+DBFF)
        if cp >= 55296 and cp <= 56319
          if json_lexer_peek(lexer) == '\\'
            json_lexer_advance(lexer)
            if json_lexer_peek(lexer) == 'u'
              json_lexer_advance(lexer)
              var low = json_parse_unicode_hex4(lexer)
              if low >= 56320 and low <= 57343
                cp = 65536 + (cp - 55296) * 1024 + (low - 56320)
              else
                return json_token_error("Invalid unicode surrogate pair", lexer.line, lexer.column)
              end
            else
              return json_token_error("Expected low surrogate after high surrogate", lexer.line, lexer.column)
            end
          else
            return json_token_error("Expected low surrogate after high surrogate", lexer.line, lexer.column)
          end
        end
        # Reject lone low surrogates (U+DC00-U+DFFF)
        if cp >= 56320 and cp <= 57343
          return json_token_error("Unexpected low surrogate", lexer.line, lexer.column)
        end
        result = "#{result}#{json_codepoint_to_utf8(cp)}"
      end
      if mapped == -1
        return json_token_error("Invalid escape sequence", lexer.line, lexer.column)
      end
      if mapped >= 0
        result = "#{result}#{str_from_char(mapped)}"
      end
    else
      result = "#{result}#{str_from_char(json_lexer_advance(lexer))}"
    end
  end
  
  return json_token_error("Unterminated string", start_line, start_col)
end

def json_is_digit(c: Int): Int
  if c >= '0' and c <= '9'
    return 1
  end
  return 0
end

def json_lexer_scan_number(lexer: JsonLexer): JsonToken
  var start_line = lexer.line
  var start_col = lexer.column
  var start_pos = lexer.pos
  
  if json_lexer_peek(lexer) == '-'
    json_lexer_advance(lexer)
  end

  if json_lexer_peek(lexer) == '0'
    json_lexer_advance(lexer)
  else
    if json_is_digit(json_lexer_peek(lexer)) == 1
      while json_is_digit(json_lexer_peek(lexer)) == 1
        json_lexer_advance(lexer)
      end
    else
      return json_token_error("Invalid number", start_line, start_col)
    end
  end
  
  if json_lexer_peek(lexer) == '.'
    json_lexer_advance(lexer)
    if json_is_digit(json_lexer_peek(lexer)) == 0
      return json_token_error("Invalid number: expected digit after decimal", start_line, start_col)
    end
    while json_is_digit(json_lexer_peek(lexer)) == 1
      json_lexer_advance(lexer)
    end
  end
  
  var c = json_lexer_peek(lexer)
  if c == 'e' or c == 'E'
    json_lexer_advance(lexer)
    c = json_lexer_peek(lexer)
    if c == '+' or c == '-'
      json_lexer_advance(lexer)
    end
    if json_is_digit(json_lexer_peek(lexer)) == 0
      return json_token_error("Invalid number: expected digit in exponent", start_line, start_col)
    end
    while json_is_digit(json_lexer_peek(lexer)) == 1
      json_lexer_advance(lexer)
    end
  end
  
  var num_str = str_byte_slice(lexer.source, start_pos, lexer.pos)
  return json_token(JsonTokenKind::Number, num_str, start_line, start_col)
end

def json_lexer_scan_keyword(lexer: JsonLexer, keyword: String, kind: JsonTokenKind): JsonToken
  var start_line = lexer.line
  var start_col = lexer.column
  var len = str_byte_len(keyword)
  var i = 0
  
  while i < len
    if json_lexer_at_end(lexer) == 1
      return json_token_error("Unexpected end of input", start_line, start_col)
    end
    var expected = str_byte_at(keyword, i)
    var actual = json_lexer_advance(lexer)
    if actual != expected
      return json_token_error("Invalid keyword", start_line, start_col)
    end
    i = i + 1
  end
  
  return json_token_simple(kind, start_line, start_col)
end

def json_lexer_next(lexer: JsonLexer): JsonToken
  json_lexer_skip_whitespace(lexer)
  
  if json_lexer_at_end(lexer) == 1
    return json_token_simple(JsonTokenKind::Eof, lexer.line, lexer.column)
  end
  
  var c = json_lexer_peek(lexer)
  var line = lexer.line
  var col = lexer.column
  
  if c == '{'
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::LBrace, line, col)
  end
  if c == '}'
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::RBrace, line, col)
  end
  if c == '['
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::LBracket, line, col)
  end
  if c == ']'
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::RBracket, line, col)
  end
  if c == ':'
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::Colon, line, col)
  end
  if c == ','
    json_lexer_advance(lexer)
    return json_token_simple(JsonTokenKind::Comma, line, col)
  end
  
  if c == '"'
    return json_lexer_scan_string(lexer)
  end
  
  if c == '-' or json_is_digit(c) == 1
    return json_lexer_scan_number(lexer)
  end
  
  if c == 't'
    return json_lexer_scan_keyword(lexer, "true", JsonTokenKind::True)
  end
  if c == 'f'
    return json_lexer_scan_keyword(lexer, "false", JsonTokenKind::False)
  end
  if c == 'n'
    return json_lexer_scan_keyword(lexer, "null", JsonTokenKind::Null)
  end
  
  json_lexer_advance(lexer)
  return json_token_error("Unexpected character", line, col)
end

# ============================================================================
# Parser Functions
# ============================================================================

def json_parser_new(source: String): JsonParser
  var lex = json_lexer_new(source)
  var first_token = json_lexer_next(lex)
  return JsonParser {
    lexer: lex,
    current: first_token,
    had_error: 0,
    error_message: "",
    error_line: 0,
    error_column: 0
  }
end

def json_parser_error(parser: JsonParser, msg: String): Void
  if parser.had_error == 0
    parser.had_error = 1
    parser.error_message = msg
    parser.error_line = parser.current.line
    parser.error_column = parser.current.column
  end
end

## Helper to get current token value (uses chained field access — local-var copy
## of `parser.current` mis-dispatches `.kind` as a method call, see compiler bug
## STRUCT_FIELD_LOCAL_COPY_METHOD_DISPATCH).
def json_parser_get_value(parser: JsonParser): String
  return parser.current.value
end

## Helper to get current token kind (uses chained field access — see note above).
def json_parser_get_kind(parser: JsonParser): Int
  return parser.current.kind
end

def json_parser_advance(parser: JsonParser): JsonToken
  var prev = parser.current
  parser.current = json_lexer_next(parser.lexer)
  return prev
end

def json_parser_check(parser: JsonParser, kind: JsonTokenKind): Int
  if parser.current.kind == kind
    return 1
  end
  return 0
end

def json_parser_match(parser: JsonParser, kind: JsonTokenKind): Int
  if json_parser_check(parser, kind) == 0
    return 0
  end
  json_parser_advance(parser)
  return 1
end

def json_parser_expect(parser: JsonParser, kind: JsonTokenKind, msg: String): Int
  if json_parser_check(parser, kind) == 1
    json_parser_advance(parser)
    return 1
  end
  json_parser_error(parser, msg)
  return 0
end

def json_parse_array(parser: JsonParser): JsonValue
  var arr = json_array()
  
  if json_parser_check(parser, JsonTokenKind::RBracket) == 1
    json_parser_advance(parser)
    return arr
  end
  
  var first = json_parse_value(parser)
  if parser.had_error == 1
    return json_null()
  end
  json_array_push(arr, first)
  
  while json_parser_match(parser, JsonTokenKind::Comma) == 1
    var elem = json_parse_value(parser)
    if parser.had_error == 1
      return json_null()
    end
    json_array_push(arr, elem)
  end
  
  if json_parser_expect(parser, JsonTokenKind::RBracket, "Expected ']' after array elements") == 0
    return json_null()
  end
  
  return arr
end

def json_parse_object(parser: JsonParser): JsonValue
  var obj = json_object()
  
  if json_parser_check(parser, JsonTokenKind::RBrace) == 1
    json_parser_advance(parser)
    return obj
  end
  
  if json_parser_check(parser, JsonTokenKind::String) == 0
    json_parser_error(parser, "Expected string key in object")
    return json_null()
  end
  var key = json_parser_get_value(parser)
  json_parser_advance(parser)
  
  if json_parser_expect(parser, JsonTokenKind::Colon, "Expected ':' after object key") == 0
    return json_null()
  end
  
  var v = json_parse_value(parser)
  if parser.had_error == 1
    return json_null()
  end
  json_object_set(obj, key, v)
  
  while json_parser_match(parser, JsonTokenKind::Comma) == 1
    if json_parser_check(parser, JsonTokenKind::String) == 0
      json_parser_error(parser, "Expected string key in object")
      return json_null()
    end
    key = json_parser_get_value(parser)
    json_parser_advance(parser)
    
    if json_parser_expect(parser, JsonTokenKind::Colon, "Expected ':' after object key") == 0
      return json_null()
    end
    
    v = json_parse_value(parser)
    if parser.had_error == 1
      return json_null()
    end
    json_object_set(obj, key, v)
  end
  
  if json_parser_expect(parser, JsonTokenKind::RBrace, "Expected '}' after object members") == 0
    return json_null()
  end
  
  return obj
end

def json_parse_value(parser: JsonParser): JsonValue
  if parser.had_error == 1
    return json_null()
  end
  
  var kind = json_parser_get_kind(parser)
  
  if kind == JsonTokenKind::Null
    json_parser_advance(parser)
    return json_null()
  end
  
  if kind == JsonTokenKind::True
    json_parser_advance(parser)
    return json_bool(1)
  end
  if kind == JsonTokenKind::False
    json_parser_advance(parser)
    return json_bool(0)
  end
  
  if kind == JsonTokenKind::Number
    var num_str = json_parser_get_value(parser)
    json_parser_advance(parser)
    # Check if this is a float (contains '.', 'e', or 'E')
    if str_contains(num_str, ".")
      return json_float(str_to_f64(num_str))
    end
    if str_contains(num_str, "e")
      return json_float(str_to_f64(num_str))
    end
    if str_contains(num_str, "E")
      return json_float(str_to_f64(num_str))
    end
    var num = num_str.to_i()
    return json_number(num)
  end
  
  if kind == JsonTokenKind::String
    var str_val = json_parser_get_value(parser)
    json_parser_advance(parser)
    return json_string(str_val)
  end
  
  if kind == JsonTokenKind::LBracket
    json_parser_advance(parser)
    return json_parse_array(parser)
  end
  
  if kind == JsonTokenKind::LBrace
    json_parser_advance(parser)
    return json_parse_object(parser)
  end
  
  if kind == JsonTokenKind::Error
    json_parser_error(parser, json_parser_get_value(parser))
    return json_null()
  end
  
  json_parser_error(parser, "Unexpected token")
  return json_null()
end

def json_parse(source: String): Result<JsonValue, ParseError>
  var parser = json_parser_new(source)
  var val = json_parse_value(parser)

  if parser.had_error == 1
    return Result::Err(parse_error(parser.error_message, parser.error_line, parser.error_column))
  end

  if json_parser_check(parser, JsonTokenKind::Eof) == 0
    return Result::Err(parse_error("Unexpected content after JSON value", parser.current.line, parser.current.column))
  end

  return Result::Ok(val)
end

def json_parse_or_null(source: String): JsonValue
  var result = json_parse(source)
  match result
    Ok(v) => return v
    Err(e) => return json_null()
  end
end

# Deprecated: use json_parse() which returns Result<JsonValue, ParseError>
def json_parse_legacy(source: String): JsonResult
  var parser = json_parser_new(source)
  var val = json_parse_value(parser)

  if parser.had_error == 1
    return json_err(parser.error_message, parser.error_line, parser.error_column)
  end

  if json_parser_check(parser, JsonTokenKind::Eof) == 0
    return json_err("Unexpected content after JSON value", parser.current.line, parser.current.column)
  end

  return json_ok(val)
end

# ============================================================================
# Stringify Functions
# ============================================================================

def json_escape_string(s: String): String
  var result = ""
  var i = 0
  var len = str_byte_len(s)
  
  while i < len
    var c = str_byte_at(s, i)
    if c == '"'
      result = "#{result}\\\""
    end
    if c == '\\'
      result = "#{result}\\\\"
    end
    if c == '\n'
      result = "#{result}\\n"
    end
    if c == '\r'
      result = "#{result}\\r"
    end
    if c == '\t'
      result = "#{result}\\t"
    end
    if c != '"' and c != '\\' and c != '\n' and c != '\r' and c != '\t'
      result = "#{result}#{str_from_char(c)}"
    end
    i = i + 1
  end
  
  return result
end

def json_stringify_array(items: Int): String
  var result = "["
  var len = vec_size(items)
  var i = 0
  
  while i < len
    if i > 0
      result = "#{result},"
    end
    var elem = vec_get(items, i)
    result = "#{result}#{json_stringify(elem)}"
    i = i + 1
  end
  
  result = "#{result}]"
  return result
end

def json_stringify_object(fields: Map<String, JsonValue>): String
  var result = "{"
  var keys = fields.keys()
  var len = keys.size
  var i = 0

  while i < len
    if i > 0
      result = "#{result},"
    end
    var key = keys[i]
    result = "#{result}\""
    result = "#{result}#{json_escape_string(key)}"
    result = "#{result}\":"
    match fields.get(key)
      Some(val) => {
        result = "#{result}#{json_stringify(val)}"
      }
      _ => {}
    end
    i = i + 1
  end

  result = "#{result}}"
  return result
end

def json_stringify_bool(b: Int): String
  if b == 1
    return "true"
  else
    return "false"
  end
end

def json_stringify_string(s: String): String
  var result = "\""
  result = "#{result}#{json_escape_string(s)}"
  result = "#{result}\""
  return result
end

def json_stringify(v: JsonValue): String
  match v
    JsonValue::Null => return "null"
    JsonValue::Bool(b) => return json_stringify_bool(b)
    JsonValue::Number(n) => return n.to_s()
    JsonValue::Float(f) => return f64_to_str(f)
    JsonValue::String(s) => return json_stringify_string(s)
    JsonValue::Array(items) => return json_stringify_array(items)
    JsonValue::Object(fields) => return json_stringify_object(fields)
  end
end

def json_make_indent(spaces: Int): String
  var result = ""
  var i = 0
  while i < spaces
    result = "#{result} "
    i = i + 1
  end
  return result
end

def json_stringify_array_pretty(items: Vec<JsonValue>, indent: Int, depth: Int): String
  var len = items.size
  if len == 0
    return "[]"
  end
  var result = "[\n"
  var child_indent = json_make_indent(indent * (depth + 1))
  var close_indent = json_make_indent(indent * depth)
  var i = 0
  while i < len
    if i > 0
      result = "#{result},\n"
    end
    result = "#{result}#{child_indent}"
    var elem = items[i]
    result = "#{result}#{json_stringify_pretty_inner(elem, indent, depth + 1)}"
    i = i + 1
  end
  result = "#{result}\n"
  result = "#{result}#{close_indent}"
  result = "#{result}]"
  return result
end

def json_stringify_object_pretty(fields: Map<String, JsonValue>, indent: Int, depth: Int): String
  var keys = fields.keys()
  var len = keys.size
  if len == 0
    return "{}"
  end
  var result = "{\n"
  var child_indent = json_make_indent(indent * (depth + 1))
  var close_indent = json_make_indent(indent * depth)
  var i = 0
  while i < len
    if i > 0
      result = "#{result},\n"
    end
    result = "#{result}#{child_indent}"
    var key = keys[i]
    result = "#{result}\""
    result = "#{result}#{json_escape_string(key)}"
    result = "#{result}\": "
    match fields.get(key)
      Some(val) => {
        result = "#{result}#{json_stringify_pretty_inner(val, indent, depth + 1)}"
      }
      _ => {}
    end
    i = i + 1
  end
  result = "#{result}\n"
  result = "#{result}#{close_indent}"
  result = "#{result}}"
  return result
end

def json_stringify_pretty_inner(v: JsonValue, indent: Int, depth: Int): String
  match v
    JsonValue::Null => return "null"
    JsonValue::Bool(b) => return json_stringify_bool(b)
    JsonValue::Number(n) => return n.to_s()
    JsonValue::Float(f) => return f64_to_str(f)
    JsonValue::String(s) => return json_stringify_string(s)
    JsonValue::Array(items) => return json_stringify_array_pretty(items, indent, depth)
    JsonValue::Object(fields) => return json_stringify_object_pretty(fields, indent, depth)
  end
end

def json_stringify_pretty(v: JsonValue, indent: Int): String
  return json_stringify_pretty_inner(v, indent, 0)
end

# ============================================================================
# UFCS Extend Block
# ============================================================================

extend JsonValue
  def is_null(): Bool
    return json_is_null(self)
  end

  def is_bool(): Bool
    return json_is_bool(self)
  end

  def is_number(): Bool
    return json_is_number(self)
  end

  def is_float(): Bool
    return json_is_float(self)
  end

  def is_string(): Bool
    return json_is_string(self)
  end

  def is_array(): Bool
    return json_is_array(self)
  end

  def is_object(): Bool
    return json_is_object(self)
  end

  def as_bool(): Int
    return json_as_bool(self)
  end

  def as_number(): Int
    return json_as_number(self)
  end

  def as_string(): String
    return json_as_string(self)
  end

  def as_array(): Vec<JsonValue>
    return json_as_array(self)
  end

  def as_object(): Map<String, JsonValue>
    return json_as_object(self)
  end

  def get(key: String): JsonValue
    return json_object_get(self, key)
  end

  def get_at(idx: Int): JsonValue
    return json_array_get(self, idx)
  end

  def set(key: String, val: JsonValue): Void
    json_object_set(self, key, val)
  end

  def has(key: String): Bool
    return json_object_has(self, key)
  end

  def size(): Int
    return json_array_size(self)
  end

  def push(val: JsonValue): Void
    json_array_push(self, val)
  end

  def to_s(): String
    return json_stringify(self)
  end

  def to_pretty(indent: Int): String
    return json_stringify_pretty(self, indent)
  end

  def path(p: String): JsonValue
    return json_get_path(self, p)
  end
end

# ============================================================================
# Trait Implementations
# ============================================================================

extend JsonValue with Show
  def show(self): String = json_stringify(self)
end

extend JsonValue with Serializable
  def to_json(self): Int = as_int(self)
end
