## std/throws — algebraic effect-based fatal-error reporting.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D (Throws is in
## the runtime's blessed default-handler set since D.4). Phase 6.1.b
## adds the explicit module + std/log-shaped surface so user code can
## `import std/throws` without redeclaring the effect inline.
##
## The Throws effect carries a single op `throw(msg: String)` whose
## payload is the diagnostic message. Throw is unwind-style (kind=2):
## a `throw("boom")` inside a `with Throws { throw: my_h } do ... end`
## longjmps to my_h, whose return value becomes the with-block's value
## — execution does NOT continue past the `throw(...)` site. The
## kind=2 classification is driven by the canonical `= resume(0)` body
## marker on the op decl below (see typecheck_walk.qz §"P3.0b: split
## kind=2 (tail resume — unwind/abort) from kind=3"). Without this
## marker, the op would default to kind=1 (continuation-style), in
## which case post-throw code would still execute after the handler
## returned — the wrong semantic for an abort-flavored effect.
##
## The runtime default handler (installed by main prelude) writes the
## message to stderr + newline, then exits 66 — non-recoverable by
## design. Programs that need recovery install a user handler:
##
##   def my_throw(op_name: Int, argc: Int, argv: Int): Int
##     var msg = as_string(load(argv, 0))
##     # ... handle gracefully, return some code ...
##     return 1
##   end
##
##   with Throws { throw: my_throw } do ->
##     risky_operation()  # throws return through my_throw
##   end
##
## Usage:
##   import std/throws
##
##   def main(): Int
##     throw("fatal: cannot proceed")  # default handler exits 66
##   end
##
## Handler ABI: `def h(op_name: Int, argc: Int, argv: Int): Int`. Decode
## the message via `as_string(load(argv, 0))` — or, using std/effects,
## `effects::effect_arg_string(argv, 0)`. See effect_user_handler_d5_spec
## for argc/argv contract details.

effect Throws
  def throw(msg: String): Int = resume(0)
end
