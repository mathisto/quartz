##! CSV Parser and Writer
##!
##! RFC 4180-compliant CSV parser and writer for Quartz.
##! Supports quoted fields, escaped quotes, and newlines in fields.
##!
##! @since 6.0.0

import * from error

# ============================================================================
# Data Types
# ============================================================================

## A single CSV row (vector of field strings).
struct CsvRow
  fields: Vec<String>
end

## A complete CSV document (optional headers + rows).
struct CsvDocument
  headers: Vec<String>
  rows: Vec<CsvRow>
  has_headers: Bool
end

# ============================================================================
# Constructors
# ============================================================================

## Creates an empty CSV row.
def csv_row_new(): CsvRow
  return CsvRow { fields: vec_new<String>() }
end

## Creates a CSV row from a vector of strings.
def csv_row_from_vec(fields: Vec<String>): CsvRow
  return CsvRow { fields: fields }
end

## Creates an empty CSV document with no headers.
def csv_document_new(): CsvDocument
  return CsvDocument { headers: vec_new<String>(), rows: vec_new<CsvRow>(), has_headers: false }
end

## Creates a CSV document with headers.
def csv_document_with_headers(headers: Vec<String>): CsvDocument
  return CsvDocument { headers: headers, rows: vec_new<CsvRow>(), has_headers: true }
end

# ============================================================================
# Row Operations
# ============================================================================

## Returns the number of fields in a row.
def csv_row_len(row: CsvRow): Int
  return vec_size(row.fields)
end

## Gets a field by index.
def csv_row_get(row: CsvRow, idx: Int): String
  if idx < 0 or idx >= vec_size(row.fields)
    return ""
  end
  return vec_get(row.fields, idx)
end

## Adds a field to the end of a row.
def csv_row_push(row: CsvRow, field: String): Void
  vec_push(row.fields, field)
end

# ============================================================================
# Document Operations
# ============================================================================

## Adds a row to the document.
def csv_document_add_row(doc: CsvDocument, row: CsvRow): Void
  vec_push(doc.rows, row)
end

## Returns the number of data rows.
def csv_document_row_count(doc: CsvDocument): Int
  return vec_size(doc.rows)
end

## Gets a row by index.
def csv_document_get_row(doc: CsvDocument, idx: Int): CsvRow
  if idx < 0 or idx >= vec_size(doc.rows)
    return csv_row_new()
  end
  return vec_get(doc.rows, idx)
end

## Gets a field by row index and column name (requires headers).
def csv_document_get_field(doc: CsvDocument, row_idx: Int, col_name: String): String
  if not doc.has_headers
    return ""
  end
  var col_idx = -1
  var i = 0
  while i < vec_size(doc.headers)
    if str_eq(vec_get(doc.headers, i), col_name)
      col_idx = i
    end
    i = i + 1
  end
  if col_idx < 0
    return ""
  end
  var row = csv_document_get_row(doc, row_idx)
  return csv_row_get(row, col_idx)
end

# ============================================================================
# Parser
# ============================================================================

struct CsvParser
  source: String
  pos: Int
  line: Int
  column: Int
end

def csv_parser_new(source: String): CsvParser
  return CsvParser { source: source, pos: 0, line: 1, column: 1 }
end

def csv_parser_at_end(p: CsvParser): Bool
  return p.pos >= str_byte_len(p.source)
end

def csv_parser_peek(p: CsvParser): Int
  if csv_parser_at_end(p)
    return 0
  end
  return str_byte_at(p.source, p.pos)
end

def csv_parser_advance(p: CsvParser): Int
  if csv_parser_at_end(p)
    return 0
  end
  var c = str_byte_at(p.source, p.pos)
  p.pos = p.pos + 1
  if c == '\n'
    p.line = p.line + 1
    p.column = 1
  else
    p.column = p.column + 1
  end
  return c
end

## Parses a quoted field (handles escaped quotes "").
def csv_parse_quoted_field(p: CsvParser): String
  csv_parser_advance(p)  # skip opening quote
  var result = ""

  while not csv_parser_at_end(p)
    var c = csv_parser_peek(p)
    if c == '"'  # '"'
      csv_parser_advance(p)
      # Check for escaped quote ""
      if not csv_parser_at_end(p) and csv_parser_peek(p) == '"'
        result = "#{result}\""
        csv_parser_advance(p)
      else
        # End of quoted field
        return result
      end
    else
      result = "#{result}#{str_from_char(csv_parser_advance(p))}"
    end
  end

  return result
end

## Parses an unquoted field.
def csv_parse_unquoted_field(p: CsvParser): String
  var result = ""

  while not csv_parser_at_end(p)
    var c = csv_parser_peek(p)
    if c == ',' or c == '\n' or c == '\r'  # ',' or '\n' or '\r'
      return result
    end
    result = "#{result}#{str_from_char(csv_parser_advance(p))}"
  end

  return result
end

## Parses a single row (one line of CSV).
def csv_parse_row(p: CsvParser): CsvRow
  var row = csv_row_new()

  # Handle empty trailing line
  if csv_parser_at_end(p)
    return row
  end

  while true
    var c = csv_parser_peek(p)
    if c == '"'  # '"' - quoted field
      csv_row_push(row, csv_parse_quoted_field(p))
    else
      csv_row_push(row, csv_parse_unquoted_field(p))
    end

    if csv_parser_at_end(p)
      return row
    end

    c = csv_parser_peek(p)
    if c == ','  # ','
      csv_parser_advance(p)
    elsif c == '\r'  # '\r'
      csv_parser_advance(p)
      if not csv_parser_at_end(p) and csv_parser_peek(p) == '\n'
        csv_parser_advance(p)
      end
      return row
    elsif c == '\n'  # '\n'
      csv_parser_advance(p)
      return row
    else
      return row
    end
  end

  return row
end

## Parses a complete CSV string into a CsvDocument.
## The first row is treated as headers.
def csv_parse(source: String): Result<CsvDocument, ParseError>
  if str_byte_len(source) == 0
    return Result::Ok(csv_document_new())
  end

  var p = csv_parser_new(source)

  # Parse header row
  var header_row = csv_parse_row(p)
  var doc = csv_document_with_headers(header_row.fields)

  # Parse data rows
  while not csv_parser_at_end(p)
    # Skip trailing newlines
    if csv_parser_peek(p) == '\n'
      csv_parser_advance(p)
    elsif csv_parser_peek(p) == '\r'
      csv_parser_advance(p)
      if not csv_parser_at_end(p) and csv_parser_peek(p) == '\n'
        csv_parser_advance(p)
      end
    else
      var row = csv_parse_row(p)
      if csv_row_len(row) > 0
        csv_document_add_row(doc, row)
      end
    end
  end

  return Result::Ok(doc)
end

## Parses CSV without treating the first row as headers.
def csv_parse_no_headers(source: String): Result<CsvDocument, ParseError>
  if str_byte_len(source) == 0
    return Result::Ok(csv_document_new())
  end

  var p = csv_parser_new(source)
  var doc = csv_document_new()

  while not csv_parser_at_end(p)
    if csv_parser_peek(p) == '\n'
      csv_parser_advance(p)
    elsif csv_parser_peek(p) == '\r'
      csv_parser_advance(p)
      if not csv_parser_at_end(p) and csv_parser_peek(p) == '\n'
        csv_parser_advance(p)
      end
    else
      var row = csv_parse_row(p)
      if csv_row_len(row) > 0
        csv_document_add_row(doc, row)
      end
    end
  end

  return Result::Ok(doc)
end

# ============================================================================
# Writer
# ============================================================================

## Checks if a field needs quoting.
def csv_needs_quoting(field: String): Bool
  var i = 0
  var len = str_byte_len(field)
  while i < len
    var c = str_byte_at(field, i)
    if c == ',' or c == '"' or c == '\n' or c == '\r'  # , " \n \r
      return true
    end
    i = i + 1
  end
  return false
end

## Escapes a field for CSV output (quotes if needed).
def csv_escape_field(field: String): String
  if not csv_needs_quoting(field)
    return field
  end

  var result = "\""
  var i = 0
  var len = str_byte_len(field)
  while i < len
    var c = str_byte_at(field, i)
    if c == '"'  # '"' → ""
      result = "#{result}\"\""
    else
      result = "#{result}#{str_from_char(c)}"
    end
    i = i + 1
  end
  result = "#{result}\""
  return result
end

## Stringifies a single row.
def csv_stringify_row(row: CsvRow): String
  var result = ""
  var i = 0
  var len = csv_row_len(row)

  while i < len
    if i > 0
      result = "#{result},"
    end
    result = "#{result}#{csv_escape_field(csv_row_get(row, i))}"
    i = i + 1
  end

  return result
end

## Stringifies a complete CSV document.
def csv_stringify(doc: CsvDocument): String
  var result = ""

  # Write headers if present
  if doc.has_headers and vec_size(doc.headers) > 0
    var header_row = csv_row_from_vec(doc.headers)
    result = "#{result}#{csv_stringify_row(header_row)}"
    result = "#{result}\n"
  end

  # Write data rows
  var i = 0
  while i < csv_document_row_count(doc)
    var row = csv_document_get_row(doc, i)
    result = "#{result}#{csv_stringify_row(row)}"
    result = "#{result}\n"
    i = i + 1
  end

  return result
end

# ============================================================================
# UFCS Extend Blocks
# ============================================================================

extend CsvRow
  def len(): Int
    return csv_row_len(self)
  end

  def get(idx: Int): String
    return csv_row_get(self, idx)
  end

  def push(field: String): Void
    csv_row_push(self, field)
  end
end

extend CsvDocument
  def row_count(): Int
    return csv_document_row_count(self)
  end

  def get_row(idx: Int): CsvRow
    return csv_document_get_row(self, idx)
  end

  def add_row(row: CsvRow): Void
    csv_document_add_row(self, row)
  end

  def get_field(row_idx: Int, col_name: String): String
    return csv_document_get_field(self, row_idx, col_name)
  end
end
