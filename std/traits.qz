## Standard Traits Library
##
## Core traits for common operations:
## - Eq: Equality comparison
## - Ord: Ordering comparison
## - Hash: Hash code generation
## - Show: String representation

## Equality comparison trait
## Types implementing Eq can be compared for equality.
## Method names match operator dispatch: op_eq enables ==, op_ne enables !=
trait Eq
  def op_eq(self, other: Self): Bool

  def op_ne(self, other: Self): Bool
    return not op_eq(self, other)
  end
end

## Ordering comparison trait
## Types implementing Ord can be compared for less than, greater than, etc.
## All defaults derived purely from op_lt — no Eq dependency.
trait Ord
  def op_lt(self, other: Self): Bool

  def op_le(self, other: Self): Bool
    return not op_lt(other, self)
  end

  def op_gt(self, other: Self): Bool
    return op_lt(other, self)
  end

  def op_ge(self, other: Self): Bool
    return not op_lt(self, other)
  end
end

## Arithmetic operator traits
## Each trait's method name matches operator dispatch (op_add enables +, etc.)

trait Add
  def op_add(self, other: Self): Self
end

trait Sub
  def op_sub(self, other: Self): Self
end

trait Mul
  def op_mul(self, other: Self): Self
end

trait Div
  def op_div(self, other: Self): Self
end

trait Mod
  def op_mod(self, other: Self): Self
end

## Index trait — enables obj[key] via op_index
trait Index
  def op_index(self, key: Int): Int
end

## Hash code generation trait
## Types implementing Hash can produce a hash code for use in hash maps
trait Hash
  def hash(self): Int
end

## String representation trait
## Types implementing Show can be converted to a display string
trait Show
  def show(self): String
    return "<unknown>"
  end
end

## Clone trait for value copying
## Types implementing Clone can produce an independent copy
trait Clone
  def clone(self): Self
    return self
  end
end

## Serializable trait for JSON conversion
## Types implementing Serializable can be converted to a JsonValue.
## Use manual `impl Serializable for T` — @derive(Serialize) is deferred
## until the compiler supports field-name emission.
trait Serializable
  def to_json(self): Int
end

## Drop trait for RAII cleanup
## Types implementing Drop have their drop() method called automatically
## when they go out of scope. The compiler inserts drop calls at:
## - End of block/scope
## - Before return statements
## - On break/continue in loops
## - On early return via ? operator
## Drop calls are made in LIFO order (reverse of construction).
trait Drop
  def drop(self): Void
end

## Iterator trait — the core iteration protocol.
## Types implementing Iterator<T> produce a sequence of T values.
## next() returns Option::Some(value) for each element, Option::None when exhausted.
trait Iterator<T>
  def next(self): Option<T>
    return Option::None
  end
end

## AsyncIterator trait — the async iteration protocol.
## Types implementing AsyncIterator<T> produce values that may require suspension.
## Used with `for await x in source` where source is an async generator or stream.
## The $next$poll function returns POLL_READY (1) with Option in frame[1],
## or yields (0) / I/O suspends (-(fd+2)) when the next value isn't ready yet.
trait AsyncIterator<T>
  def next(self): Option<T>
    return Option::None
  end
end

## Iterable trait — types that can produce an iterator.
##
## Types implementing Iterable<T> can produce a fresh iterator over T values.
## The iterator type is opaque at the trait level (`impl Iterator<T>`) but
## concrete at each impl site, enabling method dispatch through the concrete
## type without runtime boxing.
##
## Auto-satisfaction: collections that already define an inherent
## `def iter(): ConcreteIter` whose return type implements `Iterator<T>` can
## be marked Iterable with an empty impl block:
##
##   impl Iterable<Int> for Stack end
trait Iterable<T>
  def iter(self): impl Iterator<T>
end

## Container trait — common interface for sized collections.
## Types implementing Container have size, is_empty, and clear.
## Inherent impl methods auto-satisfy the trait — empty impl blocks are idiomatic:
##   impl Container for Queue end
trait Container
  def size(self): Int
  def is_empty(self): Bool = self.size() == 0
  def clear(self): Void
end

# ============================================================================
# Primitive Type Trait Implementations
# ============================================================================

## String equality via str_eq builtin
extend String with Eq
  def op_eq(self, other: Self): Bool = str_eq(self, other)
end
