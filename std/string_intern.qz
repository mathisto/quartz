##! # String Interner
##!
##! Deduplicates strings by mapping each unique string to an integer handle.
##! Interning the same string twice returns the same handle, so string
##! equality can be checked with integer comparison (O(1)) instead of
##! byte-by-byte `str_eq` (O(n)).
##!
##! ## Usage
##!
##! ```quartz
##! var interner = intern_new()
##! var id1 = intern(interner, "hello")
##! var id2 = intern(interner, "hello")
##! assert(id1 == id2)  # Same string → same ID
##! assert(intern_resolve(interner, id1) == "hello")
##! ```
##!
##! ## Design
##!
##! Uses a `Vec<String>` for O(1) id→string resolution and a
##! `Map<String, Int>` for O(1) amortized string→id dedup.
##! ID 0 is always the empty string "".
##!
##! Pre-interns common keywords and builtin type names at construction
##! time so they get stable, low-numbered IDs.
##!
##! @since 5.25.0

## An interned string identifier.
## ID 0 is always the empty string.
newtype InternId = Int

## The string interner. Holds unique strings and a dedup lookup table.
struct StringInterner
  strings: Vec<String>
  lookup: Map<String, Int>
end

## Creates a new string interner pre-loaded with common symbols.
##
## Pre-interns the empty string at ID 0, followed by all Quartz keywords
## and builtin type names. This gives them stable, low-numbered IDs
## and avoids Map lookups for the most common strings during lexing.
##
## @returns A new StringInterner ready for use
def intern_new(): StringInterner
  var interner = StringInterner {
    strings: vec_new<String>(),
    lookup: map_new<String, Int>()
  }
  # ID 0 = empty string (sentinel)
  intern(interner, "")

  # Keywords (27)
  intern(interner, "def")
  intern(interner, "end")
  intern(interner, "if")
  intern(interner, "else")
  intern(interner, "elsif")
  intern(interner, "while")
  intern(interner, "for")
  intern(interner, "in")
  intern(interner, "return")
  intern(interner, "var")
  intern(interner, "struct")
  intern(interner, "enum")
  intern(interner, "match")
  intern(interner, "import")
  intern(interner, "from")
  intern(interner, "true")
  intern(interner, "false")
  intern(interner, "nil")
  intern(interner, "and")
  intern(interner, "or")
  intern(interner, "not")
  intern(interner, "do")
  intern(interner, "unless")
  intern(interner, "break")
  intern(interner, "continue")
  intern(interner, "trait")
  intern(interner, "impl")

  # Builtin types (19)
  intern(interner, "Int")
  intern(interner, "String")
  intern(interner, "Bool")
  intern(interner, "Void")
  intern(interner, "Float")
  intern(interner, "F32")
  intern(interner, "F64")
  intern(interner, "U8")
  intern(interner, "I8")
  intern(interner, "U16")
  intern(interner, "I16")
  intern(interner, "U32")
  intern(interner, "I32")
  intern(interner, "Vec")
  intern(interner, "Map")
  intern(interner, "Option")
  intern(interner, "Result")
  intern(interner, "Fn")
  intern(interner, "Nil")

  # Common identifiers (8)
  intern(interner, "self")
  intern(interner, "main")
  intern(interner, "size")
  intern(interner, "push")
  intern(interner, "get")
  intern(interner, "set")
  intern(interner, "new")
  intern(interner, "to_s")

  return interner
end

## Interns a string, returning its unique integer handle.
##
## If the string has been interned before, returns the existing handle.
## Otherwise, stores the string and returns a new handle.
## O(1) amortized via Map lookup.
##
## @param interner The string interner
## @param s The string to intern
## @returns InternId handle for the string
def intern(interner: StringInterner, s: String): InternId
  var existing = __map_get_raw(interner.lookup, s)
  if existing > 0
    return existing
  end
  # Special case: ID 0 is always "", check if s is "" and we already have it
  if interner.strings.size > 0 and s == ""
    return 0
  end
  var id = interner.strings.size
  interner.strings.push(s)
  map_set(interner.lookup, s, id)
  return id
end

## Resolves an interned handle back to its string value.
##
## O(1) via Vec index lookup.
##
## @param interner The string interner
## @param id The InternId to resolve
## @returns The original string
def intern_resolve(interner: StringInterner, id: InternId): String = interner.strings[id]

## Checks if two InternIds refer to the same string.
##
## O(1) integer comparison — the whole point of interning.
##
## @param a First InternId
## @param b Second InternId
## @returns 1 if equal, 0 if not
def intern_eq(a: InternId, b: InternId): Int
  if a == b
    return 1
  end
  return 0
end

## Interns a string, returning a plain Int handle (no newtype).
##
## Use this when storing intern IDs in untyped or Int-typed vectors
## to avoid InternId newtype friction.
##
## @param interner The string interner
## @param s The string to intern
## @returns Plain Int handle for the string
def intern_id(interner: StringInterner, s: String): Int = intern(interner, s) + 0

## Resolves a plain Int handle back to its string value.
##
## Companion to `intern_id` — takes Int instead of InternId.
##
## @param interner The string interner
## @param id The plain Int handle
## @returns The original string
def intern_resolve_int(interner: StringInterner, id: Int): String = interner.strings[id]

## Reconstructs an interner from a saved string table.
##
## The strings vector is used directly (IDs = indices).
## The lookup Map is rebuilt from the strings.
## Used by the build cache to restore interned AST data.
##
## @param strings Previously saved interner string table
## @returns A fully functional StringInterner with the same ID mapping
def intern_from_strings(strings: Vec<String>): StringInterner
  var interner = StringInterner {
    strings: strings,
    lookup: map_new<String, Int>()
  }
  for i in 0..strings.size
    map_set(interner.lookup, strings[i], i)
  end
  return interner
end

## Returns the interner's string table for serialization.
##
## @param interner The string interner
## @returns The underlying Vec<String> of all interned strings
def intern_get_strings(interner: StringInterner): Vec<String> = interner.strings

## Returns the number of unique strings in the interner.
##
## @param interner The string interner
## @returns Count of interned strings
def intern_count(interner: StringInterner): Int = interner.strings.size

# ============================================================================
# Global Shared Interner — singleton per compilation session
# ============================================================================

# Optional-singleton holder: empty = uninitialized, one element = the live interner.
# Holds the StringInterner struct DIRECTLY (no as_int erasure), so it survives the
# F4 value-layout flip. Mirrors the `Vec<TypecheckState>`-as-singleton idiom used by
# the tc diag/ctx globals (module-level `Option::None` init is unsupported).
var _g_interner: Vec<StringInterner> = vec_new<StringInterner>()

## Returns the global shared string interner.
##
## Lazy-initialized on first call. All AstStorage instances share this
## interner so that intern IDs are consistent across modules within a
## single compilation session.
def intern_global(): StringInterner
  if _g_interner.size == 0
    _g_interner.push(intern_new())
  end
  return _g_interner[0]
end

## Resets the global interner to a fresh state.
##
## For test isolation or future library usage.
def intern_global_reset(): Void
  if _g_interner.size == 0
    _g_interner.push(intern_new())
  else
    _g_interner[0] = intern_new()
  end
end

# ============================================================================
# Mangled Name Cache — disabled
# ============================================================================
#
# Both `mangle` and `mangle_int` were prime candidates for caching: each
# call returns a small interned-style string ("Foo$bar" / "Foo$42") that
# many call sites construct repeatedly during a self-compile.
#
# Two distinct attempts have been made:
#
# 1. **Pointer-cache (April 2026, reverted)** — cache stored
#    `as_int(result)` in `_mangle_cache`, retrieved via `as_string(cached)`.
#    Use-after-free: the underlying string was relocated/freed between the
#    cache write and the read, returning a stale pointer that crashed in
#    `qz_str_hash`. Root cause of the Bootstrap Island incident.
#
# 2. **Intern-id cache (2026-04-27, this file)** — cache stored intern-id
#    of result in `Map<Int, Int>` keyed by packed `(prefix_id, suffix_id)`,
#    retrieved via `intern_resolve_int`. UAF impossible because intern ids
#    are stable Vec indices that live for the compiler's lifetime.
#    **Measurement (post-D.1 arena, 2026-04-27)**: peak RSS dropped 21 MB
#    (2315→2294 MB, 0.9%) but wall time regressed 6.7s (57.0→63.7s, +12%).
#    Net loss. The Phase 2-era prediction of ~2 GB recovery is stale: D.1's
#    cg_arena dogfooding has already absorbed most of the duplicate-
#    allocation cost the cache would have eliminated. Per-call overhead
#    (2× `intern_id` lookups + `__map_get_raw` + conditional `intern_resolve`
#    + `map_set` on miss) exceeds the dedup savings at current allocator
#    state.
#
# Cache prerequisites that DO ship even with caching disabled:
#   - `intmap_get_sentinel` codegen (`bee41c14`) — sentinel-returning
#     int-key map probe, parallel to `__hashmap_get_sentinel`. Useful for
#     any future Int-keyed dedup cache.
#   - `intmap_set` resize path (`dc2ebfc3`) — closes the no-resize footgun
#     that hung at insert #17. Benefits any user of `Map<Int, V>`.
#
# Don't reintroduce the cache without first re-measuring against the
# current allocator. If duplicate-string allocation ever shows up in a
# profile again, the cache shape from attempt 2 (intern-id storage,
# packed-int keys) is the correct shape — the issue isn't the design,
# it's that D.1 made the underlying problem too small to be worth caching.

def mangle(prefix: String, suffix: String): String = "#{prefix}$#{suffix}"

def mangle_int(prefix: String, n: Int): String = "#{prefix}$#{n}"

