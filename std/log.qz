## std/log — algebraic effect-based logging.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D.7 pilot.
##
## Declares the `Log` effect plus three severity wrappers (info, warn,
## error) that prefix `[INFO] `, `[WARN] `, `[ERROR] ` to the message
## before dispatching through `emit`. `Log` is in the runtime's blessed
## default set — programs that don't install a custom `with Log { emit:
## my_fn } do ... end` handler fall back to writing the message + newline
## to stderr and continue execution (non-fatal).
##
## Usage:
##   import std/log
##
##   def main(): Int
##     log::info("starting up")       # dispatches via default handler
##
##     with Log { emit: my_capture } do ->
##       log::warn("recoverable")     # dispatches via my_capture
##     end
##     return 0
##   end
##
## Handler signature: `def my_capture(op_name: Int, argc: Int, argv: Int): Int`.
## Decode the message via `as_string(load(argv, 0))` — or, using the
## std/effects helpers, `effects::effect_arg_string(argv, 0)`. See
## `effect_multi_arg_e_spec.qz` for the argc/argv ABI contract.

effect Log
  def emit(s: String): Int
end

## Log an informational message. Prefix: "[INFO] ".
def info(msg: String): Int can Log
  var prefixed = "[INFO] "
  prefixed = prefixed + msg
  return emit(prefixed)
end

## Log a warning. Prefix: "[WARN] ".
def warn(msg: String): Int can Log
  var prefixed = "[WARN] "
  prefixed = prefixed + msg
  return emit(prefixed)
end

## Log an error. Prefix: "[ERROR] ". Non-fatal — does not throw.
## (Use the Throws effect for errors that should terminate the program.)
def error(msg: String): Int can Log
  var prefixed = "[ERROR] "
  prefixed = prefixed + msg
  return emit(prefixed)
end

## Log a raw message without a severity prefix. Useful when the caller
## has already formatted the line (e.g., structured log emitters).
def raw(msg: String): Int can Log = emit(msg)
