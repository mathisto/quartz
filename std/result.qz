# Result<T, E> - Represents success or failure
#
# Result is a type that represents either a successful value (Ok) or
# an error (Err). It is used for operations that can fail, providing
# a type-safe way to handle errors without exceptions.
#
# Example:
#   res = Result::Ok(42)
#   match res
#     Result::Ok(v) => print(v)
#     Result::Err(e) => print("error: " + e)
#   end

enum Result<T, E>
  Ok(value: T)
  Err(error: E)
end

# Returns true if the Result is Ok.
def is_ok<T, E>(res: Result<T, E>): Bool
  match res
    Result::Ok(x) => true
    Result::Err(x) => false
  end
end

# Returns true if the Result is Err.
def is_err<T, E>(res: Result<T, E>): Bool
  match res
    Result::Ok(x) => false
    Result::Err(x) => true
  end
end

# Note: Functions that convert to Option<T> require module-qualified
# generic types in return position, which is not yet supported.
# Use pattern matching directly:
#
#   match res
#     Result::Ok(v) => Option::Some(v)
#     Result::Err(x) => Option::None
#   end
#
# Functions like unwrap, map, map_err, and_then require:
# 1. Never/Bottom type for panic (divergent functions)
# 2. Generic type inference improvements
