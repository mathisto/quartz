## Unicode String Support
##
## Zero-allocation codepoint iteration, char indices, and
## Unicode-aware string operations.
##
## Existing intrinsics (always available):
##   Byte-level:
##     str_byte_at(s, byte_idx)         — byte at byte index
##     str_byte_len(s)                  — total bytes
##     str_byte_slice(s, start, end)    — byte slice
##   Codepoint-level (byte-offset, sequential walking):
##     str_codepoint_at(s, byte_idx)    — decode codepoint at byte (O(1))
##     str_codepoint_byte_len(s, idx)   — UTF-8 stride 1/2/3/4 (O(1))
##   Codepoint-level (ordinal, prefer byte-offset for walking):
##     str_codepoint_nth(s, cp_idx)     — n-th codepoint (O(n) walk)
##     str_size(s)                      — total codepoints (O(n))
##   Construction:
##     str_from_codepoint(cp)           — codepoint → 1..4-byte string
##     sb_new / sb_append / sb_append_char
##
## This module builds on those foundations for full Unicode support.

import traits

## ---------------------------------------------------------------------------
## CodepointIter — lazy, zero-allocation UTF-8 codepoint iteration
## ---------------------------------------------------------------------------

struct CodepointIter
  s: String
  pos: Int
  len: Int
end

extend CodepointIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.pos >= self.len
      return Option::None
    end
    var b0 = str_byte_at(self.s, self.pos)
    ## 1-byte: 0xxxxxxx
    if b0 < 128
      self.pos = self.pos + 1
      return Option::Some(b0)
    end
    ## 2-byte: 110xxxxx 10xxxxxx
    if b0 < 224
      var cp = ((b0 & 0x1F) << 6) | (str_byte_at(self.s, self.pos + 1) & 0x3F)
      self.pos = self.pos + 2
      return Option::Some(cp)
    end
    ## 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
    if b0 < 240
      var cp = ((b0 & 0x0F) << 12) | ((str_byte_at(self.s, self.pos + 1) & 0x3F) << 6) | (str_byte_at(self.s, self.pos + 2) & 0x3F)
      self.pos = self.pos + 3
      return Option::Some(cp)
    end
    ## 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    var cp = ((b0 & 0x07) << 18) | ((str_byte_at(self.s, self.pos + 1) & 0x3F) << 12) | ((str_byte_at(self.s, self.pos + 2) & 0x3F) << 6) | (str_byte_at(self.s, self.pos + 3) & 0x3F)
    self.pos = self.pos + 4
    return Option::Some(cp)
  end
end

def str_codepoints(s: String): CodepointIter
  return CodepointIter { s: s, pos: 0, len: str_byte_len(s) }
end

## ---------------------------------------------------------------------------
## CharIndexIter — yields packed (byte_offset << 21) | codepoint
## ---------------------------------------------------------------------------

struct CharIndexIter
  s: String
  pos: Int
  len: Int
end

extend CharIndexIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.pos >= self.len
      return Option::None
    end
    var start = self.pos
    var b0 = str_byte_at(self.s, self.pos)
    ## 1-byte
    if b0 < 128
      self.pos = self.pos + 1
      return Option::Some((start << 21) | b0)
    end
    ## 2-byte
    if b0 < 224
      var cp = ((b0 & 0x1F) << 6) | (str_byte_at(self.s, self.pos + 1) & 0x3F)
      self.pos = self.pos + 2
      return Option::Some((start << 21) | cp)
    end
    ## 3-byte
    if b0 < 240
      var cp = ((b0 & 0x0F) << 12) | ((str_byte_at(self.s, self.pos + 1) & 0x3F) << 6) | (str_byte_at(self.s, self.pos + 2) & 0x3F)
      self.pos = self.pos + 3
      return Option::Some((start << 21) | cp)
    end
    ## 4-byte
    var cp = ((b0 & 0x07) << 18) | ((str_byte_at(self.s, self.pos + 1) & 0x3F) << 12) | ((str_byte_at(self.s, self.pos + 2) & 0x3F) << 6) | (str_byte_at(self.s, self.pos + 3) & 0x3F)
    self.pos = self.pos + 4
    return Option::Some((start << 21) | cp)
  end
end

def str_char_indices(s: String): CharIndexIter
  return CharIndexIter { s: s, pos: 0, len: str_byte_len(s) }
end

## Accessors for packed char-index values.
def char_index_offset(pair: Int): Int = pair >> 21
def char_index_codepoint(pair: Int): Int = pair & 0x1FFFFF

## ---------------------------------------------------------------------------
## Unicode Case Conversion
## ---------------------------------------------------------------------------

import * from unicode/tables
import * from unicode/case_data
import * from unicode/category_data
import * from unicode/width

## Convert a single codepoint to uppercase (simple 1:1 mapping).
## Returns the codepoint unchanged if no mapping exists.
def unicode_uppercase(cp: Int): Int
  return unicode_mapping_lookup(uc_upper_keys(), uc_upper_vals(), cp)
end

## Convert a single codepoint to lowercase (simple 1:1 mapping).
def unicode_lowercase(cp: Int): Int
  return unicode_mapping_lookup(uc_lower_keys(), uc_lower_vals(), cp)
end

## Case-fold a single codepoint (for case-insensitive comparison).
def unicode_casefold(cp: Int): Int
  return unicode_mapping_lookup(uc_fold_keys(), uc_fold_vals(), cp)
end

## Convert a string to uppercase (full mapping including 1-to-many).
## "straße" → "STRASSE", "café" → "CAFÉ"
def unicode_to_upper(s: String): String
  var sb = sb_new()
  var special_keys = uc_special_upper_keys()
  var special_vals = uc_special_upper_vals()
  var special_lens = uc_special_upper_lens()
  for cp in str_codepoints(s)
    ## Check for special 1-to-many mapping first
    var si = _binary_search_index(special_keys, cp)
    if si >= 0
      var packed = vec_get(special_vals, si)
      var n = vec_get(special_lens, si)
      var cp1 = (packed >> 42) & 0x1FFFFF
      var cp2 = (packed >> 21) & 0x1FFFFF
      var cp3 = packed & 0x1FFFFF
      sb_append(sb, str_from_codepoint(cp1))
      if n >= 2
        sb_append(sb, str_from_codepoint(cp2))
      end
      if n >= 3
        sb_append(sb, str_from_codepoint(cp3))
      end
    else
      sb_append(sb, str_from_codepoint(unicode_uppercase(cp)))
    end
  end
  return sb_to_string(sb)
end

## Convert a string to lowercase.
def unicode_to_lower(s: String): String
  var sb = sb_new()
  for cp in str_codepoints(s)
    sb_append(sb, str_from_codepoint(unicode_lowercase(cp)))
  end
  return sb_to_string(sb)
end

## Case-fold a string (for case-insensitive comparison).
def unicode_case_fold(s: String): String
  var sb = sb_new()
  for cp in str_codepoints(s)
    sb_append(sb, str_from_codepoint(unicode_casefold(cp)))
  end
  return sb_to_string(sb)
end

## Case-insensitive string comparison.
def unicode_eq_ignore_case(a: String, b: String): Bool
  return unicode_case_fold(a) == unicode_case_fold(b)
end

## ---------------------------------------------------------------------------
## Unicode Character Classification
## ---------------------------------------------------------------------------

def unicode_is_alphabetic(cp: Int): Bool
  return unicode_range_contains(uc_alphabetic_ranges(), cp)
end

def unicode_is_numeric(cp: Int): Bool
  return unicode_range_contains(uc_numeric_ranges(), cp)
end

def unicode_is_whitespace(cp: Int): Bool
  return unicode_range_contains(uc_whitespace_ranges(), cp)
end

def unicode_is_uppercase(cp: Int): Bool
  return unicode_range_contains(uc_uppercase_ranges(), cp)
end

def unicode_is_lowercase(cp: Int): Bool
  return unicode_range_contains(uc_lowercase_ranges(), cp)
end

def unicode_is_alphanumeric(cp: Int): Bool
  return unicode_is_alphabetic(cp) or unicode_is_numeric(cp)
end

## Visible cell width is provided by `std/unicode/width` and re-exported
## here for callers that already import all of `std/unicode`. Width-only
## consumers should `import std/unicode/width` directly to skip the
## case-folding tables.

## ---------------------------------------------------------------------------
## Internal helpers
## ---------------------------------------------------------------------------

## Binary search for exact key in sorted Vec. Returns index or -1.
def _binary_search_index(keys: Vec<Int>, target: Int): Int
  var lo = 0
  var hi = vec_size(keys) - 1
  while lo <= hi
    var mid = lo + (hi - lo) / 2
    var key = vec_get(keys, mid)
    if target < key
      hi = mid - 1
    else
      if target > key
        lo = mid + 1
      else
        return mid
      end
    end
  end
  return -1
end
