## std/selectable — Selectable trait (C.13 Phase 3)
##
## A Selectable is anything that can be raced inside a `select` block. The
## existing arm-keyword shapes (`recv`/`send`/`timeout`/`await`) are the
## C.13 Phase 2 parser de-sugar fast-path; this trait lets user-defined
## types participate via `case x = <Selectable expr> => body`.
##
## See `docs/design/SELECT_UNIFICATION.md` for the full design.
##
## Usage (Phase 5 ships the first impl — RecvSelectable):
##
##   var ch = channel_new(8)
##   go producer(ch)
##
##   select
##     case msg = recvable(ch) => process(msg)
##     case _   = deadline_ms(5000) => give_up()
##     default  => non_blocking_fallback()
##   end
##
## Trait contract:
##
##   try_poll(self) -> Option<R>
##     Non-destructive readiness check. Returns Some(payload) if ready
##     right now, None otherwise. MUST NOT consume the payload — that's
##     `complete`'s job. Channel recv: peek queue head; scope.cancelled():
##     observe cancel flag; deadline_ms: compare time_mono_ns to deadline.
##
##   register_waker(self, frame: Int) -> Void
##     Install a wake notification. When the resource becomes ready, the
##     impl MUST call sched_wake(frame). Idempotent. Currently unused by
##     the Phase 4a chunked-poll dispatcher; Phase 4b will switch the
##     polling loop to register-park-unregister to drop wake latency.
##
##   unregister_waker(self, frame: Int) -> Void
##     Tear down a register_waker. Always called when select abandons a
##     branch (winner won, or select itself cancelled). Idempotent.
##
##   complete(self) -> R
##     Consume the payload now that this branch has won. Channel recv:
##     pop from queue; channel send: push value; future: mark awaited;
##     scope.cancelled(): throw via Throws (control never returns).
##     Runtime guarantees this is called only after a successful
##     try_poll.
##
## R erasure: per existential-types policy, `Selectable<R>` is
## `Selectable<Int>` at runtime. Surface types may write `Selectable<T>`
## but the impl block hardcodes `Int` (mirrors `Iterator<Int>` in
## std/iter.qz, `Scoped` in std/scoped.qz).

trait Selectable<R>
  ## Non-destructive readiness check. Some(payload) when ready, None
  ## otherwise. MUST NOT consume — that's `complete`'s job.
  def try_poll(self): Option<R>

  ## Install a wake notification. When ready, impl MUST sched_wake(frame).
  ## Idempotent.
  def register_waker(self, frame: Int): Void

  ## Tear down a register_waker. Always called on branch abandonment.
  ## Idempotent.
  def unregister_waker(self, frame: Int): Void

  ## Consume the payload now that this branch has won. Called only
  ## after a successful try_poll.
  def complete(self): R
end
