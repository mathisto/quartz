##! Content Hashing — FNV-1a based content addressing for incremental compilation
##!
##! Provides deterministic content hashing for cache key computation.
##! Uses FNV-1a (64-bit variant) — fast, good distribution, pure Quartz.
##!
##! The hash is returned as a 16-character hex string for use as
##! cache keys and file names.
##!
##! Usage:
##!   import shared/content_hash
##!   var h = content_hash("file contents here")
##!   var combined = content_hash_combine(vec_of_hashes)



## FNV-1a 64-bit offset basis.
## The actual value is 14695981039346656037 but we use the
## signed i64 representation: -3750763034362895579
var FNV_OFFSET_BASIS = 0 - 3750763034362895579

## FNV-1a 64-bit prime: 1099511628211
var FNV_PRIME = 1099511628211

## Compute a 64-bit FNV-1a hash of a string, returned as a 16-char hex string.
##
## FNV-1a is a non-cryptographic hash with excellent avalanche properties.
## For content addressing (cache keys), collision resistance is sufficient —
## we're not defending against adversaries, just detecting changes.
def content_hash(data: String): String
  var hash = FNV_OFFSET_BASIS
  var len = str_byte_len(data)
  for i in 0..len
    var byte = str_byte_at(data, i)
    # XOR the byte into the hash, then multiply by the FNV prime
    hash = hash ^ byte
    hash *= FNV_PRIME
  end
  return _hash_to_hex(hash)
end

## Compute a content hash for a file by reading its contents.
## Returns empty string if the file cannot be read.
def content_hash_file(path: String): String
  if not file_exists(path)
    return ""
  end
  var data = read_file(path)
  return content_hash(data)
end

## Combine multiple hash strings into a single hash.
## Used for computing cache keys that depend on multiple inputs
## (e.g., source hash + dependency interface hashes + compiler flags).
def content_hash_combine(hashes: Vec<String>): String
  var combined = ""
  for i in 0..hashes.size
    combined = "#{combined}#{hashes[i]}"
  end
  return content_hash(combined)
end

## Compute a hash for a list of key-value pairs.
## Useful for hashing compiler flags and configuration.
## Keys and values are separated by "=" and pairs by newlines.
def content_hash_pairs(keys: Vec<String>, values: Vec<String>): String
  var combined = ""
  for i in 0..keys.size
    combined = "#{combined}#{keys[i]}"
    combined = "#{combined}="
    if i < values.size
      combined = "#{combined}#{values[i]}"
    end
    combined = "#{combined}\n"
  end
  return content_hash(combined)
end

## Convert a 64-bit integer hash to a 16-character lowercase hex string.
## This is the canonical string representation used for cache keys.
def _hash_to_hex(hash: Int): String
  var hex_chars = "0123456789abcdef"
  var result = ""
  # Process 16 hex digits (64 bits / 4 bits per digit)
  for i in 0..16
    # Extract 4 bits at position (60 - i*4)
    var shift = 60 - (i * 4)
    var nibble = 0
    if shift >= 0
      # Unsigned right shift: divide by 2^shift, mask bottom 4 bits
      nibble = _unsigned_right_shift(hash, shift)
      nibble = nibble & 15
    end
    var hex_digit = str_byte_at(hex_chars, nibble)
    result = "#{result}#{_char_to_string(hex_digit)}"
  end
  return result
end

## Unsigned right shift — needed because Quartz Int is signed i64.
## For positive shift amounts, divides by 2^shift and masks.
def _unsigned_right_shift(value: Int, shift: Int): Int
  if shift == 0
    return value
  end
  if shift >= 64
    return 0
  end
  # For the topmost bit handling, we need to be careful with signed arithmetic.
  # Use the arithmetic right shift and mask off the sign-extended bits.
  var shifted = value
  for s in 0..shift
    # Arithmetic right shift by 1: divide by 2 rounding toward negative infinity
    shifted /= 2
    # If original was negative and we shifted, the top bit got sign-extended.
    # We need to clear it: mask to (64-s-1) bits.
  end
  # Mask to keep only the bottom (64-shift) bits
  if shift < 63
    var mask = _pow2(64 - shift) - 1
    shifted = shifted & mask
  end
  return shifted
end

## Compute 2^n for small n (used for bit masking).
def _pow2(n: Int): Int
  if n <= 0
    return 1
  end
  if n >= 63
    # Overflow guard: 2^63 would overflow signed i64
    return 4611686018427387904  # 2^62, close enough for masking
  end
  var result = 1
  for i in 0..n
    result *= 2
  end
  return result
end

## Convert a char code (Int) to a single-character String.
def _char_to_string(code: Int): String
  # Use string slicing on a known string to extract single chars
  var all = "0123456789abcdef"
  if code >= '0' and code <= '9'
    # '0'-'9' → index 0-9
    return str_byte_slice(all, code - 48, code - 48 + 1)
  end
  if code >= 'a' and code <= 'f'
    # 'a'-'f' → index 10-15
    return str_byte_slice(all, code - 97 + 10, code - 97 + 11)
  end
  return "0"
end
