## Composable terminal styling API.
##
## Immutable Style struct with chainable builder methods and automatic
## color degradation based on terminal capabilities.
##
## Inspired by Lipgloss (Go) and Rich (Python).
##
## Usage:
##   import style
##   import terminal
##
##   s = Style.new().bold().fg(Red).render("error!")
##   s2 = Style.error().render("something went wrong")
##   s3 = Style.new().fg(rgb_color(255, 128, 0)).underline().render("orange")
##
## ## Tier A on Tier B (v0.6.7+)
##
## `Style.render(text)` is now a thin façade over the v0.6 cell engine.
## It builds a `Vec<Cell>` (Tier B's canonical primitive) via
## `cl::style_to_cells` and routes the SGR-byte emission through
## `cl::cells_render_inline`. Output is byte-identical to the
## pre-v0.6.7 implementation — every existing combined-SGR test
## (`\x1b[1;3;4;31m...m\x1b[0m`) still passes — but the implementation
## is now the same code path the rest of the cell engine uses.
##
## Color encoding (Int):
##   -1            → terminal default (sentinel)
##   0..15         → ANSI 16-color palette
##   16..255       → 256-color palette
##   ≥ 0x1000000   → packed truecolor; bits (R << 16) | (G << 8) | B
##
## The encoding is owned by `std/tui/cell.qz` (see `RGB_FLAG`,
## `color_is_rgb`, `color_r/g/b`). Style values pass straight through
## to Tier-B Channel constructors.
##
## @since 5.27.0

import std/terminal
import std/tui/cell as cl

# =============================================================================
# Color Constants — ANSI 16 palette
# =============================================================================

## No color set (sentinel).
def COLOR_NONE(): Int = -1

## ANSI basic 8 colors (foreground codes 30-37).
def Black(): Int = 0
def Red(): Int = 1
def Green(): Int = 2
def Yellow(): Int = 3
def Blue(): Int = 4
def Magenta(): Int = 5
def Cyan(): Int = 6
def White(): Int = 7

## ANSI bright 8 colors (foreground codes 90-97).
def BrightBlack(): Int = 8
def BrightRed(): Int = 9
def BrightGreen(): Int = 10
def BrightYellow(): Int = 11
def BrightBlue(): Int = 12
def BrightMagenta(): Int = 13
def BrightCyan(): Int = 14
def BrightWhite(): Int = 15

## Aliases.
def Gray(): Int = 8
def Grey(): Int = 8

# =============================================================================
# Color Constructors
# =============================================================================

## Create an RGB truecolor value. r, g, b each 0-255.
def rgb_color(r: Int, g: Int, b: Int): Int
  return cl::RGB_FLAG() | (r << 16) | (g << 8) | b
end

## Create a color from a 256-color palette index (0-255).
def ansi256_color(code: Int): Int = code

## Parse a hex color string like "#FF5500" or "FF5500".
def hex_color(hex: String): Int
  var start = 0
  if str_byte_len(hex) > 0 and str_byte_at(hex, 0) == '#'
    start = 1
  end
  var r = _hex_pair(hex, start)
  var g = _hex_pair(hex, start + 2)
  var b = _hex_pair(hex, start + 4)
  return rgb_color(r, g, b)
end

def _hex_digit(c: Int): Int
  if c >= '0' and c <= '9'
    return c - '0'
  end
  if c >= 'a' and c <= 'f'
    return c - 'a' + 10
  end
  if c >= 'A' and c <= 'F'
    return c - 'A' + 10
  end
  return 0
end

def _hex_pair(s: String, offset: Int): Int
  var hi = _hex_digit(str_byte_at(s, offset))
  var lo = _hex_digit(str_byte_at(s, offset + 1))
  return hi * 16 + lo
end

# =============================================================================
# Attribute Bitmask Constants
# =============================================================================

def _ATTR_BOLD(): Int = 1
def _ATTR_DIM(): Int = 2
def _ATTR_ITALIC(): Int = 4
def _ATTR_UNDERLINE(): Int = 8
def _ATTR_STRIKETHROUGH(): Int = 16
def _ATTR_INVERSE(): Int = 32

# =============================================================================
# Style Struct — Immutable Builder
# =============================================================================

struct Style
  _fg: Int
  _bg: Int
  _attrs: Int
end

## Create a new empty Style (no colors, no attributes).
def Style.new(): Style
  return Style { _fg: COLOR_NONE(), _bg: COLOR_NONE(), _attrs: 0 }
end

## Semantic presets.
def Style.error(): Style
  return Style { _fg: Red(), _bg: COLOR_NONE(), _attrs: _ATTR_BOLD() }
end

def Style.success(): Style
  return Style { _fg: Green(), _bg: COLOR_NONE(), _attrs: _ATTR_BOLD() }
end

def Style.warning(): Style
  return Style { _fg: Yellow(), _bg: COLOR_NONE(), _attrs: _ATTR_BOLD() }
end

def Style.info(): Style
  return Style { _fg: Blue(), _bg: COLOR_NONE(), _attrs: 0 }
end

def Style.muted(): Style
  return Style { _fg: BrightBlack(), _bg: COLOR_NONE(), _attrs: 0 }
end

def Style.heading(): Style
  return Style { _fg: Cyan(), _bg: COLOR_NONE(), _attrs: _ATTR_BOLD() | _ATTR_UNDERLINE() }
end

# =============================================================================
# Builder Methods — each returns a new Style (immutable)
# =============================================================================

extend Style
  ## Set foreground color. Accepts color constants, ansi256_color(), rgb_color(), hex_color().
  def fg(color: Int): Style
    return Style { _fg: color, _bg: @_bg, _attrs: @_attrs }
  end

  ## Set background color.
  def bg(color: Int): Style
    return Style { _fg: @_fg, _bg: color, _attrs: @_attrs }
  end

  ## Set foreground to RGB.
  def fg_rgb(r: Int, g: Int, b: Int): Style
    return Style { _fg: rgb_color(r, g, b), _bg: @_bg, _attrs: @_attrs }
  end

  ## Set background to RGB.
  def bg_rgb(r: Int, g: Int, b: Int): Style
    return Style { _fg: @_fg, _bg: rgb_color(r, g, b), _attrs: @_attrs }
  end

  ## Bold text.
  def bold(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_BOLD() }
  end

  ## Dim/faint text.
  def dim(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_DIM() }
  end

  ## Italic text.
  def italic(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_ITALIC() }
  end

  ## Underlined text.
  def underline(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_UNDERLINE() }
  end

  ## Strikethrough text.
  def strikethrough(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_STRIKETHROUGH() }
  end

  ## Inverse/reverse video.
  def inverse(): Style
    return Style { _fg: @_fg, _bg: @_bg, _attrs: @_attrs | _ATTR_INVERSE() }
  end

  ## Render text with this style applied.
  ## Automatically degrades colors based on term_color_depth().
  ## Returns plain text if colors are disabled (NO_COLOR, pipe, etc).
  def render(text: String): String
    var depth = terminal::term_color_depth()
    if depth == 0
      return text
    end
    return _style_render(self, text, depth)
  end

  ## Force-render with a specific color depth (for testing/overrides).
  ## depth: 0, 16, 256, or 16777216.
  def render_at(text: String, depth: Int): String
    if depth == 0
      return text
    end
    return _style_render(self, text, depth)
  end

  ## Check if this style has any visual effect.
  def is_empty(): Bool
    return @_fg == COLOR_NONE() and @_bg == COLOR_NONE() and @_attrs == 0
  end
end

# =============================================================================
# Rendering Engine — Tier A on Tier B
# =============================================================================
#
# `_style_render` builds a `Vec<Cell>` and routes through the canonical
# v0.6 cell engine emitter (`cl::cells_render_inline`). All
# color-encoding, degradation, and SGR-byte assembly lives in
# `std/tui/cell.qz`. This module owns only the surface API (the
# `Style` struct + builder methods) and the bridge into Tier B.

def _style_render(s: Style, text: String, depth: Int): String
  if s.is_empty()
    return text
  end
  var cells = cl::style_to_cells(text, s._fg, s._bg, s._attrs)
  return cl::cells_render_inline(cells, depth)
end

# =============================================================================
# ANSI Stripping
# =============================================================================

## Strip all ANSI escape sequences from a string.
def style_strip_ansi(s: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == 27
      # Skip ESC[...m sequences
      i += 1
      if i < len and str_byte_at(s, i) == '['
        i += 1
        while i < len
          var cc = str_byte_at(s, i)
          i += 1
          if cc == 'm'
            break
          end
        end
      end
    else
      sb.append_char(c)
      i += 1
    end
  end
  return sb.to_string()
end

## Get the visible (non-ANSI) length of a styled string.
def style_visible_len(s: String): Int
  return str_byte_len(style_strip_ansi(s))
end
