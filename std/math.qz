# Math — Standard Library
#
# Integer and floating-point math functions.
# Built on Quartz intrinsics and basic arithmetic.
#
# Example:
#   import math
#   var x = math_abs(-42)         # 42
#   var m = math_max(10, 20)      # 20
#   var p = math_pow(2, 10)       # 1024

## Pi constant (F64).
var MATH_PI = 3.14159265358979323846

## Euler's number (F64).
var MATH_E = 2.71828182845904523536

## Absolute value of an integer.
def math_abs(n: Int): Int
  if n < 0
    return -n
  end
  return n
end

## Absolute value of a float.
def math_abs_f64(n: F64): F64
  if n < 0.0
    return -n
  end
  return n
end

## Minimum of two integers.
def math_min(a: Int, b: Int): Int
  if a <= b
    return a
  end
  return b
end

## Maximum of two integers.
def math_max(a: Int, b: Int): Int
  if a >= b
    return a
  end
  return b
end

## Minimum of two floats.
def math_min_f64(a: F64, b: F64): F64
  if a <= b
    return a
  end
  return b
end

## Maximum of two floats.
def math_max_f64(a: F64, b: F64): F64
  if a >= b
    return a
  end
  return b
end

## Integer power: base^exp (non-negative exp only).
## Returns 1 for exp == 0.
def math_pow(base: Int, exp: Int): Int
  if exp == 0
    return 1
  end
  if exp == 1
    return base
  end
  var result = 1
  var b = base
  var e = exp
  # Fast exponentiation by squaring
  while e > 0
    if e % 2 == 1
      result = result * b
    end
    b = b * b
    e = e / 2
  end
  return result
end

## Clamp integer to range [lo, hi].
def math_clamp(n: Int, lo: Int, hi: Int): Int
  if n < lo
    return lo
  end
  if n > hi
    return hi
  end
  return n
end

## Clamp float to range [lo, hi].
def math_clamp_f64(n: F64, lo: F64, hi: F64): F64
  if n < lo
    return lo
  end
  if n > hi
    return hi
  end
  return n
end

## Sign of an integer: -1, 0, or 1.
def math_sign(n: Int): Int
  if n > 0
    return 1
  end
  if n < 0
    return -1
  end
  return 0
end

## Greatest common divisor (Euclidean algorithm).
def math_gcd(a: Int, b: Int): Int
  var x = math_abs(a)
  var y = math_abs(b)
  while y != 0
    var t = y
    y = x % y
    x = t
  end
  return x
end

## Least common multiple.
def math_lcm(a: Int, b: Int): Int
  if a == 0 or b == 0
    return 0
  end
  return math_abs(a * b) / math_gcd(a, b)
end

## Check if an integer is even.
def math_is_even(n: Int): Bool
  return n % 2 == 0
end

## Check if an integer is odd.
def math_is_odd(n: Int): Bool
  return n % 2 != 0
end

## Integer division (truncated toward zero).
def math_div(a: Int, b: Int): Int
  return a / b
end

## Integer modulo.
def math_mod(a: Int, b: Int): Int
  return a % b
end

## Tau constant (2 * PI).
var MATH_TAU = 6.28318530717958647692

## Convert degrees to radians.
def math_to_radians(degrees: F64): F64
  return degrees * MATH_PI / 180.0
end

## Convert radians to degrees.
def math_to_degrees(radians: F64): F64
  return radians * 180.0 / MATH_PI
end

## Trigonometric wrappers for clean stdlib API.
def math_sin(x: F64): F64 = f64_sin(x)
def math_cos(x: F64): F64 = f64_cos(x)
def math_tan(x: F64): F64 = f64_tan(x)
def math_asin(x: F64): F64 = f64_asin(x)
def math_acos(x: F64): F64 = f64_acos(x)
def math_atan(x: F64): F64 = f64_atan(x)
def math_atan2(y: F64, x: F64): F64 = f64_atan2(y, x)

## Logarithmic/exponential wrappers.
def math_sqrt(x: F64): F64 = f64_sqrt(x)
def math_log(x: F64): F64 = f64_log(x)
def math_log2(x: F64): F64 = f64_log2(x)
def math_log10(x: F64): F64 = f64_log10(x)
def math_exp(x: F64): F64 = f64_exp(x)

## Float power (overloads existing Int version).
def math_pow_f64(base: F64, exp: F64): F64 = f64_pow(base, exp)

## Rounding wrappers.
def math_floor(x: F64): F64 = f64_floor(x)
def math_ceil(x: F64): F64 = f64_ceil(x)
def math_round(x: F64): F64 = f64_round(x)
