##! TOML Value Types
##!
##! Core data structures for representing TOML values in Be.
##!
##! @since 6.0.0

# -----------------------------------------------------------------------------
# Core Value Enum
# -----------------------------------------------------------------------------

## Represents any valid TOML value.
enum TomlValue
  String(value: String)
  Int(value: Int)
  Float(value: F64)
  Bool(value: Bool)
  Array(items: Vec<TomlValue>)
  Table(entries: Map<String, TomlValue>)
end

## A document location for error reporting.
struct TomlLocation
  line: Int
  column: Int
end

## Detailed error information from a failed parse.
struct TomlError
  message: String
  location: TomlLocation
end

## Result type for TOML parsing operations.
enum TomlResult
  Ok(value: TomlValue)
  Err(error: TomlError)
end


# -----------------------------------------------------------------------------
# Constructor Functions
# -----------------------------------------------------------------------------

## Creates a new empty TOML table.
def toml_table_new(): Map<String, TomlValue>
  return map_new()
end

## Creates a new TomlLocation.
def toml_location_new(line: Int, column: Int): TomlLocation
  return TomlLocation { line: line, column: column }
end

## Creates a successful parse result.
def toml_ok(value: TomlValue): TomlResult
  return TomlResult::Ok(value)
end

## Creates a failed parse result.
def toml_err_result(message: String, line: Int, column: Int): TomlResult
  loc = TomlLocation { line: line, column: column }
  error = TomlError { message: message, location: loc }
  return TomlResult::Err(error)
end

# -----------------------------------------------------------------------------
# Table Operations
# -----------------------------------------------------------------------------

## Sets a key-value pair in a TOML table.
def toml_table_set(table: Map<String, TomlValue>, key: String, value: TomlValue): Void
  map_set(table, key, value)
end

## Gets a value from a TOML table by key. `None` if the key is absent.
def toml_table_get(table: Map<String, TomlValue>, key: String): Option<TomlValue>
  return table.get(key)
end

## Checks if a key exists in a TOML table.
def toml_table_has(table: Map<String, TomlValue>, key: String): Bool
  return map_has(table, key)
end

## Returns all keys in a TOML table.
def toml_table_keys(table: Map<String, TomlValue>): Vec<String>
  return table.keys()
end

# -----------------------------------------------------------------------------
# Type Extraction Helpers
# -----------------------------------------------------------------------------

## Extracts a string value from a TomlValue.
def toml_as_string(value: TomlValue): String
  match value
    TomlValue::String(s) => return s
    _ => return ""
  end
end

## Extracts an integer value from a TomlValue.
def toml_as_int(value: TomlValue): Int
  match value
    TomlValue::Int(n) => return n
    _ => return 0
  end
end

## Extracts the float value from a TomlValue.
def toml_as_float(value: TomlValue): F64
  match value
    TomlValue::Float(f) => return f
    _ => return 0.0
  end
end

## Extracts a boolean value from a TomlValue.
def toml_as_bool(value: TomlValue): Bool
  match value
    TomlValue::Bool(b) => return b
    _ => return false
  end
end

## Extracts the typed Vec<TomlValue> payload from an Array TomlValue.
def toml_as_array(value: TomlValue): Vec<TomlValue>
  match value
    TomlValue::Array(a) => return a
    _ => return vec_new<TomlValue>()
  end
end

## Extracts the typed Map<String, TomlValue> payload from a Table TomlValue.
def toml_as_table(value: TomlValue): Map<String, TomlValue>
  match value
    TomlValue::Table(t) => return t
    _ => return map_new<String, TomlValue>()
  end
end

# -----------------------------------------------------------------------------
# Type Checking Predicates
# -----------------------------------------------------------------------------

## Checks if a TOML value is a string.
def toml_is_string(value: TomlValue): Bool
  match value
    TomlValue::String(x) => return true
    _ => return false
  end
end

## Checks if a TOML value is an integer.
def toml_is_int(value: TomlValue): Bool
  match value
    TomlValue::Int(x) => return true
    _ => return false
  end
end

## Checks if a TOML value is a float.
def toml_is_float(value: TomlValue): Bool
  match value
    TomlValue::Float(x) => return true
    _ => return false
  end
end

## Checks if a TOML value is a boolean.
def toml_is_bool(value: TomlValue): Bool
  match value
    TomlValue::Bool(x) => return true
    _ => return false
  end
end

## Checks if a TOML value is an array.
def toml_is_array(value: TomlValue): Bool
  match value
    TomlValue::Array(x) => return true
    _ => return false
  end
end

## Checks if a TOML value is a table.
def toml_is_table(value: TomlValue): Bool
  match value
    TomlValue::Table(x) => return true
    _ => return false
  end
end

# -----------------------------------------------------------------------------
# Path-Based Access
# -----------------------------------------------------------------------------

## Gets a nested value using dot-separated path notation.
## `None` if the path is not found.
def toml_get_path(table: Map<String, TomlValue>, path: String): Option<TomlValue>
  var current_table = table
  segments = str_split(path, ".")  # Now returns Vec<String>
  seg_count = segments.size
  var i = 0

  while i < seg_count - 1
    segment = segments[i]
    if not toml_table_has(current_table, segment)
      vec_free(segments)
      return Option::None
    end
    value = toml_table_get(current_table, segment).unwrap()  # key present (has-guarded)
    var is_tbl = false
    match value
      TomlValue::Table(x) => is_tbl = true
      _ => is_tbl = false
    end
    if is_tbl
      match value
        TomlValue::Table(t) => current_table = t
        _ => current_table = map_new<String, TomlValue>()
      end
    else
      vec_free(segments)
      return Option::None
    end
    i += 1
  end

  # Get final segment
  final_segment = segments[seg_count - 1]
  if not toml_table_has(current_table, final_segment)
    vec_free(segments)
    return Option::None
  end
  result = toml_table_get(current_table, final_segment)  # Option<TomlValue>, Some (has-guarded)
  vec_free(segments)
  return result
end

## Gets a string value at a dot-separated path.
def toml_get_string(table: Map<String, TomlValue>, path: String): String
  match toml_get_path(table, path)
    Some(value) =>
      match value
        TomlValue::String(s) => return s
        _ => return ""
      end
    None => return ""
  end
end

## Gets an integer value at a dot-separated path.
def toml_get_int(table: Map<String, TomlValue>, path: String): Int
  match toml_get_path(table, path)
    Some(value) =>
      match value
        TomlValue::Int(n) => return n
        _ => return 0
      end
    None => return 0
  end
end

## Gets a boolean value at a dot-separated path.
def toml_get_bool(table: Map<String, TomlValue>, path: String): Bool
  match toml_get_path(table, path)
    Some(value) =>
      match value
        TomlValue::Bool(b) => return b
        _ => return false
      end
    None => return false
  end
end

## Gets a string value with a fallback if missing.
def toml_get_string_or(table: Map<String, TomlValue>, path: String, fallback: String): String
  result = toml_get_string(table, path)
  if str_byte_len(result) == 0
    return fallback
  end
  return result
end

# -----------------------------------------------------------------------------
# TomlResult Helpers
# -----------------------------------------------------------------------------

## Checks if a TomlResult is an error.
def toml_result_is_err(result: TomlResult): Bool
  match result
    Err(e) => return true
    Ok(v) => return false
  end
end

## Checks if a TomlResult is Ok.
def toml_result_is_ok(result: TomlResult): Bool
  match result
    Err(e) => return false
    Ok(v) => return true
  end
end

## Extracts the value from a successful TomlResult.
## PANICS if the result is an error.
def toml_result_unwrap(result: TomlResult): TomlValue
  match result
    Err(e) => do
      panic("toml_result_unwrap called on Err")
      # Unreachable but needed for type checker
    end
    Ok(v) => do
      return v
    end
  end
  # After panic, we never reach here, but type checker needs a return
  return TomlValue::Int(0)
end

## Extracts the error message from a TomlError.
def toml_error_message(error: TomlError): String
  return error.message
end

# -----------------------------------------------------------------------------
# UFCS Extend Block
# -----------------------------------------------------------------------------

extend TomlValue
  def is_string(): Bool
    return toml_is_string(self)
  end

  def is_int(): Bool
    return toml_is_int(self)
  end

  def is_float(): Bool
    return toml_is_float(self)
  end

  def is_bool(): Bool
    return toml_is_bool(self)
  end

  def is_array(): Bool
    return toml_is_array(self)
  end

  def is_table(): Bool
    return toml_is_table(self)
  end

  def as_int(): Int
    return toml_as_int(self)
  end

  def as_float(): F64
    return toml_as_float(self)
  end

  def as_bool(): Bool
    return toml_as_bool(self)
  end

  def as_array(): Vec<TomlValue>
    return toml_as_array(self)
  end

  def as_table(): Map<String, TomlValue>
    return toml_as_table(self)
  end
end
