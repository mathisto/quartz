##! TOML Lexer
##!
##! Tokenizer for TOML document parsing.
##!
##! @since 6.0.0

import * from toml/value

# -----------------------------------------------------------------------------
# Token Types
# -----------------------------------------------------------------------------

## Token type enumeration.
enum TomlTokenKind
  String
  LiteralString
  Int
  Float
  Bool
  Ident
  LBracket
  RBracket
  DoubleLBracket
  DoubleRBracket
  LBrace
  RBrace
  Equals
  Comma
  Dot
  Newline
  Eof
  Error
end

## A single token produced by the lexer.
struct TomlToken
  kind: TomlTokenKind
  value: String
  location: TomlLocation
end

## Lexer state for tokenizing TOML source.
struct TomlLexer
  source: String
  pos: Int
  line: Int
  column: Int
end

# -----------------------------------------------------------------------------
# Constructor Functions
# -----------------------------------------------------------------------------

## Creates a new lexer for the given TOML source text.
def toml_lexer_new(source: String): TomlLexer
  return TomlLexer {
    source: source,
    pos: 0,
    line: 1,
    column: 1
  }
end

## Creates a token with the given kind and value.
def toml_token_new(kind: TomlTokenKind, value: String, line: Int, column: Int): TomlToken
  return TomlToken {
    kind: kind,
    value: value,
    location: TomlLocation { line: line, column: column }
  }
end

# -----------------------------------------------------------------------------
# Token Kind Utilities
# -----------------------------------------------------------------------------

## Returns a human-readable name for a token kind.
def toml_token_kind_name(kind: TomlTokenKind): String
  match kind
    TomlTokenKind::String => return "string"
    TomlTokenKind::LiteralString => return "literal string"
    TomlTokenKind::Int => return "integer"
    TomlTokenKind::Float => return "float"
    TomlTokenKind::Bool => return "boolean"
    TomlTokenKind::Ident => return "identifier"
    TomlTokenKind::LBracket => return "'['"
    TomlTokenKind::RBracket => return "']'"
    TomlTokenKind::DoubleLBracket => return "'[['"
    TomlTokenKind::DoubleRBracket => return "']]'"
    TomlTokenKind::LBrace => return "'{'"
    TomlTokenKind::RBrace => return "'}'"
    TomlTokenKind::Equals => return "'='"
    TomlTokenKind::Comma => return "','"
    TomlTokenKind::Dot => return "'.'"
    TomlTokenKind::Newline => return "newline"
    TomlTokenKind::Eof => return "end of file"
    TomlTokenKind::Error => return "error"
  end
end

# -----------------------------------------------------------------------------
# Lexer Internals
# -----------------------------------------------------------------------------

## Returns the current character without advancing.
def toml_lexer_peek(lex: TomlLexer): Int
  if lex.pos >= str_byte_len(lex.source)
    return 0
  end
  return str_byte_at(lex.source, lex.pos)
end

## Returns the character at offset positions ahead.
def toml_lexer_peek_ahead(lex: TomlLexer, offset: Int): Int
  var target = lex.pos + offset
  if target >= str_byte_len(lex.source)
    return 0
  end
  return str_byte_at(lex.source, target)
end

# -----------------------------------------------------------------------------
# Lexer Mutators (self-receiver borrow convention)
#
# These mutate `self` and MUST be methods so the mutation persists when
# TomlLexer becomes value-layout (the F4 default-struct-value flip). A free
# function with a value-layout param-0 would mutate a copy and lose the
# advance; the `self` receiver passes the caller's live slot by reference.
# -----------------------------------------------------------------------------

extend TomlLexer
  ## Advances the lexer by one character.
  def advance(&mut self): Void
    if self.pos < str_byte_len(self.source)
      c = str_byte_at(self.source, self.pos)
      if c == '\n'  # '\n'
        self.line = self.line + 1
        self.column = 1
      else
        self.column = self.column + 1
      end
      self.pos = self.pos + 1
    end
  end

  ## Skips whitespace (spaces and tabs) but NOT newlines.
  def skip_whitespace(self): Void
    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)
      if c == ' ' or c == '\t'  # Space or Tab
        self.advance()
      else
        break
      end
    end
  end

  ## Skips a comment from `#` to end of line.
  def skip_comment(self): Void
    self.advance()  # Skip the '#'
    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)
      if c == '\n'  # '\n'
        break
      end
      self.advance()
    end
  end
end

## Checks if a character is valid in a bare key.
def toml_is_bare_key_char(c: Int): Bool
  if c >= 'A' and c <= 'Z'
    return true
  end
  if c >= 'a' and c <= 'z'
    return true
  end
  if c >= '0' and c <= '9'
    return true
  end
  if c == '_' or c == '-'
    return true
  end
  return false
end

# -----------------------------------------------------------------------------
# Token Scanning
# -----------------------------------------------------------------------------

## Helper to convert escape character to its escaped string value.
## Returns empty string for invalid escapes.
def toml_lexer_escape_char(c: Int): String
  if c == 'n'
    return "\n"
  end
  if c == 't'
    return "\t"
  end
  if c == 'r'
    return "\r"
  end
  if c == '\\'
    return "\\"
  end
  if c == '"'
    return "\""
  end
  return ""
end

extend TomlLexer
  ## Scans a basic string (double-quoted).
  def scan_string(self): TomlToken
    start_line = self.line
    start_col = self.column
    self.advance()  # Skip opening quote

    var result = ""

    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)

      if c == '"'  # '"' - closing quote
        self.advance()
        return toml_token_new(TomlTokenKind::String, result, start_line, start_col)
      end

      if c == '\n'  # '\n'
        return toml_token_new(TomlTokenKind::Error, "Unterminated string", start_line, start_col)
      end

      # Handle escape sequences
      if c == '\\'  # '\' - escape
        self.advance()
        if self.pos >= str_byte_len(self.source)
          return toml_token_new(TomlTokenKind::Error, "Unterminated escape", start_line, start_col)
        end

        escape_char = toml_lexer_peek(self)
        escaped = toml_lexer_escape_char(escape_char)
        if str_byte_len(escaped) == 0
          return toml_token_new(TomlTokenKind::Error, "Invalid escape", self.line, self.column)
        end
        result = result + escaped
        self.advance()
      end

      # Handle regular character
      if c != '\\'
        result = result + str_from_char(c)
        self.advance()
      end
    end

    return toml_token_new(TomlTokenKind::Error, "Unterminated string", start_line, start_col)
  end

  ## Scans a literal string (single-quoted).
  def scan_literal_string(self): TomlToken
    start_line = self.line
    start_col = self.column
    self.advance()  # Skip opening quote

    var result = ""

    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)

      if c == '\''  # '\'' - closing quote
        self.advance()
        return toml_token_new(TomlTokenKind::LiteralString, result, start_line, start_col)
      end

      if c == '\n'  # '\n'
        return toml_token_new(TomlTokenKind::Error, "Unterminated literal string", start_line, start_col)
      end

      result = result + str_from_char(c)
      self.advance()
    end

    return toml_token_new(TomlTokenKind::Error, "Unterminated literal string", start_line, start_col)
  end

  ## Scans a number literal (integer or float).
  def scan_number(self): TomlToken
    start_line = self.line
    start_col = self.column

    var result = ""
    var is_float = false

    # Handle optional sign
    var c = toml_lexer_peek(self)
    if c == '+' or c == '-'  # '+' or '-'
      result = result + str_from_char(c)
      self.advance()
    end

    # Scan integer part (digits and underscores)
    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)

      if c >= '0' and c <= '9'  # 0-9
        result = result + str_from_char(c)
        self.advance()
      elsif c == '_'  # '_' - skip
        self.advance()
      else
        break
      end
    end

    # Check for decimal point
    if self.pos < str_byte_len(self.source) and toml_lexer_peek(self) == '.'
      var next = toml_lexer_peek_ahead(self, 1)
      if next >= '0' and next <= '9'
        is_float = true
        result = result + "."
        self.advance()
        while self.pos < str_byte_len(self.source)
          c = toml_lexer_peek(self)
          if c >= '0' and c <= '9'
            result = result + str_from_char(c)
            self.advance()
          elsif c == '_'
            self.advance()
          else
            break
          end
        end
      end
    end

    # Check for exponent
    if self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)
      if c == 'e' or c == 'E'  # 'e' or 'E'
        is_float = true
        result = result + str_from_char(c)
        self.advance()
        if self.pos < str_byte_len(self.source)
          c = toml_lexer_peek(self)
          if c == '+' or c == '-'
            result = result + str_from_char(c)
            self.advance()
          end
        end
        while self.pos < str_byte_len(self.source)
          c = toml_lexer_peek(self)
          if c >= '0' and c <= '9'
            result = result + str_from_char(c)
            self.advance()
          elsif c == '_'
            self.advance()
          else
            break
          end
        end
      end
    end

    if is_float
      return toml_token_new(TomlTokenKind::Float, result, start_line, start_col)
    end
    return toml_token_new(TomlTokenKind::Int, result, start_line, start_col)
  end

  ## Scans a bare key or keyword.
  def scan_ident(self): TomlToken
    start_line = self.line
    start_col = self.column

    var result = ""

    while self.pos < str_byte_len(self.source)
      c = toml_lexer_peek(self)

      if toml_is_bare_key_char(c)
        result = result + str_from_char(c)
        self.advance()
      else
        break
      end
    end

    # Check for boolean keywords
    if result == "true" or result == "false"
      return toml_token_new(TomlTokenKind::Bool, result, start_line, start_col)
    end

    return toml_token_new(TomlTokenKind::Ident, result, start_line, start_col)
  end
end

# -----------------------------------------------------------------------------
# Main Lexer API
# -----------------------------------------------------------------------------

## Returns the next token from the input. Mutates `self` (advances) AND returns
## the token — a mutate-and-return receiver (like an iterator `$next`). Must be a
## method so the advance persists under value-layout. Named `next_token` (not
## `next`) to avoid colliding with the Stream/iterator-protocol `next`, which
## a bare field-receiver call (`self.lexer.next()`) otherwise mis-dispatches to.
extend TomlLexer
  def next_token(self): TomlToken
    self.skip_whitespace()

    if self.pos >= str_byte_len(self.source)
      return toml_token_new(TomlTokenKind::Eof, "", self.line, self.column)
    end

    c = toml_lexer_peek(self)
    start_line = self.line
    start_col = self.column

    # Comment
    if c == '#'  # '#'
      self.skip_comment()
      return self.next_token()
    end

    # Newline
    if c == '\n'  # '\n'
      self.advance()
      return toml_token_new(TomlTokenKind::Newline, "", start_line, start_col)
    end

    # Carriage return
    if c == '\r'  # '\r'
      self.advance()
      if toml_lexer_peek(self) == '\n'
        self.advance()
      end
      return toml_token_new(TomlTokenKind::Newline, "", start_line, start_col)
    end

    # Basic string
    if c == '"'  # '"'
      return self.scan_string()
    end

    # Literal string
    if c == '\''  # '\''
      return self.scan_literal_string()
    end

    # Left bracket
    if c == '['  # '['
      self.advance()
      if toml_lexer_peek(self) == '['
        self.advance()
        return toml_token_new(TomlTokenKind::DoubleLBracket, "", start_line, start_col)
      end
      return toml_token_new(TomlTokenKind::LBracket, "", start_line, start_col)
    end

    # Right bracket
    if c == ']'  # ']'
      self.advance()
      if toml_lexer_peek(self) == ']'
        self.advance()
        return toml_token_new(TomlTokenKind::DoubleRBracket, "", start_line, start_col)
      end
      return toml_token_new(TomlTokenKind::RBracket, "", start_line, start_col)
    end

    # Left brace
    if c == '{'  # '{'
      self.advance()
      return toml_token_new(TomlTokenKind::LBrace, "", start_line, start_col)
    end

    # Right brace
    if c == '}'  # '}'
      self.advance()
      return toml_token_new(TomlTokenKind::RBrace, "", start_line, start_col)
    end

    # Equals
    if c == '='  # '='
      self.advance()
      return toml_token_new(TomlTokenKind::Equals, "", start_line, start_col)
    end

    # Comma
    if c == ','  # ','
      self.advance()
      return toml_token_new(TomlTokenKind::Comma, "", start_line, start_col)
    end

    # Dot
    if c == '.'  # '.'
      self.advance()
      return toml_token_new(TomlTokenKind::Dot, "", start_line, start_col)
    end

    # Number
    if c >= '0' and c <= '9'  # 0-9
      return self.scan_number()
    end
    if (c == '+' or c == '-') and toml_lexer_peek_ahead(self, 1) >= '0' and toml_lexer_peek_ahead(self, 1) <= '9'
      return self.scan_number()
    end

    # Identifier
    if toml_is_bare_key_char(c)
      return self.scan_ident()
    end

    # Unknown character
    self.advance()
    return toml_token_new(TomlTokenKind::Error, "Unexpected character: " + str_from_char(c), start_line, start_col)
  end
end

## Returns the token at the given index from a tokenized vector.
def toml_get_token(tokens: Vec<TomlToken>, idx: Int): TomlToken
  return tokens[idx]
end

## Returns the number of tokens in a tokenized vector.
def toml_token_count(tokens: Vec<TomlToken>): Int
  return vec_size(tokens)
end

## Tokenizes an entire TOML source string into a vector of tokens (Vec handle).
def toml_tokenize(source: String): Vec<TomlToken>
  lex = toml_lexer_new(source)
  var tokens = vec_new<TomlToken>()
  
  while true
    tok = lex.next_token()
    tokens.push(tok)
    
    if tok.kind == TomlTokenKind::Eof or tok.kind == TomlTokenKind::Error
      break
    end
  end
  
  return tokens
end
