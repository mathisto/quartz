##! TOML Serializer
##!
##! Converts TomlValue trees back into TOML text format.
##!
##! @since 6.0.0

import * from toml/value
import * from traits

# -----------------------------------------------------------------------------
# String Escaping
# -----------------------------------------------------------------------------

def toml_escape_string(s: String): String
  var result = ""
  var i = 0
  var len = str_byte_len(s)

  while i < len
    var c = str_byte_at(s, i)
    if c == '"'
      result = "#{result}\\\""
    elsif c == '\\'
      result = "#{result}\\\\"
    elsif c == '\n'
      result = "#{result}\\n"
    elsif c == '\r'
      result = "#{result}\\r"
    elsif c == '\t'
      result = "#{result}\\t"
    else
      result = "#{result}#{str_from_char(c)}"
    end
    i = i + 1
  end

  return result
end

# -----------------------------------------------------------------------------
# Value Stringification
# -----------------------------------------------------------------------------

## Stringifies a TOML value (inline format).
def toml_stringify_value(v: TomlValue): String
  match v
    TomlValue::String(s) => return "\"#{toml_escape_string(s)}\""
    TomlValue::Int(n) => return n.to_s()
    TomlValue::Float(f) => return f64_to_str(f)
    TomlValue::Bool(b) => do
      if b
        return "true"
      else
        return "false"
      end
    end
    TomlValue::Array(items) => return toml_stringify_array(items)
    TomlValue::Table(entries) => return toml_stringify_inline_table(entries)
  end
end

## Stringifies an array inline.
def toml_stringify_array(items: Vec<TomlValue>): String
  var result = "["
  var len = items.size
  var i = 0

  while i < len
    if i > 0
      result = "#{result}, "
    end
    var elem = items[i]
    result = "#{result}#{toml_stringify_value(elem)}"
    i = i + 1
  end

  return "#{result}]"
end

## Stringifies a table inline.
def toml_stringify_inline_table(entries: Map<String, TomlValue>): String
  var result = "{"
  var keys = entries.keys()
  var len = keys.size
  var i = 0

  while i < len
    if i > 0
      result = "#{result}, "
    end
    var key = keys[i]
    result = str_concat(result, key)
    result = "#{result} = #{toml_stringify_value(entries[key])}"
    i = i + 1
  end

  return "#{result}}"
end

# -----------------------------------------------------------------------------
# Document Stringification
# -----------------------------------------------------------------------------

## Checks if a value is a simple scalar (not table or array-of-tables).
def toml_is_simple_value(v: TomlValue): Bool
  match v
    TomlValue::Table(t) => return false
    TomlValue::Array(items) => do
      if items.size > 0
        var first = items[0]
        if toml_is_table(first)
          return false
        end
      end
      return true
    end
    _ => return true
  end
end

## Stringifies key-value pairs for a table section.
def toml_stringify_table_pairs(entries: Map<String, TomlValue>): String
  var result = ""
  var keys = entries.keys()
  var len = keys.size
  var i = 0

  while i < len
    var key = keys[i]
    var val = entries[key]
    if toml_is_simple_value(val)
      result = str_concat(result, key)
      result = "#{result} = #{toml_stringify_value(val)}\n"
    end
    i = i + 1
  end

  return result
end

## Recursively stringifies nested tables with section headers.
def toml_stringify_sections(entries: Map<String, TomlValue>, prefix: String): String
  var result = ""
  var keys = entries.keys()
  var len = keys.size
  var i = 0

  while i < len
    var key = keys[i]
    var val = entries[key]

    if toml_is_table(val)
      var section_name = key
      if str_byte_len(prefix) > 0
        section_name = str_concat(str_concat(prefix, "."), key)
      end
      var tbl = toml_as_table(val)
      result = "#{result}["
      result = str_concat(result, section_name)
      result = "#{result}]\n"
      result = "#{result}#{toml_stringify_table_pairs(tbl)}"
      result = "#{result}#{toml_stringify_sections(tbl, section_name)}"
    end

    if toml_is_array(val)
      var arr = toml_as_array(val)
      if arr.size > 0
        var first = arr[0]
        if toml_is_table(first)
          var section_name = key
          if str_byte_len(prefix) > 0
            section_name = str_concat(str_concat(prefix, "."), key)
          end
          var j = 0
          while j < arr.size
            var elem = arr[j]
            result = "#{result}[["
            result = str_concat(result, section_name)
            result = "#{result}]]\n"
            if toml_is_table(elem)
              var elem_tbl = toml_as_table(elem)
              result = "#{result}#{toml_stringify_table_pairs(elem_tbl)}"
              result = "#{result}#{toml_stringify_sections(elem_tbl, section_name)}"
            end
            j = j + 1
          end
        end
      end
    end

    i = i + 1
  end

  return result
end

## Stringifies a complete TOML document.
## The input should be a TomlValue::Table (the root document).
def toml_stringify(v: TomlValue): String
  match v
    TomlValue::Table(entries) => do
      var result = toml_stringify_table_pairs(entries)
      result = "#{result}#{toml_stringify_sections(entries, "")}"
      return result
    end
    _ => return toml_stringify_value(v)
  end
end

# -----------------------------------------------------------------------------
# Trait Implementations
# -----------------------------------------------------------------------------

extend TomlValue with Show
  def show(self): String = toml_stringify_value(self)
end
