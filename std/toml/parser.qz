##! TOML Parser
##!
##! Parses TOML documents into structured TomlValue trees.
##!
##! @since 6.0.0

import * from toml/value
import * from toml/lexer
import * from error

# -----------------------------------------------------------------------------
# Parser State
# -----------------------------------------------------------------------------

## Parser state for processing TOML tokens.
struct TomlParser
  lexer: TomlLexer
  current: TomlToken
  root: Map<String, TomlValue>
  current_table: Map<String, TomlValue>
end

# -----------------------------------------------------------------------------
# Parser Construction
# -----------------------------------------------------------------------------

## Creates a new parser for the given TOML source.
def toml_parser_new(source: String): TomlParser
  lex = toml_lexer_new(source)
  root = toml_table_new()
  
  first = lex.next_token()
  parser = TomlParser {
    lexer: lex,
    current: first,
    root: root,
    current_table: root
  }

  return parser
end

# -----------------------------------------------------------------------------
# Parser Utilities
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Parser Mutators (self-receiver borrow convention)
#
# These mutate `self` (advance the embedded lexer + current token) and MUST be
# methods so the mutation persists when TomlParser/TomlLexer become value-layout
# (the F4 default-struct-value flip). A free function with a value-layout param-0
# would mutate a copy and lose every advance. EVERY function in the advance call
# chain must use the `self` receiver — a single non-self link in the chain copies
# the parser and strands the mutation in the copy.
# -----------------------------------------------------------------------------

extend TomlParser
  ## Advances to the next token.
  def advance(&mut self): Void
    self.current = self.lexer.next_token()
  end

  ## Skips newline tokens.
  def skip_newlines(self): Void
    while self.current.kind == TomlTokenKind::Newline
      self.advance()
    end
  end

  ## Checks if the current token matches the expected kind.
  def check(self, kind: TomlTokenKind): Bool
    return self.current.kind == kind
  end
end

# -----------------------------------------------------------------------------
# Key Parsing
# -----------------------------------------------------------------------------

extend TomlParser
  ## Parses a key (bare, quoted, or dotted). Returns vector of segments;
  ## empty vector indicates a parse error (no valid key seen).
  def parse_key(self): Vec<String>
    var segments = vec_new<String>()
    var has_error = false

    # Parse first segment
    match self.current.kind
      TomlTokenKind::Ident => do
        segments.push(self.current.value)
        self.advance()
        end
      TomlTokenKind::String => do
        segments.push(self.current.value)
        self.advance()
        end
      TomlTokenKind::LiteralString => do
        segments.push(self.current.value)
        self.advance()
        end
      TomlTokenKind::Int => do
        segments.push(self.current.value)
        self.advance()
        end
      _ => do
        has_error = true
        end
    end

    if has_error
      return vec_new<String>()
    end

    # Parse additional dotted segments
    while self.current.kind == TomlTokenKind::Dot
      self.advance()  # consume dot

      if self.current.kind == TomlTokenKind::Ident
        segments.push(self.current.value)
        self.advance()
      elsif self.current.kind == TomlTokenKind::String
        segments.push(self.current.value)
        self.advance()
      elsif self.current.kind == TomlTokenKind::LiteralString
        segments.push(self.current.value)
        self.advance()
      elsif self.current.kind == TomlTokenKind::Int
        segments.push(self.current.value)
        self.advance()
      else
        return vec_new<String>()
      end
    end

    return segments
  end
end

# -----------------------------------------------------------------------------
# Value Parsing
# -----------------------------------------------------------------------------

extend TomlParser
  ## Parses a TOML value.
  def parse_value(self): TomlResult
    match self.current.kind
      TomlTokenKind::String => do
        value = TomlValue::String(self.current.value)
        self.advance()
        return toml_ok(value)

        end
      TomlTokenKind::LiteralString => do
        value = TomlValue::String(self.current.value)
        self.advance()
        return toml_ok(value)

        end
      TomlTokenKind::Int => do
        n = str_to_int(self.current.value)
        value = TomlValue::Int(n)
        self.advance()
        return toml_ok(value)

        end
      TomlTokenKind::Float => do
        f = str_to_f64(self.current.value)
        value = TomlValue::Float(f)
        self.advance()
        return toml_ok(value)

        end
      TomlTokenKind::Bool => do
        b = self.current.value == "true"
        value = TomlValue::Bool(b)
        self.advance()
        return toml_ok(value)

        end
      TomlTokenKind::LBracket => do
        return self.parse_array()

        end
      TomlTokenKind::LBrace => do
        return self.parse_inline_table()

        end
      TomlTokenKind::Error => do
        return toml_err_result(self.current.value, self.current.location.line, self.current.location.column)

        end
      _ => do
        return toml_err_result("Expected value, got " + toml_token_kind_name(self.current.kind),
                               self.current.location.line, self.current.location.column)
        end
    end
  end

  ## Parses an array value.
  def parse_array(self): TomlResult
    self.advance()  # consume '['

    var items = vec_new<TomlValue>()

    self.skip_newlines()

    # Empty array
    if self.current.kind == TomlTokenKind::RBracket
      self.advance()
      return toml_ok(TomlValue::Array(items))
    end

    # Parse first element
    var result = self.parse_value()
    if toml_result_is_err(result)
      return result
    end
    items.push(toml_result_unwrap(result))

    self.skip_newlines()

    # Parse remaining elements
    while self.current.kind == TomlTokenKind::Comma
      self.advance()  # consume ','
      self.skip_newlines()

      if self.current.kind == TomlTokenKind::RBracket
        break
      end

      var result = self.parse_value()
      if toml_result_is_err(result)
        return result
      end
      items.push(toml_result_unwrap(result))

      self.skip_newlines()
    end

    if self.current.kind != TomlTokenKind::RBracket
      return toml_err_result("Expected ']' or ',' in array", self.current.location.line, self.current.location.column)
    end
    self.advance()

    return toml_ok(TomlValue::Array(items))
  end

  ## Parses an inline table.
  def parse_inline_table(self): TomlResult
    self.advance()  # consume '{'

    table = toml_table_new()

    # Empty inline table
    if self.current.kind == TomlTokenKind::RBrace
      self.advance()
      return toml_ok(TomlValue::Table(table))
    end

    # Parse first key-value
    var key_segments = self.parse_key()
    if key_segments.size == 0
      return toml_err_result("Expected key in inline table", self.current.location.line, self.current.location.column)
    end

    if self.current.kind != TomlTokenKind::Equals
      return toml_err_result("Expected '=' after key", self.current.location.line, self.current.location.column)
    end
    self.advance()

    var val_result = self.parse_value()
    if toml_result_is_err(val_result)
      return val_result
    end
    var insert_ok = toml_insert_at_path(table, key_segments, toml_result_unwrap(val_result))
    if not insert_ok
      return toml_err_result("Duplicate key in inline table", self.current.location.line, self.current.location.column)
    end

    # Parse remaining key-values
    while self.current.kind == TomlTokenKind::Comma
      self.advance()

      var key_segments = self.parse_key()
      if key_segments.size == 0
        return toml_err_result("Expected key after ','", self.current.location.line, self.current.location.column)
      end

      if self.current.kind != TomlTokenKind::Equals
        return toml_err_result("Expected '='", self.current.location.line, self.current.location.column)
      end
      self.advance()

      var val_result = self.parse_value()
      if toml_result_is_err(val_result)
        return val_result
      end
      var insert_ok = toml_insert_at_path(table, key_segments, toml_result_unwrap(val_result))
      if not insert_ok
        return toml_err_result("Duplicate key", self.current.location.line, self.current.location.column)
      end
    end

    if self.current.kind != TomlTokenKind::RBrace
      return toml_err_result("Expected '}' or ','", self.current.location.line, self.current.location.column)
    end
    self.advance()

    return toml_ok(TomlValue::Table(table))
  end
end

# -----------------------------------------------------------------------------
# Path Navigation
# -----------------------------------------------------------------------------

## Navigates to or creates a nested table. `None` on error.
def toml_navigate_to_table(root: Map<String, TomlValue>, segments: Vec<String>, create_intermediate: Bool): Option<Map<String, TomlValue>>
  var current = root

  var i = 0
  while i < segments.size
    segment = segments[i]

    if toml_table_has(current, segment)
      existing = toml_table_get(current, segment).unwrap()  # key present (has-guarded)
      if toml_is_table(existing)
        current = toml_as_table(existing)
      elsif toml_is_array(existing)
        arr = toml_as_array(existing)
        if arr.size > 0
          last = arr[arr.size - 1]
          if toml_is_table(last)
            current = toml_as_table(last)
          else
            return Option::None
          end
        else
          return Option::None
        end
      else
        return Option::None
      end
    elsif create_intermediate
      new_table = toml_table_new()
      toml_table_set(current, segment, TomlValue::Table(new_table))
      current = new_table
    else
      return Option::None
    end

    i += 1
  end

  return Option::Some(current)
end

## Inserts a value at a key path. Returns true on success.
def toml_insert_at_path(table: Map<String, TomlValue>, segments: Vec<String>, value: TomlValue): Bool
  if segments.size == 0
    return false
  end

  if segments.size == 1
    key = segments[0]
    if toml_table_has(table, key)
      return false  # Duplicate key
    end
    toml_table_set(table, key, value)
    return true
  end

  # Navigate to parent table
  var parent_segments = vec_new<String>()
  var i = 0
  while i < segments.size - 1
    parent_segments.push(segments[i])
    i += 1
  end

  target_opt = toml_navigate_to_table(table, parent_segments, true)
  if target_opt.is_none()
    return false
  end
  target = target_opt.unwrap()

  final_key = segments[segments.size - 1]
  if toml_table_has(target, final_key)
    return false  # Duplicate key
  end
  toml_table_set(target, final_key, value)

  return true
end

# -----------------------------------------------------------------------------
# Table Header Parsing
# -----------------------------------------------------------------------------

extend TomlParser
  ## Parses a table header: [table.name]
  def parse_table_header(&mut self): Bool
    self.advance()  # consume '['

    var segments = self.parse_key()
    if segments.size == 0
      return false
    end

    if self.current.kind != TomlTokenKind::RBracket
      return false
    end
    self.advance()

    target_opt = toml_navigate_to_table(self.root, segments, true)
    if target_opt.is_none()
      return false
    end
    self.current_table = target_opt.unwrap()

    return true
  end

  ## Parses an array-of-tables header: [[array.name]]
  def parse_array_table_header(&mut self): Bool
    self.advance()  # consume '[['

    var segments = self.parse_key()
    if segments.size == 0
      return false
    end

    if self.current.kind != TomlTokenKind::DoubleRBracket
      return false
    end
    self.advance()

    # Get parent path and final key
    var parent_segments = vec_new<String>()
    var i = 0
    while i < segments.size - 1
      parent_segments.push(segments[i])
      i += 1
    end
    final_key = segments[segments.size - 1]

    # Navigate to parent
    var parent = self.root
    if vec_size(parent_segments) > 0
      parent_opt = toml_navigate_to_table(self.root, parent_segments, true)
      if parent_opt.is_none()
        return false
      end
      parent = parent_opt.unwrap()
    end

    # Get or create array
    var array = vec_new<TomlValue>()
    if toml_table_has(parent, final_key)
      existing = toml_table_get(parent, final_key).unwrap()  # key present (has-guarded)
      if toml_is_array(existing)
        array = toml_as_array(existing)
      else
        return false
      end
    else
      toml_table_set(parent, final_key, TomlValue::Array(array))
    end

    # Create and append new table
    new_table = toml_table_new()
    array.push(TomlValue::Table(new_table))
    self.current_table = new_table

    return true
  end
end

# -----------------------------------------------------------------------------
# Key-Value Parsing
# -----------------------------------------------------------------------------

extend TomlParser
  ## Parses a key-value pair.
  def parse_keyval(self): Bool
    var key_segments = self.parse_key()
    if key_segments.size == 0
      return false
    end

    if self.current.kind != TomlTokenKind::Equals
      return false
    end
    self.advance()

    var val_result = self.parse_value()
    if toml_result_is_err(val_result)
      return false
    end
    return toml_insert_at_path(self.current_table, key_segments, toml_result_unwrap(val_result))
  end
end

# -----------------------------------------------------------------------------
# Document Parsing
# -----------------------------------------------------------------------------

extend TomlParser
  ## Parses a complete TOML document.
  def parse_document(self): TomlResult
    self.skip_newlines()

    while self.current.kind != TomlTokenKind::Eof
      if self.current.kind == TomlTokenKind::LBracket
        if not self.parse_table_header()
          return toml_err_result("Invalid table header", self.current.location.line, self.current.location.column)
        end
      elsif self.current.kind == TomlTokenKind::DoubleLBracket
        if not self.parse_array_table_header()
          return toml_err_result("Invalid array table header", self.current.location.line, self.current.location.column)
        end
      elsif self.current.kind == TomlTokenKind::Ident
        if not self.parse_keyval()
          return toml_err_result("Invalid key-value pair", self.current.location.line, self.current.location.column)
        end
      elsif self.current.kind == TomlTokenKind::String
        if not self.parse_keyval()
          return toml_err_result("Invalid key-value pair", self.current.location.line, self.current.location.column)
        end
      elsif self.current.kind == TomlTokenKind::LiteralString
        if not self.parse_keyval()
          return toml_err_result("Invalid key-value pair", self.current.location.line, self.current.location.column)
        end
      elsif self.current.kind == TomlTokenKind::Newline
        self.advance()
      elsif self.current.kind == TomlTokenKind::Error
        return toml_err_result(self.current.value, self.current.location.line, self.current.location.column)
      else
        return toml_err_result("Unexpected token: " + toml_token_kind_name(self.current.kind),
                               self.current.location.line, self.current.location.column)
      end
    end

    return toml_ok(TomlValue::Table(self.root))
  end
end

# -----------------------------------------------------------------------------
# Public API
# -----------------------------------------------------------------------------

## Parses a TOML string into a document table.
def toml_parse(source: String): Result<TomlValue, ParseError>
  p = toml_parser_new(source)
  var legacy = p.parse_document()
  match legacy
    Ok(v) => return Result::Ok(v)
    Err(e) => return Result::Err(parse_error(e.message, e.location.line, e.location.column))
  end
end

## Parses a TOML file into a document table.
def toml_parse_file(path: String): Result<TomlValue, ParseError>
  source = read_file(path)
  if str_byte_len(source) == 0
    return Result::Err(parse_error("Could not read file: " + path, 0, 0))
  end
  return toml_parse(source)
end

# Deprecated: use toml_parse() which returns Result<TomlValue, ParseError>
def toml_parse_legacy(source: String): TomlResult
  p = toml_parser_new(source)
  return p.parse_document()
end
