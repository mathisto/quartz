# ByteReader — Cursor-based binary data reader
#
# Reads sequential bytes from a Bytes value with automatic position tracking.
#
# Example:
#   var r = ByteReader { _data: my_bytes, _pos: 0 }
#   var version = r.u8()
#   var length = r.u16be()

struct ByteReader
  _data: Bytes
  _pos: Int
end

extend ByteReader
  def u8(&mut self): Int
    var val = @_data.read_u8(@_pos)
    @_pos = @_pos + 1
    return val
  end

  def u16be(&mut self): Int
    var val = @_data.read_u16be(@_pos)
    @_pos = @_pos + 2
    return val
  end

  def u16le(&mut self): Int
    var val = @_data.read_u16le(@_pos)
    @_pos = @_pos + 2
    return val
  end

  def u32be(&mut self): Int
    var val = @_data.read_u32be(@_pos)
    @_pos = @_pos + 4
    return val
  end

  def u32le(&mut self): Int
    var val = @_data.read_u32le(@_pos)
    @_pos = @_pos + 4
    return val
  end

  def remaining(): Int
    return @_data.size() - @_pos
  end

  def eof(): Int
    if @_pos >= @_data.size()
      return 1
    end
    return 0
  end
end
