## std/sync/exclusion/semaphore.qz — Counting semaphore
##
## Implemented as a buffered channel pre-filled with `permits` tokens.
## acquire() = recv() (blocks when no permits)
## release() = send() (returns a permit)
## Standard Go pattern — zero overhead, reuses channel infra.
##
## Counting-semaphore use cases: rate limiting, resource pools, bounded
## concurrency. For binary-mutex semantics, prefer std/sync/exclusion/mutex.

## Create a counting semaphore with `permits` initial permits.
def semaphore_new(permits: Int): Int
  var ch = channel_new(permits)
  var i = 0
  while i < permits
    send(ch, 1)
    i = i + 1
  end
  return ch
end

## Acquire a permit (blocking). Blocks if no permits available.
def semaphore_acquire(sem: Int): Void
  recv(sem)
end

## Release a permit. Must be called once per acquire.
def semaphore_release(sem: Int): Void
  send(sem, 1)
end

## Try to acquire a permit (non-blocking).
## Returns true if acquired, false if no permits available.
def semaphore_try_acquire(sem: Int): Bool
  var opt = try_recv(sem)
  if option_is_some(opt)
    return true
  end
  return false
end

## Return the number of currently available permits.
def semaphore_available(sem: Int): Int
  return channel_size(sem)
end
