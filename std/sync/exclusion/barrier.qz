## std/sync/exclusion/barrier.qz — Rendezvous synchronization for N participants
##
## Layout: alloc'd 4-word block:
##   [0] = total participant count (immutable)
##   [1] = atomic counter (remaining waiters this generation)
##   [2] = notification channel (capacity = count)
##   [3] = atomic generation counter (for barrier reuse)
##
## Algorithm: Each waiter atomic_sub on counter. Last waiter (counter
## reaches 1) resets the counter, bumps generation, and sends count-1
## wake tokens. All other waiters recv a token. Last waiter is the
## "leader" (returns 1), all others return 0.

## Create a barrier for `count` participants.
def barrier_new(count: Int): Int
  var b = mem_alloc(4)
  store(b, 0, count)
  store(b, 1, atomic_new(count))
  store(b, 2, channel_new(count))
  store(b, 3, atomic_new(0))
  return b
end

## Wait at the barrier. Blocks until all participants arrive.
## Returns 1 for exactly one waiter (the "leader"), 0 for all others.
## The barrier resets automatically for reuse.
def barrier_wait(b: Int): Int
  var count = load(b, 0)
  var counter = load(b, 1)
  var ch = load(b, 2)
  var remaining = atomic_sub(counter, 1)
  if remaining == 1
    # Last to arrive — I'm the leader
    # Reset counter for next generation
    atomic_store(counter, count)
    atomic_add(load(b, 3), 1)
    # Wake all other waiters
    var i = 0
    while i < count - 1
      send(ch, 1)
      i = i + 1
    end
    return 1
  end
  # Not last — scheduler-friendly wait using try_recv + yield.
  # Blocking recv would deadlock scheduler worker threads.
  var token = try_recv(ch)
  while not option_is_some(token)
    sched_yield()
    token = try_recv(ch)
  end
  return 0
end

## Return the current generation count (how many times the barrier has tripped).
def barrier_generation(b: Int): Int
  return atomic_load(load(b, 3))
end
