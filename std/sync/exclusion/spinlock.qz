## std/sync/exclusion/spinlock — busy-wait Spinlock primitive (KERN.8 K8.4)
##
## Single-acquire mutual exclusion. Threads that fail to acquire spin
## in a tight CAS loop. Suitable for short critical sections where
## contention is rare; for longer waits prefer Mutex (which yields to
## the scheduler).
##
## The lock state is one U64 at the heap address returned by
## spinlock_new: 0 = unlocked, 1 = locked. spinlock_unlock writes 0
## via atomic_store_u64; spinlock_lock spins on atomic_cas_u64(s,0,1)
## until the swap wins.
##
## Lives in its own file (separate from std/sync.qz) because the
## sibling Semaphore implementation pulls in channel codegen, which
## references hosted-only TLS globals (@__qz_current_frame, etc.).
## Freestanding/kernel callers can `import * from std/sync/spinlock`
## without dragging the scheduler runtime along.
##
## Reference: docs/design/KERN_8_SMP.md decision D5; intrinsics emit
## `lock cmpxchg` / aligned MOV on x86_64.

## Allocate a new spinlock; returns its address (use with the other
## spinlock_* functions). Caller does not free at K8.4 — spinlocks
## are typically static / process-lifetime.
def spinlock_new(): Int
  var addr = qz_malloc(8)
  atomic_store_u64(addr, 0)
  return addr
end

## Acquire the spinlock. Spins until acquired.
def spinlock_lock(s: Int): Void
  var locked = atomic_cas_u64(s, 0, 1)
  while not locked
    locked = atomic_cas_u64(s, 0, 1)
  end
end

## Release the spinlock. Caller must hold the lock; mismatched
## release is undefined behavior.
def spinlock_unlock(s: Int): Void
  atomic_store_u64(s, 0)
end

## Try to acquire without spinning. Returns true if acquired.
def spinlock_try_lock(s: Int): Bool
  return atomic_cas_u64(s, 0, 1)
end

## Read the current locked state (1 = held, 0 = free). Diagnostic
## only — by the time the caller acts, the value may have changed.
def spinlock_is_locked(s: Int): Bool
  return atomic_load_u64(s) == 1
end

## A spinlock wrapper carrying the underlying address handle. D.10
## canonical surface for new code — `Spinlock.new()` / `s.lock` /
## `s.unlock` / `s.try_lock` / `s.is_locked`. The raw `spinlock_*`
## free functions above remain callable for freestanding / kernel
## code that prefers procedural style.
struct Spinlock
  handle: Int
end

extend Spinlock
  ## Allocate a new spinlock. Initially unlocked.
  def new(): Spinlock = Spinlock { handle: spinlock_new() }

  ## Acquire — spins until acquired.
  def lock(self): Void = spinlock_lock(@handle)

  ## Release.
  def unlock(self): Void = spinlock_unlock(@handle)

  ## Try to acquire without spinning. Returns true if acquired.
  def try_lock(self): Bool = spinlock_try_lock(@handle)

  ## Diagnostic readout of locked state. Racy by design.
  def is_locked(self): Bool = spinlock_is_locked(@handle)
end
