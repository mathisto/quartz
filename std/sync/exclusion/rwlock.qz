## std/sync/exclusion/rwlock — RwLock + Scoped read/write guards (B.8 Phase 5)
##
## A struct wrapper around the procedural `rwlock_new` / `rwlock_read` /
## `rwlock_read_unlock` / `rwlock_write` / `rwlock_write_unlock` intrinsics
## exposing the canonical Scoped-resource surface for both reader and
## writer locks. Existentially erased to `Int` at runtime.
##
## Usage:
##
##   var rw = rwlock(0)
##
##   with rw.read do v ->
##     # v: Int — a snapshot of the protected value (read-locked).
##     # ... read-only work ...
##   end
##   # implicit: rwlock_read_unlock fires on normal AND throw-unwind exit.
##
##   with rw.write do v ->
##     # v: Int — the protected value (write-locked, exclusive).
##     # caller may pass an updated value back via the bound v variable.
##     v = v + 1
##   end
##   # implicit: rwlock_write_unlock(rw, v) fires on normal exit;
##   # rwlock_write_unlock(rw, v) fires on throw-unwind too — write-back
##   # of the partially-updated v is intentional, mirroring Mutex.
##
## Both guards' release_on_throw is the same as release: just unlock. The
## protected value's "transactional commit" semantics are the caller's job
## (e.g., snapshot v at entry, only mutate on the success path).

import * from std/scoped

## A reader-lock guard. Construction is free; `acquire` actually grabs
## the read lock and returns the protected value snapshot.
struct RwLockReadGuard
  handle: Int
end

extend RwLockReadGuard with Scoped
  ## Take a shared read lock. Blocks until no writer holds the lock,
  ## then returns the protected value snapshot.
  def acquire(self): Int = rwlock_read(@handle)

  ## Release the read lock on normal block exit. Reader unlock takes
  ## no value — the read lock is non-modifying by design.
  def release(self, value: Int): Void
    rwlock_read_unlock(@handle)
  end

  ## Release the read lock on exceptional block exit. Identical to
  ## release — reader unlock is symmetric.
  def release_on_throw(self, value: Int, exc_msg: String): Void
    rwlock_read_unlock(@handle)
  end
end

## A writer-lock guard. Construction is free; `acquire` actually grabs
## the exclusive write lock and returns the current protected value.
struct RwLockWriteGuard
  handle: Int
end

extend RwLockWriteGuard with Scoped
  ## Take an exclusive write lock. Blocks until no reader or writer
  ## holds the lock, then returns the current protected value.
  def acquire(self): Int = rwlock_write(@handle)

  ## Release the write lock on normal block exit. Writes the (possibly
  ## updated) value back as the new protected value — caller mutations
  ## to the bound `v` propagate.
  def release(self, value: Int): Void
    rwlock_write_unlock(@handle, value)
  end

  ## Release the write lock on exceptional block exit. Same as release:
  ## the bound v's current contents are written back. If the body failed
  ## mid-update the partially-updated v WILL be observed by the next
  ## reader/writer — caller is responsible for snapshotting if it wants
  ## transactional semantics.
  def release_on_throw(self, value: Int, exc_msg: String): Void
    rwlock_write_unlock(@handle, value)
  end
end

## A reader-writer lock carrying a protected `Int` value. Multiple
## readers can hold the lock simultaneously; writers are exclusive.
## Construct via `rwlock(initial)`; acquire a Scoped read lock via
## `rw.read` or a Scoped write lock via `rw.write`. Direct procedural
## use of the inner intrinsics still works.
struct RwLock
  handle: Int
end

extend RwLock
  ## Construct a new RwLock protecting `initial` as its starting value.
  ## Canonical constructor (D.10). Equivalent to the legacy `rwlock(initial)`
  ## free function.
  def new(initial: Int): RwLock = RwLock { handle: rwlock_new(initial) }

  ## Build a one-shot reader guard for a `with`-block. The guard's
  ## `acquire` method actually grabs the read lock; constructing the
  ## guard is free.
  def read(self): RwLockReadGuard = RwLockReadGuard { handle: @handle }

  ## Build a one-shot writer guard for a `with`-block. The guard's
  ## `acquire` method actually grabs the write lock; constructing the
  ## guard is free.
  def write(self): RwLockWriteGuard = RwLockWriteGuard { handle: @handle }
end

## Legacy free-fn constructor — kept during the D.10 migration window.
## Prefer `RwLock.new(initial)` in new code.
def rwlock(initial: Int): RwLock = RwLock { handle: rwlock_new(initial) }
