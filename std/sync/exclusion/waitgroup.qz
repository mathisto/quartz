## std/sync/exclusion/waitgroup — WaitGroup canonical wrapper (D.10 Phase 2)
##
## Counter-based synchronization. Spawn N workers, each calling
## `wg.done()` when finished; the main thread blocks in `wg.wait()`
## until the counter reaches zero. Underlying state (atomic counter +
## condvar + mutex) is allocated by `waitgroup_new`; the wrapper
## carries the heap address as `handle`.
##
## Usage:
##
##   var wg = WaitGroup.new(3)
##   for i in 0..3
##     go (-> { do_work(i); wg.done(); 0 })
##   end
##   wg.wait()
##   wg.free()
##
## D.10 canonical surface; the legacy `waitgroup_new(N)` /
## `waitgroup_done(h)` / `waitgroup_wait(h)` / `waitgroup_free(h)` free
## functions remain callable during the migration window.

struct WaitGroup
  handle: Int
end

extend WaitGroup
  ## Construct a new WaitGroup with initial counter `count`. Each spawned
  ## worker decrements via `done()`; `wait()` blocks until the counter
  ## reaches zero.
  def new(count: Int): WaitGroup = WaitGroup { handle: waitgroup_new(count) }

  ## Decrement the counter. Last call (when counter hits zero) signals
  ## any waiters.
  def done(self): Void = waitgroup_done(@handle)

  ## Block until the counter reaches zero.
  def wait(self): Void = waitgroup_wait(@handle)

  ## Free the underlying condvar/mutex/memory. Caller is responsible for
  ## ensuring no live waiter or worker still references the handle.
  def free(self): Void = waitgroup_free(@handle)
end
