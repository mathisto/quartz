## std/sync/communication/broadcast.qz — Broadcast (fan-out) channels
##
## Lock-free one-sender / many-receivers (pub-sub). Each subscriber
## holds its own buffered channel; the broadcast structure is just a
## subscriber registry and a published-count cursor that senders walk
## on each broadcast_send.
##
## Layout: alloc'd block:
##   [0] = subscriber array (alloc'd N-slot array of channel handles)
##   [1] = visible subscriber count (atomic) — senders iterate 0..this
##   [2] = closed flag (atomic)
##   [3] = max subscribers (capacity)
##   [4] = next slot reservation (atomic) — internal, not read by senders
##
## Two-phase subscribe (lock-free append):
##   1. Reserve slot: atomic_add on [4] → unique idx
##   2. Store channel at subs[idx]
##   3. Publish: spin until [1] == idx, then atomic_add [1]
## This ensures senders never see a slot before its channel is stored.

## Create a new broadcast channel with a default 64-subscriber cap.
def broadcast_new(): Int
  var max_subs = 64
  var bcast = mem_alloc(5)
  var subs = mem_alloc(max_subs)
  store(bcast, 0, subs)
  store(bcast, 1, atomic_new(0))
  store(bcast, 2, atomic_new(0))
  store(bcast, 3, max_subs)
  store(bcast, 4, atomic_new(0))
  return bcast
end

## Subscribe to a broadcast channel.
## Creates a new channel for this subscriber and returns it.
## Returns -1 if broadcast is closed or at capacity.
def broadcast_subscribe(bcast: Int): Int
  if atomic_load(load(bcast, 2)) == 1
    return -1
  end
  # Phase 1: Reserve a unique slot index
  var reserve_atom = load(bcast, 4)
  var idx = atomic_add(reserve_atom, 1)
  var max_subs = load(bcast, 3)
  if idx >= max_subs
    atomic_sub(reserve_atom, 1)
    return -1
  end
  # Phase 2: Create channel and store in the reserved slot
  var ch = channel_new(64)
  var subs = load(bcast, 0)
  store(subs, idx, ch)
  # Phase 3: Publish — wait for our turn, then increment visible count.
  # This ensures slots 0..visible_count are all fully initialized.
  # In practice, subscribes are rare and sequential, so this never spins.
  var visible_atom = load(bcast, 1)
  while atomic_load(visible_atom) != idx
    sched_yield()
  end
  atomic_add(visible_atom, 1)
  return ch
end

## Send a value to all current subscribers (lock-free).
## Uses try_send (non-blocking): slow subscribers miss messages.
## Returns 0 on success, -1 if broadcast is closed.
def broadcast_send(bcast: Int, val: Int): Int
  if atomic_load(load(bcast, 2)) == 1
    return -1
  end
  var subs = load(bcast, 0)
  var count = atomic_load(load(bcast, 1))
  var i = 0
  while i < count
    try_send(load(subs, i), val)
    i = i + 1
  end
  return 0
end

## Close the broadcast and all subscriber channels.
def broadcast_close(bcast: Int): Void
  atomic_store(load(bcast, 2), 1)
  var subs = load(bcast, 0)
  var count = atomic_load(load(bcast, 1))
  var i = 0
  while i < count
    channel_close(load(subs, i))
    i = i + 1
  end
end

## Return the number of active subscribers.
def broadcast_subscriber_count(bcast: Int): Int
  return atomic_load(load(bcast, 1))
end
