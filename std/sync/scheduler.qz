## std/sync/scheduler.qz — userland M:N scheduler exposition (KERN.8 K8.9)
##
## Lightweight, freestanding-safe surface over the kernel's per-CPU
## scheduler primitives (K8.6 per-CPU rings + K8.MVP per-CPU current
## task slot). The implementation reads from %gs-based per-CPU pages
## on the kernel target, and returns single-CPU stubs everywhere else
## (hosted, qspec, any program that hasn't called scheduler_register).
##
## Usage from the unikernel boot path (after kern8_pcpu_init):
##
##   import * from std/sync/scheduler
##   ...
##   kern8_pcpu_init()
##   scheduler_register_pcpu_pages(g_pcpu_pages, g_cpu_count)
##
## Usage from any task body:
##
##   var cpu = scheduler_current_cpu()        # 0 / 1 / ...
##   var n   = scheduler_cpu_count()          # 1 / 2 / 4 / ...
##   var hb  = scheduler_cpu_heartbeat(cpu)
##
## Lives in std/sync/ (parallel to spinlock.qz) so D.11 (http_server
## dogfood) can consume the API without dragging the unikernel ELF's
## kernel internals into the import graph.
##
## Reference: docs/design/KERN_8_SMP.md K8.9.

# Per-CPU page offsets — kept in lockstep with hello_x86.qz PCPU_*.
# Duplicated here so std/sync/scheduler.qz has a self-contained ABI;
# if the kernel layout changes, both files update together.
const _SCHED_PCPU_CPU_ID       = 0
const _SCHED_PCPU_LAPIC_ID     = 8
const _SCHED_PCPU_HEARTBEAT    = 40
const _SCHED_PCPU_READY_COUNT  = 88

# Set by the kernel at boot via scheduler_register_pcpu_pages. Hosted
# programs leave both at 0; the API then returns single-CPU stubs.
var g_sched_pcpu_pages = 0
var g_sched_cpu_count  = 0

# Per-CPU page lookup — extern from libc_stubs.c kern8_gs_load_u64.
# Same symbol the kernel uses for cpu_local_load; declaring here lets
# scheduler.qz be the canonical owner of the FFI surface.
extern "C" def kern8_gs_load_u64(off: Int): Int

# Called by the kernel after kern8_pcpu_init has populated the per-CPU
# page table + loaded BSP's GS-base. Wires this module's queries to
# the live kernel state. Hosted programs never call this and the API
# returns single-CPU stubs.
def scheduler_register_pcpu_pages(pages: Int, count: Int): Void
  g_sched_pcpu_pages = pages
  g_sched_cpu_count = count
end

def _sched_pcpu_for(cpu: Int): Int = volatile_load<U64>(g_sched_pcpu_pages + (cpu * 8))

# How many CPUs the scheduler is running on. Returns 1 if the kernel
# hasn't registered (hosted/qspec); the kernel's actual count once
# scheduler_register_pcpu_pages has been called.
def scheduler_cpu_count(): Int
  if g_sched_cpu_count == 0
    return 1
  end
  return g_sched_cpu_count
end

# Which CPU the current task is running on. Hosted: always 0.
def scheduler_current_cpu(): Int
  if g_sched_pcpu_pages == 0
    return 0
  end
  return kern8_gs_load_u64(_SCHED_PCPU_CPU_ID)
end

# LAPIC ID of the current CPU. Hosted: 0.
def scheduler_current_lapic_id(): Int
  if g_sched_pcpu_pages == 0
    return 0
  end
  return kern8_gs_load_u64(_SCHED_PCPU_LAPIC_ID)
end

# LAPIC ID for any specific CPU index. Hosted: 0.
def scheduler_cpu_lapic_id(cpu: Int): Int
  if g_sched_pcpu_pages == 0
    return 0
  end
  return volatile_load<U64>(_sched_pcpu_for(cpu) + _SCHED_PCPU_LAPIC_ID)
end

# Per-CPU sched_tick counter (bumped on every task entry by the kernel
# scheduler). A stalled CPU is visible as a heartbeat that stops
# advancing while siblings climb. Hosted: 0.
def scheduler_cpu_heartbeat(cpu: Int): Int
  if g_sched_pcpu_pages == 0
    return 0
  end
  return volatile_load<U64>(_sched_pcpu_for(cpu) + _SCHED_PCPU_HEARTBEAT)
end

# Depth of CPU N's local ready ring. Best-effort snapshot — readers
# may see a slightly stale count during concurrent push/pop. Hosted: 0.
def scheduler_cpu_ready_count(cpu: Int): Int
  if g_sched_pcpu_pages == 0
    return 0
  end
  return volatile_load<U64>(_sched_pcpu_for(cpu) + _SCHED_PCPU_READY_COUNT)
end

# Sum of every CPU's ready ring depth. Same best-effort snapshot
# semantics as scheduler_cpu_ready_count (no global lock).
def scheduler_total_ready(): Int
  var sum = 0
  var i = 0
  var n = scheduler_cpu_count()
  while i < n
    sum = sum + scheduler_cpu_ready_count(i)
    i = i + 1
  end
  return sum
end

# ============================================================================
# Hosted scheduler dashboard — diagnostic (hosted M:N scheduler only)
# ============================================================================

## Print scheduler dashboard with worker and task counts.
## Requires sched_init to have been called.
##
## Note: this consults the hosted M:N scheduler's intrinsics
## (`sched_worker_count` / `sched_task_count` / `sched_queue_depth`).
## On the kernel target the intrinsics return their initialized-default
## value of 0; the dashboard line still prints without crashing.
def sched_dashboard(): Void
  var workers = sched_worker_count()
  var tasks = sched_task_count()
  var queue = sched_queue_depth()
  puts("Scheduler: workers=#{to_str(workers)}, active_tasks=#{to_str(tasks)}, queue_depth=#{to_str(queue)}")
end
