## std/sync/composition/parallel.qz — Parallel data-parallel helpers
##
## Composition-shape: lift a Vec<Int> through a transform function in
## parallel and collect the results in order. parallel_map fans out;
## parallel_reduce sequentially folds (the current implementation —
## tree reduction is a future optimization once the substrate supports
## associative-fold short-circuit).
##
## Build on top of `go` + `await` (`std/sync/composition/go.qz`). Result
## ordering is preserved by spawn/index correspondence — caller sees a
## Vec<Int> whose result[i] is f(items[i]).

import * from std/sync/composition/go

## Apply f to each item in parallel using the M:N scheduler.
## Returns results in the same order as inputs.
## f should be a pure function (no side effects) for deterministic
## results when scheduled across worker threads.
def parallel_map(items: Vec<Int>, f: Fn(Int): Int): Vec<Int>
  var count = items.size
  if count == 0
    return vec_new()
  end

  # Spawn one task per item. `go` requires a lambda, not a closure-call
  # — P3.G-followup migration eliminated `spawn`, and bare `go f(val)`
  # with a closure-captured `f` trips QZ1302 (closures may capture
  # non-Send). Wrap in an explicit lambda; the parser auto-wraps bare
  # lambdas via `(-> body)()` so this still enqueues the scheduled task.
  var handles = vec_new()
  for i in 0..count
    var val = items[i]
    var h = go (-> f(val))
    handles.push(h)
  end

  # Collect results in order.
  var results = vec_new()
  for i in 0..count
    var result = await handles[i]
    results.push(result)
  end

  return results
end

## Parallel reduce — combine all items using an associative binary
## operation. f should be associative and commutative for correct
## parallel results.
##
## Current implementation is sequential — tree reduction requires
## intermediate-result handling we don't yet have. Returns the
## accumulated result, or `initial` for empty input.
def parallel_reduce(items: Vec<Int>, initial: Int, f: Fn(Int, Int): Int): Int
  var count = items.size
  if count == 0
    return initial
  end
  var acc = initial
  for i in 0..count
    acc = f(acc, items[i])
  end
  return acc
end
