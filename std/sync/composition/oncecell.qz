## std/sync/composition/oncecell — OnceCell canonical wrapper (D.10 Phase 2)
##
## Thread-safe single-value lazy initialization. The first
## `get_or_init(f)` caller runs `f` and stores its result; concurrent
## callers block until the value is published; subsequent callers
## observe the cached value with no further synchronization cost.
##
## Usage:
##
##   var cell = OnceCell.new()
##   var v = cell.get_or_init(_compute_value)   # f runs once
##   var v2 = cell.get_or_init(_other)          # observes cached, _other never runs
##   cell.free()
##
##   def _compute_value(): Int = 42
##   def _other(): Int = 99
##
## D.10 canonical surface; the legacy `oncecell_new()` /
## `oncecell_get_or_init(h, f)` / `oncecell_get(h)` / `oncecell_free(h)`
## free functions remain callable during the migration window.

struct OnceCell
  handle: Int
end

extend OnceCell
  ## Construct an empty OnceCell. The first `get_or_init` caller wins
  ## the initialization race; concurrent callers block until the value
  ## is published, then observe the same value.
  def new(): OnceCell = OnceCell { handle: oncecell_new() }

  ## Return the stored value, computing and storing it via `f` if the
  ## cell is empty. The first thread through wins; later threads block
  ## until the value is published.
  def get_or_init(self, f: Fn(): Int): Int = oncecell_get_or_init(@handle, f)

  ## Return the stored value if the cell is initialized, or 0 if empty.
  ## Use `get_or_init` if you need the initialization guarantee.
  def get(self): Int = oncecell_get(@handle)

  ## Free the underlying state. Caller is responsible for ensuring no
  ## live consumer still references the handle.
  def free(self): Void = oncecell_free(@handle)
end
