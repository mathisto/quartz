## Declarative command-line argument parser.
##
## Inspired by Ruby's Thor/Optimist: one line per flag, auto-generated help,
## short + long form support, subcommands, repeatable options.
##
## Example:
##   var cli = argparser_new("myapp", "1.0.0", "A great tool")
##   argparser_command(cli, "build", "Compile the project")
##   argparser_flag(cli, "-v", "--verbose", "Show detailed output")
##   argparser_option(cli, "-o", "--output", "Output file path")
##   var args = argparser_parse_args(cli)
##   var cmd = parsed_command(args)
##   var verbose = parsed_has(args, "--verbose")
##   var out = parsed_get(args, "--output")

## Entry kinds stored as strings for Vec<String> compat.
## "0" = flag, "1" = option, "2" = repeatable option, "3" = command
ARGPARSE_KIND_FLAG = "0"
ARGPARSE_KIND_OPTION = "1"
ARGPARSE_KIND_OPTION_REPEAT = "2"
ARGPARSE_KIND_COMMAND = "3"

struct ArgParser
  ## Program metadata
  prog_name: String
  prog_version: String
  prog_desc: String

  ## Registered entries (flags, options, commands)
  short_names: Vec<String>
  long_names: Vec<String>
  descriptions: Vec<String>
  kinds: Vec<String>
  count: Int
end

struct ParsedArgs
  ## Matched flag/option keys (long form)
  keys: Vec<String>
  ## Matched values ("1" for flags, actual value for options)
  values: Vec<String>
  ## Positional arguments (after flags and subcommand)
  positionals: Vec<String>
  ## Subcommand name (empty if none)
  command: String
end

## Create a new argument parser.
def argparser_new(name: String, version: String, desc: String): ArgParser
  var p = ArgParser {
    prog_name: name,
    prog_version: version,
    prog_desc: desc,
    short_names: vec_new(),
    long_names: vec_new(),
    descriptions: vec_new(),
    kinds: vec_new(),
    count: 0
  }
  # Auto-register --help and --version
  argparser_flag(p, "-h", "--help", "Show this help message")
  argparser_flag(p, "-v", "--version", "Show version")
  return p
end

## Register a boolean flag (no value).
def argparser_flag(p: ArgParser, short_name: String, long_name: String, desc: String): Void
  p.short_names.push(short_name)
  p.long_names.push(long_name)
  p.descriptions.push(desc)
  p.kinds.push(ARGPARSE_KIND_FLAG)
  p.count = p.count + 1
end

## Register an option that takes a value.
def argparser_option(p: ArgParser, short_name: String, long_name: String, desc: String): Void
  p.short_names.push(short_name)
  p.long_names.push(long_name)
  p.descriptions.push(desc)
  p.kinds.push(ARGPARSE_KIND_OPTION)
  p.count = p.count + 1
end

## Register a repeatable option (can appear multiple times, e.g. -I path).
def argparser_option_repeat(p: ArgParser, short_name: String, long_name: String, desc: String): Void
  p.short_names.push(short_name)
  p.long_names.push(long_name)
  p.descriptions.push(desc)
  p.kinds.push(ARGPARSE_KIND_OPTION_REPEAT)
  p.count = p.count + 1
end

## Register a subcommand.
def argparser_command(p: ArgParser, name: String, desc: String): Void
  p.short_names.push("")
  p.long_names.push(name)
  p.descriptions.push(desc)
  p.kinds.push(ARGPARSE_KIND_COMMAND)
  p.count = p.count + 1
end

## Find an entry by short or long name. Returns index or -1.
def argparser_find(p: ArgParser, arg: String): Int
  var i = 0
  while i < p.count
    var kind = p.kinds[i]
    if kind != ARGPARSE_KIND_COMMAND
      var sn = p.short_names[i]
      if sn == arg
        if str_byte_len(arg) > 0
          return i
        end
      end
      if p.long_names[i] == arg
        return i
      end
    end
    i = i + 1
  end
  return -1
end

## Check if a string matches any registered command.
def argparser_find_command(p: ArgParser, arg: String): Int
  var i = 0
  while i < p.count
    var kind = p.kinds[i]
    if kind == ARGPARSE_KIND_COMMAND
      if p.long_names[i] == arg
        return i
      end
    end
    i = i + 1
  end
  return -1
end

## Check if a string starts with "-".
def argparse_is_flag(s: String): Int
  if str_byte_len(s) > 0
    if s[0] == 45
      return 1
    end
  end
  return 0
end

## Parse command-line arguments from argc/argv.
def argparser_parse_args(p: ArgParser): ParsedArgs
  var keys: Vec<String> = vec_new()
  var values: Vec<String> = vec_new()
  var positionals: Vec<String> = vec_new()
  var command = ""
  var found_command = 0
  var n = argc()
  var i = 1

  while i < n
    var arg = argv(i)

    # Check for -- separator (everything after is positional)
    if arg == "--"
      i = i + 1
      while i < n
        positionals.push(argv(i))
        i = i + 1
      end
      break
    end

    # Check for =VALUE syntax (e.g., --target=x86_64)
    var eq_pos = -1
    var j = 0
    while j < str_byte_len(arg)
      if arg[j] == 61
        eq_pos = j
        break
      end
      j = j + 1
    end

    if eq_pos > 0
      var flag_part = str_byte_slice(arg, 0, eq_pos)
      var val_part = str_byte_slice(arg, eq_pos + 1, str_byte_len(arg))
      var idx = argparser_find(p, flag_part)
      if idx >= 0
        keys.push(p.long_names[idx])
        values.push(val_part)
      end
      i = i + 1
    elsif argparse_is_flag(arg)
      var idx = argparser_find(p, arg)
      if idx >= 0
        var kind = p.kinds[idx]
        var long_name = p.long_names[idx]
        if kind == ARGPARSE_KIND_FLAG
          keys.push(long_name)
          values.push("1")
          i = i + 1
        else
          # OPTION or OPTION_REPEAT - consume next arg as value
          i = i + 1
          if i < n
            keys.push(long_name)
            values.push(argv(i))
          else
            print("error: ")
            print(arg)
            puts(" requires a value")
          end
          i = i + 1
        end
      else
        # Unknown flag - report error
        print("error: unknown option '")
        print(arg)
        puts("'")
        argparser_print_help(p)
        exit(1)
        i = i + 1
      end
    else
      # Not a flag - check for subcommand first, then positional
      if found_command == 0
        var cmd_idx = argparser_find_command(p, arg)
        if cmd_idx >= 0
          command = arg
          found_command = 1
          i = i + 1
        else
          positionals.push(arg)
          i = i + 1
        end
      else
        positionals.push(arg)
        i = i + 1
      end
    end
  end

  # Handle auto flags
  if parsed_has_in(keys, values, "--help")
    argparser_print_help(p)
    exit(0)
  end
  if parsed_has_in(keys, values, "--version")
    puts("#{p.prog_name} #{p.prog_version}")
    exit(0)
  end

  return ParsedArgs { keys: keys, values: values, positionals: positionals, command: command }
end

## Internal helper: check if a key exists in parallel key/value vecs.
def parsed_has_in(keys: Vec<String>, values: Vec<String>, name: String): Int
  var i = 0
  var count = keys.size
  while i < count
    if keys[i] == name
      return 1
    end
    i = i + 1
  end
  return 0
end

## Check if a flag or option was provided.
def parsed_has(args: ParsedArgs, name: String): Int
  return parsed_has_in(args.keys, args.values, name)
end

## Get the value of an option. Returns empty string if not found.
def parsed_get(args: ParsedArgs, name: String): String
  var i = 0
  var count = args.keys.size
  while i < count
    if args.keys[i] == name
      return args.values[i]
    end
    i = i + 1
  end
  return ""
end

## Get all values for a repeatable option. Returns Vec<String>.
def parsed_get_all(args: ParsedArgs, name: String): Vec<String>
  var result: Vec<String> = vec_new()
  var i = 0
  var count = args.keys.size
  while i < count
    if args.keys[i] == name
      result.push(args.values[i])
    end
    i = i + 1
  end
  return result
end

## Get the matched subcommand name (empty string if none).
def parsed_command(args: ParsedArgs): String
  return args.command
end

## Get a positional argument by index. Returns empty string if out of range.
def parsed_positional(args: ParsedArgs, index: Int): String
  if index < 0
    return ""
  end
  if index >= args.positionals.size
    return ""
  end
  return args.positionals[index]
end

## Get all positional arguments.
def parsed_positionals(args: ParsedArgs): Vec<String>
  return args.positionals
end

## Print formatted help text.
def argparser_print_help(p: ArgParser): Void
  puts("#{p.prog_name} #{p.prog_version}")
  if str_byte_len(p.prog_desc) > 0
    puts(p.prog_desc)
  end
  puts("")

  # Print commands section
  var has_commands = 0
  var i = 0
  while i < p.count
    if p.kinds[i] == ARGPARSE_KIND_COMMAND
      has_commands = 1
      break
    end
    i = i + 1
  end

  if has_commands
    puts("Commands:")
    i = 0
    while i < p.count
      if p.kinds[i] == ARGPARSE_KIND_COMMAND
        var name = p.long_names[i]
        var desc = p.descriptions[i]
        print("  ")
        print(name)
        # Pad to column 20
        var pad = 20 - str_byte_len(name) - 2
        var k = 0
        while k < pad
          print(" ")
          k = k + 1
        end
        puts(desc)
      end
      i = i + 1
    end
    puts("")
  end

  # Print options section
  puts("Options:")
  i = 0
  while i < p.count
    var kind = p.kinds[i]
    if kind != ARGPARSE_KIND_COMMAND
      var short_name = p.short_names[i]
      var long_name = p.long_names[i]
      var desc = p.descriptions[i]
      var col = 2

      print("  ")
      if str_byte_len(short_name) > 0
        print(short_name)
        print(", ")
        col = col + str_byte_len(short_name) + 2
      else
        print("    ")
        col = col + 4
      end

      print(long_name)
      col = col + str_byte_len(long_name)

      if kind == ARGPARSE_KIND_OPTION
        print(" VALUE")
        col = col + 6
      end
      if kind == ARGPARSE_KIND_OPTION_REPEAT
        print(" VALUE")
        col = col + 6
      end

      # Pad to column 30
      var pad = 30 - col
      if pad < 2
        pad = 2
      end
      var k = 0
      while k < pad
        print(" ")
        k = k + 1
      end
      puts(desc)
    end
    i = i + 1
  end
end

## --- Convenience API (simpler signatures for testing / quick scripts) ---

## Create a bare parser with no metadata and no auto-registered flags.
def argparser_new(): ArgParser
  var p = ArgParser {
    prog_name: "",
    prog_version: "",
    prog_desc: "",
    short_names: vec_new(),
    long_names: vec_new(),
    descriptions: vec_new(),
    kinds: vec_new(),
    count: 0
  }
  return p
end

## Register a flag without description.
def argparser_flag(p: ArgParser, short_name: String, long_name: String): Void
  argparser_flag(p, short_name, long_name, "")
end

## Register an option without description.
def argparser_option(p: ArgParser, short_name: String, long_name: String): Void
  argparser_option(p, short_name, long_name, "")
end

## Parse an explicit Vec<String> of arguments (for testing without argc/argv).
def argparser_parse(p: ArgParser, argv_vec: Vec<String>): ParsedArgs
  var keys: Vec<String> = vec_new()
  var values: Vec<String> = vec_new()
  var positionals: Vec<String> = vec_new()
  var command = ""
  var n = argv_vec.size
  var i = 0

  while i < n
    var arg = argv_vec[i]

    if arg == "--"
      i = i + 1
      while i < n
        positionals.push(argv_vec[i])
        i = i + 1
      end
      break
    end

    if argparse_is_flag(arg)
      var idx = argparser_find(p, arg)
      if idx >= 0
        var kind = p.kinds[idx]
        var long_name = p.long_names[idx]
        if kind == ARGPARSE_KIND_FLAG
          keys.push(long_name)
          values.push("1")
          i = i + 1
        else
          i = i + 1
          if i < n
            keys.push(long_name)
            values.push(argv_vec[i])
          end
          i = i + 1
        end
      else
        i = i + 1
      end
    else
      positionals.push(arg)
      i = i + 1
    end
  end

  return ParsedArgs { keys: keys, values: values, positionals: positionals, command: command }
end

## Alias: check if a flag/option was provided.
def argparse_has(args: ParsedArgs, name: String): Int
  return parsed_has(args, name)
end

## Alias: get an option value.
def argparse_get(args: ParsedArgs, name: String): String
  return parsed_get(args, name)
end
