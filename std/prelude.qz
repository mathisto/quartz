# Prelude - Auto-imported types and functions
#
# This module is automatically imported at the start of every Quartz program.
# It provides the core Option and Result types for nullable and fallible operations,
# and (via wildcard re-export) the Yield<T> effect plus Stream<T> handle from
# std/gen so generator/iterator surface syntax works without an explicit import.
#
# The prelude is a true import (not magic) - user code can shadow these definitions
# if needed, though this is rarely advisable.
#
# All definitions here are public (Quartz uses private sections, not pub keyword).

# std/gen — Yield<T> effect, Stream<T> handle, and the consumer-drive
# helpers that power `def gen(): impl Iterator<T>` + `for x in gen()`.
# The compiler emits Stream$next + __qz_gen_yield_capture references when
# lowering generator constructors and for-in over generators (Path B,
# Phase 4.B.4-4.B.5), so these names need to be in scope wherever a user
# writes a generator. Using the canonical hierarchical form `std/gen`
# (the same form callers write) so the resolver's loaded-set de-dups
# any explicit `import * from std/gen` against the prelude-injected one.
import * from std/gen

# std/fmt/float — pure-Quartz Dragon4 shortest-round-trip float formatter.
# Provides the free function `f64_to_str(f: F64): String`, which replaced the
# former sprintf-%g intrinsic of the same name. Auto-imported so `to_str(f)`,
# `#{f}`, `puts(f)`, concat-coercion, and `f.to_s()` all route to it.
import * from std/fmt/float

# Option<T> - Represents an optional value
#
# Option is a type that represents either a value (Some) or the absence
# of a value (None). It provides a type-safe alternative to nil.
#
# Example:
#   opt = Option::Some(42)
#   match opt
#     Option::Some(v) => print(v)
#     Option::None => print("no value")
#   end

enum Option<T>
  Some(value: T)
  None
end

# Returns true if the Option contains a value.
def is_some<T>(opt: Option<T>): Bool
  match opt
    Option::Some(x) => true
    Option::None => false
  end
end

# Returns true if the Option is None.
def is_none<T>(opt: Option<T>): Bool
  match opt
    Option::Some(x) => false
    Option::None => true
  end
end

# Unwraps the Option, returning the contained value.
# Panics if the Option is None.
def unwrap<T>(opt: Option<T>): T
  match opt
    Option::Some(v) => v
    Option::None => panic("called unwrap on None")
  end
end

# Returns the contained value or a fallback.
def unwrap_or<T>(opt: Option<T>, fallback: T): T
  if is_some(opt)
    return unwrap(opt)
  end
  return fallback
end

# Result<T, E> - Represents success or failure
#
# Result is a type that represents either a successful value (Ok) or
# an error (Err). It is used for operations that can fail, providing
# a type-safe way to handle errors without exceptions.
#
# Example:
#   res = Result::Ok(42)
#   match res
#     Result::Ok(v) => print(v)
#     Result::Err(e) => print("error: " + e)
#   end

enum Result<T, E>
  Ok(value: T)
  Err(error: E)
end

# Returns true if the Result is Ok.
def is_ok<T, E>(res: Result<T, E>): Bool
  match res
    Result::Ok(x) => true
    Result::Err(x) => false
  end
end

# Returns true if the Result is Err.
def is_err<T, E>(res: Result<T, E>): Bool
  match res
    Result::Ok(x) => false
    Result::Err(x) => true
  end
end

# Unwraps the Result, returning the Ok value.
# Panics if the Result is Err.
def unwrap_ok<T, E>(res: Result<T, E>): T
  match res
    Result::Ok(v) => v
    Result::Err(e) => panic("called unwrap_ok on Err")
  end
end

# Unwraps the Result, returning the Err value.
# Panics if the Result is Ok.
def unwrap_err<T, E>(res: Result<T, E>): E
  match res
    Result::Ok(x) => panic("called unwrap_err on Ok")
    Result::Err(e) => e
  end
end

# Returns the Ok value or a fallback.
def unwrap_or_ok<T, E>(res: Result<T, E>, fallback: T): T
  match res
    Result::Ok(v) => v
    Result::Err(x) => fallback
  end
end

# Converts Result to Option, discarding the error.
def ok<T, E>(res: Result<T, E>): Option<T>
  match res
    Result::Ok(v) => Option::Some(v)
    Result::Err(x) => Option::None
  end
end

# Converts Result to Option of error, discarding the Ok value.
def err<T, E>(res: Result<T, E>): Option<E>
  match res
    Result::Ok(x) => Option::None
    Result::Err(e) => Option::Some(e)
  end
end

# ============================================================================
# Result Combinators
# ============================================================================

# Maps the Ok value of a Result using a function.
def result_map<T, E, U>(res: Result<T, E>, f: Fn(T): U): Result<U, E>
  match res
    Result::Ok(v) => Result::Ok(f(v))
    Result::Err(e) => Result::Err(e)
  end
end

# Maps the Err value of a Result using a function.
def result_map_err<T, E, F>(res: Result<T, E>, f: Fn(E): F): Result<T, F>
  match res
    Result::Ok(v) => Result::Ok(v)
    Result::Err(e) => Result::Err(f(e))
  end
end

# Chains Result computations (flat_map / and_then).
def result_and_then<T, E, U>(res: Result<T, E>, f: Fn(T): Result<U, E>): Result<U, E>
  match res
    Result::Ok(v) => f(v)
    Result::Err(e) => Result::Err(e)
  end
end

# Returns the Ok value or a default. Alias for unwrap_or_ok.
def result_or<T, E>(res: Result<T, E>, fallback: T): T
  match res
    Result::Ok(v) => v
    Result::Err(e) => fallback
  end
end

# ============================================================================
# Option Combinators
# ============================================================================

# Maps the Some value of an Option using a function.
def option_map<T, U>(opt: Option<T>, f: Fn(T): U): Option<U>
  match opt
    Option::Some(v) => Option::Some(f(v))
    Option::None => Option::None
  end
end

# Chains Option computations (flat_map / and_then).
def option_and_then<T, U>(opt: Option<T>, f: Fn(T): Option<U>): Option<U>
  match opt
    Option::Some(v) => f(v)
    Option::None => Option::None
  end
end

# Returns the Some value or a default. Alias for unwrap_or.
def option_or<T>(opt: Option<T>, fallback: T): T
  match opt
    Option::Some(v) => v
    Option::None => fallback
  end
end

# ============================================================================
# Eager Collection Operations
# ============================================================================
#
# These complement the lazy iterator library in std/iter.qz with
# eager Vec-in / Vec-out helpers. They live in the prelude because
# their lazy cousins exist only in std/iter, and asking users to
# import a separate module just to call `.unique()` or `.flatten()`
# is friction. Each of these allocates new collections and returns
# them; none mutate their inputs.

def reversed(v: Vec<Int>): Vec<Int>
  var r = vec_clone(v)
  vec_reverse(r)
  return r
end

def sorted(v: Vec<Int>): Vec<Int>
  var s = vec_clone(v)
  vec_sort(s)
  return s
end

def unique(v: Vec<Int>): Vec<Int>
  var result = vec_new<Int>()
  if v.size == 0
    return result
  end
  var s = sorted(v)
  result.push(s[0])
  var i = 1
  while i < s.size
    if s[i] != s[i - 1]
      result.push(s[i])
    end
    i += 1
  end
  return result
end

# Concatenates a Vec of Vecs into a single Vec. Each element of `outer`
# is a Vec<Int> handle (the existential boundary used here is the same
# pattern as std/quake.qz task accessors: store via `as_int`, read back
# via `as_type` or implicit return-position widening).
# Empty inner Vecs are skipped silently.
def flatten(outer: Vec<Int>): Vec<Int>
  var result = vec_new<Int>()
  var i = 0
  while i < outer.size
    var inner = as_type<Vec<Int>>(outer[i])
    var j = 0
    while j < inner.size
      result.push(inner[j])
      j += 1
    end
    i += 1
  end
  return result
end

# Pairs each element with its index. Returns a Vec of two-element Vecs:
# the inner shape is [index, value]. Quartz doesn't have native tuples,
# so the convention across the eager collection ops is "small fixed-size
# Vec means tuple."
def enumerate(v: Vec<Int>): Vec<Vec<Int>>
  var result = vec_new<Vec<Int>>()
  var i = 0
  while i < v.size
    var pair = vec_new<Int>()
    pair.push(i)
    pair.push(v[i])
    result.push(pair)
    i += 1
  end
  return result
end

# Pairs elements from two Vecs positionally. Stops at min(a.size, b.size)
# — the longer Vec's tail is dropped silently. Each output element is a
# two-element Vec [a[i], b[i]].
def zip(a: Vec<Int>, b: Vec<Int>): Vec<Vec<Int>>
  var result = vec_new<Vec<Int>>()
  var n = a.size
  if b.size < n
    n = b.size
  end
  var i = 0
  while i < n
    var pair = vec_new<Int>()
    pair.push(a[i])
    pair.push(b[i])
    result.push(pair)
    i += 1
  end
  return result
end

# Splits a Vec into two by predicate. Returns a two-element Vec where
# result[0] holds the elements matching the predicate (in original order)
# and result[1] holds the rest. Single pass, stable order preserved within
# each side.
def partition(v: Vec<Int>, pred: Fn(Int): Bool): Vec<Vec<Int>>
  var matching = vec_new<Int>()
  var rest = vec_new<Int>()
  var i = 0
  while i < v.size
    var x = v[i]
    if pred(x)
      matching.push(x)
    else
      rest.push(x)
    end
    i += 1
  end
  var result = vec_new<Vec<Int>>()
  result.push(matching)
  result.push(rest)
  return result
end

# ============================================================================
# UFCS Extend Blocks
# ============================================================================

# Method syntax for Option<T>: opt.unwrap(), opt.is_some(), etc.
extend Option
  def unwrap(): T
    match self
      Some(v) => v
      None => panic("called unwrap on None")
    end
  end

  def unwrap_or(fallback: T): T
    match self
      Some(v) => v
      None => fallback
    end
  end

  def is_some(): Bool
    self is Some
  end

  def is_none(): Bool
    self is None
  end
end

# Method syntax for Result<T, E>: res.unwrap(), res.is_ok(), etc.
extend Result
  def unwrap(): T
    match self
      Ok(v) => v
      Err(e) => panic("called unwrap_ok on Err")
    end
  end

  def unwrap_err(): E
    match self
      Ok(v) => panic("called unwrap_err on Ok")
      Err(e) => e
    end
  end

  def is_ok(): Bool
    self is Ok
  end

  def is_err(): Bool
    self is Err
  end
end

# MAP-NEW-DECLARE-MISSING reproducer — remove after fix.
def group_by(v: Vec<Int>, key_fn: Fn(Int): Int): Map<Int, Vec<Int>>
  var result: Map<Int, Vec<Int>> = map_new()
  var i = 0
  while i < v.size
    var x = v[i]
    var k = key_fn(x)
    if result.has(k)
      var bucket: Vec<Int> = result.get(k).unwrap()
      bucket.push(x)
    else
      var bucket = vec_new<Int>()
      bucket.push(x)
      result.set(k, bucket)
    end
    i += 1
  end
  return result
end
