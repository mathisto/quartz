## std/net/tls13/alert — TLS 1.3 alert protocol (RFC 8446 §6)
##
## NET.5c.1 substrate. Alert messages are 2 bytes on the wire — { level u8,
## description u8 } — typically encrypted inside a TLSCiphertext (the record
## layer handles that; this module just encodes / decodes the 2 bytes).
##
## TLS 1.3 §6.2 deprecates the "warning" level entirely except for
## `user_canceled` and `close_notify`; for v1 we still emit / parse the
## level byte but only act on `fatal` for non-close_notify alerts.

import * from ffi/socket

# AlertLevel (RFC 8446 §6).
def ALERT_LEVEL_WARNING(): Int = 1
def ALERT_LEVEL_FATAL(): Int = 2

# AlertDescription (RFC 8446 §6 — every code defined for TLS 1.3).
def ALERT_CLOSE_NOTIFY(): Int = 0
def ALERT_UNEXPECTED_MESSAGE(): Int = 10
def ALERT_BAD_RECORD_MAC(): Int = 20
def ALERT_RECORD_OVERFLOW(): Int = 22
def ALERT_HANDSHAKE_FAILURE(): Int = 40
def ALERT_BAD_CERTIFICATE(): Int = 42
def ALERT_UNSUPPORTED_CERTIFICATE(): Int = 43
def ALERT_CERTIFICATE_REVOKED(): Int = 44
def ALERT_CERTIFICATE_EXPIRED(): Int = 45
def ALERT_CERTIFICATE_UNKNOWN(): Int = 46
def ALERT_ILLEGAL_PARAMETER(): Int = 47
def ALERT_UNKNOWN_CA(): Int = 48
def ALERT_ACCESS_DENIED(): Int = 49
def ALERT_DECODE_ERROR(): Int = 50
def ALERT_DECRYPT_ERROR(): Int = 51
def ALERT_PROTOCOL_VERSION(): Int = 70
def ALERT_INSUFFICIENT_SECURITY(): Int = 71
def ALERT_INTERNAL_ERROR(): Int = 80
def ALERT_INAPPROPRIATE_FALLBACK(): Int = 86
def ALERT_USER_CANCELED(): Int = 90
def ALERT_MISSING_EXTENSION(): Int = 109
def ALERT_UNSUPPORTED_EXTENSION(): Int = 110
def ALERT_UNRECOGNIZED_NAME(): Int = 112
def ALERT_BAD_CERTIFICATE_STATUS_RESPONSE(): Int = 113
def ALERT_UNKNOWN_PSK_IDENTITY(): Int = 115
def ALERT_CERTIFICATE_REQUIRED(): Int = 116
def ALERT_NO_APPLICATION_PROTOCOL(): Int = 120

## Encode an alert into a caller-provided 2-byte buffer.
def alert_encode(buf: Int, level: Int, description: Int): Void
  ptr_write_byte(buf,     level & 0xff)
  ptr_write_byte(buf + 1, description & 0xff)
end

## Decode an alert from a 2-byte buffer. Returns the description; level
## lands in `level_out` via ptr-write. Returns -1 if buf is too short
## (signalled via len; this is called against a record payload that's
## already-length-validated by the record layer, so len < 2 is unusual).
def alert_decode(buf: Int, len: Int, level_out: Int): Int
  if len < 2 then return 0 - 1 end
  ptr_write_byte(level_out, ptr_read_byte(buf))
  return ptr_read_byte(buf + 1)
end

## True (1) if this alert is fatal: any `level == fatal`, plus
## `close_notify` (which is fatal-for-the-connection regardless of level).
def alert_is_fatal(level: Int, description: Int): Int
  if level == ALERT_LEVEL_FATAL() then return 1 end
  if description == ALERT_CLOSE_NOTIFY() then return 1 end
  return 0
end
