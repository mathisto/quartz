# std/net/http_server.qz - HTTP/1.1 + HTTP/2 Server (The Quartz Way)
#
# Supervised goroutine-per-connection server on the M:N scheduler with
# Sinatra-shaped block-DSL routing via the `HttpRoute` effect
# (Phase 6.1.d). Two entry shapes:
#
#   - `http_serve(port) do -> ... end`            — block DSL (recommended)
#   - `http_serve_supervised(config, handler)`    — config + single dispatcher
#   - `https_serve_supervised(config, tls, hdlr)` — TLS counterpart (ALPN h2/h1.1)
#
# Cross-platform; per-connection supervisor restart on handler crash;
# graceful shutdown via SIGTERM/SIGINT or `http_server_shutdown()`;
# unified-select listener loop via `tcp_acceptable`.
#
# Example - Hello World (block DSL, v1):
#   import std/net/http_server
#
#   def main(): Int
#     http_serve(8080) do ->
#       route_get("/", req: Request -> text_response("Hello, Quartz!"))
#     end
#     return 0
#   end
#
# Example - Multiple routes:
#   import std/net/http_server
#
#   def main(): Int
#     http_serve(8080) do ->
#       route_get("/", req: Request -> text_response("Hello!"))
#       route_get("/users/:id", req: Request -> {
#         var id = route_param("/users/:id", req.path, "id")
#         json_response("{\"id\":" + id + "}")
#       })
#       route_post("/echo", req: Request -> text_response(req.body))
#     end
#     return 0
#   end
#
# Example - Single-dispatcher form (no routing DSL):
#   import std/net/http_server
#
#   def main(): Int
#     var r = router_new()
#     r.router_get("/") do req: Request ->
#       text_response("Hello!")
#     end
#     http_serve_supervised(http_server_config(8080),
#                           r.router_handler() | with_logging)
#     return 0
#   end

# =============================================================================
# FFI Declarations (inline — extern "C" def doesn't cross module boundaries yet)
# =============================================================================

extern "C" def socket(domain: CInt, socket_type: CInt, protocol: CInt): CInt
extern "C" def connect(sockfd: CInt, addr: CPtr, addrlen: CInt): CInt
extern "C" def bind(sockfd: CInt, addr: CPtr, addrlen: CInt): CInt
extern "C" def listen(sockfd: CInt, backlog: CInt): CInt
extern "C" def accept(sockfd: CInt, addr: CPtr, addrlen: CPtr): CInt
extern "C" def sendto(sockfd: CInt, buf: CPtr, len: CSize, flags: CInt, addr: CPtr, addrlen: CInt): Int
extern "C" def recvfrom(sockfd: CInt, buf: CPtr, len: CSize, flags: CInt, addr: CPtr, addrlen: CPtr): Int

# Wrappers: use sendto/recvfrom with NULL addr to avoid channel intrinsic collision
def socket_send(sockfd: Int, buf: Int, len: Int, flags: Int): Int
  sendto(sockfd, buf, len, flags, int_to_cptr(0), 0)
end

def socket_recv(sockfd: Int, buf: Int, len: Int, flags: Int): Int
  recvfrom(sockfd, buf, len, flags, int_to_cptr(0), int_to_cptr(0))
end
extern "C" def shutdown(sockfd: CInt, how: CInt): CInt
extern "C" def close(fd: CInt): CInt

# Phase 8b step 1 — close-fd cross-target shim.
# Hosted: libc close(fd). Freestanding: route through the kernel's
# kern_tcp_close which sends FIN + transitions the slot to FIN_SENT.
# Used by `http_serve_supervised`'s load-shed branch + a few TLS-path
# close sites. Keeps the per-call-site code identical across targets.
@cfg(not: os: "unknown")
def _http_close_fd(fd: Int): Int = close(fd)

@cfg(os: "unknown")
def _http_close_fd(fd: Int): Int
  # fd is the kernel conn slot ptr (fd ≡ slot ptr).
  var _ignore_kc = kern_tcp_close(fd)
  return 0
end
extern "C" def setsockopt(sockfd: CInt, level: CInt, optname: CInt, optval: CPtr, optlen: CInt): CInt
extern "C" def htons(hostshort: CInt): CInt
extern "C" def inet_pton(af: CInt, src: CPtr, dst: CPtr): CInt
extern "C" def malloc(size: CSize): CPtr
extern "C" def free(ptr: CPtr): Void
extern "C" def memset(ptr: CPtr, value: CInt, size: CSize): CPtr
extern "C" def strlen(str: CPtr): CSize
extern "C" def fcntl(fd: CInt, cmd: CInt, arg: CInt): CInt

# POSIX signal() — used to install SIG_IGN for SIGPIPE so a write to a
# peer-closed socket returns EPIPE instead of terminating the process.
# SIG_IGN is canonically `(void (*)(int)) 1` — pass as int_to_cptr(1).
extern "C" def signal(sig: CInt, handler: CPtr): CPtr

# TLS FFI (inline since extern C doesn't cross modules)
extern "C" def OPENSSL_init_ssl(opts: Int, settings: CPtr): CInt
extern "C" def TLS_server_method(): CPtr
extern "C" def SSL_CTX_new(method: CPtr): CPtr
extern "C" def SSL_CTX_free(ctx: CPtr): Void
extern "C" def SSL_CTX_use_certificate_file(ctx: CPtr, file: CPtr, file_type: CInt): CInt
extern "C" def SSL_CTX_use_PrivateKey_file(ctx: CPtr, file: CPtr, file_type: CInt): CInt
extern "C" def SSL_CTX_check_private_key(ctx: CPtr): CInt
extern "C" def SSL_CTX_ctrl(ctx: CPtr, cmd: CInt, larg: Int, parg: CPtr): Int

# SSL_CTX_set_min_proto_version is a macro in OpenSSL — wrap SSL_CTX_ctrl.
# SSL_CTRL_SET_MIN_PROTO_VERSION = 123
def SSL_CTX_set_min_proto_version(ctx: CPtr, version: Int): Int
  return SSL_CTX_ctrl(ctx, 123, version, int_to_cptr(0))
end
extern "C" def SSL_new(ctx: CPtr): CPtr
extern "C" def SSL_free(ssl: CPtr): Void
extern "C" def SSL_set_fd(ssl: CPtr, fd: CInt): CInt
extern "C" def SSL_accept(ssl: CPtr): CInt
extern "C" def SSL_read(ssl: CPtr, buf: CPtr, num: CInt): CInt
extern "C" def SSL_write(ssl: CPtr, buf: CPtr, num: CInt): CInt
extern "C" def SSL_shutdown(ssl: CPtr): CInt
extern "C" def SSL_get_error(ssl: CPtr, ret: CInt): CInt
extern "C" def SSL_pending(ssl: CPtr): CInt
extern "C" def ERR_clear_error(): Void
def SSL_FILETYPE_PEM(): Int = 1
def TLS1_2_VERSION(): Int = 0x0303
def SSL_ERROR_WANT_READ(): Int = 2
def SSL_ERROR_WANT_WRITE(): Int = 3

# ALPN FFI (for HTTP/2 negotiation)
extern "C" def SSL_CTX_set_alpn_select_cb(ctx: CPtr, cb: CPtr, arg: CPtr): Void
extern "C" def SSL_get0_alpn_selected(ssl: CPtr, data: CPtr, len: CPtr): Void
extern "C" def SSL_select_next_proto(out: CPtr, outlen: CPtr, server: CPtr, server_len: CInt, client: CPtr, client_len: CInt): CInt

