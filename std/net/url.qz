# URL Encoding/Decoding — Standard Library
#
# Provides percent-encoding (RFC 3986) utilities for URL components.
# Used by HTTP server for query string parsing and cookie values.
#
# Example:
#   import std/net/url
#   var decoded = url_decode("hello%20world")   # "hello world"
#   var encoded = url_encode("hello world")     # "hello%20world"

# =============================================================================
# Hex Helpers
# =============================================================================

def _hex_val(c: Int): Int
  if c >= '0' and c <= '9'
    return c - 48
  end
  if c >= 'A' and c <= 'F'
    return c - 55
  end
  if c >= 'a' and c <= 'f'
    return c - 87
  end
  return -1
end

def _byte_to_hex(b: Int): String
  var hi = band(shr(b, 4), 15)
  var lo = band(b, 15)
  var hex_chars = "0123456789ABCDEF"
  return str_from_char(str_byte_at(hex_chars, hi)) + str_from_char(str_byte_at(hex_chars, lo))
end

# =============================================================================
# URL Decode
# =============================================================================

## Decode a percent-encoded string.
## %XX → byte value, + → space. Malformed sequences pass through literally.
def url_decode(s: String): String
  var len = str_byte_len(s)
  var sb = sb_new()
  var i = 0
  while i < len
    var c = str_byte_at(s, i)
    if c == '%'
      if i + 2 < len
        var h1 = _hex_val(str_byte_at(s, i + 1))
        var h2 = _hex_val(str_byte_at(s, i + 2))
        if h1 >= 0 and h2 >= 0
          sb.append_char(h1 * 16 + h2)
          i = i + 3
        else
          # Malformed — pass through literally
          sb.append_char(c)
          i = i + 1
        end
      else
        # Not enough chars — pass through literally
        sb.append_char(c)
        i = i + 1
      end
    elsif c == '+'
      sb.append_char(' ')
      i = i + 1
    else
      sb.append_char(c)
      i = i + 1
    end
  end
  return sb.to_string()
end

# =============================================================================
# URL Encode
# =============================================================================

## Percent-encode a string for use in URLs.
## Unreserved chars (A-Z, a-z, 0-9, - . _ ~) pass through. All others → %XX.
def url_encode(s: String): String
  var len = str_byte_len(s)
  var sb = sb_new()
  var i = 0
  while i < len
    var c = str_byte_at(s, i)
    if (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '-' or c == '.' or c == '_' or c == '~'
      sb.append_char(c)
    else
      sb.append("%")
      sb.append(_byte_to_hex(c))
    end
    i = i + 1
  end
  return sb.to_string()
end
