## std/net/wireguard/peer - Configured WireGuard peer
##
## A `Peer` is a remote WireGuard endpoint identified by its 32-byte Curve25519
## static public key. Peers are configured out-of-band (no PKI in WG).
##
## Per-peer state covered here:
##   - static_pub:  32 bytes — peer's identity (canonical lookup key)
##   - psk:         32 bytes — pre-shared key (zero buffer if "no PSK")
##   - endpoint:    UDP IPv4 + port — last-known remote address
##
## NOT covered here (split for clarity):
##   - active session keys + counters → std/net/wireguard/session
##   - replay window → std/net/wireguard/session (replay state is tied to a
##                     specific session, not the peer)
##   - rekey/keepalive timers → std/net/wireguard/timers (Step 2.3)
##   - peer table + allowed_ips routing → std/net/wireguard/device (Step 2.4)
##
## A Peer is identified by `static_pub` for handshake routing. Two Peers with
## the same static_pub MUST NOT coexist in the same device's peer table (the
## receiver can't disambiguate a MSG_INITIATION from one vs the other).
## Higher layers enforce this; peer.qz does not.
##
## See docs/design/WIREGUARD_UNIKERNEL_DESIGN.md "Files to touch".

import std/core/crypto/subtle
import std/core/crypto/zeroize
import * from ffi/socket  # malloc/free/memcpy/memset

# =============================================================================
# Endpoint — UDP/IPv4 address pair
# =============================================================================

## A peer's UDP transport address. IPv4 only for Phase 1; IPv6 deferred to
## Phase 2 alongside unikernel IPv6 support.
##
## ip_be: 32-bit IPv4 address in network byte order — same layout `inet_pton`
##        writes into `sin_addr`. All-zero = unconfigured.
## port:  UDP port in host byte order (0..65535). Zero = unconfigured.
struct EndpointV4
  ip_be: Int
  port: Int
end

def endpoint_v4(ip_be: Int, port: Int): EndpointV4
  return EndpointV4 { ip_be: ip_be, port: port }
end

def endpoint_v4_unset(): EndpointV4
  return EndpointV4 { ip_be: 0, port: 0 }
end

def endpoint_v4_is_set(e: EndpointV4): Int
  if e.ip_be == 0 and e.port == 0
    return 0
  end
  return 1
end

# =============================================================================
# Peer
# =============================================================================

## A configured remote WireGuard peer.
##
## Underlying buffer: 64 bytes laid out as `[0..32) static_pub` + `[32..64) psk`.
## The endpoint is stored inline. `peer_destroy` zeroes the PSK before freeing.
struct Peer
  buf: Int            # malloc'd 64 bytes
  endpoint: EndpointV4
end

## Construct a Peer.
##
## Args:
## - static_pub_src: pointer to 32 bytes of peer's static Curve25519 pubkey.
## - psk_src: pointer to 32 bytes of PSK, or 0 to use an all-zero PSK
##            (equivalent to "no PSK" — IKpsk2's PSK input is the empty buffer
##            represented as 32 zero bytes).
## - endpoint: peer's UDP address. Use `endpoint_v4_unset()` if unknown until
##             first incoming packet from peer (peer roaming, WG paper §5.1.3).
def peer_new(static_pub_src: Int, psk_src: Int, endpoint: EndpointV4): Peer
  var buf = malloc(64)
  memcpy(buf, static_pub_src, 32)
  if psk_src == 0
    memset(buf + 32, 0, 32)
  else
    memcpy(buf + 32, psk_src, 32)
  end
  return Peer { buf: buf, endpoint: endpoint }
end

## Wipe PSK + free state buffer. The Peer value must not be used after.
def peer_destroy(p: Peer): Void
  zeroize(p.buf, 64)
  free(p.buf)
end

# =============================================================================
# Internal-use accessors — never expose the returned pointers across module
# boundaries that could write into wire format.
# =============================================================================

def peer_static_pub(p: Peer): Int
  return p.buf
end

def peer_psk(p: Peer): Int
  return p.buf + 32
end

## Constant-time compare a peer's static pubkey against an external 32-byte
## buffer. Returns 1 on match, 0 otherwise. Used by the responder side of the
## handshake to identify the peer that sent MSG_INITIATION.
def peer_static_pub_eq(p: Peer, other_pub: Int): Int
  return ct_eq_bytes(p.buf, other_pub, 32)
end
