# std/net/udp.qz - UDP networking
#
# Usage:
#   import std/net/udp
#
#   match udp_bind(0)  # 0 = ephemeral port
#     UdpResult::Ok(sock) => {
#       udp_send_to(sock, "hello", "127.0.0.1", 9999)
#       udp_close(sock)
#     }
#     UdpResult::Err(e) => puts(e.message)
#   end

import std/ffi/socket

struct UdpSocket
  fd: Int
  port: Int
end

enum UdpResult
  Ok(socket: UdpSocket)
  Err(error: TcpError)
end

# Bind a UDP socket to a local port (0 for ephemeral)
def udp_bind(port: Int): UdpResult
  fd = socket(AF_INET(), SOCK_DGRAM(), 0)
  if fd < 0
    return UdpResult::Err(tcp_error("Failed to create UDP socket", fd))
  end

  var optval = 1
  setsockopt(fd, SOL_SOCKET(), SO_REUSEADDR(), addr_of(optval), 4)

  var addr = SockaddrIn {
    sin_len: 16,
    sin_family: AF_INET(),
    sin_port: htons(port),
    sin_addr: 0,
    sin_zero: 0
  }

  addr_ptr = addr_of(addr)
  bind_result = bind(fd, addr_ptr, 16)
  if bind_result < 0
    close(fd)
    return UdpResult::Err(tcp_error("UDP bind failed", bind_result))
  end

  # Get assigned port if ephemeral (port == 0)
  var actual_port = port
  if port == 0
    var local_addr = SockaddrIn {
      sin_len: 16,
      sin_family: AF_INET(),
      sin_port: 0,
      sin_addr: 0,
      sin_zero: 0
    }
    var len = 16
    getsockname(fd, addr_of(local_addr), addr_of(len))
    actual_port = ntohs(local_addr.sin_port)
  end

  UdpResult::Ok(UdpSocket { fd: fd, port: actual_port })
end

# Send data to a specific host:port
def udp_send_to(sock: UdpSocket, data: String, host: String, port: Int): WriteResult
  var addr = SockaddrIn {
    sin_len: 16,
    sin_family: AF_INET(),
    sin_port: htons(port),
    sin_addr: 0,
    sin_zero: 0
  }

  host_cstr = string_to_cstr(host)
  sin_addr_ptr = addr_of(addr.sin_addr)
  inet_pton(AF_INET(), host_cstr, sin_addr_ptr)

  data_cstr = string_to_cstr(data)
  len = strlen(data_cstr)
  bytes_sent = sendto(sock.fd, data_cstr, len, 0, addr_of(addr), 16)

  if bytes_sent < 0
    return WriteResult::Err(tcp_error("UDP send failed", bytes_sent))
  end
  WriteResult::Ok(bytes_sent)
end

# Receive data (up to max_bytes)
def udp_recv_from(sock: UdpSocket, max_bytes: Int): ReadResult
  buf = malloc(max_bytes + 1)
  if buf == 0
    return ReadResult::Err(tcp_error("Failed to allocate buffer", 0))
  end

  var sender_addr = SockaddrIn {
    sin_len: 16,
    sin_family: AF_INET(),
    sin_port: 0,
    sin_addr: 0,
    sin_zero: 0
  }
  var addr_len = 16
  bytes_read = recvfrom(sock.fd, buf, max_bytes, 0, addr_of(sender_addr), addr_of(addr_len))

  if bytes_read < 0
    mem_free(buf)
    return ReadResult::Err(tcp_error("UDP recv failed", bytes_read))
  end

  memset(buf + bytes_read, 0, 1)
  data = buf
  ReadResult::Ok(data)
end

# Close a UDP socket
def udp_close(sock: UdpSocket): Int
  close(sock.fd)
end
