## std/streams.qz — Effect-polymorphic stream combinators.
##
## P3.F.4: callbacks now carry a row variable `e` that propagates through
## the combinator's return row. The source iterator is still AsyncIterator
## (the body uses `for await`), so the combinator row always subsumes
## `{Async}` — but a pure callback binds `e = {}` at the caller and an
## async callback binds `e = {Async, ...}`, letting both flow through the
## same function. F.3c (Iterator-row propagation) will widen this further
## so the SOURCE can also be pure; today it's fixed async.
##
## Supports composition: stream_filter(stream_map(source, f), pred).

## Transform each value through a mapping function.
## stream_map(numbers(), x -> x * 2) yields doubled values.
def stream_map<e>(src: impl AsyncIterator<Int>, f: Fn(Int): Int can e): impl AsyncIterator<Int> can e
  for await v in src
    yield f(v)
  end
end

## Keep only values matching a predicate.
## stream_filter(numbers(), x -> x % 2 == 0) yields even values.
def stream_filter<e>(src: impl AsyncIterator<Int>, pred: Fn(Int): Bool can e): impl AsyncIterator<Int> can e
  for await v in src
    if pred(v)
      yield v
    end
  end
end

## Take only the first n values from a source.
## stream_take_first(counting(), 5) yields values 1..5.
def stream_take_first(src: impl AsyncIterator<Int>, n: Int): impl AsyncIterator<Int>
  var count = 0
  for await v in src
    if count < n
      yield v
    end
    count = count + 1
  end
end

## Collect all values from an async iterator into a Vec.
def stream_collect(src: impl AsyncIterator<Int>): Vec<Int>
  var result = vec_new<Int>()
  for await v in src
    result.push(v)
  end
  return result
end

## Sum all values from an async iterator.
def stream_sum(src: impl AsyncIterator<Int>): Int
  var total = 0
  for await v in src
    total = total + v
  end
  return total
end

## Count the number of values in an async iterator.
def stream_count(src: impl AsyncIterator<Int>): Int
  var n = 0
  for await v in src
    n = n + 1
  end
  return n
end

## Apply a function to each value (for side effects), yielding the values unchanged.
def stream_inspect<e>(src: impl AsyncIterator<Int>, f: Fn(Int): Void can e): impl AsyncIterator<Int> can e
  for await v in src
    f(v)
    yield v
  end
end

## Skip the first n values from a source.
def stream_skip(src: impl AsyncIterator<Int>, n: Int): impl AsyncIterator<Int>
  var count = 0
  for await v in src
    if count >= n
      yield v
    end
    count = count + 1
  end
end

## Yield values while predicate is true, then stop.
def stream_take_while<e>(src: impl AsyncIterator<Int>, pred: Fn(Int): Bool can e): impl AsyncIterator<Int> can e
  for await v in src
    if pred(v)
      yield v
    else
      return
    end
  end
end

## Skip values while predicate is true, then yield the rest.
def stream_skip_while<e>(src: impl AsyncIterator<Int>, pred: Fn(Int): Bool can e): impl AsyncIterator<Int> can e
  var skipping = 1
  for await v in src
    if skipping == 1
      if pred(v) == false
        skipping = 0
        yield v
      end
    else
      yield v
    end
  end
end

## Enumerate values with their index: yields index * 1000000 + value.
## (Simplified encoding since we don't have tuples in async iterators yet.)
def stream_enumerate(src: impl AsyncIterator<Int>): impl AsyncIterator<Int>
  var idx = 0
  for await v in src
    yield idx * 1000000 + v
    idx = idx + 1
  end
end
