def SPIN_BOUNCING_BALL(): Int = 7
def SPIN_BOX(): Int = 8
def SPIN_CIRCLE(): Int = 9
def SPIN_CIRCLE_HALVES(): Int = 10
def SPIN_MOON(): Int = 11
def SPIN_EARTH(): Int = 12
def SPIN_AESTHETIC(): Int = 13
def SPIN_TRIANGLE(): Int = 14
def SPIN_PONG(): Int = 15
def SPIN_GROW_VERTICAL(): Int = 16
def SPIN_GROW_HORIZONTAL(): Int = 17
def SPIN_BALLOON(): Int = 18
def SPIN_NOISE(): Int = 19
def SPIN_BOUNCE(): Int = 20
def SPIN_BOX_BOUNCE(): Int = 21
def SPIN_SIMPLE_DOTS(): Int = 22
def SPIN_SIMPLE_DOTS_SCROLLING(): Int = 23
def SPIN_STAR(): Int = 24
def SPIN_FLIP(): Int = 25
