var _spin_frames_registry: Vec<Vec<String>> = vec_new()
var _spin_interval_registry: Vec<Int> = vec_new()
var _spin_initialized = 0

def _spin_register(frames: Vec<String>, interval_ms: Int): Void
  _spin_frames_registry.push(frames)
  _spin_interval_registry.push(interval_ms)
end

def _spin_init(): Void
  if _spin_initialized == 1
    return
  end
  _spin_initialized = 1

  # SPIN_DOTS — 0 — Braille rotation, the canonical spinner
  var dots = vec_new<String>()
  dots.push("⠋")
  dots.push("⠙")
  dots.push("⠹")
  dots.push("⠸")
  dots.push("⠼")
  dots.push("⠴")
  dots.push("⠦")
  dots.push("⠧")
  dots.push("⠇")
  dots.push("⠏")
  _spin_register(dots, 80)

  # SPIN_DOTS2 — 1
  var dots2 = vec_new<String>()
