  dots2.push("⣟")
  dots2.push("⣯")
  dots2.push("⣷")
  _spin_register(dots2, 80)

  # SPIN_LINE — 2 — ASCII fallback
  var line = vec_new<String>()
  line.push("-")
  line.push("\\")
  line.push("|")
  line.push("/")
  _spin_register(line, 130)

  # SPIN_PIPE — 3
