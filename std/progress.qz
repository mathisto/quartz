## std/progress.qz — Composable progress bars and spinners.
##
## Design philosophy:
##   * Columns are first-class typechecked values, not strings.
##   * A small template grammar parses to the same column vector, so users
##     who want a one-liner can have one — both paths converge to one engine.
##   * The template grammar is OPEN: callers can register custom column keys.
##   * Three output modes auto-selected: tty (ANSI), dumb (CI), json (NDJSON).
##   * Spring-damper smoothing makes percent jumps feel buttery.
##   * Ticking is driven by the M:N scheduler, not a background OS thread.
##
## Inspired by:
##   - lipgloss / bubbles (Charm, Go) — column composition + spring smoothing
##   - rich.progress (Python) — columns-as-renderables
##   - Rust's mainstream progress-bar crate — pioneered the {key:width.fg} grammar
##   - cli-spinners (npm) — canonical named frame data, vendored verbatim
##
## Usage:
##   import * from progress
##
##   # One-liner spinner
##   sp = Spinner_start("Fetching data")
##   do_work()
##   sp.success("Done")
##
##   # Builder
##   pb = Progress.new(1024).label("Downloading").template("{spinner} [{bar:40.cyan}] {pos}/{len} ({eta})")
##   pb.start()
##   for i in 0..1024
##     pb.inc(1)
##   end
##   pb.finish()
##
##   # Preset
##   pb = Progress.download(file_size).label(url).start()
##
## @since 5.28.0

import style
import terminal
import time
import * from std/sync/exclusion/mutex

# =============================================================================
# Constants — column kinds, statuses, output modes
# =============================================================================

def COL_TEXT(): Int = 0
def COL_SPINNER(): Int = 1
def COL_BAR(): Int = 2
def COL_POS(): Int = 3
def COL_LEN(): Int = 4
def COL_POS_LEN(): Int = 5
def COL_PERCENT(): Int = 6
def COL_ETA(): Int = 7
def COL_RATE(): Int = 8
def COL_ELAPSED(): Int = 9
def COL_MSG(): Int = 10
def COL_BYTES(): Int = 11
def COL_LABEL(): Int = 12
def COL_CUSTOM(): Int = 100

def STATUS_RUNNING(): Int = 0
def STATUS_OK(): Int = 1
def STATUS_FAIL(): Int = 2
def STATUS_WARN(): Int = 3
def STATUS_INFO(): Int = 4
def STATUS_CANCEL(): Int = 5

def PROGRESS_MODE_AUTO(): Int = -1
def PROGRESS_MODE_TTY(): Int = 0
def PROGRESS_MODE_DUMB(): Int = 1
def PROGRESS_MODE_JSON(): Int = 2
def PROGRESS_MODE_OFF(): Int = 3

# =============================================================================
# Spinner Frame Registry — vendored from cli-spinners (npm)
# =============================================================================
# Frame data is canonical across the CLI animation ecosystem; cli-spinners
# is the de-facto source. Quartz vendors a curated subset; the full set
# (~80 styles) is in the next patch.

def SPIN_DOTS(): Int = 0
def SPIN_DOTS2(): Int = 1
def SPIN_LINE(): Int = 2
def SPIN_PIPE(): Int = 3
def SPIN_ARROW(): Int = 4
def SPIN_ARROW2(): Int = 5
