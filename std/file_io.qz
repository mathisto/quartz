## std/file_io — algebraic effect for filesystem access.
##
## Operation Piezoelectric Effects, Phase 5, Milestone 5.4 (compiler
## dogfooding pilot — testability win).
##
## Declares the `FileIo` effect with four flat ops: `fio_read`,
## `fio_write`, `fio_exists`, `fio_list_dir`. Callers inside a
## `with FileIo { fio_read: h, ... } do ... end` block delegate
## filesystem access to the handler instead of the libc-backed
## intrinsics (`read_file` / `write_file` / `file_exists` / `readdir`).
##
## Op names are intentionally distinct from the intrinsic names to
## avoid shadowing the intrinsic registry. Migration idiom: replace
## `read_file(p)` with `fio_read(p)` inside a `with FileIo { ... }`
## block. Unmigrated call sites continue to use the intrinsic directly.
##
## Usage:
##
##   import std/file_io
##
##   def mock_read(op_name: Int, argc: Int, argv: Int): Int
##     var path = as_string(load(argv, 0))
##     if path == "foo.qz" then return as_int("def foo() = 1")
##     return as_int("")
##   end
##
##   def main(): Int
##     with FileIo { fio_read: mock_read } do ->
##       var src = fio_read("foo.qz")
##       puts(src)
##     end
##     return 0
##   end
##
## Handle-based ops (`open_file` / `fread` / `fwrite` / `close_file`)
## are explicitly NOT declared here — they require token-indirection
## handler state that Phase 5.4 defers to a follow-up design memo.
## Users needing streaming file I/O continue to call the intrinsics
## directly until the design lands.
##
## Default handler: installed in the main prelude (Phase 5.4.b),
## forwards to the corresponding intrinsic. So `fio_read(p)` outside
## any `with FileIo` block behaves exactly like `read_file(p)`.
## Custom handlers unlock test fixtures (`with FileIo { fio_read:
## mock_reader } do -> compile(...) end`) and sandbox policies
## (`with FileIo { fio_read: deny_all } do -> run_untrusted() end`).
##
## All four ops are kind=1 (function-kind): the handler runs, returns,
## and execution continues at the perform site. No continuation capture,
## no unwind semantics.
##
## Handler ABI: `(op_name: Int, argc: Int, argv: Int): Int`. Decode
## args via `as_string(load(argv, 0))` for path/content strings.
## Encode String return values with `as_int(s)` — the runtime treats
## the i64 return as the op's typed result (pointer-as-int for
## String, raw Int for Bool).

effect FileIo
  def fio_read(path: String): String
  def fio_write(path: String, content: String): Int
  def fio_exists(path: String): Bool
  def fio_list_dir(path: String): Vec<String>
end

## Default handler for `fio_read` — forwards to the `read_file` intrinsic.
def fio_default_read(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  return as_int(read_file(path))
end

## Default handler for `fio_write` — forwards to the `write_file` intrinsic.
def fio_default_write(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  var content = as_string(load(argv, 1))
  return write_file(path, content)
end

## Default handler for `fio_exists` — forwards to the `file_exists` intrinsic.
def fio_default_exists(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  if file_exists(path) then return 1 end
  return 0
end

## Default handler for `fio_list_dir` — forwards to the `readdir` intrinsic.
def fio_default_list_dir(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  return as_int(readdir(path))
end
