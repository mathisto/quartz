# Stream — Convenience wrappers for standard I/O
#
# Thin wrappers around Quartz I/O builtins for ergonomic use.
#
# Example:
#   import io/stream
#   println("Hello, world!")
#   var line = read_stdin_line()

## Print a string followed by a newline to stdout.
def println(s: String): Void
  puts(s)
end

## Print a string followed by a newline to stderr.
def eprintln(s: String): Void
  eputs(s)
end

## Print a string to stdout without a trailing newline.
def write_stdout(s: String): Void
  print(s)
end

## Print a string to stderr without a trailing newline.
def write_stderr(s: String): Void
  eprint(s)
end

## Read a line from stdin.
def read_stdin_line(): String
  return read_line()
end
