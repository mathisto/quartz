# Buffered I/O — BufferedReader and BufferedWriter
#
# Provides buffered wrappers around file handles for efficient I/O.
# Reads/writes in chunks to minimize system calls.
#
# Example:
#   import io/buffered
#   var h = open_file("data.txt", "r")
#   var reader = buffered_reader_new(h)
#   var line = reader.read_line()
#   reader.close()

## BufferedReader — reads from a file handle in chunks.
struct BufferedReader
  _handle: Int
  _buf: String
  _pos: Int
  _buf_size: Int
  _eof: Int
end

## Create a new BufferedReader with default buffer size (8192 bytes).
def buffered_reader_new(handle: Int): BufferedReader
  return BufferedReader {
    _handle: handle,
    _buf: "",
    _pos: 0,
    _buf_size: 8192,
    _eof: 0
  }
end

## Create a new BufferedReader with a specific buffer size.
def buffered_reader_new_sized(handle: Int, size: Int): BufferedReader
  return BufferedReader {
    _handle: handle,
    _buf: "",
    _pos: 0,
    _buf_size: size,
    _eof: 0
  }
end

## Internal: refill the buffer from the file handle.
def _br_refill(r: BufferedReader): Void
  if r._eof
    return
  end
  r._buf = fread(r._handle, r._buf_size)
  r._pos = 0
  if str_byte_len(r._buf) == 0
    r._eof = 1
  end
end

extend BufferedReader
  ## Read a single line from the file. Returns "" at EOF.
  def read_line(&mut self): String
    var sb = sb_new()
    var found = 0
    while found == 0
      # If buffer is exhausted, refill
      if @_pos >= str_byte_len(@_buf)
        _br_refill(self)
        if @_eof
          # Return whatever we accumulated
          return sb.to_string()
        end
      end
      # Scan for newline in current buffer
      var buf_len = str_byte_len(@_buf)
      var i = @_pos
      while i < buf_len
        if str_byte_at(@_buf, i) == '\n'
          # Found newline — append up to it and advance past
          sb.append(str_byte_slice(@_buf, @_pos, i))
          @_pos = i + 1
          found = 1
          i = buf_len  # break
        end
        i += 1
      end
      if found == 0
        # No newline found — append rest of buffer and refill
        sb.append(str_byte_slice(@_buf, @_pos, buf_len))
        @_pos = buf_len
      end
    end
    return sb.to_string()
  end

  ## Read a single byte as an integer. Returns -1 at EOF.
  def read_byte(&mut self): Int
    if @_pos >= str_byte_len(@_buf)
      _br_refill(self)
      if @_eof
        return -1
      end
    end
    var ch = str_byte_at(@_buf, @_pos)
    @_pos += 1
    return ch
  end

  ## Read n bytes as a string. May return fewer bytes at EOF.
  def read_n(&mut self, n: Int): String
    var sb = sb_new()
    var remaining = n
    while remaining > 0
      if @_pos >= str_byte_len(@_buf)
        _br_refill(self)
        if @_eof
          return sb.to_string()
        end
      end
      var available = str_byte_len(@_buf) - @_pos
      if available > remaining
        available = remaining
      end
      sb.append(str_byte_slice(@_buf, @_pos, @_pos + available))
      @_pos += available
      remaining -= available
    end
    return sb.to_string()
  end

  ## Return true if end-of-file has been reached and buffer is exhausted.
  def is_eof(): Bool
    if @_eof
      if @_pos >= str_byte_len(@_buf)
        return true
      end
    end
    return false
  end

  ## Close the underlying file handle.
  def close(&mut self): Void
    if @_handle != 0
      close_file(@_handle)
      @_handle = 0
    end
  end
end

## BufferedWriter — writes to a file handle in chunks.
struct BufferedWriter
  _handle: Int
  _buf: Vec<Int>
  _buf_size: Int
  _written: Int
end

## Create a new BufferedWriter with default buffer size (8192 bytes).
def buffered_writer_new(handle: Int): BufferedWriter
  return BufferedWriter {
    _handle: handle,
    _buf: vec_new(),
    _buf_size: 8192,
    _written: 0
  }
end

## Create a new BufferedWriter with a specific buffer size.
def buffered_writer_new_sized(handle: Int, size: Int): BufferedWriter
  return BufferedWriter {
    _handle: handle,
    _buf: vec_new(),
    _buf_size: size,
    _written: 0
  }
end

## Internal: convert the buffer Vec<Int> of char codes to a string and write it.
def _bw_flush_buf(w: BufferedWriter): Void
  if w._written == 0
    return
  end
  var sb = sb_new()
  var i = 0
  while i < w._written
    sb.append_char(w._buf[i])
    i += 1
  end
  var s = sb.to_string()
  var result = fwrite(w._handle, s, str_byte_len(s))
  w._written = 0
end

## Internal: append a string's bytes to the writer's buffer, flushing as needed.
def _bw_write_data(w: BufferedWriter, data: String): Void
  var len = str_byte_len(data)
  var i = 0
  while i < len
    if w._written >= w._buf_size
      _bw_flush_buf(w)
    end
    # Ensure buf has enough slots
    if w._written >= w._buf.size
      w._buf.push(str_byte_at(data, i))
    else
      vec_set(w._buf, w._written, str_byte_at(data, i))
    end
    w._written += 1
    i += 1
  end
end

extend BufferedWriter
  ## Write a string to the buffer. Flushes when buffer is full.
  def write_str(data: String): Void
    _bw_write_data(self, data)
  end

  ## Write a string followed by a newline.
  def write_line(line: String): Void
    _bw_write_data(self, line)
    _bw_write_data(self, "\n")
  end

  ## Flush the buffer to the file.
  def flush(): Void
    _bw_flush_buf(self)
  end

  ## Flush and close the underlying file handle.
  def close(&mut self): Void
    _bw_flush_buf(self)
    if @_handle != 0
      close_file(@_handle)
      @_handle = 0
    end
  end
end
