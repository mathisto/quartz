# Path — Unix path manipulation
#
# Path wraps a String and provides methods for manipulating file paths.
# Unix-only: uses "/" as the separator.
#
# Example:
#   import io/path
#   var p = path_new("/home/user/docs")
#   p.parent().to_string()     # "/home/user"
#   p.filename()               # "docs"
#   p.join("file.txt").to_string()  # "/home/user/docs/file.txt"

import string

struct Path
  _value: String
end

## Create a new Path from a string.
def path_new(s: String): Path
  return Path { _value: s }
end

## Alias for path_new.
def path_from(s: String): Path
  return Path { _value: s }
end

## Find the last occurrence of "/" in a string. Returns -1 if not found.
def _path_last_slash(s: String): Int
  var len = str_byte_len(s)
  var i = len - 1
  while i >= 0
    if str_byte_at(s, i) == '/'
      return i
    end
    i -= 1
  end
  return -1
end

## Find the last occurrence of "." in a string, starting from `start`. Returns -1 if not found.
def _path_last_dot(s: String, start: Int): Int
  var len = str_byte_len(s)
  var i = len - 1
  while i >= start
    if str_byte_at(s, i) == '.'
      return i
    end
    i -= 1
  end
  return -1
end

## Extract filename from a path string.
def _path_get_filename(s: String): String
  var pos = _path_last_slash(s)
  if pos < 0
    return s
  end
  return str_byte_slice(s, pos + 1, str_byte_len(s))
end

## Extract parent directory from a path string.
def _path_get_parent(s: String): String
  var pos = _path_last_slash(s)
  if pos < 0
    return "."
  end
  if pos == 0
    return "/"
  end
  return str_byte_slice(s, 0, pos)
end

extend Path
  ## Return the path as a string.
  def to_string(): String
    return @_value
  end

  ## Join a segment to this path, returning a new Path.
  def join(segment: String): Path
    var len = str_byte_len(@_value)
    if len == 0
      return path_new(segment)
    end
    # Check if path already ends with /
    if str_byte_at(@_value, len - 1) == '/'
      return path_new(@_value + segment)
    end
    return path_new(@_value + "/" + segment)
  end

  ## Return the parent directory as a new Path.
  ## Returns "." if there is no parent.
  def parent(): Path
    return path_new(_path_get_parent(@_value))
  end

  ## Return the filename component (after the last /).
  ## Returns the entire path if there is no /.
  def filename(): String
    return _path_get_filename(@_value)
  end

  ## Return the filename without its extension.
  def stem(): String
    var name = _path_get_filename(@_value)
    var dot = _path_last_dot(name, 0)
    if dot <= 0
      return name
    end
    return str_byte_slice(name, 0, dot)
  end

  ## Return the file extension (without the dot). Empty string if none.
  def extension(): String
    var name = _path_get_filename(@_value)
    var dot = _path_last_dot(name, 0)
    if dot <= 0
      return ""
    end
    return str_byte_slice(name, dot + 1, str_byte_len(name))
  end

  ## Return true if the path is absolute (starts with /).
  def is_absolute(): Bool
    if str_byte_len(@_value) == 0
      return false
    end
    return str_byte_at(@_value, 0) == '/'
  end

  ## Return true if the path is relative.
  def is_relative(): Bool
    if str_byte_len(@_value) == 0
      return true
    end
    return str_byte_at(@_value, 0) != '/'
  end

  ## Replace the extension, returning a new Path.
  ## If the path has no extension, appends one.
  def with_extension(ext: String): Path
    var name = _path_get_filename(@_value)
    var dot = _path_last_dot(name, 0)
    var parent_str = _path_get_parent(@_value)
    var new_stem = name
    if dot > 0
      new_stem = str_byte_slice(name, 0, dot)
    end
    var new_name = "#{new_stem}.#{ext}"
    if parent_str == "."
      return path_new(new_name)
    end
    return path_new("#{parent_str}/#{new_name}")
  end

  ## Split the path into its components.
  def components(): Vec<String>
    return str_split(@_value, "/")
  end

  ## Check if the path exists on disk.
  def exists(): Bool
    return file_exists(@_value)
  end
end
