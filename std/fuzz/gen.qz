# std/fuzz/gen.qz — Grammar-guided random program generator
#
# Generates valid Quartz programs by walking grammar productions with random choices.
# Uses a depth budget to prevent infinite recursion.
#
# Usage:
#   import std/fuzz/gen
#   rand_seed(42)
#   source = fuzz_generate(fuzz_config_default())

import * from std/random

# =============================================================================
# Configuration
# =============================================================================

struct FuzzConfig
  max_depth: Int
  max_funcs: Int
  max_stmts: Int
  max_params: Int
end

def fuzz_config_default(): FuzzConfig
  return FuzzConfig {
    max_depth: 8,
    max_funcs: 5,
    max_stmts: 10,
    max_params: 3
  }
end

# =============================================================================
# Generator State
# =============================================================================

struct FuzzEnv
  depth: Int
  var_count: Int
  func_count: Int
  sb: Int
  config: FuzzConfig
  ## In-scope mutable variable names for current function
  local_vars: Vec<String>
  ## Track defined helper functions: arities
  func_arities: Vec<Int>
end

def fuzz_env_new(config: FuzzConfig): FuzzEnv
  return FuzzEnv {
    depth: 0,
    var_count: 0,
    func_count: 0,
    sb: sb_new(),
    config: config,
    local_vars: vec_new<String>(),
    func_arities: vec_new()
  }
end

# =============================================================================
# Emit Helpers
# =============================================================================

def _fz_emit(env: FuzzEnv, s: String): Void
  sb_append(env.sb, s)
end

def _fz_emit_indent(env: FuzzEnv, depth: Int): Void
  for _i in 0..depth
    sb_append(env.sb, "  ")
  end
end

def _fz_emit_line(env: FuzzEnv, depth: Int, s: String): Void
  _fz_emit_indent(env, depth)
  sb_append(env.sb, s)
  sb_append(env.sb, "\n")
end

# =============================================================================
# Name Generation
# =============================================================================

def _fz_fresh_var(env: FuzzEnv): String
  var n = env.var_count
  env.var_count = n + 1
  var name = "v#{str_from_int(n)}"
  env.local_vars.push(name)
  return name
end

## Like _fz_fresh_var but does NOT add to local_vars yet.
## Use when the variable should not be referenceable in its own init expr.
def _fz_fresh_var_deferred(env: FuzzEnv): String
  var n = env.var_count
  env.var_count = n + 1
  return "v#{str_from_int(n)}"
end

def _fz_fresh_func(env: FuzzEnv): String
  var n = env.func_count
  env.func_count = n + 1
  return "helper_#{str_from_int(n)}"
end

def _fz_has_vars(env: FuzzEnv): Int
  return env.local_vars.size
end

def _fz_random_var(env: FuzzEnv): String
  if env.local_vars.size == 0
    return "0"
  end
  # A.8 Pass 2: first consumer migration. Dispatches through the
  # `Random` effect's `rand_range_op` rather than the bare `rand_range`
  # intrinsic. End-to-end behavior is identical (blessed default forwards
  # to qz_rand_range), but test handlers can now override via
  # `with Random { rand_range_op: h } do -> fuzz_generate(...) end`.
  return env.local_vars[rand_range_op(0, env.local_vars.size)]
end

# =============================================================================
# Expression Generation
# =============================================================================

def _fz_gen_int_literal(env: FuzzEnv): Void
  _fz_emit(env, str_from_int(rand_range_op(0, 1000)))
end

def _fz_gen_string_literal(env: FuzzEnv): Void
  var choices = vec_new<String>()
  choices.push("\"hello\"")
  choices.push("\"world\"")
  choices.push("\"foo\"")
  choices.push("\"bar\"")
  choices.push("\"\"")
  choices.push("\"test\"")
  _fz_emit(env, choices[rand_range_op(0, choices.size)])
end

def _fz_gen_bool_literal(env: FuzzEnv): Void
  if rand_range_op(0, 2) == 0
    _fz_emit(env, "true")
  else
    _fz_emit(env, "false")
  end
end

def _fz_gen_expr(env: FuzzEnv, target_type: Int): Void
  var has_vars = _fz_has_vars(env) > 0

  if env.depth >= env.config.max_depth
    if target_type == 1
      _fz_gen_string_literal(env)
    elsif target_type == 2
      _fz_gen_bool_literal(env)
    else
      _fz_gen_int_literal(env)
    end
    return
  end

  env.depth += 1

  if target_type == 0
    var choice = rand_range_op(0, 8)
    if choice == 0 or choice == 1
      _fz_gen_int_literal(env)
    elsif choice == 2 and has_vars
      _fz_emit(env, _fz_random_var(env))
    elsif choice == 3
      _fz_emit(env, "(")
      _fz_gen_expr(env, 0)
      var ops = vec_new<String>()
      ops.push(" + ")
      ops.push(" - ")
      ops.push(" * ")
      _fz_emit(env, ops[rand_range_op(0, ops.size)])
      _fz_gen_expr(env, 0)
      _fz_emit(env, ")")
    elsif choice == 4 and env.func_arities.size > 0
      var fi = rand_range_op(0, env.func_arities.size)
      var arity = env.func_arities[fi]
      _fz_emit(env, "helper_#{str_from_int(fi)}(")
      for a in 0..arity
        if a > 0
          _fz_emit(env, ", ")
        end
        _fz_gen_expr(env, 0)
      end
      _fz_emit(env, ")")
    elsif choice == 5
      _fz_emit(env, "(0 - ")
      _fz_gen_expr(env, 0)
      _fz_emit(env, ")")
    else
      _fz_gen_int_literal(env)
    end
  elsif target_type == 1
    var choice = rand_range_op(0, 5)
    if choice == 0 or choice == 1
      _fz_gen_string_literal(env)
    elsif choice == 2
      _fz_emit(env, "str_from_int(")
      _fz_gen_expr(env, 0)
      _fz_emit(env, ")")
    elsif choice == 3
      _fz_gen_string_literal(env)
      _fz_emit(env, " + ")
      _fz_gen_string_literal(env)
    else
      _fz_gen_string_literal(env)
    end
  else
    var choice = rand_range_op(0, 5)
    if choice == 0
      _fz_gen_bool_literal(env)
    elsif choice == 1
      _fz_gen_expr(env, 0)
      var cmp_ops = vec_new<String>()
      cmp_ops.push(" > ")
      cmp_ops.push(" < ")
      cmp_ops.push(" == ")
      cmp_ops.push(" >= ")
      cmp_ops.push(" != ")
      _fz_emit(env, cmp_ops[rand_range_op(0, cmp_ops.size)])
      _fz_gen_expr(env, 0)
    elsif choice == 2
      _fz_gen_bool_literal(env)
      _fz_emit(env, " and ")
      _fz_gen_bool_literal(env)
    elsif choice == 3
      _fz_gen_bool_literal(env)
      _fz_emit(env, " or ")
      _fz_gen_bool_literal(env)
    else
      _fz_gen_bool_literal(env)
    end
  end

  env.depth -= 1
end

# =============================================================================
# Statement Generation
# =============================================================================

def _fz_gen_stmt(env: FuzzEnv, indent: Int): Void
  var has_vars = _fz_has_vars(env) > 0
  var at_limit = env.depth >= env.config.max_depth

  var choice = rand_range_op(0, 10)

  if choice == 0 or choice == 1 or choice == 9
    ## var declaration (all mutable) — add to scope AFTER generating init expr
    var name = _fz_fresh_var_deferred(env)
    _fz_emit_indent(env, indent)
    _fz_emit(env, "var #{name} = ")
    _fz_gen_expr(env, 0)
    _fz_emit(env, "\n")
    env.local_vars.push(name)
  elsif choice == 2 and has_vars
    ## Assignment to existing mutable var
    _fz_emit_indent(env, indent)
    _fz_emit(env, "#{_fz_random_var(env)} = ")
    _fz_gen_expr(env, 0)
    _fz_emit(env, "\n")
  elsif choice == 3 and has_vars
    ## Compound assignment
    _fz_emit_indent(env, indent)
    _fz_emit(env, "#{_fz_random_var(env)} += ")
    _fz_gen_expr(env, 0)
    _fz_emit(env, "\n")
  elsif choice == 4 and not at_limit
    ## If statement — save scope, restore after block
    var saved_size = env.local_vars.size
    env.depth += 1
    _fz_emit_indent(env, indent)
    _fz_emit(env, "if ")
    _fz_gen_expr(env, 2)
    _fz_emit(env, "\n")
    var body_count = rand_range_op(1, 3)
    for _i in 0..body_count
      _fz_gen_stmt(env, indent + 1)
    end
    ## Trim vars created in then-branch
    while env.local_vars.size > saved_size
      env.local_vars.pop()
    end
    if rand_range_op(0, 2) == 0
      _fz_emit_line(env, indent, "else")
      var else_count = rand_range_op(1, 2)
      for _i in 0..else_count
        _fz_gen_stmt(env, indent + 1)
      end
      ## Trim vars created in else-branch
      while env.local_vars.size > saved_size
        env.local_vars.pop()
      end
    end
    _fz_emit_line(env, indent, "end")
    env.depth -= 1
  elsif choice == 5 and not at_limit
    ## While loop — counter declared OUTSIDE loop, body vars scoped
    env.depth += 1
    var ctr = _fz_fresh_var_deferred(env)
    _fz_emit_indent(env, indent)
    _fz_emit(env, "var #{ctr} = 0\n")
    env.local_vars.push(ctr)
    var saved_size = env.local_vars.size
    _fz_emit_indent(env, indent)
    _fz_emit(env, "while #{ctr} < #{str_from_int(rand_range_op(1, 5))}\n")
    _fz_gen_stmt(env, indent + 1)
    _fz_emit_indent(env, indent + 1)
    _fz_emit(env, "#{ctr} += 1\n")
    _fz_emit_line(env, indent, "end")
    ## Trim body vars but keep counter
    while env.local_vars.size > saved_size
      env.local_vars.pop()
    end
    env.depth -= 1
  elsif choice == 6 and not at_limit
    ## For..in loop — iterator scoped to loop body
    env.depth += 1
    var saved_size = env.local_vars.size
    var iter = _fz_fresh_var(env)
    _fz_emit_indent(env, indent)
    _fz_emit(env, "for #{iter} in 0..#{str_from_int(rand_range_op(1, 10))}\n")
    _fz_gen_stmt(env, indent + 1)
    _fz_emit_line(env, indent, "end")
    ## Trim iterator and body vars
    while env.local_vars.size > saved_size
      env.local_vars.pop()
    end
    env.depth -= 1
  elsif choice == 7
    ## puts() call
    _fz_emit_indent(env, indent)
    _fz_emit(env, "puts(")
    _fz_gen_expr(env, 1)
    _fz_emit(env, ")\n")
  elsif choice == 8
    ## print_int() call
    _fz_emit_indent(env, indent)
    _fz_emit(env, "print_int(")
    _fz_gen_expr(env, 0)
    _fz_emit(env, ")\n")
  else
    ## Fallback: var declaration (deferred to avoid self-reference)
    var name = _fz_fresh_var_deferred(env)
    _fz_emit_indent(env, indent)
    _fz_emit(env, "var #{name} = ")
    _fz_gen_expr(env, 0)
    _fz_emit(env, "\n")
    env.local_vars.push(name)
  end
end

# =============================================================================
# Function Generation
# =============================================================================

def _fz_gen_helper_func(env: FuzzEnv): Void
  var name = _fz_fresh_func(env)
  var arity = rand_range_op(0, env.config.max_params + 1)
  env.func_arities.push(arity)

  ## Save and clear local vars for this function scope
  var saved_locals = env.local_vars
  env.local_vars = vec_new<String>()
  var saved_depth = env.depth

  _fz_emit(env, "def #{name}(")
  for i in 0..arity
    if i > 0
      _fz_emit(env, ", ")
    end
    var pname = _fz_fresh_var(env)
    _fz_emit(env, "#{pname}: Int")
  end
  _fz_emit(env, "): Int\n")

  env.depth = 1
  var stmt_count = rand_range_op(1, env.config.max_stmts)
  for _i in 0..stmt_count
    _fz_gen_stmt(env, 1)
  end

  _fz_emit(env, "  return ")
  _fz_gen_expr(env, 0)
  _fz_emit(env, "\n")
  _fz_emit(env, "end\n\n")

  ## Restore previous scope
  env.local_vars = saved_locals
  env.depth = saved_depth
end

# =============================================================================
# Program Generation (top-level)
# =============================================================================

def fuzz_generate(config: FuzzConfig): String
  var env = fuzz_env_new(config)

  ## Generate helper functions
  var func_count = rand_range_op(0, config.max_funcs + 1)
  for _i in 0..func_count
    _fz_gen_helper_func(env)
  end

  ## Generate main — starts with fresh local scope
  env.local_vars = vec_new<String>()
  _fz_emit(env, "def main(): Int\n")
  env.depth = 1

  var stmt_count = rand_range_op(2, config.max_stmts + 1)
  for _i in 0..stmt_count
    _fz_gen_stmt(env, 1)
  end

  _fz_emit(env, "  return 0\n")
  _fz_emit(env, "end\n")

  return sb_to_string(env.sb)
end
