## QSpec - The Quartz Testing Framework
##
## QSpec = RSpec's ergonomics + QuickCheck's power + beautiful CLI output
##
## Usage:
##   import qspec
##
##   describe "Vec" do
##     it "push appends an element" do
##       v = vec_new()
##       vec_push(v, 42)
##       expect(vec_get(v, 0)).to_eq(42)
##     end
##   end
##
##   def main(): Int
##     return qspec_main()
##   end

import * from colors
import * from qspec/matchers
import * from qspec/runner
import * from qspec/formatter
import * from qspec/subprocess
import io/file

# =============================================================================
# Re-exports: All public API available via `import qspec`
# =============================================================================

# From matchers:
#   expect(value: Int): Expectation
#   expect_str(value: String): Expectation
#   expect_bool(value: Bool): Expectation
#   not(e: Expectation): Expectation
#   to_eq(e, expected: Int)
#   to_eq_str(e, expected: String)
#   to_be_gt(e, expected: Int)
#   to_be_lt(e, expected: Int)
#   to_be_gte(e, expected: Int)
#   to_be_lte(e, expected: Int)
#   to_be_true(e)
#   to_be_false(e)
#   qspec_assert(cond: Bool)
#   assert_eq(actual: Int, expected: Int)
#   assert_eq_str(actual: String, expected: String)
#   assert_ne(actual: Int, expected: Int)
#   assert_gt(actual: Int, expected: Int)
#   assert_lt(actual: Int, expected: Int)
#   assert_output(expected: String, f: Fn(): Void)
#   assert_output_contains(expected: String, f: Fn(): Void)

# From subprocess:
#   subprocess_exec_argv(stage: String, argv: Vec<String>): SubResult
#   SubResult preserves outcome/exit_code/signal/timed_out/orphan/cancelled/spawn_error.
#   subprocess_compile(source: String): SubResult
#   subprocess_run(source: String): SubResult
#   assert_compile_fails(source: String)
#   assert_compile_error(source: String, expected: String)
#   assert_compile_succeeds(source: String)
#   assert_ir_contains(source: String, pattern: String)
#   assert_ir_not_contains(source: String, pattern: String)
#   assert_run_exits(source: String, code: Int)
#   assert_run_panics(source: String, expected: String)
#   assert_run_stderr_contains(source: String, expected: String)
#   assert_run_stdout_eq(source: String, expected: String)

# From runner:
#   describe(name: String, block: Fn(): Void)
#   context(name: String, block: Fn(): Void)
#   it(name: String, test_fn: Fn(): Void)
#   it_pending(name: String)
#   fit(name: String, test_fn: Fn(): Void)
#   xit(name: String, test_fn: Fn(): Void)
#   skip(reason: String)
#   skip_unless(condition: Int, reason: String)
#   before(hook: Fn(): Void)
#   after(hook: Fn(): Void)
#   test(name: String, test_fn: Fn(): Void)

# From formatter:
#   format_set_pretty()
#   format_set_progress()
#   format_set_dots()
#   qspec_format()

# =============================================================================
# Main Entry Point
# =============================================================================

_qspec_main_result = vec_new()

## Emit one validated self-report to the file prepared by the parent runner.
## Test code inherits this path and credential, so this record is never
## parent-observed evidence. Ordinary stdout/stderr is not parsed as a record.
priv def _qspec_emit_machine_result(): Void
  var path = getenv("QSPEC_RESULT_PATH")
  if str_byte_len(path) == 0
    return
  end
  var run_id = getenv("QSPEC_RESULT_RUN_ID")
  var file_id = getenv("QSPEC_RESULT_FILE_ID")
  var token = getenv("QSPEC_RESULT_TOKEN")
  var record = "QSPEC_RESULT_V3 {\"schema\":3,\"authority\":\"test_reported\",\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"#{token}\",\"cases\":#{qspec_total()},\"passed\":#{qspec_passed()},\"case_failures\":#{qspec_case_failed()},\"framework_failures\":#{qspec_framework_failure_count()},\"pending\":#{qspec_pending()},\"skipped\":#{qspec_skipped()},\"assertions\":#{qspec_assertions()},\"duration_us\":#{qspec_duration_us()}}\n"
  file.file_append(path, record)
end

## Request a feature exclusion. The parent runner accepts this only when the
## exact selected file and feature pair appears in its registry.
def qspec_exclude_feature(feature: String): Int
  var path = getenv("QSPEC_RESULT_PATH")
  if str_byte_len(path) == 0
    return 0
  end
  var run_id = getenv("QSPEC_RESULT_RUN_ID")
  var file_id = getenv("QSPEC_RESULT_FILE_ID")
  var token = getenv("QSPEC_RESULT_TOKEN")
  file.file_append(path, "QSPEC_EXCLUSION_V1 {\"schema\":1,\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"#{token}\",\"feature\":\"#{feature}\"}\n")
  return 0
end

## Run all tests at most once, format the cached result, and return exit code.
## Call this from your main() function.
##
## ```qz
## def main(): Int
##   # ... test definitions above ...
##   return qspec_main()
## end
## ```
def qspec_main(): Int
  if vec_size(_qspec_main_result) > 0
    if qspec_run() > 0
      return 1
    end
    return 0
  end

  # Auto-detect color support
  colors_auto()

  # Parse format from args (if available)
  # TODO: Parse --progress, --dots, --filter flags from args

  # Run all tests
  var failures = qspec_run()

  # Format output
  qspec_format()

  # Stable self-report consumed by the outer Quake runner. The runner validates
  # its shape and bounds but does not treat test-authored counts as authoritative.
  _qspec_emit_machine_result()

  # Return exit code: 0 = all pass, 1 = failures
  var result = 0
  if failures > 0
    result = 1
  end
  vec_push(_qspec_main_result, result)
  return result
end
