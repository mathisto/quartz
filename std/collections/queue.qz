# Queue — FIFO queue backed by Vec<Int> with head pointer
#
# A simple first-in-first-out queue. Enqueue/dequeue are O(1) amortized.
# When the head pointer advances past half the capacity, elements are
# shifted left to reclaim space (compaction).
#
# Example:
#   import collections/queue
#   var q = queue_new()
#   q.enqueue(1)
#   q.enqueue(2)
#   q.dequeue()   # 1
#   q.peek()      # 2

struct Queue
  _data: Vec<Int>
  _head: Int
end

## Create a new empty queue.
def queue_new(): Queue
  return Queue { _data: vec_new(), _head: 0 }
end

extend Queue
  ## Add a value to the back of the queue.
  def enqueue(val: Int): Void
    @_data.push(val)
  end

  ## Remove and return the front value. Returns Option::None if empty.
  def dequeue(&mut self): Option<Int>
    var total = @_data.size
    if @_head >= total
      return Option::None
    end
    var val = @_data[@_head]
    @_head += 1
    # Compact when head passes half the total length
    var sz = total - @_head
    if @_head > sz
      var i = 0
      while i < sz
        @_data[i] = @_data[@_head + i]
        i += 1
      end
      # Trim the vec back to size
      while @_data.size > sz
        @_data.pop()
      end
      @_head = 0
    end
    return Option::Some(val)
  end

  ## Peek at the front value without removing it. Returns Option::None if empty.
  def peek(): Option<Int>
    if @_head >= @_data.size
      return Option::None
    end
    return Option::Some(@_data[@_head])
  end

  ## Return the number of elements in the queue.
  def size(): Int
    return @_data.size - @_head
  end

  ## Return true if the queue is empty.
  def is_empty(): Bool
    return @_head >= @_data.size
  end

  ## Remove all elements from the queue.
  def clear(&mut self): Void
    vec_clear(@_data)
    @_head = 0
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_data)
  end

  # --- Canonical aliases ---

  ## Alias for enqueue — add to end.
  def push(val: Int): Void
    @_data.push(val)
  end

  ## Alias for dequeue — remove from front.
  def shift(): Option<Int>
    return self.dequeue()
  end

  ## Alias for peek — peek at front.
  def first(): Option<Int>
    return self.peek()
  end

  # --- Higher-order methods ---

  def to_vec(): Vec<Int>
    var result = vec_new()
    var i = @_head
    while i < @_data.size
      result.push(@_data[i])
      i += 1
    end
    return result
  end

  def each(f: Fn(Int): Void): Void
    var i = @_head
    while i < @_data.size
      f(@_data[i])
      i += 1
    end
  end

  def map(f: Fn(Int): Int): Vec<Int>
    var result = vec_new()
    var i = @_head
    while i < @_data.size
      result.push(f(@_data[i]))
      i += 1
    end
    return result
  end

  def filter(f: Fn(Int): Bool): Vec<Int>
    var result = vec_new()
    var i = @_head
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        result.push(val)
      end
      i += 1
    end
    return result
  end

  def reduce(init: Int, f: Fn(Int, Int): Int): Int
    var acc = init
    var i = @_head
    while i < @_data.size
      acc = f(acc, @_data[i])
      i += 1
    end
    return acc
  end

  def find(f: Fn(Int): Bool): Int
    var i = @_head
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        return val
      end
      i += 1
    end
    return 0
  end

  def any?(f: Fn(Int): Bool): Bool
    var i = @_head
    while i < @_data.size
      if f(@_data[i])
        return true
      end
      i += 1
    end
    return false
  end

  def all?(f: Fn(Int): Bool): Bool
    var i = @_head
    while i < @_data.size
      if not f(@_data[i])
        return false
      end
      i += 1
    end
    return true
  end

  def count(f: Fn(Int): Bool): Int
    var n = 0
    var i = @_head
    while i < @_data.size
      if f(@_data[i])
        n += 1
      end
      i += 1
    end
    return n
  end

  ## Return an iterator over queue elements (front to back).
  def iter(): QueueIter
    return QueueIter { _data: @_data, _index: @_head, _end: @_data.size }
  end
end

## QueueIter — iterates over Queue elements from front to back.
struct QueueIter
  _data: Vec<Int>
  _index: Int
  _end: Int
end

extend QueueIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._end
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

import * from traits
extend Queue with Container end
extend Queue with Iterable<Int> end
