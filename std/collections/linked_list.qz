# LinkedList — Doubly-linked list via parallel arrays
#
# A doubly-linked list using array-based slot allocation (parallel Vecs)
# instead of individual heap allocations. Provides O(1) push/pop at both
# ends and O(n) random access.
#
# Example:
#   import collections/linked_list
#   var ll = ll_new()
#   ll.push_back(1)
#   ll.push_back(2)
#   ll.push_front(0)
#   ll.pop_front()   # 0
#   ll.pop_back()    # 2

struct LinkedList
  _data: Vec<Int>
  _next: Vec<Int>
  _prev: Vec<Int>
  _free_slots: Vec<Int>
  _head: Int
  _tail: Int
  _size: Int
end

## Create a new empty linked list.
def ll_new(): LinkedList
  return LinkedList {
    _data: vec_new(),
    _next: vec_new(),
    _prev: vec_new(),
    _free_slots: vec_new(),
    _head: -1,
    _tail: -1,
    _size: 0
  }
end

## Alias for ll_new — more descriptive constructor name.
def linked_list_new(): LinkedList
  return ll_new()
end

## Internal: allocate a slot, reusing from free list if possible.
def _ll_alloc_slot(ll: LinkedList, val: Int): Int
  var free_count = ll._free_slots.size
  if free_count > 0
    match ll._free_slots.pop()
      Some(slot) => {
        ll._data[slot] = val
        ll._next[slot] = -1
        ll._prev[slot] = -1
        return slot
      }
      _ => {}
    end
  end
  var slot = ll._data.size
  ll._data.push(val)
  ll._next.push(-1)
  ll._prev.push(-1)
  return slot
end

## Internal: recycle a slot back to the free list.
def _ll_free_slot(ll: LinkedList, slot: Int): Void
  ll._free_slots.push(slot)
end

extend LinkedList
  ## Push a value to the front.
  def push_front(&mut self, val: Int): Void
    var slot = _ll_alloc_slot(self, val)
    if @_head < 0
      # Empty list
      @_head = slot
      @_tail = slot
    else
      @_next[slot] = @_head
      @_prev[@_head] = slot
      @_head = slot
    end
    @_size += 1
  end

  ## Push a value to the back.
  def push_back(&mut self, val: Int): Void
    var slot = _ll_alloc_slot(self, val)
    if @_tail < 0
      # Empty list
      @_head = slot
      @_tail = slot
    else
      @_prev[slot] = @_tail
      @_next[@_tail] = slot
      @_tail = slot
    end
    @_size += 1
  end

  ## Pop and return the front value. Returns Option::None if empty.
  def pop_front(&mut self): Option<Int>
    if @_size == 0
      return Option::None
    end
    var slot = @_head
    var val = @_data[slot]
    var next_slot = @_next[slot]
    if next_slot < 0
      # Was the only element
      @_head = -1
      @_tail = -1
    else
      @_prev[next_slot] = -1
      @_head = next_slot
    end
    _ll_free_slot(self, slot)
    @_size -= 1
    return Option::Some(val)
  end

  ## Pop and return the back value. Returns Option::None if empty.
  def pop_back(&mut self): Option<Int>
    if @_size == 0
      return Option::None
    end
    var slot = @_tail
    var val = @_data[slot]
    var prev_slot = @_prev[slot]
    if prev_slot < 0
      # Was the only element
      @_head = -1
      @_tail = -1
    else
      @_next[prev_slot] = -1
      @_tail = prev_slot
    end
    _ll_free_slot(self, slot)
    @_size -= 1
    return Option::Some(val)
  end

  ## Peek at the front value. Returns Option::None if empty.
  def peek_front(): Option<Int>
    if @_size == 0
      return Option::None
    end
    return Option::Some(@_data[@_head])
  end

  ## Peek at the back value. Returns Option::None if empty.
  def peek_back(): Option<Int>
    if @_size == 0
      return Option::None
    end
    return Option::Some(@_data[@_tail])
  end

  ## Get the element at index (0-based, O(n) traversal). Returns 0 if out of bounds.
  def get(index: Int): Int
    if index < 0 or index >= @_size
      return 0
    end
    var current = @_head
    var i = 0
    while i < index
      current = @_next[current]
      i += 1
    end
    return @_data[current]
  end

  ## Check if the list contains a value.
  def contains(val: Int): Bool
    var current = @_head
    while current >= 0
      if @_data[current] == val
        return true
      end
      current = @_next[current]
    end
    return false
  end

  ## Convert the list to a Vec, traversing head to tail.
  def to_vec(): Vec<Int>
    var result = vec_new()
    var current = @_head
    while current >= 0
      result.push(@_data[current])
      current = @_next[current]
    end
    return result
  end

  ## Return the number of elements.
  def size(): Int
    return @_size
  end

  ## Return true if the list is empty.
  def is_empty(): Bool
    return @_size == 0
  end

  ## Remove all elements.
  def clear(&mut self): Void
    vec_clear(@_data)
    vec_clear(@_next)
    vec_clear(@_prev)
    vec_clear(@_free_slots)
    @_head = -1
    @_tail = -1
    @_size = 0
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_data)
    vec_free(@_next)
    vec_free(@_prev)
    vec_free(@_free_slots)
  end

  # --- Canonical aliases ---

  ## Alias for push_back — add to end.
  def push(val: Int): Void
    self.push_back(val)
  end

  ## Alias for pop_back — remove from end.
  def pop(): Option<Int>
    return self.pop_back()
  end

  ## Alias for push_front — add to front.
  def unshift(val: Int): Void
    self.push_front(val)
  end

  ## Alias for pop_front — remove from front.
  def shift(): Option<Int>
    return self.pop_front()
  end

  ## Alias for peek_front — peek at front.
  def first(): Option<Int>
    return self.peek_front()
  end

  ## Alias for peek_back — peek at end.
  def last(): Option<Int>
    return self.peek_back()
  end

  # --- Higher-order methods ---

  def each(f: Fn(Int): Void): Void
    var current = @_head
    while current >= 0
      f(@_data[current])
      current = @_next[current]
    end
  end

  def map(f: Fn(Int): Int): Vec<Int>
    var result = vec_new()
    var current = @_head
    while current >= 0
      result.push(f(@_data[current]))
      current = @_next[current]
    end
    return result
  end

  def filter(f: Fn(Int): Bool): Vec<Int>
    var result = vec_new()
    var current = @_head
    while current >= 0
      var val = @_data[current]
      if f(val)
        result.push(val)
      end
      current = @_next[current]
    end
    return result
  end

  def reduce(init: Int, f: Fn(Int, Int): Int): Int
    var acc = init
    var current = @_head
    while current >= 0
      acc = f(acc, @_data[current])
      current = @_next[current]
    end
    return acc
  end

  def find(f: Fn(Int): Bool): Int
    var current = @_head
    while current >= 0
      var val = @_data[current]
      if f(val)
        return val
      end
      current = @_next[current]
    end
    return 0
  end

  def any?(f: Fn(Int): Bool): Bool
    var current = @_head
    while current >= 0
      if f(@_data[current])
        return true
      end
      current = @_next[current]
    end
    return false
  end

  def all?(f: Fn(Int): Bool): Bool
    var current = @_head
    while current >= 0
      if not f(@_data[current])
        return false
      end
      current = @_next[current]
    end
    return true
  end

  def count(f: Fn(Int): Bool): Int
    var n = 0
    var current = @_head
    while current >= 0
      if f(@_data[current])
        n += 1
      end
      current = @_next[current]
    end
    return n
  end

  ## Return an iterator over linked list elements (head to tail).
  def iter(): LinkedListIter
    return LinkedListIter { _data: @_data, _next: @_next, _current: @_head }
  end
end

## LinkedListIter — iterates over LinkedList elements by following the next-pointer chain.
struct LinkedListIter
  _data: Vec<Int>
  _next: Vec<Int>
  _current: Int
end

extend LinkedListIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._current < 0
      return Option::None
    end
    var val = self._data[self._current]
    self._current = self._next[self._current]
    return Option::Some(val)
  end
end

import * from traits
extend LinkedList with Container end
extend LinkedList with Iterable<Int> end
