# Deque — Double-ended queue (ring buffer)
#
# A double-ended queue backed by a fixed-capacity Vec<Int> used as a
# circular buffer. Grows by doubling when full.
#
# All push/pop operations are O(1) amortized.
#
# Example:
#   import collections/deque
#   var d = deque_new()
#   d.push_back(1)
#   d.push_front(0)
#   d.pop_front()   # 0
#   d.pop_back()    # 1

struct Deque
  _data: Vec<Int>
  _head: Int
  _size: Int
  _capacity: Int
end

## Internal: create a Vec<Int> pre-filled with n zeros.
def _deque_make_buf(n: Int): Vec<Int>
  var v = vec_new()
  var i = 0
  while i < n
    v.push(0)
    i += 1
  end
  return v
end

## Create a new empty deque with default capacity 8.
def deque_new(): Deque
  var cap = 8
  var data = _deque_make_buf(cap)
  return Deque { _data: data, _head: 0, _size: 0, _capacity: cap }
end

## Create a new empty deque with a specific initial capacity.
def deque_new_with_capacity(cap: Int): Deque
  var c = cap
  if c < 2
    c = 2
  end
  var data = _deque_make_buf(c)
  return Deque { _data: data, _head: 0, _size: 0, _capacity: c }
end

## Internal: grow the deque by copying elements in logical order to a new buffer.
def _deque_grow(d: Deque): Void
  var new_cap = d._capacity * 2
  var new_data = _deque_make_buf(new_cap)
  var i = 0
  while i < d._size
    var idx = (d._head + i) % d._capacity
    new_data[i] = d._data[idx]
    i += 1
  end
  vec_free(d._data)
  d._data = new_data
  d._head = 0
  d._capacity = new_cap
end

extend Deque
  ## Push a value to the front.
  def push_front(&mut self, val: Int): Void
    if @_size == @_capacity
      _deque_grow(self)
    end
    @_head = (@_head - 1 + @_capacity) % @_capacity
    @_data[@_head] = val
    @_size += 1
  end

  ## Push a value to the back.
  def push_back(&mut self, val: Int): Void
    if @_size == @_capacity
      _deque_grow(self)
    end
    var tail = (@_head + @_size) % @_capacity
    @_data[tail] = val
    @_size += 1
  end

  ## Pop and return the front value. Returns Option::None if empty.
  def pop_front(&mut self): Option<Int>
    if @_size == 0
      return Option::None
    end
    var val = @_data[@_head]
    @_head = (@_head + 1) % @_capacity
    @_size -= 1
    return Option::Some(val)
  end

  ## Pop and return the back value. Returns Option::None if empty.
  def pop_back(&mut self): Option<Int>
    if @_size == 0
      return Option::None
    end
    @_size -= 1
    var tail = (@_head + @_size) % @_capacity
    return Option::Some(@_data[tail])
  end

  ## Peek at the front value without removing it. Returns Option::None if empty.
  def peek_front(): Option<Int>
    if @_size == 0
      return Option::None
    end
    return Option::Some(@_data[@_head])
  end

  ## Peek at the back value without removing it. Returns Option::None if empty.
  def peek_back(): Option<Int>
    if @_size == 0
      return Option::None
    end
    var tail = (@_head + @_size - 1) % @_capacity
    return Option::Some(@_data[tail])
  end

  ## Get the element at a logical index. Returns 0 if out of bounds.
  def get(index: Int): Int
    if index < 0 or index >= @_size
      return 0
    end
    var phys = (@_head + index) % @_capacity
    return @_data[phys]
  end

  ## Set the element at a logical index.
  def set(index: Int, val: Int): Void
    if index >= 0 and index < @_size
      var phys = (@_head + index) % @_capacity
      @_data[phys] = val
    end
  end

  ## Return the number of elements.
  def size(): Int
    return @_size
  end

  ## Return true if the deque is empty.
  def is_empty(): Bool
    return @_size == 0
  end

  ## Remove all elements.
  def clear(&mut self): Void
    @_size = 0
    @_head = 0
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_data)
  end

  # --- Canonical aliases ---

  ## Alias for push_back — add to end.
  def push(val: Int): Void
    self.push_back(val)
  end

  ## Alias for pop_back — remove from end.
  def pop(): Option<Int>
    return self.pop_back()
  end

  ## Alias for push_front — add to front.
  def unshift(val: Int): Void
    self.push_front(val)
  end

  ## Alias for pop_front — remove from front.
  def shift(): Option<Int>
    return self.pop_front()
  end

  ## Alias for peek_front — peek at front.
  def first(): Option<Int>
    return self.peek_front()
  end

  ## Alias for peek_back — peek at end.
  def last(): Option<Int>
    return self.peek_back()
  end

  # --- Higher-order methods ---

  def to_vec(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      result.push(@_data[idx])
      i += 1
    end
    return result
  end

  def each(f: Fn(Int): Void): Void
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      f(@_data[idx])
      i += 1
    end
  end

  def map(f: Fn(Int): Int): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      result.push(f(@_data[idx]))
      i += 1
    end
    return result
  end

  def filter(f: Fn(Int): Bool): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      var val = @_data[idx]
      if f(val)
        result.push(val)
      end
      i += 1
    end
    return result
  end

  def reduce(init: Int, f: Fn(Int, Int): Int): Int
    var acc = init
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      acc = f(acc, @_data[idx])
      i += 1
    end
    return acc
  end

  def find(f: Fn(Int): Bool): Int
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      var val = @_data[idx]
      if f(val)
        return val
      end
      i += 1
    end
    return 0
  end

  def any?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      if f(@_data[idx])
        return true
      end
      i += 1
    end
    return false
  end

  def all?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      if not f(@_data[idx])
        return false
      end
      i += 1
    end
    return true
  end

  def count(f: Fn(Int): Bool): Int
    var n = 0
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      if f(@_data[idx])
        n += 1
      end
      i += 1
    end
    return n
  end

  ## Return an iterator over deque elements (front to back).
  ## Creates a snapshot of elements in logical order.
  def iter(): DequeIter
    var snapshot = vec_new()
    var i = 0
    while i < @_size
      var idx = (@_head + i) % @_capacity
      snapshot.push(@_data[idx])
      i += 1
    end
    return DequeIter { _data: snapshot, _index: 0 }
  end
end

## DequeIter — iterates over a snapshot of Deque elements (front to back).
struct DequeIter
  _data: Vec<Int>
  _index: Int
end

extend DequeIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._data.size
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

import * from traits
extend Deque with Container end
extend Deque with Iterable<Int> end
