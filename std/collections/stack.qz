# Stack — LIFO stack backed by Vec<Int>
#
# A simple last-in-first-out stack. All operations are O(1) amortized.
#
# Example:
#   import collections/stack
#   var s = stack_new()
#   s.push(1)
#   s.push(2)
#   s.pop()    # 2
#   s.peek()   # 1

struct Stack
  _data: Vec<Int>
end

## Create a new empty stack.
def stack_new(): Stack
  return Stack { _data: vec_new() }
end

extend Stack
  ## Push a value onto the top of the stack.
  def push(val: Int): Void
    @_data.push(val)
  end

  ## Pop the top value off the stack. Returns Option::None if empty.
  def pop(): Option<Int>
    if @_data.size == 0
      return Option::None
    end
    return @_data.pop()
  end

  ## Peek at the top value without removing it. Returns Option::None if empty.
  def peek(): Option<Int>
    var n = @_data.size
    if n == 0
      return Option::None
    end
    return Option::Some(@_data[n - 1])
  end

  ## Return the number of elements in the stack.
  def size(): Int
    return @_data.size
  end

  ## Return true if the stack is empty.
  def is_empty(): Bool
    return @_data.size == 0
  end

  ## Remove all elements from the stack.
  def clear(): Void
    vec_clear(@_data)
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_data)
  end

  # --- Higher-order methods ---

  ## Convert to a Vec (bottom to top).
  def to_vec(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      result.push(@_data[i])
      i += 1
    end
    return result
  end

  ## Iterate over each element (bottom to top).
  def each(f: Fn(Int): Void): Void
    var i = 0
    while i < @_data.size
      f(@_data[i])
      i += 1
    end
  end

  ## Map each element to a new value.
  def map(f: Fn(Int): Int): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      result.push(f(@_data[i]))
      i += 1
    end
    return result
  end

  ## Filter elements by predicate.
  def filter(f: Fn(Int): Bool): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        result.push(val)
      end
      i += 1
    end
    return result
  end

  ## Fold/reduce all elements.
  def reduce(init: Int, f: Fn(Int, Int): Int): Int
    var acc = init
    var i = 0
    while i < @_data.size
      acc = f(acc, @_data[i])
      i += 1
    end
    return acc
  end

  ## Find first element matching predicate. Returns 0 if not found.
  def find(f: Fn(Int): Bool): Int
    var i = 0
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        return val
      end
      i += 1
    end
    return 0
  end

  ## Check if any element matches predicate.
  def any?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_data.size
      if f(@_data[i])
        return true
      end
      i += 1
    end
    return false
  end

  ## Check if all elements match predicate.
  def all?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_data.size
      if not f(@_data[i])
        return false
      end
      i += 1
    end
    return true
  end

  ## Count elements matching predicate.
  def count(f: Fn(Int): Bool): Int
    var n = 0
    var i = 0
    while i < @_data.size
      if f(@_data[i])
        n += 1
      end
      i += 1
    end
    return n
  end

  ## Return an iterator over stack elements (bottom to top).
  def iter(): StackIter
    return StackIter { _data: @_data, _index: 0 }
  end
end

## StackIter — iterates over Stack elements by index (bottom to top).
struct StackIter
  _data: Vec<Int>
  _index: Int
end

extend StackIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._data.size
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

import * from traits
extend Stack with Container end
extend Stack with Iterable<Int> end
