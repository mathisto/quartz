# SortedMap — Ordered map via sorted parallel arrays
#
# A map that keeps keys in sorted order, backed by two parallel Vec<Int>.
# Uses binary search for O(log n) lookup and O(n) insert/delete.
#
# Example:
#   import collections/sorted_map
#   var m = sorted_map_new()
#   m.set(3, 30)
#   m.set(1, 10)
#   m.set(2, 20)
#   m.min_key()   # 1
#   m.get(2)      # 20

struct SortedMap
  _keys: Vec<Int>
  _values: Vec<Int>
end

## Create a new empty sorted map.
def sorted_map_new(): SortedMap
  return SortedMap { _keys: vec_new(), _values: vec_new() }
end

## Internal: binary search for key in sorted vec.
## Returns the index where key is found or should be inserted.
def _sm_binary_search(keys: Vec<Int>, key: Int): Int
  var lo = 0
  var hi = keys.size
  while lo < hi
    var mid = (lo + hi) / 2
    if keys[mid] < key
      lo = mid + 1
    else
      hi = mid
    end
  end
  return lo
end

extend SortedMap
  ## Set a key-value pair. If key exists, updates the value.
  def set(key: Int, val: Int): Void
    var idx = _sm_binary_search(@_keys, key)
    if idx < @_keys.size
      if @_keys[idx] == key
        @_values[idx] = val
        return
      end
    end
    vec_insert(@_keys, idx, key)
    vec_insert(@_values, idx, val)
  end

  ## Get the value for a key. Returns 0 if not found.
  def get(key: Int): Int
    var idx = _sm_binary_search(@_keys, key)
    if idx < @_keys.size
      if @_keys[idx] == key
        return @_values[idx]
      end
    end
    return 0
  end

  ## Check if a key exists.
  def has(key: Int): Bool
    var idx = _sm_binary_search(@_keys, key)
    if idx < @_keys.size
      if @_keys[idx] == key
        return true
      end
    end
    return false
  end

  ## Delete a key. No-op if key not found.
  def delete(key: Int): Void
    var idx = _sm_binary_search(@_keys, key)
    if idx < @_keys.size
      if @_keys[idx] == key
        vec_delete(@_keys, idx)
        vec_delete(@_values, idx)
      end
    end
  end

  ## Return the number of entries.
  def size(): Int
    return @_keys.size
  end

  ## Return true if the map is empty.
  def is_empty(): Bool
    return @_keys.size == 0
  end

  ## Return the smallest key. Returns 0 if empty.
  def min_key(): Int
    if @_keys.size == 0
      return 0
    end
    return @_keys[0]
  end

  ## Return the largest key. Returns 0 if empty.
  def max_key(): Int
    var n = @_keys.size
    if n == 0
      return 0
    end
    return @_keys[n - 1]
  end

  ## Remove all entries.
  def clear(): Void
    vec_clear(@_keys)
    vec_clear(@_values)
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_keys)
    vec_free(@_values)
  end

  # --- Higher-order methods ---

  ## Return a copy of the keys Vec.
  def keys(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_keys.size
      result.push(@_keys[i])
      i += 1
    end
    return result
  end

  ## Return a copy of the values Vec.
  def values(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_values.size
      result.push(@_values[i])
      i += 1
    end
    return result
  end

  ## Convert to a Vec of keys (alias for keys).
  def to_vec(): Vec<Int>
    return self.keys()
  end

  ## Iterate over each key-value pair.
  def each(f: Fn(Int, Int): Void): Void
    var i = 0
    while i < @_keys.size
      f(@_keys[i], @_values[i])
      i += 1
    end
  end

  ## Map each key-value pair to a new value.
  def map(f: Fn(Int, Int): Int): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_keys.size
      result.push(f(@_keys[i], @_values[i]))
      i += 1
    end
    return result
  end

  ## Filter key-value pairs by predicate, returning matching keys.
  def filter(f: Fn(Int, Int): Bool): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_keys.size
      var k = @_keys[i]
      var v = @_values[i]
      if f(k, v)
        result.push(k)
      end
      i += 1
    end
    return result
  end

  ## Fold all key-value pairs into an accumulator.
  def reduce(init: Int, f: Fn(Int, Int, Int): Int): Int
    var acc = init
    var i = 0
    while i < @_keys.size
      acc = f(acc, @_keys[i], @_values[i])
      i += 1
    end
    return acc
  end

  ## Find first key-value pair matching predicate, returning the key. Returns 0 if not found.
  def find(f: Fn(Int, Int): Bool): Int
    var i = 0
    while i < @_keys.size
      var k = @_keys[i]
      if f(k, @_values[i])
        return k
      end
      i += 1
    end
    return 0
  end

  ## Check if any key-value pair matches predicate.
  def any?(f: Fn(Int, Int): Bool): Bool
    var i = 0
    while i < @_keys.size
      if f(@_keys[i], @_values[i])
        return true
      end
      i += 1
    end
    return false
  end

  ## Check if all key-value pairs match predicate.
  def all?(f: Fn(Int, Int): Bool): Bool
    var i = 0
    while i < @_keys.size
      if not f(@_keys[i], @_values[i])
        return false
      end
      i += 1
    end
    return true
  end

  ## Count key-value pairs matching predicate.
  def count(f: Fn(Int, Int): Bool): Int
    var n = 0
    var i = 0
    while i < @_keys.size
      if f(@_keys[i], @_values[i])
        n += 1
      end
      i += 1
    end
    return n
  end

  ## Return an iterator over keys in sorted order.
  def iter(): SortedMapKeyIter
    return SortedMapKeyIter { _data: @_keys, _index: 0 }
  end

  ## Return an iterator over values in key-sorted order.
  def iter_values(): SortedMapValueIter
    return SortedMapValueIter { _data: @_values, _index: 0 }
  end
end

## SortedMapKeyIter — iterates over SortedMap keys in sorted order.
struct SortedMapKeyIter
  _data: Vec<Int>
  _index: Int
end

extend SortedMapKeyIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._data.size
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

## SortedMapValueIter — iterates over SortedMap values in key-sorted order.
struct SortedMapValueIter
  _data: Vec<Int>
  _index: Int
end

extend SortedMapValueIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._data.size
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

extend SortedMap with Container end
extend SortedMap with Iterable<Int> end
