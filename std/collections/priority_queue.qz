# PriorityQueue — Binary heap
#
# A priority queue implemented as a binary min-heap (default) or max-heap.
# Push and pop are O(log n). Peek is O(1).
#
# Example:
#   import collections/priority_queue
#   var pq = pq_new()       # min-heap
#   pq.push(30)
#   pq.push(10)
#   pq.push(20)
#   pq.pop()   # 10 (smallest)
#
#   var mx = pq_new_max()   # max-heap
#   mx.push(30)
#   mx.push(10)
#   mx.pop()   # 30 (largest)

struct PriorityQueue
  _data: Vec<Int>
  _is_max: Int
end

## Create a new min-heap priority queue.
def pq_new(): PriorityQueue
  return PriorityQueue { _data: vec_new(), _is_max: 0 }
end

## Create a new max-heap priority queue.
def pq_new_max(): PriorityQueue
  return PriorityQueue { _data: vec_new(), _is_max: 1 }
end

## Alias for pq_new — more descriptive constructor name.
def priority_queue_new(): PriorityQueue
  return pq_new()
end

## Alias for pq_new_max — more descriptive constructor name.
def priority_queue_new_max(): PriorityQueue
  return pq_new_max()
end

## Internal: should element at index a be above element at index b?
## Min-heap: a < b. Max-heap: a > b.
def _pq_should_swap(pq: PriorityQueue, child_val: Int, parent_val: Int): Int
  if pq._is_max
    if child_val > parent_val
      return 1
    end
    return 0
  end
  if child_val < parent_val
    return 1
  end
  return 0
end

## Internal: swap two elements in the data vec.
def _pq_swap(pq: PriorityQueue, i: Int, j: Int): Void
  var tmp = pq._data[i]
  pq._data[i] = pq._data[j]
  pq._data[j] = tmp
end

## Internal: sift up from index to restore heap property.
def _pq_sift_up(pq: PriorityQueue, idx: Int): Void
  var i = idx
  while i > 0
    var parent = (i - 1) / 2
    if _pq_should_swap(pq, pq._data[i], pq._data[parent])
      _pq_swap(pq, i, parent)
      i = parent
    else
      return
    end
  end
end

## Internal: sift down from index to restore heap property.
def _pq_sift_down(pq: PriorityQueue, idx: Int): Void
  var n = pq._data.size
  var i = idx
  while true
    var best = i
    var left = 2 * i + 1
    var right = 2 * i + 2
    if left < n
      if _pq_should_swap(pq, pq._data[left], pq._data[best])
        best = left
      end
    end
    if right < n
      if _pq_should_swap(pq, pq._data[right], pq._data[best])
        best = right
      end
    end
    if best == i
      return
    end
    _pq_swap(pq, i, best)
    i = best
  end
end

extend PriorityQueue
  ## Push a value onto the heap.
  def push(val: Int): Void
    @_data.push(val)
    _pq_sift_up(self, @_data.size - 1)
  end

  ## Pop and return the highest-priority value. Returns Option::None if empty.
  def pop(): Option<Int>
    var n = @_data.size
    if n == 0
      return Option::None
    end
    var top = @_data[0]
    if n == 1
      @_data.pop()
      return Option::Some(top)
    end
    # Move last to root, then sift down
    @_data[0] = @_data[n - 1]
    @_data.pop()
    _pq_sift_down(self, 0)
    return Option::Some(top)
  end

  ## Peek at the highest-priority value without removing it. Returns Option::None if empty.
  def peek(): Option<Int>
    if @_data.size == 0
      return Option::None
    end
    return Option::Some(@_data[0])
  end

  ## Return the number of elements.
  def size(): Int
    return @_data.size
  end

  ## Return true if the queue is empty.
  def is_empty(): Bool
    return @_data.size == 0
  end

  ## Remove all elements.
  def clear(): Void
    vec_clear(@_data)
  end

  ## Free the underlying storage.
  def free(): Void
    vec_free(@_data)
  end

  # --- Higher-order methods ---

  def to_vec(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      result.push(@_data[i])
      i += 1
    end
    return result
  end

  def each(f: Fn(Int): Void): Void
    var i = 0
    while i < @_data.size
      f(@_data[i])
      i += 1
    end
  end

  def map(f: Fn(Int): Int): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      result.push(f(@_data[i]))
      i += 1
    end
    return result
  end

  def filter(f: Fn(Int): Bool): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        result.push(val)
      end
      i += 1
    end
    return result
  end

  def reduce(init: Int, f: Fn(Int, Int): Int): Int
    var acc = init
    var i = 0
    while i < @_data.size
      acc = f(acc, @_data[i])
      i += 1
    end
    return acc
  end

  def find(f: Fn(Int): Bool): Int
    var i = 0
    while i < @_data.size
      var val = @_data[i]
      if f(val)
        return val
      end
      i += 1
    end
    return 0
  end

  def any?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_data.size
      if f(@_data[i])
        return true
      end
      i += 1
    end
    return false
  end

  def all?(f: Fn(Int): Bool): Bool
    var i = 0
    while i < @_data.size
      if not f(@_data[i])
        return false
      end
      i += 1
    end
    return true
  end

  def count(f: Fn(Int): Bool): Int
    var n = 0
    var i = 0
    while i < @_data.size
      if f(@_data[i])
        n += 1
      end
      i += 1
    end
    return n
  end

  ## Return an iterator over heap elements (array order, NOT priority order).
  def iter(): PQIter
    return PQIter { _data: @_data, _index: 0 }
  end
end

## PQIter — iterates over PriorityQueue elements by array index.
struct PQIter
  _data: Vec<Int>
  _index: Int
end

extend PQIter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self._index >= self._data.size
      return Option::None
    end
    var val = self._data[self._index]
    self._index = self._index + 1
    return Option::Some(val)
  end
end

extend PriorityQueue with Container end
extend PriorityQueue with Iterable<Int> end
