# Time — Standard Library
#
# Time utilities for measuring elapsed time and sleeping.
# Uses the POSIX FFI time module (std/ffi/time) for calendar time.
# Monotonic timestamps come from the `clock_gettime` POSIX call.
#
# Example:
#   import time
#   var start = time_epoch()
#   # ... do work ...
#   var elapsed = time_epoch() - start
#   println("Elapsed: " + elapsed.to_s() + " seconds")

import ffi/time

## Get current Unix epoch time in seconds.
## Wraps the POSIX `time()` function.
def time_epoch(): Int
  return time(0)
end

## Get current Unix epoch time in milliseconds.
## Uses gettimeofday for microsecond precision, returns ms.
@cfg(not: os: "unknown")
def time_epoch_ms(): Int
  var tv = mem_alloc(16)
  gettimeofday(int_to_cptr(tv), int_to_cptr(0))
  var sec = _time_read_i64(tv)
  var usec = _time_read_i64(ptr_add(tv, 8))
  qz_free(tv)
  return sec * 1000 + usec / 1000
end

## B.5e.7b — freestanding/kernel variant. The kernel has no `gettimeofday`
## (no POSIX, no RTC bridge). It does expose a monotonic-ns TSC clock via the
## `time_mono_ns` intrinsic (→ `uk_time_mono_ns`), so we report monotonic ms.
## Every kernel caller of this (std/actor.qz supervisor backoff, etc.) computes
## DELTAS (`now - last_restart_ts_ms`), for which monotonic is *more* correct
## than wall-clock — it can't jump or go backwards. The absolute value is not a
## real Unix epoch; it's "ms since boot". `@cfg(os: "unknown")` matches the
## `x86_64-unknown-none-elf` freestanding target (cfg_os_from_target fallback).
@cfg(os: "unknown")
def time_epoch_ms(): Int
  return time_mono_ns() / 1000000
end

# Internal: read i32 from raw memory (little-endian)
def _time_read_i32(ptr: Int): Int
  var b0 = ptr_read_byte(ptr)
  var b1 = ptr_read_byte(ptr_add(ptr, 1))
  var b2 = ptr_read_byte(ptr_add(ptr, 2))
  var b3 = ptr_read_byte(ptr_add(ptr, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

# Internal: read i64 from raw memory (little-endian)
def _time_read_i64(ptr: Int): Int
  var lo = _time_read_i32(ptr)
  var hi = _time_read_i32(ptr_add(ptr, 4))
  return lo + hi * 4294967296
end

## Sleep for the given number of milliseconds.
## Uses POSIX usleep (microsecond sleep).
extern "C" def usleep(usec: Int): Int

def time_sleep_ms(ms: Int): Void
  var us = ms * 1000
  var result = usleep(us)
end

## Sleep for the given number of seconds.
def time_sleep(seconds: Int): Void
  time_sleep_ms(seconds * 1000)
end

## Get elapsed seconds between two epoch timestamps.
def time_elapsed(start: Int, stop: Int): Int
  return stop - start
end

# ============================================================================
# Calendar Arithmetic — correct date calculations from Unix epoch
# ============================================================================

## Constants for time calculations.
const SECONDS_PER_MINUTE = 60
const SECONDS_PER_HOUR = 3600
const SECONDS_PER_DAY = 86400

## Check if a year is a leap year.
## Rules: divisible by 4, except centuries, unless divisible by 400.
def is_leap_year(year: Int): Bool
  if year % 400 == 0
    return true
  end
  if year % 100 == 0
    return false
  end
  return year % 4 == 0
end

## Get the number of days in a given month (1-12) of a given year.
def days_in_month(month: Int, year: Int): Int
  if month == 1
    return 31
  end
  if month == 2
    if is_leap_year(year)
      return 29
    end
    return 28
  end
  if month == 3
    return 31
  end
  if month == 4
    return 30
  end
  if month == 5
    return 31
  end
  if month == 6
    return 30
  end
  if month == 7
    return 31
  end
  if month == 8
    return 31
  end
  if month == 9
    return 30
  end
  if month == 10
    return 31
  end
  if month == 11
    return 30
  end
  if month == 12
    return 31
  end
  return 0
end

## Get the number of days in a year (365 or 366).
def days_in_year(year: Int): Int
  if is_leap_year(year)
    return 366
  end
  return 365
end

## Convert epoch seconds to total days since 1970-01-01.
## Handles negative epochs (dates before 1970).
def _epoch_to_days(epoch: Int): Int
  if epoch >= 0
    return epoch / SECONDS_PER_DAY
  end
  # For negative epochs, use floor division
  # -1 second => day -1 (1969-12-31), not day 0
  return (epoch - SECONDS_PER_DAY + 1) / SECONDS_PER_DAY
end

## Convert epoch seconds to year.
def epoch_to_year(epoch: Int): Int
  var remaining = _epoch_to_days(epoch)
  if remaining >= 0
    var year = 1970
    while remaining >= days_in_year(year)
      remaining = remaining - days_in_year(year)
      year = year + 1
    end
    return year
  end
  # Negative: walk backwards from 1970
  var year = 1969
  # remaining is negative: e.g. -1 means 1 day before epoch
  remaining = 0 - remaining  # make positive (days before epoch)
  while remaining > days_in_year(year)
    remaining = remaining - days_in_year(year)
    year = year - 1
  end
  return year
end

## Convert epoch seconds to month (1-12).
def epoch_to_month(epoch: Int): Int
  var remaining = _epoch_to_days(epoch)
  if remaining >= 0
    var year = 1970
    while remaining >= days_in_year(year)
      remaining = remaining - days_in_year(year)
      year = year + 1
    end
    var month = 1
    while remaining >= days_in_month(month, year)
      remaining = remaining - days_in_month(month, year)
      month = month + 1
    end
    return month
  end
  # Negative epoch
  var year = 1969
  remaining = 0 - remaining - 1  # convert -1 day to index 0 from end of year
  while remaining >= days_in_year(year)
    remaining = remaining - days_in_year(year)
    year = year - 1
  end
  # remaining = days from end of year
  var month = 12
  while remaining >= days_in_month(month, year)
    remaining = remaining - days_in_month(month, year)
    month = month - 1
  end
  return month
end

## Convert epoch seconds to day of month (1-31).
def epoch_to_day(epoch: Int): Int
  var remaining = _epoch_to_days(epoch)
  if remaining >= 0
    var year = 1970
    while remaining >= days_in_year(year)
      remaining = remaining - days_in_year(year)
      year = year + 1
    end
    var month = 1
    while remaining >= days_in_month(month, year)
      remaining = remaining - days_in_month(month, year)
      month = month + 1
    end
    return remaining + 1
  end
  # Negative epoch
  var year = 1969
  remaining = 0 - remaining - 1
  while remaining >= days_in_year(year)
    remaining = remaining - days_in_year(year)
    year = year - 1
  end
  var month = 12
  while remaining >= days_in_month(month, year)
    remaining = remaining - days_in_month(month, year)
    month = month - 1
  end
  return days_in_month(month, year) - remaining
end

## Convert epoch seconds to hour (0-23).
def epoch_to_hour(epoch: Int): Int
  var day_seconds = epoch % SECONDS_PER_DAY
  if day_seconds < 0
    day_seconds = day_seconds + SECONDS_PER_DAY
  end
  return day_seconds / SECONDS_PER_HOUR
end

## Convert epoch seconds to minute (0-59).
def epoch_to_minute(epoch: Int): Int
  var day_seconds = epoch % SECONDS_PER_DAY
  if day_seconds < 0
    day_seconds = day_seconds + SECONDS_PER_DAY
  end
  return (day_seconds % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE
end

## Convert epoch seconds to second (0-59).
def epoch_to_second(epoch: Int): Int
  var day_seconds = epoch % SECONDS_PER_DAY
  if day_seconds < 0
    day_seconds = day_seconds + SECONDS_PER_DAY
  end
  return day_seconds % SECONDS_PER_MINUTE
end

## Get the day of the week for an epoch timestamp.
## Returns 0=Sunday, 1=Monday, ..., 6=Saturday (POSIX convention).
## Epoch 0 (1970-01-01) is a Thursday (day 4).
def day_of_week(epoch: Int): Int
  var total_days = _epoch_to_days(epoch)
  # Thursday = 4, so offset by 4
  var dow = (total_days + 4) % 7
  if dow < 0
    dow = dow + 7
  end
  return dow
end

## Get the current year.
## Uses proper calendar arithmetic (not the 365.25-day approximation).
def time_year(): Int
  return epoch_to_year(time_epoch())
end

## Get the current month (1-12).
def time_month(): Int
  return epoch_to_month(time_epoch())
end

## Get the current day of the month (1-31).
def time_day(): Int
  return epoch_to_day(time_epoch())
end

# ============================================================================
# Duration Type — nanosecond-precision time span
# ============================================================================

## Duration represented as nanoseconds (Int).
## Range: ±292 years (~int64 range).
struct Duration
  nanos: Int
end

## Constructors
def duration_from_hours(h: Int): Duration
  return Duration { nanos: h * 3600000000000 }
end

def duration_from_minutes(m: Int): Duration
  return Duration { nanos: m * 60000000000 }
end

def duration_from_secs(s: Int): Duration
  return Duration { nanos: s * 1000000000 }
end

def duration_from_millis(ms: Int): Duration
  return Duration { nanos: ms * 1000000 }
end

def duration_from_micros(us: Int): Duration
  return Duration { nanos: us * 1000 }
end

def duration_from_nanos(ns: Int): Duration
  return Duration { nanos: ns }
end

def duration_zero(): Duration
  return Duration { nanos: 0 }
end

## Accessors (truncating conversion)
def duration_to_secs(d: Duration): Int
  return d.nanos / 1000000000
end

def duration_to_millis(d: Duration): Int
  return d.nanos / 1000000
end

def duration_to_micros(d: Duration): Int
  return d.nanos / 1000
end

def duration_to_nanos(d: Duration): Int
  return d.nanos
end

def duration_to_minutes(d: Duration): Int
  return d.nanos / 60000000000
end

def duration_to_hours(d: Duration): Int
  return d.nanos / 3600000000000
end

## UFCS accessor aliases so `d.as_millis` / `d.as_secs` read naturally.
## `obj.method` ≡ `obj.method()` for zero-arg free functions whose first
## parameter matches the receiver type (paren-optional dot-method calls).
def as_nanos(d: Duration): Int = d.nanos
def as_micros(d: Duration): Int = duration_to_micros(d)
def as_millis(d: Duration): Int = duration_to_millis(d)
def as_secs(d: Duration): Int = duration_to_secs(d)
def as_minutes(d: Duration): Int = duration_to_minutes(d)
def as_hours(d: Duration): Int = duration_to_hours(d)

## Arithmetic
def duration_add(a: Duration, b: Duration): Duration
  return Duration { nanos: a.nanos + b.nanos }
end

def duration_sub(a: Duration, b: Duration): Duration
  return Duration { nanos: a.nanos - b.nanos }
end

def duration_mul(d: Duration, n: Int): Duration
  return Duration { nanos: d.nanos * n }
end

## Comparison: returns -1, 0, or 1
def duration_cmp(a: Duration, b: Duration): Int
  if a.nanos < b.nanos
    return -1
  end
  if a.nanos > b.nanos
    return 1
  end
  return 0
end

## Boolean comparisons (built on the nanosecond field directly).
def duration_eq(a: Duration, b: Duration): Bool = a.nanos == b.nanos
def duration_lt(a: Duration, b: Duration): Bool = a.nanos < b.nanos
def duration_le(a: Duration, b: Duration): Bool = a.nanos <= b.nanos
def duration_gt(a: Duration, b: Duration): Bool = a.nanos > b.nanos
def duration_ge(a: Duration, b: Duration): Bool = a.nanos >= b.nanos

## Check if duration is zero
def duration_is_zero(d: Duration): Bool
  return d.nanos == 0
end

# ============================================================================
# Monotonic Clock — high-resolution timing via intrinsic
# ============================================================================

## Get monotonic time in milliseconds.
## Uses the time_mono_ns intrinsic (POSIX clock_gettime CLOCK_MONOTONIC).
def time_mono_ms(): Int = time_mono_ns() / 1000000

# ============================================================================
# Civil <-> Epoch — days-from-civil (Howard Hinnant, chrono algorithm)
# ============================================================================
#
# The epoch->civil accessors above (epoch_to_year/month/day) walk year-by-year.
# For constructing an epoch FROM a (y, m, d) triple we use the closed-form
# `days_from_civil` from Howard Hinnant's public-domain date algorithms
# (http://howardhinnant.github.io/date_algorithms.html#days_from_civil).
# It maps a proleptic-Gregorian (year, month, day) to a signed day count
# relative to 1970-01-01, valid for any date the algorithm's era math covers
# (well beyond the Int64 second range we ultimately clamp to).
#
# Correctness note: the algorithm shifts the year so that March 1 begins each
# internal year, which folds the leap-day into the end of the interval and
# removes month-length special-casing. `era` is the 400-year Gregorian cycle.

## Days since 1970-01-01 for a proleptic-Gregorian date. month in 1..12,
## day in 1..31. Negative for dates before the epoch.
def days_from_civil(year: Int, month: Int, day: Int): Int
  # Treat Jan/Feb as months 13/14 of the previous year.
  var y = year
  if month <= 2
    y = y - 1
  end
  var era = 0
  if y >= 0
    era = y / 400
  else
    era = (y - 399) / 400
  end
  var yoe = y - era * 400              # year of era, 0..399
  var mp = month + 9                   # (month + 12 - 3) % 12
  if month > 2
    mp = month - 3
  end
  var doy = (153 * mp + 2) / 5 + day - 1   # day of year, Mar-based, 0..365
  var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy   # day of era, 0..146096
  return era * 146097 + doe - 719468
end

## Compose Unix epoch seconds from a UTC calendar timestamp.
## No timezone handling — inputs are interpreted as UTC.
def civil_to_epoch(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int): Int
  var days = days_from_civil(year, month, day)
  return days * SECONDS_PER_DAY + hour * SECONDS_PER_HOUR + minute * SECONDS_PER_MINUTE + second
end

# ============================================================================
# String / digit helpers (local, byte-level, ASCII)
# ============================================================================

## Parse a fixed-width run of decimal digits starting at byte offset `start`.
## Returns Some(value) only if all `count` bytes are ASCII digits; None
## otherwise (including if the run would read past the end of the string).
def _parse_uint_fixed(s: String, start: Int, count: Int): Option<Int>
  if start + count > str_byte_len(s)
    return Option::None
  end
  var n = 0
  var i = 0
  while i < count
    var b = str_byte_at(s, start + i)
    if b < '0' or b > '9'
      return Option::None
    end
    n = n * 10 + (b - '0')
    i = i + 1
  end
  return Option::Some(n)
end

## Left-pad an Int to `width` with '0' (for formatters). Non-negative only.
def _pad2(n: Int): String = str_pad_left(n.to_s(), 2, "0")
def _pad4(n: Int): String = str_pad_left(n.to_s(), 4, "0")

# ============================================================================
# ISO-8601 timestamp parsing
# ============================================================================
#
# Supported subset (the two most common forms):
#   YYYY-MM-DDTHH:MM:SS      — interpreted as UTC
#   YYYY-MM-DDTHH:MM:SSZ     — explicit UTC ('Z' trailing)
#
# A lowercase 't' separator is also accepted. Both forms are treated as UTC.
#
# NOT yet supported (documented TODO): numeric offsets (+HH:MM / -HH:MM),
# fractional seconds (.sss), basic (no-dash/colon) format, week/ordinal dates.
# Feeding any of those returns None. Range-validation is light: month 1..12,
# day 1..days_in_month, hour 0..23, minute/second 0..59 (a leap second value
# of 60 is rejected — IsO-8601 permits it but epoch has no representation).
#
# Returns Option<Int> = epoch seconds (UTC). None on any malformed input.

def parse_iso8601(s: String): Option<Int>
  var len = str_byte_len(s)
  # Minimum well-formed length: "YYYY-MM-DDTHH:MM:SS" = 19 bytes.
  if len < 19
    return Option::None
  end
  # Structural separators at fixed offsets.
  if str_byte_at(s, 4) != '-'
    return Option::None
  end
  if str_byte_at(s, 7) != '-'
    return Option::None
  end
  var sep = str_byte_at(s, 10)
  if sep != 'T' and sep != 't'
    return Option::None
  end
  if str_byte_at(s, 13) != ':'
    return Option::None
  end
  if str_byte_at(s, 16) != ':'
    return Option::None
  end
  # Trailing content: either nothing, or a single 'Z'.
  if len > 19
    if len != 20
      return Option::None
    end
    if str_byte_at(s, 19) != 'Z'
      return Option::None
    end
  end

  var year_opt = _parse_uint_fixed(s, 0, 4)
  var month_opt = _parse_uint_fixed(s, 5, 2)
  var day_opt = _parse_uint_fixed(s, 8, 2)
  var hour_opt = _parse_uint_fixed(s, 11, 2)
  var min_opt = _parse_uint_fixed(s, 14, 2)
  var sec_opt = _parse_uint_fixed(s, 17, 2)

  var year = 0
  match year_opt
    Option::Some(v) => year = v
    Option::None => return Option::None
  end
  var month = 0
  match month_opt
    Option::Some(v) => month = v
    Option::None => return Option::None
  end
  var day = 0
  match day_opt
    Option::Some(v) => day = v
    Option::None => return Option::None
  end
  var hour = 0
  match hour_opt
    Option::Some(v) => hour = v
    Option::None => return Option::None
  end
  var minute = 0
  match min_opt
    Option::Some(v) => minute = v
    Option::None => return Option::None
  end
  var second = 0
  match sec_opt
    Option::Some(v) => second = v
    Option::None => return Option::None
  end

  if not _valid_civil(year, month, day, hour, minute, second)
    return Option::None
  end
  return Option::Some(civil_to_epoch(year, month, day, hour, minute, second))
end

## Range-validate a UTC calendar timestamp. Rejects leap seconds (sec==60)
## since epoch seconds cannot represent them.
def _valid_civil(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int): Bool
  if month < 1 or month > 12
    return false
  end
  if day < 1 or day > days_in_month(month, year)
    return false
  end
  if hour < 0 or hour > 23
    return false
  end
  if minute < 0 or minute > 59
    return false
  end
  if second < 0 or second > 59
    return false
  end
  return true
end

## Format epoch seconds as an ISO-8601 UTC timestamp with trailing 'Z':
## "YYYY-MM-DDTHH:MM:SSZ". Round-trips with parse_iso8601 for the supported
## subset. Uses the existing epoch_to_* accessors.
def format_iso8601(epoch: Int): String
  var y = epoch_to_year(epoch)
  var mo = epoch_to_month(epoch)
  var d = epoch_to_day(epoch)
  var h = epoch_to_hour(epoch)
  var mi = epoch_to_minute(epoch)
  var se = epoch_to_second(epoch)
  return _pad4(y) + "-" + _pad2(mo) + "-" + _pad2(d) + "T" + _pad2(h) + ":" + _pad2(mi) + ":" + _pad2(se) + "Z"
end

# ============================================================================
# HTTP-Date parsing (RFC 7231 §7.1.1.1 — IMF-fixdate)
# ============================================================================
#
# Supported form (the "preferred" and only one senders MUST generate):
#   IMF-fixdate:  "Sun, 06 Nov 1994 08:49:37 GMT"
#
#   day-name "," SP day SP month SP year SP hour ":" minute ":" second SP "GMT"
#   day  = 2DIGIT      month = 3-letter English name
#   year = 4DIGIT      time  = 2DIGIT:2DIGIT:2DIGIT
#
# The day-name prefix (Sun/Mon/…) is tolerated but NOT validated against the
# actual weekday — RFC 7231 says recipients SHOULD accept but the value is
# redundant with the date, so we skip it and parse from the first digit run.
#
# NOT yet supported (documented TODO): the two obsolete formats RFC 7231
# lists for parsers — RFC 850 ("Sunday, 06-Nov-94 08:49:37 GMT") and the
# asctime form ("Sun Nov  6 08:49:37 1994"). These return Option::None.
#
# The trailing zone MUST be literal "GMT" (IMF-fixdate is always GMT/UTC).
#
# Returns Option<Int> = epoch seconds (UTC). None on any malformed input.

## Map a 3-byte English month abbreviation (offset `start`) to 1..12, or
## None if unrecognized. Case-sensitive per RFC (Title-case: "Nov").
def _http_month(s: String, start: Int): Option<Int>
  if start + 3 > str_byte_len(s)
    return Option::None
  end
  var a = str_byte_at(s, start)
  var b = str_byte_at(s, start + 1)
  var c = str_byte_at(s, start + 2)
  # Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec
  if a == 'J' and b == 'a' and c == 'n'
    return Option::Some(1)
  end
  if a == 'F' and b == 'e' and c == 'b'
    return Option::Some(2)
  end
  if a == 'M' and b == 'a' and c == 'r'
    return Option::Some(3)
  end
  if a == 'A' and b == 'p' and c == 'r'
    return Option::Some(4)
  end
  if a == 'M' and b == 'a' and c == 'y'
    return Option::Some(5)
  end
  if a == 'J' and b == 'u' and c == 'n'
    return Option::Some(6)
  end
  if a == 'J' and b == 'u' and c == 'l'
    return Option::Some(7)
  end
  if a == 'A' and b == 'u' and c == 'g'
    return Option::Some(8)
  end
  if a == 'S' and b == 'e' and c == 'p'
    return Option::Some(9)
  end
  if a == 'O' and b == 'c' and c == 't'
    return Option::Some(10)
  end
  if a == 'N' and b == 'o' and c == 'v'
    return Option::Some(11)
  end
  if a == 'D' and b == 'e' and c == 'c'
    return Option::Some(12)
  end
  return Option::None
end

## Parse an RFC 7231 IMF-fixdate to epoch seconds (UTC).
## "Sun, 06 Nov 1994 08:49:37 GMT" — the fixed-width layout lets us index
## directly. Total length is exactly 29 bytes.
def parse_http_date(s: String): Option<Int>
  # "Sun, 06 Nov 1994 08:49:37 GMT" is exactly 29 bytes.
  if str_byte_len(s) != 29
    return Option::None
  end
  # Byte layout (0-based):
  #   0-2  day-name, 3 ',', 4 ' '
  #   5-6  day,      7 ' '
  #   8-10 month,   11 ' '
  #   12-15 year,   16 ' '
  #   17-18 hour,   19 ':'
  #   20-21 minute, 22 ':'
  #   23-24 second, 25 ' '
  #   26-28 "GMT"
  if str_byte_at(s, 3) != ','
    return Option::None
  end
  if str_byte_at(s, 4) != ' '
    return Option::None
  end
  if str_byte_at(s, 7) != ' '
    return Option::None
  end
  if str_byte_at(s, 11) != ' '
    return Option::None
  end
  if str_byte_at(s, 16) != ' '
    return Option::None
  end
  if str_byte_at(s, 19) != ':'
    return Option::None
  end
  if str_byte_at(s, 22) != ':'
    return Option::None
  end
  if str_byte_at(s, 25) != ' '
    return Option::None
  end
  if str_byte_at(s, 26) != 'G' or str_byte_at(s, 27) != 'M' or str_byte_at(s, 28) != 'T'
    return Option::None
  end

  var day_opt = _parse_uint_fixed(s, 5, 2)
  var month_opt = _http_month(s, 8)
  var year_opt = _parse_uint_fixed(s, 12, 4)
  var hour_opt = _parse_uint_fixed(s, 17, 2)
  var min_opt = _parse_uint_fixed(s, 20, 2)
  var sec_opt = _parse_uint_fixed(s, 23, 2)

  var day = 0
  match day_opt
    Option::Some(v) => day = v
    Option::None => return Option::None
  end
  var month = 0
  match month_opt
    Option::Some(v) => month = v
    Option::None => return Option::None
  end
  var year = 0
  match year_opt
    Option::Some(v) => year = v
    Option::None => return Option::None
  end
  var hour = 0
  match hour_opt
    Option::Some(v) => hour = v
    Option::None => return Option::None
  end
  var minute = 0
  match min_opt
    Option::Some(v) => minute = v
    Option::None => return Option::None
  end
  var second = 0
  match sec_opt
    Option::Some(v) => second = v
    Option::None => return Option::None
  end

  if not _valid_civil(year, month, day, hour, minute, second)
    return Option::None
  end
  return Option::Some(civil_to_epoch(year, month, day, hour, minute, second))
end

## Format epoch seconds as an RFC 7231 IMF-fixdate string (round-trips with
## parse_http_date). Weekday computed from the epoch via day_of_week.
def format_http_date(epoch: Int): String
  var y = epoch_to_year(epoch)
  var mo = epoch_to_month(epoch)
  var d = epoch_to_day(epoch)
  var h = epoch_to_hour(epoch)
  var mi = epoch_to_minute(epoch)
  var se = epoch_to_second(epoch)
  var dow = day_of_week(epoch)     # 0=Sunday .. 6=Saturday
  return _http_day_name(dow) + ", " + _pad2(d) + " " + _http_month_name(mo) + " " + _pad4(y) + " " + _pad2(h) + ":" + _pad2(mi) + ":" + _pad2(se) + " GMT"
end

## 0=Sunday .. 6=Saturday -> "Sun".."Sat"
def _http_day_name(dow: Int): String
  if dow == 0
    return "Sun"
  end
  if dow == 1
    return "Mon"
  end
  if dow == 2
    return "Tue"
  end
  if dow == 3
    return "Wed"
  end
  if dow == 4
    return "Thu"
  end
  if dow == 5
    return "Fri"
  end
  return "Sat"
end

## 1..12 -> "Jan".."Dec"
def _http_month_name(m: Int): String
  if m == 1
    return "Jan"
  end
  if m == 2
    return "Feb"
  end
  if m == 3
    return "Mar"
  end
  if m == 4
    return "Apr"
  end
  if m == 5
    return "May"
  end
  if m == 6
    return "Jun"
  end
  if m == 7
    return "Jul"
  end
  if m == 8
    return "Aug"
  end
  if m == 9
    return "Sep"
  end
  if m == 10
    return "Oct"
  end
  if m == 11
    return "Nov"
  end
  return "Dec"
end
