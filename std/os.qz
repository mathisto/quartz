# OS — Standard Library
#
# Typed wrappers over the already-registered OS intrinsics (argc/argv/exit/
# getenv/setenv/getcwd/chdir/system). These are thin `os_`-prefixed helpers:
# the bare intrinsic names (`getenv`, `chdir`, ...) must NOT be shadowed by a
# same-named `def` or the wrapper would recurse into itself, so every wrapper
# carries the `os_` prefix.
#
# Example:
#   import os
#   for arg in os_args()
#     println(arg)
#   end
#   match os_env("HOME")
#     Option::Some(home) => println("home: " + home)
#     Option::None => println("no HOME set")
#   end

## Number of command-line arguments (>= 1; argv[0] is the binary path).
def os_argc(): Int = argc()

## The nth command-line argument. `os_arg(0)` is the binary path.
def os_arg(n: Int): String = argv(n)

## Collect argv(0)..argv(argc()-1) into a Vec<String>.
def os_args(): Vec<String>
  var args = vec_new<String>()
  var n = argc()
  var i = 0
  while i < n
    args.push(argv(i))
    i = i + 1
  end
  return args
end

## Raw environment lookup: returns the value, or "" when the var is unset.
def os_getenv(key: String): String = getenv(key)

## Typed environment lookup: None when unset (empty), Some(value) otherwise.
def os_env(key: String): Option<String>
  var val = getenv(key)
  if val == ""
    return Option::None
  end
  return Option::Some(val)
end

## Set an environment variable; returns true on success.
def os_setenv(key: String, val: String): Bool = setenv(key, val) == 0

## Current working directory.
def os_cwd(): String = getcwd()

## Change the current working directory; returns true on success.
def os_chdir(path: String): Bool = chdir(path) == 0

## Terminate the process with the given exit code. Never returns.
def os_exit(code: Int): Never = exit(code)

## Run a shell command; returns the child's exit code.
def os_system(cmd: String): Int = system(cmd)
