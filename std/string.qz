# String Processing — Standard Library
#
# Module-level string manipulation functions built on Quartz intrinsics.
# All functions are pure (no mutation of inputs) and return new strings.
#
# Internal implementation uses byte-level intrinsics for O(1) indexing.
# The public API uses codepoint-level semantics by default.
#
# Available byte-level intrinsics used:
#   str_byte_at(s, i) → Int          Get byte value at byte index
#   str_from_char(code) → String     Single char from code point
#   str_byte_slice(s, start, end) → String  Extract [start, end) by byte offset
#   str_byte_find(s, needle) → Option<Int>  Find substring by byte offset, None if not found
#   sb_new() → StringBuilder         Create new string builder
#   sb.append(s)                      Append string to builder
#   sb.append_char(c)                 Append single char to builder
#   sb.to_string() → String          Finalize builder
#
# Example:
#   import string
#   var parts = str_split("a,b,c", ",")       # ["a", "b", "c"]
#   var upper = str_to_upper("hello")          # "HELLO"
#   var trimmed = str_trim("  hi  ")           # "hi"

## Split a string by delimiter, returning a Vec of substrings.
## Returns a single-element Vec containing the original string if delimiter not found.
## Returns empty strings for consecutive delimiters.
def str_split(s: String, delim: String): Vec<String>
  var result = vec_new<String>()
  var len = str_byte_len(s)
  var dlen = str_byte_len(delim)
  if dlen == 0
    # Split each character
    for i in 0..len
      result.push(str_from_char(str_byte_at(s, i)))
    end
    return result
  end
  var start = 0
  while start <= len
    var opt = str_byte_find(str_byte_slice(s, start, len), delim)
    match opt
      Some(pos) => {
        result.push(str_byte_slice(s, start, start + pos))
        start = start + pos + dlen
      }
      None => {
        result.push(str_byte_slice(s, start, len))
        return result
      }
      _ => {
        result.push(str_byte_slice(s, start, len))
        return result
      }
    end
  end
  return result
end

## Join a Vec of strings with a separator.
def str_join(parts: Vec<String>, sep: String): String
  var count = parts.size
  if count == 0
    return ""
  end
  var sb = sb_new()
  sb.append(parts[0])
  for i in 1..count
    sb.append(sep)
    sb.append(parts[i])
  end
  return sb.to_string()
end

## Check if a character code is ASCII whitespace (space, tab, newline, carriage return).
def is_whitespace(c: Int): Bool
  return c == ' ' or c == '\t' or c == '\n' or c == '\r'
end

## Trim whitespace from both sides of a string.
def str_trim(s: String): String
  var len = str_byte_len(s)
  var start = 0
  while start < len and is_whitespace(str_byte_at(s, start))
    start += 1
  end
  var stop = len
  while stop > start and is_whitespace(str_byte_at(s, stop - 1))
    stop -= 1
  end
  return str_byte_slice(s, start, stop)
end

## Trim whitespace from the left side of a string.
def str_trim_left(s: String): String
  var len = str_byte_len(s)
  var start = 0
  while start < len and is_whitespace(str_byte_at(s, start))
    start += 1
  end
  return str_byte_slice(s, start, len)
end

## Trim whitespace from the right side of a string.
def str_trim_right(s: String): String
  var len = str_byte_len(s)
  var stop = len
  while stop > 0 and is_whitespace(str_byte_at(s, stop - 1))
    stop -= 1
  end
  return str_byte_slice(s, 0, stop)
end

## Replace all occurrences of `old` with `new_str` in `s`.
## Returns the original string if `old` is not found.
def str_replace(s: String, old: String, new_str: String): String
  var olen = str_byte_len(old)
  if olen == 0
    return s
  end
  var sb = sb_new()
  var len = str_byte_len(s)
  var start = 0
  while start < len
    var remaining = str_byte_slice(s, start, len)
    var opt = str_byte_find(remaining, old)
    match opt
      Some(pos) => {
        sb.append(str_byte_slice(remaining, 0, pos))
        sb.append(new_str)
        start = start + pos + olen
      }
      None => {
        sb.append(remaining)
        return sb.to_string()
      }
      _ => {
        sb.append(remaining)
        return sb.to_string()
      }
    end
  end
  return sb.to_string()
end

## Check if a string starts with the given prefix.
def str_starts_with(s: String, prefix: String): Bool
  var plen = str_byte_len(prefix)
  if plen > str_byte_len(s)
    return false
  end
  return str_byte_slice(s, 0, plen) == prefix
end

## Check if a string ends with the given suffix.
def str_ends_with(s: String, suffix: String): Bool
  var slen = str_byte_len(suffix)
  var len = str_byte_len(s)
  if slen > len
    return false
  end
  return str_byte_slice(s, len - slen, len) == suffix
end

## Convert ASCII letters in a string to uppercase.
def str_to_upper(s: String): String
  var sb = sb_new()
  var len = str_byte_len(s)
  for i in 0..len
    var c = str_byte_at(s, i)
    if c >= 'a' and c <= 'z'
      sb.append_char(c - 32)
    else
      sb.append_char(c)
    end
  end
  return sb.to_string()
end

## Convert ASCII letters in a string to lowercase.
def str_to_lower(s: String): String
  var sb = sb_new()
  var len = str_byte_len(s)
  for i in 0..len
    var c = str_byte_at(s, i)
    if c >= 'A' and c <= 'Z'
      sb.append_char(c + 32)
    else
      sb.append_char(c)
    end
  end
  return sb.to_string()
end

## Check if a string contains a substring.
def str_contains(s: String, sub: String): Bool
  match str_byte_find(s, sub)
    Some(pos) => return true
    None => return false
    _ => return false
  end
end

## Get a Vec of character codes (codepoint values) from a string.
## Uses codepoint-level iteration. For byte iteration, use str_bytes().
## Note: O(n²) on multi-byte strings due to codepoint indexing.
def str_chars(s: String): Vec<Int>
  var len = s.size
  var result = vec_new()
  for i in 0..len
    result.push(str_codepoint_nth(s, i))
  end
  return result
end

## Repeat a string `n` times.
def str_repeat(s: String, n: Int): String
  if n <= 0
    return ""
  end
  var sb = sb_new()
  for i in 0..n
    sb.append(s)
  end
  return sb.to_string()
end

## Pad a string on the left to reach target length.
def str_pad_left(s: String, target_len: Int, pad_char: String): String
  var len = str_byte_len(s)
  if len >= target_len
    return s
  end
  var sb = sb_new()
  var diff = target_len - len
  for i in 0..diff
    sb.append(pad_char)
  end
  sb.append(s)
  return sb.to_string()
end

## Pad a string on the right to reach target length.
def str_pad_right(s: String, target_len: Int, pad_char: String): String
  var len = str_byte_len(s)
  if len >= target_len
    return s
  end
  var sb = sb_new()
  sb.append(s)
  var diff = target_len - len
  for i in 0..diff
    sb.append(pad_char)
  end
  return sb.to_string()
end

## Reverse a string (byte-level, ASCII-safe).
def str_reverse(s: String): String
  var len = str_byte_len(s)
  if len <= 1
    return s
  end
  var sb = sb_new()
  var i = len - 1
  while i >= 0
    sb.append_char(str_byte_at(s, i))
    i -= 1
  end
  return sb.to_string()
end

## Count occurrences of a substring in a string.
def str_count(s: String, sub: String): Int
  var sublen = str_byte_len(sub)
  if sublen == 0
    return 0
  end
  var count = 0
  var start = 0
  var len = str_byte_len(s)
  while start < len
    var remaining = str_byte_slice(s, start, len)
    var opt = str_byte_find(remaining, sub)
    match opt
      Some(pos) => {
        count += 1
        start = start + pos + sublen
      }
      None => return count
      _ => return count
    end
  end
  return count
end

## Check if a string is empty.
def str_is_empty(s: String): Bool
  return str_byte_len(s) == 0
end

## Get a substring given start index and length.
def str_substr(s: String, start: Int, length: Int): String
  return str_byte_slice(s, start, start + length)
end
