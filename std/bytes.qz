# Bytes — First-class binary data type
#
# A byte array backed by Vec<Int> where each element is a byte (0-255).
# Provides typed readers for structured binary data access.
#
# Example:
#   var data = Bytes { _data: [0x48, 0x65, 0x6C] }
#   var b = data[0]  # 72 (0x48)
#
# `@repr(C)` PINS Bytes on the reference (Boxed) path under value-default structs
# (F4). Bytes instances are reached via `as_int_generic`/`as_type<Bytes>` handles
# stored in RAW MEMORY SLOTS — the HTTP/2 per-stream state (`malloc(64)`,
# `std/net/http2.qz` `_h2s_*`) and the frame `out` buffer (`_h2_read_frame_into`) —
# then MUTATED IN PLACE through those handles: HEADERS+CONTINUATION frames append
# to the same `hdr_block` and multiple DATA frames append to the same `body`
# (`http_server.qz` `hdr_block.push(...)` / `body.push(...)`). Value-copy semantics
# would copy the wrapper on `as_type` read and re-erase a struct value into an i64
# slot is itself the QZ0221 wall (`as_int_generic` on a value-layout struct is a
# compile error). The raw-slot storage has no typed container to retype, so the
# TestFailure-style value de-erase does not apply. `@repr(C)` is positively
# known-Boxed (never flips to value-layout), so the existential-handle bridge keeps
# working AND QZ0221 positively excludes it — exactly as `Suite` (std/qspec/runner.qz)
# and `AstStorage`.
@repr(C)
struct Bytes
  _data: Vec<Int>
end

extend Bytes
  # ---- Access (custom index via LS.6) ----

  def get(index: Int): Int
    return @_data[index]
  end

  def set(index: Int, val: Int): Void
    @_data[index] = val
  end

  def size(): Int
    return @_data.size
  end

  # ---- Typed positional readers ----

  def read_u8(at: Int): Int
    return @_data[at]
  end

  def read_u16be(at: Int): Int
    return (@_data[at] * 256) + @_data[at + 1]
  end

  def read_u16le(at: Int): Int
    return @_data[at] + (@_data[at + 1] * 256)
  end

  def read_u32be(at: Int): Int
    return (@_data[at] * 16777216) + (@_data[at + 1] * 65536) + (@_data[at + 2] * 256) + @_data[at + 3]
  end

  def read_u32le(at: Int): Int
    return @_data[at] + (@_data[at + 1] * 256) + (@_data[at + 2] * 65536) + (@_data[at + 3] * 16777216)
  end

  # ---- Mutation ----

  def push(b: Int): Void
    @_data.push(b)
  end

  ## Return true if the bytes buffer is empty.
  def is_empty(): Bool
    return @_data.size == 0
  end

  ## Convert to a Vec<Int> copy.
  def to_vec(): Vec<Int>
    var result = vec_new()
    var i = 0
    while i < @_data.size
      result.push(@_data[i])
      i += 1
    end
    return result
  end

  # ---- Comparison ----

  def eq(other: Bytes): Bool
    if @_data.size != other.size()
      return false
    end
    var i = 0
    while i < @_data.size
      if @_data[i] != other[i]
        return false
      end
      i = i + 1
    end
    return true
  end
end

import * from traits

extend Bytes with Eq
  def op_eq(self, other: Self): Bool = self.eq(other)
end
