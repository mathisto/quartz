# std/ffi/tls.qz - OpenSSL/LibreSSL FFI bindings (Layer 1 - Raw FFI)
#
# Raw C function declarations for TLS via OpenSSL 3.x / LibreSSL.
# Most users should use std/net/tls instead.
#
# Linking: -lssl -lcrypto
# macOS (Homebrew): -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto
# Linux: -lssl -lcrypto
#
# Usage:
#   import std/ffi/tls

# =============================================================================
# OpenSSL Library Initialization (OpenSSL 1.1+/3.x — auto-initialized)
# =============================================================================

# OPENSSL_init_ssl — Initialize OpenSSL. Called automatically on first use
# in OpenSSL 1.1+, but explicit call is harmless and ensures initialization.
# flags: 0 for default behavior
# Returns: 1 on success, 0 on failure
extern "C" def OPENSSL_init_ssl(opts: Int, settings: CPtr): CInt

# OPENSSL_init_crypto — Initialize crypto library
extern "C" def OPENSSL_init_crypto(opts: Int, settings: CPtr): CInt

# =============================================================================
# SSL Method Selection
# =============================================================================

# TLS_method — Supports TLS 1.0-1.3 (negotiates highest available)
# For general client/server use. Replaces deprecated SSLv23_method.
extern "C" def TLS_method(): CPtr

# TLS_client_method — Client-only TLS method
extern "C" def TLS_client_method(): CPtr

# TLS_server_method — Server-only TLS method
extern "C" def TLS_server_method(): CPtr

# =============================================================================
# SSL_CTX — SSL Context (shared configuration for multiple connections)
# =============================================================================

# SSL_CTX_new — Create new SSL context
# method: Result of TLS_method(), TLS_client_method(), or TLS_server_method()
# Returns: SSL_CTX pointer, or NULL on failure
extern "C" def SSL_CTX_new(method: CPtr): CPtr

# SSL_CTX_free — Free SSL context
extern "C" def SSL_CTX_free(ctx: CPtr): Void

# SSL_CTX_set_verify — Set certificate verification mode
# mode: SSL_VERIFY_NONE (0) or SSL_VERIFY_PEER (1)
# callback: Verification callback, or NULL for default
extern "C" def SSL_CTX_set_verify(ctx: CPtr, mode: CInt, callback: CPtr): Void

# SSL_CTX_set_default_verify_paths — Load default CA certificates
# Uses system default CA bundle (e.g. /etc/ssl/certs on Linux,
# Keychain on macOS via Homebrew OpenSSL)
# Returns: 1 on success, 0 on failure
extern "C" def SSL_CTX_set_default_verify_paths(ctx: CPtr): CInt

# SSL_CTX_load_verify_locations — Load CA certificates from file/directory
# file: Path to CA certificate bundle (PEM format), or NULL
# path: Path to directory with hashed CA certificates, or NULL
# Returns: 1 on success, 0 on failure
extern "C" def SSL_CTX_load_verify_locations(ctx: CPtr, file: CPtr, path: CPtr): CInt

# SSL_CTX_use_certificate_file — Load server certificate
# file: Path to certificate file (PEM format)
# type: SSL_FILETYPE_PEM (1)
# Returns: 1 on success, 0 on failure
extern "C" def SSL_CTX_use_certificate_file(ctx: CPtr, file: CPtr, file_type: CInt): CInt

# SSL_CTX_use_PrivateKey_file — Load server private key
# file: Path to private key file (PEM format)
# type: SSL_FILETYPE_PEM (1)
# Returns: 1 on success, 0 on failure
extern "C" def SSL_CTX_use_PrivateKey_file(ctx: CPtr, file: CPtr, file_type: CInt): CInt

# SSL_CTX_check_private_key — Verify that key matches certificate
# Returns: 1 if key matches, 0 otherwise
extern "C" def SSL_CTX_check_private_key(ctx: CPtr): CInt

# SSL_CTX_ctrl — Generic SSL_CTX control function
# Used for macro-based operations like set_min_proto_version
extern "C" def SSL_CTX_ctrl(ctx: CPtr, cmd: CInt, larg: Int, parg: CPtr): Int

# SSL_CTX_set_min_proto_version — Set minimum TLS protocol version
# This is a macro in OpenSSL: SSL_CTX_ctrl(ctx, 123, version, NULL)
def SSL_CTX_set_min_proto_version(ctx: CPtr, version: Int): Int
  SSL_CTX_ctrl(ctx, 123, version, int_to_cptr(0))
end

# =============================================================================
# SSL — Individual SSL connection
# =============================================================================

# SSL_new — Create new SSL connection from context
# Returns: SSL pointer, or NULL on failure
extern "C" def SSL_new(ctx: CPtr): CPtr

# SSL_free — Free SSL connection
extern "C" def SSL_free(ssl: CPtr): Void

# SSL_set_fd — Attach SSL to a socket file descriptor
# Returns: 1 on success, 0 on failure
extern "C" def SSL_set_fd(ssl: CPtr, fd: CInt): CInt

# SSL_connect — Initiate TLS handshake (client side)
# Returns: 1 on success, 0 or -1 on error (use SSL_get_error for details)
extern "C" def SSL_connect(ssl: CPtr): CInt

# SSL_accept — Accept TLS handshake (server side)
# Returns: 1 on success, 0 or -1 on error
extern "C" def SSL_accept(ssl: CPtr): CInt

# SSL_read — Read decrypted data from TLS connection
# Returns: Number of bytes read, 0 for clean shutdown, <0 for error
extern "C" def SSL_read(ssl: CPtr, buf: CPtr, num: CInt): CInt

# SSL_write — Write data to TLS connection (will be encrypted)
# Returns: Number of bytes written, or <0 for error
extern "C" def SSL_write(ssl: CPtr, buf: CPtr, num: CInt): CInt

# SSL_shutdown — Initiate/complete TLS shutdown
# Returns: 0 (shutdown sent, need to call again), 1 (complete), <0 (error)
extern "C" def SSL_shutdown(ssl: CPtr): CInt

# SSL_get_error — Get error code for last SSL operation
# ret: Return value from the failed SSL operation
# Returns: SSL_ERROR_* constant
extern "C" def SSL_get_error(ssl: CPtr, ret: CInt): CInt

# SSL_get_verify_result — Get certificate verification result
# Returns: X509_V_OK (0) if verification succeeded, or error code
extern "C" def SSL_get_verify_result(ssl: CPtr): Int

# =============================================================================
# SNI (Server Name Indication)
# =============================================================================

# SSL_set_tlsext_host_name — Set hostname for SNI
# This is actually a macro in C, but OpenSSL 3.x exposes it as:
# SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_host_name, name)
extern "C" def SSL_ctrl(ssl: CPtr, cmd: CInt, larg: Int, parg: CPtr): Int

# SSL_CTRL_SET_TLSEXT_HOSTNAME = 55
# TLSEXT_NAMETYPE_host_name = 0
def ssl_set_hostname(ssl: CPtr, hostname: String): Int
  var name_cstr = string_to_cstr(hostname)
  return SSL_ctrl(ssl, 55, 0, name_cstr)
end

# SSL_set1_host — Set expected hostname for certificate verification (OpenSSL 1.1.0+)
# Unlike ssl_set_hostname (SNI), this validates the certificate's subject/SAN matches.
# Returns: 1 on success, 0 on failure
extern "C" def SSL_set1_host(ssl: CPtr, hostname: CPtr): CInt

# Helper: Set hostname verification on an SSL connection
def ssl_set_verify_hostname(ssl: CPtr, hostname: String): Int
  var name_cstr = string_to_cstr(hostname)
  return SSL_set1_host(ssl, name_cstr)
end

# =============================================================================
# ALPN (Application-Layer Protocol Negotiation) — RFC 7301
# =============================================================================

# SSL_CTX_set_alpn_protos — Set ALPN protocol list (client-side, wire format)
# protos: wire-format byte array (length-prefixed strings, e.g. \x02h2\x08http/1.1)
# Returns: 0 on success
extern "C" def SSL_CTX_set_alpn_protos(ctx: CPtr, protos: CPtr, protos_len: CInt): CInt

# SSL_CTX_set_alpn_select_cb — Set server-side ALPN selection callback
# cb: callback with signature (SSL*, out, outlen, in, inlen, arg) -> int
# arg: user data passed to callback
extern "C" def SSL_CTX_set_alpn_select_cb(ctx: CPtr, cb: CPtr, arg: CPtr): Void

# SSL_get0_alpn_selected — Get the negotiated ALPN protocol after handshake
# data: output pointer to protocol string (NOT null-terminated)
# len: output pointer to protocol string length
extern "C" def SSL_get0_alpn_selected(ssl: CPtr, data: CPtr, len: CPtr): Void

# SSL_select_next_proto — Protocol selection helper (for ALPN callbacks)
# Returns: OPENSSL_NPN_NEGOTIATED (1) on match, OPENSSL_NPN_NO_OVERLAP (2) on no match
extern "C" def SSL_select_next_proto(out: CPtr, outlen: CPtr, server: CPtr, server_len: CInt, client: CPtr, client_len: CInt): CInt

def OPENSSL_NPN_NEGOTIATED(): Int = 1
def OPENSSL_NPN_NO_OVERLAP(): Int = 2

# =============================================================================
# Error Handling
# =============================================================================

# ERR_get_error — Get oldest error from error queue
# Returns: Error code, or 0 if no more errors
extern "C" def ERR_get_error(): Int

# ERR_error_string_n — Get human-readable error string
# buf: Buffer to write error string to
# len: Buffer length
extern "C" def ERR_error_string_n(e: Int, buf: CPtr, len: CSize): Void

# ERR_clear_error — Clear the error queue
extern "C" def ERR_clear_error(): Void

# ERR_peek_last_error — Peek at last error without removing
extern "C" def ERR_peek_last_error(): Int

# Helper: Get the last OpenSSL error as a Quartz string
def ssl_error_string(): String
  var err = ERR_get_error()
  if err == 0
    return "unknown SSL error"
  end
  var buf = mem_alloc(256)
  ERR_error_string_n(err, buf, 256)
  var result = cstr_to_string(buf)
  qz_free(buf)
  return result
end

# Helper: Drain all errors from the queue, return the last one
def ssl_drain_errors(): String
  var last_msg = ""
  var err = ERR_get_error()
  while err != 0
    var buf = mem_alloc(256)
    ERR_error_string_n(err, buf, 256)
    last_msg = cstr_to_string(buf)
    qz_free(buf)
    err = ERR_get_error()
  end
  if str_byte_len(last_msg) == 0
    return "unknown SSL error"
  end
  return last_msg
end

# =============================================================================
# Memory Functions (needed for buffer allocation)
# =============================================================================

extern "C" def malloc(size: CSize): CPtr
extern "C" def free(ptr: CPtr): Void
extern "C" def memset(ptr: CPtr, value: CInt, size: CSize): CPtr

# =============================================================================
# Constants
# =============================================================================

# SSL verification modes
def SSL_VERIFY_NONE(): Int = 0
def SSL_VERIFY_PEER(): Int = 1
def SSL_VERIFY_FAIL_IF_NO_PEER_CERT(): Int = 2

# SSL file types
def SSL_FILETYPE_PEM(): Int = 1
def SSL_FILETYPE_ASN1(): Int = 2

# SSL error codes (from SSL_get_error)
def SSL_ERROR_NONE(): Int = 0
def SSL_ERROR_SSL(): Int = 1
def SSL_ERROR_WANT_READ(): Int = 2
def SSL_ERROR_WANT_WRITE(): Int = 3
def SSL_ERROR_WANT_X509_LOOKUP(): Int = 4
def SSL_ERROR_SYSCALL(): Int = 5
def SSL_ERROR_ZERO_RETURN(): Int = 6
def SSL_ERROR_WANT_CONNECT(): Int = 7
def SSL_ERROR_WANT_ACCEPT(): Int = 8

# X509 verification result (from SSL_get_verify_result)
def X509_V_OK(): Int = 0

# TLS protocol versions (for SSL_CTX_set_min_proto_version)
def TLS1_2_VERSION(): Int = 0x0303
def TLS1_3_VERSION(): Int = 0x0304

# OpenSSL init flags
def OPENSSL_INIT_LOAD_SSL_STRINGS(): Int = 0x00200000
def OPENSSL_INIT_LOAD_CRYPTO_STRINGS(): Int = 0x00000002
