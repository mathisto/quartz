##! C stdlib.h FFI declarations
##!
##! Provides extern "C" bindings for standard library functions.
##! Usage: cimport "stdlib.h"

extern "C" def malloc(size: Int): Int
extern "C" def free(ptr: Int): Void
extern "C" def realloc(ptr: Int, size: Int): Int
extern "C" def exit(code: Int): Void
extern "C" def atoi(s: CPtr): Int
extern "C" def getenv(name: CPtr): Int
