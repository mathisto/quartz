##! C stdio.h FFI declarations
##!
##! Provides extern "C" bindings for standard I/O functions.
##! Usage: cimport "stdio.h"

extern "C" def puts(s: CPtr): Int
extern "C" def printf(fmt: CPtr): Int
extern "C" def fprintf(stream: CPtr, fmt: CPtr): Int
extern "C" def fopen(path: CPtr, mode: CPtr): Int
extern "C" def fclose(stream: Int): Int
extern "C" def fgets(buf: CPtr, size: Int, stream: Int): Int
extern "C" def fread(buf: CPtr, size: Int, count: Int, stream: Int): Int
extern "C" def fwrite(buf: CPtr, size: Int, count: Int, stream: Int): Int
extern "C" def fflush(stream: Int): Int
