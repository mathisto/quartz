## Terminal I/O control — POSIX termios + Win32 console FFI bindings.
##
## Provides raw terminal access for line editing, syntax highlighting,
## and interactive REPL functionality.
##
## POSIX path: termios + ioctl/TIOCGWINSZ + fcntl/O_NONBLOCK.
## Windows path: GetStdHandle + Get/SetConsoleMode (with
## ENABLE_VIRTUAL_TERMINAL_INPUT + ENABLE_VIRTUAL_TERMINAL_PROCESSING so
## the existing ANSI escape parser + emitter "just work") +
## GetConsoleScreenBufferInfo + PeekConsoleInputW for non-blocking peek.
## See QUARTZ_WINDOWS_TARGET.md §"TUI Windows backend" for the full
## design memo. Cross-platform consumer code lives in std/terminal.qz.
##
## @since 5.13.0

# =============================================================================
# Core termios functions (POSIX)
# =============================================================================

## Get terminal attributes.
@cfg(not: os: "windows")
extern "C" def tcgetattr(fd: CInt, termios_p: CPtr): CInt

## Set terminal attributes.
## @param actions TCSANOW (0) for immediate, TCSADRAIN (1) after output, TCSAFLUSH (2) after flush.
@cfg(not: os: "windows")
extern "C" def tcsetattr(fd: CInt, actions: CInt, termios_p: CPtr): CInt

## Check if file descriptor refers to a terminal.
## Returns 1 if terminal, 0 otherwise.
##
## Cross-platform: mingw-w64 / UCRT export `isatty` as a forwarding
## alias for `_isatty`; macOS / Linux have the POSIX symbol directly.
extern "C" def isatty(fd: CInt): CInt

## File descriptor control.
@cfg(not: os: "windows")
extern "C" def ioctl(fd: CInt, request: CInt, ...): CInt

# =============================================================================
# Constants — tcsetattr actions (same on all POSIX)
# =============================================================================

## Apply changes immediately.
@cfg(not: os: "windows")
def TCSANOW(): Int = 0

# =============================================================================
# termios struct layout — platform-specific
# =============================================================================
#
# macOS: struct termios is 72 bytes
#   c_iflag:  u64  offset 0   (8 bytes)
#   c_oflag:  u64  offset 8   (8 bytes)
#   c_cflag:  u64  offset 16  (8 bytes)
#   c_lflag:  u64  offset 24  (8 bytes)
#   c_cc:     [20]u8 offset 32
#   c_ispeed: u64  offset 56
#   c_ospeed: u64  offset 64
#
# Linux: struct termios is 60 bytes
#   c_iflag:  u32  offset 0   (4 bytes)
#   c_oflag:  u32  offset 4   (4 bytes)
#   c_cflag:  u32  offset 8   (4 bytes)
#   c_lflag:  u32  offset 12  (4 bytes)
#   c_line:   u8   offset 16
#   c_cc:     [32]u8 offset 17
#   c_ispeed: u32  offset 52
#   c_ospeed: u32  offset 56

## Size of struct termios.
@cfg(os: "macos")
def TERMIOS_SIZE(): Int = 72

@cfg(os: "linux")
def TERMIOS_SIZE(): Int = 60

## Byte offset of c_lflag field.
@cfg(os: "macos")
def TERMIOS_LFLAG_OFFSET(): Int = 24

@cfg(os: "linux")
def TERMIOS_LFLAG_OFFSET(): Int = 12

## Byte width of c_lflag field.
@cfg(os: "macos")
def TERMIOS_LFLAG_WIDTH(): Int = 8

@cfg(os: "linux")
def TERMIOS_LFLAG_WIDTH(): Int = 4

## Byte offset of c_cc array.
@cfg(os: "macos")
def TERMIOS_CC_OFFSET(): Int = 32

@cfg(os: "linux")
def TERMIOS_CC_OFFSET(): Int = 17

# =============================================================================
# Local mode flags (c_lflag)
# =============================================================================

## Canonical mode — line editing enabled.
@cfg(os: "macos")
def ICANON(): Int = 0x100

@cfg(os: "linux")
def ICANON(): Int = 2

## Echo input characters.
@cfg(os: "macos")
def ECHO(): Int = 8

@cfg(os: "linux")
def ECHO(): Int = 8

## Enable signal generation (Ctrl-C → SIGINT, etc).
@cfg(os: "macos")
def ISIG(): Int = 0x80

@cfg(os: "linux")
def ISIG(): Int = 1

## Implementation-defined input processing.
@cfg(os: "macos")
def IEXTEN(): Int = 0x400

@cfg(os: "linux")
def IEXTEN(): Int = 0x8000

# =============================================================================
# Input mode flags (c_iflag) — offset 0 on both platforms
# =============================================================================

## Translate CR to NL on input.
@cfg(os: "macos")
def ICRNL(): Int = 0x100

@cfg(os: "linux")
def ICRNL(): Int = 0x100

## Byte offset of c_iflag field (always 0).
def TERMIOS_IFLAG_OFFSET(): Int = 0

## Byte width of c_iflag field.
@cfg(os: "macos")
def TERMIOS_IFLAG_WIDTH(): Int = 8

@cfg(os: "linux")
def TERMIOS_IFLAG_WIDTH(): Int = 4

# =============================================================================
# c_cc indices — special characters
# =============================================================================

## Index for VMIN (minimum characters for non-canonical read).
@cfg(os: "macos")
def VMIN(): Int = 16

@cfg(os: "linux")
def VMIN(): Int = 6

## Index for VTIME (timeout for non-canonical read, in 1/10 sec).
@cfg(os: "macos")
def VTIME(): Int = 17

@cfg(os: "linux")
def VTIME(): Int = 5

# =============================================================================
# ioctl — terminal window size
# =============================================================================

## ioctl request code for getting terminal window size.
@cfg(os: "macos")
def TIOCGWINSZ(): Int = 0x40087468

@cfg(os: "linux")
def TIOCGWINSZ(): Int = 0x5413

# =============================================================================
# Windows Win32 console FFI (TUI host on Windows — TUI.W)
# =============================================================================
#
# Mirrors the POSIX surface for raw-mode entry/exit, terminal dimensions, and
# non-blocking input peek using the Win32 console API. The strategy is to
# enable ENABLE_VIRTUAL_TERMINAL_INPUT (stdin) + ENABLE_VIRTUAL_TERMINAL_PROCESSING
# (stdout) on raw-mode entry so the existing ANSI-escape parser in
# std/terminal.qz and the existing escape emitter in std/text/style/* work
# without modification. Windows 10 1809+ ships these; Windows Terminal
# supports them universally. Older conhost (Windows 8 / 7) is out of scope.
#
# References:
#   - https://learn.microsoft.com/en-us/windows/console/console-functions
#   - https://learn.microsoft.com/en-us/windows/console/console-virtual-terminal-sequences
#   - crossterm (Rust)             — src/terminal/sys/windows.rs
#   - bubbletea / charm (Go)       — termenv/termenv_windows.go
#   - libuv tty.c                  — src/win/tty.c (reader-thread pattern)
#
# Non-blocking input strategy: PeekConsoleInputW to check the input queue
# without consuming. If a KEY_EVENT is at the head, calling read() will
# return at least one VT-translated byte (ENABLE_VIRTUAL_TERMINAL_INPUT
# rewrites VK codes into ESC sequences). Other event types (focus,
# buffer-resize, mouse) are drained with ReadConsoleInputW and reported
# as "no byte available right now" — the caller's outer poll loop will
# re-peek on the next chunk. WaitForSingleObject signals on ANY event
# (including ones that don't translate to bytes), which is why we use
# PeekConsoleInputW rather than WaitForSingleObject for "is byte
# available" decisions.

# ---- Constants --------------------------------------------------------------

# GetStdHandle nStdHandle arguments. The Win32 type is DWORD (u32), but the
# documented values are -10, -11, -12 cast through unsigned arithmetic.
# Quartz Int is i64 — passing -10 directly works because the callee
# truncates to 32 bits as DWORD.
@cfg(os: "windows")
def STD_INPUT_HANDLE(): Int = -10

@cfg(os: "windows")
def STD_OUTPUT_HANDLE(): Int = -11

@cfg(os: "windows")
def STD_ERROR_HANDLE(): Int = -12

# Input mode flags (Get/SetConsoleMode on STD_INPUT_HANDLE). ORed together.
@cfg(os: "windows")
def ENABLE_PROCESSED_INPUT(): Int = 0x0001
@cfg(os: "windows")
def ENABLE_LINE_INPUT(): Int = 0x0002
@cfg(os: "windows")
def ENABLE_ECHO_INPUT(): Int = 0x0004
@cfg(os: "windows")
def ENABLE_WINDOW_INPUT(): Int = 0x0008
@cfg(os: "windows")
def ENABLE_MOUSE_INPUT(): Int = 0x0010
@cfg(os: "windows")
def ENABLE_INSERT_MODE(): Int = 0x0020
@cfg(os: "windows")
def ENABLE_QUICK_EDIT_MODE(): Int = 0x0040
@cfg(os: "windows")
def ENABLE_EXTENDED_FLAGS(): Int = 0x0080
@cfg(os: "windows")
def ENABLE_VIRTUAL_TERMINAL_INPUT(): Int = 0x0200

# Output mode flags (Get/SetConsoleMode on STD_OUTPUT_HANDLE). ORed together.
@cfg(os: "windows")
def ENABLE_PROCESSED_OUTPUT(): Int = 0x0001
@cfg(os: "windows")
def ENABLE_WRAP_AT_EOL_OUTPUT(): Int = 0x0002
@cfg(os: "windows")
def ENABLE_VIRTUAL_TERMINAL_PROCESSING(): Int = 0x0004
@cfg(os: "windows")
def DISABLE_NEWLINE_AUTO_RETURN(): Int = 0x0008
@cfg(os: "windows")
def ENABLE_LVB_GRID_WORLDWIDE(): Int = 0x0010

# INPUT_RECORD.EventType values
@cfg(os: "windows")
def KEY_EVENT_TYPE(): Int = 0x0001
@cfg(os: "windows")
def MOUSE_EVENT_TYPE(): Int = 0x0002
@cfg(os: "windows")
def WINDOW_BUFFER_SIZE_EVENT_TYPE(): Int = 0x0004
@cfg(os: "windows")
def MENU_EVENT_TYPE(): Int = 0x0008
@cfg(os: "windows")
def FOCUS_EVENT_TYPE(): Int = 0x0010

# CONSOLE_SCREEN_BUFFER_INFO is 22 bytes packed on x64:
#   offset 0:  dwSize.X            (i16)
#   offset 2:  dwSize.Y            (i16)
#   offset 4:  dwCursorPosition.X  (i16)
#   offset 6:  dwCursorPosition.Y  (i16)
#   offset 8:  wAttributes         (u16)
#   offset 10: srWindow.Left       (i16)
#   offset 12: srWindow.Top        (i16)
#   offset 14: srWindow.Right      (i16)
#   offset 16: srWindow.Bottom     (i16)
#   offset 18: dwMaximumWindowSize.X (i16)
#   offset 20: dwMaximumWindowSize.Y (i16)
# Allocate 24 for 8-byte alignment slack — the callee reads 22 + 0 padding.
@cfg(os: "windows")
def CONSOLE_SCREEN_BUFFER_INFO_SIZE(): Int = 24

@cfg(os: "windows")
def CSBI_SRWINDOW_LEFT_OFFSET(): Int = 10
@cfg(os: "windows")
def CSBI_SRWINDOW_TOP_OFFSET(): Int = 12
@cfg(os: "windows")
def CSBI_SRWINDOW_RIGHT_OFFSET(): Int = 14
@cfg(os: "windows")
def CSBI_SRWINDOW_BOTTOM_OFFSET(): Int = 16

# INPUT_RECORD is 20 bytes packed on x64 (EventType u16 + 2-byte pad to align
# the largest union variant on 4 bytes + 16-byte union payload). Only the
# EventType field at offset 0 is accessed from Quartz; payload is opaque.
@cfg(os: "windows")
def INPUT_RECORD_SIZE(): Int = 20

# ---- Externs ----------------------------------------------------------------
#
# kernel32.dll — implicitly linked by mingw-w64 / zig cc; no -lkernel32 needed.
# All Win32 BOOL returns are i32: nonzero = success, 0 = failure. Errors
# retrieve via GetLastError() (which is already declared/used by Phase 4 code).

# Resolve one of the standard handles. Returns HANDLE (pointer-sized, i64).
@cfg(os: "windows")
extern "C" def GetStdHandle(nStdHandle: CInt): Int

# Read or write the current console mode bitmask on a stdin/stdout handle.
@cfg(os: "windows")
extern "C" def GetConsoleMode(hConsole: Int, lpMode: CPtr): CInt

@cfg(os: "windows")
extern "C" def SetConsoleMode(hConsole: Int, dwMode: CInt): CInt

# Read the screen buffer info — used for terminal dimensions via
# srWindow (the visible viewport rectangle, not the larger buffer).
@cfg(os: "windows")
extern "C" def GetConsoleScreenBufferInfo(hConsole: Int, lpInfo: CPtr): CInt

# Peek at the next input event without consuming it. Returns 0 on failure
# (rare — invalid handle); on success, *lpNumberOfEventsRead is the number
# of records actually copied (0 = empty queue, 1 = at least one event).
@cfg(os: "windows")
extern "C" def PeekConsoleInputW(hInput: Int, lpBuffer: CPtr, nLength: CInt, lpNumberOfEventsRead: CPtr): CInt

# Drain one input event from the queue. Used to discard non-key events
# (mouse, focus, buffer-resize) so they don't sit at the head blocking
# subsequent key peeks.
@cfg(os: "windows")
extern "C" def ReadConsoleInputW(hInput: Int, lpBuffer: CPtr, nLength: CInt, lpNumberOfEventsRead: CPtr): CInt

# Sleep — used by term_write's EAGAIN retry path on Windows. mingw-w64
# provides `usleep` as a static-inline wrapper around `Sleep` in
# `<unistd.h>`, but the symbol isn't exported as a CRT entry. Call
# `Sleep(ms)` from kernel32 directly. Signature: `void Sleep(DWORD ms)`.
@cfg(os: "windows")
extern "C" def Sleep(dwMilliseconds: CInt): Void

# ---- Helpers ----------------------------------------------------------------
#
# These present a tidy view of the bit-twiddling and struct-unpacking the
# raw FFI calls require. Consumer code in std/terminal.qz uses these.

# Read a u32 LE from a 4-byte buffer. Used for the lpMode out-param of
# GetConsoleMode and the lpNumberOfEventsRead out-params.
@cfg(os: "windows")
def _winconsole_read_u32_le(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var b2 = ptr_read_byte(ptr_add(p, 2))
  var b3 = ptr_read_byte(ptr_add(p, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

# Read a signed i16 LE from a 2-byte buffer. Used for the srWindow rect
# in CONSOLE_SCREEN_BUFFER_INFO.
@cfg(os: "windows")
def _winconsole_read_i16_le(p: Int): Int
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var raw = b0 + b1 * 256
  if raw >= 32768
    return raw - 65536
  end
  return raw
end
