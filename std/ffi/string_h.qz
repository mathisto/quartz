##! C string.h FFI declarations
##!
##! Provides extern "C" bindings for C string functions.
##! Usage: cimport "string.h"

extern "C" def strlen(s: CPtr): Int
extern "C" def strcmp(a: CPtr, b: CPtr): Int
extern "C" def strcpy(dst: CPtr, src: CPtr): Int
extern "C" def memcpy(dst: CPtr, src: CPtr, n: Int): Int
extern "C" def memset(dst: CPtr, c: Int, n: Int): Int
