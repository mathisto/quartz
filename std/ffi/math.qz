##! C math.h FFI declarations
##!
##! Provides extern "C" bindings for math functions.
##! Usage: cimport "math.h"

extern "C" def sin(x: F64): F64
extern "C" def cos(x: F64): F64
extern "C" def sqrt(x: F64): F64
extern "C" def pow(x: F64, y: F64): F64
extern "C" def floor(x: F64): F64
extern "C" def ceil(x: F64): F64
extern "C" def fabs(x: F64): F64
