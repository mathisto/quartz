# std/ffi/event.qz - Event multiplexing FFI (Layer 1 - Raw FFI)
#
# Platform-specific non-blocking I/O primitives:
#   macOS/BSD: kqueue + kevent
#   Linux:     epoll
#
# Most users should use std/net/event_loop instead.

import std/ffi/socket

# =============================================================================
# fcntl - file descriptor control (for O_NONBLOCK)
# =============================================================================

# fcntl(fd, cmd, ...) - file descriptor control (variadic)
# For F_GETFL, pass no extra arg. For F_SETFL, pass the new flags.
extern "C" def fcntl(fd: CInt, cmd: CInt, ...): CInt

# F_GETFL / F_SETFL (same on macOS and Linux)
def F_GETFL(): Int = 3
def F_SETFL(): Int = 4

# O_NONBLOCK
@cfg(os: "macos")
def O_NONBLOCK(): Int = 4

@cfg(os: "linux")
def O_NONBLOCK(): Int = 2048

# Set a file descriptor to non-blocking mode
# Returns: 0 on success, -1 on error
# NOTE: Inlines O_NONBLOCK value per-platform to work around C bootstrap
# @cfg same-module arity-mangling bug (calls to @cfg-duplicated names within
# the same module emit unmangled references).
@cfg(os: "macos")
def set_nonblocking(fd: Int): Int
  var flags = fcntl(fd, F_GETFL(), 0)
  if flags < 0
    return -1
  end
  return fcntl(fd, F_SETFL(), flags | 4)
end

@cfg(os: "linux")
def set_nonblocking(fd: Int): Int
  var flags = fcntl(fd, F_GETFL(), 0)
  if flags < 0
    return -1
  end
  return fcntl(fd, F_SETFL(), flags | 2048)
end

# =============================================================================
# kqueue (macOS/BSD) - declared unconditionally, gated by @cfg in event_loop
# =============================================================================

extern "C" def kqueue(): CInt

# kevent(kq, changelist, nchanges, eventlist, nevents, timeout)
extern "C" def kevent(kq: CInt, changelist: CPtr, nchanges: CInt, eventlist: CPtr, nevents: CInt, timeout: CPtr): CInt

# kevent struct on macOS/arm64 (32 bytes):
#   offset 0:  ident    (uintptr_t, 8 bytes) - fd
#   offset 8:  filter   (int16_t, 2 bytes)
#   offset 10: flags    (uint16_t, 2 bytes)
#   offset 12: fflags   (uint32_t, 4 bytes)
#   offset 16: data     (intptr_t, 8 bytes)
#   offset 24: udata    (void*, 8 bytes)

def KEVENT_SIZE(): Int = 32

# kevent filters
def EVFILT_READ(): Int = -1
def EVFILT_WRITE(): Int = -2

# kevent flags
def EV_ADD(): Int = 1
def EV_DELETE(): Int = 2
def EV_ENABLE(): Int = 4
def EV_ONESHOT(): Int = 16
def EV_EOF(): Int = 32768
def EV_ERROR(): Int = 16384

# =============================================================================
# epoll (Linux) - declared unconditionally, gated by @cfg in event_loop
# =============================================================================

extern "C" def epoll_create1(flags: CInt): CInt
extern "C" def epoll_ctl(epfd: CInt, op: CInt, fd: CInt, event: CPtr): CInt
extern "C" def epoll_wait(epfd: CInt, events: CPtr, maxevents: CInt, timeout: CInt): CInt

# epoll_event struct on Linux/x86_64 (12 bytes):
#   offset 0: events (uint32_t, 4 bytes)
#   offset 4: data.fd (int32_t, 4 bytes)
#   offset 8: padding (4 bytes)
def EPOLL_EVENT_SIZE(): Int = 12

# epoll operations
def EPOLL_CTL_ADD(): Int = 1
def EPOLL_CTL_DEL(): Int = 2
def EPOLL_CTL_MOD(): Int = 3

# epoll event types
def EPOLLIN(): Int = 1
def EPOLLOUT(): Int = 4
def EPOLLERR(): Int = 8
def EPOLLHUP(): Int = 16
def EPOLLET(): Int = 2147483648

# =============================================================================
# Byte-level memory helpers (little-endian)
# =============================================================================

# Write a 16-bit value at ptr (little-endian)
def ptr_write_i16(ptr: Int, val: Int): Int
  ptr_write_byte(ptr, val & 255)
  ptr_write_byte(ptr_add(ptr, 1), (val >> 8) & 255)
  return 0
end

# Read a 16-bit signed value from ptr (little-endian)
def ptr_read_i16(ptr: Int): Int
  var b0 = ptr_read_byte(ptr)
  var b1 = ptr_read_byte(ptr_add(ptr, 1))
  var val = b0 + b1 * 256
  # Sign-extend from 16-bit
  if val >= 32768
    return val - 65536
  end
  return val
end

# Write a 32-bit value at ptr (little-endian)
def ptr_write_i32(ptr: Int, val: Int): Int
  ptr_write_byte(ptr, val & 255)
  ptr_write_byte(ptr_add(ptr, 1), (val >> 8) & 255)
  ptr_write_byte(ptr_add(ptr, 2), (val >> 16) & 255)
  ptr_write_byte(ptr_add(ptr, 3), (val >> 24) & 255)
  return 0
end

# Read a 32-bit value from ptr (little-endian)
def ptr_read_i32(ptr: Int): Int
  var b0 = ptr_read_byte(ptr)
  var b1 = ptr_read_byte(ptr_add(ptr, 1))
  var b2 = ptr_read_byte(ptr_add(ptr, 2))
  var b3 = ptr_read_byte(ptr_add(ptr, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

# Write a 64-bit value at ptr (little-endian)
def ptr_write_i64(ptr: Int, val: Int): Int
  ptr_write_i32(ptr, val & 4294967295)
  ptr_write_i32(ptr_add(ptr, 4), (val >> 32) & 4294967295)
  return 0
end

# Read a 64-bit value from ptr (little-endian)
def ptr_read_i64(ptr: Int): Int
  var lo = ptr_read_i32(ptr)
  var hi = ptr_read_i32(ptr_add(ptr, 4))
  return lo + hi * 4294967296
end

# =============================================================================
# kevent struct builders (macOS)
# =============================================================================

# Build a kevent struct at the given pointer
# kevent: [ident:8 | filter:2 | flags:2 | fflags:4 | data:8 | udata:8]
@cfg(os: "macos")
def kevent_set(ev: Int, ident: Int, filter: Int, flags: Int): Int
  ptr_write_i64(ev, ident)
  ptr_write_i16(ptr_add(ev, 8), filter)
  ptr_write_i16(ptr_add(ev, 10), flags)
  ptr_write_i32(ptr_add(ev, 12), 0)
  ptr_write_i64(ptr_add(ev, 16), 0)
  ptr_write_i64(ptr_add(ev, 24), 0)
  return 0
end

# Read ident from a kevent struct
@cfg(os: "macos")
def kevent_get_ident(ev: Int): Int
  return ptr_read_i64(ev)
end

# Read filter from a kevent struct
@cfg(os: "macos")
def kevent_get_filter(ev: Int): Int
  return ptr_read_i16(ptr_add(ev, 8))
end

# Read flags from a kevent struct
@cfg(os: "macos")
def kevent_get_flags(ev: Int): Int
  var b0 = ptr_read_byte(ptr_add(ev, 10))
  var b1 = ptr_read_byte(ptr_add(ev, 11))
  return b0 + b1 * 256
end

# Read data from a kevent struct
@cfg(os: "macos")
def kevent_get_data(ev: Int): Int
  return ptr_read_i64(ptr_add(ev, 16))
end

# =============================================================================
# epoll_event struct builders (Linux)
# =============================================================================

# Build an epoll_event struct at the given pointer
# epoll_event: [events:4 | data.fd:4 | padding:4]
@cfg(os: "linux")
def epoll_event_set(ev: Int, events: Int, fd: Int): Int
  ptr_write_i32(ev, events)
  ptr_write_i32(ptr_add(ev, 4), fd)
  ptr_write_i32(ptr_add(ev, 8), 0)
  return 0
end

# Read events from an epoll_event struct
@cfg(os: "linux")
def epoll_event_get_events(ev: Int): Int
  return ptr_read_i32(ev)
end

# Read fd from an epoll_event struct
@cfg(os: "linux")
def epoll_event_get_fd(ev: Int): Int
  return ptr_read_i32(ptr_add(ev, 4))
end

# =============================================================================
# timespec helper (for kqueue timeout)
# =============================================================================

# Build a timespec struct: [tv_sec:8 | tv_nsec:8]
def timespec_set(ts: Int, sec: Int, nsec: Int): Int
  ptr_write_i64(ts, sec)
  ptr_write_i64(ptr_add(ts, 8), nsec)
  return 0
end
