# std/ffi/socket.be - POSIX socket functions (Layer 1 - Raw FFI)
#
# This is the escape hatch for direct C socket access.
# Most users should use std/net/tcp instead.
#
# Usage:
#   import std/ffi/socket
#   fd = socket(AF_INET, SOCK_STREAM, 0)
#   connect(fd, addr_ptr, addr_len)
#   socket_send(fd, buf, len, 0)
#   socket_recv(fd, buf, len, 0)
#   close(fd)

# =============================================================================
# Constants (platform-specific - these are for macOS/BSD)
# =============================================================================

# Address families (same on all POSIX platforms)
def AF_UNSPEC(): Int = 0
def AF_UNIX(): Int = 1
def AF_INET(): Int = 2

# AF_INET6 differs between macOS (30) and Linux (10)
@cfg(os: "macos")
def AF_INET6(): Int = 30

@cfg(os: "linux")
def AF_INET6(): Int = 10

# Socket types (same on all POSIX platforms)
def SOCK_STREAM(): Int = 1   # TCP
def SOCK_DGRAM(): Int = 2    # UDP
def SOCK_RAW(): Int = 3

# Protocol (same on all POSIX platforms)
def IPPROTO_TCP(): Int = 6
def IPPROTO_UDP(): Int = 17

# Shutdown how (same on all POSIX platforms)
def SHUT_RD(): Int = 0       # No more receives
def SHUT_WR(): Int = 1       # No more sends
def SHUT_RDWR(): Int = 2     # No more sends or receives

# Socket options level — differs between macOS (0xFFFF) and Linux (1)
@cfg(os: "macos")
def SOL_SOCKET(): Int = 0xFFFF

@cfg(os: "linux")
def SOL_SOCKET(): Int = 1

# Socket options — differ between macOS and Linux
@cfg(os: "macos")
def SO_REUSEADDR(): Int = 0x0004

@cfg(os: "linux")
def SO_REUSEADDR(): Int = 2

@cfg(os: "macos")
def SO_KEEPALIVE(): Int = 0x0008

@cfg(os: "linux")
def SO_KEEPALIVE(): Int = 9

@cfg(os: "macos")
def SO_RCVTIMEO(): Int = 0x1006

@cfg(os: "linux")
def SO_RCVTIMEO(): Int = 20

@cfg(os: "macos")
def SO_SNDTIMEO(): Int = 0x1005

@cfg(os: "linux")
def SO_SNDTIMEO(): Int = 21

# TCP_NODELAY option (disables Nagle's algorithm)
def TCP_NODELAY(): Int = 1

# SO_NOSIGPIPE (macOS only — prevents SIGPIPE on broken pipe)
@cfg(os: "macos")
def SO_NOSIGPIPE(): Int = 0x1022

# MSG_NOSIGNAL (Linux only — prevents SIGPIPE on send)
@cfg(os: "linux")
def MSG_NOSIGNAL(): Int = 16384

# =============================================================================
# Structs
# =============================================================================

# sockaddr_in - IPv4 socket address
# Uses @cfg to handle BSD/macOS vs Linux layout differences
@repr(C)
struct SockaddrIn
  @cfg(os: "macos")
  sin_len: U8         # Length of structure (BSD only)
  sin_family: U8      # AF_INET
  sin_port: U16       # Port number (network byte order)
  sin_addr: U32       # IP address (network byte order)
  sin_zero: Int       # Padding (8 bytes)
end

# timeval - for socket timeouts
@repr(C)
struct Timeval
  tv_sec: Int          # Seconds
  tv_usec: Int         # Microseconds
end

# addrinfo - DNS resolution result
# NOTE: macOS field order — ai_canonname BEFORE ai_addr (differs from Linux)
# Linux field order — ai_addr BEFORE ai_canonname
@cfg(os: "macos")
@repr(C)
struct Addrinfo
  ai_flags: U32       # Input flags
  ai_family: U32      # Address family (AF_INET, etc.)
  ai_socktype: U32    # Socket type (SOCK_STREAM, etc.)
  ai_protocol: U32    # Protocol (IPPROTO_TCP, etc.)
  ai_addrlen: U32     # Length of ai_addr
  ai_canonname: Int   # Canonical hostname (char*, 8 bytes)
  ai_addr: Int        # Socket address (struct sockaddr*, 8 bytes)
  ai_next: Int        # Next in linked list (struct addrinfo*, 8 bytes)
end

# TODO: Verify on Linux
@cfg(os: "linux")
@repr(C)
struct Addrinfo
  ai_flags: U32       # Input flags
  ai_family: U32      # Address family (AF_INET, etc.)
  ai_socktype: U32    # Socket type (SOCK_STREAM, etc.)
  ai_protocol: U32    # Protocol (IPPROTO_TCP, etc.)
  ai_addrlen: U32     # Length of ai_addr
  ai_addr: Int        # Socket address (struct sockaddr*, 8 bytes)
  ai_canonname: Int   # Canonical hostname (char*, 8 bytes)
  ai_next: Int        # Next in linked list (struct addrinfo*, 8 bytes)
end

# =============================================================================
# Core Socket Functions
# =============================================================================

# socket - Create a socket
# Returns: File descriptor on success, -1 on error
# Windows: SOCKET (u64) is the return type, not int — see ws2_socket below.
@cfg(not: os: "windows")
extern "C" def socket(domain: CInt, socket_type: CInt, protocol: CInt): CInt

# connect - Connect to a remote address
# Returns: 0 on success, -1 on error
# Windows: first arg is SOCKET (u64) — see ws2_connect below.
@cfg(not: os: "windows")
extern "C" def connect(sockfd: CInt, addr: CPtr, addrlen: CInt): CInt

# bind - Bind socket to local address
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def bind(sockfd: CInt, addr: CPtr, addrlen: CInt): CInt

# listen - Mark socket as listening
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def listen(sockfd: CInt, backlog: CInt): CInt

# accept - Accept incoming connection
# Returns: New socket fd on success, -1 on error
@cfg(not: os: "windows")
extern "C" def accept(sockfd: CInt, addr: CPtr, addrlen: CPtr): CInt

# sendto - Send data to a specific address (for UDP)
# Returns: Bytes sent on success, -1 on error
@cfg(not: os: "windows")
extern "C" def sendto(sockfd: CInt, buf: CPtr, len: CSize, flags: CInt, addr: CPtr, addrlen: CInt): Int

# recvfrom - Receive data and get sender address (for UDP)
# Returns: Bytes received on success, -1 on error
@cfg(not: os: "windows")
extern "C" def recvfrom(sockfd: CInt, buf: CPtr, len: CSize, flags: CInt, addr: CPtr, addrlen: CPtr): Int

# shutdown - Shut down part of a connection
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def shutdown(sockfd: CInt, how: CInt): CInt

# close - Close file descriptor (from unistd.h)
# On Windows this closes a file HANDLE (MSVCRT _close), NOT a socket.
# Use ws2_closesocket for sockets on Windows.
extern "C" def close(fd: CInt): CInt

# setsockopt - Set socket options
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def setsockopt(sockfd: CInt, level: CInt, optname: CInt, optval: CPtr, optlen: CInt): CInt

# getsockname - Get local address of socket
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def getsockname(sockfd: CInt, addr: CPtr, addrlen: CPtr): CInt

# getsockopt - Get socket options
# Returns: 0 on success, -1 on error
@cfg(not: os: "windows")
extern "C" def getsockopt(sockfd: CInt, level: CInt, optname: CInt, optval: CPtr, optlen: CPtr): CInt

# =============================================================================
# Address Conversion Functions
# =============================================================================

# htons - Host to network short (16-bit)
# Pure Quartz implementation (htons is a C macro, not a linkable function)
def htons(port: Int): Int = bor(shl(band(port, 255), 8), band(shr(port, 8), 255))

# ntohs - Network to host short (16-bit)
def ntohs(net: Int): Int = bor(shl(band(net, 255), 8), band(shr(net, 8), 255))

# htonl - Host to network long (32-bit)
def htonl(host: Int): Int
  var b0 = band(host, 255)
  var b1 = band(shr(host, 8), 255)
  var b2 = band(shr(host, 16), 255)
  var b3 = band(shr(host, 24), 255)
  return bor(bor(shl(b0, 24), shl(b1, 16)), bor(shl(b2, 8), b3))
end

# ntohl - Network to host long (32-bit)
def ntohl(net: Int): Int = htonl(net)

# inet_pton - Convert IP string to binary
# Returns: 1 on success, 0 for invalid address, -1 on error
extern "C" def inet_pton(af: CInt, src: CPtr, dst: CPtr): CInt

# inet_ntop - Convert binary IP to string
# Returns: Pointer to dst on success, nil on error
extern "C" def inet_ntop(af: CInt, src: CPtr, dst: CPtr, size: CInt): CPtr

# =============================================================================
# DNS Resolution (from netdb.h)
# =============================================================================

# getaddrinfo - Network address and service translation
# Returns: 0 on success, error code on failure
extern "C" def getaddrinfo(node: CPtr, service: CPtr, hints: CPtr, res: CPtr): CInt

# freeaddrinfo - Free addrinfo structure
extern "C" def freeaddrinfo(res: CPtr): CInt

# gai_strerror - Get error string for getaddrinfo
extern "C" def gai_strerror(errcode: CInt): CPtr

# =============================================================================
# Memory Functions (from stdlib.h)
# =============================================================================

# malloc - Allocate memory
extern "C" def malloc(size: CSize): CPtr

# free - Free memory
extern "C" def free(ptr: CPtr): Void

# memset - Set memory to a value
extern "C" def memset(ptr: CPtr, value: CInt, size: CSize): CPtr

# memcpy - Copy memory
extern "C" def memcpy(dest: CPtr, src: CPtr, size: CSize): CPtr

# strlen - Get string length
extern "C" def strlen(str: CPtr): CSize

# =============================================================================
# Error Handling
# =============================================================================

# errno location (thread-safe)
# macOS: __error() returns int*
# Linux: __errno_location() returns int*
@cfg(os: "macos")
extern "C" def __error(): CPtr

@cfg(os: "linux")
extern "C" def __errno_location(): CPtr

# strerror - Get error string
extern "C" def strerror(errnum: CInt): CPtr

# Helper to get errno value
@cfg(os: "macos")
def get_errno(): Int
  var p = __error()
  # Read 4 bytes of int (little-endian)
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var b2 = ptr_read_byte(ptr_add(p, 2))
  var b3 = ptr_read_byte(ptr_add(p, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

# TODO: Verify on Linux
@cfg(os: "linux")
def get_errno(): Int
  var p = __errno_location()
  # Read 4 bytes of int (little-endian)
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var b2 = ptr_read_byte(ptr_add(p, 2))
  var b3 = ptr_read_byte(ptr_add(p, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

# =============================================================================
# Poll (for connect timeouts and event waiting)
# =============================================================================

# poll - Wait for events on file descriptors
# fds: Array of pollfd structs
# nfds: Number of file descriptors
# timeout: Timeout in milliseconds (-1 for infinite)
# Returns: Number of ready fds, 0 on timeout, -1 on error
# Windows: use ws2_WSAPoll below — same shape, but pollfd.fd is SOCKET (i64).
@cfg(not: os: "windows")
extern "C" def poll(fds: CPtr, nfds: CInt, timeout: CInt): CInt

# pollfd struct layout (8 bytes on POSIX, 16 on Windows — see WSAPOLLFD_SIZE
# in the Windows block below):
#   POSIX:   fd: i32 (offset 0), events: i16 (4), revents: i16 (6)
#   Windows: fd: SOCKET=i64 (offset 0), events: i16 (8), revents: i16 (10),
#            pad (12-15)
@cfg(not: os: "windows")
def POLLFD_SIZE(): Int = 8

# Poll event flags — POSIX values. Windows uses different bitmasks; see the
# Windows block below for WSA equivalents. For cross-platform code that
# just wants "is data readable" semantics, use socket_wait_one() with the
# platform-appropriate POLLIN() / POLLOUT() — both are platform-gated.
@cfg(not: os: "windows")
def POLLIN(): Int = 1       # Data ready to read
@cfg(not: os: "windows")
def POLLOUT(): Int = 4      # Ready to write
@cfg(not: os: "windows")
def POLLERR(): Int = 8      # Error condition
@cfg(not: os: "windows")
def POLLHUP(): Int = 16     # Hung up
@cfg(not: os: "windows")
def POLLNVAL(): Int = 32    # Invalid fd

# Helper: Create a pollfd struct in memory
def pollfd_new(fd: Int, events: Int): Int
  var p = mem_alloc(POLLFD_SIZE())
  # Write fd as i32
  ptr_write_byte(p, band(fd, 255))
  ptr_write_byte(ptr_add(p, 1), band(shr(fd, 8), 255))
  ptr_write_byte(ptr_add(p, 2), band(shr(fd, 16), 255))
  ptr_write_byte(ptr_add(p, 3), band(shr(fd, 24), 255))
  # Write events as i16
  ptr_write_byte(ptr_add(p, 4), band(events, 255))
  ptr_write_byte(ptr_add(p, 5), band(shr(events, 8), 255))
  # revents = 0
  ptr_write_byte(ptr_add(p, 6), 0)
  ptr_write_byte(ptr_add(p, 7), 0)
  return p
end

# Helper: Read revents from pollfd struct
def pollfd_revents(p: Int): Int
  var b0 = ptr_read_byte(ptr_add(p, 6))
  var b1 = ptr_read_byte(ptr_add(p, 7))
  return b0 + b1 * 256
end

# fcntl — file descriptor control (for non-blocking mode)
# Windows: no fcntl; use ws2_ioctlsocket(fd, FIONBIO, &one) instead.
@cfg(not: os: "windows")
extern "C" def fcntl(fd: CInt, cmd: CInt, ...): CInt

# fcntl commands
def F_GETFL(): Int = 3
def F_SETFL(): Int = 4
def O_NONBLOCK(): Int = 4

# EINPROGRESS errno value
@cfg(os: "macos")
def EINPROGRESS(): Int = 36

@cfg(os: "linux")
def EINPROGRESS(): Int = 115

# EAGAIN / EWOULDBLOCK errno value
@cfg(os: "macos")
def EAGAIN(): Int = 35
@cfg(os: "linux")
def EAGAIN(): Int = 11
@cfg(os: "macos")
def EWOULDBLOCK(): Int = 35
@cfg(os: "linux")
def EWOULDBLOCK(): Int = 11

# EINTR — interrupted by signal. Both macOS and Linux: 4.
@cfg(not: os: "windows")
def EINTR(): Int = 4

# SO_ERROR option for getsockopt
@cfg(not: os: "windows")
def SO_ERROR(): Int = 4

# =============================================================================
# Wrapper functions for send/recv
# =============================================================================
# Use sendto/recvfrom with NULL addr, equivalent to send/recv on connected sockets.

@cfg(not: os: "windows")
def socket_fcntl(fd: Int, cmd: Int, arg: Int): Int = fcntl(fd, cmd, arg)

@cfg(not: os: "windows")
def socket_accept(sockfd: Int, addr: Int, addrlen: Int): Int = accept(sockfd, int_to_cptr(addr), int_to_cptr(addrlen))

@cfg(os: "windows")
def socket_accept(sockfd: Int, addr: Int, addrlen: Int): Int = accept(sockfd, int_to_cptr(addr), int_to_cptr(addrlen))

@cfg(not: os: "windows")
def socket_send(sockfd: Int, buf: Int, len: Int, flags: Int): Int
  sendto(sockfd, buf, len, flags, int_to_cptr(0), 0)
end

# Windows send() has no addr parameters (the POSIX equivalent of send() rather
# than sendto()). 4 args, not 6.
@cfg(os: "windows")
def socket_send(sockfd: Int, buf: Int, len: Int, flags: Int): Int = send(sockfd, int_to_cptr(buf), len, flags)

@cfg(not: os: "windows")
def socket_recv(sockfd: Int, buf: Int, len: Int, flags: Int): Int
  recvfrom(sockfd, buf, len, flags, int_to_cptr(0), int_to_cptr(0))
end

@cfg(os: "windows")
def socket_recv(sockfd: Int, buf: Int, len: Int, flags: Int): Int = recv(sockfd, int_to_cptr(buf), len, flags)

# =============================================================================
# POSIX I/O (read/write/pipe — for pipes, files, and general fd I/O)
# =============================================================================

# read - Read from file descriptor
extern "C" def read(fd: CInt, buf: CPtr, count: CSize): Int

# write - Write to file descriptor
extern "C" def write(fd: CInt, buf: CPtr, count: CSize): Int

# pipe - Create a unidirectional pipe
# pipefd: pointer to int[2] — pipefd[0] is read end, pipefd[1] is write end
# Windows: no pipe(); use CreatePipe from kernel32 with a different shape.
@cfg(not: os: "windows")
extern "C" def pipe(pipefd: CPtr): CInt

# Create a pipe. Returns Vec with [read_fd, write_fd], or empty Vec on error.
@cfg(not: os: "windows")
def pipe_create(): Vec<Int>
  var buf = mem_alloc(8)
  var ret = pipe(buf)
  var result = vec_new<Int>()
  if ret == 0
    # Read two 32-bit ints from the buffer (little-endian)
    var b0 = ptr_read_byte(buf)
    var b1 = ptr_read_byte(ptr_add(buf, 1))
    var b2 = ptr_read_byte(ptr_add(buf, 2))
    var b3 = ptr_read_byte(ptr_add(buf, 3))
    var read_fd = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    var b4 = ptr_read_byte(ptr_add(buf, 4))
    var b5 = ptr_read_byte(ptr_add(buf, 5))
    var b6 = ptr_read_byte(ptr_add(buf, 6))
    var b7 = ptr_read_byte(ptr_add(buf, 7))
    var write_fd = b4 + b5 * 256 + b6 * 65536 + b7 * 16777216
    result.push(read_fd)
    result.push(write_fd)
  end
  qz_free(buf)
  return result
end

# Write a single byte to fd. Returns bytes written or -1.
def fd_write_byte(fd: Int, byte_val: Int): Int
  var buf = mem_alloc(1)
  ptr_write_byte(buf, byte_val)
  var n = write(fd, buf, 1)
  qz_free(buf)
  return n
end

# Read up to max_bytes from fd into buf. Returns bytes read or -1.
def fd_read(fd: Int, buf: Int, max_bytes: Int): Int
  return read(fd, buf, max_bytes)
end

# =============================================================================
# Windows ws2_32 socket FFI (Phase 5e+: end-to-end TCP on Windows)
# =============================================================================
#
# These are the Windows-specific socket FFI declarations. The POSIX FFI above
# remains the canonical surface on macOS / Linux; here we mirror the same
# functionality with Windows ABI (SOCKET = UINT_PTR / i64 on x64) and the
# WSA* error-handling shape.
#
# Two ABI gotchas the POSIX block can't paper over:
#   1. SOCKET is u64 on x64-Windows. Declaring socket() as returning CInt
#      silently truncates the high 32 bits — for small handles it usually
#      "works," but it's a latent bug. Here we declare it as Int (i64).
#   2. send/recv/bind/setsockopt/etc. all take SOCKET as their first arg.
#      The mingw-w64 winsock2.h header makes this work in C; we have to be
#      explicit at the FFI boundary.
#
# Three runtime gotchas every Windows socket consumer must respect:
#   - Every program MUST call WSAStartup before any socket call. The
#     ws2_init_once() helper at the bottom guards a static flag so this
#     is a single one-time cost the first time anything touches a socket.
#   - close() does NOT close a socket on Windows — it works on file HANDLEs
#     (from MSVCRT _close). Sockets need closesocket().
#   - errno isn't populated by socket errors. Use ws2_last_error() instead.
#
# References:
#   - https://learn.microsoft.com/en-us/windows/win32/api/winsock2/
#   - mingw-w64 winsock2.h, ws2tcpip.h
#   - libuv src/win/winsock.c (for AFD interop patterns)

# ---- Windows-specific constants ---------------------------------------------

@cfg(os: "windows")
def AF_INET6(): Int = 23

@cfg(os: "windows")
def SOL_SOCKET(): Int = 0xFFFF

@cfg(os: "windows")
def SO_REUSEADDR(): Int = 4

@cfg(os: "windows")
def SO_KEEPALIVE(): Int = 8

@cfg(os: "windows")
def SO_RCVTIMEO(): Int = 0x1006

@cfg(os: "windows")
def SO_SNDTIMEO(): Int = 0x1005

@cfg(os: "windows")
def SO_ERROR(): Int = 0x1007

# MAKEWORD(2, 2) — request Winsock v2.2. Encoded as (high << 8) | low.
@cfg(os: "windows")
def WSA_MAKEWORD_2_2(): Int = 514

# WSADATA on x64 packs to ~404 bytes (wVersion + wHighVersion +
# szDescription[257] + szSystemStatus[129] + iMaxSockets + iMaxUdpDg +
# lpVendorInfo). 512 gives ample headroom plus 8-byte alignment slack.
@cfg(os: "windows")
def WSADATA_SIZE(): Int = 512

# FIONBIO — set/clear non-blocking mode. Encoded _IOW('f', 126, u_long).
@cfg(os: "windows")
def FIONBIO(): Int = 0x8004667E

# Winsock error codes (returned by WSAGetLastError()). All POSIX errno values
# offset by +10000. See <winerror.h>.
@cfg(os: "windows")
def WSAEINTR(): Int = 10004
@cfg(os: "windows")
def WSAEBADF(): Int = 10009
@cfg(os: "windows")
def WSAEACCES(): Int = 10013
@cfg(os: "windows")
def WSAEFAULT(): Int = 10014
@cfg(os: "windows")
def WSAEINVAL(): Int = 10022
@cfg(os: "windows")
def WSAEMFILE(): Int = 10024
@cfg(os: "windows")
def WSAEWOULDBLOCK(): Int = 10035
@cfg(os: "windows")
def WSAEINPROGRESS(): Int = 10036
@cfg(os: "windows")
def WSAEALREADY(): Int = 10037
@cfg(os: "windows")
def WSAENOTSOCK(): Int = 10038
@cfg(os: "windows")
def WSAEMSGSIZE(): Int = 10040
@cfg(os: "windows")
def WSAEADDRINUSE(): Int = 10048
@cfg(os: "windows")
def WSAEADDRNOTAVAIL(): Int = 10049
@cfg(os: "windows")
def WSAENETUNREACH(): Int = 10051
@cfg(os: "windows")
def WSAECONNABORTED(): Int = 10053
@cfg(os: "windows")
def WSAECONNRESET(): Int = 10054
@cfg(os: "windows")
def WSAEISCONN(): Int = 10056
@cfg(os: "windows")
def WSAENOTCONN(): Int = 10057
@cfg(os: "windows")
def WSAESHUTDOWN(): Int = 10058
@cfg(os: "windows")
def WSAETIMEDOUT(): Int = 10060
@cfg(os: "windows")
def WSAECONNREFUSED(): Int = 10061
@cfg(os: "windows")
def WSAEHOSTUNREACH(): Int = 10065

# Cross-platform aliases — re-export POSIX names with Windows values so
# consumer code can stay shape-portable when the only difference is the
# numeric value. (For functions that need different *behavior* between
# POSIX and Windows — close vs closesocket, fcntl vs ioctlsocket — see
# the socket_* helpers at the bottom of this section.)
@cfg(os: "windows")
def EAGAIN(): Int = 10035            # WSAEWOULDBLOCK
@cfg(os: "windows")
def EWOULDBLOCK(): Int = 10035       # WSAEWOULDBLOCK
@cfg(os: "windows")
def EINPROGRESS(): Int = 10036       # WSAEINPROGRESS
@cfg(os: "windows")
def EINTR(): Int = 10004             # WSAEINTR

# ---- Windows externs (ws2_32.dll except where noted) ------------------------

# WSAStartup expects a WORD (u16); declaring as CInt is ABI-safe on x64
# because the unused high bits are ignored by the callee.
@cfg(os: "windows")
extern "C" def WSAStartup(wVersionRequested: CInt, lpWSAData: CPtr): CInt

@cfg(os: "windows")
extern "C" def WSACleanup(): CInt

@cfg(os: "windows")
extern "C" def WSAGetLastError(): CInt

# socket / bind / listen / accept / connect / send / recv / setsockopt /
# getsockopt / getsockname / shutdown — Windows variants. SOCKET (i64) on
# x64; the rest of the args mirror POSIX shapes. Returns -1 on error in
# the int-returning calls, INVALID_SOCKET (cast to i64 is -1) in the
# SOCKET-returning calls.
@cfg(os: "windows")
extern "C" def socket(domain: CInt, socket_type: CInt, protocol: CInt): Int

@cfg(os: "windows")
extern "C" def bind(s: Int, addr: CPtr, addrlen: CInt): CInt

@cfg(os: "windows")
extern "C" def listen(s: Int, backlog: CInt): CInt

@cfg(os: "windows")
extern "C" def accept(s: Int, addr: CPtr, addrlen: CPtr): Int

@cfg(os: "windows")
extern "C" def connect(s: Int, addr: CPtr, addrlen: CInt): CInt

@cfg(os: "windows")
extern "C" def send(s: Int, buf: CPtr, len: CInt, flags: CInt): CInt

@cfg(os: "windows")
extern "C" def recv(s: Int, buf: CPtr, len: CInt, flags: CInt): CInt

@cfg(os: "windows")
extern "C" def setsockopt(s: Int, level: CInt, optname: CInt, optval: CPtr, optlen: CInt): CInt

@cfg(os: "windows")
extern "C" def getsockopt(s: Int, level: CInt, optname: CInt, optval: CPtr, optlen: CPtr): CInt

@cfg(os: "windows")
extern "C" def getsockname(s: Int, addr: CPtr, addrlen: CPtr): CInt

@cfg(os: "windows")
extern "C" def shutdown(s: Int, how: CInt): CInt

@cfg(os: "windows")
extern "C" def closesocket(s: Int): CInt

# ioctlsocket(s, FIONBIO, &one) — Windows non-blocking. cmd is an unsigned
# i32 (DWORD), argp points to a u_long (4 bytes).
@cfg(os: "windows")
extern "C" def ioctlsocket(s: Int, cmd: CInt, argp: CPtr): CInt

# WSAPoll — Windows poll(). pollfd layout differs from POSIX (fd is SOCKET
# = 8 bytes, not int = 4 bytes; total struct size is 16 bytes, not 8).
@cfg(os: "windows")
extern "C" def WSAPoll(fdarr: CPtr, nfds: CInt, timeout: CInt): CInt

# WSAPOLLFD struct size on x64 (16 bytes):
#   offset 0:  fd      (SOCKET, 8 bytes)
#   offset 8:  events  (i16, 2 bytes)
#   offset 10: revents (i16, 2 bytes)
#   offset 12: padding (4 bytes — 8-byte align of next struct in array)
@cfg(os: "windows")
def WSAPOLLFD_SIZE(): Int = 16

# Re-export the pollfd-size name as platform-appropriate. cross-platform
# code that allocates a single pollfd struct can use POLLFD_SIZE() and
# get 8 on POSIX, 16 on Windows.
@cfg(os: "windows")
def POLLFD_SIZE(): Int = 16

# Windows POLL* event flags. <winsock2.h> values; differ from POSIX in
# both magnitude (different bits) and definition (POLLIN here is the
# union of POLLRDNORM + POLLRDBAND).
@cfg(os: "windows")
def POLLRDNORM(): Int = 0x100
@cfg(os: "windows")
def POLLRDBAND(): Int = 0x200
@cfg(os: "windows")
def POLLIN(): Int = 0x300   # POLLRDNORM | POLLRDBAND
@cfg(os: "windows")
def POLLWRNORM(): Int = 0x10
@cfg(os: "windows")
def POLLOUT(): Int = 0x10   # POLLWRNORM (no POLLWRBAND on Windows)
@cfg(os: "windows")
def POLLERR(): Int = 0x1
@cfg(os: "windows")
def POLLHUP(): Int = 0x2
@cfg(os: "windows")
def POLLNVAL(): Int = 0x4

# ---- Cross-platform helpers -------------------------------------------------
#
# These are the right thing for consumer code that wants to be portable.
# They branch on @cfg internally so callers don't have to.

# socket_init_once — call before any socket operation on Windows; no-op on
# POSIX. Idempotent: WSAStartup is called exactly once per process via a
# module-level guard. Returns 0 on success, non-zero on WSA error.

@cfg(not: os: "windows")
def socket_init_once(): Int = 0

@cfg(os: "windows")
def socket_init_once(): Int
  if __wsa_initialized_flag() != 0
    return 0
  end
  var wsadata = mem_alloc(WSADATA_SIZE())
  var rc = WSAStartup(WSA_MAKEWORD_2_2(), wsadata)
  qz_free(wsadata)
  if rc == 0
    __wsa_set_initialized()
  end
  return rc
end

# socket_close — closesocket on Windows, close on POSIX. Use for socket fds
# (not file descriptors).
@cfg(not: os: "windows")
def socket_close(fd: Int): Int = close(fd)

@cfg(os: "windows")
def socket_close(fd: Int): Int = closesocket(fd)

# socket_last_error — WSAGetLastError on Windows, errno on POSIX.
# Gated on explicit POSIX OS list (not `not: os: "windows"`) so freestanding
# targets — which classify as os="unknown" — don't pull in the body and
# trip a typecheck-time `Undefined function: get_errno` (get_errno itself
# is gated `os: "linux" | "macos"`). The asymmetry was introduced by
# 20da7f5a (ws2_32 user FFI) without re-running baremetal:build_elf.
@cfg(any: os: "linux", os: "macos")
def socket_last_error(): Int = get_errno()

@cfg(os: "windows")
def socket_last_error(): Int = WSAGetLastError()

# socket_set_nonblock — set a socket to non-blocking mode.
#   POSIX: fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK)
#   Windows: ioctlsocket(fd, FIONBIO, &one) — write a u_long != 0
#   Freestanding: no-op (kernel TCP is always non-blocking — there is
#     no underlying socket fd with O_NONBLOCK to flip). D.11 Phase 8a
#     step 5.
# Returns 0 on success, -1 on error.
@cfg(any: os: "linux", os: "macos")
def socket_set_nonblock(fd: Int): Int
  var flags = fcntl(fd, F_GETFL(), 0)
  if flags < 0
    return -1
  end
  return fcntl(fd, F_SETFL(), bor(flags, O_NONBLOCK()))
end

@cfg(os: "windows")
def socket_set_nonblock(fd: Int): Int
  var argp = mem_alloc(4)
  ptr_write_byte(argp, 1)
  ptr_write_byte(ptr_add(argp, 1), 0)
  ptr_write_byte(ptr_add(argp, 2), 0)
  ptr_write_byte(ptr_add(argp, 3), 0)
  var rc = ioctlsocket(fd, FIONBIO(), argp)
  qz_free(argp)
  return rc
end

@cfg(os: "unknown")
def socket_set_nonblock(fd: Int): Int = 0

# socket_set_blocking — undo socket_set_nonblock. Returns 0 on success,
# -1 on error. Useful for connect-with-timeout patterns that flip a
# socket to non-blocking for the connect+poll window, then restore
# blocking before handing the fd to higher-level code that expects
# blocking semantics.
@cfg(any: os: "linux", os: "macos")
def socket_set_blocking(fd: Int): Int
  var flags = fcntl(fd, F_GETFL(), 0)
  if flags < 0
    return -1
  end
  # Clear O_NONBLOCK bit. bxor + band would work; here we just mask via
  # (flags & ~O_NONBLOCK). Quartz integers are 64-bit signed; the
  # complement of O_NONBLOCK keeps the low bits we care about.
  var without_nonblock = band(flags, bxor(-1, O_NONBLOCK()))
  return fcntl(fd, F_SETFL(), without_nonblock)
end

@cfg(os: "windows")
def socket_set_blocking(fd: Int): Int
  var argp = mem_alloc(4)
  ptr_write_byte(argp, 0)
  ptr_write_byte(ptr_add(argp, 1), 0)
  ptr_write_byte(ptr_add(argp, 2), 0)
  ptr_write_byte(ptr_add(argp, 3), 0)
  var rc = ioctlsocket(fd, FIONBIO(), argp)
  qz_free(argp)
  return rc
end

@cfg(os: "unknown")
def socket_set_blocking(fd: Int): Int = 0

# socket_wait_one — block until `events` are ready on `fd` or `timeout_ms`
# expires. Returns: 1 if ready, 0 on timeout, -1 on error.
#
# This is the cross-platform 1-fd specialization of poll / WSAPoll. For
# the connect-with-timeout pattern this is all you need; the multi-fd
# version is filed forward (no current consumer).
#
# Internally allocates the pollfd struct with the correct per-platform
# layout (8 bytes / fd: i32 on POSIX, 16 bytes / fd: SOCKET=i64 on
# Windows) and dispatches to poll() / WSAPoll() respectively.

@cfg(not: os: "windows")
def socket_wait_one(fd: Int, events: Int, timeout_ms: Int): Int
  var pfd = pollfd_new(fd, events)
  var rc = poll(pfd, 1, timeout_ms)
  qz_free(pfd)
  if rc < 0
    return -1
  end
  if rc == 0
    return 0
  end
  return 1
end

@cfg(os: "windows")
def socket_wait_one(fd: Int, events: Int, timeout_ms: Int): Int
  # Build a WSAPOLLFD: fd (SOCKET, 8 bytes) at 0, events (i16) at 8,
  # revents (i16) at 10, pad to 16.
  var pfd = mem_alloc(WSAPOLLFD_SIZE())
  # Zero the whole struct first to set revents+pad to 0 cleanly.
  var i = 0
  while i < WSAPOLLFD_SIZE()
    ptr_write_byte(ptr_add(pfd, i), 0)
    i = i + 1
  end
  # Write SOCKET fd (i64, little-endian, 8 bytes at offset 0).
  ptr_write_byte(pfd, band(fd, 255))
  ptr_write_byte(ptr_add(pfd, 1), band(shr(fd, 8), 255))
  ptr_write_byte(ptr_add(pfd, 2), band(shr(fd, 16), 255))
  ptr_write_byte(ptr_add(pfd, 3), band(shr(fd, 24), 255))
  ptr_write_byte(ptr_add(pfd, 4), band(shr(fd, 32), 255))
  ptr_write_byte(ptr_add(pfd, 5), band(shr(fd, 40), 255))
  ptr_write_byte(ptr_add(pfd, 6), band(shr(fd, 48), 255))
  ptr_write_byte(ptr_add(pfd, 7), band(shr(fd, 56), 255))
  # Write events (i16, little-endian, 2 bytes at offset 8).
  ptr_write_byte(ptr_add(pfd, 8), band(events, 255))
  ptr_write_byte(ptr_add(pfd, 9), band(shr(events, 8), 255))
  var rc = WSAPoll(pfd, 1, timeout_ms)
  qz_free(pfd)
  if rc < 0
    return -1
  end
  if rc == 0
    return 0
  end
  return 1
end

# ---- Windows-only internals -------------------------------------------------
#
# The WSAStartup guard. A module-level Int held in a 1-cell scratch buffer
# allocated on first read (lazy) — we can't use a top-level mutable global
# on Windows without disturbing the existing global IR layout. The address
# is stable across the process lifetime; the read/write are word-aligned
# 4-byte ops. Concurrent first-callers may race; WSAStartup is idempotent
# and the worst case is two WSAStartup calls (and two matching WSACleanup
# would be needed — but Quartz programs typically never call WSACleanup,
# letting process exit reclaim the refcount).
#
# (A future improvement: an atomic CAS on the flag — currently the race
# window is the two reads + one write between sock_init_once entries. For
# pre-scheduler-spawn init this is single-threaded; for post-spawn init
# the cost is "extra WSAStartup" which is harmless.)

@cfg(os: "windows")
def __wsa_initialized_slot(): Int
  # One static 4-byte slot, allocated lazily via a function-static pattern.
  # `static_int_slot()` is not a Quartz intrinsic — we approximate with a
  # function-scoped var that holds the malloc'd pointer across calls via
  # a top-level zero-init global. The simplest portable substrate is a
  # 4-byte buffer leaked at first use.
  var p = __wsa_slot_ptr()
  return p
end

@cfg(os: "windows")
def __wsa_initialized_flag(): Int
  var p = __wsa_initialized_slot()
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var b2 = ptr_read_byte(ptr_add(p, 2))
  var b3 = ptr_read_byte(ptr_add(p, 3))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

@cfg(os: "windows")
def __wsa_set_initialized(): Void
  var p = __wsa_initialized_slot()
  ptr_write_byte(p, 1)
  ptr_write_byte(ptr_add(p, 1), 0)
  ptr_write_byte(ptr_add(p, 2), 0)
  ptr_write_byte(ptr_add(p, 3), 0)
end

# Module-level scratch slot. Initialized to a malloc'd 4-byte zero buffer
# on first read. The pointer is held in a top-level mutable variable. The
# global is allocated on all platforms (8 bytes of BSS, harmless on POSIX
# where it's never read) because top-level `var` does not accept @cfg.
var __wsa_slot = 0

@cfg(os: "windows")
def __wsa_slot_ptr(): Int
  if __wsa_slot == 0
    var p = mem_alloc(4)
    ptr_write_byte(p, 0)
    ptr_write_byte(ptr_add(p, 1), 0)
    ptr_write_byte(ptr_add(p, 2), 0)
    ptr_write_byte(ptr_add(p, 3), 0)
    __wsa_slot = p
  end
  return __wsa_slot
end

# =============================================================================
# Freestanding stubs (os: "unknown") — D.11 Phase 8a step 1
# =============================================================================
#
# When std/net/tcp.qz is typechecked against a freestanding target
# (e.g., `--target x86_64-unknown-none-elf` for the unikernel), the
# POSIX/Windows-gated definitions above are absent and tcp.qz fails to
# typecheck on the constants and helpers its fn bodies reference
# (SOL_SOCKET, SO_REUSEADDR, SO_RCVTIMEO, SO_SNDTIMEO, EINPROGRESS,
# EWOULDBLOCK, EAGAIN, socket_last_error).
#
# These stubs let tcp.qz typecheck for freestanding. They return -1
# sentinel values that won't accidentally match a real errno or sockopt
# constant. They're intentionally unusable at runtime in freestanding —
# the @cfg-branched tcp.qz fn bodies (Phase 8a step 2+) replace the
# whole call path with kernel-equivalent code that never reaches a
# POSIX setsockopt / sockopt-constant comparison.
#
# This block is the typecheck-only floor for D.11 Phase 8a step 1
# (B.6 merged in). See docs/design/D11_HTTP_SERVER_MIGRATION.md
# Phase 8a for the per-step plan.

@cfg(os: "unknown")
def SOL_SOCKET(): Int = -1

@cfg(os: "unknown")
def SO_REUSEADDR(): Int = -1

@cfg(os: "unknown")
def SO_RCVTIMEO(): Int = -1

@cfg(os: "unknown")
def SO_SNDTIMEO(): Int = -1

@cfg(os: "unknown")
def EINPROGRESS(): Int = -1

@cfg(os: "unknown")
def EWOULDBLOCK(): Int = -1

@cfg(os: "unknown")
def EAGAIN(): Int = -1

@cfg(os: "unknown")
def socket_last_error(): Int = -1
