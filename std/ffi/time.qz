# std/ffi/time.be - POSIX time functions
#
# Generated by tools/gen_ffi.rb from time.h
# Manual edits: Added documentation, cleaner parameter names
#
# Usage:
#   import std/ffi/time
#   fn main() {
#     now = time(nil)
#     print(now)
#   }
#
# Regenerate with:
#   ruby tools/gen_ffi.rb /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/time.h \
#     --functions time,localtime,gmtime,mktime,strftime,difftime,clock --structs tm

# =============================================================================
# Structs
# =============================================================================

# tm - Broken-down time structure
# Fields represent calendar time broken into components
@repr(C)
struct Tm
  tm_sec: CInt     # Seconds (0-60, 60 for leap seconds)
  tm_min: CInt     # Minutes (0-59)
  tm_hour: CInt    # Hours (0-23)
  tm_mday: CInt    # Day of month (1-31)
  tm_mon: CInt     # Month (0-11, January = 0)
  tm_year: CInt    # Years since 1900
  tm_wday: CInt    # Day of week (0-6, Sunday = 0)
  tm_yday: CInt    # Day of year (0-365)
  tm_isdst: CInt   # Daylight saving time flag
  tm_gmtoff: Int   # Seconds east of UTC (macOS extension)
  tm_zone: CPtr    # Timezone abbreviation (macOS extension)
end

# =============================================================================
# Functions
# =============================================================================

# time - Get current calendar time
# Returns: Seconds since Unix epoch (1970-01-01 00:00:00 UTC)
# If tloc is not nil, also stores the result at *tloc
extern "C" def time(tloc: CPtr): Int

# clock - Get processor time used
# Returns: Processor time in CLOCKS_PER_SEC units (usually 1000000)
# Use difftime or divide by CLOCKS_PER_SEC to get seconds
extern "C" def clock(): Int

# difftime - Compute difference between times
# Returns: time1 - time0 in seconds as a double
extern "C" def difftime(time1: Int, time0: Int): CDouble

# localtime - Convert time_t to local time Tm
# Returns: Pointer to static Tm struct (not thread-safe!)
# The returned pointer is overwritten by subsequent calls
extern "C" def localtime(timep: CPtr): CPtr

# gmtime - Convert time_t to UTC time Tm
# Returns: Pointer to static Tm struct (not thread-safe!)
# The returned pointer is overwritten by subsequent calls
extern "C" def gmtime(timep: CPtr): CPtr

# mktime - Convert Tm to time_t
# Also normalizes the Tm fields (e.g., tm_mday=32 becomes next month)
# Returns: Seconds since epoch, or -1 on error
extern "C" def mktime(tm: CPtr): Int

# strftime - Format time as string
# Writes formatted time to buf (max maxsize bytes) using format string
# Returns: Number of bytes written (excluding null), or 0 if buffer too small
#
# Common format specifiers:
#   %Y - Year (4 digits)    %m - Month (01-12)    %d - Day (01-31)
#   %H - Hour (00-23)       %M - Minute (00-59)   %S - Second (00-60)
#   %F - ISO date (YYYY-MM-DD)  %T - ISO time (HH:MM:SS)
extern "C" def strftime(buf: CPtr, maxsize: CSize, format: CPtr, tm: CPtr): CSize

# gettimeofday - Get time with microsecond precision
# Fills timeval struct: { tv_sec: i64, tv_usec: i64 } (on 64-bit systems)
# Returns: 0 on success, -1 on error
extern "C" def gettimeofday(tv: CPtr, tz: CPtr): CInt
