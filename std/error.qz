# Error Types — Standard error infrastructure for Quartz
#
# Provides the Error trait and concrete error types for use across
# the standard library. All error types implement the Error trait
# with `message()` and `kind()` methods.
#
# Error kinds are strings (not enums) for cross-module extensibility.
#
# Example:
#   import error
#   var e = simple_error("something went wrong")
#   puts(e.message())  # "something went wrong"
#   puts(e.kind())     # "Error"

# ============================================================================
# Error Trait
# ============================================================================

trait Error
  def message(self): String
    return "<unknown error>"
  end
  def kind(self): String
    return "Error"
  end
end

# ============================================================================
# SimpleError — General-purpose error
# ============================================================================

struct SimpleError
  _message: String
end

def simple_error(msg: String): SimpleError
  return SimpleError { _message: msg }
end

extend SimpleError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "Error"
  end
end


# ============================================================================
# IoError — File, network, and stream errors
# ============================================================================

struct IoError
  _message: String
  _path: String
  _code: Int
end

def io_error(msg: String, path: String): IoError
  return IoError { _message: msg, _path: path, _code: 0 }
end

def io_error_with_code(msg: String, path: String, code: Int): IoError
  return IoError { _message: msg, _path: path, _code: code }
end

extend IoError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "IoError"
  end
end

extend IoError
  def path(): String
    return @_path
  end
  def code(): Int
    return @_code
  end
end

# ============================================================================
# ParseError — JSON, TOML, CSV parsing errors
# ============================================================================

struct ParseError
  _message: String
  _line: Int
  _column: Int
  _source: String
end

def parse_error(msg: String, line: Int, col: Int): ParseError
  return ParseError { _message: msg, _line: line, _column: col, _source: "" }
end

def parse_error_with_source(msg: String, line: Int, col: Int, source: String): ParseError
  return ParseError { _message: msg, _line: line, _column: col, _source: source }
end

extend ParseError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "ParseError"
  end
end

extend ParseError
  def line(): Int
    return @_line
  end
  def column(): Int
    return @_column
  end
  def source(): String
    return @_source
  end
end

# ============================================================================
# ValueError — Type mismatches, invalid arguments
# ============================================================================

struct ValueError
  _message: String
  _expected: String
  _got: String
end

def value_error(msg: String, expected: String, got: String): ValueError
  return ValueError { _message: msg, _expected: expected, _got: got }
end

extend ValueError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "ValueError"
  end
end

extend ValueError
  def expected(): String
    return @_expected
  end
  def got(): String
    return @_got
  end
end

# ============================================================================
# FormatError — Serialization failures
# ============================================================================

struct FormatError
  _message: String
  _format: String
end

def format_error(msg: String, fmt: String): FormatError
  return FormatError { _message: msg, _format: fmt }
end

extend FormatError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "FormatError"
  end
end

extend FormatError
  def format(): String
    return @_format
  end
end

# ============================================================================
# WrappedError — Error chaining (stores cause as strings)
# ============================================================================

struct WrappedError
  _message: String
  _cause_message: String
  _cause_kind: String
end

def wrap_error(msg: String, cause_message: String, cause_kind: String): WrappedError
  return WrappedError { _message: msg, _cause_message: cause_message, _cause_kind: cause_kind }
end

extend WrappedError with Error
  def message(self): String
    return @_message
  end
  def kind(self): String
    return "WrappedError"
  end
end

extend WrappedError
  def cause_message(): String
    return @_cause_message
  end
  def cause_kind(): String
    return @_cause_kind
  end
end
