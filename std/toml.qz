##! TOML Parser for Be
##!
##! A pure Be implementation of TOML parsing for package manifests.
##!
##! ## Quick Start
##!
##! ```be
##! import std/toml
##!
##! result = toml_parse("[package]\\nname = \\"my-app\\"")
##! match result
##!   TomlResult::Ok(doc) =>
##!     name = toml_get_string(doc, "package.name")
##!     puts("Package: " + name)
##!   TomlResult::Err(err) =>
##!     puts("Error: " + err.message)
##! end
##! ```
##!
##! @since 6.0.0

import * from toml/value
import * from toml/lexer
import * from toml/parser
import * from toml/stringify
import * from error
