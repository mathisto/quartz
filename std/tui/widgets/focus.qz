## std/tui/widgets/focus.qz — FocusRing<Id> for parent-managed focus.
##
## A FocusRing owns the focus cycle for a parent's children. The parent
## constructs one with the list of focusable child ids, asks
## `focus_ring_current(ring)` at dispatch time to decide who gets keys,
## and rotates with `focus_ring_next` / `focus_ring_prev` (typically
## bound to Tab / Shift-Tab in the parent's update).
##
## `Id` is whatever enum the parent uses to label its children — one
## variant per focusable widget. Id is bounded by `Eq` so the ring can
## resolve user-supplied ids against its stored Vec via `==`. Unit-
## variant enums get this for free; richer Id types (struct variants)
## need an explicit `extend Foo with Eq` impl.
##
## The ring is a thin wrapper around `Vec<Id>` + a current-index
## `Option<Int>`. Pure value semantics — every transition returns a new
## FocusRing; the input is unchanged. No internal mutation.
##
## Inspired by Brick's Focus.FocusRing, adapted to Quartz's enum + bounded-
## generic idiom. Brick is the cleanest focus story in any TUI library;
## this is a port, not a re-invention.
##
## Usage:
##
##   import std/tui/widgets/focus as fr
##
##   enum SaveFocus
##     NameInput
##     SaveList
##   end
##
##   extend SaveFocus with Eq
##     def op_eq(self, other: Self): Bool
##       match self
##         NameInput => return other is NameInput
##         SaveList  => return other is SaveList
##       end
##     end
##   end
##
##   var ids = vec_new<SaveFocus>()
##   ids.push(SaveFocus::NameInput)
##   ids.push(SaveFocus::SaveList)
##   var ring = fr::focus_ring_with_initial(ids, SaveFocus::NameInput)
##
##   match fr::focus_ring_current(ring)
##     Some(SaveFocus::NameInput) => # forward keys to name input
##     Some(SaveFocus::SaveList)  => # forward keys to save list
##     None => # no widget focused (empty ring)
##   end
##
## @since 5.28.x

import * from std/traits

## A FocusRing tracks which of `ids` is currently focused. `current`
## is the index into `ids`, or None for "no widget focused" (empty
## ring, or after `focus_ring_clear`).
struct FocusRing<Id: Eq>
  ids:     Vec<Id>
  current: Option<Int>
end

## Construct a FocusRing from a list of ids. If the list is non-empty,
## the first id is initially focused; otherwise `current` is None.
def focus_ring_new<Id: Eq>(ids: Vec<Id>): FocusRing<Id>
  var initial = Option::None
  if ids.size > 0
    initial = Option::Some(0)
  end
  return FocusRing { ids: ids, current: initial }
end

## Construct a FocusRing with `initial` focused. If `initial` is not
## present in `ids`, focus defaults to None — caller is responsible
## for ensuring the initial id exists in the ring.
def focus_ring_with_initial<Id: Eq>(ids: Vec<Id>, initial: Id): FocusRing<Id>
  return FocusRing { ids: ids, current: _focus_ring_index_of(ids, initial) }
end

## Return the currently-focused id, or None.
def focus_ring_current<Id: Eq>(r: FocusRing<Id>): Option<Id>
  match r.current
    Some(idx) => return Option::Some(r.ids[idx])
    None      => return Option::None
  end
end

## Rotate focus to the next id in the ring. Wraps from the last id back
## to the first. If the ring is empty, returns the input unchanged.
## If `current` is None on a non-empty ring, focuses the first id.
def focus_ring_next<Id: Eq>(r: FocusRing<Id>): FocusRing<Id>
  if r.ids.size == 0
    return r
  end
  var next_idx = 0
  match r.current
    Some(idx) => next_idx = (idx + 1) % r.ids.size
    None      => next_idx = 0
  end
  return FocusRing { ids: r.ids, current: Option::Some(next_idx) }
end

## Rotate focus to the previous id in the ring. Wraps from the first id
## back to the last. If the ring is empty, returns the input unchanged.
## If `current` is None on a non-empty ring, focuses the first id
## (matching `focus_ring_next`'s convention).
def focus_ring_prev<Id: Eq>(r: FocusRing<Id>): FocusRing<Id>
  if r.ids.size == 0
    return r
  end
  var prev_idx = 0
  match r.current
    Some(idx) =>
      if idx == 0
        prev_idx = r.ids.size - 1
      else
        prev_idx = idx - 1
      end
    None => prev_idx = 0
  end
  return FocusRing { ids: r.ids, current: Option::Some(prev_idx) }
end

## Set focus to a specific id. If `id` is not present in the ring,
## returns the input unchanged (caller must ensure id is valid).
def focus_ring_set<Id: Eq>(r: FocusRing<Id>, id: Id): FocusRing<Id>
  var idx = _focus_ring_index_of(r.ids, id)
  if idx is None
    return r
  end
  return FocusRing { ids: r.ids, current: idx }
end

## Clear focus — `current` becomes None. Useful for "no widget focused"
## states (e.g. modal dialog dismissed, screen showing only static info).
def focus_ring_clear<Id: Eq>(r: FocusRing<Id>): FocusRing<Id>
  return FocusRing { ids: r.ids, current: Option::None }
end

## Test whether a given id is currently focused. Convenience for the
## common render-time check (`text_input_view(t, fr::focus_ring_is_focused(ring, MyId::Input))`).
def focus_ring_is_focused<Id: Eq>(r: FocusRing<Id>, id: Id): Bool
  match r.current
    Some(idx) => return r.ids[idx] == id
    None      => return false
  end
end

## Number of ids in the ring.
def focus_ring_size<Id: Eq>(r: FocusRing<Id>): Int = r.ids.size

# ============================================================
# Internal helpers
# ============================================================

# Linear search for `target` in `ids`, returning Option<Int>. Used by
# `with_initial` and `set`. Linear is fine — focus rings have <10 ids
# in any realistic UI.
def _focus_ring_index_of<Id: Eq>(ids: Vec<Id>, target: Id): Option<Int>
  var i = 0
  while i < ids.size
    if ids[i] == target
      return Option::Some(i)
    end
    i = i + 1
  end
  return Option::None
end
