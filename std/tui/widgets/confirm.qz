## std/tui/widgets/confirm.qz — interactive Yes/No dialog.
##
## A two-button confirmation widget. Pairs naturally with `Overlay`
## via `confirm_overlay(c)` which returns a centred bordered modal
## ready to compose over a base view.
##
## Keys handled by `confirm_update`:
##   - ←  /  h  → select Yes (left button)
##   - →  /  l  → select No  (right button)
##   - Y / y    → select Yes AND emit Confirmed
##   - N / n    → select No AND emit Cancelled
##   - Enter    → emit Confirmed if Yes selected, Cancelled otherwise
##   - Esc      → emit Cancelled regardless of selection
##
## Arrow direction matches visual button order — `[ Yes ]    [ No ]`
## renders Yes on the left, so Left arrow lands on Yes and Right
## lands on No.
##
## The widget itself doesn't track "is open?" state — the parent
## holds an `Option<Confirm>` and clears it on receiving Confirmed
## or Cancelled. Same value-object discipline as Overlay.
##
## Visual: both buttons are rendered with their respective styles —
## the selected button uses `styles.button_selected` (default inverse
## video + bold), the unselected button uses `styles.button` (default
## plain).
##
## @since 5.28.x

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/overlay as ov
import style

# ============================================================
# Public types
# ============================================================

## Semantic events emitted by `confirm_update`.
##
## - Idle:      no decision yet (selection toggle, unhandled key).
## - Confirmed: user committed Yes.
## - Cancelled: user committed No (or pressed Esc).
enum ConfirmEvent
  Idle
  Confirmed
  Cancelled
end

## Per-slot Style values.
##
## - prompt:          colours the prompt text.
## - button:          colours the unselected button. Default plain.
## - button_selected: colours the highlighted button. Default inverse
##                    video so it's visually distinct without colour.
struct ConfirmStyles
  prompt:          Style
  button:          Style
  button_selected: Style
end

## Default styles. Prompt is plain; button is plain (and reserved);
## selected button uses inverse video — works on every terminal that
## supports any styling at all.
def confirm_styles_default(): ConfirmStyles
  return ConfirmStyles {
    prompt:          Style.new(),
    button:          Style.new(),
    button_selected: Style.new().inverse().bold()
  }
end

## Confirm widget value object.
##
## `selected` tracks which button is highlighted: `true` = Yes,
## `false` = No. Default is `true` (Yes) — the common "press Enter
## to accept" idiom. Apps where the safe answer is No (destructive
## operations) should construct with `confirm_with_default(c, false)`.
struct Confirm
  prompt:    String
  yes_label: String
  no_label:  String
  selected:  Bool
  styles:    ConfirmStyles
end

# ============================================================
# Constructors + builders
# ============================================================

## Build a Confirm with default labels ("Yes" / "No"), Yes selected.
def confirm_new(prompt: String): Confirm
  return Confirm {
    prompt:    prompt,
    yes_label: "Yes",
    no_label:  "No",
    selected:  true,
    styles:    confirm_styles_default()
  }
end

## Replace the button labels.
def confirm_with_labels(c: Confirm, yes: String, no: String): Confirm
  return Confirm {
    prompt:    c.prompt,
    yes_label: yes,
    no_label:  no,
    selected:  c.selected,
    styles:    c.styles
  }
end

## Set the initial selection. `default_yes = false` is the right call
## when the destructive answer is Yes ("delete?" / "quit?") and we
## want the user to deliberately move to it rather than mash Enter.
def confirm_with_default(c: Confirm, default_yes: Bool): Confirm
  return Confirm {
    prompt:    c.prompt,
    yes_label: c.yes_label,
    no_label:  c.no_label,
    selected:  default_yes,
    styles:    c.styles
  }
end

## Replace styles wholesale.
def confirm_with_styles(c: Confirm, s: ConfirmStyles): Confirm
  return Confirm {
    prompt:    c.prompt,
    yes_label: c.yes_label,
    no_label:  c.no_label,
    selected:  c.selected,
    styles:    s
  }
end

# ============================================================
# Update
# ============================================================

## Pure update — pattern-matches FrameMsg::Key, applies the key
## semantics, and returns the next state alongside Cmd::None and a
## ConfirmEvent describing the decision (or Idle).
##
## Non-Key messages are no-ops.
def confirm_update<M>(
  c: Confirm,
  msg: tui::FrameMsg<M>
): (Confirm, tui::Cmd<M>, ConfirmEvent)
  match msg
    tui::FrameMsg::Key(k) => return _confirm_handle_key<M>(c, k.code)
    _ => return (c, tui::Cmd::None, ConfirmEvent::Idle)
  end
end

# ============================================================
# View
# ============================================================

## Render the confirm body — prompt above a button row, with one
## blank line of vertical padding above and below each. Suitable
## input for `border_with` or for direct composition.
def confirm_view(c: Confirm): String
  var s_prompt:  Style = c.styles.prompt
  var s_btn:     Style = c.styles.button
  var s_btn_sel: Style = c.styles.button_selected

  var lines = vec_new<String>()
  lines.push("")
  lines.push("  " + s_prompt.render(c.prompt) + "  ")
  lines.push("")
  lines.push(_confirm_button_row(c, s_btn, s_btn_sel))
  lines.push("")
  return ly::join_vertical(lines)
end

## Wrap the rendered body in a centred rounded-border Overlay,
## ready to compose over a base view via `ov::overlay_compose`.
def confirm_overlay(c: Confirm): ov::Overlay
  return ov::overlay_new(confirm_view(c), ov::POS_CENTER(), ly::BORDER_ROUNDED())
end

# ============================================================
# Internal — key dispatch
# ============================================================

# 'h' / 'l' / 'y' / 'n' / 'Y' / 'N' as plain ASCII codepoints. Kept
# inline rather than as KEY_* constants since std/terminal only
# defines sentinels for non-printable keys.

def _confirm_handle_key<M>(
  c: Confirm,
  code: Int
): (Confirm, tui::Cmd<M>, ConfirmEvent)
  # Hard cancel — Esc emits Cancelled regardless of selection.
  if code == 27
    return (c, tui::Cmd::None, ConfirmEvent::Cancelled)
  end

  # Y / y hotkey — select Yes AND commit.
  if code == 'Y' or code == 'y'
    var c2 = _confirm_set_selected(c, true)
    return (c2, tui::Cmd::None, ConfirmEvent::Confirmed)
  end

  # N / n hotkey — select No AND commit.
  if code == 'N' or code == 'n'
    var c2 = _confirm_set_selected(c, false)
    return (c2, tui::Cmd::None, ConfirmEvent::Cancelled)
  end

  # Enter commits whatever's currently selected.
  if code == terminal::KEY_ENTER()
    if c.selected
      return (c, tui::Cmd::None, ConfirmEvent::Confirmed)
    end
    return (c, tui::Cmd::None, ConfirmEvent::Cancelled)
  end

  # Left / h → Yes (left button in `[ Yes ]    [ No ]` row).
  if code == terminal::KEY_LEFT() or code == 'h'
    return (_confirm_set_selected(c, true), tui::Cmd::None, ConfirmEvent::Idle)
  end

  # Right / l → No (right button).
  if code == terminal::KEY_RIGHT() or code == 'l'
    return (_confirm_set_selected(c, false), tui::Cmd::None, ConfirmEvent::Idle)
  end

  # Anything else: no-op.
  return (c, tui::Cmd::None, ConfirmEvent::Idle)
end

def _confirm_set_selected(c: Confirm, sel: Bool): Confirm
  return Confirm {
    prompt:    c.prompt,
    yes_label: c.yes_label,
    no_label:  c.no_label,
    selected:  sel,
    styles:    c.styles
  }
end

# Render the button row. The selected button uses sel_style; the
# unselected button uses btn_style.
def _confirm_button_row(c: Confirm, btn_style: Style, sel_style: Style): String
  var yes_btn = "[ " + c.yes_label + " ]"
  var no_btn  = "[ " + c.no_label  + " ]"
  if c.selected
    return "  " + sel_style.render(yes_btn) + "    " + btn_style.render(no_btn) + "  "
  end
  return "  " + btn_style.render(yes_btn) + "    " + sel_style.render(no_btn) + "  "
end
