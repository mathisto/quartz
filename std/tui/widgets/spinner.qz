## std/tui/widgets/spinner.qz — animated spinner glyph for background
## task feedback.
##
## Cmd::Run handlers spawn off-thread work; while it's in flight the
## view wants a visible cue that something is happening. The Spinner
## holds a frame cycle (e.g. octant rotor, dotted ellipsis, ASCII
## line) plus a current index; the parent advances the index on a
## tick by calling `spinner_tick(s)`. View renders one frame char
## followed optionally by a label.
##
## Display-only — no key handling, no events. The frame index lives in
## the Spinner; visibility (whether to render at all) is parent state.
##
## Render path: at most TWO styled regions (frame + label) separated by
## a literal space. The literal sits between the two `Style.X.render`
## results so they're never directly concatenated — sidesteps
## STYLE_RENDER_CONCAT_CORRUPTION (docs/bugs/STYLE_RENDER_CONCAT_CORRUPTION.md).
##
## Usage:
##
##   import std/tui/widgets/spinner as sp
##
##   # In init:
##   sp::spinner_new("Loading…")
##
##   # On tick:
##   spinner = sp::spinner_tick(spinner)
##
##   # In view:
##   return sp::spinner_view(spinner)
##
## @since 5.28.x

import style
import std/tui/octant as oc

# ============================================================
# Frame cycles
# ============================================================

## ASCII dotted-ellipsis 6-frame cycle. Different aesthetic from the
## rotational spinners — reads as "loading…" rather than "spinning".
def spinner_dots(): Vec<String>
  var frames = vec_new<String>()
  frames.push("   ")
  frames.push(".  ")
  frames.push(".. ")
  frames.push("...")
  frames.push(" ..")
  frames.push("  .")
  return frames
end

## Classic 4-frame line spinner. ASCII, low-fidelity rotation.
def spinner_line(): Vec<String>
  var frames = vec_new<String>()
  frames.push("|")
  frames.push("/")
  frames.push("-")
  frames.push("\\")
  return frames
end

# ============================================================
# Octant frame cycles — sub-cell-precision animations
# ============================================================
#
# Octant glyphs (U+1CD00..U+1CDE5 + reused codepoints, full Unicode
# 17 table) split a monospace cell into 2 columns × 4 rows of binary
# sub-pixels. Each frame is one 8-bit pattern; std/tui/octant.qz
# resolves it to the corresponding glyph.
#
# Pattern bit layout (matches octant.qz convention):
#   bit 0 = (col 0, row 0) — top-left
#   bit 1 = (col 1, row 0) — top-right
#   bit 2 = (col 0, row 1)
#   bit 3 = (col 1, row 1)
#   bit 4 = (col 0, row 2)
#   bit 5 = (col 1, row 2)
#   bit 6 = (col 0, row 3) — bottom-left
#   bit 7 = (col 1, row 3) — bottom-right

## Render an 8-bit octant pattern as a single-cell glyph.
def _octant_glyph(pat: Int): String
  return oc::codepoint_to_utf8(oc::octant_codepoint(pat))
end

## Sub-cell rotor — 8 frames, one sub-pixel rotating clockwise
## around the cell perimeter. Visually a tiny dot sweeping a tight
## circle. The default frame cycle for `spinner_new` — Unicode 17
## octant glyphs give the smoothest rotational animation a monospace
## cell can carry.
def spinner_octant_rotor(): Vec<String>
  var frames = vec_new<String>()
  frames.push(_octant_glyph(0x01))  # top-left
  frames.push(_octant_glyph(0x02))  # top-right
  frames.push(_octant_glyph(0x08))  # row 1, right
  frames.push(_octant_glyph(0x20))  # row 2, right
  frames.push(_octant_glyph(0x80))  # bottom-right
  frames.push(_octant_glyph(0x40))  # bottom-left
  frames.push(_octant_glyph(0x10))  # row 2, left
  frames.push(_octant_glyph(0x04))  # row 1, left
  return frames
end

## Pulse — 4 frames, ping-pong expand/contract. Visually the cell
## "breathes": empty → middle 2 rows → full → middle 2 rows. Useful
## for "thinking" or "in flight" cues where rotational direction
## isn't the right metaphor.
def spinner_octant_pulse(): Vec<String>
  var frames = vec_new<String>()
  frames.push(_octant_glyph(0x00))  # empty
  frames.push(_octant_glyph(0x3C))  # middle 2 rows (rows 1+2, both cols)
  frames.push(_octant_glyph(0xFF))  # full block
  frames.push(_octant_glyph(0x3C))  # middle 2 rows (return path)
  return frames
end

## Scan — 4 frames, horizontal scan line sweeping top-to-bottom.
## Each frame is a single row of 2 sub-pixels. Reads as a "loading
## bar" that scrolls vertically. Pairs well with progress bars
## animating horizontally — the two motions are orthogonal so they
## don't compete visually.
def spinner_octant_scan(): Vec<String>
  var frames = vec_new<String>()
  frames.push(_octant_glyph(0x03))  # row 0
  frames.push(_octant_glyph(0x0C))  # row 1
  frames.push(_octant_glyph(0x30))  # row 2
  frames.push(_octant_glyph(0xC0))  # row 3
  return frames
end

# ============================================================
# Styles
# ============================================================

## Per-slot Style values. Default frame is plain; default label is
## muted so the animation stands out against the static text.
struct SpinnerStyles
  frame: Style
  label: Style
end

def spinner_styles_default(): SpinnerStyles
  return SpinnerStyles {
    frame: Style.new(),
    label: Style.muted()
  }
end

# ============================================================
# Spinner value
# ============================================================

## Spinner widget value. Immutable — every mutator returns a new
## struct.
struct Spinner
  frames: Vec<String>
  index:  Int
  label:  String
  styles: SpinnerStyles
end

# ============================================================
# Constructors + builders
# ============================================================

## Build a new Spinner with the default octant-rotor frames and the
## supplied label. Pass `""` for no label.
def spinner_new(label: String): Spinner
  return Spinner {
    frames: spinner_octant_rotor(),
    index:  0,
    label:  label,
    styles: spinner_styles_default()
  }
end

## Replace the frame cycle. Resets the index to 0 — switching frame
## sets mid-animation otherwise leaves a half-finished cycle visible
## for one tick.
def spinner_with_frames(s: Spinner, frames: Vec<String>): Spinner
  return Spinner {
    frames: frames, index: 0, label: s.label, styles: s.styles
  }
end

## Replace the styles wholesale.
def spinner_with_styles(s: Spinner, styles: SpinnerStyles): Spinner
  return Spinner {
    frames: s.frames, index: s.index, label: s.label, styles: styles
  }
end

## Replace the label.
def spinner_with_label(s: Spinner, label: String): Spinner
  return Spinner {
    frames: s.frames, index: s.index, label: label, styles: s.styles
  }
end

# ============================================================
# Frame advance
# ============================================================

## Advance to the next frame, wrapping from the last back to 0.
## Empty frame cycles return the spinner unchanged.
def spinner_tick(s: Spinner): Spinner
  if s.frames.size == 0
    return s
  end
  var next = s.index + 1
  if next >= s.frames.size
    next = 0
  end
  return Spinner {
    frames: s.frames, index: next, label: s.label, styles: s.styles
  }
end

# ============================================================
# View
# ============================================================

## Render the spinner. With a label: `{frame} {label}`; without:
## `{frame}`. Empty frame cycles render as the bare label (or `""`
## when no label either).
def spinner_view(s: Spinner): String
  var s_frame: Style = s.styles.frame
  var s_label: Style = s.styles.label

  if s.frames.size == 0
    if str_byte_len(s.label) == 0
      return ""
    end
    return s_label.render(s.label)
  end

  var idx = s.index
  if idx < 0 or idx >= s.frames.size
    idx = 0
  end
  var frame_str = s.frames[idx]

  if str_byte_len(s.label) == 0
    return s_frame.render(frame_str)
  end
  return s_frame.render(frame_str) + " " + s_label.render(s.label)
end
