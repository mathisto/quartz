## std/tui/widgets/tabs.qz — horizontal tab strip.
##
## Generic over T — the consumer associates each tab label with a
## payload value, retrievable via `tabs_active_item`. Typical payloads
## are enum tags identifying the screen the tab represents.
##
## The widget owns only the strip; the parent renders the body for the
## active tab. Parents typically compose with `join_vertical([strip,
## body])`.
##
## Keymap:
##   ←, h     previous tab (wraps from 0 → last)
##   →, l     next tab (wraps from last → 0)
##   1..9     jump to tab at index digit-1 (ignored if out of range)
##
## Events:
##   Idle           — no selection change (empty tabs, ignored key,
##                    same-index jump).
##   Activated(idx) — selection changed; idx is the new active index.
##
## Render path uses one Vec<String> of pre-rendered styled segments
## interleaved with a styled vertical-bar separator (` │ ` muted by
## default). Each tab segment and each separator is a single
## Style.render result; `str_join("")` reassembles them with no
## further concatenation.
##
## @since 5.28.x

import std/tui/runtime as tui
import std/terminal
import style

# ============================================================
# Public types
# ============================================================

struct TabItem<T>
  label:   String
  payload: T
end

struct TabsStyles
  active:    Style
  inactive:  Style
  separator: Style
end

enum TabsEvent
  Idle
  Activated(idx: Int)
end

struct Tabs<T>
  items:  Vec<TabItem<T>>
  active: Int
  styles: TabsStyles
end

# ============================================================
# Constructors + builders
# ============================================================

def tab_item<T>(label: String, payload: T): TabItem<T>
  return TabItem { label: label, payload: payload }
end

def tabs_styles_default(): TabsStyles
  return TabsStyles {
    active:    Style.new().bold().inverse(),
    inactive:  Style.new(),
    separator: Style.muted()
  }
end

def tabs_new<T>(items: Vec<TabItem<T>>): Tabs<T>
  return Tabs {
    items:  items,
    active: 0,
    styles: tabs_styles_default()
  }
end

## Set the active index. Out-of-range values clamp to the last valid
## index; on empty items, active stays at 0.
def tabs_with_active<T>(t: Tabs<T>, idx: Int): Tabs<T>
  var n = t.items.size
  var clamped = idx
  if n == 0
    clamped = 0
  else
    if clamped < 0
      clamped = 0
    end
    if clamped >= n
      clamped = n - 1
    end
  end
  return Tabs {
    items: t.items, active: clamped, styles: t.styles
  }
end

def tabs_with_styles<T>(t: Tabs<T>, s: TabsStyles): Tabs<T>
  return Tabs {
    items: t.items, active: t.active, styles: s
  }
end

def tabs_append<T>(t: Tabs<T>, label: String, payload: T): Tabs<T>
  var items: Vec<TabItem<T>> = vec_clone(t.items)
  items.push(tab_item(label, payload))
  return Tabs {
    items: items, active: t.active, styles: t.styles
  }
end

# ============================================================
# Accessors
# ============================================================

## Return the active item. Caller must verify items.size > 0 first.
def tabs_active_item<T>(t: Tabs<T>): TabItem<T>
  var items: Vec<TabItem<T>> = t.items
  return items[t.active]
end

def tabs_active_index<T>(t: Tabs<T>): Int = t.active

# ============================================================
# Update + view
# ============================================================

def tabs_update<T, M>(
  t: Tabs<T>,
  msg: tui::FrameMsg<M>
): (Tabs<T>, tui::Cmd<M>, TabsEvent)
  match msg
    tui::FrameMsg::Key(k) => return _tabs_handle_key(t, k.code)
    _ => return (t, tui::Cmd::None, TabsEvent::Idle)
  end
end

def tabs_view<T>(t: Tabs<T>): String
  var items: Vec<TabItem<T>> = t.items
  if items.size == 0
    return ""
  end
  var s_active:    Style = t.styles.active
  var s_inactive:  Style = t.styles.inactive
  var s_separator: Style = t.styles.separator

  var out = vec_new<String>()
  var i = 0
  while i < items.size
    if i > 0
      out.push(s_separator.render(" │ "))
    end
    var segment = "[ " + _tabs_item_label(items, i) + " ]"
    if i == t.active
      out.push(s_active.render(segment))
    else
      out.push(s_inactive.render(segment))
    end
    i = i + 1
  end
  return str_join(out, "")
end

# Pull out a tab's label inside a generic-typed function — chained
# field access on a generic-erased Vec element trips QZ0301 ("Unknown
# struct: Struct") at typecheck. Pulling the access into a function
# whose parameter type is the concrete `Vec<TabItem<T>>` keeps the
# element type visible. See feedback_chained_field_access_generic_erases.md.
def _tabs_item_label<T>(items: Vec<TabItem<T>>, i: Int): String
  var item: TabItem<T> = items[i]
  return item.label
end

# ============================================================
# Internal — key dispatch
# ============================================================

def _tabs_handle_key<T, M>(
  t: Tabs<T>,
  code: Int
): (Tabs<T>, tui::Cmd<M>, TabsEvent)
  var n = t.items.size
  if n == 0
    return (t, tui::Cmd::None, TabsEvent::Idle)
  end

  if code == terminal::KEY_LEFT() or code == 'h'
    var prev = t.active - 1
    if prev < 0
      prev = n - 1
    end
    return _tabs_set_active(t, prev)
  end
  if code == terminal::KEY_RIGHT() or code == 'l'
    var next = t.active + 1
    if next >= n
      next = 0
    end
    return _tabs_set_active(t, next)
  end
  if code >= '1' and code <= '9'
    var target = code - '1'
    if target < n
      return _tabs_set_active(t, target)
    end
    return (t, tui::Cmd::None, TabsEvent::Idle)
  end
  return (t, tui::Cmd::None, TabsEvent::Idle)
end

# Set active index and emit Activated only when it changed; otherwise
# emit Idle. Used by every key handler so the same-index-jump case
# doesn't fire a redundant event.
def _tabs_set_active<T, M>(
  t: Tabs<T>,
  idx: Int
): (Tabs<T>, tui::Cmd<M>, TabsEvent)
  if idx == t.active
    return (t, tui::Cmd::None, TabsEvent::Idle)
  end
  var updated = Tabs {
    items: t.items, active: idx, styles: t.styles
  }
  return (updated, tui::Cmd::None, TabsEvent::Activated(idx))
end
