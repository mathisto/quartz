## std/tui/widgets/_string_helpers.qz — internal string utilities
## shared across the widget suite. Underscore-prefixed module name
## flags this as not for direct consumer use; the public API surface
## is in the widget modules themselves.
##
## @since 5.28.x

import std/unicode/width

## Compute the visible cell width of a String — sum of per-codepoint
## widths via unicode_width. Wide chars (CJK, emoji) count as 2.
def visible_width(s: String): Int
  var w = 0
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var cp = str_codepoint_at(s, i)
    w = w + width::unicode_width(cp)
    i = i + str_codepoint_byte_len(s, i)
  end
  return w
end

## Clip `s` to at most `max_width` visible cells. Excess content is
## truncated at the codepoint that would tip the running width over
## max — wide chars whose addition would exceed the budget are
## excluded entirely (no half-rendered glyphs).
def clip_to_width(s: String, max_width: Int): String
  var taken_w = 0
  var byte_i = 0
  var len = str_byte_len(s)
  while byte_i < len
    var cp = str_codepoint_at(s, byte_i)
    var cw = width::unicode_width(cp)
    if taken_w + cw > max_width
      break
    end
    taken_w = taken_w + cw
    byte_i = byte_i + str_codepoint_byte_len(s, byte_i)
  end
  return str_byte_slice(s, 0, byte_i)
end

## Soft-wrap `line` to `width` cells, pushing each wrapped segment
## into `out`. Empty input pushes an empty string (preserves blank-
## line layout). Naive cell-boundary break — no word boundary
## awareness; that's a v0.4+ refinement if real consumers want it.
def wrap_line_into(out: Vec<String>, line: String, width: Int): Void
  if line.empty?
    out.push("")
    return
  end
  var taken_w = 0
  var seg_start = 0
  var byte_i = 0
  var len = str_byte_len(line)
  while byte_i < len
    var cp = str_codepoint_at(line, byte_i)
    var cw = width::unicode_width(cp)
    if taken_w + cw > width
      out.push(str_byte_slice(line, seg_start, byte_i))
      seg_start = byte_i
      taken_w = 0
    end
    taken_w = taken_w + cw
    byte_i = byte_i + str_codepoint_byte_len(line, byte_i)
  end
  if seg_start < len
    out.push(str_byte_slice(line, seg_start, len))
  end
end
