## std/tui/widgets/progress.qz — horizontal progress bar widget.
##
## Renders as `[█████▌░░░░] 55/100` (or a styled equivalent). The
## fill region defaults to a semantic gradient — green ≥50%, yellow
## [25%, 50%), red <25% — so HP / energy / loading bars colour-shift
## naturally as their value drops without per-app wiring.
##
## Sub-cell precision: the leading edge of the fill renders through
## eighth-block glyphs (U+258F..U+2588: ▏▎▍▌▋▊▉█), giving 8× the
## resolution of a plain block fill. A 20-cell bar carries 160
## distinct fill positions instead of 20 — the difference between
## "stuttering jumps" and "smooth scroll" at small bar widths.
##
## Display-only: no key handling, no events. Consumers update by
## calling `progress_bar_set(p, current)` and re-rendering.
##
## Auto-gradient is on by default; toggle with
## `progress_bar_with_auto_gradient(p, false)` to use `styles.fill`
## as-is. `progress_bar_with_styles` swaps fill / empty / border
## wholesale and leaves the auto_gradient flag unchanged — apps
## wanting a fixed colour usually call both.
##
## Naming: the struct is `ProgressBar` (not `Progress`) because
## `std/progress.qz` already exports a `Progress` struct (the
## long-running task progress reporter). The two are unrelated; the
## widget keeps a distinct name to avoid struct-namespace collision.
##
## Render path is a four-region composite — border + fill + empty +
## border — each rendered through its own `Style.render` call.
##
## @since 5.28.x

import style
import std/tui/octant as oc

# ============================================================
# Public types
# ============================================================

## Per-slot Style values for rendering.
##
## - fill:   colours the filled cells. When auto_gradient is on
##           (default), this slot is ignored and a semantic colour
##           is computed per render.
## - empty:  colours the unfilled (track) cells.
## - border: colours the surrounding `[ ]` brackets.
struct ProgressBarStyles
  fill:   Style
  empty:  Style
  border: Style
end

## Default styles. Empty track is dim (visually de-emphasised);
## border and fill are plain (the auto_gradient flag on ProgressBar
## supplies fill colour at render time when on).
def progress_bar_styles_default(): ProgressBarStyles
  return ProgressBarStyles {
    fill:   Style.new(),
    empty:  Style.new().dim(),
    border: Style.new()
  }
end

## ProgressBar widget value object. Immutable — every mutator
## returns a new struct.
##
## `current` may be outside `[0, max]` — `progress_bar_view` clamps
## for render purposes but the underlying field stays as-set so
## callers inspecting the value see what they wrote.
##
## When `auto_gradient` is true, the fill colour is computed from
## the current percentage at render time (red <25%, yellow <50%,
## green ≥50%) and `styles.fill` is ignored.
struct ProgressBar
  current:       Int
  max:           Int
  width:         Int                # cells available for the bar (excludes brackets)
  auto_gradient: Bool
  styles:        ProgressBarStyles
end

# ============================================================
# Constructors + builders
# ============================================================

## Build a new ProgressBar with `width` defaulting to 20 cells and
## the auto-gradient on.
def progress_bar_new(current: Int, max: Int): ProgressBar
  return ProgressBar {
    current:       current,
    max:           max,
    width:         20,
    auto_gradient: true,
    styles:        progress_bar_styles_default()
  }
end

## Set the bar width in cells (excludes the surrounding `[ ]`).
## Negative widths clamp to 0 inside `progress_bar_view`.
def progress_bar_with_size(p: ProgressBar, width: Int): ProgressBar
  return ProgressBar {
    current: p.current, max: p.max, width: width,
    auto_gradient: p.auto_gradient, styles: p.styles
  }
end

## Replace the styles wholesale. Leaves auto_gradient unchanged —
## callers wanting `styles.fill` to take effect should follow with
## `progress_bar_with_auto_gradient(p, false)`.
def progress_bar_with_styles(p: ProgressBar, s: ProgressBarStyles): ProgressBar
  return ProgressBar {
    current: p.current, max: p.max, width: p.width,
    auto_gradient: p.auto_gradient, styles: s
  }
end

## Toggle the auto-gradient. When off, `styles.fill` colours the bar.
def progress_bar_with_auto_gradient(p: ProgressBar, on: Bool): ProgressBar
  return ProgressBar {
    current: p.current, max: p.max, width: p.width,
    auto_gradient: on, styles: p.styles
  }
end

## Update the current value. `current` may exceed `max` or go
## negative — `progress_bar_view` clamps at render time.
def progress_bar_set(p: ProgressBar, current: Int): ProgressBar
  return ProgressBar {
    current: current, max: p.max, width: p.width,
    auto_gradient: p.auto_gradient, styles: p.styles
  }
end

# ============================================================
# Accessors
# ============================================================

## Percent in [0, 100], computed from clamped current. Returns 0
## when max <= 0 (degenerate bar — no progress to report).
def progress_bar_percent(p: ProgressBar): Int
  if p.max <= 0
    return 0
  end
  var cur = p.current
  if cur < 0
    cur = 0
  end
  if cur > p.max
    cur = p.max
  end
  return cur * 100 / p.max
end

## Semantic gradient colour for a given percent: red <25%, yellow
## [25%, 50%), green ≥50%. Exposed for testing and consumers that
## want the same colour scheme outside the bar (matching label
## colour, etc).
def progress_bar_gradient_color(percent: Int): Int
  if percent < 25
    return style::Red()
  end
  if percent < 50
    return style::Yellow()
  end
  return style::Green()
end

# ============================================================
# View
# ============================================================

## Eighth-block leading-edge glyph for `eighths` ∈ [1, 7]. Returns ""
## for eighths ≤ 0 (no partial drawn) and "█" for eighths ≥ 8 (full
## cell). Codepoint mapping is U+258F (1/8) … U+2589 (7/8) — note the
## Unicode order is reversed from the visual fill direction, so the
## arithmetic is `0x2590 - eighths`.
def _eighth_block(eighths: Int): String
  if eighths <= 0
    return ""
  end
  if eighths >= 8
    return "█"
  end
  return oc::codepoint_to_utf8(0x2590 - eighths)
end

## Render the bar as `[█████▌░░░░] cur/max` (or styled equivalent).
##
## Sub-cell fill: the leading edge uses eighth-block glyphs
## (U+258F..U+2588) for 8× horizontal resolution. A 20-cell bar
## addresses 160 fill positions; non-aligned ratios get a partial
## glyph instead of snapping to the nearest cell boundary.
##
## Degenerate cases:
##   - max <= 0   → returns `""` (no bar to draw)
##   - width <= 0 → produces `[] cur/max` (brackets + count, no cells)
def progress_bar_view(p: ProgressBar): String
  if p.max <= 0
    return ""
  end

  var width = p.width
  if width < 0
    width = 0
  end

  var cur = p.current
  if cur < 0
    cur = 0
  end
  if cur > p.max
    cur = p.max
  end

  # Compute fill in eighths-of-a-cell. total_eighths ∈ [0, width * 8].
  #   full_cells = total_eighths / 8       (whole cells of █)
  #   partial    = total_eighths % 8       (eighth-block leading edge, 0..7)
  #   track      = width - full_cells - (partial > 0 ? 1 : 0)
  var full_cells = 0
  var partial    = 0
  var track_cells = 0
  if width > 0
    var total_eighths = cur * width * 8 / p.max
    if total_eighths < 0
      total_eighths = 0
    end
    if total_eighths > width * 8
      total_eighths = width * 8
    end
    full_cells = total_eighths / 8
    partial    = total_eighths - full_cells * 8
    track_cells = width - full_cells
    if partial > 0
      track_cells -= 1
    end
    if track_cells < 0
      track_cells = 0
    end
  end

  var fill_str = str_repeat("█", full_cells) + _eighth_block(partial)
  var track_str = str_repeat("░", track_cells)

  # Extract Styles to typed locals before .render — chained method
  # calls on struct-field paths of generic-erased structs trip a
  # Quartz codegen bug (feedback_chained_field_access_generic_erases).
  var s_fill:   Style = p.styles.fill
  var s_empty:  Style = p.styles.empty
  var s_border: Style = p.styles.border

  # Auto-gradient: pick a semantic colour from the percentage. The
  # configured fill style is overridden when this flag is on.
  if p.auto_gradient
    var pct = cur * 100 / p.max
    s_fill = Style.new().fg(progress_bar_gradient_color(pct)).bold()
  end

  return s_border.render("[") + s_fill.render(fill_str) +
         s_empty.render(track_str) + s_border.render("] ") +
         cur.to_s() + "/" + p.max.to_s()
end
