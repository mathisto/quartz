## std/tui/widgets/status_bar.qz — pinned one-row header/footer.
##
## Lays out left/center/right-aligned segments within a fixed width.
## Each segment carries its own Style; the widget renders them in
## place at view time.
##
## Position (POS_TOP / POS_BOTTOM) is a metadata hint for the
## consumer — the widget itself emits a single line of fixed width;
## where the line ends up in the view is the parent's compose
## decision.
##
## Layout rules (term_width = TW):
##   - Left segments pack at column 0, separated by 1 space.
##   - Right segments pack against column TW, separated by 1 space.
##   - Center segments center within TW; if a left or right group is
##     wider than its half-allocation the center can be pushed off
##     center but never overlaps (at least 1 space separation).
##   - Spaces fill any leftover.
##   - If content overflows TW the line truncates at the right edge.
##
## Render path uses str_join over a Vec of pre-rendered segment
## strings interleaved with literal-space spacers. No two
## Style.render results are directly concatenated — sidesteps
## STYLE_RENDER_CONCAT_CORRUPTION
## (docs/bugs/STYLE_RENDER_CONCAT_CORRUPTION.md). Multi-segment
## styled bars are safe under this discipline.
##
## Usage:
##
##   import std/tui/widgets/status_bar as sb
##   import std/tui/layout as ly
##
##   var muted = Style.muted()
##   var bar = sb::status_bar_with_segments(sb::status_bar_new(), [
##     sb::status_segment_with_style(
##       sb::status_segment_left("Combat — Turn 1"), muted),
##     sb::status_segment_with_style(
##       sb::status_segment_center("Fights won: 0"), muted),
##     sb::status_segment_with_style(
##       sb::status_segment_right("[?] help"), muted)
##   ])
##   var line = sb::status_bar_view(bar, view_inner_width())
##
## @since 5.28.x

import std/tui/layout as ly
import style

# ============================================================
# Position constants (consumer hint)
# ============================================================

## Status bar pinned at the top of the view (header).
def POS_TOP():    Int = 0

## Status bar pinned at the bottom of the view (footer).
def POS_BOTTOM(): Int = 1

# ============================================================
# StatusSegment — single labelled, aligned cell
# ============================================================

## A single aligned segment. `align` is one of the
## `ly::ALIGN_LEFT/CENTER/RIGHT()` values.
struct StatusSegment
  content: String
  style:   Style
  align:   Int
end

## Construct a left-aligned segment with the default plain style.
def status_segment_left(content: String): StatusSegment
  return StatusSegment {
    content: content,
    style:   Style.new(),
    align:   ly::ALIGN_LEFT()
  }
end

## Construct a center-aligned segment with the default plain style.
def status_segment_center(content: String): StatusSegment
  return StatusSegment {
    content: content,
    style:   Style.new(),
    align:   ly::ALIGN_CENTER()
  }
end

## Construct a right-aligned segment with the default plain style.
def status_segment_right(content: String): StatusSegment
  return StatusSegment {
    content: content,
    style:   Style.new(),
    align:   ly::ALIGN_RIGHT()
  }
end

## Replace the segment's Style.
def status_segment_with_style(seg: StatusSegment, s: Style): StatusSegment
  return StatusSegment {
    content: seg.content, style: s, align: seg.align
  }
end

# ============================================================
# StatusBarStyles
# ============================================================

## Per-bar Style values. Currently only `body` — the colour for the
## space-fill cells between segments. Reserved for once
## STYLE_RENDER_CONCAT_CORRUPTION clears and we can render the fill
## with a background colour without breaking the segment renders.
struct StatusBarStyles
  body: Style
end

def status_bar_styles_default(): StatusBarStyles
  return StatusBarStyles {
    body: Style.new()
  }
end

# ============================================================
# StatusBar value
# ============================================================

## Status bar value object. Immutable — every mutator returns a new
## struct.
struct StatusBar
  segments: Vec<StatusSegment>
  position: Int
  styles:   StatusBarStyles
end

# ============================================================
# Constructors + builders
# ============================================================

## Build an empty status bar pinned at the top with default styles.
def status_bar_new(): StatusBar
  return StatusBar {
    segments: vec_new<StatusSegment>(),
    position: POS_TOP(),
    styles:   status_bar_styles_default()
  }
end

## Replace the segment list wholesale.
def status_bar_with_segments(b: StatusBar, segs: Vec<StatusSegment>): StatusBar
  return StatusBar {
    segments: segs, position: b.position, styles: b.styles
  }
end

## Replace the position hint (POS_TOP | POS_BOTTOM).
def status_bar_with_position(b: StatusBar, position: Int): StatusBar
  return StatusBar {
    segments: b.segments, position: position, styles: b.styles
  }
end

## Replace the styles wholesale.
def status_bar_with_styles(b: StatusBar, s: StatusBarStyles): StatusBar
  return StatusBar {
    segments: b.segments, position: b.position, styles: s
  }
end

## Append a single segment, returning a new bar.
def status_bar_append(b: StatusBar, seg: StatusSegment): StatusBar
  var segs: Vec<StatusSegment> = vec_clone(b.segments)
  segs.push(seg)
  return status_bar_with_segments(b, segs)
end

# ============================================================
# View
# ============================================================

# Group segments by alignment, preserving order within each group.
def _partition_by_align(segs: Vec<StatusSegment>):
    (Vec<StatusSegment>, Vec<StatusSegment>, Vec<StatusSegment>)
  var lefts   = vec_new<StatusSegment>()
  var centers = vec_new<StatusSegment>()
  var rights  = vec_new<StatusSegment>()
  var i = 0
  while i < segs.size
    var s: StatusSegment = segs[i]
    if s.align == ly::ALIGN_LEFT()
      lefts.push(s)
    elsif s.align == ly::ALIGN_CENTER()
      centers.push(s)
    else
      rights.push(s)
    end
    i = i + 1
  end
  return (lefts, centers, rights)
end

# Sum of visible widths in `segs` plus 1 cell of separation between
# each adjacent pair. 0 if `segs` is empty.
def _group_width(segs: Vec<StatusSegment>): Int
  if segs.size == 0
    return 0
  end
  var total = 0
  var i = 0
  while i < segs.size
    var s: StatusSegment = segs[i]
    total = total + ly::visible_width(s.content)
    i = i + 1
  end
  total = total + (segs.size - 1)
  return total
end

# Render each segment via its own Style and append to `out`.
# A single-space spacer is pushed between segments — so the assembled
# string never directly concats two render results.
def _push_rendered_group(segs: Vec<StatusSegment>, out: Vec<String>): Void
  var i = 0
  while i < segs.size
    if i > 0
      out.push(" ")
    end
    var s: StatusSegment = segs[i]
    var st: Style = s.style
    out.push(st.render(s.content))
    i = i + 1
  end
end

## Render the bar to a single line of at most `term_width` visible
## cells. Empty bars fill with spaces; over-budget content truncates
## at the right edge.
def status_bar_view(b: StatusBar, term_width: Int): String
  if term_width <= 0
    return ""
  end
  if b.segments.size == 0
    return str_repeat(" ", term_width)
  end

  var groups = _partition_by_align(b.segments)
  var lefts:   Vec<StatusSegment> = groups.0
  var centers: Vec<StatusSegment> = groups.1
  var rights:  Vec<StatusSegment> = groups.2

  var lw = _group_width(lefts)
  var cw = _group_width(centers)
  var rw = _group_width(rights)

  var out = vec_new<String>()
  _push_rendered_group(lefts, out)

  if cw > 0
    # Center the center group at floor((TW - CW) / 2). If the left
    # group encroaches, push the center over to leave at least one
    # space of separation. truncate() at the bottom catches any
    # right-edge overflow.
    var ideal_start = (term_width - cw) / 2
    var lpad = ideal_start - lw
    if lw > 0 and lpad < 1
      lpad = 1
    end
    if lpad < 0
      lpad = 0
    end
    if lpad > 0
      out.push(str_repeat(" ", lpad))
    end
    _push_rendered_group(centers, out)

    var rpad = term_width - lw - lpad - cw - rw
    if rw > 0 and rpad < 1
      rpad = 1
    end
    if rpad < 0
      rpad = 0
    end
    if rpad > 0
      out.push(str_repeat(" ", rpad))
    end
    _push_rendered_group(rights, out)
  else
    # No center: lefts (already pushed) + filler + rights, or just
    # lefts padded out to term_width.
    var filler_w = term_width - lw - rw
    if rw == 0
      if filler_w > 0
        out.push(str_repeat(" ", filler_w))
      end
    else
      if lw > 0 and filler_w < 1
        filler_w = 1
      end
      if filler_w < 0
        filler_w = 0
      end
      if filler_w > 0
        out.push(str_repeat(" ", filler_w))
      end
      _push_rendered_group(rights, out)
    end
  end

  var line = str_join(out, "")
  return ly::truncate(line, term_width)
end
