## std/tui/help.qz — declarative help-modal builder.
##
## Stop hand-writing help text per app: register key/action pairs in
## groups, hand the list to `help_modal`, get back an Overlay ready
## to compose over a base view.
##
## Usage:
##
##   import std/tui/help as hp
##
##   def help_overlay(): hp::Overlay
##     var combat = hp::keymap_append(
##       hp::keymap_append(
##         hp::keymap_append(
##           hp::keymap_new("Combat"),
##           "↑↓",    "navigate hand"),
##           "Enter", "play card"),
##           "E",     "end turn")
##     var anywhere = hp::keymap_append(
##       hp::keymap_append(hp::keymap_new("Anywhere"),
##         "?", "toggle help"),
##         "Q", "quit")
##     var maps = vec_new<hp::KeyMap>()
##     maps.push(combat)
##     maps.push(anywhere)
##     return hp::help_modal(maps)
##   end
##
## Layout:
##
##     KEYS
##
##     Combat
##       ↑↓        navigate hand
##       Enter     play card
##       E         end turn
##
##     Anywhere
##       ?         toggle help
##       Q         quit
##
##     [? to dismiss]
##
## Key column width auto-fits the widest key label across all groups,
## so action columns line up across groups regardless of key length.
##
## Render path uses one Style.render call per output line — sidesteps
## STYLE_RENDER_CONCAT_CORRUPTION
## (docs/bugs/STYLE_RENDER_CONCAT_CORRUPTION.md). The title and group
## headers render with the heading style, the dismiss hint renders
## muted; binding rows are plain so they don't compete with the
## section headers. Style.render results are never directly
## concatenated — every styled line either stands alone in the line
## list (str_join over Vec) or has plain literals padding it on at
## least one side.
##
## @since 5.28.x

import std/tui/layout as ly
import std/tui/widgets/overlay as ov
import style

# ============================================================
# Public types
# ============================================================

## A single (key, action) row. The display label is what the user
## sees ("↑↓", "Enter", "Ctrl+C") — not necessarily a single key.
struct KeyBinding
  key:    String
  action: String
end

## Bindings for a logical surface ("Combat", "Reward", "Anywhere").
struct KeyMap
  group:    String
  bindings: Vec<KeyBinding>
end

## Per-element styles. Default values target the same heading /
## muted aesthetic the rest of the TUI uses.
struct HelpStyles
  title:    Style    # the "KEYS" banner
  group:    Style    # group titles
  dismiss:  Style    # the "[? to dismiss]" footer hint
end

def help_styles_default(): HelpStyles
  return HelpStyles {
    title:   Style.heading(),
    group:   Style.heading(),
    dismiss: Style.muted()
  }
end

# ============================================================
# Constructors + builders
# ============================================================

## Construct a single binding row.
def key_binding(key: String, action: String): KeyBinding
  return KeyBinding { key: key, action: action }
end

## Empty keymap for a named group. Bindings are added incrementally
## via `keymap_append` or wholesale via `keymap_with_bindings`.
def keymap_new(group: String): KeyMap
  return KeyMap { group: group, bindings: vec_new<KeyBinding>() }
end

## Replace the binding list wholesale.
def keymap_with_bindings(km: KeyMap, b: Vec<KeyBinding>): KeyMap
  return KeyMap { group: km.group, bindings: b }
end

## Append a single (key, action) row, returning a new keymap.
def keymap_append(km: KeyMap, key: String, action: String): KeyMap
  var bs: Vec<KeyBinding> = vec_clone(km.bindings)
  bs.push(key_binding(key, action))
  return keymap_with_bindings(km, bs)
end

# ============================================================
# Body construction
# ============================================================

# Width of the longest key label across every binding in `maps`.
# Drives the action-column indent so every binding lines up.
def _max_key_width(maps: Vec<KeyMap>): Int
  var max_w = 0
  var i = 0
  while i < maps.size
    var km: KeyMap = maps[i]
    var j = 0
    while j < km.bindings.size
      var b: KeyBinding = km.bindings[j]
      var w = ly::visible_width(b.key)
      if w > max_w
        max_w = w
      end
      j = j + 1
    end
    i = i + 1
  end
  return max_w
end

# Pad `s` with trailing spaces to reach exactly `width` visible cells.
# Pure helper — keeps the binding-row builder readable.
def _pad_right(s: String, width: Int): String
  var w = ly::visible_width(s)
  if w >= width
    return s
  end
  return s + str_repeat(" ", width - w)
end

## Render a single bindings table — `key_w`-padded key column, four
## spaces, action. Plain text only (no styled renders on this row).
def _binding_line(b: KeyBinding, key_w: Int): String
  return "  " + _pad_right(b.key, key_w) + "    " + b.action
end

## Build the help body as a Vec<String> of lines, ready for
## `join_vertical`. Splitting into a Vec and joining at the bottom
## keeps each Style.render call a stand-alone line — no two render
## results land in the same `+` expression.
def _build_lines(maps: Vec<KeyMap>, styles: HelpStyles): Vec<String>
  var key_w = _max_key_width(maps)
  var s_title:   Style = styles.title
  var s_group:   Style = styles.group
  var s_dismiss: Style = styles.dismiss

  var lines = vec_new<String>()
  lines.push(s_title.render("KEYS"))
  lines.push("")

  var i = 0
  while i < maps.size
    var km: KeyMap = maps[i]
    lines.push(s_group.render(km.group))
    var j = 0
    while j < km.bindings.size
      lines.push(_binding_line(km.bindings[j], key_w))
      j = j + 1
    end
    if i < maps.size - 1
      lines.push("")
    end
    i = i + 1
  end

  lines.push("")
  lines.push(s_dismiss.render("[? to dismiss]"))
  return lines
end

## Render the help body as a multi-line string with the supplied
## styles. Caller decides whether to wrap in a border or hand
## directly to `overlay_new`.
def help_body_with_styles(maps: Vec<KeyMap>, styles: HelpStyles): String
  return ly::join_vertical(_build_lines(maps, styles))
end

## Render the help body with the default styles.
def help_body(maps: Vec<KeyMap>): String
  return help_body_with_styles(maps, help_styles_default())
end

# ============================================================
# Modal
# ============================================================

## Build a centred, rounded-border Overlay from `maps`. Caller
## decides whether to compose the overlay over a base view (interior
## modal) or render its content directly as a full-screen replacement.
def help_modal_with_styles(maps: Vec<KeyMap>, styles: HelpStyles): ov::Overlay
  return ov::overlay_new(
    ly::pad_uniform(help_body_with_styles(maps, styles), 1),
    ov::POS_CENTER(),
    ly::BORDER_ROUNDED())
end

## Build a centred, rounded-border Overlay from `maps` using the
## default HelpStyles.
def help_modal(maps: Vec<KeyMap>): ov::Overlay
  return help_modal_with_styles(maps, help_styles_default())
end
