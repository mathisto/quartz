# =============================================================================
# YAML loader — Phase 6.8
# =============================================================================
#
# Targeted Base16/Base24 YAML parser. Accepts both spec-0.10 (flat top-level
# baseXX keys) and spec-0.11 (palette: block with indented baseXX keys) layouts
# from `tinted-theming/schemes`. Not a full YAML parser — recognized keys are:
#   - `name`, `author`, `variant`, `slug`, `system`, `description` (metadata)
#   - `palette` (block marker — ignored, contents flow into the same loop)
#   - `base00`..`base0F` (mandatory; 16 Base16 slots)
#   - `base10`..`base17` (optional; Base24 extension; partial sets rejected)
# Unknown keys are silently ignored, so newer scheme metadata fields don't
# break older Quartz builds.

## Look up the slot index for `baseXX` keys. Returns 0..15 for `base00`..`base0F`,
## 16..23 for `base10`..`base17`, and -1 for non-base keys.
def _theme_base_slot_index(key: String): Int
  if str_byte_len(key) != 6
    return -1
  end
  if str_byte_at(key, 0) != 'b'
    return -1
  end
  if str_byte_at(key, 1) != 'a'
    return -1
  end
  if str_byte_at(key, 2) != 's'
    return -1
  end
  if str_byte_at(key, 3) != 'e'
    return -1
  end
  var hi = str_byte_at(key, 4)
  var lo = str_byte_at(key, 5)
  var hi_v = -1
  if hi >= '0' and hi <= '9'
    hi_v = hi - '0'
  end
  var lo_v = -1
  if lo >= '0' and lo <= '9'
    lo_v = lo - '0'
  end
  if lo >= 'a' and lo <= 'f'
    lo_v = lo - 'a' + 10
  end
  if lo >= 'A' and lo <= 'F'
    lo_v = lo - 'A' + 10
  end
  if hi_v < 0 or lo_v < 0
    return -1
  end
  var idx = hi_v * 16 + lo_v
  if idx < 0 or idx >= 24
    return -1
  end
  return idx
end

## Strip a YAML end-of-line comment from `line`. Comments start with `#`
## that lies *outside* a `"..."` or `'...'` quoted string. Hex values
## like `"#1e1e2e"` are not mis-detected because the `#` is inside quotes.
def _theme_strip_yaml_comment(line: String): String
  var len = str_byte_len(line)
  var i = 0
  var in_dq = false
  var in_sq = false
  while i < len
    var c = str_byte_at(line, i)
    if c == '"' and not in_sq
      in_dq = not in_dq
    end
    if c == '\'' and not in_dq
      in_sq = not in_sq
    end
    if c == '#' and not in_dq and not in_sq
      return str_byte_slice(line, 0, i)
    end
    i += 1
  end
  return line
end

## Strip surrounding `"..."` or `'...'` quotes from `s`. If `s` is not
## quoted, return it unchanged.
def _theme_strip_quotes(s: String): String
  var len = str_byte_len(s)
  if len < 2
    return s
  end
  var first = str_byte_at(s, 0)
  var last = str_byte_at(s, len - 1)
  if first == '"' and last == '"'
    return str_byte_slice(s, 1, len - 1)
  end
  if first == '\'' and last == '\''
    return str_byte_slice(s, 1, len - 1)
  end
  return s
end

## Verify every byte in `s` is an ASCII hex digit (0-9, a-f, A-F).
def _theme_is_valid_hex(s: String): Bool
  var len = str_byte_len(s)
  if len == 0
    return false
  end
  for i in 0..len
    var c = str_byte_at(s, i)
    var ok = false
    if c >= '0' and c <= '9'
      ok = true
    end
    if c >= 'a' and c <= 'f'
      ok = true
    end
    if c >= 'A' and c <= 'F'
      ok = true
    end
    if not ok
      return false
    end
  end
  return true
end

## Parse a Base16/Base24 YAML document into a `Theme`. Errors are returned
## as `ParseError` (line/column zero-indexed; line 0 = "no specific line").
##
## Accepts both spec-0.10 (flat) and spec-0.11 (palette-block) layouts.
## Mandatory: all 16 `base00`..`base0F` slots. Partial Base24 sets (some
## but not all of `base10`..`base17`) are rejected.
##
## ```be
## var yaml = "name: \"Foo\"\nvariant: \"dark\"\npalette:\n  base00: \"#000000\"\n  ..."
## var res = theme_from_string(yaml)
## match res
##   Ok(t)  => use_theme(t)
##   Err(e) => puts(e.message())
## end
## ```
def theme_from_string(yaml: String): Result<Theme, ParseError>
  var slots = vec_new<Int>()
  var seen = vec_new<Bool>()
  for i in 0..24
    slots.push(0)
    seen.push(false)
  end
  var name = ""
  var author = ""
  var variant_str = "dark"

  var lines = str_split(yaml, "\n")
  var line_no = 0
  for raw_line in lines
    line_no += 1
    var line = _theme_strip_yaml_comment(raw_line)
    line = str_trim(line)
    if str_byte_len(line) == 0
      continue
    end
    var colon_opt = str_byte_find(line, ":")
    var colon_idx = -1
    match colon_opt
      Some(p) => colon_idx = p
      None    => colon_idx = -1
    end
    if colon_idx < 0
      continue
    end
    var key = str_trim(str_byte_slice(line, 0, colon_idx))
    var val = str_trim(str_byte_slice(line, colon_idx + 1, str_byte_len(line)))
    val = _theme_strip_quotes(str_trim(val))

    if key == "name"
      name = val
      continue
    end
    if key == "author"
      author = val
      continue
    end
    if key == "variant"
      variant_str = val
      continue
    end

    var idx = _theme_base_slot_index(key)
    if idx < 0
      continue
    end

    var hex_str = val
    if str_byte_len(hex_str) > 0 and str_byte_at(hex_str, 0) == '#'
      hex_str = str_byte_slice(hex_str, 1, str_byte_len(hex_str))
    end
    if str_byte_len(hex_str) != 6
      return Result::Err(parse_error("Bad hex (expected 6 chars) for #{key}: #{val}", line_no, 0))
    end
    if not _theme_is_valid_hex(hex_str)
      return Result::Err(parse_error("Bad hex digits for #{key}: #{val}", line_no, 0))
    end
    slots[idx] = style::hex_color(hex_str)
    seen[idx] = true
  end

  for i in 0..16
    if not seen[i]
      return Result::Err(parse_error("Missing required Base16 slot (index #{i})", 0, 0))
    end
  end

  var has_ext = false
  var partial_ext = false
  for i in 16..24
    if seen[i]
      has_ext = true
    else
      partial_ext = true
    end
  end
  if has_ext and partial_ext
    return Result::Err(parse_error("Partial Base24 extension — all 8 of base10..base17 required", 0, 0))
  end

  var variant = ThemeVariant::Dark
  if variant_str == "light"
    variant = ThemeVariant::Light
  end

  var ext = Option::None
  if has_ext
    ext = Option::Some(Base24Ext {
      base10: slots[16],
      base11: slots[17],
      base12: slots[18],
      base13: slots[19],
      base14: slots[20],
      base15: slots[21],
      base16: slots[22],
      base17: slots[23]
    })
  end

  return Result::Ok(Theme {
    name:      name,
    author:    author,
    variant:   variant,
    base00:    slots[0],
    base01:    slots[1],
    base02:    slots[2],
    base03:    slots[3],
    base04:    slots[4],
    base05:    slots[5],
    base06:    slots[6],
    base07:    slots[7],
    base08:    slots[8],
    base09:    slots[9],
    base0A:    slots[10],
    base0B:    slots[11],
    base0C:    slots[12],
    base0D:    slots[13],
    base0E:    slots[14],
    base0F:    slots[15],
    base10_17: ext
  })
end

## Read a Base16/Base24 YAML file from disk and parse it. Returns
## `Err(ParseError)` if the file is missing or malformed; `Ok(Theme)` on
## success.
def theme_load_yaml(path: String): Result<Theme, ParseError>
  if not file_exists(path)
    return Result::Err(parse_error("Theme file not found: #{path}", 0, 0))
  end
  var content = read_file(path)
  return theme_from_string(content)
end
