## std/tui/theme.qz — Base16 / Base24 theme system with semantic accessors.
##
## A `Theme` carries 16 color slots (`base00`-`base0F`) following the
## Chris Kempson Base16 spec, plus an optional Base24 extension
## (`base10_17` for terminal-bright variants of the 8 accent colors).
## Slots are interpreted as `Int` color values using the same encoding
## as `std/style.qz` (truecolor / 256-palette / ANSI 16) — `theme.base05`
## passes straight to `Style.fg(theme.base05)` and to
## `cell::channel_rgb(theme.base05)` without conversion.
##
## **Semantic accessors** are the ergonomic move: widgets call
## `theme_fg(t)` / `theme_error(t)` / `theme_status_bar_bg(t)` and
## never memorize what `base05` or `base08` mean. Switching themes is
## a config swap with zero widget changes.
##
## v0.6.0 ships with `theme_catppuccin_mocha()` as the bundled default
## (Dark variant). Phase 6.8 adds the YAML loader and bundles the rest
## (Catppuccin Latte, Gruvbox Dark/Light Hard, Tokyo Night, Nord,
## Dracula, Solarized Dark/Light, Rosé Pine Moon, Everforest Dark).
## All 200+ schemes from tinted-theming/schemes work via
## `theme_load_yaml` once it ships in 6.8.
##
## See `docs/design/TUI_V06_CELL_ENGINE.md` D8 and
## `docs/design/TUI_V06_OPEN_QUESTIONS.md` Q5 for the migration story.
##
## @since 5.28.x

import style
import string
import error

# =============================================================================
# Theme variant
# =============================================================================

## Whether a theme intends a light or dark background. Consumers can
## key off this to flip non-color decisions (e.g., select a different
## border style) without parsing colors.
enum ThemeVariant
  Light
  Dark
end

# =============================================================================
# Base24 extension
# =============================================================================

## Optional Base24 extension carrying 8 brighter accent variants
## paired with `base08`-`base0F`. When `base10_17` is `Some(ext)`,
## consumers may use the brighter variants for emphasis (e.g., bright
## red for a critical-error highlight that needs to stand out against
## the regular `base08` red). Most apps and most schemes don't use it.
##
## Slot mapping:
##   base10 — bright red       (paired with base08)
##   base11 — bright orange    (paired with base09)
##   base12 — bright yellow    (paired with base0A)
##   base13 — bright green     (paired with base0B)
##   base14 — bright cyan      (paired with base0C)
##   base15 — bright blue      (paired with base0D)
##   base16 — bright purple    (paired with base0E)
##   base17 — bright brown     (paired with base0F)
struct Base24Ext
  base10: Int
  base11: Int
  base12: Int
  base13: Int
  base14: Int
  base15: Int
  base16: Int
  base17: Int
end

# =============================================================================
# Theme struct
# =============================================================================

## The full theme value. Immutable — `theme_with_*` builders return new
## structs.
##
## - `name` / `author`: metadata. `name` is the human-readable title
##   (e.g., "Catppuccin Mocha"); `author` may be empty.
## - `variant`: light vs dark — for non-color-keyed UI decisions.
## - `base00`-`base0F`: 16 standard Base16 slots. Encoding matches
##   `std/style.qz` colors (RGB / palette / ANSI 16 / `-1` sentinel).
## - `base10_17`: optional Base24 bright-variant extension.
struct Theme
  name:      String
  author:    String
  variant:   ThemeVariant
  base00:    Int          # default bg
  base01:    Int          # lighter bg / status bar bg
  base02:    Int          # selection bg
  base03:    Int          # comments / disabled / dim
  base04:    Int          # dark fg / status bar fg
  base05:    Int          # default fg
  base06:    Int          # light fg
  base07:    Int          # lightest fg
  base08:    Int          # red — variables / errors
  base09:    Int          # orange — integers / constants
  base0A:    Int          # yellow — classes / types / warnings
  base0B:    Int          # green — strings / success
  base0C:    Int          # cyan — regex / escape / special / info
  base0D:    Int          # blue — functions / methods / info
  base0E:    Int          # purple — keywords / storage / special
  base0F:    Int          # brown — deprecated / embedded
  base10_17: Option<Base24Ext>
end

# =============================================================================
# Semantic accessors — the ergonomic API
# =============================================================================

## Default background for body content.
def theme_bg(t: Theme): Int = t.base00

## Default foreground for body text.
def theme_fg(t: Theme): Int = t.base05

## Dim foreground for comments / disabled / placeholder text.
def theme_dim(t: Theme): Int = t.base03

## Selection / highlighted-row background (e.g., for `List`'s focused row).
def theme_selection_bg(t: Theme): Int = t.base02

## Status bar background — slightly lighter / darker than default bg.
def theme_status_bar_bg(t: Theme): Int = t.base01

## Status bar foreground.
def theme_status_bar_fg(t: Theme): Int = t.base04

## Error color (red-ish in most palettes).
def theme_error(t: Theme): Int = t.base08

## Warning color (orange-ish).
def theme_warning(t: Theme): Int = t.base09

## Info / link color (blue-ish).
def theme_info(t: Theme): Int = t.base0D

## Success color (green-ish).
def theme_success(t: Theme): Int = t.base0B

## Special / keyword color (purple-ish).
def theme_special(t: Theme): Int = t.base0E

# =============================================================================
# Accent slot accessor
# =============================================================================

## Named accent slots. Use with `theme_accent(t, ACCENT_BLUE)` etc.
## These are the eight Base16 accent colors (base08-base0F) addressed
## by semantic name rather than slot number.
def ACCENT_RED():    Int = 0
def ACCENT_ORANGE(): Int = 1
def ACCENT_YELLOW(): Int = 2
def ACCENT_GREEN():  Int = 3
def ACCENT_CYAN():   Int = 4
def ACCENT_BLUE():   Int = 5
def ACCENT_PURPLE(): Int = 6
def ACCENT_BROWN():  Int = 7

## Look up an accent slot by name. Returns `t.base05` (default fg) if
## the slot is out of range — defensive default that won't crash if
## a caller passes an unrecognized slot number.
def theme_accent(t: Theme, slot: Int): Int
  if slot == 0
    return t.base08
  end
  if slot == 1
    return t.base09
  end
  if slot == 2
    return t.base0A
  end
  if slot == 3
    return t.base0B
  end
  if slot == 4
    return t.base0C
  end
  if slot == 5
    return t.base0D
  end
  if slot == 6
    return t.base0E
  end
  if slot == 7
    return t.base0F
  end
  return t.base05
end

# =============================================================================
# Bundled theme — Catppuccin Mocha
# =============================================================================

## Catppuccin Mocha (Dark). The v0.6.0 default. Values match the
## canonical scheme at github.com/tinted-theming/schemes/tree/spec-0.11/base16
## (catppuccin-mocha.yaml).
##
## Palette source: Catppuccin community (https://catppuccin.com).
## Mapped to Base16 slots:
##   base00 base = 1E1E2E       base08 red       = F38BA8
##   base01 mantle = 181825      base09 peach     = FAB387
##   base02 surface0 = 313244    base0A yellow    = F9E2AF
##   base03 surface1 = 45475A    base0B green     = A6E3A1
##   base04 surface2 = 585B70    base0C teal      = 94E2D5
##   base05 text = CDD6F4        base0D blue      = 89B4FA
##   base06 rosewater = F5E0DC   base0E mauve     = CBA6F7
##   base07 lavender = B4BEFE    base0F flamingo  = F2CDCD
def theme_catppuccin_mocha(): Theme
  return Theme {
    name:      "Catppuccin Mocha",
    author:    "Catppuccin Team",
    variant:   ThemeVariant::Dark,
    base00:    style::hex_color("1E1E2E"),
    base01:    style::hex_color("181825"),
    base02:    style::hex_color("313244"),
    base03:    style::hex_color("45475A"),
    base04:    style::hex_color("585B70"),
    base05:    style::hex_color("CDD6F4"),
    base06:    style::hex_color("F5E0DC"),
    base07:    style::hex_color("B4BEFE"),
    base08:    style::hex_color("F38BA8"),
    base09:    style::hex_color("FAB387"),
    base0A:    style::hex_color("F9E2AF"),
    base0B:    style::hex_color("A6E3A1"),
    base0C:    style::hex_color("94E2D5"),
    base0D:    style::hex_color("89B4FA"),
    base0E:    style::hex_color("CBA6F7"),
    base0F:    style::hex_color("F2CDCD"),
    base10_17: Option::None
  }
end

