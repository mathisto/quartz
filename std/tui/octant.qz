## std/tui/octant.qz — sub-cell pixel blitter (Phase 6.6 of v0.6).
##
## An `OctantBlitter` carries a `pixel_w × pixel_h` boolean pixel
## grid. `octant_blit_to_plane` downsamples that grid into one cell
## per (2 cols × 4 rows) of pixels, choosing a glyph for each cell
## based on which sub-pixels are filled. Output cell dimensions are
## `pixel_w / 2` wide × `pixel_h / 4` tall.
##
## **Why sub-cell pixels.** Modern terminals draw one glyph per
## monospace cell. With careful glyph choice (block characters,
## quadrants, octants), each cell can carry up to 8 binary
## "sub-pixels" while preserving cell semantics — mouse hit-testing,
## focus, cursor positioning, attribute boundaries all still work at
## the cell level. For dashboards, sparklines, roguelike weather
## effects, and any "graphics-shaped" use case, this is the most
## resolution you can get without escaping into Sixel / Kitty graphics
## protocol territory.
##
## **Quality tiers.** Apps pick their tradeoff at blit time:
##
## - `Octant` — full 2×4 sub-cell resolution, Unicode 16 octants
##   (Sept 2024). All 256 patterns covered: 230 new codepoints in
##   U+1CD00..U+1CDE5 plus 26 reused codepoints from earlier blocks
##   (16 quadrant-clean from U+2580..U+259F, plus 8 from
##   U+1CEA0..U+1CEAB / U+1FB82 / U+1FB85 / U+1FBE6 / U+1FBE7, plus 2
##   from U+2582 and U+2586). Full coverage shipped in v0.6.6.1 — the
##   visceral fidelity payoff for cell-level lighting + roguelike
##   rendering.
## - `Quadrant` — 2×2 sub-cell resolution. Maps the 8 octant pixels to
##   4 quadrant pixels (each quadrant ON if any of its 2 octant pixels
##   is on), then picks one of 16 BMP block characters. Universal
##   support — every modern terminal and most legacy ones.
## - `Half` — 1×2 sub-cell resolution (top half / bottom half). Maps
##   the 8 octant pixels to 2 half pixels. Picks one of 4 chars (full,
##   upper-half, lower-half, space). Maximum compat.
## - `Ascii` — 1×1 (the entire cell is on or off). `#` for any-on,
##   space for all-off. For terminals that don't render any block
##   characters at all (vanishingly rare in 2026 but kept for true
##   degraded-terminal cases like log files / scriptable test output).
##
## **Coordinate system.** The pixel grid uses `(px, py)` where
## `px ∈ [0, pixel_w)` is column and `py ∈ [0, pixel_h)` is row, both
## 0-indexed. Pixel `(px, py)` corresponds to bit
## `(py % 4) * 2 + (px % 2)` within its containing octant cell — the
## standard Unicode octant bit ordering (top-left first, then right,
## then row-by-row down to bottom-right).
##
## **Why 2×4 not 4×2.** The Unicode 16 octant block lays out cells as
## 2 columns × 4 rows of subpixels (matching how a monospace cell is
## ~2× taller than wide). The original v0.6 design memo sketched
## "4w × 2h pixels per cell" which was a notation slip — the actual
## Unicode geometry is 2×4. Rectifying here.
##
## See `docs/design/TUI_V06_CELL_ENGINE.md` D6 for the design rationale,
## and Unicode 16/17 charts U+1CC00..U+1CEBF (Symbols for Legacy
## Computing Supplement) for the codepoint reference.
##
## @since 5.28.x

import std/tui/cell as cl
import std/tui/plane as pl

# =============================================================================
# OctantQuality — caller-selected resolution / compatibility tier
# =============================================================================

## Picks how `octant_blit_to_plane` chooses a glyph per output cell.
## Tiers are ordered by descending resolution; higher tiers may need
## newer fonts, lower tiers degrade gracefully on legacy terminals.
enum OctantQuality
  Octant      # 2×4 sub-cells (Unicode 16; partial coverage in v0.6.6.0)
  Quadrant    # 2×2 sub-cells (BMP block characters; full coverage)
  Half        # 1×2 sub-cells (upper / lower halves)
  Ascii       # 1×1 (#-or-space)
end

# =============================================================================
# OctantBlitter struct
# =============================================================================

## A boolean pixel grid that downsamples to monospace cells via
## `octant_blit_to_plane`. Cell-output dimensions are `pixel_w / 2 ×
## pixel_h / 4` (regardless of quality tier).
##
## - `pixels`: row-major `pixel_w × pixel_h` `Vec<Bool>`. Pixel
##   `(px, py)` lives at `pixels[py * pixel_w + px]`.
## - `pixel_w`, `pixel_h`: dimensions in pixels (sub-cell units).
##   Should be multiples of 2 and 4 respectively for clean cell
##   boundaries; non-aligned dimensions are silently rounded down at
##   blit time.
struct OctantBlitter
  pixels:  Vec<Bool>
  pixel_w: Int
  pixel_h: Int
end

## Construct a blank (all-off) blitter at `pixel_w × pixel_h`.
def octant_blitter_new(pixel_w: Int, pixel_h: Int): OctantBlitter
  var pw = pixel_w
  var ph = pixel_h
  if pw < 0
    pw = 0
  end
  if ph < 0
    ph = 0
  end
  var n = pw * ph
  var px = vec_new<Bool>()
  var i = 0
  while i < n
    px.push(false)
    i += 1
  end
  return OctantBlitter {
    pixels:  px,
    pixel_w: pw,
    pixel_h: ph
  }
end

## Read pixel `(px, py)`. Returns `false` for OOB queries.
def octant_get(b: OctantBlitter, px: Int, py: Int): Bool
  if px < 0 or py < 0 or px >= b.pixel_w or py >= b.pixel_h
    return false
  end
  var v = b.pixels
  return v[py * b.pixel_w + px]
end

## Set pixel `(px, py)` to `on`. Returns a fresh blitter with the
## change. OOB writes are silent no-ops (the original blitter is
## returned, dimensions unchanged).
def octant_set(b: OctantBlitter, px: Int, py: Int, on: Bool): OctantBlitter
  if px < 0 or py < 0 or px >= b.pixel_w or py >= b.pixel_h
    return b
  end
  # Copy pixel buffer, mutate the copy.
  var src = b.pixels
  var n = src.size
  var copy = vec_new<Bool>()
  var i = 0
  while i < n
    copy.push(src[i])
    i += 1
  end
  copy[py * b.pixel_w + px] = on
  return OctantBlitter {
    pixels:  copy,
    pixel_w: b.pixel_w,
    pixel_h: b.pixel_h
  }
end

## Set every pixel in the blitter to `on`. Useful for clearing or
## flooding before targeted edits.
def octant_fill(b: OctantBlitter, on: Bool): OctantBlitter
  var n = b.pixels.size
  var px = vec_new<Bool>()
  var i = 0
  while i < n
    px.push(on)
    i += 1
  end
  return OctantBlitter {
    pixels:  px,
    pixel_w: b.pixel_w,
    pixel_h: b.pixel_h
  }
end

## Output cell width: how many cells wide an octant blit produces.
## Equal to `pixel_w / 2` (rounded down).
def octant_cell_w(b: OctantBlitter): Int = b.pixel_w / 2

## Output cell height: how many cells tall an octant blit produces.
## Equal to `pixel_h / 4` (rounded down).
def octant_cell_h(b: OctantBlitter): Int = b.pixel_h / 4

# =============================================================================
# Internal: pattern extraction
# =============================================================================

## Read the 8-bit octant pattern for cell `(cx, cy)` from the blitter.
##
## Bit ordering (Unicode-standard for octants):
##   bit 0 = pixel (2*cx + 0, 4*cy + 0)  — top-left
##   bit 1 = pixel (2*cx + 1, 4*cy + 0)  — top-right
##   bit 2 = pixel (2*cx + 0, 4*cy + 1)
##   bit 3 = pixel (2*cx + 1, 4*cy + 1)
##   bit 4 = pixel (2*cx + 0, 4*cy + 2)
##   bit 5 = pixel (2*cx + 1, 4*cy + 2)
##   bit 6 = pixel (2*cx + 0, 4*cy + 3)  — bottom-left
##   bit 7 = pixel (2*cx + 1, 4*cy + 3)  — bottom-right
##
## OOB cells return 0 (octant_get clamps individual pixel reads to false).
def octant_pattern_at(b: OctantBlitter, cx: Int, cy: Int): Int
  var pat = 0
  var dy = 0
  while dy < 4
    var dx = 0
    while dx < 2
      if octant_get(b, 2 * cx + dx, 4 * cy + dy)
        pat = pat | (1 << (dy * 2 + dx))
      end
      dx += 1
    end
    dy += 1
  end
  return pat
end

# =============================================================================
# Pattern → glyph for each quality tier
# =============================================================================

## Quadrant bit packing — collapse 8 octant bits to 4 quadrant bits.
##
##   quad bit 0 = UL set (any of octant bits 0, 2)
##   quad bit 1 = UR set (any of octant bits 1, 3)
##   quad bit 2 = LL set (any of octant bits 4, 6)
##   quad bit 3 = LR set (any of octant bits 5, 7)
def _quadrant_bits(pat: Int): Int
  var q = 0
  if (pat & 0x05) != 0
    q = q | 1
  end
  if (pat & 0x0A) != 0
    q = q | 2
  end
  if (pat & 0x50) != 0
    q = q | 4
  end
  if (pat & 0xA0) != 0
    q = q | 8
  end
  return q
end

## Half-block bit packing — collapse 8 octant bits to 2 half bits.
##
##   half bit 0 = upper half (any of octant bits 0..3)
##   half bit 1 = lower half (any of octant bits 4..7)
def _half_bits(pat: Int): Int
  var h = 0
  if (pat & 0x0F) != 0
    h = h | 1
  end
  if (pat & 0xF0) != 0
    h = h | 2
  end
  return h
end

## Map a 4-bit quadrant pattern to its block-character glyph.
##
## Table (q-bit numbering: 1=UL, 2=UR, 4=LL, 8=LR):
##   0x0  →  " "      (space)
##   0x1  →  "▘"      (U+2598)
##   0x2  →  "▝"      (U+259D)
##   0x3  →  "▀"      (U+2580 upper half)
##   0x4  →  "▖"      (U+2596)
##   0x5  →  "▌"      (U+258C left half)
##   0x6  →  "▞"      (U+259E)
##   0x7  →  "▛"      (U+259B)
##   0x8  →  "▗"      (U+2597)
##   0x9  →  "▚"      (U+259A)
##   0xA  →  "▐"      (U+2590 right half)
##   0xB  →  "▜"      (U+259C)
##   0xC  →  "▄"      (U+2584 lower half)
##   0xD  →  "▙"      (U+2599)
##   0xE  →  "▟"      (U+259F)
##   0xF  →  "█"      (U+2588 full block)
def _quadrant_glyph(q: Int): String
  if q == 0x0
    return " "
  end
  if q == 0x1
    return "▘"
  end
  if q == 0x2
    return "▝"
  end
  if q == 0x3
    return "▀"
  end
  if q == 0x4
    return "▖"
  end
  if q == 0x5
    return "▌"
  end
  if q == 0x6
    return "▞"
  end
  if q == 0x7
    return "▛"
  end
  if q == 0x8
    return "▗"
  end
  if q == 0x9
    return "▚"
  end
  if q == 0xA
    return "▐"
  end
  if q == 0xB
    return "▜"
  end
  if q == 0xC
    return "▄"
  end
  if q == 0xD
    return "▙"
  end
  if q == 0xE
    return "▟"
  end
  return "█"
end

## Map a 2-bit half-block pattern to its glyph.
def _half_glyph(h: Int): String
  if h == 0
    return " "
  end
  if h == 1
    return "▀"
  end
  if h == 2
    return "▄"
  end
  return "█"
end

# =============================================================================
# Full Unicode 16/17 octant codepoint table (Phase 6.6.1)
# =============================================================================
#
# 256 patterns map to 230 NEW Unicode 17 codepoints in U+1CD00..U+1CDE5
# plus 26 reused codepoints from earlier blocks:
#
#   - 16 quadrant-clean patterns (halves, quadrants, full block, space)
#     reuse the existing Block Elements range U+2580..U+259F.
#   - 8 patterns reuse the Symbols-for-Legacy-Computing range
#     (U+1CEA0..U+1CEAB, U+1FB82, U+1FB85, U+1FBE6, U+1FBE7) for shapes
#     that already had glyphs in Unicode 13 / 16 elsewhere.
#   - 2 patterns reuse U+2582 (LOWER ONE QUARTER BLOCK) and U+2586
#     (LOWER THREE QUARTERS BLOCK) for the bottom-row-only and
#     bottom-three-rows patterns.
#
# Bit ordering (`octant_pattern_at` in this module):
#   bit 0=top-left, 1=top-right, 2=upper-mid-left, 3=upper-mid-right,
#   bit 4=lower-mid-left, 5=lower-mid-right, 6=bottom-left, 7=bottom-right.
#
# Source: Bobby-Miller's community-curated octant lookup gist
# (https://gist.github.com/Bobby-Miller/d48dabce3179f328b15db4737740fd55),
# transcribed from the Unicode 17 chart at U+1CC00 (Symbols for Legacy
# Computing Supplement). One typo in the gist was corrected: the
# top-3-rows pattern (my-bit 0x3F) maps to U+1FB85 (UPPER THREE QUARTERS
# BLOCK), not U+2586 (which is LOWER THREE QUARTERS — already used by
# the bottom-3-rows pattern at my-bit 0xFC). Cross-validated against
# the Unicode "BLOCK OCTANT-DIGITS" naming convention for the 16
# canonical reused patterns + several representative new octants
# (U+1CD00 = OCTANT-3, U+1CDE5 = OCTANT-2345678).
#
# Dispatched as 16 helper functions keyed by high nibble (each handles
# 16 low-nibble cases). This shape is mechanical to verify — every
# `if lo == 0xN / return 0x...` line corresponds 1:1 to a row in the
# generator script that built this table.

def _oct_cp_h0(lo: Int): Int
  if lo == 0x0
    return 0x20
  end
  if lo == 0x1
    return 0x1CEA8
  end
  if lo == 0x2
    return 0x1CEAB
  end
  if lo == 0x3
    return 0x1FB82
  end
  if lo == 0x4
    return 0x1CD00
  end
  if lo == 0x5
    return 0x2598
  end
  if lo == 0x6
    return 0x1CD01
  end
  if lo == 0x7
    return 0x1CD02
  end
  if lo == 0x8
    return 0x1CD03
  end
  if lo == 0x9
    return 0x1CD04
  end
  if lo == 0xA
    return 0x259D
  end
  if lo == 0xB
    return 0x1CD05
  end
  if lo == 0xC
    return 0x1CD06
  end
  if lo == 0xD
    return 0x1CD07
  end
  if lo == 0xE
    return 0x1CD08
  end
  if lo == 0xF
    return 0x2580
  end
  return 0x20
end

