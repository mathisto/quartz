## Pattern → Unicode codepoint dispatch. Combines the high-nibble +
## low-nibble lookup. Public (non-`_`-prefixed) so the spec can verify
## individual entries directly without going through the glyph emitter.
def octant_codepoint(pat: Int): Int
  var hi = (pat >> 4) & 0xF
  var lo = pat & 0xF
  if hi == 0x0
    return _oct_cp_h0(lo)
  end
  if hi == 0x1
    return _oct_cp_h1(lo)
  end
  if hi == 0x2
    return _oct_cp_h2(lo)
  end
  if hi == 0x3
    return _oct_cp_h3(lo)
  end
  if hi == 0x4
    return _oct_cp_h4(lo)
  end
  if hi == 0x5
    return _oct_cp_h5(lo)
  end
  if hi == 0x6
    return _oct_cp_h6(lo)
  end
  if hi == 0x7
    return _oct_cp_h7(lo)
  end
  if hi == 0x8
    return _oct_cp_h8(lo)
  end
  if hi == 0x9
    return _oct_cp_h9(lo)
  end
  if hi == 0xA
    return _oct_cp_hA(lo)
  end
  if hi == 0xB
    return _oct_cp_hB(lo)
  end
  if hi == 0xC
    return _oct_cp_hC(lo)
  end
  if hi == 0xD
    return _oct_cp_hD(lo)
  end
  if hi == 0xE
    return _oct_cp_hE(lo)
  end
  return _oct_cp_hF(lo)
end

# =============================================================================
# UTF-8 encoder for octant codepoints
# =============================================================================
#
# Octant codepoints span four UTF-8 length classes:
#   - 1 byte:  U+0020 (space, only one in the table)
#   - 3 bytes: U+2580..U+259F (Block Elements range)
#   - 4 bytes: U+1CD00..U+1CDE5 (new octants), U+1CEA0..U+1CEAB,
#              U+1FB82, U+1FB85, U+1FBE6, U+1FBE7
#
# Encoding follows RFC 3629:
#   0x00..0x7F      → 1 byte  (cp)
#   0x80..0x7FF     → 2 bytes (110xxxxx 10xxxxxx)
#   0x800..0xFFFF   → 3 bytes (1110xxxx 10xxxxxx 10xxxxxx)
#   0x10000..       → 4 bytes (11110xxx 10xxxxxx 10xxxxxx 10xxxxxx)

## Encode a Unicode codepoint as a UTF-8 String.
##
## Quartz's `StringBuilder.append_char` already takes a Unicode
## codepoint and emits the correct UTF-8 byte sequence. We just hand
## the codepoint over and trust the builder. (An earlier version of
## this helper hand-rolled the UTF-8 byte arithmetic and then called
## `append_char` per byte — that double-encoded every high-bit byte
## because `append_char` treated the byte as a codepoint and re-
## emitted it as a 2-byte UTF-8 sequence.)
def codepoint_to_utf8(cp: Int): String
  var sb = sb_new()
  sb.append_char(cp)
  return sb.to_string()
end

## Map an 8-bit octant pattern to a glyph at full Unicode 17 fidelity.
##
## Every pattern (256 total) lands on either a new octant codepoint
## (U+1CD00..U+1CDE5, 230 patterns) or a reused codepoint from the
## Block Elements / Symbols-for-Legacy-Computing ranges (26 patterns).
## See the table comment block above for the bit-ordering convention
## and source provenance.
##
## v0.6.6.0 covered only the 16 quadrant-clean reused patterns and
## fell back to the `Quadrant` quality glyph for the remaining 240.
## v0.6.6.1 (this implementation) closes the gap with the full
## Unicode 17 codepoint table.
def _octant_glyph(pat: Int): String
  return codepoint_to_utf8(octant_codepoint(pat))
end

## Map an 8-bit octant pattern to its ASCII representation.
##   0x00       → " "
##   anything   → "#"
def _ascii_glyph(pat: Int): String
  if pat == 0
    return " "
  end
  return "#"
end

## Dispatch: pattern + quality → glyph.
def _glyph_for(pat: Int, q: OctantQuality): String
  if q is Octant
    return _octant_glyph(pat)
  end
  if q is Quadrant
    return _quadrant_glyph(_quadrant_bits(pat))
  end
  if q is Half
    return _half_glyph(_half_bits(pat))
  end
  return _ascii_glyph(pat)
end

# =============================================================================
# Public API: blit blitter onto a plane
# =============================================================================

## Render the blitter's pixels onto `plane` starting at `(dst_x, dst_y)`,
## one cell per (2 cols × 4 rows) of pixels. Cells outside `plane`'s
## rectangle are clipped silently. Each output cell uses `fg` and `bg`
## as its foreground / background channels and 0 for attributes.
##
## Cell footprint: `octant_cell_w(b) × octant_cell_h(b)`.
##
## Quality controls only the choice of glyph per cell — the same
## blitter renders to the same number of output cells under any
## quality. `Quadrant`, `Half`, `Ascii` provide full-coverage fallbacks
## for terminals lacking Unicode 16 / block-character support; in
## practice every modern terminal handles `Quadrant` correctly.
##
## Returns a fresh `Plane`. The input is unchanged.
def octant_blit_to_plane(
  b: OctantBlitter, plane: pl::Plane,
  dst_x: Int, dst_y: Int,
  quality: OctantQuality,
  fg: cl::Channel, bg: cl::Channel
): pl::Plane
  var cw = octant_cell_w(b)
  var ch = octant_cell_h(b)
  var out = plane
  var cy = 0
  while cy < ch
    var cx = 0
    while cx < cw
      var pat = octant_pattern_at(b, cx, cy)
      var glyph = _glyph_for(pat, quality)
      var cell = cl::Cell {
        egc:   glyph,
        fg:    fg,
        bg:    bg,
        attrs: 0
      }
      out = pl::plane_putc(out, dst_x + cx, dst_y + cy, cell)
      cx += 1
    end
    cy += 1
  end
  return out
end

## Multi-blitter layered render: one blitter drives the cell footprint +
## glyph; a `fg_picker` callback receives all blitters' patterns at the
## current cell and returns the foreground colour as an Int (the integer
## carried by `cl::Channel`'s underlying RGB packing — produce one with
## `cl::channel_rgb(rgb)` and pass that channel through `Channel`'s Int
## representation, OR have the picker close over a few precomputed
## `cl::Channel` ints).
##
## Use case — the brogue-tribute minimap idiom: a "memory" blitter drives
## the layout (so visited geometry persists), while a "currently visible"
## blitter picks bright vs. dim fg at each cell. The picker is one line:
##
## ```be
## var picker = (cx, cy, pats) -> {
##   if pats[1] != 0 { return fg_bright_int } else { return fg_dim_int }
## }
## octant_blit_layered(
##   vec![mem_blitter, fov_blitter], 0, picker, bg, plane, 0, 0, quality
## )
## ```
##
## ### Semantics
##
## - For each cell `(cx, cy)` in the area covered by
##   `blitters[layout_blitter_idx]` (i.e., `octant_cell_w × octant_cell_h`
##   of that blitter):
##   1. Read `octant_pattern_at(blitters[i], cx, cy)` for every `i` →
##      `pats: Vec<Int>`.
##   2. Take the glyph from `pats[layout_blitter_idx]` rendered at the
##      requested `quality`.
##   3. Call `fg_picker(cx, cy, pats)` for the cell's fg colour as an Int
##      and wrap with `cl::Channel { value: fg_int, alpha: ... }` —
##      see implementation: we build the channel via `cl::channel_rgb`
##      below from the picker's returned RGB int.
##   4. Composite a single cell at `(dst_x + cx, dst_y + cy)` with that
##      fg + the given `bg`, attrs cleared.
##
## ### Edge cases
##
## - Empty `blitters` (size 0): no-op. Returns `plane` unchanged. There is
##   no layout blitter to size the loop, so the function has nothing to
##   do.
## - `layout_blitter_idx` out-of-bounds: same no-op. Defensive — caller
##   bug, but a silent return keeps the contract simple.
## - Cells outside `plane`'s rectangle: clipped silently by `plane_putc`,
##   matching `octant_blit_to_plane`.
##
## Returns a fresh `Plane`. All inputs unchanged.
def octant_blit_layered(
  blitters: Vec<OctantBlitter>,
  layout_blitter_idx: Int,
  fg_picker: Fn(Int, Int, Vec<Int>): Int,
  bg: cl::Channel,
  plane: pl::Plane,
  dst_x: Int, dst_y: Int,
  quality: OctantQuality
): pl::Plane
  var n = blitters.size
  if n == 0
    return plane
  end
  if layout_blitter_idx < 0 or layout_blitter_idx >= n
    return plane
  end
  var layout = blitters[layout_blitter_idx]
  var cw = octant_cell_w(layout)
  var ch = octant_cell_h(layout)
  var out = plane
  var cy = 0
  while cy < ch
    var cx = 0
    while cx < cw
      var pats = vec_new<Int>()
      var i = 0
      while i < n
        var bi = blitters[i]
        pats.push(octant_pattern_at(bi, cx, cy))
        i += 1
      end
      var glyph = _glyph_for(pats[layout_blitter_idx], quality)
      var fg_int = fg_picker(cx, cy, pats)
      var fg = cl::channel_rgb(fg_int)
      var cell = cl::Cell {
        egc:   glyph,
        fg:    fg,
        bg:    bg,
        attrs: 0
      }
      out = pl::plane_putc(out, dst_x + cx, dst_y + cy, cell)
      cx += 1
    end
    cy += 1
  end
  return out
end
