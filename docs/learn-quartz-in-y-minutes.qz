# Learn Quartz in Y Minutes
#
# Quartz is an existential programming language - rich types at compile-time,
# pure i64 at runtime. This is a quick-start guide with runnable examples.
#
# Run any section: ./self-hosted/bin/quartz this_file.qz | llc ... | clang ...
#
# v5.12.21-alpha | Self-hosted | ~10.3K tests

# =============================================================================
# 0. QUARTZ IS NOT RUST (Read This First!)
# =============================================================================
# These are the most common mistakes when coming from Rust/Go/TypeScript:
#
# | Don't Write (Rust)         | Write (Quartz)              | Why                    |
# |----------------------------|-----------------------------|------------------------|
# | loop { }                   | while true                  | No `loop` keyword      |
# | let mut x = 5              | var x = 5                   | `var` not `let mut`    |
# | fn foo() -> i32            | def foo(): Int              | `def` not `fn`         |
# | struct { field: Type, }    | struct Name ... end         | No braces, use `end`   |
# | match x { _ => ... }       | match x ... _ => ... end    | No braces, use `end`   |
# | use module::item           | import module               | `import` not `use`     |
# | Option::Some(x)            | Some(x)                     | Unqualified in match   |
# | vec.push(x)                | v.push(x)                   | Same! UFCS works       |
# | x.is_some()                | opt.is_some() or opt is Some| UFCS or `is` keyword   |
# | |x| expr                   | x -> expr or { it * 2 }    | Arrow or implicit `it` |
# | println!()                 | puts()                      | No macros              |

# =============================================================================
# 1. THE 4 BIG RULES
# =============================================================================
# 1. Const by Default: `x = 5` is immutable. Use `var x = 5` for mutable.
# 2. Explicit Types: Parameters and returns require annotations. Locals infer.
# 3. Existential Runtime: All types become i64 at runtime. Structs are handles.
# 4. Self-Hosted: The compiler compiles itself.

# =============================================================================
# 2. VARIABLES
# =============================================================================

def demo_variables(): Void
  # Immutable (const by default)
  x = 42
  name = "Quartz"

  # Mutable (explicit var)
  var counter = 0
  counter = counter + 1
  counter += 1                    # Compound assignment works

  # Type inference - no annotations needed for locals
  inferred = 100                  # Int
  also_inferred = "hello"         # String
end

# =============================================================================
# 3. FUNCTIONS
# =============================================================================

# Block form - explicit return
def add(a: Int, b: Int): Int
  return a + b
end

# Endless def - single expression, implicit return
def double(x: Int): Int = x * 2
def is_positive(n: Int): Bool = n > 0

# Default arguments
def greet(name: String = "World"): Void
  puts("Hello, #{name}!")
end

# First-class functions
def apply(f: Fn(Int): Int, x: Int): Int = f(x)

def demo_functions(): Void
  result = apply(double, 21)      # Returns 42
  greet()                         # "Hello, World!"
  greet("Quartz")                 # "Hello, Quartz!"
end

# =============================================================================
# 4. LAMBDAS & IMPLICIT `it`
# =============================================================================

def demo_lambdas(): Void
  # Arrow syntax (explicit param name)
  square = x: Int -> x * x
  adder = (a: Int, b: Int) -> a + b
  nullary = -> 42

  # Trailing block syntax (preferred for callbacks)
  # items.each() { x -> puts(x.to_s()) }
  # items.map() do item ->
  #   "Hello, #{item}!"
  # end

  # Implicit `it` — short blocks without naming the parameter
  # items.map() { it * 2 }
  # items.filter() { it > 0 }
  # items.each() { puts("#{it}") }

  puts("#{square(5)}")             # 25
end

# =============================================================================
# 5. STRUCTS
# =============================================================================

struct Point
  x: Int
  y: Int
end

# Associated functions
def Point.origin(): Point = Point { x: 0, y: 0 }
def Point.manhattan(p: Point): Int = abs(p.x) + abs(p.y)

def demo_structs(): Void
  # MUST be single line, curly braces
  p = Point { x: 10, y: 20 }

  # Field access
  puts("#{p.x}")                   # 10

  # Associated function call
  origin = Point.origin()
  dist = Point.manhattan(p)       # 30
end

# =============================================================================
# 5.5 STRUCTURAL DISPATCH (Duck Typing)
# =============================================================================
# Write functions with untyped parameters — the compiler figures out what
# methods they need and monomorphizes at each call site. Zero-cost generics,
# no annotations, no interfaces.

struct Cat
  name: Int
end
struct Dog
  name: Int
end

# Extend any struct with methods
extend Cat
  def speak(): Int = 10
end
extend Dog
  def speak(): Int = 32
end

# This function works on ANY type that has a .speak() method
def make_sound(animal): Int = animal.speak()

def demo_structural(): Void
  c = Cat { name: 0 }
  d = Dog { name: 0 }
  total = make_sound(c) + make_sound(d)   # 10 + 32 = 42
end

# =============================================================================
# 6. ENUMS & OPTION/RESULT
# =============================================================================

# Simple enum
enum Color
  Red
  Green
  Blue
end

# Option and Result are built-in
# enum Option<T>
#   Some(value: T)
#   None
# end
#
# enum Result<T, E>
#   Ok(value: T)
#   Err(error: E)
# end

def demo_enums(): Void
  color = Color::Red
  opt = Option::Some(42)
  res = Result::Ok(100)

  # Option UFCS methods
  # opt.unwrap_or(0)               # 42
  # opt.is_some()                  # true
  # opt.is_none()                  # false
  # opt.map(x -> x * 2)           # Some(84)

  # `is` keyword — quick variant checks
  # if opt is Some
  #   puts("has value")
  # end
  # return 0 if opt is None
  # return -1 if res is Err
end

# =============================================================================
# 7. PATTERN MATCHING
# =============================================================================

def demo_match(): Void
  # Simple match — unqualified variants (no Option:: prefix needed)
  color = Color::Blue
  match color
    Red => puts("red")
    Green => puts("green")
    Blue => puts("blue")
  end

  # With payload extraction — unqualified variants
  opt = Option::Some(42)
  match opt
    Some(v) => puts("#{v}")
    None => puts("nothing")
  end

  # Wildcard pattern (match as expression)
  n = 5
  result = match n
    0 => 1
    1 => 1
    _ => 99                       # Catch-all
  end
  puts("#{result}")                # Use the result

  # `is` keyword for simple checks (instead of match)
  # if opt is Some
  #   puts("has a value")
  # end

  # Return inside match arms (works!)
  match opt
    Some(v) => {
      return                      # Early return is allowed
    }
    None => puts("none")
  end
end

# =============================================================================
# 8. CONTROL FLOW
# =============================================================================

def demo_control_flow(): Void
  x = 10

  # if/elsif/else
  if x > 0
    puts("positive")
  elsif x < 0
    puts("negative")
  else
    puts("zero")
  end

  # unless (negated if)
  unless x == 0
    puts("not zero")
  end

  # while loop
  var i = 0
  while i < 5
    puts("#{i}")
    i += 1
  end

  # for loop (range is exclusive end)
  for j in 0..5                   # 0, 1, 2, 3, 4
    puts("#{j}")
  end

  # for-in with strings (iterates codepoints)
  for c in "hi"                   # c = 104, then 105
    puts(c.to_s())
  end

  # for-in with maps (iterates keys)
  var m = map_new()
  m.set("x", 1)
  for k in m                      # k = "x"
    puts(k)
  end

  # Character literals — sugar for ASCII codes
  ch = 'A'                        # 65
  if ch >= 'a' and ch <= 'z'
    puts("lowercase")
  end

  # Negative indexing
  var v = [10, 20, 30]
  v[-1]                           # 30 (last element)
  v[-2]                           # 20

  # Postfix guards — flatten your code
  # return -1 if x < 0
  # return 0 if opt is None
  puts("only if x >= 0") unless x == 0
end

# =============================================================================
# 9. DEFER
# =============================================================================

def demo_defer(): Void
  # Runs at function exit, LIFO order
  defer puts("third - runs last")
  defer puts("second")
  defer puts("first - runs first")

  puts("working...")
  # Output: working..., first, second, third
end

# =============================================================================
# 10. STRINGS (Important Gotchas!)
# =============================================================================

def demo_strings(): Void
  # Strings are Int handles (pointers), not objects
  name = "Quartz"

  # Interpolation
  puts("Hello, #{name}!")

  # Concatenation
  full = "Hello, " + name

  # CRITICAL: Check empty with .size, not comparison
  s = ""
  if str_size(s) == 0              # Empty string check
    puts("empty")
  end

  # String UFCS methods
  len = name.size                  # Length in codepoints
  c = str_char_at(name, 0)        # Char code at index

  # Slice uses END position, not length!
  url = "http://example.com/path"
  host = str_slice(url, 7, 18)    # "example.com" (7 to 18, not 7 + 11)

  # Other string methods
  pos = url.find("://")           # Returns Option<Int>
  parts = str_split(url, "/")     # Returns vector
  eq = (name == "Quartz")         # true/false  (== works for strings)
end

# =============================================================================
# 11. COLLECTIONS (UFCS Style)
# =============================================================================

def demo_collections(): Void
  # Vectors — UFCS method style (preferred)
  v = vec_new()
  v.push(1)
  v.push(2)
  v.push(3)
  len = v.size                    # 3
  first = v[0]                    # 1
  v[0] = 100                      # Mutate
  vec_free(v)                     # Manual cleanup

  # Array literals
  arr = [1, 2, 3, 4, 5]
  x = arr[0]                      # Index access

  # Maps — UFCS method style (preferred)
  m = map_new()
  m.set("key", 42)                # not map_set(m, "key", 42)
  val = m.get("key")              # Returns Option<T>
  has = m.has("key")              # true
  m.free()
end

# =============================================================================
# 12. HIGHER-ORDER FUNCTIONS (with implicit `it`)
# =============================================================================

def demo_higher_order(): Void
  arr = [1, 2, 3, 4, 5]

  # UFCS + implicit `it` (preferred modern style)
  doubled = arr.map() { it * 2 }
  evens = arr.filter() { it % 2 == 0 }

  # Explicit params when needed (multi-param or complex)
  total = arr.reduce(0, (acc: Int, x: Int) -> acc + x)

  # Each (side effects)
  arr.each() { puts("#{it}") }

  # Predicates (? suffix — they return Bool)
  has_neg = arr.any?() { it < 0 }
  all_pos = arr.all?() { it > 0 }

  # Pipeline operator (for long chains)
  result = arr
    |> map(x: Int -> x * 2)
    |> filter(x: Int -> x > 5)
    |> reduce(0, (a: Int, b: Int) -> a + b)
end

# =============================================================================
# 13. OPEN UFCS & TRAITS
# =============================================================================

# Any function can be called as a method if its first parameter matches:
def double(n: Int): Int = n * 2
def area(r: Int): Int = r * r * 3

def demo_open_ufcs(): Void
  puts("#{5.double()}")        # 10 — rewrites to double(5)
  puts("#{5.double().double()}") # 20 — chaining works
  puts("#{7.area()}")          # 147 — rewrites to area(7)
end

# Traits define shared behavior. Self = the implementing type.
trait Describable
  def describe(self): String
    return "unknown"
  end
  def label(self): String = "#{self.describe()}!"  # default method
end

struct Dog
  name: String
end

struct Cat
  name: String
end

extend Dog with Describable
  def describe(self): String = "dog:#{@name}"
end

extend Cat with Describable
  def describe(self): String = "cat:#{@name}"
end

# Bounded generics: call trait methods via UFCS
def introduce<T: Describable>(pet: T): Void
  puts(pet.label())  # calls default label() which calls overridden describe()
end

def demo_traits(): Void
  introduce(Dog { name: "Rex" })   # "dog:Rex!"
  introduce(Cat { name: "Miso" })  # "cat:Miso!"
end

# =============================================================================
# 14. FFI (Foreign Function Interface)
# =============================================================================

# C type aliases (all map to i64)
type CInt = Int
type CPtr = Int
type CSize = Int

# Declare external C functions
extern "C" def getpid(): CInt
extern "C" def strlen(s: CPtr): CSize
extern "C" def abs(x: CInt): CInt

# C-compatible struct layout
@repr(C)
struct Timespec
  tv_sec: Int
  tv_nsec: Int
end

def demo_ffi(): Void
  pid = getpid()
  puts("#{pid}")

  n = abs(-42)                    # 42
  puts("#{n}")
end

# =============================================================================
# 14. IMPORTS & MODULES
# =============================================================================

# Import syntax (NOT Rust's `use`)
# import token                    # Same directory
# import frontend/lexer           # Hierarchical
# import std/colors               # Standard library
# from token import Token, Loc    # Selective
# import token as t               # Aliased

# Module-qualified calls
# import math
# math.add(1, 2)                  # Dot syntax (preferred)
# math$add(1, 2)                  # Explicit syntax

# =============================================================================
# 15. MAIN ENTRY POINT
# =============================================================================

def main(): Int
  puts("Learn Quartz in Y Minutes!")
  puts("")

  demo_variables()
  demo_functions()
  demo_lambdas()
  demo_structs()
  demo_enums()
  demo_match()
  demo_control_flow()
  demo_defer()
  demo_strings()
  demo_collections()
  demo_higher_order()
  demo_ffi()

  puts("")
  puts("Done!")
  return 0
end
